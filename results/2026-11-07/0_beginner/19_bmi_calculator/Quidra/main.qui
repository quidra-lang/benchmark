people := [
    ("Aiko", 158, 45),
    ("Kenji", 172, 68),
    ("Mika", 165, 70),
    ("Ryo", 180, 101),
    ("Yuki", 150, 52),
]
for (name, height, weight) := people[]
    bmi := real(weight * 10000) / real(height * height)
    category := (
        if bmi < 18.5 then "underweight"
        elif bmi < 25.0 then "normal"
        elif bmi < 30.0 then "overweight"
        else "obese"
    )
    println("{name}: BMI {bmi:.1} ({category})")
