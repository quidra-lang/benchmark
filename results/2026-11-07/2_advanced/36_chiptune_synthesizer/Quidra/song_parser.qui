string[] read_lines(string path)
    content := string.from_utf8(file.read_bin(path))
    lines := content.split(NL)
    return lines[0:<int(#lines) - 1]

int hex_value(string text)
    digits := "0123456789ABCDEF"
    value := 0
    for: index < int(#text)
        digit := 0
        while digits[digit] != text[index]
            digit += 1
        value = 16 * value + digit
    return value

string[] pitch_names()
    return ["C-", "C#", "D-", "D#", "E-", "F-", "F#", "G-", "G#", "A-", "A#", "B-"]

int note_number(string name)
    pitches := pitch_names()
    pitch := 0
    while pitches[pitch] != name[0:<2]
        pitch += 1
    octave := int(name[2])
    return 12 * octave + pitch

string note_name(int number)
    pitches := pitch_names()
    return pitches[number % 12] + "{number / 12}"

class Effect(string text)
    string name := if text == "..." then "" elif text[0] == "E" then text[0:<2] else text[0]
    value := if text == "..." then 0 elif text[0] == "E" then hex_value(text[2]) else hex_value(text[1:])
    high := value / 16
    low := value % 16

class Cell(text := "... .. . ...")
    note := if text[0:<3] == "..." then -1 elif text[0:<3] == "OFF" then -2 else note_number(text[0:<3])
    instrument := if text[4:<6] == ".." then -1 else hex_value(text[4:<6])
    volume := if text[7] == "." then -1 else hex_value(text[7])
    effect := Effect(text[9:])
    has_note := note != -1
    empty := text == "... .. . ..."

class Instrument(int number, string name)
    wave := ""
    mode := 0
    int[] table := []
    attack := 0
    decay := 0
    sustain := 0
    release := 0
    int[] vibrato := []
    int[] arpeggio := []
    sweep := 0

class Pattern(int number)
    Cell[][] rows := array(64, fill = array(4, fill = Cell()))

class Song(string title, int rate, int speed, int tempo, int gain)
    Instrument[] instruments := []
    Pattern[] patterns := []
    instrument_index := array(256, fill = -1)
    pattern_index := array(256, fill = -1)
    int[] order := []

    Cell[] cells(int position, int row)
        return patterns[pattern_index[order[position]]].rows[row]

Song read_song(string path)
    lines := [for line := read_lines(path)[] if line != "" and not line.starts_with("#") then line]
    rate := int(lines[1][5:])
    speed := int(lines[2][6:])
    tempo := int(lines[3][6:])
    gain := int(lines[4][5:])
    song := Song(lines[0][6:], rate, speed, tempo, gain)
    index := 5
    while index < int(#lines)
        header := lines[index].split(" ")
        index += 1
        if header[0] == "ORDER"
            song.order = [for value := header[1:][] then hex_value(value)]
        elif header[0] == "INSTRUMENT"
            instrument := Instrument(hex_value(header[1]), header[2])
            while lines[index] != "END"
                row := lines[index].split(" ")
                if row[0] == "WAVE"
                    instrument.wave = row[1]
                    if row[1] == "PULSE"
                        duties := ["12", "25", "50", "75"]
                        while duties[instrument.mode] != row[2]
                            instrument.mode += 1
                    elif row[1] == "NOISE"
                        instrument.mode = if row[2] == "SHORT" then 1 else 0
                    elif row[1] == "TABLE"
                        for: offset < 32
                            instrument.table = instrument.table.append(hex_value(row[2][offset]))
                elif row[0] == "ENVELOPE"
                    instrument.attack = int(row[1])
                    instrument.decay = int(row[2])
                    instrument.sustain = int(row[3])
                    instrument.release = int(row[4])
                elif row[0] == "VIBRATO"
                    instrument.vibrato = [for value := row[1:][] then int(value)]
                elif row[0] == "ARPEGGIO"
                    instrument.arpeggio = [for value := row[1:][] then int(value)]
                else
                    instrument.sweep = int(row[1])
                index += 1
            index += 1
            song.instrument_index[instrument.number] = int(#song.instruments)
            song.instruments = song.instruments.append(instrument)
        else
            pattern := Pattern(hex_value(header[1]))
            while lines[index] != "END"
                row := hex_value(lines[index][0:<2])
                pattern.rows[row] = [for text := lines[index][3:].split(" | ")[] then Cell(text)]
                index += 1
            index += 1
            song.pattern_index[pattern.number] = int(#song.patterns)
            song.patterns = song.patterns.append(pattern)
    return song

class Params(local string[][] rows)
    int max_samples := int(rows[0][1])
    int loops := int(rows[1][1])
    int fade := int(rows[2][1])
    int[] muted := [for value := rows[3][1:][] then int(value)]
    int window_start := int(rows[4][1])
    int window_length := int(rows[4][2])
    int window_width := int(rows[4][3])
    int window_height := int(rows[4][4])
    int window_scope := int(rows[4][5])
    int roll_start := int(rows[5][1])
    int roll_rows := int(rows[5][2])
    preview_note := note_number(rows[6][1])
    int preview_ticks := int(rows[6][2])
    int preview_release := int(rows[6][3])
    traces := array(4096, fill = false)
    for index := (7:<int(#rows))[]
        traces[64 * hex_value(rows[index][1]) + hex_value(rows[index][2])] = true

Params read_params(string path)
    return Params([for line := read_lines(path)[] then line.split(" ")])
