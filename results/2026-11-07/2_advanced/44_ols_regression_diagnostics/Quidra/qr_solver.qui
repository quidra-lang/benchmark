import inference = "./inference.qui"

real64[] zeros(int count)
    return [for index := (0:<count)[] then 0.0]

real64[][] matrix_zeros(int rows, int columns)
    return [for index := (0:<rows)[] then zeros(columns)]

class Fit(real64[][] matrix, real64[] response, real64[] weights, int n, int p, int rank, int[] accepted, int[] aliases, real64[][] triangular, real64[] effects, real64[] beta, real64[][] inverse, real64[] variance, real64[][] u, real64[][] g, real64[] leverage, real64[] fitted, real64[] residual, real64[] weighted_residual, real64 rss)

Fit fit(real64[][] matrix, real64[] response, real64[] weights, real64 tolerance)
    n := int(#matrix)
    p := int(#matrix[0])
    roots := [for weight := weights[] then inference.root(weight)]
    weighted := matrix_zeros(n, p)
    work := matrix_zeros(n, p)
    transformed := zeros(n)
    for: i < n
        for: j < p
            weighted[i][j] = roots[i] * matrix[i][j]
            work[i][j] = weighted[i][j]
        transformed[i] = roots[i] * response[i]
    real64[] lengths := []
    for: j < p
        real64 sum := 0.0
        for: i < n
            sum += weighted[i][j] * weighted[i][j]
        lengths = lengths.append(inference.root(sum))
    triangular := matrix_zeros(p, p)
    int[] accepted := []
    int[] aliases := []
    for: j < p
        k := int(#accepted)
        real64 sum := 0.0
        for: k <= i < n
            sum += work[i][j] * work[i][j]
        eta := inference.root(sum)
        if eta <= tolerance * lengths[j]
            aliases = aliases.append(j)
            continue
        accepted = accepted.append(j)
        alpha := if work[k][j] >= 0.0 then -eta else eta
        vector := zeros(n)
        real64 squared := 0.0
        for: k <= i < n
            vector[i] = if i == k then work[i][j] - alpha else work[i][j]
            squared += vector[i] * vector[i]
        for: l < k
            triangular[l][k] = work[l][j]
        triangular[k][k] = alpha
        for: j + 1 <= l < p
            real64 dot := 0.0
            for: k <= i < n
                dot += vector[i] * work[i][l]
            delta := 2.0 * dot / squared
            for: k <= i < n
                work[i][l] -= delta * vector[i]
        real64 dot := 0.0
        for: k <= i < n
            dot += vector[i] * transformed[i]
        delta := 2.0 * dot / squared
        for: k <= i < n
            transformed[i] -= delta * vector[i]
    rank := int(#accepted)
    effects := transformed[0:<rank]
    beta := zeros(p)
    for: backwards < rank
        k := rank - 1 - backwards
        real64 tail := 0.0
        for: k + 1 <= l < rank
            tail += triangular[k][l] * beta[accepted[l]]
        beta[accepted[k]] = (effects[k] - tail) / triangular[k][k]
    inverse := matrix_zeros(rank, rank)
    for: m < rank
        for: backwards < rank
            l := rank - 1 - backwards
            real64 tail := 0.0
            for: l + 1 <= q < rank
                tail += triangular[l][q] * inverse[q][m]
            real64 diagonal := if l == m then 1.0 else 0.0
            inverse[l][m] = (diagonal - tail) / triangular[l][l]
    real64[] variance := []
    for: k < rank
        real64 sum := 0.0
        for: m < rank
            sum += inverse[k][m] * inverse[k][m]
        variance = variance.append(sum)
    real64[][] u := []
    real64[][] g := []
    real64[] leverage := []
    real64[] fitted := []
    real64[] residual := []
    real64[] weighted_residual := []
    real64 rss := 0.0
    for: i < n
        real64[] u_row := []
        real64 h := 0.0
        for: k < rank
            real64 sum := 0.0
            for: m < rank
                sum += weighted[i][accepted[m]] * inverse[m][k]
            u_row = u_row.append(sum)
            h += sum * sum
        u = u.append(u_row)
        leverage = leverage.append(h)
        real64[] g_row := []
        for: k < rank
            real64 sum := 0.0
            for: m < rank
                sum += inverse[k][m] * u_row[m]
            g_row = g_row.append(sum)
        g = g.append(g_row)
        real64 value := 0.0
        for: k < rank
            value += matrix[i][accepted[k]] * beta[accepted[k]]
        fitted = fitted.append(value)
        difference := response[i] - value
        residual = residual.append(difference)
        weighted_difference := roots[i] * difference
        weighted_residual = weighted_residual.append(weighted_difference)
        rss += weighted_difference * weighted_difference
    real64[][] final_triangular := []
    for: row < rank
        final_triangular = final_triangular.append(triangular[row][0:<rank])
    return Fit(matrix, response, weights, n, p, rank, accepted, aliases, final_triangular, effects, beta, inverse, variance, u, g, leverage, fitted, residual, weighted_residual, rss)
