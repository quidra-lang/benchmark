string[] read_lines(string path)
    content := string.from_utf8(file.read_bin(path))
    lines := content.split(NL)
    return lines[0:<int(#lines) - 1]

int decimal(string word)
    result := int(word)
    return result

int[] read_ecg()
    int[] result := []
    lines := read_lines("input/ecg.csv")
    for: 1 <= index < int(#lines)
        result = result.append(decimal(lines[index].split(",")[1]))
    return result

class Annotation(int sample, string label)
    beat := -1

Annotation[] read_annotations()
    Annotation[] result := []
    lines := read_lines("input/annotations.csv")
    for: 1 <= index < int(#lines)
        words := lines[index].split(",")
        result = result.append(Annotation(decimal(words[0]), words[1]))
    return result

int[] read_params()
    int[] result := []
    for line := read_lines("input/params.txt")[]
        result = result.append(decimal(line.split(" ")[1]))
    return result

void write_lines(string name, string[] lines)
    writer1 := file.write("output/" + name)
    .writer1(lines.join(NL) + NL)
