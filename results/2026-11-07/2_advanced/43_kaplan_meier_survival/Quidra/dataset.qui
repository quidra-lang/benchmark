string[] read_lines(string path)
    contents := string.from_utf8(file.read_bin(path))
    lines := contents.split(NL)
    return lines[0:<int(#lines) - 1]

int integer(string value)
    result := int(value)
    return result

int find_name(string[] names, string name)
    for: index < int(#names)
        if names[index] == name
            return index
    return -1

class Params()
    string[] groups := []
    int[] report_times := []
    tau := 1
    width := 1
    intervals := 1
    strata := "sex"
    string[] subgroups := []
    landmark := 1
    string[] covariates := []
    residuals := 1
    int[] plot_size := []

Params read_params()
    params := Params()
    for line := read_lines("input/params.txt")[]
        fields := line.split(" ")
        values := fields[1:<int(#fields)]
        key := fields[0]
        if key == "GROUPS"
            params.groups = values
        elif key == "REPORT_TIMES"
            params.report_times = [for value := values[] then integer(value)]
        elif key == "TAU"
            params.tau = integer(values[0])
        elif key == "LIFE_TABLE"
            params.width = integer(values[0])
            params.intervals = integer(values[1])
        elif key == "STRATA"
            params.strata = values[0]
        elif key == "SUBGROUPS"
            params.subgroups = values
        elif key == "LANDMARK"
            params.landmark = integer(values[0])
        elif key == "COX"
            params.covariates = values
        elif key == "RESIDUALS"
            params.residuals = integer(values[0])
        elif key == "PLOT"
            params.plot_size = [for value := values[] then integer(value)]
    return params

int[][] read_subjects(string[] groups)
    int[][] subjects := []
    lines := read_lines("input/subjects.csv")
    for: 1 <= index < int(#lines)
        fields := lines[index].split(",")
        row := [integer(fields[0]), find_name(groups, fields[1]), integer(fields[2]), integer(fields[3]), integer(fields[4]), if fields[5] == "M" then 1 else 0, integer(fields[6])]
        place := int(#subjects)
        for: position < int(#subjects)
            if row[0] < subjects[position][0]
                place = position
                break
        subjects = subjects[0:<place].append(row).concat(subjects[place:<int(#subjects)])
    return subjects
