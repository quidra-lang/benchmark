void emit(string text)
    print(text + NL)

int absolute(int value)
    return if value < 0 then -value else value

int gcd(int first, int second)
    int a = absolute(first)
    int b = absolute(second)
    while b != 0
        int remainder = a % b
        a = b
        b = remainder
    return a

string decimal(int value, nat places)
    int scale = 1
    for nat i < places
        scale *= 10
    string fraction = (absolute(value) % scale).string()
    return (if value < 0 then "-" else "") + (absolute(value) / scale).string() + "." + string.repeat("0", places - len(fraction)) + fraction

string signed(int value)
    return (if value > 0 then "+" else "") + value.string()

bool digits(string text)
    if text == ""
        return false
    for nat i < len(text)
        if not "0123456789".contains(text[i])
            return false
    return true

int locate(string[] items, string item)
    for nat i < len(items)
        if items[i] == item
            return int(i)
    return -1

string[] symbols()
    return "H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe".split(" ")

int[] weights()
    return [1008, 4003, 6941, 9012, 10811, 12011, 14007, 15999, 18998, 20180, 22990, 24305, 26982, 28086, 30974, 32065, 35453, 39948, 39098, 40078, 44956, 47867, 50942, 51996, 54938, 55845, 58933, 58693, 63546, 65380, 69723, 72630, 74922, 78971, 79904, 83798, 85468, 87620, 88906, 91224, 92906, 95950, 98000, 101070, 102906, 106420, 107868, 112414, 114818, 118710, 121760, 127600, 126904, 131293]

int[] hill_order(int[] counts)
    string[] names = symbols()
    string[] present = [for nat i < len(names) if counts[i] > 0 then names[i]]
    string[] ordered = present.sorted()
    if counts[5] > 0
        ordered = ["C"].concat(if counts[0] > 0 then ["H"] else []).concat([for string name = ordered[] if name != "C" and name != "H" then name])
    return [for string name = ordered[] then locate(names, name)]

string hill(int[] counts, int charge = 0)
    string result = ""
    string[] names = symbols()
    for int element = hill_order(counts)[]
        result += names[element] + (if counts[element] == 1 then "" else counts[element].string())
    if charge != 0
        result += "^" + (if absolute(charge) == 1 then "" else absolute(charge).string()) + (if charge > 0 then "+" else "-")
    return result

class Fraction(int numerator, int denominator = 1)
    local int divisor = gcd(numerator, denominator)
    numerator /= divisor
    denominator /= divisor
    if denominator < 0
        numerator = -numerator
        denominator = -denominator

    Fraction plus(Fraction other)
        return Fraction(numerator * other.denominator + other.numerator * denominator, denominator * other.denominator)

    Fraction minus(Fraction other)
        return Fraction(numerator * other.denominator - other.numerator * denominator, denominator * other.denominator)

    Fraction times(Fraction other)
        return Fraction(numerator * other.numerator, denominator * other.denominator)

    Fraction divided(Fraction other)
        return Fraction(numerator * other.denominator, denominator * other.numerator)

    string notation()
        return signed(numerator) + (if denominator == 1 then "" else "/{denominator}")

class Formula(int[] counts, int charge = 0)
    int mass()
        int result = 0
        int[] table = weights()
        for nat i < len(counts)
            result += counts[i] * table[i]
        return result

class FormulaReader(string text)
    nat position = 0
    string unknown = ""

    int | error .multiplier()
        nat begin = position
        while position < len(text) and "0123456789".contains(text[position])
            position += 1
        if position == begin
            return 1
        if text[begin] == "0"
            return error("syntax")
        return int.parse(text[begin:<position])

    int[] | error .sequence()
        int[] result = array(54, fill = 0)
        bool any_item = false
        while position < len(text)
            string token = text[position]
            int[] item = array(54, fill = 0)
            if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(token)
                position += 1
                if position < len(text) and "abcdefghijklmnopqrstuvwxyz".contains(text[position])
                    token += text[position]
                    position += 1
                int element = locate(symbols(), token)
                if element < 0
                    if unknown == ""
                        unknown = token
                else
                    item[element] = 1
            elif token == "(" or token == "["
                position += 1
                item = try .sequence()
                string closing = if token == "(" then ")" else "]"
                if position >= len(text) or text[position] != closing
                    return error("syntax")
                position += 1
            else
                break
            any_item = true
            int factor = try .multiplier()
            for nat i < 54
                result[i] += item[i] * factor
        if not any_item
            return error("syntax")
        return result

    Formula | error .parse()
        int[] result = try .sequence()
        while position < len(text) and text[position] == "."
            position += 1
            int factor = try .multiplier()
            int[] hydrate = try .sequence()
            for nat i < 54
                result[i] += hydrate[i] * factor
        int charge = 0
        if position < len(text) and text[position] == "^"
            position += 1
            charge = try .multiplier()
            if position >= len(text) or (text[position] != "+" and text[position] != "-")
                return error("syntax")
            if text[position] == "-"
                charge = -charge
            position += 1
        if position != len(text)
            return error("syntax")
        return Formula(result, charge)

Formula | error read_formula(string text, string original = "")
    FormulaReader reader = FormulaReader(text)
    match .reader.parse()
        Formula parsed
            if reader.unknown != ""
                return error("unknown element " + reader.unknown)
            return parsed
        error failure
            return error("invalid formula " + (if original == "" then text else original))

int | error quantity(string word, bool enthalpy = false)
    string text = word
    bool negative = enthalpy and text.starts_with("-")
    if negative
        text = text[1:]
    string[] parts = text.split(".")
    nat precision = if enthalpy then 2 else 3
    nat max_integer = if enthalpy then 5 else 4
    bool valid = len(parts) >= 1 and len(parts) <= 2
    if valid
        valid = digits(parts[0]) and len(parts[0]) <= max_integer and (len(parts[0]) == 1 or parts[0][0] != "0")
    string fraction = ""
    if len(parts) == 2
        fraction = parts[1]
        valid = valid and digits(fraction) and len(fraction) <= precision
    if not valid
        return error((if enthalpy then "invalid enthalpy " else "invalid quantity ") + word)
    int scale = if enthalpy then 100 else 1000
    int value = int.parse(parts[0]) * scale
    if fraction != ""
        value += int.parse(fraction + string.repeat("0", precision - len(fraction)))
    if not enthalpy and value == 0
        return error("invalid quantity " + word)
    return if negative then -value else value

class Species(string name, string core, string state, Formula formula, int coefficient = 1)

Species | error read_species(string word, bool coefficients = false)
    string text = word
    string state = ""
    for string suffix = ["(s)", "(l)", "(g)", "(aq)"][]
        if text.ends_with(suffix)
            state = suffix
            text = text[:<len(text) - len(suffix)]
            break
    int coefficient = 1
    nat begin = 0
    if coefficients
        while begin < len(text) and "0123456789".contains(text[begin])
            begin += 1
        if begin > 0
            if text[0] == "0"
                return error("invalid formula " + word)
            coefficient = int.parse(text[:<begin])
    text = text[begin:]
    Formula formula = try read_formula(text, word)
    return Species(text + state, text, state, formula, coefficient)

class Equation(Species[] species, int reactants)

Equation | error read_equation(string[] words, bool coefficients = false)
    bool valid = len(words) % 2 == 1
    int arrow = -1
    for nat i < len(words)
        if i % 2 == 0
            if words[i] == "+" or words[i] == "->"
                valid = false
        elif words[i] == "->"
            if arrow >= 0
                valid = false
            arrow = int(i)
        elif words[i] != "+"
            valid = false
    if not valid or arrow < 0
        return error("malformed equation")
    Species[] species = []
    for nat i < len(words) step 2
        Species item = try read_species(words[i], coefficients)
        species = species.append(item)
    return Equation(species, (arrow + 1) / 2)

class Matrix(string[] labels, int[][] entries, int rank, int[][] basis)

Matrix analyze(Species[] species, int[] signs)
    int[] present = array(54, fill = 0)
    for Species item = species[]
        for nat i < 54
            present[i] += item.formula.counts[i]
    int[] elements = hill_order(present)
    string[] names = symbols()
    string[] labels = [for int element = elements[] then names[element]].append("charge")
    int[][] entries = []
    for int element = elements[]
        entries = entries.append([for nat j < len(species) then signs[j] * species[j].formula.counts[element]])
    entries = entries.append([for nat j < len(species) then signs[j] * species[j].formula.charge])
    Fraction[][] reduced = [for int[] row = entries[] then [for int entry = row[] then Fraction(entry)]]
    int[] pivots = []
    int[] free = []
    nat rank = 0
    for nat column < len(species)
        nat chosen = rank
        while chosen < len(reduced) and reduced[chosen][column].numerator == 0
            chosen += 1
        if chosen == len(reduced)
            free = free.append(int(column))
            continue
        Fraction[] saved = reduced[rank]
        reduced[rank] = reduced[chosen]
        reduced[chosen] = saved
        Fraction divisor = reduced[rank][column]
        for nat j < len(species)
            reduced[rank][j] = reduced[rank][j].divided(divisor)
        for nat i < len(reduced)
            if i == rank
                continue
            Fraction factor = reduced[i][column]
            for nat j < len(species)
                reduced[i][j] = reduced[i][j].minus(factor.times(reduced[rank][j]))
        pivots = pivots.append(int(column))
        rank += 1
    int[][] basis = []
    for int column = free[]
        Fraction[] vector = array(len(species), fill = Fraction(0))
        vector[column] = Fraction(1)
        for nat i < rank
            Fraction entry = reduced[i][column]
            vector[pivots[i]] = Fraction(-entry.numerator, entry.denominator)
        int multiple = 1
        for Fraction entry = vector[]
            multiple = multiple / gcd(multiple, entry.denominator) * entry.denominator
        int[] integers = [for Fraction entry = vector[] then entry.numerator * (multiple / entry.denominator)]
        int divisor = 0
        for int entry = integers[]
            divisor = gcd(divisor, entry)
        basis = basis.append([for int entry = integers[] then entry / divisor])
    return Matrix(labels, entries, int(rank), basis)

int[] | string determine(Matrix matrix, nat required)
    if len(matrix.basis) == 0
        return "IMPOSSIBLE"
    if len(matrix.basis) > 1
        return "AMBIGUOUS (nullity {len(matrix.basis)})"
    int[] coefficients = matrix.basis[0]
    if coefficients[0] < 0
        coefficients = [for int value = coefficients[] then -value]
    for nat i < required
        if coefficients[i] <= 0
            return "IMPOSSIBLE"
    return coefficients

string term(string name, int coefficient)
    return (if coefficient == 1 then "" else coefficient.string()) + name

string balanced(Equation equation, int[] coefficients)
    string[] left = []
    string[] right = []
    for nat i < len(equation.species)
        string text = term(equation.species[i].name, coefficients[i])
        if int(i) < equation.reactants
            left = left.append(text)
        else
            right = right.append(text)
    return left.join(" + ") + " -> " + right.join(" + ")

string[] ratio_report(int[] amounts)
    int[] elements = hill_order(amounts)
    int[] table = weights()
    string[] names = symbols()
    int smallest = elements[0]
    for int element = elements[]
        if amounts[element] * table[smallest] < amounts[smallest] * table[element]
            smallest = element
    string[] output = []
    for int element = elements[]
        output = output.append(names[element] + " " + decimal(1000 * amounts[element] * table[smallest] / (table[element] * amounts[smallest]), 3))
    for 1 <= int factor <= 12
        int[] composition = array(54, fill = 0)
        bool valid = true
        for int element = elements[]
            int numerator = factor * amounts[element] * table[smallest]
            int denominator = table[element] * amounts[smallest]
            int rounded = (2 * numerator + denominator) / (2 * denominator)
            if 20 * absolute(numerator - rounded * denominator) > denominator
                valid = false
            composition[element] = rounded
        if valid
            return output.append(hill(composition) + " (k = {factor})")
    return output.append("no simple ratio")

string salt_part(string text, int count)
    string core = text.split("^")[0]
    if count == 1
        return core
    bool simple = locate(symbols(), core) >= 0
    if core.starts_with("[")
        int depth = 0
        for nat i < len(core)
            if core[i] == "["
                depth += 1
            elif core[i] == "]"
                depth -= 1
                if depth == 0
                    simple = i == len(core) - 1
                    break
    return (if simple then core else "(" + core + ")") + count.string()

string oxidation(Formula formula)
    int[] order = hill_order(formula.counts)
    string[] names = symbols()
    Fraction[] values = array(54, fill = Fraction(0))
    bool[] assigned = array(54, fill = false)
    int last = -1
    string[] fixed = ["Li", "Na", "K", "Rb", "Be", "Mg", "Ca", "Sr", "Al"]
    if len(order) == 1
        int element = order[0]
        values[element] = Fraction(formula.charge, formula.counts[element])
    else
        int[] assignment_order = []
        if formula.counts[8] > 0
            assignment_order = assignment_order.append(8)
            values[8] = Fraction(-1)
        for int element = order[]
            int metal = locate(fixed, names[element])
            if metal >= 0
                assignment_order = assignment_order.append(element)
                values[element] = Fraction(if metal < 4 then 1 elif metal < 8 then 2 else 3)
        if formula.counts[0] > 0
            bool hydride = true
            for int element = order[]
                if element != 0 and locate(fixed, names[element]) < 0
                    hydride = false
            assignment_order = assignment_order.append(0)
            values[0] = Fraction(if hydride then -1 else 1)
        if formula.counts[7] > 0
            assignment_order = assignment_order.append(7)
            values[7] = Fraction(-2)
        if formula.counts[7] == 0 and formula.counts[8] == 0
            for int element = [16, 34, 52][]
                if formula.counts[element] > 0
                    assignment_order = assignment_order.append(element)
                    values[element] = Fraction(-1)
                    break
        int sum = 0
        for int element = assignment_order[]
            assigned[element] = true
            last = element
            sum += formula.counts[element] * values[element].numerator
        int[] unknown = [for int element = order[] if not assigned[element] then element]
        if len(unknown) >= 2
            return "indeterminate: " + [for int element = unknown[] then names[element]].join(" ")
        if len(unknown) == 1
            int element = unknown[0]
            values[element] = Fraction(formula.charge - sum, formula.counts[element])
        elif sum != formula.charge
            values[last] = Fraction(formula.charge - sum + formula.counts[last] * values[last].numerator, formula.counts[last])
    return [for int element = order[] then names[element] + " " + values[element].notation()].join(", ")

class Calculator()
    map.Map<string, int> heats

    string[] | error .execute(string[] words)
        string command = words[0]
        string[] args = words[1:]
        string[] one = ["ELEMENT", "PARSE", "MASS", "PERCENT", "EMPIRICAL", "DBE", "OXSTATE"]
        string[] two = ["MOLES", "GRAMS", "MOLECULAR", "SALT", "HEAT"]
        string[] equation_commands = ["BALANCE", "MATRIX", "CHECK", "DELTAH"]
        bool special = locate(["COMBUST", "HEATS", "DERIVE", "REDOX", "HALF", "STOICH", "LIMITING", "YIELD"], command) >= 0
        if locate(one, command) < 0 and locate(two, command) < 0 and locate(equation_commands, command) < 0 and not special
            return error("unknown command " + command)
        bool wrong = (locate(one, command) >= 0 and len(args) != 1) or (locate(two, command) >= 0 and len(args) != 2) or (locate(equation_commands, command) >= 0 and len(args) == 0)
        wrong = wrong or (command == "COMBUST" and len(args) != 3) or (command == "HEATS" and len(args) != 0) or (command == "DERIVE" and (len(args) < 2 or len(args) % 2 != 0)) or ((command == "REDOX" or command == "HALF") and len(args) < 2)
        if wrong
            return error("wrong argument count for " + command)
        string[] names = symbols()
        int[] table = weights()
        if command == "ELEMENT"
            int element = locate(names, args[0])
            if element < 0
                return error("unknown element " + args[0])
            return [args[0] + " (Z = {element + 1}) " + decimal(table[element], 3) + " u"]
        if command == "HEATS"
            string[] keys = heats.keys().sorted()
            if len(keys) == 0
                return ["no enthalpies"]
            string[] output = []
            for string key = keys[]
                match heats.get(key)
                    int value
                        output = output.append(key + " " + decimal(value, 2) + " kJ/mol")
                    none
                        void
            return output
        if command == "HEAT"
            Species species = try read_species(args[0])
            int value = try quantity(args[1], true)
            string output = "dHf(" + args[0] + ") = " + decimal(value, 2) + " kJ/mol"
            match heats.get(species.name)
                int previous
                    output += " (was " + decimal(previous, 2) + ")"
                none
                    void
            .heats.set(species.name, value)
            return [output]
        if command == "DERIVE" or command == "COMBUST"
            int[] amounts = array(54, fill = 0)
            string[] output = []
            if command == "DERIVE"
                int sum = 0
                for nat i < len(args) step 2
                    int element = locate(names, args[i])
                    if element < 0
                        return error("unknown element " + args[i])
                    if amounts[element] > 0
                        return error("duplicate element " + args[i])
                    int value = try quantity(args[i + 1])
                    if value > 100000
                        return error("invalid percentage " + args[i + 1])
                    amounts[element] = value
                    sum += value
                if absolute(sum - 100000) > 1000
                    return error("percentages sum to " + decimal(sum, 3))
            else
                int sample = try quantity(args[0])
                int co2 = try quantity(args[1])
                int water = try quantity(args[2])
                int carbon = co2 * 12011 / 44009
                int hydrogen = water * 2016 / 18015
                int oxygen = sample - carbon - hydrogen
                if carbon == 0 or hydrogen == 0 or 100 * oxygen < -sample
                    return error("inconsistent masses")
                amounts[5] = carbon
                amounts[0] = hydrogen
                if 100 * oxygen > sample
                    amounts[7] = oxygen
                for int element = [5, 0, 7][]
                    if amounts[element] > 0
                        output = output.append("mass " + names[element] + " " + decimal(amounts[element], 3) + " g")
            return output.concat(ratio_report(amounts))
        if locate(one, command) >= 0 or locate(["MOLES", "GRAMS", "MOLECULAR", "SALT"], command) >= 0
            Formula formula = try read_formula(args[0])
            int mass = formula.mass()
            int[] order = hill_order(formula.counts)
            if command == "PARSE"
                return [hill(formula.counts, formula.charge) + " (" + [for int element = order[] then names[element] + " {formula.counts[element]}"].join(", ") + "; charge " + signed(formula.charge) + ")"]
            if command == "MASS"
                return ["M(" + args[0] + ") = " + decimal(mass, 3) + " g/mol"]
            if command == "PERCENT"
                return [for int element = order[] then names[element] + " " + decimal(10000 * formula.counts[element] * table[element] / mass, 2) + "%"]
            if command == "EMPIRICAL"
                int divisor = 0
                for int count = formula.counts[]
                    divisor = gcd(divisor, count)
                return [hill([for int count = formula.counts[] then count / divisor]) + " (n = {divisor})"]
            if command == "OXSTATE"
                return [oxidation(formula)]
            if command == "DBE" or command == "MOLECULAR"
                if formula.charge != 0
                    return error("charged formula " + args[0])
            if command == "DBE"
                string[][] valences = [["H", "F", "Cl", "Br", "I"], ["O", "S", "Se"], ["B", "N", "P", "As"], ["C", "Si", "Ge"]]
                int twice = 2
                for int element = order[]
                    int valence = 0
                    for nat i < len(valences)
                        if locate(valences[i], names[element]) >= 0
                            valence = int(i) + 1
                    if valence == 0
                        return error("no valence for " + names[element])
                    twice += formula.counts[element] * (valence - 2)
                return ["DBE = " + (if twice < 0 then "-" else "") + (absolute(twice) / 2).string() + (if absolute(twice) % 2 == 0 then ".0" else ".5")]
            if command == "SALT"
                Formula anion = try read_formula(args[1])
                if formula.charge <= 0
                    return error("not a cation " + args[0])
                if anion.charge >= 0
                    return error("not an anion " + args[1])
                for string argument = args[]
                    if argument.contains(".")
                        return error("hydrate ion " + argument)
                int divisor = gcd(formula.charge, anion.charge)
                int a = -anion.charge / divisor
                int b = formula.charge / divisor
                int[] composition = [for nat i < 54 then a * formula.counts[i] + b * anion.counts[i]]
                return [salt_part(args[0], a) + salt_part(args[1], b) + " (" + hill(composition) + ", " + decimal(a * mass + b * anion.mass(), 3) + " g/mol)"]
            int amount = try quantity(args[1])
            if command == "MOLES"
                return [decimal(amount, 3) + " g " + args[0] + " = " + decimal(amount * 1000000 / mass, 6) + " mol"]
            if command == "GRAMS"
                return [decimal(amount, 3) + " mol " + args[0] + " = " + decimal(amount * mass / 1000, 3) + " g"]
            int multiple = (2 * amount + mass) / (2 * mass)
            if multiple == 0 or 10 * absolute(amount - multiple * mass) > mass
                return ["no integer multiple (ratio " + decimal(1000 * amount / mass, 3) + ")"]
            return [hill([for int count = formula.counts[] then count * multiple]) + " (n = {multiple}, " + decimal(multiple * mass, 3) + " g/mol)"]
        string[] equation_words = args
        string[] trailing = []
        bool redox = command == "REDOX" or command == "HALF"
        if redox
            if args[0] != "acidic" and args[0] != "basic"
                return error("invalid medium " + args[0])
            equation_words = args[1:]
        if command == "STOICH" or command == "LIMITING" or command == "YIELD"
            int separator = -1
            for nat i < len(args)
                if args[i] == ":"
                    if separator >= 0
                        return error("invalid separator")
                    separator = int(i)
            if separator < 0
                return error("invalid separator")
            trailing = args[separator + 1:]
            equation_words = args[:<separator]
            if (command == "STOICH" and len(trailing) != 2) or (command == "YIELD" and len(trailing) != 4)
                return error("wrong argument count for " + command)
        Equation equation = try read_equation(equation_words, command == "CHECK")
        Species[] species = equation.species
        int[] signs = [for nat i < len(species) then (if int(i) < equation.reactants then 1 else -1)]
        int first = -1
        int second = -1
        int[] quantities = []
        int[] enthalpies = []
        if command == "STOICH"
            first = locate([for Species item = species[] then item.name], trailing[0])
            if first < 0
                return error("species " + trailing[0] + " not in equation")
            int amount = try quantity(trailing[1])
            quantities = [amount]
        elif command == "LIMITING"
            if int(len(trailing)) != equation.reactants
                return error("expected {equation.reactants} masses, got {len(trailing)}")
            for string word = trailing[]
                int amount = try quantity(word)
                quantities = quantities.append(amount)
        elif command == "YIELD"
            first = locate([for Species item = species[:<equation.reactants][] then item.name], trailing[0])
            if first < 0
                return error(trailing[0] + " is not a reactant")
            second = locate([for Species item = species[equation.reactants:][] then item.name], trailing[2])
            if second < 0
                return error(trailing[2] + " is not a product")
            second += equation.reactants
            int supplied = try quantity(trailing[1])
            int actual = try quantity(trailing[3])
            quantities = [supplied, actual]
        elif command == "DELTAH"
            for Species item = species[]
                match heats.get(item.name)
                    int value
                        enthalpies = enthalpies.append(value)
                    none
                        return error("no enthalpy for " + item.name)
        if redox
            for Species item = species[]
                if locate(["H^+", "OH^-", "H2O"], item.core) >= 0
                    return error("reserved species " + item.name)
            Species ion = try read_species(if args[0] == "acidic" then "H^+" else "OH^-")
            Species water = try read_species("H2O")
            species = species.append(ion).append(water)
            signs = signs.append(1).append(1)
            if command == "HALF"
                species = species.append(Species("e^-", "e^-", "", Formula(array(54, fill = 0), -1)))
                signs = signs.append(1)
        Matrix matrix = analyze(species, signs)
        if command == "MATRIX"
            string[] output = ["columns: " + [for Species item = species[] then item.name].join(" ")]
            for nat i < len(matrix.labels)
                output = output.append(matrix.labels[i] + ": " + [for int value = matrix.entries[i][] then value.string()].join(" "))
            output = output.append("rank {matrix.rank}, nullity {len(matrix.basis)}")
            for int[] vector = matrix.basis[]
                output = output.append("null: " + [for int value = vector[] then value.string()].join(" "))
            return output
        if command == "CHECK"
            string[] differences = []
            for nat i < len(matrix.labels)
                int left = 0
                int right = 0
                for nat j < len(species)
                    if int(j) < equation.reactants
                        left += matrix.entries[i][j] * species[j].coefficient
                    else
                        right -= matrix.entries[i][j] * species[j].coefficient
                if left != right
                    bool charge_row = matrix.labels[i] == "charge"
                    differences = differences.append(matrix.labels[i] + ": " + (if charge_row then signed(left) else left.string()) + " != " + (if charge_row then signed(right) else right.string()))
            if len(differences) > 0
                return ["not balanced"].concat(differences)
            int divisor = 0
            for Species item = species[]
                divisor = gcd(divisor, item.coefficient)
            return [if divisor == 1 then "balanced" else "balanced, not in lowest terms (gcd {divisor})"]
        int[] coefficients = []
        match determine(matrix, len(equation.species))
            string failure
                return [failure]
            int[] found
                coefficients = found
        if redox
            string[] left = []
            string[] right = []
            for nat i < len(species)
                int coefficient = coefficients[i]
                if coefficient == 0
                    continue
                bool reactant = if i < len(equation.species) then int(i) < equation.reactants else coefficient > 0
                string text = term(species[i].name, absolute(coefficient))
                if reactant
                    left = left.append(text)
                else
                    right = right.append(text)
            string[] output = [left.join(" + ") + " -> " + right.join(" + ")]
            if command == "HALF"
                int electrons = coefficients[len(coefficients) - 1]
                output = output.append(if electrons > 0 then "reduction" elif electrons < 0 then "oxidation" else "no electron transfer")
            return output
        string[] output = [balanced(equation, coefficients)]
        if command == "STOICH"
            int denominator = coefficients[first] * species[first].formula.mass()
            for nat i < len(species)
                int scaled = quantities[0] * coefficients[i]
                string line = species[i].name + " " + decimal(scaled * 1000000 / denominator, 6) + " mol " + decimal(scaled * species[i].formula.mass() / denominator, 3) + " g"
                if species[i].state == "(g)"
                    line += " " + decimal(scaled * 22414 / denominator, 3) + " L"
                output = output.append(line)
        elif command == "LIMITING"
            int limiting = 0
            for int i < equation.reactants
                if quantities[i] * coefficients[limiting] * species[limiting].formula.mass() < quantities[limiting] * coefficients[i] * species[i].formula.mass()
                    limiting = i
            int denominator = coefficients[limiting] * species[limiting].formula.mass()
            int supplied = quantities[limiting]
            output = output.append("limiting " + species[limiting].name).append("extent " + decimal(supplied * 1000000 / denominator, 6) + " mol")
            for equation.reactants <= int i < int(len(species))
                int scaled = supplied * coefficients[i]
                string line = "product " + species[i].name + " " + decimal(scaled * species[i].formula.mass() / denominator, 3) + " g"
                if species[i].state == "(g)"
                    line += " " + decimal(scaled * 22414 / denominator, 3) + " L"
                output = output.append(line)
            for int i < equation.reactants
                if i != limiting
                    output = output.append("remaining " + species[i].name + " " + decimal((quantities[i] * denominator - supplied * coefficients[i] * species[i].formula.mass()) / denominator, 3) + " g")
        elif command == "YIELD"
            int theoretical = quantities[0] * coefficients[second] * species[second].formula.mass() / (coefficients[first] * species[first].formula.mass())
            output = output.append("theoretical " + decimal(theoretical, 3) + " g").append("actual " + decimal(quantities[1], 3) + " g")
            output = output.append(if theoretical == 0 then "yield undefined" else "yield " + decimal(quantities[1] * 10000 / theoretical, 2) + "%")
        elif command == "DELTAH"
            int change = 0
            for nat i < len(species)
                change -= signs[i] * coefficients[i] * enthalpies[i]
            string kind = if change < 0 then "exothermic" elif change > 0 then "endothermic" else "thermoneutral"
            output = output.append("dH = " + decimal(change, 2) + " kJ ({kind})")
        return output

void run_commands()
    Calculator calculator = Calculator()
    nat count = 0
    scan(&count)
    for nat i < count
        string line = ""
        scan(&line)
        match .calculator.execute(line.split(" "))
            string[] output
                for string item = output[]
                    emit(item)
            error failure
                emit("error: " + failure.message)

run_commands()
