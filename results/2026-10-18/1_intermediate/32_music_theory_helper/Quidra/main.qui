import math

int natural_pitch(int letter)
    int[] values = [0, 2, 4, 5, 7, 9, 11]
    return values[letter]

int letter_fifths(int letter)
    int[] values = [0, 2, 4, -1, 1, 3, 5]
    return values[letter]

string accidental_text(int alteration)
    string[] values = ["bb", "b", "", "#", "x"]
    return values[alteration + 2]

string[] standard_names(bool flat)
    string names = if flat then "C Db D Eb E F Gb G Ab A Bb B" else "C C# D D# E F F# G G# A A# B"
    return names.split(" ")

string[] roman_names(bool lower)
    string names = if lower then "i ii iii iv v vi vii" else "I II III IV V VI VII"
    return names.split(" ")

string[] interval_qualities()
    return ["P", "M", "m", "A", "d", "AA", "dd"]

int modulo(int value, int divisor)
    return (value % divisor + divisor) % divisor

int floor_div(int value, int divisor)
    return (value - modulo(value, divisor)) / divisor

bool digits_only(string text)
    if text == ""
        return false
    for nat index < len(text)
        if not "0123456789".contains(text[index])
            return false
    return true

int | error bounded_integer(string text, string kind, int lower, int upper)
    if not digits_only(text) or (len(text) > 1 and text[0] == "0")
        return error("BAD {kind} {text}")
    int value = int.parse(text)
    if value < lower or value > upper
        return error("BAD {kind} {text}")
    return value

int | error parse_frequency(string text, bool tuning)
    string[] parts = text.split(".")
    if len(parts) > 2 or len(parts[0]) > 5 or not digits_only(parts[0])
        return error("BAD FREQUENCY " + text)
    int value = int.parse(parts[0]) * 100
    if len(parts) == 2
        if len(parts[1]) > 2 or not digits_only(parts[1])
            return error("BAD FREQUENCY " + text)
        value += int.parse(parts[1]) * (if len(parts[1]) == 1 then 10 else 1)
    if value == 0 or (tuning and (value < 40000 or value > 48000))
        return error("BAD FREQUENCY " + text)
    return value

string frequency_text(int cents)
    int whole = cents / 100
    int tail = cents % 100
    return "{whole}." + (if tail < 10 then "0" else "") + tail.string()

class Tone(int letters, int semitones)

class Pitch self(int letter, int alteration)
    int pitch_class()
        return modulo(natural_pitch(letter) + alteration, 12)

    string text()
        return "CDEFGAB"[letter] + accidental_text(alteration)

    Pitch | error raised(Tone tone)
        int target = letter + tone.letters
        int changed = natural_pitch(letter) + alteration + tone.semitones - natural_pitch(modulo(target, 7)) - 12 * floor_div(target, 7)
        if changed < -2 or changed > 2
            return error("CANNOT SPELL")
        return Pitch(modulo(target, 7), changed)

class PitchPrefix(Pitch pitch, int end)

PitchPrefix | error read_pitch(string text, string kind)
    if text == "" or not "CDEFGAB".contains(text[0])
        return error("BAD {kind} {text}")
    int letter = 0
    while "CDEFGAB"[letter] != text[0]
        letter += 1
    int alteration = 0
    int end = 1
    if end < int(len(text))
        if text[end] == "b"
            alteration = -1
            end += 1
            if end < int(len(text)) and text[end] == "b"
                alteration = -2
                end += 1
        elif text[end] == "#"
            alteration = 1
            end += 1
        elif text[end] == "x"
            alteration = 2
            end += 1
    return PitchPrefix(Pitch(letter, alteration), end)

Pitch | error parse_pitch(string text)
    PitchPrefix parsed = try read_pitch(text, "PITCH")
    if parsed.end != int(len(text))
        return error("BAD PITCH " + text)
    return parsed.pitch

class Note self(Pitch pitch, int octave)
    int midi()
        return 12 * (octave + 1) + natural_pitch(pitch.letter) + pitch.alteration

    int position()
        return 7 * octave + pitch.letter

    bool valid()
        return -1 <= octave <= 9 and 0 <= midi() <= 127

    string text()
        return pitch.text() + octave.string()

Note | error parse_note(string text)
    PitchPrefix parsed = try read_pitch(text, "NOTE")
    string rest = text[parsed.end:]
    int octave
    if rest == "-1"
        octave = -1
    elif len(rest) == 1 and digits_only(rest)
        octave = int.parse(rest)
    else
        return error("BAD NOTE " + text)
    auto note = Note(parsed.pitch, octave)
    if not note.valid()
        return error("BAD NOTE " + text)
    return note

Note make_note(Pitch pitch, int value)
    return Note(pitch, (value - natural_pitch(pitch.letter) - pitch.alteration) / 12 - 1)

Note spelling(int value, bool flat = false)
    string[] names = standard_names(flat)
    Pitch pitch = parse_pitch(names[modulo(value, 12)])
    return Note(pitch, floor_div(value, 12) - 1)

Pitch fifth_pitch(int value)
    int[] letters = [3, 0, 4, 1, 5, 2, 6]
    return Pitch(letters[modulo(value + 1, 7)], floor_div(value + 1, 7))

int quality_delta(int quality, int number)
    int remainder = (number - 1) % 7
    int[] deltas = if remainder == 0 or remainder == 3 or remainder == 4 then [0, -99, -99, 1, -1, 2, -2] else [-99, 0, -1, 1, -2, 2, -3]
    return deltas[quality]

class Interval self(int quality, int number)
    string text()
        return interval_qualities()[quality] + number.string()

    bool forbidden()
        return number == 1 and (quality == 4 or quality == 6)

    Tone tone()
        int letters = number - 1
        return Tone(letters, 12 * (letters / 7) + natural_pitch(letters % 7) + quality_delta(quality, number))

    Interval simple()
        int reduced = number
        while reduced > 8
            reduced -= 7
        return Interval(quality, reduced)

    string consonance()
        Interval reduced = simple()
        if quality == 0 and (reduced.number == 1 or reduced.number == 5 or reduced.number == 8)
            return "perfect"
        if (quality == 1 or quality == 2) and (reduced.number == 3 or reduced.number == 6)
            return "imperfect"
        return "dissonant"

Interval | error parse_interval(string text)
    string[] qualities = interval_qualities()
    for nat quality = qualities.indices()[]
        string prefix = qualities[quality]
        if text.starts_with(prefix)
            string rest = text[len(prefix):]
            if rest == "" or len(rest) > 2 or rest[0] == "0" or not digits_only(rest)
                continue
            int number = int.parse(rest)
            auto interval = Interval(int(quality), number)
            if quality_delta(int(quality), number) != -99 and not interval.forbidden()
                return interval
    return error("BAD INTERVAL " + text)

class Motion(Interval interval, bool down, int semitones)

Motion | error between(Note first, Note second)
    int distance = second.position() - first.position()
    int semitones = second.midi() - first.midi()
    bool down = distance < 0 or (distance == 0 and semitones < 0)
    if down
        distance = -distance
        semitones = -semitones
    int difference = semitones - 12 * (distance / 7) - natural_pitch(distance % 7)
    for 0 <= int quality < 7
        if quality_delta(quality, distance + 1) == difference
            return Motion(Interval(quality, distance + 1), down, semitones)
    return error("UNNAMEABLE INTERVAL")

Tone[] tone_list(string text)
    Tone[] result = []
    for string word = text.split(" ")[]
        Interval interval = parse_interval(word)
        result = result.append(interval.tone())
    return result

class Scale(string name, Tone[] tones)
class Chord(string name, string suffix, bool lower, string numeral_suffix, Tone[] tones)
class Mode(string name, int scale, int offset)
class Catalog(Scale[] scales, Chord[] chords, Mode[] modes)

Catalog make_catalog()
    string[] scale_rows = [
        "major|P1 M2 M3 P4 P5 M6 M7",
        "natural_minor|P1 M2 m3 P4 P5 m6 m7",
        "harmonic_minor|P1 M2 m3 P4 P5 m6 M7",
        "melodic_minor|P1 M2 m3 P4 P5 M6 M7",
        "ionian|P1 M2 M3 P4 P5 M6 M7",
        "dorian|P1 M2 m3 P4 P5 M6 m7",
        "phrygian|P1 m2 m3 P4 P5 m6 m7",
        "lydian|P1 M2 M3 A4 P5 M6 M7",
        "mixolydian|P1 M2 M3 P4 P5 M6 m7",
        "aeolian|P1 M2 m3 P4 P5 m6 m7",
        "locrian|P1 m2 m3 P4 d5 m6 m7",
        "major_pentatonic|P1 M2 M3 P5 M6",
        "minor_pentatonic|P1 m3 P4 P5 m7",
        "blues|P1 m3 P4 A4 P5 m7",
        "whole_tone|P1 M2 M3 A4 A5 A6"
    ]
    string[] chord_rows = [
        "maj||I|P1 M3 P5", "min|m|i|P1 m3 P5", "dim|dim|io|P1 m3 d5",
        "aug|aug|I+|P1 M3 A5", "sus2|sus2|Isus2|P1 M2 P5", "sus4|sus4|Isus4|P1 P4 P5",
        "6|6|I6|P1 M3 P5 M6", "m6|m6|i6|P1 m3 P5 M6", "7|7|I7|P1 M3 P5 m7",
        "maj7|maj7|Imaj7|P1 M3 P5 M7", "m7|m7|i7|P1 m3 P5 m7", "mMaj7|mMaj7|imaj7|P1 m3 P5 M7",
        "m7b5|m7b5|ih7|P1 m3 d5 m7", "dim7|dim7|io7|P1 m3 d5 d7",
        "9|9|I9|P1 M3 P5 m7 M9", "add9|add9|Iadd9|P1 M3 P5 M9"
    ]
    Scale[] scales = []
    for string row = scale_rows[]
        string[] parts = row.split("|")
        scales = scales.append(Scale(parts[0], tone_list(parts[1])))
    Chord[] chords = []
    for string row = chord_rows[]
        string[] parts = row.split("|")
        chords = chords.append(Chord(parts[0], parts[1], parts[2][0] == "i", parts[2][1:], tone_list(parts[3])))
    Mode[] modes = [Mode("major", 0, 0), Mode("minor", 1, -3), Mode("ionian", 4, 0),
        Mode("dorian", 5, -2), Mode("phrygian", 6, -4), Mode("lydian", 7, 1),
        Mode("mixolydian", 8, -1), Mode("aeolian", 9, -3), Mode("locrian", 10, -5)]
    return Catalog(scales, chords, modes)

int | error named_index(string text, string kind, const Catalog catalog)
    string[] names = []
    if kind == "SCALE"
        for Scale item = catalog.scales[]
            names = names.append(item.name)
    elif kind == "QUALITY"
        for Chord item = catalog.chords[]
            names = names.append(item.name)
    else
        for Mode item = catalog.modes[]
            names = names.append(item.name)
    for nat index = names.indices()[]
        if names[index] == text
            return int(index)
    return error("BAD {kind} {text}")

Pitch[] | error build(Pitch root, const Tone[] tones)
    Pitch[] result = []
    for Tone tone = tones[]
        Pitch pitch = try root.raised(tone)
        result = result.append(pitch)
    return result

string pitches_text(const Pitch[] pitches)
    string[] parts = []
    for Pitch pitch = pitches[]
        parts = parts.append(pitch.text())
    return parts.join(" ")

string notes_text(const Note[] notes)
    string[] parts = []
    for Note note = notes[]
        parts = parts.append(note.text())
    return parts.join(" ")

string integer_list(const int[] values)
    string[] parts = []
    for int value = values[]
        parts = parts.append(value.string())
    return parts.join(",")

string chord_symbol(Pitch root, Chord chord, Pitch | none bass = none)
    string result = root.text() + chord.suffix
    match bass
        Pitch
            result += "/" + bass.text()
        none
            return result
    return result

string roman(int degree, Chord chord)
    string[] numerals = roman_names(chord.lower)
    return numerals[degree] + chord.numeral_suffix

class Key self(Pitch tonic, string mode, int fifths, Pitch[] scale)
    string text()
        return tonic.text() + " " + mode

    int degree(Pitch pitch)
        return modulo(pitch.letter - tonic.letter, 7)

    string prefix(Pitch pitch)
        int difference = pitch.alteration - scale[degree(pitch)].alteration
        return string.repeat(if difference < 0 then "b" else "#", nat(math.abs(difference)))

    string label(Pitch pitch)
        int number = degree(pitch) + 1
        return prefix(pitch) + number.string()

    bool[] classes()
        bool[] result = array(12, fill = false)
        for Pitch pitch = scale[]
            result[pitch.pitch_class()] = true
        return result

Key | error make_key(Pitch tonic, Mode mode, const Catalog catalog)
    int fifths = letter_fifths(tonic.letter) + 7 * tonic.alteration + mode.offset
    if fifths < -7 or fifths > 7
        return error("THEORETICAL KEY")
    Pitch[] scale = try build(tonic, catalog.scales[mode.scale].tones)
    return Key(tonic, mode.name, fifths, scale)

Key | error parse_key(const string[] words, int start, const Catalog catalog)
    Pitch tonic = try parse_pitch(words[start])
    int mode = try named_index(words[start + 1], "MODE", catalog)
    return make_key(tonic, catalog.modes[mode], catalog)

class Numeral(int alteration, int degree, int quality)
class Symbol(Pitch root, int quality)

Numeral | error parse_numeral(string text, const Catalog catalog)
    int start = 0
    int alteration = 0
    if text[0] == "b" or text[0] == "#"
        alteration = if text[0] == "b" then -1 else 1
        start = 1
    int end = start
    while end < int(len(text)) and "IViv".contains(text[end])
        end += 1
    string part = text[start:<end]
    string suffix = text[end:]
    for 0 <= int degree < 7
        for nat quality = catalog.chords.indices()[]
            Chord chord = catalog.chords[quality]
            string expected = roman_names(chord.lower)[degree]
            if part == expected and suffix == chord.numeral_suffix
                return Numeral(alteration, degree, int(quality))
    return error("BAD NUMERAL " + text)

Symbol | error parse_symbol(string text, const Catalog catalog)
    PitchPrefix parsed = try read_pitch(text, "SYMBOL")
    for nat quality = catalog.chords.indices()[]
        if catalog.chords[quality].suffix == text[parsed.end:]
            return Symbol(parsed.pitch, int(quality))
    return error("BAD SYMBOL " + text)

Note[] | error parse_notes(const string[] words)
    Note[] result = []
    for string word = words[]
        Note note = try parse_note(word)
        result = result.append(note)
    return result

Pitch[] | error parse_pitches(const string[] words)
    Pitch[] result = []
    for string word = words[]
        Pitch pitch = try parse_pitch(word)
        result = result.append(pitch)
    return result

int first_index(const int[] values, int sought)
    for nat index = values.indices()[]
        if values[index] == sought
            return int(index)
    return -1

string identify(const Note[] notes, const Catalog catalog)
    int width = int(len(notes))
    int[] order = []
    for 0 <= int index < width
        order = order.append(notes[index].midi() * width + index)
    order = order.sorted()
    Note[] candidates = []
    bool[] present = array(12, fill = false)
    for int rank = order[]
        Note note = notes[rank % width]
        int pitch_class = note.pitch.pitch_class()
        if not present[pitch_class]
            candidates = candidates.append(note)
            present[pitch_class] = true
    Pitch bass = candidates[0].pitch
    for Note root = candidates[]
        for Chord chord = catalog.chords[]
            bool[] possible = array(12, fill = false)
            for Tone tone = chord.tones[]
                possible[modulo(root.midi() + tone.semitones, 12)] = true
            if possible != present
                continue
            int inversion = 0
            while modulo(root.midi() + chord.tones[inversion].semitones, 12) != bass.pitch_class()
                inversion += 1
            Pitch | none slash = if inversion == 0 then none else bass
            string symbol = chord_symbol(root.pitch, chord, slash)
            return "IDENTIFY {symbol} root={root.pitch.text()} quality={chord.name} inversion={inversion}"
    return "IDENTIFY UNKNOWN"

string | error melody(const Note[] notes, const string[] words)
    int[] values = []
    for Note note = notes[]
        values = values.append(note.midi())
    int low = first_index(values, math.min_all(values))
    int high = first_index(values, math.max_all(values))
    Motion range = try between(notes[low], notes[high])
    int leaps = 0
    string[] steps = []
    for 1 <= int index < int(len(notes))
        Motion motion = try between(notes[index - 1], notes[index])
        steps = steps.append((if motion.down then "-" else "+") + motion.interval.text())
        if math.abs(values[index] - values[index - 1]) >= 3
            leaps += 1
    return "MELODY n={len(notes)} low={words[low]} high={words[high]} range={range.interval.text()} leaps={leaps} steps=" + steps.join(",")

string cadence(const Numeral[] numerals)
    if len(numerals) < 2
        return "none"
    Numeral first = numerals[len(numerals) - 2]
    Numeral second = numerals[len(numerals) - 1]
    if first.alteration == 0 and second.alteration == 0
        if first.degree == 4 and second.degree == 0
            return "authentic"
        if first.degree == 3 and second.degree == 0
            return "plagal"
        if first.degree == 4 and second.degree == 5
            return "deceptive"
    return if second.alteration == 0 and second.degree == 4 then "half" else "none"

string[] diatonic(Key key, const Catalog catalog)
    string[] rows = ["DIATONIC " + key.text()]
    for 3 <= int size <= 4
        string[] items = []
        for 0 <= int index < 7
            Pitch root = key.scale[index]
            int third = modulo(key.scale[(index + 2) % 7].pitch_class() - root.pitch_class(), 12)
            int fifth = modulo(key.scale[(index + 4) % 7].pitch_class() - root.pitch_class(), 12)
            int quality
            if size == 3
                quality = if third == 4 then 0 elif fifth == 7 then 1 else 2
            else
                int seventh = modulo(key.scale[(index + 6) % 7].pitch_class() - root.pitch_class(), 12)
                quality = if third == 4 then (if seventh == 11 then 9 else 8) elif fifth == 7 then 10 else 12
            Chord chord = catalog.chords[quality]
            items = items.append(roman(index, chord) + "=" + chord_symbol(root, chord))
        rows = rows.append((if size == 3 then "TRIADS " else "SEVENTHS ") + items.join(" "))
    return rows

class Calculator(int tuning = 44000)

string[] | error execute(Calculator &calculator, const Catalog catalog, const string[] words)
    string command = words[0]
    string[] commands = "MIDI NOTE FREQ TUNING PITCH INTERVAL INVERT TRANSPOSE SCALE CHORD VOICE IDENTIFY MELODY ENHARMONIC KEYSIG RELATIVE CIRCLE DIATONIC PROGRESSION ANALYZE FINDKEY DEGREE SPELL KEYDIST".split(" ")
    int[] minimum = [1,1,1,1,1,2,1,3,2,2,2,2,2,1,2,2,1,2,3,3,1,3,3,4]
    int[] maximum = [1,1,1,1,1,2,1,3,2,3,3,15,15,1,2,2,1,2,15,15,15,3,3,4]
    int command_index = -1
    for nat index = commands.indices()[]
        if command == commands[index]
            command_index = int(index)
            break
    if command_index < 0
        return error("UNKNOWN COMMAND " + command)
    int count = int(len(words)) - 1
    if count < minimum[command_index] or count > maximum[command_index]
        return error("ARGUMENT COUNT")
    string[] arguments = words[1:]
    if command == "MIDI" or command == "FREQ" or command == "ENHARMONIC"
        Note note = try parse_note(arguments[0])
        int value = note.midi()
        if command == "MIDI"
            return ["MIDI {arguments[0]} {value}"]
        if command == "FREQ"
            real64 exponent = real64(value - 69) / 12.0
            int cents = math.floor(real64(calculator.tuning) * (2.0 ^ exponent) + 0.5)
            return ["FREQ {arguments[0]} " + frequency_text(cents)]
        Note[] equivalents = []
        for -1 <= int octave <= 9
            for 0 <= int letter < 7
                int alteration = value - 12 * (octave + 1) - natural_pitch(letter)
                if -2 <= alteration <= 2
                    equivalents = equivalents.append(Note(Pitch(letter, alteration), octave))
        return ["ENHARMONIC {arguments[0]} " + notes_text(equivalents)]
    elif command == "NOTE"
        int value = try bounded_integer(arguments[0], "NUMBER", 0, 127)
        return ["NOTE {value} {spelling(value).text()} {spelling(value, true).text()}"]
    elif command == "TUNING" or command == "PITCH"
        int value = try parse_frequency(arguments[0], command == "TUNING")
        if command == "TUNING"
            calculator.tuning = value
            return ["TUNING " + frequency_text(value)]
        real64 ratio = real64(value) / real64(calculator.tuning)
        real64 height = 69.0 + 12.0 * math.log(ratio) / math.log(real64(2))
        int nearest = math.floor(height + 0.5)
        if nearest < 0 or nearest > 127
            return error("OUT OF RANGE")
        int cents = math.floor(100.0 * (height - real64(nearest)) + 0.5)
        string sign = if cents >= 0 then "+" else ""
        return ["PITCH " + frequency_text(value) + " {spelling(nearest).text()} {sign}{cents}"]
    elif command == "INTERVAL"
        Note first = try parse_note(arguments[0])
        Note second = try parse_note(arguments[1])
        Motion motion = try between(first, second)
        string direction = if motion.down then "down" else "up"
        return ["INTERVAL {arguments[0]} {arguments[1]} {motion.interval.text()} {direction} semitones={motion.semitones} simple={motion.interval.simple().text()} class={motion.interval.consonance()}"]
    elif command == "INVERT"
        Interval interval = try parse_interval(arguments[0])
        Interval simple = interval.simple()
        int[] inverses = [0, 2, 1, 4, 3, 6, 5]
        auto inverse = Interval(inverses[simple.quality], 9 - simple.number)
        if inverse.forbidden()
            return error("CANNOT INVERT")
        return ["INVERT {arguments[0]} {simple.text()} {inverse.text()}"]
    elif command == "TRANSPOSE"
        Note note = try parse_note(arguments[0])
        Interval interval = try parse_interval(arguments[1])
        if arguments[2] != "UP" and arguments[2] != "DOWN"
            return error("BAD DIRECTION " + arguments[2])
        int sign = if arguments[2] == "UP" then 1 else -1
        Tone tone = interval.tone()
        int target = note.position() + sign * tone.letters
        int value = note.midi() + sign * tone.semitones
        int letter = modulo(target, 7)
        int octave = floor_div(target, 7)
        int alteration = value - 12 * (octave + 1) - natural_pitch(letter)
        if alteration < -2 or alteration > 2
            return error("CANNOT SPELL")
        auto result = Note(Pitch(letter, alteration), octave)
        if not result.valid()
            return error("OUT OF RANGE")
        return ["TRANSPOSE {arguments[0]} {arguments[1]} {arguments[2]} {result.text()}"]
    elif command == "SCALE"
        Pitch root = try parse_pitch(arguments[0])
        int index = try named_index(arguments[1], "SCALE", catalog)
        Scale scale = catalog.scales[index]
        Pitch[] pitches = try build(root, scale.tones)
        int[] steps = []
        for nat tone_index = scale.tones.indices()[]
            int next = if tone_index + 1 < len(scale.tones) then scale.tones[tone_index + 1].semitones else 12
            steps = steps.append(next - scale.tones[tone_index].semitones)
        return ["SCALE {arguments[0]} {arguments[1]} " + pitches_text(pitches) + " steps=" + integer_list(steps)]
    elif command == "CHORD" or command == "VOICE"
        Pitch root
        int initial = 0
        if command == "VOICE"
            Note note = try parse_note(arguments[0])
            root = note.pitch
            initial = note.midi()
        else
            root = try parse_pitch(arguments[0])
        int quality = try named_index(arguments[1], "QUALITY", catalog)
        Chord chord = catalog.chords[quality]
        int inversion = 0
        if count == 3
            inversion = try bounded_integer(arguments[2], "INVERSION", 0, int(len(chord.tones)) - 1)
        Pitch[] tones = try build(root, chord.tones)
        Pitch[] ordered = []
        for 0 <= int index < int(len(tones))
            ordered = ordered.append(tones[(index + inversion) % int(len(tones))])
        Pitch | none bass = if inversion == 0 then none else ordered[0]
        string symbol = chord_symbol(root, chord, bass)
        if command == "CHORD"
            return ["CHORD {symbol} " + pitches_text(ordered)]
        Note[] notes = []
        int[] values = []
        int value = initial
        for nat index = ordered.indices()[]
            Pitch pitch = ordered[index]
            if index > 0 or inversion > 0
                int difference = modulo(pitch.pitch_class() - value, 12)
                value += if difference == 0 then 12 else difference
            Note note = make_note(pitch, value)
            if not note.valid()
                return error("OUT OF RANGE")
            notes = notes.append(note)
            values = values.append(value)
        return ["VOICE {symbol} " + notes_text(notes) + " midi=" + integer_list(values)]
    elif command == "IDENTIFY" or command == "MELODY"
        Note[] notes = try parse_notes(arguments)
        if command == "IDENTIFY"
            return [identify(notes, catalog)]
        string result = try melody(notes, arguments)
        return [result]
    elif command == "CIRCLE"
        int mode = try named_index(arguments[0], "MODE", catalog)
        Pitch[] pitches = []
        for -7 <= int fifths <= 7
            pitches = pitches.append(fifth_pitch(fifths - catalog.modes[mode].offset))
        return ["CIRCLE {arguments[0]} " + pitches_text(pitches)]
    elif command == "FINDKEY"
        Pitch[] pitches = try parse_pitches(arguments)
        string[] keys = []
        for -7 <= int fifths <= 7
            for 0 <= int mode < 2
                Key key = try make_key(fifth_pitch(fifths - catalog.modes[mode].offset), catalog.modes[mode], catalog)
                bool contains_all = true
                for Pitch pitch = pitches[]
                    Pitch expected = key.scale[key.degree(pitch)]
                    if pitch.alteration != expected.alteration
                        contains_all = false
                if contains_all
                    keys = keys.append(key.text())
        return ["FINDKEY {len(keys)}" + (if len(keys) == 0 then "" else " " + keys.join(", "))]
    elif command == "SPELL"
        int value = try bounded_integer(arguments[0], "NUMBER", 0, 127)
        Key key = try parse_key(arguments, 1, catalog)
        Pitch pitch = spelling(value, key.fifths < 0).pitch
        for Pitch candidate = key.scale[]
            if candidate.pitch_class() == value % 12
                pitch = candidate
                break
        Note note = make_note(pitch, value)
        if not note.valid()
            return error("OUT OF RANGE")
        return ["SPELL {value} {key.text()} {note.text()} {key.label(pitch)}"]
    else
        Key key = try parse_key(arguments, 0, catalog)
        if command == "KEYSIG"
            int value = key.fifths
            if value == 0
                return ["KEYSIG {key.text()} none"]
            string[] names = if value > 0 then ["F#", "C#", "G#", "D#", "A#", "E#", "B#"] else ["Bb", "Eb", "Ab", "Db", "Gb", "Cb", "Fb"]
            string kind = if value > 0 then "sharps" else "flats"
            return ["KEYSIG {key.text()} {kind}={math.abs(value)} " + names[0:<math.abs(value)].join(" ")]
        elif command == "RELATIVE"
            return ["RELATIVE {key.text()} major={fifth_pitch(key.fifths).text()} minor={fifth_pitch(key.fifths + 3).text()}"]
        elif command == "DIATONIC"
            return diatonic(key, catalog)
        elif command == "DEGREE"
            Pitch pitch = try parse_pitch(arguments[2])
            return ["DEGREE {key.text()} {pitch.text()} {key.label(pitch)}"]
        elif command == "KEYDIST"
            Key other = try parse_key(arguments, 2, catalog)
            int distance = modulo(other.fifths - key.fifths, 12)
            if distance > 6
                distance -= 12
            bool[] first_set = key.classes()
            bool[] second_set = other.classes()
            int common = 0
            for nat index = first_set.indices()[]
                if first_set[index] and second_set[index]
                    common += 1
            bool same_tonic = key.tonic.pitch_class() == other.tonic.pitch_class()
            string relation
            if first_set == second_set
                relation = if same_tonic then "same" else "relative"
            elif same_tonic
                relation = "parallel"
            else
                relation = if math.abs(distance) == 1 then "close" else "distant"
            string sign = if distance > 0 then "+" else ""
            return ["KEYDIST {key.text()} {other.text()} fifths={sign}{distance} common={common} relation={relation}"]
        elif command == "ANALYZE"
            Symbol[] symbols = []
            for string word = arguments[2:][]
                Symbol parsed = try parse_symbol(word, catalog)
                symbols = symbols.append(parsed)
            string[] numerals = []
            for Symbol symbol = symbols[]
                numerals = numerals.append(key.prefix(symbol.root) + roman(key.degree(symbol.root), catalog.chords[symbol.quality]))
            return ["ANALYZE {key.text()} " + numerals.join(" ")]
        else
            Numeral[] numerals = []
            for string word = arguments[2:][]
                Numeral parsed = try parse_numeral(word, catalog)
                numerals = numerals.append(parsed)
            string[] rows = ["PROGRESSION {key.text()} {len(numerals)}"]
            for nat index = numerals.indices()[]
                Numeral numeral = numerals[index]
                Pitch root = key.scale[numeral.degree]
                root.alteration += numeral.alteration
                Chord chord = catalog.chords[numeral.quality]
                Pitch[] tones = try build(root, chord.tones)
                rows = rows.append(arguments[index + 2] + " " + chord_symbol(root, chord) + " " + pitches_text(tones))
            rows = rows.append("CADENCE " + cadence(numerals))
            return rows

const Catalog theory_catalog = make_catalog()
auto music_calculator = Calculator()
int command_count
scan(&command_count)
for 0 <= int command_index < command_count
    string command_line
    scan(&command_line)
    match execute(&music_calculator, theory_catalog, command_line.split(" "))
        string[] rows
            for string row = rows[]
                print(row + NL)
        error problem
            print("ERROR " + problem.message + NL)
