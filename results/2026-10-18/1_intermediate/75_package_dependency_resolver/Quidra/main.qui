void emit(string text)
    print(text + NL)

bool contains_text(string[] items, string value)
    for string item = items[]
        if item == value
            return true
    return false

bool numeric_text(string text)
    if text == ""
        return false
    for string ch = text[]
        if ch < "0" or ch > "9"
            return false
    return true

bool number_part(string text)
    return len(text) <= 4 and numeric_text(text) and (len(text) == 1 or text[0] != "0")

class Version(int[] core, string[] pre)
    string core_text()
        return [for int value = core[] then value.string()].join(".")

    string notation()
        return core_text() + (if len(pre) == 0 then "" else "-" + pre.join("."))

Version | none parse_version(string text)
    string[] halves = text.split("-")
    if len(halves) > 2
        return none
    string[] parts = halves[0].split(".")
    if len(parts) != 3
        return none
    for string part = parts[]
        if not number_part(part)
            return none
    string[] pre = []
    if len(halves) == 2
        pre = halves[1].split(".")
        for string item = pre[]
            if item == ""
                return none
            for string ch = item[]
                if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "z"))
                    return none
            if numeric_text(item) and not number_part(item)
                return none
    return Version([for string part = parts[] then int.parse(part)], pre)

Version | error require_version(string text)
    match parse_version(text)
        Version value
            return value
        none
            return error("invalid version '{text}'")

int compare_versions(Version first, Version second)
    for nat i < 3
        if first.core[i] != second.core[i]
            return if first.core[i] < second.core[i] then -1 else 1
    if (len(first.pre) == 0) != (len(second.pre) == 0)
        return if len(first.pre) == 0 then 1 else -1
    for string item = first.pre[nat i]
        if i == len(second.pre)
            return 1
        string other = second.pre[i]
        if item == other
            continue
        bool first_numeric = numeric_text(item)
        bool second_numeric = numeric_text(other)
        if first_numeric != second_numeric
            return if first_numeric then -1 else 1
        if first_numeric
            return if int.parse(item) < int.parse(other) then -1 else 1
        return if item < other then -1 else 1
    return if len(first.pre) == len(second.pre) then 0 else -1

Version upper_version(Version value, nat index)
    int[] core = value.core
    core[index] += 1
    for index + 1 <= nat i < 3
        core[i] = 0
    return Version(core, [])

class Comparator(string op, Version bound)
    bool accepts(Version value)
        int comparison = compare_versions(value, bound)
        if op == "="
            return comparison == 0
        if op == ">"
            return comparison > 0
        if op == ">="
            return comparison >= 0
        if op == "<"
            return comparison < 0
        return comparison <= 0

class Alternative(Comparator[] comparisons, string[] pre_cores)
    bool accepts(Version value)
        if len(value.pre) > 0 and not contains_text(pre_cores, value.core_text())
            return false
        for Comparator comparison = comparisons[]
            if not comparison.accepts(value)
                return false
        return true

    string notation()
        return if len(comparisons) == 0 then "*" else [for Comparator comparison = comparisons[] then comparison.op + comparison.bound.notation()].join(" ")

class Constraint(string text, Alternative[] alternatives)
    bool accepts(Version value)
        for Alternative alternative = alternatives[]
            if alternative.accepts(value)
                return true
        return false

    string normal_form()
        return [for Alternative alternative = alternatives[] then alternative.notation()].join(" || ")

Alternative | none parse_term(string term)
    string op = ""
    string pattern = term
    for string symbol = [">=", "<=", ">", "<", "=", "^", "~"][]
        if term.starts_with(symbol)
            op = symbol
            pattern = term[len(symbol):]
            break
    Version lower = Version([0, 0, 0], [])
    string[] pre_cores = []
    nat count = 0
    match parse_version(pattern)
        Version value
            if len(value.pre) > 0
                lower = value
                count = 3
                pre_cores = [value.core_text()]
        none
            void
    if count == 0
        string[] parts = pattern.split(".")
        if len(parts) == 0 or len(parts) > 3
            return none
        bool wildcard = false
        for string part = parts[]
            if number_part(part) and not wildcard
                lower.core[count] = int.parse(part)
                count += 1
            elif part == "x" or part == "*"
                wildcard = true
            else
                return none
    Comparator[] comparisons = []
    if count == 0
        if op == ">" or op == "<"
            comparisons = [Comparator("<", Version([0, 0, 0], ["0"]))]
    elif op == "" or op == "="
        comparisons = if count == 3 then [Comparator("=", lower)] else [Comparator(">=", lower), Comparator("<", upper_version(lower, count - 1))]
    elif op == ">"
        comparisons = if count == 3 then [Comparator(">", lower)] else [Comparator(">=", upper_version(lower, count - 1))]
    elif op == "<="
        comparisons = if count == 3 then [Comparator("<=", lower)] else [Comparator("<", upper_version(lower, count - 1))]
    elif op == ">=" or op == "<"
        comparisons = [Comparator(op, lower)]
    else
        nat index = 0
        if op == "~"
            index = if count == 1 then 0 else 1
        elif lower.core[0] != 0 or count == 1
            index = 0
        elif lower.core[1] != 0 or count == 2
            index = 1
        else
            index = 2
        comparisons = [Comparator(">=", lower), Comparator("<", upper_version(lower, index))]
    return Alternative(comparisons, pre_cores)

Constraint | error require_constraint(string text)
    Alternative[] alternatives = []
    for string part = text.split(" || ")[]
        Comparator[] comparisons = []
        string[] cores = []
        for string term = part.split(" ")[]
            match parse_term(term)
                Alternative value
                    comparisons = comparisons.concat(value.comparisons)
                    cores = cores.concat(value.pre_cores)
                none
                    return error("invalid constraint '{text}'")
        alternatives = alternatives.append(Alternative(comparisons, cores))
    return Constraint(text, alternatives)

class Link(string name, Constraint constraint)
class Release(string name, Version version, Link[] dependencies, Link[] conflicts)
    bool yanked = false
class Snapshot(Link[] requests, map.Map<string, nat> installed)
class Requirement(Link link, string[] chain)

int mapped_index(map.Map<string, nat> items, string name)
    match items.get(name)
        nat value
            return int(value)
        none
            return -1

nat[] newest_indices(Release[] registry, string name)
    nat[] result = []
    for Release item = registry[nat i]
        if item.name == name
            nat index = 0
            while index < len(result) and compare_versions(item.version, registry[result[index]].version) < 0
                index += 1
            result = result[:<index].append(i).concat(result[index:])
    return result

string[] advisory_ids(Release[] registry, map.Map<string, Link> advisories, nat index)
    Release item = registry[index]
    string[] result = []
    for string identifier = advisories.keys().sorted()[]
        match advisories.get(identifier)
            Link link
                if link.name == item.name and link.constraint.accepts(item.version)
                    result = result.append(identifier)
            none
                void
    return result

string[] dependency_names(Release[] registry, map.Map<string, nat> installed, string name)
    return [for Link link = registry[nat(mapped_index(installed, name))].dependencies[] then link.name]

class Resolver(Release[] registry, map.Map<string, nat> installed, string[] held, map.Map<string, Link> advisories, string[] preferred, bool audit_mode)
    map.Map<string, nat> selected
    map.Map<string, string[]> chains
    int failure_size = -1
    string[] failure_lines = []

    bool usable(nat index)
        Release item = registry[index]
        return (not item.yanked or mapped_index(installed, item.name) == int(index)) and (not audit_mode or len(advisory_ids(registry, advisories, index)) == 0)

    bool .record_failure(Requirement requirement, string reason, string culprit = "")
        if int(selected.size()) > failure_size
            failure_size = int(selected.size())
            failure_lines = ["UNSATISFIABLE"].concat([for string line = requirement.chain[] then "  " + line]).append("  " + reason)
            if culprit != ""
                match chains.get(culprit)
                    string[] lines
                        failure_lines = failure_lines.concat([for string line = lines[] then "    " + line])
                    none
                        void
        return false

    bool .search_branch(Requirement[] pending)
        if len(pending) == 0
            return true
        Requirement requirement = pending[0]
        string name = requirement.link.name
        Constraint condition = requirement.link.constraint
        Requirement[] rest = pending[1:]
        int chosen = mapped_index(selected, name)
        if chosen >= 0
            Release item = registry[nat(chosen)]
            if condition.accepts(item.version)
                return .search_branch(rest)
            return .record_failure(requirement, "{name}@{item.version.notation()} was selected by:", name)
        nat[] candidates = []
        if contains_text(held, name)
            nat index = nat(mapped_index(installed, name))
            if not condition.accepts(registry[index].version) or not usable(index)
                return .record_failure(requirement, "{name}@{registry[index].version.notation()} is held")
            candidates = [index]
        else
            candidates = [for nat index = newest_indices(registry, name)[] if condition.accepts(registry[index].version) and usable(index) then index]
            int previous = mapped_index(installed, name)
            if contains_text(preferred, name) and previous >= 0
                nat[] matching = [for nat index = candidates[] if int(index) == previous then index]
                if len(matching) > 0
                    candidates = matching.concat([for nat index = candidates[] if int(index) != previous then index])
            if len(candidates) == 0
                return .record_failure(requirement, "no version of {name} matches {condition.text}")
        for nat index = candidates[]
            Release item = registry[index]
            string culprit = ""
            for string other = selected.keys().sorted()[]
                Release old = registry[nat(mapped_index(selected, other))]
                bool conflict = false
                for Link link = item.conflicts[]
                    if link.name == other and link.constraint.accepts(old.version)
                        conflict = true
                for Link link = old.conflicts[]
                    if link.name == name and link.constraint.accepts(item.version)
                        conflict = true
                if conflict
                    culprit = other
                    break
            if culprit != ""
                Release old = registry[nat(mapped_index(selected, culprit))]
                bool recorded = .record_failure(requirement, "{name}@{item.version.notation()} conflicts with {culprit}@{old.version.notation()}, which was selected by:", culprit)
                continue
            .selected.set(name, index)
            .chains.set(name, requirement.chain)
            Requirement[] following = [for Link link = item.dependencies[] then Requirement(link, requirement.chain.append("{name}@{item.version.notation()} requires {link.name} {link.constraint.text}"))]
            if .search_branch(following.concat(rest))
                return true
            bool removed_selection = .selected.remove(name)
            bool removed_chain = .chains.remove(name)
        return false

class Manager()
    Release[] registry = []
    Link[] requests = []
    map.Map<string, nat> installed
    string[] held = []
    map.Map<string, Link> advisories
    Snapshot[] history = []

    string[] known_names()
        string[] result = []
        for Release item = registry[]
            if not contains_text(result, item.name)
                result = result.append(item.name)
        return result.sorted()

    nat | error find_release(string name, string text)
        for Release item = registry[nat i]
            if item.name == name and item.version.notation() == text
                return i
        return error("{name}@{text} is not registered")

    nat | error require_installed(string name)
        int index = mapped_index(installed, name)
        if index < 0
            return error("{name} is not installed")
        return nat(index)

    string display_release(nat index)
        Release item = registry[index]
        string[] notes = []
        if item.yanked
            notes = notes.append("yanked")
        if mapped_index(installed, item.name) == int(index)
            notes = notes.append("installed")
        return "{item.name}@{item.version.notation()}" + (if len(notes) == 0 then "" else " ({notes.join(", ")})")

    string first_dependent(string name)
        for string other = installed.keys().sorted()[]
            if contains_text(dependency_names(registry, installed, other), name)
                return other
        return ""

    string[] reachable(string[] roots)
        string[] found = []
        string[] queue = roots
        nat at = 0
        while at < len(queue)
            string name = queue[at]
            at += 1
            if not contains_text(found, name)
                found = found.append(name)
                queue = queue.concat(dependency_names(registry, installed, name))
        return found

    string[] plan(map.Map<string, nat> replacement)
        string[] lines = []
        nat[] totals = [0, 0, 0, 0]
        string[] pending = replacement.keys().sorted()
        while len(pending) > 0
            string chosen = ""
            for string name = pending[]
                bool ready = true
                for string dep = dependency_names(registry, replacement, name)[]
                    if contains_text(pending, dep)
                        ready = false
                if ready
                    chosen = name
                    break
            pending = [for string name = pending[] if name != chosen then name]
            Release item = registry[nat(mapped_index(replacement, chosen))]
            int previous = mapped_index(installed, chosen)
            if previous < 0
                lines = lines.append("install {chosen}@{item.version.notation()}")
                totals[0] += 1
            elif mapped_index(replacement, chosen) != previous
                Release old = registry[nat(previous)]
                bool upgrade = compare_versions(item.version, old.version) > 0
                string word = if upgrade then "upgrade" else "downgrade"
                lines = lines.append("{word} {chosen} {old.version.notation()} -> {item.version.notation()}")
                totals[if upgrade then 1 else 2] += 1
        pending = [for string name = installed.keys().sorted()[] if not replacement.has(name) then name]
        while len(pending) > 0
            string chosen = ""
            for string name = pending[]
                bool ready = true
                for string other = pending[]
                    if contains_text(dependency_names(registry, installed, other), name)
                        ready = false
                if ready
                    chosen = name
                    break
            pending = [for string name = pending[] if name != chosen then name]
            lines = lines.append("remove {chosen}@{registry[nat(mapped_index(installed, chosen))].version.notation()}")
            totals[3] += 1
        return if len(lines) == 0 then ["no changes"] else lines.append("{totals[0]} installed, {totals[1]} upgraded, {totals[2]} downgraded, {totals[3]} removed")

    void .update_state(Link[] next_requests, map.Map<string, nat> next_installed)
        history = history.append(Snapshot(requests, installed))
        requests = next_requests
        installed = next_installed
        held = [for string name = held[] if installed.has(name) then name]

    string[] .resolve_requests(Link[] next_requests, string[] preferred, bool audit_mode = false, bool apply_state = true)
        Resolver resolver = Resolver(registry, installed, held, advisories, preferred, audit_mode)
        Requirement[] pending = [for Link link = next_requests[] then Requirement(link, ["requested {link.name} {link.constraint.text}"])]
        if not .resolver.search_branch(pending)
            return resolver.failure_lines
        string[] lines = plan(resolver.selected)
        if apply_state
            .update_state(next_requests, resolver.selected)
        return lines

    string[] .tree_branch(string name, string condition, string prefix, string indent, string[] &shown)
        Release item = registry[nat(mapped_index(installed, name))]
        string body = "{prefix}{name}@{item.version.notation()}" + (if condition == "" then "" else " [{condition}]")
        if contains_text(shown, name)
            return [body + " (*)"]
        shown = shown.append(name)
        string[] lines = [body]
        for Link link = item.dependencies[nat i]
            bool last = i + 1 == len(item.dependencies)
            string branch = if last then "`-- " else "|-- "
            string extension = if last then "    " else "|   "
            lines = lines.concat(.tree_branch(link.name, link.constraint.text, indent + branch, indent + extension, &shown))
        return lines

    string[] | error .execute(string line)
        string[] words = line.split(" ")
        string command = words[0]
        string[] args = words[1:]
        string rest = args.join(" ")
        string name = if len(args) > 0 then args[0] else ""
        string[] lines = []
        if command == "PKG"
            string[] clauses = rest.split("; ")
            string[] head = clauses[0].split(" ")
            Version value = try require_version(head[1])
            for Release item = registry[]
                if item.name == name and item.version.notation() == head[1]
                    return error("{name}@{head[1]} is already registered")
            Link[] deps = []
            Link[] conflicts = []
            for string clause = clauses[1:][]
                string[] parts = clause.split(" ")
                Constraint condition = try require_constraint(parts[2:].join(" "))
                Link link = Link(parts[1], condition)
                if parts[0] == "DEP"
                    deps = deps.append(link)
                else
                    conflicts = conflicts.append(link)
            registry = registry.append(Release(name, value, deps, conflicts))
            return ["registered {name}@{head[1]}"]
        if command == "YANK" or command == "INFO"
            nat index = try find_release(name, args[1])
            if command == "YANK"
                if registry[index].yanked
                    return error("{name}@{args[1]} is already yanked")
                registry[index].yanked = true
                return ["yanked {name}@{args[1]}"]
            Release item = registry[index]
            lines = [display_release(index)]
            lines = lines.concat([for Link link = item.dependencies[] then "  requires {link.name} {link.constraint.text}"])
            lines = lines.concat([for Link link = item.conflicts[] then "  conflicts with {link.name} {link.constraint.text}"])
            return lines.concat([for string identifier = advisory_ids(registry, advisories, index)[] then "  advisory {identifier}"])
        if command == "VERSIONS"
            bool filtered = len(args) > 1
            Constraint condition = try require_constraint(if filtered then args[1:].join(" ") else "*")
            if not contains_text(known_names(), name)
                return error("unknown package {name}")
            for nat index = newest_indices(registry, name)[]
                if not filtered or condition.accepts(registry[index].version)
                    lines = lines.append(display_release(index))
            return if len(lines) == 0 then ["no matching versions"] else lines
        if command == "DEPENDENTS"
            bool filtered = len(args) > 1
            Version value = try require_version(if filtered then args[1] else "0.0.0")
            for string other = known_names()[]
                for nat index = newest_indices(registry, other)[]
                    for Link link = registry[index].dependencies[]
                        if link.name == name and (not filtered or link.constraint.accepts(value))
                            lines = lines.append("{other}@{registry[index].version.notation()} requires {name} {link.constraint.text}")
            return if len(lines) == 0 then ["no dependents"] else lines
        if command == "COMPARE"
            Version first = try require_version(name)
            Version second = try require_version(args[1])
            int comparison = compare_versions(first, second)
            string symbol = if comparison < 0 then "<" else (if comparison > 0 then ">" else "=")
            return ["{name} {symbol} {args[1]}"]
        if command == "MATCH"
            Version value = try require_version(name)
            Constraint condition = try require_constraint(args[1:].join(" "))
            return [if condition.accepts(value) then "yes" else "no"]
        if command == "RANGE"
            Constraint condition = try require_constraint(rest)
            return [condition.normal_form()]
        if command == "INSTALL" or command == "SIMULATE"
            Constraint condition = try require_constraint(if len(args) > 1 then args[1:].join(" ") else "*")
            if not contains_text(known_names(), name)
                return error("unknown package {name}")
            Link[] next_requests = requests
            bool replaced = false
            for Link link = next_requests[nat i]
                if link.name == name
                    next_requests[i] = Link(name, condition)
                    replaced = true
            if not replaced
                next_requests = next_requests.append(Link(name, condition))
            return .resolve_requests(next_requests, installed.keys(), apply_state = command == "INSTALL")
        if command == "REMOVE"
            bool requested = false
            for Link link = requests[]
                if link.name == name
                    requested = true
            if not requested
                if installed.has(name)
                    return error("{name} is required by {first_dependent(name)}")
                return error("{name} is not installed")
            Link[] next_requests = [for Link link = requests[] if link.name != name then link]
            string[] kept = reachable([for Link link = next_requests[] then link.name])
            map.Map<string, nat> next_installed
            if contains_text(kept, name)
                lines = ["{name}@{registry[nat(mapped_index(installed, name))].version.notation()} is still required by {first_dependent(name)}"]
                next_installed = installed
            else
                for string other = kept[]
                    .next_installed.set(other, nat(mapped_index(installed, other)))
                lines = plan(next_installed)
            .update_state(next_requests, next_installed)
            return lines
        if command == "UPGRADE"
            string[] preferred = []
            if name != ""
                nat index = try require_installed(name)
                preferred = [for string other = installed.keys()[] if other != name then other]
            return .resolve_requests(requests, preferred)
        if command == "ROLLBACK"
            if len(history) == 0
                return error("nothing to roll back")
            Snapshot snapshot = history[len(history) - 1]
            lines = plan(snapshot.installed)
            history = history[:<len(history) - 1]
            requests = snapshot.requests
            installed = snapshot.installed
            held = [for string other = held[] if installed.has(other) then other]
            return lines
        if command == "HOLD"
            nat index = try require_installed(name)
            if contains_text(held, name)
                return error("{name} is already held")
            held = held.append(name)
            return ["held {name}@{registry[index].version.notation()}"]
        if command == "UNHOLD"
            if not contains_text(held, name)
                return error("{name} is not held")
            held = [for string other = held[] if other != name then other]
            return ["released {name}"]
        if command == "WHY"
            nat index = try require_installed(name)
            string[] roots = [for Link link = requests[] then link.name]
            if contains_text(roots, name)
                return ["{name}@{registry[index].version.notation()} is explicitly installed"]
            map.Map<string, string> parents
            string[] queue = roots.sorted()
            for string root = roots[]
                .parents.set(root, "")
            nat at = 0
            while at < len(queue)
                string current = queue[at]
                at += 1
                for string dep = dependency_names(registry, installed, current).sorted()[]
                    if not parents.has(dep)
                        .parents.set(dep, current)
                        queue = queue.append(dep)
            string[] path = [name]
            string current = name
            while true
                string parent = ""
                match parents.get(current)
                    string value
                        parent = value
                    none
                        void
                if parent == ""
                    break
                path = path.append(parent)
                current = parent
            return [[for string other = path[::-1][] then "{other}@{registry[nat(mapped_index(installed, other))].version.notation()}"].join(" -> ")]
        if command == "TREE"
            string[] roots = [for Link link = requests[] then link.name].sorted()
            if name != ""
                nat index = try require_installed(name)
                roots = [name]
            string[] shown = []
            for string root = roots[]
                string condition = ""
                for Link link = requests[]
                    if link.name == root
                        condition = link.constraint.text
                lines = lines.concat(.tree_branch(root, condition, "", "", &shown))
            return if len(lines) == 0 then ["(empty)"] else lines
        if command == "OUTDATED"
            for string other = installed.keys().sorted()[]
                nat current = nat(mapped_index(installed, other))
                Constraint[] conditions = [for Link link = requests[] if link.name == other then link.constraint]
                for string package = installed.keys()[]
                    for Link link = registry[nat(mapped_index(installed, package))].dependencies[]
                        if link.name == other
                            conditions = conditions.append(link.constraint)
                nat wanted = current
                int latest = -1
                bool wanted_set = false
                for nat index = newest_indices(registry, other)[]
                    Release item = registry[index]
                    bool accepted = not item.yanked or index == current
                    for Constraint condition = conditions[]
                        if not condition.accepts(item.version)
                            accepted = false
                    if accepted and not wanted_set
                        wanted = index
                        wanted_set = true
                    if latest < 0 and len(item.version.pre) == 0 and not item.yanked
                        latest = int(index)
                if wanted != current or (latest >= 0 and compare_versions(registry[nat(latest)].version, registry[current].version) > 0)
                    string latest_text = if latest < 0 then "-" else registry[nat(latest)].version.notation()
                    lines = lines.append("{other} {registry[current].version.notation()} {registry[wanted].version.notation()} {latest_text}")
            return if len(lines) == 0 then ["all packages are up to date"] else lines
        if command == "LOCK"
            lines = [for string other = installed.keys().sorted()[] then "{other}@{registry[nat(mapped_index(installed, other))].version.notation()}"]
            return if len(lines) == 0 then ["(empty)"] else lines
        if command == "STATUS"
            lines = [for Link link = requests[] then "{link.name} {link.constraint.text} -> {registry[nat(mapped_index(installed, link.name))].version.notation()}"]
            if len(lines) == 0
                lines = ["no requests"]
            return lines.append("{installed.size()} installed, {len(held)} held, {len(history)} snapshots")
        if command == "ADVISORY"
            if advisories.has(name)
                return error("advisory {name} already exists")
            Constraint condition = try require_constraint(args[2:].join(" "))
            .advisories.set(name, Link(args[1], condition))
            return ["advisory {name} recorded"]
        if command == "AUDIT"
            if name == "FIX"
                return .resolve_requests(requests, installed.keys(), audit_mode = true)
            for string other = installed.keys().sorted()[]
                nat current = nat(mapped_index(installed, other))
                string[] identifiers = advisory_ids(registry, advisories, current)
                if len(identifiers) == 0
                    continue
                string fix = "no fix"
                for nat index = newest_indices(registry, other)[::-1][]
                    Release item = registry[index]
                    if compare_versions(item.version, registry[current].version) > 0 and len(item.version.pre) == 0 and not item.yanked and len(advisory_ids(registry, advisories, index)) == 0
                        fix = "fix: {item.version.notation()}"
                        break
                lines = lines.append("{other}@{registry[current].version.notation()}: {identifiers.join(", ")} ({fix})")
            return if len(lines) == 0 then ["no known vulnerabilities"] else lines
        return lines

auto manager = Manager()
nat count
scan(&count)
for nat i < count
    string line
    scan(&line)
    match .manager.execute(line)
        string[] lines
            for string text = lines[]
                emit(text)
        error issue
            emit("error: {issue.message}")
