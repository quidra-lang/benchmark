import math

// Registry slots are indexed; all sequence algorithms use exact integer state.
int character_index(string alphabet, string character)
    if len(character) != 1
        return -1
    match alphabet.find(character)
        nat position
            return int(position)
        none
            return -1

int decimal_value(string text)
    return int.parse(text)

int number_value(string text)
    bool negative = text.starts_with("-")
    string digits = if negative then text[1:] else text
    if len(digits) < 1 or len(digits) > 6
        return 1000000000
    for 0 <= int k < int(len(digits))
        if character_index("0123456789", digits[k]) < 0
            return 1000000000
    int value = decimal_value(digits)
    return if negative then -value else value

string hundredths(int value)
    return "{value / 100}.{value % 100:int=2,zero}"

string percentage(int numerator, int denominator)
    return hundredths(10000 * numerator / denominator)

string milli(int value)
    return "{value / 1000}.{value % 1000:int=3,zero}"

string tenths(int value)
    return "{value / 10}.{value % 10}"

string numbers(int[] values)
    if len(values) == 0
        return "none"
    return [for int value = values[] then value.string()].join(" ")

int[] ordered_numbers(int[] values, bool descending = false)
    for 1 <= int k < int(len(values))
        int item = values[k]
        int position = k
        while position > 0 and (if descending then values[position - 1] < item else values[position - 1] > item)
            values[position] = values[position - 1]
            position -= 1
        values[position] = item
    return values

bool lexical_before(string a, string b)
    int[] aa = a.codepoints()
    int[] bb = b.codepoints()
    for 0 <= int k < math.min(int(len(aa)), int(len(bb)))
        if aa[k] != bb[k]
            return aa[k] < bb[k]
    return len(aa) < len(bb)

string complement(string sequence)
    string symbols = "ACGTRYWSKMBDHVN"
    string partners = "TGCAYRWSMKVHDBN"
    return [for 0 <= int k < int(len(sequence)) then partners[character_index(symbols, sequence[k])]].join("")

string reverse_complement(string sequence)
    return complement(sequence)[::-1]

bool transition(string a, string b)
    return a != b and (("AG".contains(a) and "AG".contains(b)) or ("CT".contains(a) and "CT".contains(b)))

string symbol_bases(string symbol)
    string[] sets = ["A", "C", "G", "T", "AG", "CT", "AT", "CG", "GT", "AC", "CGT", "AGT", "ACT", "ACG", "ACGT"]
    return sets[character_index("ACGTRYWSKMBDHVN", symbol)]

int[] occurrences(string sequence, string motif)
    int[] result = []
    for 0 <= int start <= int(len(sequence)) - int(len(motif))
        bool matches = true
        for 0 <= int k < int(len(motif))
            if not symbol_bases(motif[k]).contains(sequence[start + k])
                matches = false
                break
        if matches
            result = result.append(start + 1)
    return result

string amino_acid(string codon)
    string bases = "TCAG"
    string table = "FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG"
    int index = 16 * character_index(bases, codon[0]) + 4 * character_index(bases, codon[1]) + character_index(bases, codon[2])
    return table[index]

string[] codon_list(string sequence, int frame)
    string strand = if frame < 0 then reverse_complement(sequence) else sequence
    string[] result = []
    int position = math.abs(frame) - 1
    while position + 3 <= int(len(strand))
        result = result.append(strand[position:<position + 3])
        position += 3
    return result

string translate(string[] codons)
    return [for string codon = codons[] then amino_acid(codon)].join("")

int[] composition(string sequence)
    int[] result = array(4, fill = 0)
    for 0 <= int k < int(len(sequence))
        result[character_index("ACGT", sequence[k])] += 1
    return result

int gc_count(string sequence)
    int[] counts = composition(sequence)
    return counts[1] + counts[2]

int melting_temperature(string sequence)
    int count = int(len(sequence))
    int gc = gc_count(sequence)
    return if count < 14 then 10 * (2 * (count - gc) + 4 * gc) else (649 * count + 410 * gc - 6724) / count

int sequence_mass(string sequence)
    int[] masses = [331222, 307197, 347221, 322208]
    int[] weights = [for 0 <= int k < int(len(sequence)) then masses[character_index("ACGT", sequence[k])]]
    return weights.sum() - (int(len(sequence)) - 1) * 18015

int repeat_count(string sequence, int start, int width)
    int count = 1
    string unit = sequence[start:<start + width]
    while start + (count + 1) * width <= int(len(sequence)) and sequence[start + count * width:<start + (count + 1) * width] == unit
        count += 1
    return count

bool primitive(string unit)
    int width = int(len(unit))
    for 1 <= int divisor < width
        if width % divisor != 0
            continue
        bool equal = true
        for divisor <= int k < width
            if unit[k] != unit[k % divisor]
                equal = false
        if equal
            return false
    return true

class Registry()
    string[] names = array(400, fill = "")
    string[] sequences = array(400, fill = "")
    int used = 0

int sequence_id(const Registry registry, string name)
    for 0 <= int k < registry.used
        if registry.names[k] == name
            return k
    return -1

bool valid_name(string name)
    if len(name) < 1 or len(name) > 10 or character_index("abcdefghijklmnopqrstuvwxyz", name[0]) < 0
        return false
    for 1 <= int k < int(len(name))
        if character_index("abcdefghijklmnopqrstuvwxyz0123456789", name[k]) < 0
            return false
    return true

string registration(Registry &registry, string name, string sequence)
    if len(sequence) > 500
        return "ERROR too long"
    int index = sequence_id(registry, name)
    bool replacing = index >= 0
    if index < 0
        index = registry.used
        registry.used += 1
    registry.names[index] = name
    registry.sequences[index] = sequence
    return (if replacing then "replaced " else "stored ") + name + " " + len(sequence).string() + " nt"

class Command(string name, int least, int most, string kinds)

Command[] commands()
    return [
        Command("SEQ", 2, 2, "NS"),
        Command("SLICE", 4, 4, "RIIN"),
        Command("JOIN", 3, 9, "NR"),
        Command("MUTATE", 3, 3, "RIB"),
        Command("DEL", 1, 1, "R"),
        Command("LIST", 0, 0, ""),
        Command("REVCOMP", 1, 1, "R"),
        Command("COMPLEMENT", 1, 1, "R"),
        Command("REVERSE", 1, 1, "R"),
        Command("TRANSCRIBE", 1, 1, "R"),
        Command("TRANSLATE", 2, 2, "RI"),
        Command("CODONS", 2, 2, "RI"),
        Command("PROTEIN", 2, 2, "RI"),
        Command("ORFS", 2, 2, "RI"),
        Command("GC", 1, 1, "R"),
        Command("GCWINDOW", 3, 3, "RII"),
        Command("SKEW", 1, 1, "R"),
        Command("KMERS", 3, 3, "RII"),
        Command("FIND", 2, 2, "RM"),
        Command("RESTRICT", 2, 7, "RE"),
        Command("PALINDROMES", 3, 3, "RII"),
        Command("REPEATS", 4, 4, "RIII"),
        Command("HAMMING", 2, 2, "RR"),
        Command("ALIGN", 6, 6, "RROIII"),
        Command("CONSENSUS", 2, 10, "R"),
        Command("TM", 1, 1, "R"),
        Command("MASS", 1, 1, "R"),
        Command("PRIMER", 1, 1, "R"),
        Command("FOLD", 2, 2, "RI"),
        Command("ASSEMBLE", 4, 10, "NIR"),
        Command("PACK", 1, 1, "R"),
        Command("UNPACK", 3, 3, "NIH"),
    ]

string[] enzyme_names()
    return ["EcoRI", "BamHI", "HindIII", "PstI", "SmaI", "KpnI", "XbaI", "NotI", "EcoRV", "HaeIII", "AluI", "TaqI", "Sau3AI", "HincII", "AvaI"]

int enzyme_id(string name)
    string[] names = enzyme_names()
    for 0 <= int k < 15
        if names[k] == name
            return k
    return -1

int[] number_range(string action, int argument, int length)
    if action == "SLICE" or action == "MUTATE"
        return [1, length]
    if action == "TRANSLATE" or action == "CODONS" or action == "PROTEIN"
        return [-3, 3]
    if action == "ORFS"
        return [1, 200]
    if action == "GCWINDOW" or action == "UNPACK"
        return [1, 500]
    if action == "KMERS"
        return if argument == 1 then [1, 12] else [1, 100]
    if action == "PALINDROMES"
        return [2, 20]
    if action == "REPEATS"
        return if argument < 3 then [1, 6] else [2, 50]
    if action == "ALIGN"
        return if argument == 3 then [1, 20] elif argument == 4 then [-20, 0] else [-20, -1]
    if action == "FOLD"
        return [0, 10]
    return [1, 100]

string validation(const Registry registry, const Command specification, string[] arguments)
    int length = 0
    int unpack_length = 0
    string[] enzymes = []
    for 0 <= int k < int(len(arguments))
        string text = arguments[k]
        string kind = specification.kinds[math.min(k, int(len(specification.kinds)) - 1)]
        if kind == "R"
            int index = sequence_id(registry, text)
            if index < 0
                return "unknown sequence " + text
            if k == 0
                length = int(len(registry.sequences[index]))
        elif kind == "N"
            if not valid_name(text)
                return "invalid name " + text
        elif kind == "I"
            int value = number_value(text)
            int[] limits = number_range(specification.name, k, length)
            if value < limits[0] or value > limits[1] or ((specification.name == "TRANSLATE" or specification.name == "CODONS" or specification.name == "PROTEIN") and value == 0)
                return "invalid number " + text
            if specification.name == "UNPACK"
                unpack_length = value
        elif kind == "S"
            for 0 <= int position < int(len(text))
                if character_index("ACGT", text[position]) < 0
                    return "invalid base " + text[position] + " at " + (position + 1).string()
        elif kind == "B"
            if len(text) != 1 or character_index("ACGT", text) < 0
                return "invalid base " + text
        elif kind == "M"
            if len(text) < 1 or len(text) > 30
                return "invalid motif " + text
            for 0 <= int position < int(len(text))
                if character_index("ACGTRYWSKMBDHVN", text[position]) < 0
                    return "invalid motif " + text
        elif kind == "E"
            if enzyme_id(text) < 0
                return "unknown enzyme " + text
            for string previous = enzymes[]
                if previous == text
                    return "duplicate enzyme " + text
            enzymes = enzymes.append(text)
        elif kind == "O"
            if text != "GLOBAL" and text != "LOCAL"
                return "invalid mode " + text
        else
            if int(len(text)) != 2 * ((unpack_length + 3) / 4)
                return "invalid hex"
            for 0 <= int position < int(len(text))
                if character_index("0123456789ABCDEF", text[position]) < 0
                    return "invalid hex"
    return ""

class Frequency(string key, int count)

Frequency[] frequencies(string[] values)
    map.Map<string, int> totals = map.Map<string, int>()
    for string value = values[]
        int count
        match totals.get(value)
            int previous
                count = previous + 1
            none
                count = 1
        .totals.set(value, count)
    string[] keys = totals.keys()
    int[] counts = totals.values()
    Frequency[] result = [for 0 <= int k < int(len(keys)) then Frequency(keys[k], counts[k])]
    for 1 <= int k < int(len(result))
        Frequency item = result[k]
        int position = k
        while position > 0 and (result[position - 1].count < item.count or (result[position - 1].count == item.count and lexical_before(item.key, result[position - 1].key)))
            result[position] = result[position - 1]
            position -= 1
        result[position] = item
    return result

string[] align_sequences(string a, string b, bool local_alignment, int match_score, int mismatch, int gap)
    int m = int(len(a))
    int n = int(len(b))
    int[][] scores = array(nat(m + 1), fill = array(nat(n + 1), fill = 0))
    if not local_alignment
        for 0 <= int i <= m
            scores[i][0] = i * gap
        for 0 <= int j <= n
            scores[0][j] = j * gap
    int best = 0
    int end_a = 0
    int end_b = 0
    for 1 <= int i <= m
        for 1 <= int j <= n
            int diagonal = scores[i - 1][j - 1] + (if a[i - 1] == b[j - 1] then match_score else mismatch)
            int value = math.max(diagonal, math.max(scores[i - 1][j] + gap, scores[i][j - 1] + gap))
            if local_alignment
                value = math.max(0, value)
            scores[i][j] = value
            if value > best
                best = value
                end_a = i
                end_b = j
    if not local_alignment
        end_a = m
        end_b = n
        best = scores[m][n]
    elif best == 0
        return ["score 0"]
    int i = end_a
    int j = end_b
    string row_a = ""
    string row_b = ""
    string middle = ""
    int identity = 0
    int gaps = 0
    while (i > 0 or j > 0) and (not local_alignment or scores[i][j] != 0)
        string x = "-"
        string y = "-"
        if i > 0 and j > 0 and scores[i][j] == scores[i - 1][j - 1] + (if a[i - 1] == b[j - 1] then match_score else mismatch)
            x = a[i - 1]
            y = b[j - 1]
            i -= 1
            j -= 1
        elif i > 0 and scores[i][j] == scores[i - 1][j] + gap
            x = a[i - 1]
            i -= 1
        else
            y = b[j - 1]
            j -= 1
        row_a += x
        row_b += y
        if x == "-" or y == "-"
            middle += "-"
            gaps += 1
        elif x == y
            middle += "|"
            identity += 1
        else
            middle += "*"
    return ["score " + best.string() + " a " + (i + 1).string() + "-" + end_a.string() + " b " + (j + 1).string() + "-" + end_b.string() + " identity " + identity.string() + "/" + len(row_a).string() + " gaps " + gaps.string(), row_a[::-1], middle[::-1], row_b[::-1]]

int fold_value(const int[][] table, int first, int last)
    return if first > last then 0 else table[first][last]

bool rna_pair(string a, string b)
    return complement(a) == b or (a == "G" and b == "T") or (a == "T" and b == "G")

string[] fold_sequence(string sequence, int minimum_loop)
    int n = int(len(sequence))
    int[][] table = array(nat(n), fill = array(nat(n), fill = 0))
    for 1 <= int width <= n
        for 0 <= int first <= n - width
            int last = first + width - 1
            int best = fold_value(table, first, last - 1)
            for first <= int k <= last - minimum_loop - 1
                if rna_pair(sequence[k], sequence[last])
                    best = math.max(best, fold_value(table, first, k - 1) + 1 + fold_value(table, k + 1, last - 1))
            table[first][last] = best
    int[] starts = array(nat(2 * n + 1), fill = 0)
    int[] ends = array(nat(2 * n + 1), fill = 0)
    int pending = 1
    starts[0] = 0
    ends[0] = n - 1
    string[] symbols = array(nat(n), fill = ".")
    while pending > 0
        pending -= 1
        int first = starts[pending]
        int last = ends[pending]
        if first > last or fold_value(table, first, last) == 0
            continue
        if table[first][last] == fold_value(table, first, last - 1)
            starts[pending] = first
            ends[pending] = last - 1
            pending += 1
        else
            for first <= int k <= last - minimum_loop - 1
                if rna_pair(sequence[k], sequence[last]) and fold_value(table, first, k - 1) + 1 + fold_value(table, k + 1, last - 1) == table[first][last]
                    symbols[k] = "("
                    symbols[last] = ")"
                    starts[pending] = first
                    ends[pending] = k - 1
                    starts[pending + 1] = k + 1
                    ends[pending + 1] = last - 1
                    pending += 2
                    break
    return [symbols.join(""), "pairs " + table[0][n - 1].string()]

int suffix_overlap(string a, string b)
    int limit = math.min(int(len(a)), int(len(b))) - 1
    if limit <= 0
        return 0
    string text = b[:<limit] + "#" + a[int(len(a)) - limit:]
    int[] prefix = array(len(text), fill = 0)
    for 1 <= int k < int(len(text))
        int matched = prefix[k - 1]
        while matched > 0 and text[k] != text[matched]
            matched = prefix[matched - 1]
        if text[k] == text[matched]
            matched += 1
        prefix[k] = matched
    return prefix[int(len(text)) - 1]

string[] assemble(Registry &registry, string name, int minimum_overlap, string[] inputs)
    set.Set<string> seen = set.Set<string>()
    for string fragment = inputs[]
        .seen.add(fragment)
    string[] unique = seen.values()
    string[] fragments = []
    for 0 <= int k < int(len(unique))
        bool contained = false
        for 0 <= int j < int(len(unique))
            if j != k and unique[j].contains(unique[k])
                contained = true
        if not contained
            fragments = fragments.append(unique[k])
    while len(fragments) > 1
        int best = 0
        int first = 0
        int second = 1
        for 0 <= int k < int(len(fragments))
            for 0 <= int j < int(len(fragments))
                if j == k
                    continue
                int overlap = suffix_overlap(fragments[k], fragments[j])
                if overlap > best
                    best = overlap
                    first = k
                    second = j
        if best < minimum_overlap
            break
        string joined = fragments[first] + fragments[second][best:]
        string[] remaining = []
        for 0 <= int k < int(len(fragments))
            if k == first
                remaining = remaining.append(joined)
            elif k != second and not joined.contains(fragments[k])
                remaining = remaining.append(fragments[k])
        fragments = remaining
    int longest = 0
    for 1 <= int k < int(len(fragments))
        if len(fragments[k]) > len(fragments[longest])
            longest = k
    if len(fragments[longest]) > 500
        return ["ERROR too long"]
    string[] output = ["contigs " + len(fragments).string()]
    for string fragment = fragments[]
        output = output.append(len(fragment).string() + " " + fragment)
    output = output.append(registration(&registry, name, fragments[longest]))
    return output

string[] execute(Registry &registry, string line)
    string[] words = line.split(" ")
    string action = words[0]
    Command specification = Command("", 0, 0, "")
    for Command candidate = commands()[]
        if candidate.name == action
            specification = candidate
            break
    if specification.name == ""
        return ["ERROR unknown command " + action]
    string[] arguments = words[1:]
    int count = int(len(arguments))
    if count < specification.least or count > specification.most
        return ["ERROR wrong argument count"]
    string reason = validation(registry, specification, arguments)
    if reason != ""
        return ["ERROR " + reason]
    if action == "LIST"
        string[] names = [for 0 <= int k < registry.used if registry.names[k] != "" then registry.names[k]]
        names = names.sorted()
        string[] output = []
        for string name = names[]
            output = output.append(name + " " + len(registry.sequences[sequence_id(registry, name)]).string() + " nt")
        return if len(output) == 0 then ["no sequences"] else output
    if action == "SEQ"
        return [registration(&registry, arguments[0], arguments[1])]
    if action == "UNPACK"
        int length = number_value(arguments[1])
        string encoded = arguments[2]
        string sequence = ""
        for 0 <= int k < int(len(encoded)) / 2
            int value = 16 * character_index("0123456789ABCDEF", encoded[2 * k]) + character_index("0123456789ABCDEF", encoded[2 * k + 1])
            int[] codes = [value / 64, value / 16 % 4, value / 4 % 4, value % 4]
            for int code = codes[]
                if int(len(sequence)) >= length and code != 0
                    return ["ERROR invalid padding"]
                sequence += "ACGT"[code]
        return [registration(&registry, arguments[0], sequence[:<length])]
    if action == "JOIN" or action == "ASSEMBLE"
        int first = if action == "JOIN" then 1 else 2
        string[] fragments = [for first <= int k < count then registry.sequences[sequence_id(registry, arguments[k])]]
        if action == "JOIN"
            return [registration(&registry, arguments[0], fragments.join(""))]
        return assemble(&registry, arguments[0], number_value(arguments[1]), fragments)
    int index = sequence_id(registry, arguments[0])
    string sequence = registry.sequences[index]
    int length = int(len(sequence))
    if action == "DEL"
        registry.names[index] = ""
        registry.sequences[index] = ""
        return ["deleted " + arguments[0]]
    if action == "SLICE"
        int first = number_value(arguments[1]) - 1
        int last = number_value(arguments[2]) - 1
        string part = if first <= last then sequence[first:last] else reverse_complement(sequence[last:first])
        return [registration(&registry, arguments[3], part)]
    if action == "MUTATE"
        int position = number_value(arguments[1]) - 1
        string base = arguments[2]
        string original = sequence[position]
        if original == base
            return ["ERROR no change"]
        registry.sequences[index] = sequence[:<position] + base + sequence[position + 1:]
        return [arguments[0] + " " + original + (position + 1).string() + base + " " + (if transition(original, base) then "transition" else "transversion")]
    if action == "REVCOMP"
        return [reverse_complement(sequence)]
    if action == "COMPLEMENT"
        return [complement(sequence)]
    if action == "REVERSE"
        return [sequence[::-1]]
    if action == "TRANSCRIBE"
        return [[for 0 <= int k < length then if sequence[k] == "T" then "U" else sequence[k]].join("")]
    if action == "TRANSLATE" or action == "CODONS" or action == "PROTEIN"
        string[] codons = codon_list(sequence, number_value(arguments[1]))
        string protein = translate(codons)
        if action == "TRANSLATE"
            return [if protein == "" then "none" else protein]
        if action == "CODONS"
            string[] output = []
            for Frequency item = frequencies(codons)[]
                output = output.append(item.key + " " + amino_acid(item.key) + " " + item.count.string())
            return if len(output) == 0 then ["none"] else output
        string full = protein.split("*")[0]
        if full == ""
            return ["ERROR empty protein"]
        string alphabet = "ACDEFGHIKLMNPQRSTVWY"
        int[] masses = [71079, 103139, 115089, 129116, 147177, 57052, 137141, 113160, 128174, 113160, 131193, 114104, 97117, 128131, 156188, 87078, 101105, 99133, 186213, 163176]
        int mass = 18015
        int charge = 0
        string[] letters = []
        for 0 <= int k < int(len(full))
            string letter = full[k]
            mass += masses[character_index(alphabet, letter)]
            if letter == "K" or letter == "R"
                charge += 1
            elif letter == "D" or letter == "E"
                charge -= 1
            letters = letters.append(letter)
        string[] parts = []
        for Frequency item = frequencies(letters)[]
            parts = parts.append(item.key + "=" + item.count.string())
        return [full, "length " + len(full).string() + " mass " + milli(mass) + " charge " + (if charge > 0 then "+" else "") + charge.string(), parts.join(" ")]
    if action == "ORFS"
        int threshold = number_value(arguments[1])
        string[] keys = []
        string[] lines = []
        int[] frames = [1, 2, 3, -1, -2, -3]
        for int frame = frames[]
            string[] codons = codon_list(sequence, frame)
            int start = -1
            for 0 <= int k < int(len(codons))
                if start < 0 and codons[k] == "ATG"
                    start = k
                elif start >= 0 and amino_acid(codons[k]) == "*"
                    if k - start >= threshold
                        int left = math.abs(frame) + 3 * start
                        int right = math.abs(frame) + 3 * k + 2
                        if frame < 0
                            int converted = length + 1 - right
                            right = length + 1 - left
                            left = converted
                        string protein = translate(codons[start:<k])
                        keys = keys.append("{left:int=3,zero}")
                        lines = lines.append((if frame > 0 then "+" else "") + frame.string() + " " + left.string() + " " + right.string() + " " + (k - start).string() + " " + protein)
                    start = -1
        string[] sorted = keys.sorted()
        string[] output = []
        for string key = sorted[]
            for 0 <= int k < int(len(keys))
                if keys[k] == key
                    output = output.append(lines[k])
                    break
        return if len(output) == 0 then ["none"] else output
    if action == "GC"
        int[] counts = composition(sequence)
        return ["A=" + counts[0].string() + " C=" + counts[1].string() + " G=" + counts[2].string() + " T=" + counts[3].string() + " GC=" + percentage(counts[1] + counts[2], length) + "%"]
    if action == "GCWINDOW"
        int width = number_value(arguments[1])
        int step = number_value(arguments[2])
        if width > length
            return ["ERROR window too large"]
        string[] output = []
        int position = 0
        while position + width <= length
            output = output.append((position + 1).string() + "-" + (position + width).string() + " " + percentage(gc_count(sequence[position:<position + width]), width) + "%")
            position += step
        return output
    if action == "SKEW"
        int value = 0
        int low = 0
        int high = 0
        int[] values = [0]
        for 0 <= int k < length
            value += if sequence[k] == "G" then 1 elif sequence[k] == "C" then -1 else 0
            values = values.append(value)
            low = math.min(low, value)
            high = math.max(high, value)
        int[] minima = [for 0 <= int k <= length if values[k] == low then k]
        int[] maxima = [for 0 <= int k <= length if values[k] == high then k]
        return ["min " + low.string() + " at " + numbers(minima), "max " + high.string() + " at " + numbers(maxima)]
    if action == "KMERS"
        int width = number_value(arguments[1])
        int limit = number_value(arguments[2])
        if width > length
            return ["ERROR k too large"]
        string[] windows = [for 0 <= int k <= length - width then sequence[k:<k + width]]
        Frequency[] counts = frequencies(windows)
        string[] output = [len(windows).string() + " windows " + len(counts).string() + " distinct"]
        for 0 <= int k < math.min(limit, int(len(counts)))
            output = output.append(counts[k].key + " " + counts[k].count.string())
        return output
    if action == "FIND"
        return ["forward " + numbers(occurrences(sequence, arguments[1])), "reverse " + numbers(occurrences(sequence, reverse_complement(arguments[1])))]
    if action == "RESTRICT"
        string[] motifs = ["GAATTC", "GGATCC", "AAGCTT", "CTGCAG", "CCCGGG", "GGTACC", "TCTAGA", "GCGGCCGC", "GATATC", "GGCC", "AGCT", "TCGA", "GATC", "GTYRAC", "CYCGRG"]
        int[] offsets = [1, 1, 1, 5, 3, 5, 1, 2, 3, 2, 2, 1, 0, 3, 1]
        bool[] cuts = array(nat(length + 1), fill = false)
        string[] output = []
        for 1 <= int k < count
            int enzyme = enzyme_id(arguments[k])
            int[] points = []
            for int position = occurrences(sequence, motifs[enzyme])[]
                int cut = position + offsets[enzyme] - 1
                if 1 <= cut < length
                    points = points.append(cut)
                    cuts[cut] = true
            output = output.append(arguments[k] + " " + numbers(points))
        cuts[length] = true
        int first = 1
        string[] fragments = []
        int[] sizes = []
        for 1 <= int cut <= length
            if cuts[cut]
                fragments = fragments.append(first.string() + "-" + cut.string())
                sizes = sizes.append(cut - first + 1)
                first = cut + 1
        output = output.append("fragments " + fragments.join(" "))
        output = output.append("sizes " + numbers(ordered_numbers(sizes, true)))
        return output
    if action == "PALINDROMES" or action == "REPEATS"
        int first_width = number_value(arguments[1])
        int last_width = number_value(arguments[2])
        if first_width > last_width
            return ["ERROR invalid range"]
        if action == "PALINDROMES"
            string[] output = []
            for 0 <= int position < length
                for first_width <= int width <= last_width
                    if position + width <= length
                        string part = sequence[position:<position + width]
                        if reverse_complement(part) == part
                            output = output.append((position + 1).string() + " " + width.string() + " " + part)
            return if len(output) == 0 then ["none"] else output
        string[] keys = []
        string[] lines = []
        for first_width <= int width <= last_width
            int position = 0
            while position + width <= length
                string unit = sequence[position:<position + width]
                int repeats = repeat_count(sequence, position, width)
                bool found = primitive(unit) and repeats >= number_value(arguments[3])
                if found
                    keys = keys.append("{position:int=3,zero}{width:int=2,zero}")
                    lines = lines.append("{position + 1}-{position + repeats * width} {unit}x{repeats}")
                position += if found then repeats * width else 1
        // Keys are unique (position, width), and lexical padding preserves both.
        string[] output = []
        for string key = keys.sorted()[]
            for 0 <= int k < int(len(keys))
                if key == keys[k]
                    output = output.append(lines[k])
                    break
        return if len(output) == 0 then ["none"] else output
    if action == "HAMMING"
        string other = registry.sequences[sequence_id(registry, arguments[1])]
        if len(other) != len(sequence)
            return ["ERROR length mismatch"]
        int transitions = 0
        int transversions = 0
        for 0 <= int k < length
            if sequence[k] != other[k]
                if transition(sequence[k], other[k])
                    transitions += 1
                else
                    transversions += 1
        return ["distance " + (transitions + transversions).string() + " transitions " + transitions.string() + " transversions " + transversions.string()]
    if action == "ALIGN"
        return align_sequences(sequence, registry.sequences[sequence_id(registry, arguments[1])], arguments[2] == "LOCAL", number_value(arguments[3]), number_value(arguments[4]), number_value(arguments[5]))
    if action == "CONSENSUS"
        for string name = arguments[]
            if int(len(registry.sequences[sequence_id(registry, name)])) != length
                return ["ERROR length mismatch"]
        int[][] profile = array(4, fill = array(nat(length), fill = 0))
        for string name = arguments[]
            string other = registry.sequences[sequence_id(registry, name)]
            for 0 <= int k < length
                profile[character_index("ACGT", other[k])][k] += 1
        string consensus = ""
        string iupac = ""
        for 0 <= int k < length
            int best = 0
            for 0 <= int base < 4
                best = math.max(best, profile[base][k])
            string tied = ""
            for 0 <= int base < 4
                if profile[base][k] == best
                    tied += "ACGT"[base]
            consensus += tied[0]
            for 0 <= int symbol < 15
                string letter = "ACGTRYWSKMBDHVN"[symbol]
                if symbol_bases(letter) == tied
                    iupac += letter
                    break
        string[] output = []
        for 0 <= int base < 4
            output = output.append("ACGT"[base] + " " + numbers(profile[base]))
        return output.concat(["consensus " + consensus, "iupac " + iupac])
    if action == "TM"
        return ["Tm " + tenths(melting_temperature(sequence)) + " " + (if length < 14 then "wallace" else "gc")]
    if action == "MASS"
        int mass = sequence_mass(sequence)
        return ["ss " + milli(mass) + " ds " + milli(mass + sequence_mass(reverse_complement(sequence)))]
    if action == "FOLD"
        if length > 100
            return ["ERROR too long"]
        return fold_sequence(sequence, number_value(arguments[1]))
    if action == "PACK"
        string encoded = ""
        int position = 0
        while position < length
            int value = 0
            for 0 <= int offset < 4
                value = 4 * value + (if position + offset < length then character_index("ACGT", sequence[position + offset]) else 0)
            encoded += "0123456789ABCDEF"[value / 16] + "0123456789ABCDEF"[value % 16]
            position += 4
        return [length.string() + " " + encoded]
    int clamp = gc_count(sequence[math.max(0, length - 5):])
    int longest_run = 1
    int current_run = 1
    int tandem = 0
    for 1 <= int k < length
        current_run = if sequence[k] == sequence[k - 1] then current_run + 1 else 1
        longest_run = math.max(longest_run, current_run)
        if sequence[k - 1] != sequence[k]
            tandem = math.max(tandem, repeat_count(sequence, k - 1, 2))
    int selfcomp = 0
    for 0 <= int center < length - 1
        int left = center
        int right = center + 1
        while left >= 0 and right < length and complement(sequence[left]) == sequence[right]
            selfcomp = math.max(selfcomp, right - left + 1)
            left -= 1
            right += 1
    int gc = gc_count(sequence)
    int tm = melting_temperature(sequence)
    string[] names = ["length", "gc", "tm", "clamp", "run", "repeat", "selfcomp"]
    string[] values = [length.string(), percentage(gc, length), tenths(tm), clamp.string(), longest_run.string(), tandem.string(), selfcomp.string()]
    bool[] passed = [18 <= length <= 25, 40 * length <= 100 * gc <= 60 * length, 520 <= tm <= 620, 1 <= clamp <= 3, longest_run <= 4, tandem <= 4, selfcomp <= 6]
    string[] output = []
    string[] failed = []
    for 0 <= int k < 7
        output = output.append(names[k] + " " + values[k] + (if passed[k] then " OK" else " FAIL"))
        if not passed[k]
            failed = failed.append(names[k])
    return output.append(if len(failed) == 0 then "PASS" else "FAIL " + failed.join(" "))

int command_count = 0
scan(&command_count)
Registry registry = Registry()
for 0 <= int line_number < command_count
    string input_line = ""
    scan(&input_line)
    for string output_line = execute(&registry, input_line)[]
        print(output_line + NL)
