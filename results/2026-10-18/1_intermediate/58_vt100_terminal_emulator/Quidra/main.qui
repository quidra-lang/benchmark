int min(int a, int b)
    return if a < b then a else b

int max(int a, int b)
    return if a > b then a else b

bool is_intermediate(int byte)
    return 32 <= byte <= 47

bool is_parameter(int byte)
    return 48 <= byte <= 57 or byte == 59

bool is_private_marker(int byte)
    return 60 <= byte <= 63

bool is_final(int byte)
    return 64 <= byte <= 126

string character(int code)
    nat8 value = nat8(code)
    return string.from_utf8(bin(value))

int[] decode_stream(string line)
    int[] codes = line.codepoints()
    int[] data = []
    nat index = 0
    while index < len(codes)
        if line[index] == "^"
            int code = codes[index + 1]
            data = data.append(if line[index + 1] == "^" then code else code - 64)
            index += 2
        else
            data = data.append(codes[index])
            index += 1
    return data

int field_value(string field)
    if field == ""
        return 0
    return min(int.parse(field), 9999)

int parameter(int[] params, nat index)
    return if index < len(params) then params[index] else 0

int amount(int[] params)
    return max(parameter(params, 0), 1)

string palette_color(int number)
    string[] names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    if number < 8
        return names[number]
    if number < 16
        return "bright-" + names[number - 8]
    return number.string()

string hex_byte(int value)
    string digits = "0123456789abcdef"
    return digits[value / 16] + digits[value % 16]

string rgb_color(int red, int green, int blue)
    return "#" + hex_byte(red) + hex_byte(green) + hex_byte(blue)

error sequence_ignored(string reason)
    return error(reason, code = "SEQUENCE_IGNORED")

void | error require(bool condition, string reason = "unsupported")
    if not condition
        return sequence_ignored(reason)
    return

(string, nat) | error extended_color(int[] values, nat start)
    nat available = len(values) - start
    if available >= 2 and values[start] == 5 and values[start + 1] <= 255
        return (palette_color(values[start + 1]), 2)
    if available >= 4 and values[start] == 2
        int red = values[start + 1]
        int green = values[start + 2]
        int blue = values[start + 3]
        if red <= 255 and green <= 255 and blue <= 255
            return (rgb_color(red, green, blue), 4)
    return sequence_ignored("unsupported")

int mode_state(bool enabled)
    return if enabled then 1 else 2

string[] mode_names()
    return ["IRM", "LNM", "DECCKM", "DECSCNM", "DECOM", "DECAWM", "DECTCEM", "DECKPAM", "BRACKETED"]

bool initial_mode(string name)
    return name == "DECAWM" or name == "DECTCEM"

string | none ansi_mode_name(int number)
    if number == 4
        return "IRM"
    if number == 20
        return "LNM"
    return none

string | none dec_mode_name(int number)
    if number == 1
        return "DECCKM"
    if number == 5
        return "DECSCNM"
    if number == 6
        return "DECOM"
    if number == 7
        return "DECAWM"
    if number == 25
        return "DECTCEM"
    if number == 2004
        return "BRACKETED"
    return none

bool is_screen_mode(int number)
    return number == 47 or number == 1047 or number == 1049

bool supports_dec_mode(int number)
    match dec_mode_name(number)
        string
            return true
        none
            return is_screen_mode(number) or number == 1048

bool meets_condition(string key, int first)
    if key == "J"
        return first <= 3
    if key == "K"
        return first <= 2
    if key == "g"
        return first == 0 or first == 3
    if key == " q"
        return first <= 6
    if key == "n"
        return first == 5 or first == 6
    if key == "?n"
        return first == 6
    if key == "c" or key == ">c"
        return first == 0
    if key == "t"
        return first == 18
    return true

bool clears_wrap(string key)
    return len(key) == 1 and "ABCDEFGHIJKLMPSTXZ`adef@".contains(key)

string line_drawing_char(string symbol)
    string sources = "`ajklmntuvwqx~"
    string targets = "*#+++++++++-|o"
    match sources.find(symbol)
        nat index
            return targets[index]
        none
            return symbol

map.Map<string, string> cursor_key_finals()
    map.Map<string, string> finals = map.Map<string, string>()
    .finals.set("UP", "A")
    .finals.set("DOWN", "B")
    .finals.set("RIGHT", "C")
    .finals.set("LEFT", "D")
    .finals.set("HOME", "H")
    .finals.set("END", "F")
    return finals

map.Map<string, string> fixed_key_strings()
    map.Map<string, string> keys = map.Map<string, string>()
    .keys.set("INSERT", "^[[2~")
    .keys.set("DELETE", "^[[3~")
    .keys.set("PAGEUP", "^[[5~")
    .keys.set("PAGEDOWN", "^[[6~")
    .keys.set("F1", "^[OP")
    .keys.set("F2", "^[OQ")
    .keys.set("F3", "^[OR")
    .keys.set("F4", "^[OS")
    .keys.set("F5", "^[[15~")
    .keys.set("F6", "^[[17~")
    .keys.set("F7", "^[[18~")
    .keys.set("F8", "^[[19~")
    .keys.set("F9", "^[[20~")
    .keys.set("F10", "^[[21~")
    .keys.set("F11", "^[[23~")
    .keys.set("F12", "^[[24~")
    .keys.set("TAB", "^I")
    .keys.set("BACKSPACE", "^?")
    .keys.set("ESCAPE", "^[")
    return keys

string key_string(string name, bool application_cursor, bool new_line, bool application_keypad)
    match cursor_key_finals().get(name)
        string letter
            string prefix = if application_cursor then "^[O" else "^[["
            return prefix + letter
        none
            void
    match fixed_key_strings().get(name)
        string sequence
            return sequence
        none
            void
    string enter = if new_line then "^M^J" else "^M"
    if name == "ENTER"
        return enter
    if name == "KPENTER"
        return if application_keypad then "^[OM" else enter
    int digit = int.parse(name[2:])
    if application_keypad
        return "^[O" + character(112 + digit)
    return digit.string()

class Attributes(
    bool[] flags = array(8, fill = false),
    string foreground = "",
    string background = "",
)
    Attributes copy()
        return Attributes(flags, foreground, background)

    string describe()
        string[] names = [
            "bold",
            "dim",
            "italic",
            "underline",
            "blink",
            "reverse",
            "hidden",
            "strike",
        ]
        string[] parts = []
        for string name = names[], bool enabled = flags[]
            if enabled
                parts = parts.append(name)
        if foreground != ""
            parts = parts.append("fg=" + foreground)
        if background != ""
            parts = parts.append("bg=" + background)
        return parts.join(" ")

class Cell(string glyph, Attributes attributes)

Cell blank_cell()
    return Cell(" ", Attributes())

Cell[] blank_row(int width)
    return array(nat(width), fill = blank_cell())

string row_text(Cell[] cells)
    int last = int(len(cells)) - 1
    while last >= 0 and cells[last].glyph == " "
        last -= 1
    string text = ""
    for 0 <= int index <= last
        text += cells[index].glyph
    return text

class SavedCursor(
    int row,
    int column,
    Attributes attributes,
    bool origin,
    string g0,
    string g1,
    string gl,
)

class Screen(int width, int height)
    Cell[][] rows
    SavedCursor | none saved_cursor = none
    .clear()

    void .clear()
        rows = array(nat(height), fill = blank_row(width))

    void .fill(string glyph)
        Cell cell = Cell(glyph, Attributes())
        rows = array(nat(height), fill = array(nat(width), fill = cell))

    void .put(int row, int column, Cell cell)
        rows[row - 1][column - 1] = cell

    void .erase(int row, int first, int last)
        for first <= int column <= last
            rows[row - 1][column - 1] = blank_cell()

    void .erase_rows(int first, int last)
        for first <= int row <= last
            rows[row - 1] = blank_row(width)

    Cell[] .scroll_up(int top, int bottom)
        Cell[] removed = rows[top - 1]
        for top <= int row < bottom
            rows[row - 1] = rows[row]
        rows[bottom - 1] = blank_row(width)
        return removed

    void .scroll_down(int top, int bottom)
        for bottom >= int row > top
            rows[row - 1] = rows[row - 2]
        rows[top - 1] = blank_row(width)

    void .insert_cells(int row, int column, int count)
        for width >= int index >= column + count
            rows[row - 1][index - 1] = rows[row - 1][index - 1 - count]
        for column <= int index < column + count
            rows[row - 1][index - 1] = blank_cell()

    void .delete_cells(int row, int column, int count)
        for column <= int index <= width - count
            rows[row - 1][index - 1] = rows[row - 1][index - 1 + count]
        for width - count < int index <= width
            rows[row - 1][index - 1] = blank_cell()

    string text(int row)
        return row_text(rows[row - 1])

class Terminal(int width, int height)
    int stream_bytes = 0
    int printed = 0
    int sequences = 0
    int bells = 0
    int replies = 0
    int dumps = 0
    map.Map<string, int> ignored = map.Map<string, int>()
    for auto reason = ["unsupported", "malformed", "canceled", "invalid"][]
        .ignored.set(reason, 0)
    Screen[] screens
    int display
    int row
    int column
    bool pending_wrap
    Attributes attributes
    string g0
    string g1
    string gl
    set.Set<string> modes
    int cursor_shape
    int top
    int bottom
    set.Set<int> tab_stops
    string[] scrollback
    string | none title
    string | none last_char
    string state
    string marker
    string parameters
    string intermediates
    string osc
    .reset()

    void .reset()
        screens = [Screen(width, height), Screen(width, height)]
        display = 0
        row = 1
        column = 1
        pending_wrap = false
        attributes = Attributes()
        g0 = "ascii"
        g1 = "ascii"
        gl = "G0"
        modes = set.Set<string>()
        for auto name = mode_names()[]
            .set_mode(name, initial_mode(name))
        cursor_shape = 1
        top = 1
        bottom = height
        tab_stops = set.Set<int>()
        for 9 <= int stop <= width step 8
            .tab_stops.add(stop)
        scrollback = []
        title = none
        last_char = none
        state = "ground"
        .clear_sequence()

    void .clear_sequence()
        marker = ""
        parameters = ""
        intermediates = ""
        osc = ""

    void .set_mode(string name, bool enabled)
        if enabled
            .modes.add(name)
        else
            .modes.remove(name)

    void .count_ignored(string reason)
        match ignored.get(reason)
            int count
                .ignored.set(reason, count + 1)
            none
                .ignored.set(reason, 1)

    void .receive(int byte)
        stream_bytes += 1
        if byte < 32
            .receive_control(byte)
        elif state == "ground"
            .print_char(character(byte))
        elif state == "escape" or state == "escape intermediate"
            .escape_byte(byte)
        elif state == "osc string"
            osc += character(byte)
        elif state == "csi ignore"
            if is_final(byte)
                .count_ignored("malformed")
                state = "ground"
        elif state == "csi intermediate"
            .csi_intermediate_byte(byte)
        elif state == "csi entry" and is_private_marker(byte)
            marker = character(byte)
            state = "csi param"
        else
            .csi_param_byte(byte)

    void .receive_control(int byte)
        if byte == 27
            if state == "osc string"
                .execute_osc()
            elif state != "ground"
                .count_ignored("canceled")
            .clear_sequence()
            state = "escape"
        elif byte == 24 or byte == 26
            if state != "ground"
                .count_ignored("canceled")
                state = "ground"
        elif state == "osc string"
            if byte == 7
                .execute_osc()
                state = "ground"
        else
            .execute_control(byte)

    void .escape_byte(int byte)
        string symbol = character(byte)
        if is_intermediate(byte)
            intermediates += symbol
            state = "escape intermediate"
        elif state == "escape" and symbol == "["
            state = "csi entry"
        elif state == "escape" and symbol == "]"
            state = "osc string"
        else
            .execute_esc(intermediates + symbol)
            state = "ground"

    void .csi_param_byte(int byte)
        string symbol = character(byte)
        if is_parameter(byte)
            parameters += symbol
            state = "csi param"
        elif is_intermediate(byte)
            intermediates += symbol
            state = "csi intermediate"
        elif is_final(byte)
            .execute_csi(symbol)
            state = "ground"
        else
            state = "csi ignore"

    void .csi_intermediate_byte(int byte)
        string symbol = character(byte)
        if is_intermediate(byte)
            intermediates += symbol
        elif is_final(byte)
            .execute_csi(symbol)
            state = "ground"
        else
            state = "csi ignore"

    void .execute_control(int byte)
        if byte == 7
            bells += 1
        elif byte == 8
            pending_wrap = false
            column = max(column - 1, 1)
        elif byte == 9
            pending_wrap = false
            .tab_move(1)
        elif 10 <= byte <= 12
            pending_wrap = false
            .line_feed()
            if modes.has("LNM")
                column = 1
        elif byte == 13
            pending_wrap = false
            column = 1
        elif byte == 14
            gl = "G1"
        elif byte == 15
            gl = "G0"

    void .print_char(string symbol)
        string charset = if gl == "G1" then g1 else g0
        if charset == "line drawing"
            .write(line_drawing_char(symbol))
        else
            .write(symbol)

    void .write(string glyph)
        printed += 1
        last_char = glyph
        if pending_wrap
            pending_wrap = false
            column = 1
            .line_feed()
        if modes.has("IRM")
            .screens[display].insert_cells(row, column, 1)
        .screens[display].put(row, column, Cell(glyph, attributes.copy()))
        if column < width
            column += 1
        elif modes.has("DECAWM")
            pending_wrap = true

    void .scroll_region_up()
        Cell[] removed = .screens[display].scroll_up(top, bottom)
        if display == 0 and top == 1
            scrollback = scrollback.append(row_text(removed))
            if len(scrollback) > 100
                scrollback = scrollback[1:]

    void .line_feed()
        if row == bottom
            .scroll_region_up()
        elif row < height
            row += 1

    void .reverse_line_feed()
        if row == top
            .screens[display].scroll_down(top, bottom)
        elif row > 1
            row -= 1

    void .tab_move(int count)
        for _ < count
            if column >= width
                break
            int next_stop = width
            for auto stop = tab_stops.values()[]
                if column < stop < next_stop
                    next_stop = stop
            column = next_stop

    void .reverse_tab_move(int count)
        for _ < count
            if column <= 1
                break
            int previous_stop = 1
            for auto stop = tab_stops.values()[]
                if previous_stop < stop < column
                    previous_stop = stop
            column = previous_stop

    int address_row(int value)
        if modes.has("DECOM")
            return min(top + value - 1, bottom)
        return min(value, height)

    void .home()
        row = address_row(1)
        column = 1

    void .save_cursor()
        bool origin = modes.has("DECOM")
        SavedCursor cursor = SavedCursor(row, column, attributes.copy(), origin, g0, g1, gl)
        screens[display].saved_cursor = cursor

    void .restore_cursor()
        pending_wrap = false
        SavedCursor saved
        match screens[display].saved_cursor
            SavedCursor slot
                saved = slot
            none
                saved = SavedCursor(1, 1, Attributes(), false, "ascii", "ascii", "G0")
        row = saved.row
        column = saved.column
        attributes = saved.attributes
        .set_mode("DECOM", saved.origin)
        g0 = saved.g0
        g1 = saved.g1
        gl = saved.gl

    void .screen_alignment()
        pending_wrap = false
        .screens[display].fill("E")
        top = 1
        bottom = height
        .set_mode("DECOM", false)
        row = 1
        column = 1

    void .execute_esc(string key)
        if key == "7"
            .save_cursor()
        elif key == "8"
            .restore_cursor()
        elif key == "D"
            pending_wrap = false
            .line_feed()
        elif key == "E"
            pending_wrap = false
            column = 1
            .line_feed()
        elif key == "M"
            pending_wrap = false
            .reverse_line_feed()
        elif key == "H"
            .tab_stops.add(column)
        elif key == "c"
            .reset()
        elif key == "=" or key == ">"
            .set_mode("DECKPAM", key == "=")
        elif key == "\"
            void
        elif key == "(0" or key == "(B"
            g0 = if key == "(0" then "line drawing" else "ascii"
        elif key == ")0" or key == ")B"
            g1 = if key == ")0" then "line drawing" else "ascii"
        elif key == "#8"
            .screen_alignment()
        else
            .count_ignored("unsupported")
            return
        sequences += 1

    void .execute_osc()
        if osc.starts_with("0;") or osc.starts_with("2;")
            title = osc[2:]
            sequences += 1
        else
            .count_ignored("unsupported")

    void .execute_csi(string final_byte)
        string key = marker + intermediates + final_byte
        string[] fields = if parameters == "" then [] else parameters.split(";")
        void | error outcome = .apply_csi(key, fields)
        match outcome
            void
                sequences += 1
            error problem
                .count_ignored(problem.message)

    void | error .apply_csi(string key, string[] fields)
        try require(len(fields) <= 16, "invalid")
        int[] params = []
        for auto field = fields[]
            params = params.append(field_value(field))
        try require(meets_condition(key, parameter(params, 0)))
        if clears_wrap(key)
            pending_wrap = false
        int count = amount(params)
        if key == "A"
            .move_up(count)
        elif key == "B" or key == "e"
            .move_down(count)
        elif key == "C" or key == "a"
            column = min(column + count, width)
        elif key == "D"
            column = max(column - count, 1)
        elif key == "E"
            .move_down(count)
            column = 1
        elif key == "F"
            .move_up(count)
            column = 1
        elif key == "G" or key == "`"
            column = min(count, width)
        elif key == "H" or key == "f"
            row = address_row(count)
            column = min(max(parameter(params, 1), 1), width)
        elif key == "d"
            row = address_row(count)
        elif key == "I"
            .tab_move(count)
        elif key == "Z"
            .reverse_tab_move(count)
        elif key == "J"
            .erase_in_display(parameter(params, 0))
        elif key == "K"
            .erase_in_line(parameter(params, 0))
        elif key == "X"
            .screens[display].erase(row, column, min(column + count - 1, width))
        elif key == "@"
            .screens[display].insert_cells(row, column, min(count, width - column + 1))
        elif key == "P"
            .screens[display].delete_cells(row, column, min(count, width - column + 1))
        elif key == "L"
            .insert_lines(count)
        elif key == "M"
            .delete_lines(count)
        elif key == "S"
            for _ < min(count, bottom - top + 1)
                .scroll_region_up()
        elif key == "T"
            for _ < min(count, bottom - top + 1)
                .screens[display].scroll_down(top, bottom)
        elif key == "b"
            .repeat_character(count)
        elif key == "g"
            if parameter(params, 0) == 0
                .tab_stops.remove(column)
            else
                tab_stops = set.Set<int>()
        elif key == "m"
            try .select_graphic_rendition(params)
        elif key == "h" or key == "l"
            try .set_ansi_modes(params, key == "h")
        elif key == "?h" or key == "?l"
            try .set_dec_modes(params, key == "?h")
        elif key == " q"
            cursor_shape = count
        elif key == "r"
            try .set_scroll_region(params)
        elif key == "s"
            .save_cursor()
        elif key == "u"
            .restore_cursor()
        elif key == "!p"
            .soft_reset()
        elif key == "n"
            if parameter(params, 0) == 5
                .reply("^[[0n")
            else
                .reply("^[[{reported_row()};{column}R")
        elif key == "?n"
            .reply("^[[?{reported_row()};{column};1R")
        elif key == "c"
            .reply("^[[?1;2c")
        elif key == ">c"
            .reply("^[[>0;95;0c")
        elif key == "t"
            .reply("^[[8;{height};{width}t")
        elif key == "$p"
            .request_ansi_mode(parameter(params, 0))
        elif key == "?$p"
            .request_dec_mode(parameter(params, 0))
        else
            return sequence_ignored("unsupported")
        return

    void .move_up(int count)
        int limit = if row >= top then top else 1
        row = max(row - count, limit)

    void .move_down(int count)
        int limit = if row <= bottom then bottom else height
        row = min(row + count, limit)

    void .erase_in_display(int mode)
        if mode == 0
            .screens[display].erase(row, column, width)
            .screens[display].erase_rows(row + 1, height)
        elif mode == 1
            .screens[display].erase_rows(1, row - 1)
            .screens[display].erase(row, 1, column)
        elif mode == 2
            .screens[display].clear()
        else
            scrollback = []

    void .erase_in_line(int mode)
        int first = if mode == 1 or mode == 2 then 1 else column
        int last = if mode == 1 then column else width
        .screens[display].erase(row, first, last)

    void .insert_lines(int count)
        if top <= row <= bottom
            for _ < min(count, bottom - row + 1)
                .screens[display].scroll_down(row, bottom)
            column = 1

    void .delete_lines(int count)
        if top <= row <= bottom
            for _ < min(count, bottom - row + 1)
                .screens[display].scroll_up(row, bottom)
            column = 1

    void .repeat_character(int count)
        match last_char
            string glyph
                for _ < count
                    .write(glyph)
            none
                void

    void | error .select_graphic_rendition(int[] params)
        int[] values = if len(params) == 0 then [0] else params
        Attributes updated = attributes.copy()
        nat index = 0
        while index < len(values)
            int value = values[index]
            if value == 0
                updated = Attributes()
            elif 1 <= value <= 5
                updated.flags[value - 1] = true
            elif 7 <= value <= 9
                updated.flags[value - 2] = true
            elif value == 22
                updated.flags[0] = false
                updated.flags[1] = false
            elif 23 <= value <= 25
                updated.flags[value - 21] = false
            elif 27 <= value <= 29
                updated.flags[value - 22] = false
            elif 30 <= value <= 37
                updated.foreground = palette_color(value - 30)
            elif 90 <= value <= 97
                updated.foreground = palette_color(value - 82)
            elif 40 <= value <= 47
                updated.background = palette_color(value - 40)
            elif 100 <= value <= 107
                updated.background = palette_color(value - 92)
            elif value == 39
                updated.foreground = ""
            elif value == 49
                updated.background = ""
            else
                try require(value == 38 or value == 48)
                (string color, nat used) = try extended_color(values, index + 1)
                if value == 38
                    updated.foreground = color
                else
                    updated.background = color
                index += used
            index += 1
        attributes = updated
        return

    void | error .set_ansi_modes(int[] params, bool enabled)
        int[] values = if len(params) == 0 then [0] else params
        string[] names = []
        for auto value = values[]
            match ansi_mode_name(value)
                string name
                    names = names.append(name)
                none
                    return sequence_ignored("unsupported")
        for auto name = names[]
            .set_mode(name, enabled)
        return

    void | error .set_dec_modes(int[] params, bool enabled)
        int[] values = if len(params) == 0 then [0] else params
        for auto value = values[]
            try require(supports_dec_mode(value))
        for auto value = values[]
            match dec_mode_name(value)
                string name
                    .set_dec_flag(value, name, enabled)
                none
                    if value == 1048
                        if enabled
                            .save_cursor()
                        else
                            .restore_cursor()
                    else
                        .switch_screen(value, enabled)
        return

    void .set_dec_flag(int value, string name, bool enabled)
        if value == 6 or (value == 7 and not enabled)
            pending_wrap = false
        .set_mode(name, enabled)
        if value == 6
            .home()

    void .switch_screen(int value, bool enabled)
        pending_wrap = false
        if enabled and display == 0
            if value == 1049
                .save_cursor()
            display = 1
            if value == 1049
                .screens[display].clear()
        elif not enabled and display == 1
            if value == 1047
                .screens[display].clear()
            display = 0
            if value == 1049
                .restore_cursor()

    void | error .set_scroll_region(int[] params)
        int new_top = amount(params)
        int requested = parameter(params, 1)
        int new_bottom = if requested == 0 then height else min(requested, height)
        try require(new_top < new_bottom, "invalid")
        pending_wrap = false
        top = new_top
        bottom = new_bottom
        .home()
        return

    void .soft_reset()
        pending_wrap = false
        string[] names = ["IRM", "DECCKM", "DECOM", "DECAWM", "DECTCEM", "DECKPAM"]
        for auto name = names[]
            .set_mode(name, initial_mode(name))
        top = 1
        bottom = height
        attributes = Attributes()
        g0 = "ascii"
        g1 = "ascii"
        gl = "G0"
        screens[display].saved_cursor = none

    void .reply(string text)
        replies += 1
        print("REPLY {text}{NL}")

    int reported_row()
        if modes.has("DECOM")
            return max(row - top + 1, 1)
        return row

    void .request_ansi_mode(int mode)
        int setting = 0
        match ansi_mode_name(mode)
            string name
                setting = mode_state(modes.has(name))
            none
                void
        .reply("^[[{mode};{setting}$y")

    void .request_dec_mode(int mode)
        int setting = 0
        match dec_mode_name(mode)
            string name
                setting = mode_state(modes.has(name))
            none
                if is_screen_mode(mode)
                    setting = mode_state(display == 1)
        .reply("^[[?{mode};{setting}$y")

    void press_key(string name)
        string sent = key_string(name, modes.has("DECCKM"), modes.has("LNM"), modes.has("DECKPAM"))
        print("KEY {name} {sent}{NL}")

    void paste(string text)
        string sent = text.split("^").join("^^")
        if modes.has("BRACKETED")
            sent = "^[[200~" + sent + "^[[201~"
        print("PASTE {sent}{NL}")

    void screen_output(string label)
        string name = if display == 1 then "alt" else "main"
        string header = "{label} {name} cursor {row},{column} scrollback {len(scrollback)}"
        if pending_wrap
            header += " pending"
        print(header + NL)
        for 1 <= int line <= height
            print("|{screens[display].text(line)}{NL}")

    void .dump()
        dumps += 1
        screen_output("DUMP {dumps}")

    string[] changed_modes()
        string[] items = []
        for auto name = mode_names()[]
            bool enabled = modes.has(name)
            if enabled != initial_mode(name)
                string setting = if enabled then "on" else "off"
                items = items.append("{name}={setting}")
        if g0 == "line drawing"
            items = items.append("G0=graphics")
        if g1 == "line drawing"
            items = items.append("G1=graphics")
        if gl == "G1"
            items = items.append("GL=G1")
        if cursor_shape != 1
            items = items.append("CURSOR={cursor_shape}")
        return items

    string[] attribute_runs()
        string[] runs = []
        for 1 <= int line <= height
            Cell[] cells = screens[display].rows[line - 1]
            int start = 0
            for 1 <= int boundary <= width
                if boundary < width and cells[boundary].attributes == cells[start].attributes
                    continue
                Attributes run = cells[start].attributes
                if run != Attributes()
                    runs = runs.append("row {line} col {start + 1}-{boundary} {run.describe()}")
                start = boundary
        return runs

    void .finish()
        if state != "ground"
            .count_ignored("canceled")
            state = "ground"
        screen_output("FINAL")
        match title
            string text
                print("TITLE {DQ}{text}{DQ}{NL}")
            none
                print("TITLE none{NL}")
        string[] items = changed_modes()
        string mode_list = if len(items) == 0 then "default" else items.join(" ")
        print("MODES {mode_list}{NL}")
        print("REGION {top}-{bottom}{NL}")
        string[] stops = []
        for auto stop = tab_stops.values().sorted()[]
            stops = stops.append(stop.string())
        string tab_list = if len(stops) == 0 then "none" else stops.join(",")
        print("TABS {tab_list}{NL}")
        print("SCROLLBACK {len(scrollback)}{NL}")
        nat first = if len(scrollback) > 5 then len(scrollback) - 5 else 0
        for first <= nat index < len(scrollback)
            print("|{scrollback[index]}{NL}")
        string[] runs = attribute_runs()
        print("ATTRS {len(runs)}{NL}")
        for auto run = runs[]
            print(run + NL)
        print("BELL {bells}{NL}")
        print("REPLIES {replies}{NL}")
        print("STATS bytes={stream_bytes} printed={printed} sequences={sequences}{NL}")
        int total = 0
        string[] counts = []
        for string reason = ignored.keys()[], int count = ignored.values()[]
            total += count
            counts = counts.append("{reason}={count}")
        string count_list = counts.join(" ")
        print("IGNORED {total} {count_list}{NL}")

int width
int height
scan("{&width} {&height}")
Terminal terminal = Terminal(width, height)
while true
    string line
    scan(&line)
    if line == "%%END"
        break
    if line == "%%DUMP"
        .terminal.dump()
    elif line.starts_with("%%KEY ")
        terminal.press_key(line[6:])
    elif line.starts_with("%%PASTE ")
        terminal.paste(line[8:])
    else
        for auto byte = decode_stream(line)[]
            .terminal.receive(byte)
.terminal.finish()
