import math

enum Kind
    TwoSided
    Roommate
    Housing

enum Side
    Proposer
    Receiver

class Saved(string source, int[] matching)
class Market(string name, Kind kind, string[] names, int proposers = 0, string[] houses = [])
    int[][] preferences = array(len(names), fill = [])
    int[] capacities = array(len(names), fill = 1)
    Saved | none current = none

class Run(int[] matching, int proposals, string[] history = [])
class Metrics(int cost, int regret)
class Lattice(int[][] matchings, int[] origins, int[] vias, string[] rotations)

int position_of<T>(const T[] values, T value)
    for nat index = values.indices()[]
        if values[index] == value
            return int(index)
    return -1

int rank_in(const int[] preference, int partner)
    int index = position_of(preference, partner)
    return if index < 0 then int(len(preference)) + 1 else index + 1

int[] sequence(int start, int end)
    int[] values = []
    for start <= int value < end
        values = values.append(value)
    return values

string list_text(const string[] names, const int[] indices)
    string[] parts = []
    for int index = indices[]
        parts = parts.append(names[index])
    return if len(parts) == 0 then "-" else parts.join(" ")

string partner_name(const Market market, int partner)
    return if partner < 0 then "*" else market.names[partner]

string pair_text(const Market market, const int[] matching)
    string[] parts = []
    for 0 <= int proposer < market.proposers
        parts = parts.append(market.names[proposer] + "-" + partner_name(market, matching[proposer]))
    return parts.join(" ")

string rotation_text(const Market market, const int[] matching, const int[] rotation)
    string[] parts = []
    for int proposer = rotation[]
        parts = parts.append(market.names[proposer] + "-" + market.names[matching[proposer]])
    return parts.join(" ")

string allocation_text(const Market market, const int[] allocation)
    string[] parts = []
    for nat agent = market.names.indices()[]
        string house = if allocation[agent] < 0 then "*" else market.houses[allocation[agent]]
        parts = parts.append(market.names[agent] + "-" + house)
    return parts.join(" ")

void | error require_kind(const Market market, Kind expected)
    if market.kind != expected
        return error("WRONG TYPE " + market.name)

int | error agent_index(const Market market, string name)
    int index = position_of(market.names, name)
    if index < 0
        return error("UNKNOWN AGENT " + name)
    return index

int | error side_index(const Market market, string name, Side side)
    int index = try agent_index(market, name)
    if side == Side.Proposer and index >= market.proposers
        return error("NOT PROPOSER " + name)
    if side == Side.Receiver and index < market.proposers
        return error("NOT RECEIVER " + name)
    return index

bool able(const Market market, int agent, const int[] next, const int[] counts)
    return counts[agent] < market.capacities[agent] and next[agent] < int(len(market.preferences[agent]))

Run deferred(const Market market, bool reverse, bool verbose = false)
    int count = int(len(market.names))
    int[] next = array(nat(count), fill = 0)
    int[] counts = array(nat(count), fill = 0)
    int[][] holding = array(nat(count), fill = [])
    int[] side = if reverse then sequence(market.proposers, count) else sequence(0, market.proposers)
    int[] queue = []
    for int agent = side[]
        if able(market, agent, next, counts)
            queue = queue.append(agent)
    int proposals = 0
    string[] history = []
    while len(queue) > 0
        int proposer = queue[0]
        queue = queue[1:]
        int receiver = market.preferences[proposer][next[proposer]]
        next[proposer] += 1
        proposals += 1
        string action = "REJECT"
        int[] preference = market.preferences[receiver]
        if position_of(preference, proposer) >= 0
            if int(len(holding[receiver])) < market.capacities[receiver]
                holding[receiver] = holding[receiver].append(proposer)
                counts[proposer] += 1
                action = "HOLD"
            else
                int worst = 0
                for 1 <= int index < int(len(holding[receiver]))
                    if rank_in(preference, holding[receiver][index]) > rank_in(preference, holding[receiver][worst])
                        worst = index
                int rejected = holding[receiver][worst]
                if rank_in(preference, proposer) < rank_in(preference, rejected)
                    holding[receiver][worst] = proposer
                    counts[rejected] -= 1
                    counts[proposer] += 1
                    action = "HOLD REJECT " + market.names[rejected]
                    if able(market, rejected, next, counts) and position_of(queue, rejected) < 0
                        queue = queue.append(rejected)
        if verbose
            history = history.append("PROPOSE " + market.names[proposer] + " " + market.names[receiver] + " " + action)
        if able(market, proposer, next, counts)
            queue = queue.append(proposer)
    int[] matching = array(nat(market.proposers), fill = -1)
    int[] receiving = if reverse then sequence(0, market.proposers) else sequence(market.proposers, count)
    for int receiver = receiving[]
        for int proposer = holding[receiver][]
            if reverse
                matching[receiver] = proposer
            else
                matching[proposer] = receiver
    return Run(matching, proposals, history)

Run boston(const Market market)
    int[] matching = array(nat(market.proposers), fill = -1)
    int[] remaining = market.capacities
    int[] lengths = []
    for 0 <= int proposer < market.proposers
        lengths = lengths.append(int(len(market.preferences[proposer])))
    int rounds = math.max_all(lengths)
    int applications = 0
    for 0 <= int round < rounds
        int[] applied = array(nat(market.proposers), fill = -1)
        for 0 <= int proposer < market.proposers
            if matching[proposer] < 0 and round < lengths[proposer]
                applied[proposer] = market.preferences[proposer][round]
                applications += 1
        for market.proposers <= int receiver < int(len(market.names))
            for int proposer = market.preferences[receiver][]
                if remaining[receiver] > 0 and applied[proposer] == receiver
                    matching[proposer] = receiver
                    remaining[receiver] -= 1
    return Run(matching, applications)

int[][] exposed_rotations(const Market market, const int[] matching)
    int[] owner = array(len(market.names), fill = -1)
    int[] successor = array(nat(market.proposers), fill = -1)
    for 0 <= int proposer < market.proposers
        if matching[proposer] >= 0
            owner[matching[proposer]] = proposer
    for 0 <= int proposer < market.proposers
        if matching[proposer] < 0
            continue
        int[] preference = market.preferences[proposer]
        for int receiver = preference[rank_in(preference, matching[proposer]):][]
            int[] ranking = market.preferences[receiver]
            if position_of(ranking, proposer) >= 0 and (owner[receiver] < 0 or rank_in(ranking, proposer) < rank_in(ranking, owner[receiver]))
                successor[proposer] = owner[receiver]
                break
    bool[] covered = array(nat(market.proposers), fill = false)
    int[][] rotations = []
    for 0 <= int start < market.proposers
        if covered[start]
            continue
        int[] path = []
        int point = start
        while point >= 0 and position_of(path, point) < 0
            path = path.append(point)
            point = successor[point]
        if point == start
            for int proposer = path[]
                covered[proposer] = true
            rotations = rotations.append(path)
    return rotations

Metrics matching_metrics(const Market market, const int[] matching)
    int[] ranks = []
    for 0 <= int proposer < market.proposers
        int receiver = matching[proposer]
        if receiver >= 0
            ranks = ranks.append(rank_in(market.preferences[proposer], receiver))
            ranks = ranks.append(rank_in(market.preferences[receiver], proposer))
    return Metrics(math.sum(ranks), if len(ranks) == 0 then 0 else math.max_all(ranks))

Lattice | error enumerate_matchings(const Market market)
    for market.proposers <= int receiver < int(len(market.names))
        if market.capacities[receiver] != 1
            return error("NOT ONE TO ONE")
    auto result = Lattice([deferred(market, false).matching], [0], [0], [])
    int index = 0
    while index < int(len(result.matchings))
        int[] matching = result.matchings[index]
        for int[] rotation = exposed_rotations(market, matching)[]
            string notation = rotation_text(market, matching, rotation)
            int identifier = position_of(result.rotations, notation)
            if identifier < 0
                identifier = int(len(result.rotations))
                result.rotations = result.rotations.append(notation)
            int[] following = matching
            for nat position = rotation.indices()[]
                following[rotation[position]] = matching[rotation[(position + 1) % len(rotation)]]
            if position_of(result.matchings, following) < 0
                if len(result.matchings) == 50
                    return error("TOO MANY MATCHINGS")
                result.matchings = result.matchings.append(following)
                result.origins = result.origins.append(index + 1)
                result.vias = result.vias.append(identifier + 1)
        index += 1
    return result

string[] | error check_pairs(const Market market, const string[] words)
    if market.kind == Kind.Housing
        return error("WRONG TYPE " + market.name)
    int[] matching = array(len(market.names), fill = -1)
    int[] counts = array(len(market.names), fill = 0)
    for string word = words[2:][]
        string[] pair = word.split("-")
        int first
        int second
        if market.kind == Kind.TwoSided
            first = try side_index(market, pair[0], Side.Proposer)
            second = try side_index(market, pair[1], Side.Receiver)
        else
            first = try agent_index(market, pair[0])
            second = try agent_index(market, pair[1])
        if matching[first] >= 0
            return error("DUPLICATE AGENT " + pair[0])
        if market.kind == Kind.TwoSided
            counts[second] += 1
            if counts[second] > market.capacities[second]
                return error("OVER CAPACITY " + pair[1])
        else
            if first == second or matching[second] >= 0
                return error("DUPLICATE AGENT " + pair[1])
            matching[second] = first
        matching[first] = second
    string[] unacceptable = []
    string[] blocking = []
    if market.kind == Kind.TwoSided
        for 0 <= int proposer < market.proposers
            int receiver = matching[proposer]
            if receiver >= 0 and (position_of(market.preferences[proposer], receiver) < 0 or position_of(market.preferences[receiver], proposer) < 0)
                unacceptable = unacceptable.append("UNACCEPTABLE " + market.names[proposer] + " " + market.names[receiver])
            for market.proposers <= int other < int(len(market.names))
                if receiver == other or position_of(market.preferences[proposer], other) < 0 or position_of(market.preferences[other], proposer) < 0
                    continue
                if rank_in(market.preferences[proposer], other) >= rank_in(market.preferences[proposer], receiver)
                    continue
                int[] ranks = [0]
                for 0 <= int partner < market.proposers
                    if matching[partner] == other
                        ranks = ranks.append(rank_in(market.preferences[other], partner))
                if counts[other] < market.capacities[other] or rank_in(market.preferences[other], proposer) < math.max_all(ranks)
                    blocking = blocking.append("BLOCKING " + market.names[proposer] + " " + market.names[other])
    else
        for 0 <= int first < int(len(market.names))
            for first + 1 <= int second < int(len(market.names))
                bool mutual = position_of(market.preferences[first], second) >= 0 and position_of(market.preferences[second], first) >= 0
                string notation = market.names[first] + " " + market.names[second]
                if matching[first] == second
                    if not mutual
                        unacceptable = unacceptable.append("UNACCEPTABLE " + notation)
                elif mutual and rank_in(market.preferences[first], second) < rank_in(market.preferences[first], matching[first]) and rank_in(market.preferences[second], first) < rank_in(market.preferences[second], matching[second])
                    blocking = blocking.append("BLOCKING " + notation)
    if len(unacceptable) == 0 and len(blocking) == 0
        return ["CHECK {market.name} STABLE"]
    return ["CHECK {market.name} UNSTABLE unacceptable={len(unacceptable)} blocking={len(blocking)}"].concat(unacceptable).concat(blocking)

int[] without(const int[] values, int excluded)
    int[] result = []
    for int value = values[]
        if value != excluded
            result = result.append(value)
    return result

void remove_pair(int[][] &lists, int first, int second)
    lists[first] = without(lists[first], second)
    lists[second] = without(lists[second], first)

string[] table_lines(const Market market, const int[][] lists)
    string[] rows = []
    for nat agent = market.names.indices()[]
        rows = rows.append("TABLE " + market.names[agent] + " " + list_text(market.names, lists[agent]))
    return rows

int empty_list(const int[][] lists)
    for nat index = lists.indices()[]
        if len(lists[index]) == 0
            return int(index)
    return -1

class Pair(int first, int second)

string[] | error roommates(const Market market, bool verbose)
    try require_kind(market, Kind.Roommate)
    for nat agent = market.names.indices()[]
        if len(market.preferences[agent]) < len(market.names) - 1
            return error("INCOMPLETE " + market.names[agent])
    int[][] lists = market.preferences
    int[] held = array(len(market.names), fill = -1)
    int[] queue = sequence(0, int(len(market.names)))
    int proposals = 0
    int failure = -1
    while len(queue) > 0
        int proposer = queue[0]
        queue = queue[1:]
        int receiver = lists[proposer][0]
        if held[receiver] >= 0
            queue = queue.append(held[receiver])
        held[receiver] = proposer
        proposals += 1
        int[] preference = lists[receiver]
        for int other = preference[position_of(preference, proposer) + 1:][]
            remove_pair(&lists, receiver, other)
        failure = empty_list(lists)
        if failure >= 0
            break
    string[] history = []
    if failure < 0 and verbose
        history = table_lines(market, lists)
    int rotations = 0
    while failure < 0
        int point = -1
        for nat agent = lists.indices()[]
            if len(lists[agent]) >= 2
                point = int(agent)
                break
        if point < 0
            break
        int[] path = []
        while position_of(path, point) < 0
            path = path.append(point)
            int second = lists[point][1]
            point = lists[second][len(lists[second]) - 1]
        int[] rotation = path[position_of(path, point):]
        int[] front = []
        string[] pairs = []
        for int agent = rotation[]
            int partner = lists[agent][0]
            front = front.append(partner)
            pairs = pairs.append(market.names[agent] + "-" + market.names[partner])
        rotations += 1
        history = history.append("ROTATION {rotations} " + pairs.join(" "))
        Pair[] removals = []
        for nat index = rotation.indices()[]
            int receiver = front[(index + 1) % len(front)]
            int[] preference = lists[receiver]
            for int other = preference[position_of(preference, rotation[index]) + 1:][]
                removals = removals.append(Pair(receiver, other))
        for Pair pair = removals[]
            remove_pair(&lists, pair.first, pair.second)
        if verbose
            history = history.concat(table_lines(market, lists))
        failure = empty_list(lists)
    string[] rows = ["ROOMMATES {market.name} proposals={proposals}"].concat(history)
    if failure >= 0
        return rows.append("NO STABLE MATCHING " + market.names[failure])
    string[] pairs = []
    for nat agent = market.names.indices()[]
        int partner = lists[agent][0]
        if int(agent) < partner
            pairs = pairs.append(market.names[agent] + "-" + market.names[partner])
    return rows.append("MATCHING " + pairs.join(" "))

int[] effective_list(const Market market, int agent)
    int[] preference = market.preferences[agent]
    int position = position_of(preference, agent)
    return if position < 0 then preference.append(agent) else preference[0:<position + 1]

string[] ttc(const Market market)
    bool[] remaining = array(len(market.names), fill = true)
    int[] allocation = array(len(market.names), fill = -1)
    string[] cycles = []
    while position_of(remaining, true) >= 0
        int[] pointing = array(len(market.names), fill = -1)
        for nat agent = market.names.indices()[]
            if remaining[agent]
                for int house = effective_list(market, int(agent))[]
                    if remaining[house]
                        pointing[agent] = house
                        break
        int[] path = []
        int point = position_of(remaining, true)
        while position_of(path, point) < 0
            path = path.append(point)
            point = pointing[point]
        int[] cycle = path[position_of(path, point):]
        string[] parts = []
        for int agent = cycle[]
            int house = pointing[agent]
            allocation[agent] = house
            remaining[agent] = false
            parts = parts.append(market.names[agent] + ":" + market.houses[house])
        cycles = cycles.append("CYCLE {len(cycles) + 1} " + parts.join(" "))
    return ["TTC {market.name} cycles={len(cycles)}"].concat(cycles).append("ALLOCATION " + allocation_text(market, allocation))

string[] | error serial(const Market market, const string[] words)
    int[] order = []
    for string word = words[2:][]
        int agent = try agent_index(market, word)
        if position_of(order, agent) >= 0
            return error("DUPLICATE AGENT " + word)
        order = order.append(agent)
    if len(order) != len(market.names)
        return error("BAD ORDER")
    bool[] remaining = array(len(market.names), fill = true)
    int[] allocation = array(len(market.names), fill = -1)
    int assigned = 0
    for int agent = order[]
        for int house = market.preferences[agent][]
            if remaining[house]
                allocation[agent] = house
                remaining[house] = false
                assigned += 1
                break
    int[] worse = []
    for nat agent = market.names.indices()[]
        if position_of(effective_list(market, int(agent)), allocation[agent]) < 0
            worse = worse.append(int(agent))
    return ["SERIAL {market.name} assigned={assigned}", "ALLOCATION " + allocation_text(market, allocation), "WORSE " + list_text(market.names, worse)]

int[] partners_of(const int[] matching, int receiver)
    int[] result = []
    for nat proposer = matching.indices()[]
        if matching[proposer] == receiver
            result = result.append(int(proposer))
    return result

string[] hospital_report(const Market market)
    int[] resident = deferred(market, false).matching
    int[] hospital = deferred(market, true).matching
    int[] unmatched = []
    bool rural = true
    for 0 <= int proposer < market.proposers
        if resident[proposer] < 0
            unmatched = unmatched.append(proposer)
        if (resident[proposer] >= 0) != (hospital[proposer] >= 0)
            rural = false
    string[] rows = [
        "HR {market.name} residents={market.proposers} hospitals={int(len(market.names)) - market.proposers}",
        "RESIDENT-OPTIMAL " + pair_text(market, resident),
        "HOSPITAL-OPTIMAL " + pair_text(market, hospital),
        "UNMATCHED " + list_text(market.names, unmatched),
    ]
    for market.proposers <= int receiver < int(len(market.names))
        int[] first = partners_of(resident, receiver)
        int[] second = partners_of(hospital, receiver)
        bool same = first == second
        int capacity = market.capacities[receiver]
        string label = if same then "YES" else "NO"
        rows = rows.append("HOSPITAL " + market.names[receiver] + " cap={capacity} resident={len(first)} hospital={len(second)} same={label}")
        if len(first) != len(second) or (int(len(first)) < capacity and not same)
            rural = false
    return rows.append(if rural then "RURAL HOLDS" else "RURAL FAILS")

string[] manipulate(const Market market, int proposer)
    int[] truth = market.preferences[proposer]
    int baseline_b = boston(market).matching[proposer]
    int baseline_g = deferred(market, false).matching[proposer]
    int swaps = math.max(0, int(len(truth)) - 1)
    string[] rows = ["MANIPULATE {market.name} " + market.names[proposer] + " boston=" + partner_name(market, baseline_b) + " gs=" + partner_name(market, baseline_g) + " swaps={swaps}"]
    for 0 <= int index < swaps
        Market trial = market
        trial.preferences[proposer][index] = truth[index + 1]
        trial.preferences[proposer][index + 1] = truth[index]
        int[] results = [boston(trial).matching[proposer], deferred(trial, false).matching[proposer]]
        int[] baselines = [baseline_b, baseline_g]
        string[] labels = ["BOSTON", "GS"]
        for 0 <= int kind < 2
            if rank_in(truth, results[kind]) < rank_in(truth, baselines[kind])
                rows = rows.append("IMPROVE " + labels[kind] + " {index + 1} " + market.names[truth[index]] + " " + market.names[truth[index + 1]] + " result=" + partner_name(market, results[kind]))
    if len(rows) == 1
        rows = rows.append("NO IMPROVEMENT")
    return rows

int gcd(int first, int second)
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return first

string[] | error statistics(const Market market)
    Saved saved
    match market.current
        Saved present
            saved = present
        none
            return error("NO MATCHING")
    int[] proposer_ranks = []
    int[] receiver_ranks = []
    bool[] occupied = array(len(market.names), fill = false)
    for 0 <= int proposer < market.proposers
        int receiver = saved.matching[proposer]
        if receiver >= 0
            proposer_ranks = proposer_ranks.append(rank_in(market.preferences[proposer], receiver))
            receiver_ranks = receiver_ranks.append(rank_in(market.preferences[receiver], proposer))
            occupied[receiver] = true
    int pairs = int(len(proposer_ranks))
    int unmatched_receivers = 0
    for market.proposers <= int receiver < int(len(market.names))
        if not occupied[receiver]
            unmatched_receivers += 1
    int[][] ranks = [proposer_ranks, receiver_ranks]
    int[] unmatched = [market.proposers - pairs, unmatched_receivers]
    string[] labels = ["PROPOSERS", "RECEIVERS"]
    string[] rows = ["STATS {market.name} source={saved.source} pairs={pairs}"]
    for 0 <= int side < 2
        int total = math.sum(ranks[side])
        int first = 0
        for int value = ranks[side][]
            if value == 1
                first += 1
        string average = "-"
        string truncated = "-"
        if pairs > 0
            int divisor = gcd(total, pairs)
            average = "{total / divisor}/{pairs / divisor}"
            int cents = 100 * total / pairs
            int tail = cents % 100
            truncated = "{cents / 100}." + (if tail < 10 then "0" else "") + tail.string()
        rows = rows.append(labels[side] + " sum={total} average={average} truncated={truncated} first={first} unmatched={unmatched[side]}")
    return rows

string[] show_market(const Market market)
    string[] rows = []
    if market.kind == Kind.TwoSided
        rows = ["SHOW {market.name} MARKET proposers={market.proposers} receivers={int(len(market.names)) - market.proposers}"]
    else
        string kind = if market.kind == Kind.Roommate then "ROOMS" else "HOUSES"
        rows = ["SHOW {market.name} {kind} agents={len(market.names)}"]
    for nat agent = market.names.indices()[]
        string prefix
        if market.kind == Kind.TwoSided
            prefix = if int(agent) < market.proposers then "PROPOSER " + market.names[agent] else "RECEIVER " + market.names[agent] + " cap={market.capacities[agent]}"
        else
            prefix = "AGENT " + market.names[agent]
            if market.kind == Kind.Housing
                prefix += " house=" + market.houses[agent]
        string[] names = if market.kind == Kind.Housing then market.houses else market.names
        rows = rows.append(prefix + " " + list_text(names, market.preferences[agent]))
    if market.kind == Kind.TwoSided
        match market.current
            Saved saved
                rows = rows.append("CURRENT " + saved.source)
            none
                rows = rows.append("CURRENT -")
    return rows

Market | error new_market(const string[] words)
    string command = words[0]
    string name = words[1]
    if command == "RANDOM"
        int count = int.parse(words[2])
        int seed = int.parse(words[3])
        string[] names = []
        for string prefix = ["P", "R"][]
            for 1 <= int index <= count
                names = names.append("{prefix}{index}")
        auto market = Market(name, Kind.TwoSided, names, count)
        for 0 <= int agent < 2 * count
            int[] preference = if agent < count then sequence(count, 2 * count) else sequence(0, count)
            for count >= int length >= 2
                seed = 48271 * seed % 2147483647
                int index = seed % length
                int last = preference[length - 1]
                preference[length - 1] = preference[index]
                preference[index] = last
            market.preferences[agent] = preference
        return market
    Kind kind = if command == "ROOMS" then Kind.Roommate elif command == "HOUSES" then Kind.Housing else Kind.TwoSided
    string[] names = []
    string[] houses = []
    int proposers = 0
    for string word = words[2:][]
        if word == "|"
            proposers = int(len(names))
            continue
        string[] pair = word.split(":")
        string agent = pair[0]
        if position_of(names, agent) >= 0
            return error("DUPLICATE AGENT " + agent)
        if kind == Kind.Housing
            if position_of(houses, pair[1]) >= 0
                return error("DUPLICATE HOUSE " + pair[1])
            houses = houses.append(pair[1])
        names = names.append(agent)
    return Market(name, kind, names, proposers, houses)

string[] | error execute_market(Market &market, const string[] words)
    string command = words[0]
    string name = market.name
    if command == "SHOW"
        return show_market(market)
    elif command == "PREF"
        int agent = try agent_index(market, words[2])
        string[] names = if market.kind == Kind.Housing then market.houses else market.names
        int[] preference = []
        for string word = words[3:][]
            int choice = position_of(names, word)
            if choice < 0 or (market.kind == Kind.Roommate and choice == agent) or (market.kind == Kind.TwoSided and (agent < market.proposers) == (choice < market.proposers))
                return error("BAD CHOICE " + word)
            if position_of(preference, choice) >= 0
                return error("DUPLICATE CHOICE " + word)
            preference = preference.append(choice)
        market.preferences[agent] = preference
        if market.kind == Kind.TwoSided
            market.current = none
        return ["PREF {name} " + market.names[agent] + " length={len(preference)}"]
    elif command == "CHECK"
        return check_pairs(market, words)
    elif command == "ROOMMATES"
        return roommates(market, len(words) == 3)
    elif command == "TTC" or command == "SERIAL"
        try require_kind(market, Kind.Housing)
        return if command == "TTC" then ttc(market) else serial(market, words)
    try require_kind(market, Kind.TwoSided)
    if command == "CAPACITY"
        int receiver = try side_index(market, words[2], Side.Receiver)
        int capacity = int.parse(words[3])
        market.capacities[receiver] = capacity
        market.current = none
        return ["CAPACITY {name} " + market.names[receiver] + " {capacity}"]
    elif command == "GS" or command == "GSR" or command == "BOSTON"
        Run run = if command == "BOSTON" then boston(market) else deferred(market, command == "GSR", len(words) == 3)
        market.current = Saved(command, run.matching)
        string label = if command == "BOSTON" then "applications" else "proposals"
        return ["{command} {name} {label}={run.proposals}"].concat(run.history).append("MATCHING " + pair_text(market, run.matching))
    elif command == "HR"
        return hospital_report(market)
    elif command == "MANIPULATE"
        int proposer = try side_index(market, words[2], Side.Proposer)
        return manipulate(market, proposer)
    elif command == "STATS"
        return statistics(market)
    Lattice lattice = try enumerate_matchings(market)
    if command == "LATTICE"
        string[] rows = ["LATTICE {name} matchings={len(lattice.matchings)} rotations={len(lattice.rotations)}"]
        for nat index = lattice.matchings.indices()[]
            Metrics metrics = matching_metrics(market, lattice.matchings[index])
            string origin = if index == 0 then "-" else lattice.origins[index].string()
            string via = if index == 0 then "-" else lattice.vias[index].string()
            rows = rows.append("MATCHING {index + 1} from={origin} via={via} cost={metrics.cost} regret={metrics.regret} " + pair_text(market, lattice.matchings[index]))
        for nat index = lattice.rotations.indices()[]
            rows = rows.append("ROTATION {index + 1} " + lattice.rotations[index])
        return rows
    int[] values = []
    for int[] matching = lattice.matchings[]
        Metrics metrics = matching_metrics(market, matching)
        values = values.append(if command == "EGALITARIAN" then metrics.cost else metrics.regret)
    int best = position_of(values, math.min_all(values))
    market.current = Saved(command, lattice.matchings[best])
    string label = if command == "EGALITARIAN" then "cost" else "regret"
    return ["{command} {name} matching={best + 1} {label}={values[best]}", "MATCHING " + pair_text(market, lattice.matchings[best])]

string[] | error execute(map.Map<string, Market> &markets, const string[] words)
    string command = words[0]
    string name = words[1]
    if position_of(["MARKET", "ROOMS", "HOUSES", "RANDOM"], command) >= 0
        if markets.has(name)
            return error("DUPLICATE MARKET " + name)
        Market created = try new_market(words)
        string response
        if command == "RANDOM"
            response = "RANDOM {name} n={created.proposers} seed=" + words[3]
        elif created.kind == Kind.TwoSided
            response = "MARKET {name} proposers={created.proposers} receivers={int(len(created.names)) - created.proposers}"
        else
            response = "{command} {name} agents={len(created.names)}"
        .markets.set(name, created)
        return [response]
    match markets.get(name)
        Market market
            string[] rows = try execute_market(&market, words)
            .markets.set(name, market)
            return rows
        none
            return error("UNKNOWN MARKET " + name)

map.Map<string, Market> matching_markets = map.Map<string, Market>()
int command_count
scan(&command_count)
for 0 <= int command_index < command_count
    string command_line
    scan(&command_line)
    match execute(&matching_markets, command_line.split(" "))
        string[] rows
            for string row = rows[]
                print(row + NL)
        error problem
            print("ERROR " + problem.message + NL)
