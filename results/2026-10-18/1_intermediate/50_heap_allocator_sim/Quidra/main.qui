int minimum(int a, int b)
    return if a < b then a else b
int maximum(int a, int b)
    return if a > b then a else b
bool power_two(int value)
    if value < 1
        return false
    while value % 2 == 0
        value /= 2
    return value == 1
int size_class(int value)
    int result = 0
    while value >= 2
        value /= 2
        result += 1
    return result
T[] erase<T>(const T[] items, int at)
    T[] result = []
    for nat j < len(items)
        if int(j) != at
            result = result.append(items[j])
    return result
T[] insert<T>(const T[] items, int at, T value)
    T[] result = []
    for int j <= int(len(items))
        if j == at
            result = result.append(value)
        if j < int(len(items))
            result = result.append(items[j])
    return result
class Block(int address, int size, int owner = -1, int age = 0)
class Identity(string name)
    int state = 0
    int requested = 0
    int[] contents = []
    bool root = false
    string[] history = []
class Link(int source, int target)
class Freed(int address, int size, int merges)
class Heap(int size = 0, string mode = "FIRST")
    Block[] blocks = []
    Identity[] identities = []
    Link[] links = []
    int serial = 0
    int rover = 0
    int peak = 0
    int[] counters = [0, 0, 0, 0, 0, 0]
    if size > 0
        serial = 1
        blocks = [Block(0, size, age = serial)]
    int .identity(string name)
        for nat j < len(identities)
            if identities[j].name == name
                return int(j)
        identities = identities.append(Identity(name))
        return int(len(identities)) - 1
    int at_address(int address)
        for nat j < len(blocks)
            if blocks[j].address == address
                return int(j)
        return -1
    int owned(int owner)
        for nat j < len(blocks)
            if blocks[j].owner == owner
                return int(j)
        return -1
    int required(int requested)
        int result = ((requested + 7) / 8) * 8 + 8
        if mode == "BUDDY"
            int rounded = 32
            while rounded < result
                rounded *= 2
            return rounded
        return result
    Block .free_block(int address, int length)
        serial += 1
        return Block(address, length, age = serial)
    int used_bytes()
        int total = 0
        for Block block = blocks[]
            if block.owner >= 0
                total += block.size
        return total
    int fragmentation()
        int total = 0
        int largest = 0
        for Block block = blocks[]
            if block.owner < 0
                total += block.size
                largest = maximum(largest, block.size)
        return if total == 0 then 0 else (total - largest) * 100 / total
    int .allocate(int owner, int needed, int alignment)
        int chosen = -1
        int placement = 0
        int start_index = 0
        if mode == "NEXT"
            for nat j < len(blocks)
                if blocks[j].address <= rover < blocks[j].address + blocks[j].size
                    start_index = int(j)
        for int turn < int(len(blocks))
            int candidate = if mode == "NEXT" then (start_index + turn) % int(len(blocks)) else turn
            Block block = blocks[candidate]
            if block.owner >= 0
                continue
            int location = ((block.address + 8 + alignment - 1) / alignment) * alignment - 8
            if 0 < location - block.address < 16
                location += alignment
            if location + needed > block.address + block.size
                continue
            bool better = chosen < 0
            if chosen >= 0
                Block previous = blocks[chosen]
                if mode == "BEST" or mode == "BUDDY"
                    better = block.size < previous.size
                elif mode == "WORST"
                    better = block.size > previous.size
                elif mode == "SEGFIT"
                    better = size_class(block.size) < size_class(previous.size) or (size_class(block.size) == size_class(previous.size) and block.age > previous.age)
            if better
                chosen = candidate
                placement = location
            if mode == "FIRST" or mode == "NEXT"
                break
        if chosen < 0
            return -1
        Block target = blocks[chosen]
        blocks = erase(blocks, chosen)
        int offset = chosen
        if mode == "BUDDY"
            int remaining = target.size
            while remaining > needed
                remaining /= 2
                Block upper = .free_block(target.address + remaining, remaining)
                blocks = insert(blocks, offset, upper)
            blocks = insert(blocks, offset, Block(target.address, needed, owner))
            return target.address
        if placement > target.address
            Block leading = .free_block(target.address, placement - target.address)
            blocks = insert(blocks, offset, leading)
            offset += 1
        int available = target.address + target.size - placement
        int used_size = if available - needed >= 16 then needed else available
        blocks = insert(blocks, offset, Block(placement, used_size, owner))
        if available - needed >= 16
            Block trailing = .free_block(placement + needed, available - needed)
            blocks = insert(blocks, offset + 1, trailing)
        if mode == "NEXT"
            rover = (placement + used_size) % size
        return placement
    Freed .release(int address)
        int at = at_address(address)
        blocks[at].owner = -1
        int merges = 0
        if mode == "BUDDY"
            while blocks[at].size < size
                int length = blocks[at].size
                int buddy = if blocks[at].address % (2 * length) == 0 then blocks[at].address + length else blocks[at].address - length
                int partner = at_address(buddy)
                if partner < 0 or blocks[partner].owner >= 0 or blocks[partner].size != length
                    break
                int low = minimum(at, partner)
                blocks = erase(blocks, maximum(at, partner))
                blocks[low].address = minimum(address, buddy)
                blocks[low].size = 2 * length
                at = low
                address = blocks[at].address
                merges += 1
        else
            if at + 1 < int(len(blocks)) and blocks[at + 1].owner < 0
                blocks[at].size += blocks[at + 1].size
                blocks = erase(blocks, at + 1)
                merges += 1
            if at > 0 and blocks[at - 1].owner < 0
                blocks[at - 1].size += blocks[at].size
                blocks = erase(blocks, at)
                at -= 1
                merges += 1
        Block registered = .free_block(blocks[at].address, blocks[at].size)
        blocks[at] = registered
        return Freed(registered.address, registered.size, merges)
    int | error .live(string name)
        int owner = .identity(name)
        if identities[owner].state != 1
            return error((if identities[owner].state == 2 then "USE AFTER FREE " else "UNKNOWN ID ") + name)
        return owner
    void .remember(int owner, string line)
        identities[owner].history = identities[owner].history.append(line)
    void .forget(int owner)
        identities[owner].state = 2
        identities[owner].root = false
        Link[] kept = []
        for Link edge = links[]
            if edge.source != owner and edge.target != owner
                kept = kept.append(edge)
        links = kept
    string | error .free_id(int owner, string label)
        string name = identities[owner].name
        if identities[owner].state == 2
            return error("DOUBLE FREE {name}")
        if identities[owner].state == 0
            return error("UNKNOWN ID {name}")
        Block block = blocks[owned(owner)]
        Freed result = .release(block.address)
        .forget(owner)
        if label == "FREE"
            counters[1] += 1
        string line = "{label} {name} block={block.size} merges={result.merges} free={result.address}+{result.size}"
        .remember(owner, line)
        return line
    bool[] reachable()
        bool[] marked = array(len(identities), fill = false)
        for nat j < len(identities)
            marked[j] = identities[j].state == 1 and identities[j].root
        bool changed = true
        while changed
            changed = false
            for Link edge = links[]
                if marked[edge.source] and not marked[edge.target]
                    marked[edge.target] = true
                    changed = true
        return marked
    string[] tree(int address, int length, int depth)
        string prefix = string.repeat(" ", nat(depth * 2)) + "{address}+{length}"
        int at = at_address(address)
        if at >= 0 and blocks[at].size == length
            return [prefix + (if blocks[at].owner < 0 then " FREE" else " USED " + identities[blocks[at].owner].name)]
        int half = length / 2
        return [prefix + " split"].concat(tree(address, half, depth + 1)).concat(tree(address + half, half, depth + 1))
    string[] | error .command(const string[] words)
        string op = words[0]
        if op == "BENCH"
            int heap_size = int.parse(words[1])
            if heap_size < 32 or heap_size > 65536 or not power_two(heap_size)
                return error("BAD HEAP SIZE")
            int seed = int.parse(words[2])
            int steps = int.parse(words[3])
            int maxreq = int.parse(words[4])
            string[] output = ["BENCH heap={heap_size} seed={seed} ops={steps} maxreq={maxreq}"]
            for string allocation_mode = "FIRST NEXT BEST WORST SEGFIT BUDDY".split(" ")[]
                Heap experiment = Heap(heap_size, allocation_mode)
                int random_state = seed
                int[] active = []
                int successful = 0
                int failures = 0
                for int step < steps
                    random_state = (48271 * random_state) % 2147483647
                    bool allocating = len(active) == 0 or random_state % 3 != 0
                    random_state = (48271 * random_state) % 2147483647
                    if allocating
                        int requested = 1 + random_state % maxreq
                        int address = .experiment.allocate(0, experiment.required(requested), 8)
                        if address < 0
                            failures += 1
                        else
                            successful += 1
                            active = active.append(address)
                    else
                        int chosen = random_state % int(len(active))
                        .experiment.release(active[chosen])
                        active = erase(active, chosen)
                    experiment.peak = maximum(experiment.peak, experiment.used_bytes())
                output = output.append("BENCH {allocation_mode} ok={successful} fail={failures} peak={experiment.peak} used={experiment.used_bytes()} frag={experiment.fragmentation()} blocks={len(experiment.blocks)}")
            return output
        if size == 0
            return error("NO HEAP")
        if op == "MALLOC" or op == "CALLOC" or op == "MEMALIGN" or op == "REALLOC"
            int alignment = 8
            if op == "MEMALIGN"
                if mode == "BUDDY"
                    return error("UNSUPPORTED IN BUDDY MODE")
                alignment = int.parse(words[2])
                if alignment < 8 or alignment > 4096 or not power_two(alignment)
                    return error("BAD ALIGNMENT")
            int requested = int.parse(words[if op == "MEMALIGN" then 3 else 2])
            if op == "CALLOC"
                requested *= int.parse(words[3])
            int owner = .identity(words[1])
            if op == "REALLOC" and requested == 0
                return [try .free_id(owner, "FREE")]
            if requested == 0
                return error("BAD SIZE")
            if op == "REALLOC" and identities[owner].state == 2
                return error("USE AFTER FREE {words[1]}")
            bool reallocating = op == "REALLOC" and identities[owner].state == 1
            if not reallocating and identities[owner].state == 1
                return error("DUPLICATE ID {words[1]}")
            int needed = required(requested)
            int address = -1
            int original = -1
            string kind = "kept"
            int[] old_contents = identities[owner].contents
            if reallocating
                int at = owned(owner)
                Block old = blocks[at]
                original = old.address
                address = original
                if needed <= old.size
                    if mode == "BUDDY"
                        while blocks[at].size > needed
                            blocks[at].size /= 2
                            Block upper = .free_block(original + blocks[at].size, blocks[at].size)
                            blocks = insert(blocks, at + 1, upper)
                            kind = "shrunk"
                    elif old.size - needed >= 16
                        blocks[at].size = needed
                        blocks = insert(blocks, at + 1, Block(original + needed, old.size - needed))
                        .release(original + needed)
                        kind = "shrunk"
                elif mode != "BUDDY" and at + 1 < int(len(blocks)) and blocks[at + 1].owner < 0 and old.size + blocks[at + 1].size >= needed
                    int total = old.size + blocks[at + 1].size
                    blocks = erase(blocks, at + 1)
                    blocks[at].size = if total - needed >= 16 then needed else total
                    if total - needed >= 16
                        Block trailing = .free_block(original + needed, total - needed)
                        blocks = insert(blocks, at + 1, trailing)
                    kind = "grown"
                else
                    bool can_grow = mode == "BUDDY"
                    int length = old.size
                    while can_grow and length < needed
                        int partner = at_address(original + length)
                        can_grow = original % (2 * length) == 0 and partner >= 0 and blocks[partner].owner < 0 and blocks[partner].size == length
                        length *= 2
                    if can_grow
                        length = old.size
                        while length < needed
                            blocks = erase(blocks, at_address(original + length))
                            length *= 2
                        blocks[at].size = needed
                        kind = "grown"
                    else
                        address = .allocate(owner, needed, 8)
                        if address >= 0
                            .release(original)
                            kind = "moved"
            else
                address = .allocate(owner, needed, alignment)
            if address < 0
                counters[4] += 1
                return error("OUT OF MEMORY {words[1]}")
            identities[owner].state = 1
            identities[owner].requested = requested
            identities[owner].contents = array(nat(requested), fill = if op == "CALLOC" then 0 else -1)
            if reallocating
                for int j < minimum(int(len(old_contents)), requested)
                    identities[owner].contents[j] = old_contents[j]
                counters[2] += 1
                if kind == "moved"
                    counters[3] += 1
            else
                counters[0] += 1
            Block final_block = blocks[at_address(address)]
            string label = if op == "REALLOC" and not reallocating then "MALLOC" else op
            string line = "{label} {words[1]} addr={address + 8} block={final_block.size}"
            if reallocating
                line += " {kind}" + (if kind == "moved" then " from={original + 8}" else "")
            .remember(owner, line)
            return [line]
        if op == "FREE"
            return [try .free_id(.identity(words[1]), "FREE")]
        if op == "FILL" or op == "READ" or op == "COPY"
            int owner = try .live(words[1])
            int offset = int.parse(words[2])
            int length = int.parse(words[if op == "COPY" then 5 else 3])
            if offset + length > identities[owner].requested
                return error("OUT OF BOUNDS {words[1]}")
            if op == "COPY"
                int source = try .live(words[3])
                int source_offset = int.parse(words[4])
                if source_offset + length > identities[source].requested
                    return error("OUT OF BOUNDS {words[3]}")
                int[] copied = identities[source].contents[source_offset:<source_offset + length]
                for int j < length
                    identities[owner].contents[offset + j] = copied[j]
                return ["COPY {words[1]} {offset}+{length} from {words[3]} {source_offset}"]
            if op == "FILL"
                int value = int.parse(words[4])
                for int j < length
                    identities[owner].contents[offset + j] = value
                return ["FILL {words[1]} {offset}+{length} = {value}"]
            string[] bytes = []
            for int j < length
                int value = identities[owner].contents[offset + j]
                bytes = bytes.append(if value < 0 then "?" else value.string())
            return ["READ {words[1]} {offset}+{length} = " + bytes.join(" ")]
        if op == "ROOT" or op == "UNROOT"
            int owner = try .live(words[1])
            if op == "UNROOT" and not identities[owner].root
                return error("NOT ROOT {words[1]}")
            identities[owner].root = op == "ROOT"
            return ["{op} {words[1]}"]
        if op == "LINK" or op == "UNLINK"
            int source = try .live(words[1])
            int target = try .live(words[2])
            int found = -1
            for nat j < len(links)
                if links[j].source == source and links[j].target == target
                    found = int(j)
            if op == "UNLINK" and found < 0
                return error("NO LINK {words[1]} {words[2]}")
            if op == "LINK" and found < 0
                links = links.append(Link(source, target))
            elif op == "UNLINK"
                links = erase(links, found)
            return ["{op} {words[1]} {words[2]}"]
        if op == "GC"
            bool[] marked = reachable()
            int[] victims = []
            int total = 0
            for Block block = blocks[]
                if block.owner >= 0 and not marked[block.owner]
                    victims = victims.append(block.owner)
                    total += block.size
            string[] output = ["GC collected={len(victims)} bytes={total}"]
            for int owner = victims[]
                output = output.append(try .free_id(owner, "COLLECT"))
            counters[5] += int(len(victims))
            return output
        if op == "SBRK"
            int amount = int.parse(words[1])
            bool valid = if mode == "BUDDY" then amount == size and 2 * size <= 65536 else amount >= 16 and amount % 8 == 0 and size + amount <= 65536
            if not valid
                return error("BAD SBRK SIZE")
            int original = size
            size += amount
            blocks = blocks.append(Block(original, amount))
            Freed result = .release(original)
            return ["SBRK heap={size} free={result.address}+{result.size}"]
        if op == "TRIM"
            int original = size
            while len(blocks) > 1
                Block last = blocks[len(blocks) - 1]
                if last.owner >= 0 or (mode == "BUDDY" and last.size != size / 2)
                    break
                size = last.address
                blocks = erase(blocks, int(len(blocks)) - 1)
                if mode != "BUDDY"
                    break
            if rover >= size
                rover = 0
            return ["TRIM heap={size} released={original - size}"]
        if op == "COMPACT"
            if mode == "BUDDY"
                return error("UNSUPPORTED IN BUDDY MODE")
            Block[] packed = []
            string[] moves = []
            int address = 0
            for Block block = blocks[]
                if block.owner < 0
                    continue
                if block.address != address
                    string line = "MOVE {identities[block.owner].name} {block.address + 8} -> {address + 8}"
                    moves = moves.append(line)
                    .remember(block.owner, line)
                packed = packed.append(Block(address, block.size, block.owner))
                address += block.size
            if address < size
                Block remainder = .free_block(address, size - address)
                packed = packed.append(remainder)
            blocks = packed
            rover = 0
            counters[3] += int(len(moves))
            string free_text = if address == size then "none" else "{address}+{size - address}"
            return ["COMPACT moved={len(moves)} free={free_text}"].concat(moves)
        if op == "WHO"
            int address = int.parse(words[1])
            if address >= size
                return ["WHO {address} outside"]
            for Block block = blocks[]
                if block.address <= address < block.address + block.size
                    if block.owner < 0
                        return ["WHO {address} free {block.address}+{block.size}"]
                    string name = identities[block.owner].name
                    if address < block.address + 8
                        return ["WHO {address} header {name}"]
                    int offset = address - block.address - 8
                    string label = if offset < identities[block.owner].requested then "data" else "slack"
                    return ["WHO {address} {label} {name}+{offset}"]
        if op == "DUMP"
            string[] output = ["DUMP mode={mode} heap={size} blocks={len(blocks)}" + (if mode == "NEXT" then " rover={rover}" else "")]
            for Block block = blocks[]
                output = output.append("{block.address} {block.size} " + (if block.owner < 0 then "FREE" else "USED {identities[block.owner].name} req={identities[block.owner].requested}"))
            return output
        if op == "MAP"
            string units = ""
            for Block block = blocks[]
                units += if block.owner < 0 then "F" else "H"
                for 1 <= int j < block.size / 8
                    units += if block.owner < 0 then "." elif (j - 1) * 8 < identities[block.owner].requested then "#" else "-"
            string[] output = ["MAP heap={size}"]
            int start = 0
            while start < int(len(units))
                int end = minimum(start + 64, int(len(units)))
                int address = start * 8
                output = output.append("{address:int=5,zero} " + units[start:<end])
                start = end
            return output
        if op == "FREELIST"
            int[] ordered = []
            for nat j < len(blocks)
                if blocks[j].owner < 0
                    ordered = ordered.append(int(j))
            if mode == "SEGFIT"
                for 1 <= int j < int(len(ordered))
                    int selected = ordered[j]
                    int at = j
                    while at > 0 and blocks[ordered[at - 1]].age < blocks[selected].age
                        ordered[at] = ordered[at - 1]
                        at -= 1
                    ordered[at] = selected
            string[] output = ["FREELIST count={len(ordered)}"]
            for 4 <= int category <= 16
                string[] entries = []
                for int index = ordered[]
                    Block block = blocks[index]
                    if size_class(block.size) == category
                        entries = entries.append("{block.address}+{block.size}")
                if len(entries) > 0
                    output = output.append("{2 ^ category}-{(2 ^ (category + 1)) - 1}: " + entries.join(" "))
            return output
        if op == "TREE"
            if mode != "BUDDY"
                return error("REQUIRES BUDDY MODE")
            return ["TREE heap={size}"].concat(tree(0, size, 0))
        if op == "STATS"
            int used_count = 0
            int free_count = 0
            int largest = 0
            int requested = 0
            for Block block = blocks[]
                if block.owner < 0
                    free_count += 1
                    largest = maximum(largest, block.size)
                else
                    used_count += 1
                    requested += identities[block.owner].requested
            int used = used_bytes()
            return ["STATS used={used} used_blocks={used_count} free={size - used} free_blocks={free_count} largest={largest} frag={fragmentation()} requested={requested} peak={peak}", "OPS allocs={counters[0]} frees={counters[1]} reallocs={counters[2]} moves={counters[3]} failures={counters[4]} collected={counters[5]}"]
        if op == "LEAKS"
            bool[] marked = reachable()
            string[] names = []
            int requested = 0
            int lost = 0
            for nat j < len(identities)
                if identities[j].state == 1
                    names = names.append(identities[j].name)
                    requested += identities[j].requested
                    if not marked[j]
                        lost += 1
            string[] output = ["LEAKS count={len(names)} requested={requested} lost={lost}"]
            for string name = names.sorted()[]
                int owner = .identity(name)
                Block block = blocks[owned(owner)]
                string status = if marked[owner] then "reachable" else "lost"
                output = output.append("LEAK {name} addr={block.address + 8} block={block.size} req={identities[owner].requested} {status}")
            return output
        int owner = .identity(words[1])
        return ["HISTORY {words[1]} events={len(identities[owner].history)}"].concat(identities[owner].history)
Heap heap = Heap()
int count
scan(&count)
for int command_index < count
    string line
    scan(&line)
    string[] words = line.split(" ")
    if words[0] == "HEAP"
        int size = int.parse(words[1])
        string mode = words[2]
        if size < 32 or size > 65536 or size % 8 != 0 or (mode == "BUDDY" and not power_two(size))
            print("ERROR BAD HEAP SIZE{NL}")
        else
            heap = Heap(size, mode)
            print("HEAP size={size} mode={mode}{NL}")
    else
        match .heap.command(words)
            string[] output
                print(output.join(NL) + NL)
            error problem
                print("ERROR " + problem.message + NL)
    heap.peak = maximum(heap.peak, heap.used_bytes())
