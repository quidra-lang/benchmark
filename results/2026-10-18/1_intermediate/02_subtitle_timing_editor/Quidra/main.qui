import math

// Times and every intermediate calculation are exact arbitrary-precision integers.
int floor_ratio(int numerator, int denominator)
    if denominator < 0
        return floor_ratio(-numerator, -denominator)
    return if numerator >= 0 then numerator / denominator else -((-numerator + denominator - 1) / denominator)

int rounded(int numerator, int denominator)
    if denominator < 0
        return rounded(-numerator, -denominator)
    return floor_ratio(2 * numerator + denominator, 2 * denominator)

bool digits(string value, nat limit = 9)
    if len(value) == 0 or len(value) > limit
        return false
    for nat k < len(value)
        if not "0123456789".contains(value[k])
            return false
    return true

int time_value(string value)
    if len(value) != 12
        return -1
    if value[2] != ":" or value[5] != ":" or value[8] != ","
        return -1
    string raw = value[:<2] + value[3:<5] + value[6:<8] + value[9:]
    if not digits(raw)
        return -1
    int hours = int.parse(value[:<2])
    int minutes = int.parse(value[3:<5])
    int seconds = int.parse(value[6:<8])
    if minutes > 59 or seconds > 59
        return -1
    return hours * 3600000 + minutes * 60000 + seconds * 1000 + int.parse(value[9:])

string time_text(int value, string style = "SRT")
    if style == "ASS"
        int c = (value + 5) / 10
        return "{c / 360000}:{c / 6000 % 60:int=2,zero}:{c / 100 % 60:int=2,zero}.{c % 100:int=2,zero}"
    string separator = if style == "VTT" then "." else ","
    return "{value / 3600000:int=2,zero}:{value / 60000 % 60:int=2,zero}:{value / 1000 % 60:int=2,zero}{separator}{value % 1000:int=3,zero}"

string decimal_text(int value)
    return "{value / 100}.{value % 100:int=2,zero}"

class Cue(int index, int start, int end, string[] lines)

int characters(const Cue cue)
    nat[] lengths = [for string line = cue.lines[] then len(line)]
    return int(lengths.sum())

bool dialogue(const Cue cue)
    for string line = cue.lines[]
        if line.starts_with("- ")
            return true
    return false

string[] words_of(string[] lines)
    return [for string word = lines.join(" ").split(" ")[] if word != "" then word]

string[] wrap(string[] lines, nat width)
    string[] result = []
    for string word = words_of(lines)[]
        if len(result) > 0 and len(result[len(result) - 1]) + 1 + len(word) <= width
            result[len(result) - 1] += " " + word
        else
            result = result.append(word)
    return result

string list_line(const Cue cue, int position)
    return "{position} {cue.index} {time_text(cue.start)} {time_text(cue.end)} " + cue.lines.join("|")

int find_from(string value, string needle, int start)
    match value[start:].find(needle)
        nat position
            return start + int(position)
        none
            return -1

// kind, consumed characters, position-code digit, format-tag number.
int[] markup(string value, int position)
    string[] tags = ["<i>", "</i>", "<b>", "</b>", "<u>", "</u>"]
    string tail = value[position:]
    for 0 <= int k < 6
        if tail.starts_with(tags[k])
            return [1, int(len(tags[k])), 0, k]
    if tail.starts_with("</font>")
        return [2, 7, 0, 0]
    if tail.starts_with("<font") and len(tail) > 5
        if tail[5] == " " or tail[5] == ">"
            int close = find_from(tail, ">", 5)
            if close >= 0
                return [2, close + 1, 0, 0]
    if len(tail) >= 6 and tail[:<4] == "{{\an" and tail[5] == "}}" and "123456789".contains(tail[4])
        return [3, 6, int.parse(tail[4]), 0]
    return [0, 1, 0, 0]

class Converted(string text, int tags, int code)

Converted convert_markup(string value, string mode)
    string result = ""
    int removed = 0
    int first_code = 0
    int p = 0
    string[] ass_tags = ["{{\i1}}", "{{\i0}}", "{{\b1}}", "{{\b0}}", "{{\u1}}", "{{\u0}}"]
    while p < int(len(value))
        int[] item = markup(value, p)
        string raw = value[p:<p + item[1]]
        if item[0] != 0
            removed += 1
            if item[0] == 3 and first_code == 0
                first_code = item[2]
            if mode == "VTT" and item[0] == 1
                result += raw
            elif mode == "ASS"
                if item[0] == 1
                    result += ass_tags[item[3]]
                elif item[0] == 3
                    result += raw
        elif mode == "VTT"
            result += if raw == "&" then "&amp;" elif raw == "<" then "&lt;" elif raw == ">" then "&gt;" else raw
        else
            result += raw
        p += item[1]
    return Converted(if mode == "ASS" then result else result.trim(), removed, first_code)

class Cleaned(string text, int segments, int labels)

Cleaned clean_hi(string value)
    string result = ""
    int segments = 0
    int p = 0
    while p < int(len(value))
        string close = if value[p] == "[" then "]" elif value[p] == "(" then ")" else ""
        int end_at = if close == "" then -1 else find_from(value, close, p + 1)
        if end_at >= 0
            segments += 1
            p = end_at + 1
        else
            result += value[p]
            p += 1
    result = words_of([result]).join(" ")
    string prefix = if result.starts_with("- ") then "- " else ""
    string body = result[len(prefix):]
    int colon = find_from(body, ":", 0)
    bool speaker = colon > 0
    if speaker
        speaker = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(body[0])
        for 0 <= int k < colon
            if not "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ".contains(body[k])
                speaker = false
    if speaker
        result = words_of([prefix + body[colon + 1:]]).join(" ")
    return Cleaned(result, segments, if speaker then 1 else 0)

string[] schema(string command)
    if command == "SEARCH" or command == "REPLACE"
        return ["string"]
    if command == "AT"
        return ["time"]
    if command == "GAPS" or command == "FIXOVERLAP" or command == "EXTEND" or command == "MERGE" or command == "SPLIT"
        return ["unsigned"]
    if command == "FRAMES" or command == "SNAP"
        return ["fps"]
    if command == "SHIFT"
        return ["signed"]
    if command == "SHIFTFROM"
        return ["position", "signed"]
    if command == "SCALE"
        return ["unsigned", "unsigned"]
    if command == "SYNC"
        return ["position", "time", "position", "time"]
    if command == "TIME"
        return ["position", "time", "time"]
    if command == "INSERT"
        return ["position", "time", "time", "text"]
    if command == "TEXT"
        return ["position", "text"]
    if command == "DELETE"
        return ["position"]
    return []

string[] execute(string input_line, Cue[] &cues, Cue[][] &history, string[] &history_names)
    string[] fields = input_line.split(" ")
    string command = fields[0]
    string known = " LIST VALIDATE SEARCH AT GAPS STATS PRINT TOVTT TOASS FRAMES SHIFT SHIFTFROM SCALE SYNC SNAP FIXOVERLAP EXTEND TIME SORT RENUMBER MERGE SPLIT INSERT DELETE TEXT BALANCE STRIP CLEANHI REPLACE UNDO "
    if not known.contains(" {command} ")
        return ["ERROR unknown command"]
    string[] kinds = schema(command)
    if command == "DELETE" and len(fields) == 3
        kinds = ["position", "position"]
    bool string_tail = command == "SEARCH" or command == "INSERT" or command == "TEXT" or command == "REPLACE"
    if len(fields) < len(kinds) + 1 or (not string_tail and len(fields) != len(kinds) + 1)
        return ["ERROR bad arguments"]
    string[] args = []
    int[] values = []
    int[] fps = []
    for nat k < len(kinds)
        string argument = if string_tail and k + 1 == len(kinds) then fields[k + 1:].join(" ") else fields[k + 1]
        args = args.append(argument)
        string kind = kinds[k]
        int value = 0
        if kind == "time"
            value = time_value(argument)
            if value < 0
                return ["ERROR bad arguments"]
        elif kind == "fps"
            string[] rate = argument.split("/")
            if len(rate) < 1 or len(rate) > 2
                return ["ERROR bad arguments"]
            for string part = rate[]
                if not digits(part)
                    return ["ERROR bad arguments"]
                int component = int.parse(part)
                if component < 1 or component > 100000
                    return ["ERROR bad arguments"]
                fps = fps.append(component)
            if len(fps) == 1
                fps = fps.append(1)
        elif kind == "text"
            for string part = argument.split("|")[]
                if part == ""
                    return ["ERROR bad arguments"]
        elif kind != "string"
            string magnitude = if kind == "signed" and argument.starts_with("-") then argument[1:] else argument
            if not digits(magnitude)
                return ["ERROR bad arguments"]
            value = int.parse(magnitude)
            if argument.starts_with("-")
                value = -value
            if kind == "position" and value < 1
                return ["ERROR bad arguments"]
        values = values.append(value)
    if command == "REPLACE"
        string[] pair = args[0].split("|")
        if len(pair) != 2 or pair[0] == "" or pair[1] == ""
            return ["ERROR bad arguments"]
    if command == "GAPS" or command == "FIXOVERLAP" or command == "MERGE"
        if values[0] > 60000
            return ["ERROR bad arguments"]
    if command == "EXTEND" and (values[0] < 1 or values[0] > 60000)
        return ["ERROR bad arguments"]
    if command == "SPLIT" and (values[0] < 10 or values[0] > 80)
        return ["ERROR bad arguments"]
    if command == "SCALE"
        if values[0] < 1 or values[0] > 100000 or values[1] < 1 or values[1] > 100000
            return ["ERROR bad arguments"]
    if command == "DELETE" and len(values) == 2 and values[1] < values[0]
        return ["ERROR bad arguments"]
    for nat k < len(kinds)
        if kinds[k] == "position"
            int limit = int(len(cues)) + (if command == "INSERT" then 1 else 0)
            if values[k] > limit
                return ["ERROR no cue {values[k]}"]
    if command == "SYNC" and cues[values[0] - 1].start == cues[values[2] - 1].start
        return ["ERROR sync points coincide"]
    if command == "UNDO"
        if len(history) == 0
            return ["ERROR nothing to undo"]
        cues = history[len(history) - 1]
        string undone = history_names[len(history_names) - 1]
        history = history[:<len(history) - 1]
        history_names = history_names[:<len(history_names) - 1]
        return ["UNDO command={undone}"]
    string modifying = " SHIFT SHIFTFROM SCALE SYNC SNAP FIXOVERLAP EXTEND TIME SORT RENUMBER MERGE SPLIT INSERT DELETE TEXT BALANCE STRIP CLEANHI REPLACE "
    if modifying.contains(" {command} ")
        history = history.append(cues)
        history_names = history_names.append(command)
    int n = int(len(cues))
    string[] output = []
    if command == "LIST" or command == "AT" or command == "SEARCH" or command == "GAPS" or command == "FRAMES"
        int count = 0
        for 0 <= int k < n
            Cue cue = cues[k]
            if command == "LIST" or (command == "AT" and cue.start <= values[0] < cue.end)
                output = output.append(list_line(cue, k + 1))
                count += 1
            elif command == "SEARCH"
                for string line = cue.lines[]
                    if line.contains(args[0])
                        output = output.append("{k + 1} {time_text(cue.start)} {line}")
                        count += 1
                        break
            elif command == "GAPS" and k + 1 < n
                int gap = cues[k + 1].start - cue.end
                if gap < values[0]
                    output = output.append("{k + 1} {k + 2} {gap}")
                    count += 1
            elif command == "FRAMES"
                output = output.append("{k + 1} {cue.start * fps[0] / (1000 * fps[1])} {cue.end * fps[0] / (1000 * fps[1])}")
        if command == "AT"
            output = output.append("AT active={count}")
        elif command == "SEARCH"
            output = output.append("SEARCH found={count}")
        elif command == "GAPS"
            output = output.append("GAPS count={count}")
        return output
    if command == "VALIDATE"
        for 0 <= int k < n
            Cue cue = cues[k]
            int duration = cue.end - cue.start
            string prefix = "cue {k + 1}: "
            if cue.index != k + 1
                output = output.append("{prefix}index {cue.index} (expected {k + 1})")
            if duration <= 0
                output = output.append(prefix + "end not after start")
            if k > 0 and cue.start < cues[k - 1].end
                output = output.append("{prefix}overlaps previous by {cues[k - 1].end - cue.start} ms")
            if 1 <= duration < 700 or duration > 7000
                output = output.append(prefix + (if duration < 700 then "too short (" else "too long (") + "{duration} ms)")
            for nat j < len(cue.lines)
                if len(cue.lines[j]) > 42
                    output = output.append("{prefix}line {j + 1} too long ({len(cue.lines[j])} chars)")
            if len(cue.lines) >= 3
                output = output.append("{prefix}too many lines ({len(cue.lines)})")
            int count = characters(cue)
            if duration >= 1 and count * 1000 > 21 * duration
                output = output.append("{prefix}too fast ({decimal_text(count * 100000 / duration)} cps)")
        return output.append("VALIDATE problems={len(output)}")
    if command == "STATS"
        output = ["STATS cues={n}"]
        if n == 0
            return output
        int[] durations = [for Cue cue = cues[] then math.max(0, cue.end - cue.start)]
        int total = durations.sum()
        int[] counts = [for Cue cue = cues[] if cue.end > cue.start then characters(cue)]
        nat longest = durations.indices()[durations >= durations.max_all()][0]
        output = output.append("duration total={time_text(total)} mean={time_text(total / n)}")
        output = output.append("speed " + (if total == 0 then "-" else decimal_text(counts.sum() * 100000 / total)))
        output = output.append("longest cue={longest + 1} duration={time_text(durations[longest])}")
        if n == 1
            return output.append("gap none")
        int[] gaps = [for 0 <= int k < n - 1 then cues[k + 1].start - cues[k].end]
        nat largest = gaps.indices()[gaps >= gaps.max_all()][0]
        return output.append("gap cue={largest + 1} ms={gaps[largest]}")
    if command == "PRINT" or command == "TOVTT" or command == "TOASS"
        if command == "TOVTT"
            output = ["WEBVTT", ""]
        elif command == "TOASS"
            output = ["[Events]", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"]
        for Cue cue = cues[]
            string[] lines = cue.lines
            int first_code = 0
            if command != "PRINT"
                lines = []
                for string line = cue.lines[]
                    Converted converted = convert_markup(line, if command == "TOASS" then "ASS" else "VTT")
                    if first_code == 0
                        first_code = converted.code
                    if command == "TOASS" or converted.text != ""
                        lines = lines.append(converted.text)
            if command == "TOASS"
                output = output.append("Dialogue: 0," + time_text(cue.start, "ASS") + "," + time_text(cue.end, "ASS") + ",Default,,0,0,0,," + lines.join("\N"))
            elif len(lines) > 0
                string settings = ""
                if command == "TOVTT" and first_code > 0
                    if first_code >= 7
                        settings += " line:0"
                    elif first_code >= 4
                        settings += " line:50%"
                    if first_code % 3 == 1
                        settings += " align:start"
                    elif first_code % 3 == 0
                        settings += " align:end"
                string style = if command == "TOVTT" then "VTT" else "SRT"
                output = output.append("{cue.index}").append("{time_text(cue.start, style)} --> {time_text(cue.end, style)}{settings}").concat(lines).append("")
        return output
    if command == "SHIFT" or command == "SHIFTFROM" or command == "SCALE" or command == "SYNC" or command == "SNAP"
        int begin = if command == "SHIFTFROM" then values[0] - 1 else 0
        int clamped = 0
        int changed = 0
        int sync_start = 0
        int sync_den = 1
        if command == "SYNC"
            sync_start = cues[values[0] - 1].start
            sync_den = cues[values[2] - 1].start - sync_start
        for begin <= int k < n
            bool was_clamped = false
            int[] times = [cues[k].start, cues[k].end]
            for 0 <= int j < 2
                int original = times[j]
                int value = original
                if command == "SHIFT" or command == "SHIFTFROM"
                    value += values[if command == "SHIFT" then 0 else 1]
                elif command == "SCALE"
                    value = rounded(original * values[0], values[1])
                elif command == "SYNC"
                    value = rounded(values[1] * sync_den + (original - sync_start) * (values[3] - values[1]), sync_den)
                else
                    int frame = rounded(original * fps[0], 1000 * fps[1])
                    value = rounded(frame * 1000 * fps[1], fps[0])
                if value < 0
                    was_clamped = true
                    value = 0
                if value != original
                    changed += 1
                times[j] = value
            cues[k].start = times[0]
            cues[k].end = times[1]
            if was_clamped
                clamped += 1
        if command == "SNAP"
            return ["SNAP changed={changed}"]
        if command == "SCALE"
            return ["SCALE cues={n}"]
        return ["{command} cues={n - begin} clamped={clamped}"]
    if command == "FIXOVERLAP"
        int fixed = 0
        int failed = 0
        for 0 <= int k < n - 1
            int candidate = cues[k + 1].start - values[0]
            if cues[k].end > candidate
                if candidate > cues[k].start
                    cues[k].end = candidate
                    fixed += 1
                else
                    failed += 1
                    output = output.append("cue {k + 1}: cannot fix")
        return output.append("FIXOVERLAP fixed={fixed} failed={failed}")
    if command == "EXTEND"
        int extended = 0
        int short_count = 0
        for 0 <= int k < n
            if cues[k].end - cues[k].start < values[0]
                int candidate = cues[k].start + values[0]
                if k + 1 < n
                    candidate = math.min(candidate, cues[k + 1].start)
                if candidate > cues[k].end
                    cues[k].end = candidate
                    extended += 1
            if cues[k].end - cues[k].start < values[0]
                short_count += 1
        return ["EXTEND extended={extended} short={short_count}"]
    if command == "TIME" or command == "TEXT"
        int p = values[0] - 1
        if command == "TIME"
            cues[p].start = values[1]
            cues[p].end = values[2]
            return ["TIME cue={values[0]}"]
        cues[p].lines = args[1].split("|")
        return ["TEXT cue={values[0]} lines={len(cues[p].lines)}"]
    if command == "SORT"
        int[] order = []
        for 0 <= int k < n
            order = order.append(k)
            int p = k
            while p > 0
                Cue earlier = cues[order[p - 1]]
                if earlier.start < cues[k].start or (earlier.start == cues[k].start and earlier.end <= cues[k].end)
                    break
                order[p] = order[p - 1]
                p -= 1
            order[p] = k
        int moved = 0
        for 0 <= int k < n
            if order[k] != k
                moved += 1
        cues = cues[order]
        return ["SORT moved={moved}"]
    if command == "RENUMBER"
        int changed = 0
        for 0 <= int k < n
            if cues[k].index != k + 1
                changed += 1
                cues[k].index = k + 1
        return ["RENUMBER changed={changed}"]
    if command == "INSERT"
        int p = values[0] - 1
        cues = cues[:<p].append(Cue(p + 1, values[1], values[2], args[3].split("|"))).concat(cues[p:])
        return ["INSERT cue={p + 1} cues={len(cues)}"]
    if command == "DELETE"
        int p = values[0] - 1
        int q = if len(values) == 1 then p + 1 else values[1]
        cues = cues[:<p].concat(cues[q:])
        return ["DELETE removed={q - p} cues={len(cues)}"]
    if command == "MERGE"
        Cue[] merged = []
        int joins = 0
        for Cue cue = cues[]
            if len(merged) > 0
                Cue &previous = &merged[len(merged) - 1]
                if cue.start - previous.end < values[0] and not dialogue(previous) and not dialogue(cue)
                    string[] lines = wrap(previous.lines.concat(cue.lines), 42)
                    if len(lines) <= 2
                        previous.end = math.max(previous.end, cue.end)
                        previous.lines = lines
                        joins += 1
                        continue
            merged = merged.append(cue)
        cues = merged
        return ["MERGE merged={joins} cues={len(cues)}"]
    if command == "SPLIT"
        Cue[] result = []
        int split_count = 0
        for Cue cue = cues[]
            int duration = cue.end - cue.start
            if duration <= 0 or dialogue(cue)
                result = result.append(cue)
                continue
            string[] lines = wrap(cue.lines, nat(values[0]))
            if len(lines) <= 2
                result = result.append(Cue(cue.index, cue.start, cue.end, lines))
                continue
            split_count += 1
            string[][] parts = [for 0 <= int k < int(len(lines)) step 2 then lines[k:<math.min(k + 2, int(len(lines)))]]
            int[] counts = [for string[] part = parts[] then characters(Cue(0, 0, 0, part))]
            int total = counts.sum()
            int[] durations = counts * duration / total
            int[] remainders = counts * duration % total
            nat[] order = parts.indices()
            for nat k < len(parts)
                nat p = k
                while p > 0 and remainders[k] > remainders[order[p - 1]]
                    order[p] = order[p - 1]
                    p -= 1
                order[p] = k
            int remaining = duration - durations.sum()
            for 0 <= int k < remaining
                durations[order[k]] += 1
            int cursor = cue.start
            for nat k < len(parts)
                result = result.append(Cue(cue.index, cursor, cursor + durations[k], parts[k]))
                cursor += durations[k]
        cues = result
        return ["SPLIT split={split_count} cues={len(cues)}"]
    if command == "BALANCE"
        int changed = 0
        int skipped = 0
        int dialogue_count = 0
        for 0 <= int k < n
            if dialogue(cues[k])
                dialogue_count += 1
                continue
            string[] words = words_of(cues[k].lines)
            string joined = words.join(" ")
            string[] best = []
            int best_difference = 0
            if len(joined) <= 42
                best = [joined]
            else
                for 1 <= int j < int(len(words))
                    string left = words[:<j].join(" ")
                    string right = words[j:].join(" ")
                    int difference = math.abs(int(len(left)) - int(len(right)))
                    if len(left) <= 42 and len(right) <= 42
                        if len(best) == 0 or difference < best_difference or (difference == best_difference and len(left) < len(best[0]))
                            best = [left, right]
                            best_difference = difference
            if len(best) == 0
                skipped += 1
            elif best != cues[k].lines
                cues[k].lines = best
                changed += 1
        return ["BALANCE changed={changed} skipped={skipped} dialogue={dialogue_count}"]
    if command == "REPLACE"
        string[] pair = args[0].split("|")
        int replacements = 0
        int changed_cues = 0
        for 0 <= int k < n
            bool changed = false
            for 0 <= int j < int(len(cues[k].lines))
                string line = cues[k].lines[j]
                string result = ""
                int p = 0
                while p < int(len(line))
                    if line[p:].starts_with(pair[0])
                        result += pair[1]
                        p += int(len(pair[0]))
                        replacements += 1
                        changed = true
                    else
                        result += line[p]
                        p += 1
                cues[k].lines[j] = result
            if changed
                changed_cues += 1
        return ["REPLACE count={replacements} cues={changed_cues}"]
    // STRIP and CLEANHI both discard empty lines, then empty cues.
    Cue[] remaining = []
    int tags = 0
    int segments = 0
    int labels = 0
    int removed_lines = 0
    for Cue cue = cues[]
        string[] lines = []
        for string line = cue.lines[]
            string result = ""
            if command == "STRIP"
                Converted converted = convert_markup(line, "STRIP")
                result = converted.text
                tags += converted.tags
            else
                Cleaned cleaned = clean_hi(line)
                result = cleaned.text
                segments += cleaned.segments
                labels += cleaned.labels
                if result == "-"
                    result = ""
            if result == ""
                removed_lines += 1
            else
                lines = lines.append(result)
        if len(lines) > 0
            remaining = remaining.append(Cue(cue.index, cue.start, cue.end, lines))
    int removed_cues = n - int(len(remaining))
    cues = remaining
    string prefix = if command == "STRIP" then "STRIP tags={tags}" else "CLEANHI segments={segments} labels={labels}"
    return ["{prefix} removed_lines={removed_lines} removed_cues={removed_cues}"]

void load_block(string[] block, int number, Cue[] &cues, int &bad)
    string problem = ""
    if not digits(block[0], 6)
        problem = "index"
    elif len(block) < 2
        problem = "time"
    else
        string value = block[1]
        if len(value) != 29
            problem = "time"
        elif value[12:<17] != " --> " or time_value(value[:<12]) < 0 or time_value(value[17:]) < 0
            problem = "time"
        elif len(block) < 3
            problem = "no text"
    if problem != ""
        bad += 1
        print("BAD CUE {number}: {problem}{NL}")
    else
        cues = cues.append(Cue(int.parse(block[0]), time_value(block[1][:<12]), time_value(block[1][17:]), block[2:]))

Cue[] cue_list = []
string[] pending_block = []
int block_number = 0
int bad_count = 0
while true
    string input_line
    scan(&input_line)
    if input_line == "" or input_line == "###"
        if len(pending_block) > 0
            block_number += 1
            load_block(pending_block, block_number, &cue_list, &bad_count)
            pending_block = []
        if input_line == "###"
            break
    else
        pending_block = pending_block.append(input_line)
print("LOAD cues={len(cue_list)} bad={bad_count}{NL}")
Cue[][] undo_lists = []
string[] undo_names = []
int command_count
scan(&command_count)
for 0 <= int command_number < command_count
    string command_line
    scan(&command_line)
    for string output_line = execute(command_line, &cue_list, &undo_lists, &undo_names)[]
        print("{output_line}{NL}")
