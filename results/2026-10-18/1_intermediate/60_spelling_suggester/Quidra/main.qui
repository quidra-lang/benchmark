string translate(string text, string source, string target)
    string result = ""
    for nat i < len(text)
        match source.find(text[i])
            nat index
                result += target[index]
            none
                result += text[i]
    return result

string lower(string text)
    return translate(text, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")

string upper(string text)
    return translate(text, "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ")

// Case tests for a text that consists of letters only.
bool is_upper(string text)
    return text == upper(text)

bool is_lower(string text)
    return text == lower(text)

bool is_letter(string character)
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".contains(character)

bool is_digit(string character)
    return "0123456789".contains(character)

bool all_of(string text, func<bool>(string) predicate)
    for nat i < len(text)
        if not predicate(text[i])
            return false
    return true

nat smaller(nat first, nat second)
    return if first < second then first else second

bool text_less(string first, string second)
    int[] a = first.codepoints()
    int[] b = second.codepoints()
    for nat i < smaller(len(a), len(b))
        if a[i] != b[i]
            return a[i] < b[i]
    return len(a) < len(b)

bool contains<T>(T[] items, T item)
    for auto value = items[]
        if value == item
            return true
    return false

T[] head<T>(T[] items, nat count)
    return items[:<smaller(count, len(items))]

// A stable merge sort: before(a, b) tells whether a belongs before b.
T[] sorted_by<T>(T[] items, func<bool>(T, T) before)
    if len(items) <= 1
        return items
    nat middle = len(items) / 2
    T[] left = sorted_by(items[:<middle], before)
    T[] right = sorted_by(items[middle:], before)
    T[] merged = []
    nat i = 0
    nat j = 0
    while i < len(left) and j < len(right)
        if before(right[j], left[i])
            merged = merged.append(right[j])
            j += 1
        else
            merged = merged.append(left[i])
            i += 1
    return merged.concat(left[i:]).concat(right[j:])

void increment<K>(map.Map<K, nat> &counts, K key)
    match counts.get(key)
        nat count
            .counts.set(key, count + 1)
        none
            .counts.set(key, 1)

void emit(string[] parts)
    print("{parts.join(" ")}{NL}")

string | error word_argument(string text)
    if not (1 <= len(text) <= 30 and all_of(text, is_letter))
        return error("BAD WORD {text}")
    return lower(text)

nat | error number_argument(string text, nat minimum, nat maximum)
    if not (1 <= len(text) <= 7 and all_of(text, is_digit))
        return error("BAD NUMBER {text}")
    nat value = try nat.parse(text)
    if not (minimum <= value <= maximum)
        return error("BAD NUMBER {text}")
    return value

string decimal_text(nat numerator, nat denominator, nat digits)
    nat scale = 10 ^ digits
    nat value = (2 * numerator * scale + denominator) / (2 * denominator)
    string fraction = "{value % scale}"
    return "{value / scale}.{string.repeat("0", digits - len(fraction))}{fraction}"

string capitalize_first(string word)
    return upper(word[0]) + word[1:]

string apply_case(string token_text, string word)
    if len(token_text) >= 2 and is_upper(token_text)
        return upper(word)
    if is_upper(token_text[0])
        return capitalize_first(word)
    return word

class Token(
    nat number,
    string text,
    string word,
    nat end,
    string gap,
    bool sentence_start,
    bool repeat,
)
    bool mixed_case()
        return not is_lower(text[1:]) and not is_upper(text)

    // The replacement in the case of this token, capitalized at a sentence start.
    string recased(string replacement)
        string result = apply_case(text, replacement)
        if sentence_start and is_lower(result[0])
            return capitalize_first(result)
        return result

Token[] tokenize(string text)
    Token[] tokens = []
    nat position = 0
    nat start = 0
    while start < len(text)
        if not is_letter(text[start])
            start += 1
            continue
        nat end = start
        while end < len(text) and is_letter(text[end])
            end += 1
        string gap = text[position:<start]
        string token_text = text[start:<end]
        string word = lower(token_text)
        bool first = len(tokens) == 0
        bool sentence_start = first or gap.contains(".") or gap.contains("!") or gap.contains("?")
        bool repeat = (
            not first
            and word == tokens[len(tokens) - 1].word
            and gap == string.repeat(" ", len(gap))
        )
        auto token = Token(len(tokens) + 1, token_text, word, end, gap, sentence_start, repeat)
        tokens = tokens.append(token)
        position = end
        start = end
    return tokens

bool is_swap(int[] first, int[] second, nat i, nat j)
    return i >= 2 and j >= 2 and first[i - 1] == second[j - 2] and first[i - 2] == second[j - 1]

class EditMetric(bool keyboard)
    nat gap = if keyboard then 2 else 1
    bool[][] adjacent = array(26, fill = array(26, fill = false))
    // Keys next to a, b, ..., z on a QWERTY keyboard; letters are indexed from 97, the code of a.
    local string[] neighbors = [
        "qswz", "ghnv", "dfvx", "cefrsx", "drsw", "cdgrtv", "bfhtvy", "bgjnuy", "jkou",
        "hikmnu", "ijlmo", "kop", "jkn", "bhjm", "iklp", "lo", "aw", "deft",
        "adewxz", "fgry", "hijy", "bcfg", "aeqs", "cdsz", "ghtu", "asx",
    ]
    for string keys = neighbors[nat letter]
        for int key = keys.codepoints()[]
            adjacent[letter][key - 97] = true

    nat substitution(int first, int second)
        if first == second
            return 0
        if not keyboard
            return 1
        return if adjacent[first - 97][second - 97] then 1 else 2

    nat[][] distance_table(string first, string second)
        int[] a = first.codepoints()
        int[] b = second.codepoints()
        nat[][] table = array(len(a) + 1, fill = array(len(b) + 1, fill = 0))
        for nat i <= len(a)
            table[i][0] = i * gap
        for nat j <= len(b)
            table[0][j] = j * gap
        for 1 <= nat i <= len(a)
            for 1 <= nat j <= len(b)
                nat best = smaller(table[i - 1][j], table[i][j - 1]) + gap
                best = smaller(best, table[i - 1][j - 1] + substitution(a[i - 1], b[j - 1]))
                if is_swap(a, b, i, j)
                    best = smaller(best, table[i - 2][j - 2] + 1)
                table[i][j] = best
        return table

    nat distance(string first, string second)
        return distance_table(first, second)[len(first)][len(second)]

    nat prefix_distance(string word, string other)
        nat[] row = distance_table(word, other)[len(word)]
        nat best = row[0]
        for auto value = row[]
            best = smaller(best, value)
        return best

    (nat, string[]) operations(string first, string second)
        nat[][] table = distance_table(first, second)
        int[] a = first.codepoints()
        int[] b = second.codepoints()
        string[] found = []
        nat i = len(a)
        nat j = len(b)
        while i > 0 or j > 0
            bool diagonal = i >= 1 and j >= 1
            if diagonal and table[i][j] == table[i - 1][j - 1] + substitution(a[i - 1], b[j - 1])
                if a[i - 1] != b[j - 1]
                    found = found.append("sub:{first[i - 1]}>{second[j - 1]}")
                i -= 1
                j -= 1
            elif is_swap(a, b, i, j) and table[i][j] == table[i - 2][j - 2] + 1
                found = found.append("swap:{first[i - 2]}{first[i - 1]}")
                i -= 2
                j -= 2
            elif i >= 1 and table[i][j] == table[i - 1][j] + gap
                found = found.append("del:{first[i - 1]}")
                i -= 1
            else
                found = found.append("ins:{second[j - 1]}")
                j -= 1
        return (table[len(a)][len(b)], found[:: -1])

string soundex(string word)
    // Digits of a to z; h and w have no digit and count as 0 at the start.
    string digits = "01230120022455012623010202"
    int[] codes = word.codepoints()
    string code = upper(word[0])
    string previous = digits[codes[0] - 97]
    for 1 <= nat i < len(word)
        if word[i] == "h" or word[i] == "w"
            continue
        string digit = digits[codes[i] - 97]
        if digit != "0" and digit != previous
            code += digit
        previous = digit
    return (code + "000")[:<4]

bool segmentation_less(string[] first, string[] second)
    if len(first) != len(second)
        return len(first) < len(second)
    for string a = first[], string b = second[]
        if a != b
            return text_less(a, b)
    return false

class Candidate(string word, nat distance, nat frequency)

class WordCount(string word, nat count)

class Correction(string word, string replacement, nat count)

bool candidate_before(Candidate first, Candidate second)
    if first.distance != second.distance
        return first.distance < second.distance
    if first.frequency != second.frequency
        return first.frequency > second.frequency
    return text_less(first.word, second.word)

bool count_before(WordCount first, WordCount second)
    if first.count != second.count
        return first.count > second.count
    return text_less(first.word, second.word)

bool word_before(WordCount first, WordCount second)
    return text_less(first.word, second.word)

bool correction_before(Correction first, Correction second)
    if first.count != second.count
        return first.count > second.count
    if first.word != second.word
        return text_less(first.word, second.word)
    return text_less(first.replacement, second.replacement)

WordCount[] word_counts(string[] words, nat[] counts)
    WordCount[] result = []
    for string word = words[], nat count = counts[]
        result = result.append(WordCount(word, count))
    return result

class UndoRecord(
    string name,
    string[] words,
    nat[] frequencies,
    string[] ignored,
    string[] rule_sources,
    string[] rule_targets,
)

class Counters()
    nat checked = 0
    nat unknown = 0
    nat case = 0
    nat capital = 0
    nat repeats = 0
    nat corrected = 0

bool takes_text(string name)
    return contains(["CHECK", "CORRECT", "FIX", "PROFILE", "LEARN"], name)

nat | none argument_count(string name)
    if contains(["RULES", "UNDO", "REPORT", "HISTORY", "STATS"], name)
        return 0
    if contains(["DIST", "PREFIX", "COMPLETE", "LIST", "ADD", "RULE", "SET"], name)
        return 2
    string[] single = [
        "SUGGEST", "SOUNDEX", "SOUNDS", "SPLIT", "WORD", "REMOVE", "IGNORE", "UNIGNORE", "UNRULE",
        "KEYBOARD",
    ]
    if contains(single, name)
        return 1
    return none

class SpellChecker(map.Map<string, nat> dictionary)
    const nat max_word_length = 30
    const nat max_frequency = 1000000
    const nat max_listed = 20
    const nat report_size = 10
    set.Set<string> ignored = set.Set<string>()
    map.Map<string, string> rules = map.Map<string, string>()
    EditMetric metric = EditMetric(false)
    nat base_limit = 2
    nat suggestion_count = 5
    UndoRecord[] undo_history = []
    map.Map<string, nat> unknown_log = map.Map<string, nat>()
    map.Map<(string, string), nat> correction_log = map.Map<(string, string), nat>()
    Counters counters = Counters()

    nat limit()
        return if metric.keyboard then 2 * base_limit else base_limit

    bool is_known(string word)
        return dictionary.has(word) or ignored.has(word)

    WordCount[] frequency_order()
        WordCount[] entries = word_counts(dictionary.keys(), dictionary.values())
        return sorted_by(entries, count_before)

    nat | error require_entry(string word)
        match dictionary.get(word)
            nat frequency
                return frequency
            none
                return error("NOT FOUND {word}")

    Candidate[] candidates(string word)
        nat max_distance = limit()
        Candidate[] found = []
        for string other = dictionary.keys()[], nat frequency = dictionary.values()[]
            nat difference = (
                if len(other) > len(word) then len(other) - len(word) else len(word) - len(other)
            )
            if other == word or difference * metric.gap > max_distance
                continue
            nat distance = metric.distance(word, other)
            if distance <= max_distance
                found = found.append(Candidate(other, distance, frequency))
        return sorted_by(found, candidate_before)

    string | none .correction(string word)
        if is_known(word)
            return none
        if rules.has(word)
            return rules.get(word)
        Candidate[] found = candidates(word)
        if len(found) == 0
            return none
        return found[0].word

    void .record_undo(string name)
        auto record = UndoRecord(
            name,
            dictionary.keys(),
            dictionary.values(),
            ignored.values(),
            rules.keys(),
            rules.values(),
        )
        undo_history = undo_history.append(record)

    void .log_correction(string word, string replacement)
        increment(&correction_log, (word, replacement))
        counters.corrected += 1

    string .unknown_finding(Token token)
        string label = "UNKNOWN {token.number} {token.text}"
        match rules.get(token.word)
            string target
                return "{label} RULE {target}"
            none
                Candidate[] found = candidates(token.word)
                if len(found) == 0
                    return "{label} NONE"
                string[] words = [
                    for auto candidate = head(found, suggestion_count)[] then candidate.word
                ]
                return [label, "SUGGEST"].concat(words).join(" ")

    void .check(string text)
        Token[] tokens = tokenize(text)
        string[] findings = []
        nat unknown = 0
        nat mixed = 0
        nat capital = 0
        nat repeats = 0
        for auto token = tokens[]
            if not is_known(token.word)
                findings = findings.append(.unknown_finding(token))
                increment(&unknown_log, token.word)
                unknown += 1
            if token.mixed_case()
                findings = findings.append("CASE {token.number} {token.text}")
                mixed += 1
            if token.sentence_start and is_lower(token.text[0])
                findings = findings.append("CAPITAL {token.number} {token.text}")
                capital += 1
            if token.repeat
                findings = findings.append("REPEAT {token.number} {token.text}")
                repeats += 1
        counters.checked += len(tokens)
        counters.unknown += unknown
        counters.case += mixed
        counters.capital += capital
        counters.repeats += repeats
        emit([
            "CHECK",
            "words={len(tokens)}",
            "unknown={unknown}",
            "case={mixed}",
            "capital={capital}",
            "repeats={repeats}",
        ])
        for auto line = findings[]
            emit([line])

    void .correct(string text)
        string result = ""
        nat position = 0
        nat changed = 0
        for auto token = tokenize(text)[]
            match .correction(token.word)
                string replacement
                    result += token.gap + apply_case(token.text, replacement)
                    .log_correction(token.word, replacement)
                    changed += 1
                none
                    result += token.gap + token.text
            position = token.end
        emit(["CORRECT changed={changed}:", result + text[position:]])

    void .fix(string text)
        string result = ""
        nat position = 0
        nat removed = 0
        nat replaced = 0
        nat recased = 0
        for auto token = tokenize(text)[]
            position = token.end
            if token.repeat
                removed += 1
                continue
            match .correction(token.word)
                string replacement
                    result += token.gap + token.recased(replacement)
                    .log_correction(token.word, replacement)
                    replaced += 1
                none
                    string fixed = token.recased(token.word)
                    if fixed != token.text
                        recased += 1
                    result += token.gap + fixed
        emit([
            "FIX",
            "removed={removed}",
            "replaced={replaced}",
            "recased={recased}:",
            result + text[position:],
        ])

    void .profile(string text)
        Token[] tokens = tokenize(text)
        set.Set<string> distinct = set.Set<string>()
        for auto token = tokens[]
            .distinct.add(token.word)
        nat unknown = len([for auto token = tokens[] if not is_known(token.word) then token])
        nat sentences = len([for auto token = tokens[] if token.sentence_start then token])
        string rate = "0.0"
        string average = "0.00"
        string longest = "-"
        if len(tokens) > 0
            nat characters = 0
            Token longest_token = tokens[0]
            for auto token = tokens[]
                characters += len(token.text)
                if len(token.text) > len(longest_token.text)
                    longest_token = token
            rate = decimal_text(100 * unknown, len(tokens), 1)
            average = decimal_text(characters, len(tokens), 2)
            longest = longest_token.word
        emit([
            "PROFILE",
            "words={len(tokens)}",
            "distinct={distinct.size()}",
            "unknown={unknown}",
            "rate={rate}",
            "avglen={average}",
            "longest={longest}",
            "sentences={sentences}",
        ])

    void .learn(string text)
        .record_undo("LEARN")
        nat updated = 0
        nat added = 0
        nat skipped = 0
        for auto token = tokenize(text)[]
            if len(token.word) > max_word_length
                skipped += 1
                continue
            match dictionary.get(token.word)
                nat frequency
                    .dictionary.set(token.word, frequency + 1)
                    updated += 1
                none
                    .dictionary.set(token.word, 1)
                    .ignored.remove(token.word)
                    added += 1
        emit(["LEARN", "updated={updated}", "added={added}", "skipped={skipped}"])

    void | error .suggest(string[] arguments)
        string word = try word_argument(arguments[0])
        if is_known(word)
            emit(["SUGGEST", word, "KNOWN"])
            return
        match rules.get(word)
            string target
                emit(["SUGGEST", word, "RULE", target])
            none
                Candidate[] found = candidates(word)
                string[] listed = [
                    for auto candidate = head(found, suggestion_count)[]
                    then "{candidate.word}:{candidate.distance}"
                ]
                emit(["SUGGEST", word, "found={len(found)}"].concat(listed))
        return

    void | error dist(string[] arguments)
        string first = try word_argument(arguments[0])
        string second = try word_argument(arguments[1])
        (nat distance, string[] operations) = metric.operations(first, second)
        emit(["DIST", first, second, "{distance}"].concat(operations))
        return

    void | error soundex_code(string[] arguments)
        string word = try word_argument(arguments[0])
        emit(["SOUNDEX", word, soundex(word)])
        return

    void | error .sounds(string[] arguments)
        string word = try word_argument(arguments[0])
        string code = soundex(word)
        string[] matches = [
            for auto entry = frequency_order()[]
            if entry.word != word and soundex(entry.word) == code
            then entry.word
        ]
        emit(["SOUNDS", word, code, "count={len(matches)}"].concat(head(matches, report_size)))
        return

    (nat, string[]) segment(string word)
        nat length = len(word)
        nat[] ways = array(length + 1, fill = 0)
        string[][] best = array(length + 1, fill = [])
        ways[length] = 1
        for length > nat start
            for start < nat end <= length
                string piece = word[start:<end]
                if not dictionary.has(piece) or ways[end] == 0
                    continue
                string[] candidate = [piece].concat(best[end])
                if ways[start] == 0 or segmentation_less(candidate, best[start])
                    best[start] = candidate
                ways[start] += ways[end]
        return (ways[0], best[0])

    void | error .split(string[] arguments)
        string word = try word_argument(arguments[0])
        (nat ways, string[] best) = segment(word)
        if ways == 0
            emit(["SPLIT", word, "ways=0", "->", "NONE"])
        else
            emit(["SPLIT", word, "ways={ways}", "->"].concat(best))
        return

    void | error .prefix(string[] arguments)
        string word = try word_argument(arguments[0])
        nat count = try number_argument(arguments[1], 1, max_listed)
        WordCount[] matches = [
            for auto entry = frequency_order()[] if entry.word.starts_with(word) then entry
        ]
        string[] listed = [
            for auto entry = head(matches, count)[] then "{entry.word}:{entry.count}"
        ]
        emit(["PREFIX", word, "count={len(matches)}"].concat(listed))
        return

    void | error complete(string[] arguments)
        string word = try word_argument(arguments[0])
        nat count = try number_argument(arguments[1], 1, max_listed)
        nat threshold = limit() / 2
        Candidate[] matches = []
        for string other = dictionary.keys()[], nat frequency = dictionary.values()[]
            nat distance = metric.prefix_distance(word, other)
            if distance <= threshold
                matches = matches.append(Candidate(other, distance, frequency))
        matches = sorted_by(matches, candidate_before)
        string[] listed = [
            for auto match_entry = head(matches, count)[]
            then "{match_entry.word}:{match_entry.distance}"
        ]
        emit(["COMPLETE", word, "count={len(matches)}"].concat(listed))
        return

    void | error list_words(string[] arguments)
        string word = try word_argument(arguments[0])
        nat count = try number_argument(arguments[1], 1, max_listed)
        WordCount[] entries = word_counts(dictionary.keys(), dictionary.values())
        WordCount[] matches = [
            for auto entry = entries[] if not text_less(entry.word, word) then entry
        ]
        matches = sorted_by(matches, word_before)
        string[] listed = [
            for auto entry = head(matches, count)[] then "{entry.word}:{entry.count}"
        ]
        emit(["LIST", word, "count={len(matches)}"].concat(listed))
        return

    void | error .word_info(string[] arguments)
        string word = try word_argument(arguments[0])
        nat frequency = try require_entry(word)
        nat rank = 0
        for auto entry = frequency_order()[nat i]
            if entry.word == word
                rank = i + 1
        emit([
            "WORD",
            word,
            "freq={frequency}",
            "rank={rank}",
            "soundex={soundex(word)}",
            "neighbors={len(candidates(word))}",
        ])
        return

    void | error .add(string[] arguments)
        string word = try word_argument(arguments[0])
        nat frequency = try number_argument(arguments[1], 1, max_frequency)
        if dictionary.has(word)
            return error("DUPLICATE {word}")
        .record_undo("ADD")
        .dictionary.set(word, frequency)
        .ignored.remove(word)
        emit(["ADD", word, "{frequency}"])
        return

    void | error .remove(string[] arguments)
        string word = try word_argument(arguments[0])
        nat frequency = try require_entry(word)
        .record_undo("REMOVE")
        .dictionary.remove(word)
        emit(["REMOVE", word, "{frequency}"])
        return

    void | error .ignore(string[] arguments)
        string word = try word_argument(arguments[0])
        if dictionary.has(word)
            return error("IN DICTIONARY {word}")
        if ignored.has(word)
            return error("ALREADY IGNORED {word}")
        .record_undo("IGNORE")
        .ignored.add(word)
        emit(["IGNORE", word])
        return

    void | error .unignore(string[] arguments)
        string word = try word_argument(arguments[0])
        if not ignored.has(word)
            return error("NOT IGNORED {word}")
        .record_undo("UNIGNORE")
        .ignored.remove(word)
        emit(["UNIGNORE", word])
        return

    void | error .rule(string[] arguments)
        string source = try word_argument(arguments[0])
        string target = try word_argument(arguments[1])
        if dictionary.has(source)
            return error("IN DICTIONARY {source}")
        if not dictionary.has(target)
            return error("NOT FOUND {target}")
        .record_undo("RULE")
        string | none previous = rules.get(source)
        .rules.set(source, target)
        match previous
            string replaced
                emit(["RULE", source, target, "REPLACED", replaced])
            none
                emit(["RULE", source, target])
        return

    void | error .unrule(string[] arguments)
        string word = try word_argument(arguments[0])
        match rules.get(word)
            string target
                .record_undo("UNRULE")
                .rules.remove(word)
                emit(["UNRULE", word, target])
                return
            none
                return error("NO RULE {word}")

    void show_rules()
        string[] listed = []
        for string source = rules.keys()[], string target = rules.values()[]
            listed = listed.append("{source}>{target}")
        // ">" sorts before every letter, so this orders the rules by source word.
        emit(["RULES", "count={rules.size()}"].concat(listed.sorted()))

    void | error .keyboard_mode(string[] arguments)
        string mode = arguments[0]
        if not contains(["ON", "OFF"], mode)
            return error("BAD MODE {mode}")
        metric = EditMetric(mode == "ON")
        emit(["KEYBOARD", mode])
        return

    void | error .set_option(string[] arguments)
        string option = arguments[0]
        if not contains(["LIMIT", "SUGGESTIONS"], option)
            return error("BAD OPTION {option}")
        nat maximum = if option == "LIMIT" then 3 else 10
        nat value = try number_argument(arguments[1], 1, maximum)
        if option == "LIMIT"
            base_limit = value
        else
            suggestion_count = value
        emit(["SET", option, "{value}"])
        return

    void | error .undo()
        if len(undo_history) == 0
            return error("NOTHING TO UNDO")
        UndoRecord record = undo_history[len(undo_history) - 1]
        undo_history = undo_history[:<len(undo_history) - 1]
        dictionary = map.Map<string, nat>()
        for string word = record.words[], nat frequency = record.frequencies[]
            .dictionary.set(word, frequency)
        ignored = set.Set<string>()
        for string word = record.ignored[]
            .ignored.add(word)
        rules = map.Map<string, string>()
        for string source = record.rule_sources[], string target = record.rule_targets[]
            .rules.set(source, target)
        emit(["UNDO", record.name])
        return

    void report()
        WordCount[] entries = word_counts(unknown_log.keys(), unknown_log.values())
        entries = sorted_by(entries, count_before)
        string[] listed = [
            for auto entry = head(entries, report_size)[] then "{entry.word}:{entry.count}"
        ]
        emit(["REPORT", "distinct={len(entries)}"].concat(listed))

    void history()
        Correction[] entries = []
        for auto pair = correction_log.keys()[], nat count = correction_log.values()[]
            (string word, string replacement) = pair
            entries = entries.append(Correction(word, replacement, count))
        entries = sorted_by(entries, correction_before)
        string[] listed = [
            for auto entry = head(entries, report_size)[]
            then "{entry.word}>{entry.replacement}:{entry.count}"
        ]
        emit(["HISTORY", "distinct={len(entries)}"].concat(listed))

    void .stats()
        WordCount top = frequency_order()[0]
        nat total = 0
        nat characters = 0
        for string word = dictionary.keys()[], nat frequency = dictionary.values()[]
            total += frequency
            characters += len(word)
        emit([
            "STATS",
            "words={dictionary.size()}",
            "total={total}",
            "avglen={decimal_text(characters, dictionary.size(), 2)}",
            "top={top.word}:{top.count}",
            "ignored={ignored.size()}",
            "rules={rules.size()}",
            "keyboard={if metric.keyboard then "ON" else "OFF"}",
            "limit={limit()}",
            "suggestions={suggestion_count}",
            "undo={len(undo_history)}",
        ])
        emit([
            "SESSION",
            "checked={counters.checked}",
            "unknown={counters.unknown}",
            "case={counters.case}",
            "capital={counters.capital}",
            "repeats={counters.repeats}",
            "corrected={counters.corrected}",
        ])

    void .run_text(string name, string text)
        if name == "CHECK"
            .check(text)
        elif name == "CORRECT"
            .correct(text)
        elif name == "FIX"
            .fix(text)
        elif name == "PROFILE"
            .profile(text)
        else
            .learn(text)

    void | error .run_command(string name, string[] arguments)
        if name == "SUGGEST"
            try .suggest(arguments)
        elif name == "DIST"
            try dist(arguments)
        elif name == "SOUNDEX"
            try soundex_code(arguments)
        elif name == "SOUNDS"
            try .sounds(arguments)
        elif name == "SPLIT"
            try .split(arguments)
        elif name == "PREFIX"
            try .prefix(arguments)
        elif name == "COMPLETE"
            try complete(arguments)
        elif name == "LIST"
            try list_words(arguments)
        elif name == "WORD"
            try .word_info(arguments)
        elif name == "ADD"
            try .add(arguments)
        elif name == "REMOVE"
            try .remove(arguments)
        elif name == "IGNORE"
            try .ignore(arguments)
        elif name == "UNIGNORE"
            try .unignore(arguments)
        elif name == "RULE"
            try .rule(arguments)
        elif name == "UNRULE"
            try .unrule(arguments)
        elif name == "RULES"
            show_rules()
        elif name == "KEYBOARD"
            try .keyboard_mode(arguments)
        elif name == "SET"
            try .set_option(arguments)
        elif name == "UNDO"
            try .undo()
        elif name == "REPORT"
            report()
        elif name == "HISTORY"
            history()
        else
            .stats()
        return

    void | error .run(string line)
        string name = line.split(" ")[0]
        bool separated = len(name) < len(line)
        string rest = if separated then line[len(name) + 1:] else ""
        if takes_text(name)
            if not separated
                return error("BAD ARGUMENTS {name}")
            .run_text(name, rest)
            return
        match argument_count(name)
            nat expected
                string[] arguments = if separated then rest.split(" ") else []
                if len(arguments) != expected
                    return error("BAD ARGUMENTS {name}")
                try .run_command(name, arguments)
                return
            none
                return error("UNKNOWN COMMAND {name}")

    void .execute(string line)
        match .run(line)
            void
                void
            error problem
                emit(["ERROR", problem.message])

map.Map<string, nat> dictionary = map.Map<string, nat>()
nat word_count
scan(&word_count)
for _ < word_count
    string word
    nat frequency
    scan("{&word} {&frequency}")
    .dictionary.set(word, frequency)
SpellChecker checker = SpellChecker(dictionary)
nat command_count
scan(&command_count)
for _ < command_count
    string line
    scan(&line)
    .checker.execute(line)
