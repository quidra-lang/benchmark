import math

enum Mode
    Chain
    Linear
    Quadratic
    Double
    RobinHood
    Cuckoo

class Item(string key, int value)
class Slot(Item | none item = none, bool tombstone = false)
class Counters()
    int probes = 0
    int rehashes = 0
    int inserts = 0
    int updates = 0
    int hits = 0
    int misses = 0
    int deletes = 0
    int absent = 0

class Table(Mode mode, int cap)
    int size = 0
    int tomb = 0
    Item[][] buckets = []
    Slot[] slots = []
    Counters counters = Counters()

class Search()
    int position = -1
    int chain_index = -1
    int probes = 0
    int available = -1
    Item | none item = none
    string[] path = []

class Placement(bool success)
    int position = -1
    bool reused = false
    int shifted = 0
    int kicks = 0
    Item | none homeless = none
    string[] moves = []

class Removal(int shifted, string[] moves)
class Mutation(bool changed, string[] rehashes, string[] rows)
class Cost(string key, int value, int position)
class Metrics(int longest, string average)
class Simulator()
    Table | none current = none
    int max_load = 75
    int min_load = 0
    bool tracing = false

Mode[] modes()
    return [Mode.Chain, Mode.Linear, Mode.Quadratic, Mode.Double, Mode.RobinHood, Mode.Cuckoo]

string mode_text(Mode mode)
    match mode
        Mode.Chain
            return "CHAIN"
        Mode.Linear
            return "LINEAR"
        Mode.Quadratic
            return "QUADRATIC"
        Mode.Double
            return "DOUBLE"
        Mode.RobinHood
            return "ROBINHOOD"
        Mode.Cuckoo
            return "CUCKOO"

int next_prime(int requested)
    int candidate = math.max(2, requested)
    while true
        bool prime = true
        int divisor = 2
        while divisor * divisor <= candidate
            if candidate % divisor == 0
                prime = false
                break
            divisor += 1
        if prime
            return candidate
        candidate += 1

int hash(string key, int base, int modulus)
    int result = 0
    for int code = key.codepoints()[]
        result = (result * base + code) % modulus
    return result

string decimal(int numerator, int denominator)
    if denominator == 0
        return "0.00"
    int scaled = 100 * numerator / denominator
    return "{scaled / 100}.{scaled % 100:int=2,zero}"

int slot_count(const Table table)
    return table.cap * (if table.mode == Mode.Cuckoo then 2 else 1)

Table new_table(Mode mode, int capacity)
    auto result = Table(mode, capacity)
    Item[] empty = []
    if mode == Mode.Chain
        result.buckets = array(nat(capacity), fill = empty)
    else
        result.slots = array(nat(slot_count(result)), fill = Slot())
    return result

string position_text(const Table table, int position)
    if table.mode == Mode.Cuckoo
        return "T{position / table.cap + 1}.{position % table.cap}"
    return position.string()

int distance(const Table table, string key, int position)
    return (position - hash(key, 31, table.cap) + table.cap) % table.cap

string content(const Slot slot)
    match slot.item
        Item item
            return item.key
        none
            return if slot.tombstone then "D" else "-"

bool empty_slot(const Slot slot)
    match slot.item
        Item
            return false
        none
            return not slot.tombstone

string pair_text(const Item item)
    return "{item.key}={item.value}"

Item[] table_items(const Table table)
    Item[] result = []
    if table.mode == Mode.Chain
        for Item[] bucket = table.buckets[]
            result = result.concat(bucket)
    else
        for Slot slot = table.slots[]
            match slot.item
                Item item
                    result = result.append(item)
                none
                    continue
    return result

Search search(const Table table, string key, bool tracing = false)
    auto result = Search()
    int home = hash(key, 31, table.cap)
    if table.mode == Mode.Chain
        Item[] bucket = table.buckets[home]
        for nat index = bucket.indices()[]
            Item item = bucket[index]
            result.probes += 1
            if tracing
                result.path = result.path.append("{home}:{item.key}")
            if item.key == key
                result.position = home
                result.chain_index = int(index)
                result.item = item
                return result
    elif table.mode == Mode.Cuckoo
        for int position = [home, table.cap + hash(key, 37, table.cap)][]
            Slot slot = table.slots[position]
            result.probes += 1
            if tracing
                result.path = result.path.append(position_text(table, position) + ":" + content(slot))
            match slot.item
                Item item
                    if item.key == key
                        result.position = position
                        result.item = item
                        return result
                none
                    continue
    else
        int step = 1 + hash(key, 37, table.cap - 1)
        for 0 <= int index < table.cap
            int offset = index
            if table.mode == Mode.Quadratic
                offset = index * index
            elif table.mode == Mode.Double
                offset = index * step
            int position = (home + offset) % table.cap
            Slot slot = table.slots[position]
            result.probes += 1
            if tracing
                result.path = result.path.append("{position}:" + content(slot))
            if empty_slot(slot)
                if result.available < 0
                    result.available = position
                return result
            if slot.tombstone and result.available < 0
                result.available = position
            match slot.item
                Item item
                    if item.key == key
                        result.position = position
                        result.item = item
                        return result
                    if table.mode == Mode.RobinHood and distance(table, item.key, position) < index
                        return result
                none
                    continue
    return result

Placement place(Table &table, Item item, Search | none initial = none, bool tracing = false)
    auto result = Placement(true)
    string original_key = item.key
    if table.mode == Mode.Chain
        result.position = hash(item.key, 31, table.cap)
        table.buckets[result.position] = table.buckets[result.position].append(item)
    elif table.mode == Mode.Linear or table.mode == Mode.Quadratic or table.mode == Mode.Double
        Search found
        match initial
            Search previous
                found = previous
            none
                found = search(table, item.key)
        result.position = found.available
        if found.available < 0
            result.success = false
            result.homeless = item
        else
            result.reused = table.slots[found.available].tombstone
            if result.reused
                table.tomb -= 1
            table.slots[found.available] = Slot(item)
    elif table.mode == Mode.RobinHood
        int position = hash(item.key, 31, table.cap)
        int travelled = 0
        int origin = -1
        while true
            match table.slots[position].item
                none
                    table.slots[position] = Slot(item)
                    if result.position < 0
                        result.position = position
                    if tracing and origin >= 0
                        result.moves = result.moves.append("SHIFT {item.key} {origin} -> {position}")
                    break
                Item other
                    int previous = distance(table, other.key, position)
                    if previous < travelled
                        table.slots[position] = Slot(item)
                        if result.position < 0
                            result.position = position
                        if tracing and origin >= 0
                            result.moves = result.moves.append("SHIFT {item.key} {origin} -> {position}")
                        item = other
                        origin = position
                        travelled = previous
                        result.shifted += 1
            position = (position + 1) % table.cap
            travelled += 1
    else
        int part = 0
        while true
            int position = part * table.cap + hash(item.key, 31 + 6 * part, table.cap)
            match table.slots[position].item
                none
                    table.slots[position] = Slot(item)
                    result.position = search(table, original_key).position
                    break
                Item other
                    if result.kicks == table.cap
                        result.success = false
                        result.homeless = item
                        break
                    table.slots[position] = Slot(item)
                    result.kicks += 1
                    if tracing
                        result.moves = result.moves.append("KICK {other.key} " + position_text(table, position))
                    item = other
                    part = 1 - part
    return result

Removal remove_item(Table &table, const Search found, bool tracing)
    int shifted = 0
    string[] moves = []
    int position = found.position
    if table.mode == Mode.Chain
        Item[] bucket = table.buckets[position]
        table.buckets[position] = bucket[:<found.chain_index].concat(bucket[found.chain_index + 1:])
    elif table.mode == Mode.Linear or table.mode == Mode.Quadratic or table.mode == Mode.Double
        table.slots[position] = Slot(none, true)
        table.tomb += 1
    else
        table.slots[position] = Slot()
        if table.mode == Mode.RobinHood
            int following = (position + 1) % table.cap
            while true
                match table.slots[following].item
                    none
                        break
                    Item item
                        if distance(table, item.key, following) == 0
                            break
                        int destination = (following + table.cap - 1) % table.cap
                        table.slots[destination] = Slot(item)
                        table.slots[following] = Slot()
                        shifted += 1
                        if tracing
                            moves = moves.append("SHIFT {item.key} {following} -> {destination}")
                        following = (following + 1) % table.cap
    table.size -= 1
    return Removal(shifted, moves)

bool rebuild(Table &table, Mode mode, int capacity, const Item[] items)
    Table trial = new_table(mode, capacity)
    for Item item = items[]
        if not place(&trial, item).success
            return false
    trial.size = int(len(items))
    trial.counters = table.counters
    table = trial
    return true

Item[] rebuild_list(const Table table, Item | none pending)
    Item[] items = table_items(table)
    match pending
        Item item
            return items.append(item)
        none
            return items

string automatic(Table &table, string reason, int capacity, Item | none pending = none)
    int old = table.cap
    Item[] items = rebuild_list(table, pending)
    while not rebuild(&table, table.mode, capacity, items)
        capacity = next_prime(2 * capacity)
    table.counters.rehashes += 1
    return "REHASH {reason} {old} -> {table.cap}"

string[] load_check(Table &table, int maximum)
    if (table.size + table.tomb) * 100 > maximum * slot_count(table)
        if table.size * 200 > maximum * slot_count(table)
            return [automatic(&table, "load", next_prime(2 * table.cap))]
        return [automatic(&table, "tomb", table.cap)]
    return []

string[] shrink_check(Table &table, int minimum, int maximum)
    int capacity = next_prime(table.cap / 2)
    int slots = capacity * (if table.mode == Mode.Cuckoo then 2 else 1)
    if table.size * 100 < minimum * slot_count(table) and capacity < table.cap and table.size * 100 <= maximum * slots
        int old = table.cap
        if rebuild(&table, table.mode, capacity, table_items(table))
            table.counters.rehashes += 1
            return ["REHASH shrink {old} -> {capacity}"]
    return []

string[] trace_path(const Search found, bool tracing)
    if not tracing
        return []
    return ["PATH " + (if len(found.path) == 0 then "none" else found.path.join(" "))]

Mutation put(Table &table, string key, int value, string command, int maximum, bool tracing = false)
    Search found = search(table, key, tracing)
    table.counters.probes += found.probes
    string[] trace = trace_path(found, tracing)
    match found.item
        Item previous
            int updated = if command == "ADD" then previous.value + value else value
            auto replacement = Item(key, updated)
            if table.mode == Mode.Chain
                table.buckets[found.position][found.chain_index] = replacement
            else
                table.slots[found.position] = Slot(replacement)
            table.counters.updates += 1
            string row = "{command} {key}={updated} UPDATED old={previous.value} at=" + position_text(table, found.position) + " probes={found.probes}"
            return Mutation(false, [], [row].concat(trace))
        none
            auto inserted = Item(key, value)
            Placement placed = place(&table, inserted, found, tracing)
            table.size += 1
            table.counters.inserts += 1
            string row = "{command} {key}={value} NEW"
            string[] rehashes = []
            if placed.success
                row += " at=" + position_text(table, placed.position) + " probes={found.probes}"
                if placed.reused
                    row += " reused"
                if table.mode == Mode.RobinHood
                    row += " shifted={placed.shifted}"
                elif table.mode == Mode.Cuckoo
                    row += " kicks={placed.kicks}"
            else
                row += " probes={found.probes}"
                string reason = "full"
                if table.mode == Mode.Cuckoo
                    reason = "kicks"
                    row += " kicks={placed.kicks} failed"
                else
                    row += " full"
                rehashes = rehashes.append(automatic(&table, reason, next_prime(2 * table.cap), placed.homeless))
            rehashes = rehashes.concat(load_check(&table, maximum))
            return Mutation(true, rehashes, [row].concat(trace).concat(placed.moves).concat(rehashes))

string[] get_item(Table &table, string key, bool tracing)
    Search found = search(table, key, tracing)
    table.counters.probes += found.probes
    string row
    match found.item
        Item item
            table.counters.hits += 1
            row = "GET " + pair_text(item) + " at=" + position_text(table, found.position) + " probes={found.probes}"
        none
            table.counters.misses += 1
            row = "GET {key} NOT FOUND probes={found.probes}"
    return [row].concat(trace_path(found, tracing))

Mutation delete_item(Table &table, string key, int minimum, int maximum, bool tracing = false)
    Search found = search(table, key, tracing)
    table.counters.probes += found.probes
    string[] trace = trace_path(found, tracing)
    if found.position < 0
        table.counters.absent += 1
        return Mutation(false, [], ["DEL {key} NOT FOUND probes={found.probes}"].concat(trace))
    Removal removed = remove_item(&table, found, tracing)
    table.counters.deletes += 1
    string row = "DEL {key} OK at=" + position_text(table, found.position) + " probes={found.probes}"
    if table.mode == Mode.RobinHood
        row += " shifted={removed.shifted}"
    string[] rehashes = shrink_check(&table, minimum, maximum)
    return Mutation(true, rehashes, [row].concat(trace).concat(removed.moves).concat(rehashes))

Cost[] costs(const Table table)
    Cost[] result = []
    if table.mode == Mode.Chain
        for nat position = table.buckets.indices()[]
            Item[] bucket = table.buckets[position]
            for nat index = bucket.indices()[]
                result = result.append(Cost(bucket[index].key, int(index) + 1, int(position)))
    else
        for nat position = table.slots.indices()[]
            match table.slots[position].item
                Item item
                    int cost
                    if table.mode == Mode.Cuckoo
                        cost = int(position) / table.cap + 1
                    elif table.mode == Mode.Linear or table.mode == Mode.RobinHood
                        cost = distance(table, item.key, int(position)) + 1
                    else
                        cost = search(table, item.key).probes
                    result = result.append(Cost(item.key, cost, int(position)))
                none
                    continue
    return result

int[] cost_values(const Table table)
    int[] result = []
    for Cost cost = costs(table)[]
        result = result.append(cost.value)
    return result

Metrics metrics(const Table table)
    int[] values = cost_values(table)
    return Metrics(math.max_all(values.append(0)), decimal(math.sum(values), table.size))

string[] item_keys(const Item[] items)
    string[] result = []
    for Item item = items[]
        result = result.append(item.key)
    return result

Item[] sorted_items(const Table table)
    map.Map<string, Item> indexed = map.Map<string, Item>()
    for Item item = table_items(table)[]
        .indexed.set(item.key, item)
    Item[] result = []
    for string key = indexed.keys().sorted()[]
        match indexed.get(key)
            Item item
                result = result.append(item)
            none
                continue
    return result

string[] dump(const Table table)
    string[] rows = ["DUMP " + mode_text(table.mode) + " cap={table.cap} size={table.size} tomb={table.tomb}"]
    if table.mode == Mode.Chain
        for nat position = table.buckets.indices()[]
            string[] entries = []
            for Item item = table.buckets[position][]
                entries = entries.append(pair_text(item))
            rows = rows.append("{position} " + (if len(entries) == 0 then "-" else entries.join(" ")))
    else
        for nat position = table.slots.indices()[]
            string prefix = position.string()
            if table.mode == Mode.Cuckoo
                prefix = "T{int(position) / table.cap + 1} {int(position) % table.cap}"
            Slot slot = table.slots[position]
            string text
            match slot.item
                Item item
                    text = pair_text(item)
                    if table.mode == Mode.RobinHood
                        text += " d=" + distance(table, item.key, int(position)).string()
                none
                    text = content(slot)
            rows = rows.append(prefix + " " + text)
    return rows

string gauge(int value)
    return if value >= 10 then "+" else value.string()

string[] map_report(const Table table)
    string[] rows = ["MAP " + mode_text(table.mode) + " cap={table.cap}"]
    string[] characters = array(nat(slot_count(table)), fill = ".")
    if table.mode == Mode.Chain
        for nat position = table.buckets.indices()[]
            if len(table.buckets[position]) > 0
                characters[position] = gauge(int(len(table.buckets[position])))
    else
        for nat position = table.slots.indices()[]
            if table.slots[position].tombstone
                characters[position] = "D"
        for Cost cost = costs(table)[]
            characters[cost.position] = if table.mode == Mode.Cuckoo then "#" else gauge(cost.value - 1)
    int parts = if table.mode == Mode.Cuckoo then 2 else 1
    for 0 <= int part < parts
        string prefix = if table.mode == Mode.Cuckoo then "T{part + 1} " else ""
        for 0 <= int start < table.cap step 40
            int end = math.min(start + 40, table.cap)
            string text = characters[part * table.cap + start:<part * table.cap + end].join("")
            rows = rows.append(prefix + "{start:int=5,zero} " + text)
    return rows

string[] statistics(const Table table)
    Metrics values = metrics(table)
    Counters count = table.counters
    return ["STATS " + mode_text(table.mode) + " size={table.size} cap={table.cap} slots=" + slot_count(table).string() + " tomb={table.tomb} load=" + decimal(100 * table.size, slot_count(table)) + "% longest={values.longest} avg={values.average} probes={count.probes} rehashes={count.rehashes}", "OPS inserts={count.inserts} updates={count.updates} hits={count.hits} misses={count.misses} deletes={count.deletes} absent={count.absent}"]

string[] strings_at(const map.Map<int, string[]> groups, int key)
    match groups.get(key)
        string[] values
            return values
        none
            return []

string[] top_report(const Table table, int limit)
    map.Map<int, string[]> groups = map.Map<int, string[]>()
    map.Map<string, Cost> indexed = map.Map<string, Cost>()
    for Cost cost = costs(table)[]
        .groups.set(cost.value, strings_at(groups, cost.value).append(cost.key))
        .indexed.set(cost.key, cost)
    string[] detail = []
    for int value = groups.keys().sorted(descending = true)[]
        for string key = strings_at(groups, value).sorted()[]
            if int(len(detail)) == limit
                break
            match indexed.get(key)
                Cost cost
                    detail = detail.append("{key} cost={value} at=" + position_text(table, cost.position))
                none
                    continue
        if int(len(detail)) == limit
            break
    return ["TOP {len(detail)}"].concat(detail)

string[] cursor_keys(const Table table, int cursor)
    if table.mode == Mode.Chain
        return item_keys(table.buckets[cursor])
    match table.slots[cursor].item
        Item item
            return [item.key]
        none
            return []

string[] scan_table(const Table table, int cursor, int limit)
    string[] keys = []
    while cursor < slot_count(table) and int(len(keys)) < limit
        keys = keys.concat(cursor_keys(table, cursor))
        cursor += 1
    if cursor == slot_count(table)
        cursor = 0
    return [["SCAN next={cursor}"].concat(keys).join(" ")]

int[] circular_runs(const bool[] occupied)
    int empty = -1
    for nat index = occupied.indices()[]
        if not occupied[index]
            empty = int(index)
            break
    int size = int(len(occupied))
    if empty < 0
        return if size == 0 then [] else [size]
    int[] lengths = []
    int length = 0
    for 1 <= int offset <= size
        if occupied[(empty + offset) % size]
            length += 1
        elif length > 0
            lengths = lengths.append(length)
            length = 0
    return lengths

int count_at(const map.Map<int, int> counts, int value)
    match counts.get(value)
        int count
            return count
        none
            return 0

string[] histogram(const int[] values)
    map.Map<int, int> counts = map.Map<int, int>()
    for int value = values[]
        .counts.set(value, count_at(counts, value) + 1)
    string[] rows = []
    for int value = counts.keys().sorted()[]
        int count = count_at(counts, value)
        string bar = string.repeat("#", nat(math.min(50, count)))
        if count > 50
            bar += "+"
        rows = rows.append("{value} {count} " + bar)
    return rows

string[] clusters(const Table table)
    int[] lengths = []
    if table.mode == Mode.Chain
        for Item[] bucket = table.buckets[]
            if len(bucket) > 0
                lengths = lengths.append(int(len(bucket)))
    else
        bool[] occupied = []
        for Slot slot = table.slots[]
            occupied = occupied.append(not empty_slot(slot))
        if table.mode == Mode.Cuckoo
            lengths = circular_runs(occupied[:<table.cap]).concat(circular_runs(occupied[table.cap:]))
        else
            lengths = circular_runs(occupied)
    return ["CLUSTERS runs={len(lengths)} longest=" + math.max_all(lengths.append(0)).string()].concat(histogram(lengths))

string[] generated_keys(int count, int length, int state)
    string alphabet = "abcdefghijklmnopqrstuvwxyz"
    string[] result = []
    for 0 <= int index < count
        string key = ""
        for 0 <= int letter < length
            state = 48271 * state % 2147483647
            key += alphabet[state % 26]
        result = result.append(key)
    return result

string[] compare(const Table table, int capacity, int maximum)
    Item[] items = sorted_items(table)
    string[] rows = ["COMPARE keys={len(items)} cap={capacity}"]
    for Mode mode = modes()[]
        Table trial = new_table(mode, capacity)
        for Item item = items[]
            put(&trial, item.key, item.value, "PUT", maximum)
        Metrics values = metrics(trial)
        rows = rows.append(mode_text(mode) + " cap={trial.cap} longest={values.longest} avg={values.average} probes={trial.counters.probes} rehashes={trial.counters.rehashes}")
    return rows

string[] bench(int capacity, int count, int length, int seed, int maximum)
    string[] keys = generated_keys(2 * count, length, seed)
    string[] rows = ["BENCH cap={capacity} count={count} len={length} seed={seed}"]
    for Mode mode = modes()[]
        Table trial = new_table(mode, capacity)
        for 0 <= int index < count
            put(&trial, keys[index], index + 1, "PUT", maximum)
        int misses = 0
        int probes = 0
        for string key = keys[count:][]
            Search found = search(trial, key)
            if found.position < 0
                misses += 1
                probes += found.probes
        rows = rows.append(mode_text(mode) + " cap={trial.cap} keys={trial.size} hit=" + metrics(trial).average + " misses={misses} miss=" + decimal(probes, misses) + " rehashes={trial.counters.rehashes}")
    return rows

int | error check_capacity(int capacity)
    if capacity < 2 or capacity > 10000
        return error("BAD CAPACITY")
    return capacity

Mode | error check_mode(string text)
    for Mode mode = modes()[]
        if mode_text(mode) == text
            return mode
    return error("BAD MODE " + text)

void | error check_generation(int count, int length, int seed)
    if count < 1 or count > 500 or length < 1 or length > 10 or seed < 1 or seed > 2147483646
        return error("BAD ARGUMENT")

string[] | error execute_table(Table &table, const Simulator settings, const string[] words)
    string command = words[0]
    if command == "PUT" or command == "ADD"
        return put(&table, words[1], int.parse(words[2]), command, settings.max_load, settings.tracing).rows
    elif command == "GET"
        return get_item(&table, words[1], settings.tracing)
    elif command == "DEL"
        return delete_item(&table, words[1], settings.min_load, settings.max_load, settings.tracing).rows
    elif command == "PROBE"
        Search found = search(table, words[1], true)
        string ending = if found.position < 0 then "MISS" else "FOUND"
        return [["PROBE " + words[1]].concat(found.path).append(ending + " probes={found.probes}").join(" ")]
    elif command == "GEN" or command == "GENDEL"
        int count = int.parse(words[1])
        int length = int.parse(words[2])
        int seed = int.parse(words[3])
        try check_generation(count, length, seed)
        string[] keys = generated_keys(count, length, seed)
        string[] rows = []
        int successes = 0
        for nat index = keys.indices()[]
            Mutation result
            if command == "GEN"
                result = put(&table, keys[index], int(index) + 1, "PUT", settings.max_load)
            else
                result = delete_item(&table, keys[index], settings.min_load, settings.max_load)
            if result.changed
                successes += 1
            rows = rows.concat(result.rehashes)
        if command == "GEN"
            return rows.append("GEN {count} new={successes} updated={count - successes}")
        return rows.append("GENDEL {count} deleted={successes} missing={count - successes}")
    elif command == "RESIZE" or command == "CONVERT"
        Mode mode = table.mode
        int capacity = table.cap
        if command == "RESIZE"
            capacity = next_prime(try check_capacity(int.parse(words[1])))
        else
            mode = try check_mode(words[1])
        int slots = capacity * (if mode == Mode.Cuckoo then 2 else 1)
        if table.size * 100 > settings.max_load * slots
            return error("TOO SMALL")
        string row = if command == "RESIZE" then "RESIZE {table.cap} -> {capacity}" else "CONVERT " + mode_text(table.mode) + " -> " + mode_text(mode) + " cap={capacity}"
        if not rebuild(&table, mode, capacity, table_items(table))
            return error("REBUILD FAILED")
        return [row]
    elif command == "CLEAR"
        string row = "CLEAR {table.size}"
        Counters saved = table.counters
        table = new_table(table.mode, table.cap)
        table.counters = saved
        return [row]
    elif command == "DUMP"
        return dump(table)
    elif command == "MAP"
        return map_report(table)
    elif command == "STATS"
        return statistics(table)
    elif command == "KEYS"
        return [["KEYS {table.size}"].concat(item_keys(table_items(table)).sorted()).join(" ")]
    elif command == "TOP"
        int limit = int.parse(words[1])
        if limit < 1 or limit > 100
            return error("BAD ARGUMENT")
        return top_report(table, limit)
    elif command == "SCAN"
        int cursor = int.parse(words[1])
        int limit = int.parse(words[2])
        if limit < 1 or limit > 100
            return error("BAD ARGUMENT")
        if cursor >= slot_count(table)
            return error("BAD CURSOR")
        return scan_table(table, cursor, limit)
    elif command == "CLUSTERS"
        return clusters(table)
    elif command == "DIST"
        int[] values = cost_values(table)
        return ["DIST keys={table.size} longest=" + math.max_all(values.append(0)).string()].concat(histogram(values))
    int capacity = next_prime(try check_capacity(int.parse(words[1])))
    return compare(table, capacity, settings.max_load)

bool known_command(string command)
    string[] commands = ["CREATE", "MAXLOAD", "MINLOAD", "TRACE", "HASH", "PUT", "ADD", "GET", "DEL", "PROBE", "GEN", "GENDEL", "RESIZE", "CONVERT", "CLEAR", "DUMP", "MAP", "STATS", "KEYS", "TOP", "SCAN", "CLUSTERS", "DIST", "COMPARE", "BENCH"]
    for string name = commands[]
        if name == command
            return true
    return false

string[] | error execute(Simulator &simulator, string line)
    string[] words = line.split(" ")
    string command = words[0]
    if not known_command(command)
        return error("UNKNOWN COMMAND " + command)
    if command == "CREATE"
        Mode mode = try check_mode(words[1])
        int capacity = next_prime(try check_capacity(int.parse(words[2])))
        simulator.current = new_table(mode, capacity)
        return ["CREATE " + mode_text(mode) + " cap={capacity}"]
    elif command == "MAXLOAD"
        int maximum = int.parse(words[1])
        if maximum < 10 or maximum > 95
            return error("BAD LOAD")
        simulator.max_load = maximum
        return [line]
    elif command == "MINLOAD"
        int minimum = int.parse(words[1])
        if minimum > 40
            return error("BAD LOAD")
        simulator.min_load = minimum
        return [line]
    elif command == "TRACE"
        if words[1] != "ON" and words[1] != "OFF"
            return error("BAD ARGUMENT")
        simulator.tracing = words[1] == "ON"
        return [line]
    elif command == "HASH"
        int capacity = try check_capacity(int.parse(words[2]))
        string key = words[1]
        return ["HASH {key} m={capacity} h31=" + hash(key, 31, capacity).string() + " h37=" + hash(key, 37, capacity).string() + " step=" + (1 + hash(key, 37, capacity - 1)).string()]
    elif command == "BENCH"
        int capacity = next_prime(try check_capacity(int.parse(words[1])))
        int count = int.parse(words[2])
        int length = int.parse(words[3])
        int seed = int.parse(words[4])
        try check_generation(count, length, seed)
        return bench(capacity, count, length, seed, simulator.max_load)
    match simulator.current
        Table table
            string[] rows = try execute_table(&table, simulator, words)
            simulator.current = table
            return rows
        none
            return error("NO TABLE")

auto hash_simulator = Simulator()
int command_count
scan(&command_count)
for 0 <= int command_index < command_count
    string command_line
    scan(&command_line)
    match execute(&hash_simulator, command_line)
        string[] rows
            for string row = rows[]
                print(row + NL)
        error problem
            print("ERROR " + problem.message + NL)
