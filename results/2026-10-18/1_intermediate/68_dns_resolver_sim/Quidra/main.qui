bool text_less(string a, string b)
    int[] first = a.codepoints()
    int[] second = b.codepoints()
    nat count = if len(first) < len(second) then len(first) else len(second)
    for nat i < count
        if first[i] != second[i]
            return first[i] < second[i]
    return len(first) < len(second)

bool has_word(string[] words, string word)
    for string item = words[]
        if item == word
            return true
    return false

bool has_number(int[] numbers, int number)
    for int item = numbers[]
        if item == number
            return true
    return false

nat find_at(string text, string needle)
    match text.find(needle)
        nat found
            return found
        none
            return len(text)

string lower(string text)
    string result = ""
    for nat i < len(text)
        nat at = find_at("ABCDEFGHIJKLMNOPQRSTUVWXYZ", text[i])
        result += if at < 26 then "abcdefghijklmnopqrstuvwxyz"[at] else text[i]
    return result

bool all_chars(string text, string alphabet)
    for nat i < len(text)
        if not alphabet.contains(text[i])
            return false
    return true

bool integer_word(string text, nat digits = 9)
    return len(text) >= 1 and len(text) <= digits and all_chars(text, "0123456789") and (len(text) == 1 or text[0] != "0")

int | error parse_ipv4(string text)
    string[] parts = text.split(".")
    if len(parts) != 4
        return error("bad address {text}")
    int result = 0
    for string part = parts[]
        if not integer_word(part, 3)
            return error("bad address {text}")
        int n = int.parse(part)
        if n > 255
            return error("bad address {text}")
        result = result * 256 + n
    return result

string ipv4_text(int value)
    return "{value / 16777216}.{value / 65536 % 256}.{value / 256 % 256}.{value % 256}"

int[] | none parse_groups(string text)
    int[] result = []
    if text == ""
        return result
    for string part = text.split(":")[]
        if len(part) < 1 or len(part) > 4 or not all_chars(part, "0123456789abcdefABCDEF")
            return none
        int value = 0
        for nat i < len(part)
            value = value * 16 + int(find_at("0123456789abcdef", lower(part[i])))
        result = result.append(value)
    return result

int[] | error parse_ipv6(string text)
    nat split = find_at(text, "::")
    if split == len(text)
        match parse_groups(text)
            int[] result
                if len(result) == 8
                    return result
            none
                void
    else
        match parse_groups(text[:<split])
            int[] front
                match parse_groups(text[split + 2:])
                    int[] back
                        if len(front) + len(back) <= 7
                            int[] result = front
                            for nat i < 8 - len(front) - len(back)
                                result = result.append(0)
                            return result.concat(back)
                    none
                        void
            none
                void
    return error("bad address {text}")

string hexadecimal(int value, nat width = 0)
    int n = value
    string result = ""
    while n > 0
        result = "0123456789abcdef"[n % 16] + result
        n /= 16
    if result == ""
        result = "0"
    while len(result) < width
        result = "0" + result
    return result

string ipv6_text(int[] groups)
    nat best = 8
    nat width = 1
    nat at = 0
    while at < 8
        nat end = at
        while end < 8 and groups[end] == 0
            end += 1
        if end - at > width
            best = at
            width = end - at
        at = if end > at then end else at + 1
    string[] parts = [for int item = groups[] then hexadecimal(item)]
    return if best == 8 then parts.join(":") else parts[:<best].join(":") + "::" + parts[best + width:].join(":")

string[] labels(string text)
    return if text == "." then [] else text[:<len(text) - 1].split(".")

string | error parse_name(string text, bool wildcard = false, string origin = "")
    if origin != "" and text == "@"
        return origin
    if text == "."
        return "."
    bool absolute = text.ends_with(".")
    string[] parts = (if absolute then text[:<len(text) - 1] else text).split(".")
    for string part = parts[nat i]
        if wildcard and i == 0 and part == "*"
            continue
        if len(part) < 1 or len(part) > 63 or not all_chars(part, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-") or part[0] == "-" or part[len(part) - 1] == "-"
            return error("bad name {text}")
    string result = lower(parts.join(".")) + "."
    return if origin != "" and origin != "." and not absolute then result + origin else result

bool below(string text, string ancestor)
    return ancestor == "." or text == ancestor or text.ends_with("." + ancestor)

string[] ancestors(string text)
    string[] parts = labels(text)
    string[] result = []
    for nat i <= len(parts)
        result = result.append(if i == len(parts) then "." else parts[i:].join(".") + ".")
    return result

bool name_less(string a, string b)
    string[] first = labels(a)
    string[] second = labels(b)
    nat n = if len(first) < len(second) then len(first) else len(second)
    for nat i < n
        string x = first[len(first) - i - 1]
        string y = second[len(second) - i - 1]
        if x != y
            return text_less(x, y)
    return len(first) < len(second)

string[] names_sorted(string[] names)
    string[] result = names
    for 1 <= nat i < len(result)
        nat j = i
        while j > 0 and name_less(result[j], result[j - 1])
            string held = result[j]
            result[j] = result[j - 1]
            result[j - 1] = held
            j -= 1
    return result

int | error parse_ttl(string text)
    int total = 0
    if integer_word(text)
        total = int.parse(text)
    else
        nat at = 0
        int previous = -1
        while at < len(text)
            nat start = at
            while at < len(text) and "0123456789".contains(text[at])
                at += 1
            string digits = text[start:<at]
            if not integer_word(digits, 3) or at == len(text)
                return error("bad ttl {text}")
            nat unit = find_at("wdhms", lower(text[at]))
            if unit == 5 or int(unit) <= previous
                return error("bad ttl {text}")
            previous = int(unit)
            total += int.parse(digits) * [604800, 86400, 3600, 60, 1][unit]
            at += 1
    return if total < 1 or total > 604800 then error("bad ttl {text}") else total

nat type_index(string text)
    string[] types = ["A", "NS", "CNAME", "SOA", "PTR", "MX", "TXT", "AAAA"]
    for string item = types[nat i]
        if item == text
            return i
    return 8

void | error require_type(string text)
    if type_index(text) == 8
        return error("bad type {text}")

class Record(string owner, int ttl, string kind)
    string data = ""
    string target = ""
    int number = 0
    int[] groups = []
    int minimum = 0

Record | error parse_record(string owner, int ttl, string kind, string[] fields, string origin)
    auto result = Record(owner, ttl, kind)
    if kind == "A"
        result.number = try parse_ipv4(fields[0])
        result.data = ipv4_text(result.number)
    elif kind == "AAAA"
        result.groups = try parse_ipv6(fields[0])
        result.data = ipv6_text(result.groups)
    elif kind == "NS" or kind == "CNAME" or kind == "PTR"
        result.target = try parse_name(fields[0], false, origin)
        result.data = result.target
    elif kind == "MX"
        if not integer_word(fields[0]) or int.parse(fields[0]) > 65535
            return error("bad preference {fields[0]}")
        result.number = int.parse(fields[0])
        result.target = try parse_name(fields[1], false, origin)
        result.data = "{result.number} {result.target}"
    elif kind == "TXT"
        result.data = fields.join(" ")
        if len(result.data) < 2 or result.data[0] != DQ or result.data[len(result.data) - 1] != DQ or result.data[1:<len(result.data) - 1].contains(DQ)
            return error("bad text {result.data}")
    else
        string first = try parse_name(fields[0], false, origin)
        string second = try parse_name(fields[1], false, origin)
        string[] parts = [first, second]
        for 2 <= nat i < 6
            if not integer_word(fields[i])
                return error("bad number {fields[i]}")
            parts = parts.append("{int.parse(fields[i])}")
        if not integer_word(fields[6]) or int.parse(fields[6]) < 1 or int.parse(fields[6]) > 86400
            return error("bad minimum {fields[6]}")
        result.minimum = int.parse(fields[6])
        parts = parts.append("{result.minimum}")
        result.data = parts.join(" ")
    return result

string record_text(Record record)
    return "{record.owner} {record.ttl} {record.kind} {record.data}"

bool data_less(Record a, Record b)
    if a.kind == "A"
        return a.number < b.number
    if a.kind == "AAAA"
        for nat i < 8
            if a.groups[i] != b.groups[i]
                return a.groups[i] < b.groups[i]
        return false
    if a.kind == "NS" or a.kind == "CNAME" or a.kind == "PTR"
        return name_less(a.target, b.target)
    if a.kind == "MX"
        return if a.number != b.number then a.number < b.number else name_less(a.target, b.target)
    return text_less(a.data, b.data)

bool record_less(Record a, Record b, bool data_only = false)
    if not data_only
        if a.owner != b.owner
            return name_less(a.owner, b.owner)
        if a.kind != b.kind
            return type_index(a.kind) < type_index(b.kind)
    return data_less(a, b)

Record[] records_sorted(Record[] records, bool data_only = true)
    Record[] result = records
    for 1 <= nat i < len(result)
        nat j = i
        while j > 0 and record_less(result[j], result[j - 1], data_only)
            Record held = result[j]
            result[j] = result[j - 1]
            result[j - 1] = held
            j -= 1
    return result

class Zone(string origin, int server, nat line)
    Record[] records = []

Record[] at_owner(Zone zone, string name, string kind = "")
    Record[] result = [for Record item = zone.records[] if item.owner == name and (kind == "" or item.kind == kind) then item]
    return if kind == "" then result else records_sorted(result)

bool exists(Zone zone, string name)
    for Record item = zone.records[]
        if below(item.owner, name)
            return true
    return false

Record soa(Zone zone)
    for Record item = zone.records[]
        if item.kind == "SOA"
            return item
    return Record(".", 0, "SOA")

class Response(string kind)
    Record[] answer = []
    Record[] authority = []
    Record[] additional = []
    string referral = "."

string response_text(Response response)
    return if response.kind == "REFERRAL" then "REFERRAL {response.referral}" elif response.kind == "CNAME" then "CNAME {response.answer[0].target}" else response.kind

class Entry(string name, string kind, string status, Record[] records, int expiry)
class Pair(string name, string kind)
class Resolution(string status, Record[] answer)
class QueryCount(int address)
    int[] counts = array(7, fill = 0)

void emit(string text)
    print(text + NL)

void trace(nat depth, string text)
    emit(string.repeat(" ", (depth + 1) * 2) + text)

class Resolver()
    int[] roots = []
    Zone[] zones = []
    int current = -1
    int[] down = []
    int clock = 0
    Entry[] cache = []
    int minttl = 1
    int maxttl = 86400
    int negttl = 3600
    QueryCount[] queries = []
    int hits = 0
    int[] resolutions = array(4, fill = 0)

    void | error .zone_input(string text, nat line)
        string[] words = text.split(" ")
        if words[0] == "ROOT"
            int[] addresses = []
            for string word = words[1:][]
                int address = try parse_ipv4(word)
                if has_number(roots, address) or has_number(addresses, address)
                    return error("duplicate root {word}")
                addresses = addresses.append(address)
            roots = roots.concat(addresses)
        elif words[0] == "ZONE"
            current = -1
            string origin = try parse_name(words[1])
            int address = try parse_ipv4(words[2])
            for Zone zone = zones[]
                if zone.origin == origin and zone.server == address
                    return error("duplicate zone {origin} at {words[2]}")
            current = int(len(zones))
            zones = zones.append(Zone(origin, address, line))
        else
            if current < 0
                return error("no current zone")
            Zone zone = zones[current]
            string owner = try parse_name(words[0], true, zone.origin)
            if not below(owner, zone.origin)
                return error("out of zone {owner}")
            int ttl = try parse_ttl(words[1])
            string kind = words[2]
            try require_type(kind)
            nat required = if kind == "TXT" then len(words) - 3 elif kind == "MX" then 2 elif kind == "SOA" then 7 else 1
            if len(words) - 3 != required
                return error("wrong field count")
            Record record = try parse_record(owner, ttl, kind, words[3:], zone.origin)
            if kind == "NS" and owner.starts_with("*.")
                return error("ns at wildcard")
            if kind == "SOA" and owner != zone.origin
                return error("soa not at origin")
            if kind == "SOA" and soa(zone).ttl != 0
                return error("duplicate soa")
            for Record other = zone.records[]
                if other.owner == owner and other.kind == kind and other.data == record.data
                    return error("duplicate record")
            for Record other = zone.records[]
                if other.owner == owner and (other.kind == "CNAME" or kind == "CNAME")
                    return error("cname conflict {owner}")
            zones[current].records = zones[current].records.append(record)

    void .finish_zones()
        Zone[] kept = []
        nat total = 0
        for Zone zone = zones[]
            string label = "zone {zone.origin} at {ipv4_text(zone.server)}"
            if soa(zone).ttl == 0
                emit("error line {zone.line}: {label} has no soa")
            else
                emit("{label} records={len(zone.records)}")
                kept = kept.append(zone)
                total += len(zone.records)
        zones = kept
        emit("loaded roots={len(roots)} zones={len(zones)} records={total}")

    bool reachable(int address)
        if has_number(down, address)
            return false
        for Zone zone = zones[]
            if zone.server == address
                return true
        return false

    Response respond(int address, string name, string kind, string cut)
        if not reachable(address)
            return Response("TIMEOUT")
        int chosen = -1
        for Zone zone = zones[nat i]
            if zone.server == address and below(name, zone.origin) and (chosen < 0 or len(labels(zone.origin)) > len(labels(zones[chosen].origin)))
                chosen = int(i)
        if chosen < 0 or len(labels(zones[chosen].origin)) < len(labels(cut))
            return Response("LAME")
        Zone zone = zones[chosen]
        string[] parts = labels(name)
        for len(labels(zone.origin)) + 1 <= nat width <= len(parts)
            string point = parts[len(parts) - width:].join(".") + "."
            Record[] ns = at_owner(zone, point, "NS")
            if len(ns) > 0
                auto result = Response("REFERRAL")
                result.authority = ns
                result.referral = point
                for Record server = ns[]
                    result.additional = result.additional.concat(at_owner(zone, server.target, "A"))
                return result
        Record[] records = at_owner(zone, name)
        string status = "NODATA"
        if len(records) == 0 and not exists(zone, name)
            string[] parents = ancestors(name)
            for string parent = parents[1:][]
                if exists(zone, parent)
                    records = at_owner(zone, if parent == "." then "*." else "*." + parent)
                    break
            if len(records) == 0
                status = "NXDOMAIN"
        Record[] matching = []
        Record[] cnames = []
        for Record record = records[]
            record.owner = name
            if record.kind == kind
                matching = matching.append(record)
            if record.kind == "CNAME"
                cnames = cnames.append(record)
        if len(matching) > 0 or (kind != "CNAME" and len(cnames) > 0)
            auto result = Response(if len(matching) > 0 then "ANSWER" else "CNAME")
            result.answer = if len(matching) > 0 then records_sorted(matching) else cnames
            return result
        auto result = Response(status)
        result.authority = [soa(zone)]
        return result

    Response .ask(int address, string name, string kind, string cut)
        Response result = respond(address, name, kind, cut)
        nat chosen = len(queries)
        for QueryCount count = queries[nat i]
            if count.address == address
                chosen = i
                break
        if chosen == len(queries)
            queries = queries.append(QueryCount(address))
        string[] kinds = ["ANSWER", "CNAME", "REFERRAL", "NODATA", "NXDOMAIN", "LAME", "TIMEOUT"]
        for string item = kinds[nat i]
            if item == result.kind
                queries[chosen].counts[i] += 1
        return result

    int entry_index(string name, string kind, bool positive = false)
        for Entry entry = cache[nat i]
            if entry.name == name and entry.kind == kind and (not positive or entry.status == "POS")
                return int(i)
        return -1

    void .store(Entry entry)
        int at = entry_index(entry.name, entry.kind)
        if at < 0
            cache = cache.append(entry)
        else
            cache[at] = entry

    int .store_positive(Record[] records)
        int ttl = records[0].ttl
        for Record record = records[]
            if record.ttl < ttl
                ttl = record.ttl
        if ttl < minttl
            ttl = minttl
        if ttl > maxttl
            ttl = maxttl
        .store(Entry(records[0].owner, records[0].kind, "POS", records_sorted(records), clock + ttl))
        return ttl

    Record[] aged(Entry entry)
        Record[] result = entry.records
        for nat i < len(result)
            result[i].ttl = entry.expiry - clock
        return result

    Response | none .try_addresses(int[] addresses, string name, string kind, string cut, nat depth)
        for int address = addresses[]
            Response result = .ask(address, name, kind, cut)
            trace(depth, "ASK {ipv4_text(address)} {name} {kind} -> {response_text(result)}")
            if result.kind != "LAME" and result.kind != "TIMEOUT"
                return result
        return none

    Response .lookup(string name, string kind, nat depth, Pair[] pending)
        int direct = entry_index(name, kind)
        Response cached = Response("")
        if direct >= 0
            Entry entry = cache[direct]
            cached.kind = if entry.status == "POS" then "ANSWER" else entry.status
            if entry.status == "POS"
                cached.answer = aged(entry)
        else
            for Entry entry = cache[]
                if entry.status == "NXDOMAIN" and below(name, entry.name)
                    cached.kind = "NXDOMAIN"
                    break
            int cname = entry_index(name, "CNAME", true)
            if cached.kind == "" and kind != "CNAME" and cname >= 0
                cached.kind = "CNAME"
                cached.answer = aged(cache[cname])
        if cached.kind != ""
            hits += 1
            trace(depth, "CACHE HIT {name} {kind} -> {response_text(cached)}")
            return cached
        string cut = "."
        string[] servers = []
        bool hints = true
        for string ancestor = ancestors(name)[]
            int at = entry_index(ancestor, "NS", true)
            if at >= 0
                hits += 1
                trace(depth, "CACHE HIT {name} {kind} -> REFERRAL {ancestor}")
                cut = ancestor
                servers = [for Record record = cache[at].records[] then record.target]
                hints = false
                break
        while true
            Response | none obtained = none
            if hints
                obtained = .try_addresses(roots, name, kind, cut, depth)
            else
                for string host = names_sorted(servers)[]
                    int[] addresses = []
                    int at = entry_index(host, "A", true)
                    if at >= 0
                        for Record record = cache[at].records[]
                            if not has_number(addresses, record.number)
                                addresses = addresses.append(record.number)
                    else
                        bool loop = false
                        for Pair pair = pending[]
                            if pair.name == host and pair.kind == "A"
                                loop = true
                        if loop
                            trace(depth, "GLUELESS {host} -> LOOP")
                        else
                            trace(depth, "GLUELESS {host}")
                            Resolution found = .resolve(host, "A", depth + 1, pending)
                            if found.status == "NOERROR"
                                for Record record = found.answer[]
                                    if record.kind == "A" and not has_number(addresses, record.number)
                                        addresses = addresses.append(record.number)
                    obtained = .try_addresses(addresses.sorted(), name, kind, cut, depth)
                    match obtained
                        Response found
                            break
                        none
                            void
            match obtained
                none
                    return Response("SERVFAIL no server for {cut}")
                Response response
                    if response.kind == "REFERRAL"
                        int ttl = .store_positive(response.authority)
                        string[] owners = []
                        for Record record = response.additional[]
                            if not has_word(owners, record.owner)
                                owners = owners.append(record.owner)
                        for string owner = owners[]
                            Record[] glue = [for Record record = response.additional[] if record.owner == owner then record]
                            int stored = .store_positive(glue)
                        cut = response.referral
                        servers = [for Record record = response.authority[] then record.target]
                        hints = false
                    elif response.kind == "ANSWER" or response.kind == "CNAME"
                        int ttl = .store_positive(response.answer)
                        for nat i < len(response.answer)
                            response.answer[i].ttl = ttl
                        return response
                    else
                        Record authority = response.authority[0]
                        int ttl = authority.ttl
                        if authority.minimum < ttl
                            ttl = authority.minimum
                        if negttl < ttl
                            ttl = negttl
                        .store(Entry(name, kind, response.kind, [], clock + ttl))
                        return Response(response.kind)

    Resolution .resolve(string name, string kind, nat depth = 0, Pair[] pending = [])
        Pair[] active = pending.append(Pair(name, kind))
        Record[] chain = []
        string[] seen = [name]
        string current_name = name
        Response response = Response("")
        while true
            response = .lookup(current_name, kind, depth, active)
            if response.kind != "CNAME"
                break
            chain = chain.concat(response.answer)
            string target = response.answer[0].target
            if has_word(seen, target)
                response = Response("SERVFAIL cname loop")
                break
            if len(chain) == 9
                response = Response("SERVFAIL cname chain too long")
                break
            seen = seen.append(target)
            current_name = target
        string status = if response.kind == "ANSWER" then "NOERROR" else response.kind
        Record[] answer = if status.starts_with("SERVFAIL") then [] else chain.concat(response.answer)
        string[] statuses = ["NOERROR", "NODATA", "NXDOMAIN", "SERVFAIL"]
        for string item = statuses[nat i]
            if item == status or (item == "SERVFAIL" and status.starts_with("SERVFAIL"))
                resolutions[i] += 1
        return Resolution(status, answer)

    Resolution .report(string name, string kind)
        Resolution result = .resolve(name, kind)
        for Record record = result.answer[]
            emit("answer " + record_text(record))
        emit("status {result.status}")
        return result

    string .address_resolution(string host)
        string[] addresses = []
        for string kind = ["A", "AAAA"][]
            Resolution result = .resolve(host, kind)
            if result.status == "NOERROR"
                for Record record = result.answer[]
                    if record.kind == kind
                        addresses = addresses.append(record.data)
        return if len(addresses) == 0 then "no address" else addresses.join(" ")

    void | error .execute(string text)
        string[] words = text.split(" ")
        string command = words[0]
        if command == "RESOLVE" or command == "MX"
            string name = try parse_name(words[1], true)
            string kind = if command == "MX" then "MX" else words[2]
            try require_type(kind)
            emit(if command == "MX" then "mx {name}" else "resolve {name} {kind}")
            Resolution result = .report(name, kind)
            if command == "MX"
                if result.status == "NOERROR"
                    for Record record = result.answer[]
                        if record.kind == "MX"
                            string addresses = if record.target == "." then "null" else .address_resolution(record.target)
                            emit("exchange {record.number} {record.target} -> {addresses}")
                elif result.status == "NODATA"
                    string host = if len(result.answer) == 0 then name else result.answer[len(result.answer) - 1].target
                    string addresses = .address_resolution(host)
                    emit("implicit {host} -> {addresses}")
        elif command == "REVERSE"
            string address = ""
            string[] parts = []
            string suffix = "in-addr.arpa."
            if words[1].contains(":")
                int[] groups = try parse_ipv6(words[1])
                address = ipv6_text(groups)
                string digits = [for int group = groups[] then hexadecimal(group, 4)].join("")
                for len(digits) > nat i >= 0
                    parts = parts.append(digits[i])
                suffix = "ip6.arpa."
            else
                int value = try parse_ipv4(words[1])
                address = ipv4_text(value)
                string[] fields = address.split(".")
                for 4 > nat i >= 0
                    parts = parts.append(fields[i])
            string name = parts.join(".") + "." + suffix
            emit("reverse {address} {name}")
            Resolution result = .report(name, "PTR")
        elif command == "QUERY"
            int address = try parse_ipv4(words[1])
            string name = try parse_name(words[2], true)
            try require_type(words[3])
            Response result = .ask(address, name, words[3], ".")
            emit("query {ipv4_text(address)} {name} {words[3]} -> {response_text(result)}")
            for Record record = result.answer[]
                emit("answer " + record_text(record))
            for Record record = result.authority[]
                emit("authority " + record_text(record))
            for Record record = result.additional[]
                emit("additional " + record_text(record))
        elif command == "DUMP"
            int address = try parse_ipv4(words[1])
            string name = try parse_name(words[2])
            string prefix = "dump {ipv4_text(address)} {name}"
            if not reachable(address)
                emit("{prefix} -> TIMEOUT")
            else
                int chosen = -1
                for Zone zone = zones[nat i]
                    if zone.server == address and zone.origin == name
                        chosen = int(i)
                if chosen < 0
                    emit("{prefix} -> REFUSED")
                else
                    emit("{prefix} records={len(zones[chosen].records)}")
                    for Record record = records_sorted(zones[chosen].records, false)[]
                        emit("  " + record_text(record))
        elif command == "DOWN" or command == "UP"
            int address = try parse_ipv4(words[1])
            bool present = has_number(down, address)
            if command == "DOWN" and present
                return error("server {words[1]} already down")
            if command == "UP" and not present
                return error("server {words[1]} not down")
            down = if command == "DOWN" then down.append(address) else [for int item = down[] if item != address then item]
            emit("{lower(command)} {ipv4_text(address)}")
        elif command == "SET"
            string key = words[1]
            if not has_word(["MINTTL", "MAXTTL", "NEGTTL"], key)
                return error("bad setting {key}")
            if not integer_word(words[2]) or int.parse(words[2]) < 1 or int.parse(words[2]) > 604800
                return error("bad value {words[2]}")
            int value = int.parse(words[2])
            if (key == "MINTTL" and value > maxttl) or (key == "MAXTTL" and value < minttl)
                return error("minttl above maxttl")
            if key == "MINTTL"
                minttl = value
            elif key == "MAXTTL"
                maxttl = value
            else
                negttl = value
            emit("set {key}={value}")
        elif command == "TIME"
            if not integer_word(words[1]) or int.parse(words[1]) < 1 or int.parse(words[1]) > 1000000
                return error("bad time {words[1]}")
            clock += int.parse(words[1])
            nat before = len(cache)
            cache = [for Entry entry = cache[] if entry.expiry > clock then entry]
            emit("time now={clock} expired={before - len(cache)}")
        elif command == "CACHE" or command == "FLUSH"
            string name = if len(words) == 1 then "." else try parse_name(words[1])
            Entry[] selected = [for Entry entry = cache[] if below(entry.name, name) then entry]
            if command == "FLUSH"
                cache = [for Entry entry = cache[] if not below(entry.name, name) then entry]
                emit("flush removed={len(selected)}")
            else
                for 1 <= nat i < len(selected)
                    nat j = i
                    while j > 0 and (name_less(selected[j].name, selected[j - 1].name) or (selected[j].name == selected[j - 1].name and type_index(selected[j].kind) < type_index(selected[j - 1].kind)))
                        Entry held = selected[j]
                        selected[j] = selected[j - 1]
                        selected[j - 1] = held
                        j -= 1
                emit("cache entries={len(selected)}")
                for Entry entry = selected[]
                    if entry.status == "POS"
                        for Record record = aged(entry)[]
                            emit("  " + record_text(record))
                    else
                        emit("  {entry.name} {entry.expiry - clock} {entry.kind} {entry.status}")
        else
            int total = 0
            int[] addresses = [for QueryCount query = queries[] then query.address]
            for QueryCount query = queries[]
                for int count = query.counts[]
                    total += count
            emit("stats queries={total} hits={hits}")
            string[] kinds = ["answer", "cname", "referral", "nodata", "nxdomain", "lame", "timeout"]
            for int address = addresses.sorted()[]
                for QueryCount query = queries[]
                    if query.address == address
                        int sent = 0
                        string[] details = []
                        for int count = query.counts[nat i]
                            sent += count
                            details = details.append("{kinds[i]}={count}")
                        emit("  {ipv4_text(address)} sent={sent} {details.join(" ")}")
            emit("resolutions noerror={resolutions[0]} nodata={resolutions[1]} nxdomain={resolutions[2]} servfail={resolutions[3]}")

auto resolver = Resolver()
bool zone_section = true
nat line_number = 0
while true
    string line
    scan(&line)
    line_number += 1
    if zone_section and line == "END ZONES"
        .resolver.finish_zones()
        zone_section = false
        continue
    if not zone_section and line == "END"
        break
    if zone_section
        match .resolver.zone_input(line, line_number)
            void
                void
            error problem
                emit("error line {line_number}: {problem.message}")
    else
        match .resolver.execute(line)
            void
                void
            error problem
                emit("error line {line_number}: {problem.message}")
