bool member(string[] words, string text)
    for string word = words[]
        if word == text
            return true
    return false

bool all_chars(string text, string alphabet)
    for nat i < len(text)
        if not alphabet.contains(text[i])
            return false
    return true

string trim(string text)
    nat a = 0
    nat b = len(text)
    while a < b and text[a] == " "
        a += 1
    while b > a and text[b - 1] == " "
        b -= 1
    return text[a:<b]

nat find_at(string text, string needle, nat at = 0)
    match text[at:].find(needle)
        nat found
            return at + found
        none
            return len(text)

bool identifier(string text)
    return text != "" and all_chars(text[0], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_") and all_chars(text, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789")

bool subscript(string text)
    return text != "" and all_chars(text, "0123456789") and (len(text) == 1 or text[0] != "0")

bool number_text(string text)
    string digits = if text.starts_with("-") then text[1:] else text
    return len(digits) >= 1 and len(digits) <= 9 and all_chars(digits, "0123456789")

bool valid_name(string text)
    if text == "." or text == "@index" or text == "@number" or text == "@first" or text == "@last"
        return true
    for string part = text.split(".")[]
        if not identifier(part) and not subscript(part)
            return false
    return true

string change_case(string text, bool upper, bool title = false)
    string result = ""
    for nat i < len(text)
        string ch = text[i]
        bool up = if title then i == 0 or text[i - 1] == " " else upper
        string alphabet = if up then "abcdefghijklmnopqrstuvwxyz" else "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        string target = if up then "ABCDEFGHIJKLMNOPQRSTUVWXYZ" else "abcdefghijklmnopqrstuvwxyz"
        match alphabet.find(ch)
            nat n
                result += target[n]
            none
                result += ch
    return result

string html(string text)
    string result = ""
    for nat i < len(text)
        string ch = text[i]
        result += if ch == "&" then "&amp;" else if ch == "<" then "&lt;" else if ch == ">" then "&gt;" else if ch == DQ then "&quot;" else if ch == "'" then "&#39;" else ch
    return result

string[] unquoted(string text, string separator)
    string[] result = []
    nat start = 0
    bool quoted = false
    for nat i < len(text)
        if text[i] == "'"
            quoted = not quoted
        elif text[i] == separator and not quoted
            result = result.append(text[start:<i])
            start = i + 1
    return result.append(text[start:])

// Recursive values and syntax trees use arena indices; copies remain independent.
class Value(string kind, string text = "", int number = 0)
    string[] keys = []
    nat[] children = []

class Part(string name, int index, string prefix)
class Filter(string name)
    nat[] arguments = []
class Expression(string name)
    Filter[] filters = []
class Node(string kind, nat line, string text = "")
    Expression expression = Expression("")
    nat[] children = []
    string indent = ""
class Source()
    nat[] numbers = []
    string[] lines = []
class Loop(nat index, nat count)

class Engine()
    Value[] values = [Value("absent"), Value("map")]
    nat root = 1
    map.Map<string, Source> partials
    map.Map<string, Source> templates
    Node[] nodes = []
    bool strict = false
    string reason = ""
    nat error_line = 0

    void .fail(nat line, string message)
        if reason == ""
            reason = message
            error_line = line

    nat .add(Value value)
        values = values.append(value)
        return len(values) - 1

    nat .string_value(string text)
        return .add(Value("string", text))

    nat .integer(int number)
        return .add(Value("integer", "", number))

    nat .boolean(bool flag)
        return .add(Value("boolean", if flag then "true" else "false"))

    int child(nat owner, Part part)
        Value value = values[owner]
        if part.index >= 0
            return if value.kind == "list" and part.index < int(len(value.children)) then int(value.children[part.index]) else -1
        if value.kind == "map"
            for string key = value.keys[nat i]
                if key == part.name
                    return int(value.children[i])
        return -1

    void .put(nat owner, Part part, nat value)
        Value container = values[owner]
        if part.index >= 0
            if part.index == int(len(container.children))
                container.children = container.children.append(value)
            else
                container.children[part.index] = value
        else
            nat at = len(container.keys)
            for string key = container.keys[nat i]
                if key == part.name
                    at = i
                    break
            if at == len(container.keys)
                container.keys = container.keys.append(part.name)
                container.children = container.children.append(value)
            else
                container.children[at] = value
        values[owner] = container

    Part[] .key_parts(string key, nat line)
        Part[] result = []
        nat at = 0
        bool first = true
        while at < len(key)
            nat start = at
            if not first and key[at] == "["
                nat close = find_at(key, "]", at + 1)
                if close == len(key) or not subscript(key[at + 1:<close])
                    .fail(line, "bad key '{key}'")
                    return []
                at = close + 1
                result = result.append(Part("", int.parse(key[start + 1:<close]), key[:<at]))
            else
                if not first
                    if key[at] != "."
                        .fail(line, "bad key '{key}'")
                        return []
                    at += 1
                start = at
                while at < len(key) and key[at] != "." and key[at] != "["
                    at += 1
                string word = key[start:<at]
                if not identifier(word)
                    .fail(line, "bad key '{key}'")
                    return []
                result = result.append(Part(word, -1, key[:<at]))
            first = false
        if len(result) == 0 or key.ends_with(".")
            .fail(line, "bad key '{key}'")
        return result

    nat .scalar(string text, nat &at, bool &valid)
        if at < len(text) and text[at] == DQ
            at += 1
            string result = ""
            while at < len(text)
                string ch = text[at]
                at += 1
                if ch == DQ
                    return .string_value(result)
                if ch == "\"
                    if at == len(text) or not (DQ + "\n").contains(text[at])
                        valid = false
                        return 0
                    ch = if text[at] == "n" then NL else text[at]
                    at += 1
                result += ch
            valid = false
            return 0
        nat start = at
        while at < len(text) and text[at] != "," and text[at] != "]"
            at += 1
        string word = text[start:<at]
        if word == "true" or word == "false"
            return .boolean(word == "true")
        string digits = if word.starts_with("-") then word[1:] else word
        if not subscript(digits) or word == "-0"
            valid = false
            return 0
        return .integer(int.parse(word))

    nat .parse_value(string text, nat line)
        if text == "[]" or text == "{{}}"
            return .add(Value(if text == "[]" then "list" else "map"))
        nat at = 0
        bool valid = true
        nat result = 0
        if text.starts_with("[")
            at = 1
            auto list = Value("list")
            while valid
                nat item = .scalar(text, &at, &valid)
                list.children = list.children.append(item)
                if text[at:] == "]"
                    at = len(text)
                    break
                if not text[at:].starts_with(", ")
                    valid = false
                    break
                at += 2
            result = .add(list)
        else
            result = .scalar(text, &at, &valid)
        if not valid or at != len(text)
            .fail(line, "bad value '{text}'")
        return result

    void .data_line(string text, nat line, bool deleting)
        nat separator = find_at(text, " = ")
        if not deleting and separator == len(text)
            .fail(line, "bad line")
            return
        string key = if deleting then text[6:] else text[:<separator]
        Part[] parts = .key_parts(key, line)
        if reason != ""
            return
        nat item = if deleting then 0 else .parse_value(text[separator + 3:], line)
        if reason != ""
            return
        nat current = root
        for Part part = parts[nat i]
            int found = child(current, part)
            if deleting
                if found < 0
                    .fail(line, "no value at '{key}'")
                    return
                if i + 1 == len(parts)
                    Value container = values[current]
                    nat position = if part.index >= 0 then nat(part.index) else 0
                    if part.index < 0
                        while container.keys[position] != part.name
                            position += 1
                        container.keys = container.keys[:<position].concat(container.keys[position + 1:])
                    container.children = container.children[:<position].concat(container.children[position + 1:])
                    values[current] = container
                else
                    current = nat(found)
            else
                if part.index > int(len(values[current].children))
                    .fail(line, "index gap at '{part.prefix}'")
                    return
                if i + 1 == len(parts)
                    .put(current, part, item)
                else
                    string required = if parts[i + 1].index >= 0 then "list" else "map"
                    if found >= 0 and values[found].kind != required
                        .fail(line, "type conflict at '{part.prefix}'")
                        return
                    if found < 0
                        found = int(.add(Value(required)))
                        .put(current, part, nat(found))
                    current = nat(found)

    string .as_text(nat id, nat line)
        Value value = values[id]
        if value.kind == "integer"
            return "{value.number}"
        if value.kind == "absent"
            return ""
        if value.kind == "map"
            .fail(line, "cannot render map")
            return ""
        if value.kind == "list"
            string[] result = []
            for nat item = value.children[]
                result = result.append(.as_text(item, line))
            return result.join(", ")
        return value.text

    bool truth(nat id)
        Value value = values[id]
        return if value.kind == "absent" then false else if value.kind == "boolean" then value.text == "true" else if value.kind == "integer" then value.number != 0 else if value.kind == "string" then value.text != "" else len(value.children) > 0

    int .as_number(nat id, string filter, nat line)
        Value value = values[id]
        if value.kind == "absent"
            return 0
        if value.kind == "integer"
            return value.number
        if value.kind == "string" and number_text(value.text)
            return int.parse(value.text)
        .fail(line, "not a number for '{filter}'")
        return 0

    bool arguments_valid(Filter filter)
        string name = filter.name
        nat n = len(filter.arguments)
        bool first_int = n > 0 and values[filter.arguments[0]].kind == "integer"
        bool first_string = n > 0 and values[filter.arguments[0]].kind == "string"
        if name == "default" or name == "eq"
            return n == 1
        if name == "pad" or name == "lpad"
            return (n == 1 or n == 2) and first_int and values[filter.arguments[0]].number >= 0 and (n == 1 or values[filter.arguments[1]].kind == "string" and len(values[filter.arguments[1]].text) == 1)
        if name == "truncate"
            return n == 1 and first_int and values[filter.arguments[0]].number >= 0
        if name == "replace"
            return n == 2 and first_string and values[filter.arguments[0]].text != "" and values[filter.arguments[1]].kind == "string"
        if name == "join" or name == "pluck"
            return n == 1 and first_string
        if name == "sort"
            return n == 0 or n == 1 and first_string
        if name == "div" or name == "mod"
            return n == 1 and first_int and values[filter.arguments[0]].number != 0
        if member(["add", "sub", "mul", "gt", "lt"], name)
            return n == 1 and first_int
        return n == 0

    Expression .expression(string text, nat line)
        string[] pieces = unquoted(text, "|")
        auto result = Expression(trim(pieces[0]))
        if not valid_name(result.name)
            .fail(line, "invalid name '{result.name}'")
            return result
        for 1 <= nat i < len(pieces)
            string[] fields = unquoted(trim(pieces[i]), ":")
            auto filter = Filter(fields[0])
            if not member(["upper", "lower", "title", "trim", "length", "first", "last", "reverse", "items", "comma", "sum", "min", "max", "default", "eq", "pad", "lpad", "truncate", "replace", "join", "sort", "pluck", "add", "sub", "mul", "div", "mod", "gt", "lt"], filter.name)
                .fail(line, "unknown filter '{filter.name}'")
                return result
            for 1 <= nat j < len(fields)
                string arg = fields[j]
                if len(arg) >= 2 and arg.starts_with("'") and arg.ends_with("'") and not arg[1:<len(arg) - 1].contains("'")
                    filter.arguments = filter.arguments.append(.string_value(arg[1:<len(arg) - 1]))
                elif number_text(arg)
                    filter.arguments = filter.arguments.append(.integer(int.parse(arg)))
                else
                    .fail(line, "bad arguments for '{filter.name}'")
                    return result
            if not arguments_valid(filter)
                .fail(line, "bad arguments for '{filter.name}'")
                return result
            result.filters = result.filters.append(filter)
        return result

    nat .node(Node new_node)
        nodes = nodes.append(new_node)
        return len(nodes) - 1

    nat .parse(Source source)
        nat root_node = .node(Node("root", 0))
        nat[] targets = [root_node]
        nat[] sections = []
        string opening = "{{{{"
        string closing = "}}}}"
        for string text = source.lines[nat row]
            nat line = source.numbers[row]
            nat[] tokens = []
            nat at = 0
            nat tag_count = 0
            nat only_tag = 0
            while true
                nat start = find_at(text, opening, at)
                tokens = tokens.append(.node(Node("text", line, text[at:<start])))
                if start == len(text)
                    break
                nat after = start + len(opening)
                bool triple = text[after:].starts_with("{{")
                nat content_start = after + (if triple then 1 else 0)
                string stop = (if triple then "}}" else "") + closing
                nat close = find_at(text, stop, content_start)
                if close == len(text)
                    .fail(line, "unclosed tag")
                    return root_node
                string content = trim(text[content_start:<close])
                at = close + len(stop)
                string kind = if triple then "&" else if content != "" and "#^/!>&=".contains(content[0]) then content[0] else "v"
                string arg = if triple or kind == "v" or kind == "=" then content else trim(content[1:])
                auto tag = Node(kind, line, arg)
                if kind == "="
                    string[] delimiters = if len(content) >= 2 and content.ends_with("=") then [for string word = content[1:<len(content) - 1].split(" ")[] if word != "" then word] else []
                    if len(delimiters) != 2 or delimiters[0].contains("=") or delimiters[1].contains("=")
                        .fail(line, "invalid delimiters")
                        return root_node
                    opening = delimiters[0]
                    closing = delimiters[1]
                elif kind == "v" or kind == "&" or kind == "#" or kind == "^"
                    tag.expression = .expression(arg, line)
                elif kind == "/"
                    if not valid_name(arg)
                        .fail(line, "invalid name '{arg}'")
                    elif len(sections) == 0
                        .fail(line, "unexpected closing '{arg}'")
                    else
                        string expected = nodes[sections[len(sections) - 1]].expression.name
                        if arg != expected
                            .fail(line, "mismatched closing '{arg}', expected '{expected}'")
                        sections = sections[:<len(sections) - 1]
                elif kind == ">" and not identifier(arg)
                    .fail(line, "invalid name '{arg}'")
                if reason != ""
                    return root_node
                nat id = .node(tag)
                if kind == "#" or kind == "^"
                    sections = sections.append(id)
                tokens = tokens.append(id)
                tag_count += 1
                only_tag = id
            bool standalone = tag_count == 1 and "#^/!>=".contains(nodes[only_tag].kind)
            for nat id = tokens[]
                if nodes[id].kind == "text" and trim(nodes[id].text) != ""
                    standalone = false
            if standalone
                if nodes[only_tag].kind == ">"
                    nodes[only_tag].indent = nodes[tokens[0]].text
                tokens = [only_tag]
            else
                tokens = tokens.append(.node(Node("text", line, NL)))
            for nat id = tokens[]
                string kind = nodes[id].kind
                if kind == "/"
                    targets = targets[:<len(targets) - 1]
                elif kind != "!" and kind != "="
                    nat parent = targets[len(targets) - 1]
                    nodes[parent].children = nodes[parent].children.append(id)
                    if kind == "#" or kind == "^"
                        targets = targets.append(id)
        if len(sections) > 0
            Node section = nodes[sections[len(sections) - 1]]
            .fail(section.line, "unclosed section '{section.expression.name}'")
        return root_node

    nat field(nat id, string key)
        int found = child(id, Part(key, -1, ""))
        return if found < 0 then 0 else nat(found)

    bool less(nat left, nat right)
        Value a = values[left]
        Value b = values[right]
        string[] kinds = ["absent", "integer", "string", "boolean"]
        nat arank = 4
        nat brank = 4
        for string kind = kinds[nat i]
            if a.kind == kind
                arank = i
            if b.kind == kind
                brank = i
        if arank != brank
            return arank < brank
        return if arank == 1 then a.number < b.number else if arank == 2 or arank == 3 then a.text < b.text else false

    nat .apply(Filter filter, nat id, nat line)
        string name = filter.name
        nat[] args = filter.arguments
        Value value = values[id]
        if name == "default"
            return if truth(id) then id else args[0]
        if name == "first" or name == "last"
            return if value.kind != "list" then id else if len(value.children) == 0 then 0 else value.children[if name == "first" then 0 else len(value.children) - 1]
        if name == "reverse"
            if value.kind == "string"
                return .string_value(value.text[::-1])
            if value.kind == "list"
                value.children = value.children[::-1]
                return .add(value)
            return id
        if name == "items"
            if value.kind != "map"
                return id
            auto list = Value("list")
            for string key = value.keys.sorted()[]
                auto pair = Value("map")
                pair.keys = ["key", "value"]
                pair.children = [.string_value(key), field(id, key)]
                list.children = list.children.append(.add(pair))
            return .add(list)
        if name == "sort" or name == "pluck"
            if value.kind != "list"
                return id
            if name == "pluck"
                value.children = [for nat item = value.children[] then field(item, values[args[0]].text)]
            else
                for 1 <= nat i < len(value.children)
                    nat j = i
                    while j > 0
                        nat a = value.children[j]
                        nat b = value.children[j - 1]
                        if len(args) > 0
                            a = field(a, values[args[0]].text)
                            b = field(b, values[args[0]].text)
                        if not less(a, b)
                            break
                        nat saved = value.children[j]
                        value.children[j] = value.children[j - 1]
                        value.children[j - 1] = saved
                        j -= 1
            return .add(value)
        if name == "length"
            return .integer(int(if value.kind == "map" or value.kind == "list" then len(value.children) else len(.as_text(id, line))))
        if name == "sum" or name == "min" or name == "max"
            if value.kind != "list"
                return .integer(.as_number(id, name, line))
            if len(value.children) == 0
                return if name == "sum" then .integer(0) else 0
            int total = 0
            for nat item = value.children[nat i]
                int n = .as_number(item, name, line)
                if name == "sum"
                    total += n
                elif i == 0 or (name == "min" and n < total) or (name == "max" and n > total)
                    total = n
            return .integer(total)
        if member(["comma", "add", "sub", "mul", "div", "mod", "gt", "lt"], name)
            int n = .as_number(id, name, line)
            if reason != ""
                return 0
            if name == "comma"
                string digits = (if n < 0 then -n else n).string()
                string result = ""
                for nat i < len(digits)
                    if i > 0 and (len(digits) - i) % 3 == 0
                        result += ","
                    result += digits[i]
                return .string_value((if n < 0 then "-" else "") + result)
            int a = values[args[0]].number
            if name == "gt" or name == "lt"
                return .boolean(if name == "gt" then n > a else n < a)
            int quotient = if name == "div" or name == "mod" then n / a else 0
            if (name == "div" or name == "mod") and n % a != 0 and ((n < 0) != (a < 0))
                quotient -= 1
            return .integer(if name == "add" then n + a else if name == "sub" then n - a else if name == "mul" then n * a else if name == "div" then quotient else n - a * quotient)
        string text = .as_text(id, line)
        if name == "upper" or name == "lower" or name == "title"
            text = change_case(text, name == "upper", name == "title")
        elif name == "trim"
            text = trim(text)
        elif name == "eq"
            return .boolean(text == .as_text(args[0], line))
        elif name == "pad" or name == "lpad"
            nat count = nat(values[args[0]].number)
            if len(text) < count
                string fill = string.repeat(if len(args) == 2 then values[args[1]].text else " ", count - len(text))
                text = if name == "pad" then text + fill else fill + text
        elif name == "truncate"
            nat count = nat(values[args[0]].number)
            if len(text) > count
                text = text[:<count] + "..."
        elif name == "replace"
            text = text.split(values[args[0]].text).join(values[args[1]].text)
        elif name == "join" and value.kind == "list"
            string[] strings = []
            for nat item = value.children[]
                strings = strings.append(.as_text(item, line))
            text = strings.join(values[args[0]].text)
        return .string_value(text)

    int resolve(string name, nat[] contexts, Loop[] loops)
        if name == "."
            return int(contexts[len(contexts) - 1])
        if name.starts_with("@")
            return -1
        Part[] parts = []
        for string word = name.split(".")[]
            parts = parts.append(if subscript(word) then Part("", int.parse(word), "") else Part(word, -1, ""))
        for len(contexts) > nat i >= 0
            int current = child(contexts[i], parts[0])
            if current < 0
                continue
            for 1 <= nat j < len(parts)
                current = child(nat(current), parts[j])
                if current < 0
                    return -1
            return current
        return -1

    nat .evaluate(Expression parsed_expression, nat line, nat[] contexts, Loop[] loops, bool require)
        int found = resolve(parsed_expression.name, contexts, loops)
        if parsed_expression.name.starts_with("@") and len(loops) > 0
            Loop loop = loops[len(loops) - 1]
            found = int(if parsed_expression.name == "@index" then .integer(int(loop.index)) else if parsed_expression.name == "@number" then .integer(int(loop.index + 1)) else .boolean(if parsed_expression.name == "@first" then loop.index == 0 else loop.index + 1 == loop.count))
        if found < 0 and require
            .fail(line, "missing '{parsed_expression.name}'")
            return 0
        nat result = if found < 0 then 0 else nat(found)
        for Filter filter = parsed_expression.filters[]
            result = .apply(filter, result, line)
            if reason != ""
                break
        return result

    string .render(nat parent, nat[] contexts, Loop[] loops, nat depth)
        string result = ""
        for nat id = nodes[parent].children[]
            Node rendered_node = nodes[id]
            string kind = rendered_node.kind
            if kind == "text"
                result += rendered_node.text
            elif kind == ">"
                match partials.get(rendered_node.text)
                    Source source
                        if depth == 8
                            .fail(rendered_node.line, "partial depth exceeded at '{rendered_node.text}'")
                            return ""
                        for nat i < len(source.lines)
                            if source.lines[i] != ""
                                source.lines[i] = rendered_node.indent + source.lines[i]
                        nat partial = .parse(source)
                        if reason == ""
                            result += .render(partial, contexts, loops, depth + 1)
                    none
                        .fail(rendered_node.line, "unknown partial '{rendered_node.text}'")
            else
                nat value = .evaluate(rendered_node.expression, rendered_node.line, contexts, loops, strict and (kind == "v" or kind == "&"))
                if reason != ""
                    return ""
                if kind == "v" or kind == "&"
                    string text = .as_text(value, rendered_node.line)
                    result += if kind == "v" then html(text) else text
                elif kind == "^"
                    if not truth(value)
                        result += .render(id, contexts, loops, depth)
                elif values[value].kind == "list"
                    nat[] children = values[value].children
                    for nat item = children[nat i]
                        result += .render(id, contexts.append(item), loops.append(Loop(i, len(children))), depth)
                        if reason != ""
                            return ""
                elif truth(value)
                    result += .render(id, contexts.append(value), loops, depth)
            if reason != ""
                return ""
        return result

    string[] leaves(nat id, string path)
        Value value = values[id]
        string[] result = []
        if value.kind == "map" and len(value.children) > 0
            for string key = value.keys.sorted()[]
                result = result.concat(leaves(field(id, key), (if path == "" then "" else path + ".") + key))
        elif value.kind == "list" and len(value.children) > 0
            for nat item = value.children[nat i]
                result = result.concat(leaves(item, "{path}[{i}]"))
        elif path != ""
            string notation = if value.kind == "string" then DQ + value.text.split("\").join("\\").split(DQ).join("\" + DQ).split(NL).join("\n") + DQ else if value.kind == "integer" then "{value.number}" else if value.kind == "boolean" then value.text else if value.kind == "list" then "[]" else "{{}}"
            result = ["{path} = {notation}"]
        return result

    void .show_template(string name, Source source)
        reason = ""
        nat tree = .parse(source)
        string result = if reason == "" then .render(tree, [root], [], 0) else ""
        if reason != ""
            print("TEMPLATE {name} ERROR line {error_line}: {reason}{NL}")
            return
        string[] lines = if result == "" then [] else result.split(NL)
        if len(lines) > 0 and lines[len(lines) - 1] == ""
            lines = lines[:<len(lines) - 1]
        print("TEMPLATE {name} OK lines={len(lines)} chars={len(result)}{NL}")
        for string line = lines[]
            print(line + NL)

auto engine = Engine()
nat line_number = 0
while true
    string line
    scan(&line)
    line_number += 1
    if line == "END"
        break
    string[] words = line.split(" ")
    string command = words[0]
    string name = if len(words) > 1 then words[1] else ""
    if command == "DATA" or command == "PARTIAL" or command == "TEMPLATE"
        auto source = Source()
        string marker = if command == "DATA" then "ENDDATA" else if command == "PARTIAL" then "ENDPARTIAL" else "ENDTEMPLATE"
        while true
            scan(&line)
            line_number += 1
            if line == marker
                break
            source.lines = source.lines.append(line)
            source.numbers = source.numbers.append(line_number)
        if command == "DATA"
            nat assigned = 0
            nat unset = 0
            string[] errors = []
            for string text = source.lines[nat i]
                if text == "" or text.starts_with("#")
                    continue
                Value[] before = engine.values
                engine.reason = ""
                bool deleting = text.starts_with("UNSET ")
                .engine.data_line(text, source.numbers[i], deleting)
                if engine.reason != ""
                    engine.values = before
                    errors = errors.append("ERROR line {engine.error_line}: {engine.reason}")
                elif deleting
                    unset += 1
                else
                    assigned += 1
            print("DATA set={assigned} unset={unset} errors={len(errors)}{NL}")
            for string message = errors[]
                print(message + NL)
        elif command == "PARTIAL"
            engine.reason = ""
            nat tree = .engine.parse(source)
            if engine.reason != ""
                print("PARTIAL {name} ERROR line {engine.error_line}: {engine.reason}{NL}")
            else
                string status = if engine.partials.has(name) then "REPLACED" else "DEFINED"
                .engine.partials.set(name, source)
                print("PARTIAL {name} {status} lines={len(source.lines)}{NL}")
        else
            .engine.templates.set(name, source)
            .engine.show_template(name, source)
    elif command == "RENDER"
        match engine.templates.get(name)
            Source source
                .engine.show_template(name, source)
            none
                print("TEMPLATE {name} ERROR line {line_number}: unknown template '{name}'{NL}")
    elif command == "DUMP"
        string[] leaves = engine.leaves(engine.root, "")
        print("DUMP leaves={len(leaves)}{NL}")
        for string leaf = leaves[]
            print(leaf + NL)
    elif command == "STRICT"
        engine.strict = name == "ON"
        print(line + NL)
    elif command == "RESET"
        bool strict = engine.strict
        engine = Engine()
        engine.strict = strict
        print("RESET{NL}")
