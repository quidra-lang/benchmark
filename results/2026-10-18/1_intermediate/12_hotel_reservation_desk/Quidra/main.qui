import math

// Gregorian dates and exact cents; historical nights retain room/rate snapshots.
int integer_value(string text)
    return int.parse(text)

int cents(string text)
    string[] parts = text.split(".")
    return 100 * integer_value(parts[0]) + integer_value(parts[1])

string money(int value)
    return "{value / 100}.{value % 100:int=2,zero}"

bool leap(int year)
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

int month_length(int year, int month)
    int[] lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    return lengths[month - 1] + (if month == 2 and leap(year) then 1 else 0)

int day_number(string text)
    int year = integer_value(text[:<4])
    int month = integer_value(text[5:<7])
    int day = integer_value(text[8:])
    if year < 2000 or year > 2099 or month < 1 or month > 12
        return -1
    if day < 1 or day > month_length(year, month)
        return -1
    int result = day - 1
    for 2000 <= int prior < year
        result += if leap(prior) then 366 else 365
    for 1 <= int prior < month
        result += month_length(year, prior)
    return result

string date_text(int day)
    int year = 2000
    while day >= (if leap(year) then 366 else 365)
        day -= if leap(year) then 366 else 365
        year += 1
    int month = 1
    while day >= month_length(year, month)
        day -= month_length(year, month)
        month += 1
    return "{year:int=4,zero}-{month:int=2,zero}-{day + 1:int=2,zero}"

string date_weekday(int day)
    return date_text(day) + " " + ["SAT", "SUN", "MON", "TUE", "WED", "THU", "FRI"][day % 7]

int type_id(string text)
    string[] names = ["SINGLE", "DOUBLE", "SUITE"]
    for 0 <= int k < 3
        if names[k] == text
            return k
    return -1

string type_name(int kind)
    return ["SINGLE", "DOUBLE", "SUITE"][kind]

string status_name(int status)
    return ["booked", "inhouse", "checkedout", "cancelled", "noshow"][status]

class Room(int number, int kind, int rate, bool dirty, int inhouse)
class Season(int first, int last, int percentage)
class Booking(string id, string guest, bool created, int room, int kind, int arrival, int departure, int status, int nights, int extras, int deposit, int paid, int posting, int fee, int penalty_day, int penalty, int[] bill, int extra_head, int extra_tail)
class Extra(string name, int amount, int next)
class Ranked(int index, int day, string id)
class State()
    int today = day_number("2026-01-01")
    Room[] rooms = array(50, fill = Room(0, 0, 0, false, -1))
    int room_used = 0
    Season[] seasons = array(1000, fill = Season(0, 0, 100))
    int season_used = 0
    Booking[] bookings = array(300, fill = Booking("", "", false, -1, 0, 0, 0, -2, 0, 0, 0, 0, -1, 0, -1, 0, array(6, fill = 0), -1, -1))
    int id_used = 0
    int[] creation_order = array(300, fill = 0)
    int created_used = 0
    int[] waiting = array(300, fill = 0)
    int wait_used = 0
    // All valid dates 2000-01-01 through 2099-12-31: 36,525 days.
    bool[][] blocked = array(50, fill = array(36525, fill = false))
    int[][] occupied = array(50, fill = array(36525, fill = -1))
    int[][] night_rooms = array(300, fill = array(30, fill = -1))
    int[][] night_rates = array(300, fill = array(30, fill = 0))
    Extra[] charges = array(1000, fill = Extra("", 0, -1))
    int charge_used = 0

void emit(string text)
    print(text + NL)

void fail(string reason)
    emit("ERROR " + reason)

int room_id(const State state, int number)
    for 0 <= int k < state.room_used
        if state.rooms[k].number == number
            return k
    return -1

int used_id(const State state, string id)
    for 0 <= int k < state.id_used
        if state.bookings[k].id == id
            return k
    return -1

int reservation_id(const State state, string id)
    int index = used_id(state, id)
    return if index >= 0 and state.bookings[index].created then index else -1

int wait_position(const State state, string id)
    for 0 <= int k < state.wait_used
        if state.bookings[state.waiting[k]].id == id
            return k
    return -1

void remove_wait(State &state, int position)
    for position <= int k < state.wait_used - 1
        state.waiting[k] = state.waiting[k + 1]
    state.wait_used -= 1

int[] room_order(const State state, int kind = -1)
    int[] result = [for 0 <= int k < state.room_used if kind < 0 or state.rooms[k].kind == kind then k]
    for 1 <= int k < int(len(result))
        int value = result[k]
        int position = k
        while position > 0 and state.rooms[result[position - 1]].number > state.rooms[value].number
            result[position] = result[position - 1]
            position -= 1
        result[position] = value
    return result

bool lexical_before(string a, string b)
    int[] aa = a.codepoints()
    int[] bb = b.codepoints()
    int count = if len(aa) < len(bb) then int(len(aa)) else int(len(bb))
    for 0 <= int k < count
        if aa[k] != bb[k]
            return aa[k] < bb[k]
    return len(aa) < len(bb)

int[] reservation_order(const State state, int status = -1, int field = 0)
    Ranked[] entries = []
    for 0 <= int k < state.created_used
        int index = state.creation_order[k]
        Booking entry = state.bookings[index]
        if status < 0 or entry.status == status
            int day = if field == 1 then entry.arrival elif field == 2 then entry.departure else 0
            entries = entries.append(Ranked(index, day, entry.id))
    for 1 <= int k < int(len(entries))
        Ranked entry = entries[k]
        int position = k
        while position > 0 and (entry.day < entries[position - 1].day or (entry.day == entries[position - 1].day and lexical_before(entry.id, entries[position - 1].id)))
            entries[position] = entries[position - 1]
            position -= 1
        entries[position] = entry
    return [for Ranked entry = entries[] then entry.index]

int night_rate(const State state, int room, int day)
    int percentage = 100
    for 0 <= int k < state.season_used
        if state.seasons[k].first <= day <= state.seasons[k].last
            percentage = state.seasons[k].percentage
    return state.rooms[room].rate * percentage / 100

int unavailable(const State state, int room, int first, int last, int except = -1)
    for first <= int day < last
        int index = state.occupied[room][day]
        if state.blocked[room][day] or (index >= 0 and index != except)
            return day
    return -1

int free_room(const State state, int kind, int first, int last, int except = -1)
    for int room = room_order(state, kind)[]
        if unavailable(state, room, first, last, except) < 0
            return room
    return -1

string range_error(const State state, string a, string b, bool stay, bool past, int limit)
    int first = day_number(a)
    int last = day_number(b)
    if first < 0
        return "invalid date " + a
    if last < 0
        return "invalid date " + b
    if past and first < state.today
        return "past date " + a
    if last < first or (stay and last == first)
        return "invalid range " + a + " " + b
    int length = last - first + (if stay then 0 else 1)
    if limit > 0 and length > limit
        return "too long " + length.string()
    return ""

int lodging(const State state, int index)
    return state.night_rates[index][:<state.bookings[index].nights].sum()

void clear_nights(State &state, int index, int first)
    Booking entry = state.bookings[index]
    for first <= int k < entry.nights
        state.occupied[state.night_rooms[index][k]][entry.arrival + k] = -1

void price_nights(State &state, int index, int room, int first, int last)
    int arrival = state.bookings[index].arrival
    for first <= int day < last
        int position = day - arrival
        state.night_rooms[index][position] = room
        state.night_rates[index][position] = night_rate(state, room, day)
        state.occupied[room][day] = index

string deposit_text(const Booking entry, int amount)
    return "deposit " + money(entry.deposit) + (if amount >= entry.deposit then " due " + money(amount - entry.deposit) else " refund " + money(entry.deposit - amount))

int total_paid(const State state, string guest)
    int[] payments = [for int index = state.creation_order[:<state.created_used][]
        if state.bookings[index].guest == guest then state.bookings[index].paid]
    return payments.sum()

string tier_name(int points)
    return if points >= 2000 then "GOLD" elif points >= 500 then "SILVER" else "BRONZE"

int[] calculate_bill(const State state, int index)
    Booking entry = state.bookings[index]
    int points = total_paid(state, entry.guest) / 100
    int discount = if points >= 2000 then 10 elif points >= 500 then 5 else 0
    int charge = lodging(state, index)
    int reduction = charge * discount / 100
    int subtotal = charge - reduction + entry.penalty + entry.extras
    int tax = subtotal / 10
    return [charge, reduction, entry.penalty, entry.extras, tax, subtotal + tax]

void create_reservation(State &state, int index, int room, string prefix = "")
    state.bookings[index].created = true
    state.bookings[index].room = room
    state.bookings[index].status = 0
    state.bookings[index].nights = state.bookings[index].departure - state.bookings[index].arrival
    state.creation_order[state.created_used] = index
    state.created_used += 1
    price_nights(&state, index, room, state.bookings[index].arrival, state.bookings[index].departure)
    Booking entry = state.bookings[index]
    emit(prefix + "BOOK " + entry.id + " " + entry.guest + " room " + state.rooms[room].number.string() + " " + type_name(state.rooms[room].kind) + " " + date_text(entry.arrival) + " -> " + date_text(entry.departure) + " nights " + entry.nights.string() + " total " + money(lodging(state, index)))

void process_waitlist(State &state)
    int position = 0
    while position < state.wait_used
        int index = state.waiting[position]
        Booking entry = state.bookings[index]
        if entry.arrival < state.today
            emit("  WAITLIST " + entry.id + " expired")
            state.bookings[index].status = -2
            remove_wait(&state, position)
        else
            int room = free_room(state, entry.kind, entry.arrival, entry.departure)
            if room >= 0
                remove_wait(&state, position)
                create_reservation(&state, index, room, "  ")
            else
                position += 1

void check_out(State &state, int index, int day, string prefix = "")
    Booking entry = state.bookings[index]
    if day < entry.departure
        int position = day - entry.arrival
        state.bookings[index].penalty_day = day
        state.bookings[index].penalty = state.night_rates[index][position]
        clear_nights(&state, index, position)
        state.bookings[index].departure = day
        state.bookings[index].nights = position
    int[] bill = calculate_bill(state, index)
    state.bookings[index].bill = bill
    state.bookings[index].paid = bill[5]
    state.bookings[index].status = 2
    state.bookings[index].posting = day
    state.rooms[entry.room].dirty = true
    state.rooms[entry.room].inhouse = -1
    emit(prefix + "CHECKOUT " + entry.id + " nights " + state.bookings[index].nights.string() + " lodging " + money(bill[0]) + " discount " + money(bill[1]) + " penalty " + money(bill[2]) + " extras " + money(bill[3]) + " tax " + money(bill[4]) + " total " + money(bill[5]) + " " + deposit_text(state.bookings[index], bill[5]))

int[] occupancy(const State state, int day, int kind = -1)
    // registered rooms, blocked rooms, occupied rooms, nightly snapshot revenue
    int[] result = array(4, fill = 0)
    for 0 <= int room < state.room_used
        if kind >= 0 and state.rooms[room].kind != kind
            continue
        result[0] += 1
        if state.blocked[room][day]
            result[1] += 1
        int index = state.occupied[room][day]
        if index >= 0
            result[2] += 1
            result[3] += state.night_rates[index][day - state.bookings[index].arrival]
    return result

string occupancy_text(int[] values)
    int available = values[0] - values[1]
    return "rooms " + values[0].string() + " blocked " + values[1].string() + " occupied " + values[2].string() + " rate " + (if available == 0 then "n/a" else (values[2] * 100 / available).string() + "%")

string metrics(int available, int sold, int revenue)
    return "sold " + sold.string() + "/" + available.string() + " rate " + (if available == 0 then "n/a" else (sold * 100 / available).string() + "%") + " revenue " + money(revenue) + " adr " + (if sold == 0 then "n/a" else money(revenue / sold)) + " revpar " + (if available == 0 then "n/a" else money(revenue / available))

void command(State &state, string line)
    string[] words = line.split(" ")
    string action = words[0]
    if action == "ROOM" or action == "RATE" or action == "CLEAN" or action == "BLOCK" or action == "UNBLOCK"
        int number = integer_value(words[1])
        int room = room_id(state, number)
        if action == "ROOM"
            if room >= 0
                fail("duplicate room " + words[1])
            elif type_id(words[2]) < 0
                fail("invalid type " + words[2])
            else
                state.rooms[state.room_used] = Room(number, type_id(words[2]), cents(words[3]), false, -1)
                state.room_used += 1
                emit("ROOM " + words[1] + " " + words[2] + " " + money(cents(words[3])))
            return
        if room < 0
            fail("unknown room " + words[1])
            return
        if action == "RATE"
            int before = state.rooms[room].rate
            state.rooms[room].rate = cents(words[2])
            emit("RATE " + words[1] + " " + money(before) + " -> " + money(state.rooms[room].rate))
        elif action == "CLEAN"
            if not state.rooms[room].dirty
                fail("already clean " + words[1])
            else
                state.rooms[room].dirty = false
                emit("CLEAN " + words[1])
        else
            string reason = range_error(state, words[2], words[3], false, true, 31)
            if reason != ""
                fail(reason)
                return
            int first = day_number(words[2])
            int last = day_number(words[3])
            if action == "BLOCK"
                for first <= int day <= last
                    if state.occupied[room][day] >= 0
                        fail("room unavailable " + words[1] + " " + date_text(day))
                        return
            int count = 0
            for first <= int day <= last
                bool desired = action == "BLOCK"
                if state.blocked[room][day] != desired
                    state.blocked[room][day] = desired
                    count += 1
            emit(action + " " + words[1] + " " + words[2] + " -> " + words[3] + (if action == "BLOCK" then " added " else " removed ") + count.string())
        return
    if action == "SEASON" or action == "REVENUE"
        string reason = range_error(state, words[1], words[2], false, false, 0)
        if reason != ""
            fail(reason)
            return
        int first = day_number(words[1])
        int last = day_number(words[2])
        if action == "SEASON"
            int percentage = integer_value(words[3])
            state.seasons[state.season_used] = Season(first, last, percentage)
            state.season_used += 1
            emit("SEASON " + state.season_used.string() + " " + words[1] + " -> " + words[2] + " " + percentage.string() + "%")
        else
            emit("REVENUE " + words[1] + " -> " + words[2])
            int[] amounts = array(7, fill = 0)
            int[] counts = array(3, fill = 0)
            for 0 <= int k < state.created_used
                Booking entry = state.bookings[state.creation_order[k]]
                if entry.posting < first or entry.posting > last
                    continue
                if entry.status == 2
                    for 0 <= int part < 5
                        amounts[part] += entry.bill[part]
                    counts[0] += 1
                elif entry.status == 3
                    amounts[5] += entry.fee
                    counts[1] += 1
                elif entry.status == 4
                    amounts[6] += entry.fee
                    counts[2] += 1
            string[] names = ["lodging", "discount", "penalty", "extras", "tax", "cancellation", "noshow"]
            for 0 <= int k < 7
                emit("  " + names[k] + " " + money(amounts[k]))
            int total = amounts[0] - amounts[1] + amounts[2:].sum()
            emit("  total " + money(total))
            emit("  checkouts " + counts[0].string() + " cancellations " + counts[1].string() + " noshows " + counts[2].string())
        return
    if action == "TODAY"
        int day = day_number(words[1])
        if day < 0
            fail("invalid date " + words[1])
        elif day < state.today
            fail("past date " + words[1])
        else
            emit("TODAY " + date_weekday(day))
            for int index = reservation_order(state, 1, 2)[]
                if state.bookings[index].departure < day
                    check_out(&state, index, state.bookings[index].departure, "  ")
            for int index = reservation_order(state, 0, 1)[]
                if state.bookings[index].arrival < day
                    int fee = state.night_rates[index][0]
                    state.bookings[index].fee = fee
                    state.bookings[index].paid = fee
                    state.bookings[index].status = 4
                    state.bookings[index].posting = state.bookings[index].arrival
                    clear_nights(&state, index, 0)
                    Booking entry = state.bookings[index]
                    emit("  NOSHOW " + entry.id + " " + entry.guest + " fee " + money(fee) + " " + deposit_text(entry, fee))
            state.today = day
        return
    if action == "BOOK" or action == "BOOKROOM" or action == "WAITLIST"
        if used_id(state, words[1]) >= 0
            fail("duplicate reservation " + words[1])
            return
        int room = -1
        int kind = -1
        if action == "BOOKROOM"
            room = room_id(state, integer_value(words[3]))
            if room < 0
                fail("unknown room " + words[3])
                return
            kind = state.rooms[room].kind
        else
            kind = type_id(words[3])
            if kind < 0
                fail("invalid type " + words[3])
                return
        string reason = range_error(state, words[4], words[5], true, true, 30)
        if reason != ""
            fail(reason)
            return
        int first = day_number(words[4])
        int last = day_number(words[5])
        if action == "BOOKROOM"
            int unavailable_day = unavailable(state, room, first, last)
            if unavailable_day >= 0
                fail("room unavailable " + words[3] + " " + date_text(unavailable_day))
                return
        else
            room = free_room(state, kind, first, last)
            if room < 0 and action == "BOOK"
                fail("no availability " + words[3] + " " + words[4] + " " + words[5])
                return
        int index = state.id_used
        state.id_used += 1
        state.bookings[index] = Booking(words[1], words[2], false, room, kind, first, last, -1, 0, 0, 0, 0, -1, 0, -1, 0, array(6, fill = 0), -1, -1)
        if room >= 0
            create_reservation(&state, index, room)
        else
            state.waiting[state.wait_used] = index
            state.wait_used += 1
            emit("WAITLIST " + words[1] + " queued position " + state.wait_used.string())
        return
    if action == "AVAIL" or action == "STATS" or action == "OCCUPANCY" or action == "SCHEDULE"
        int kind = -1
        int offset = 1
        if action == "AVAIL"
            kind = type_id(words[1])
            if kind < 0
                fail("invalid type " + words[1])
                return
            offset = 2
        int first = day_number(words[offset])
        int last = first
        if action == "AVAIL" or action == "STATS"
            string reason = range_error(state, words[offset], words[offset + 1], false, false, 31)
            if reason != ""
                fail(reason)
                return
            last = day_number(words[offset + 1])
        elif first < 0
            fail("invalid date " + words[offset])
            return
        if action == "AVAIL"
            emit("AVAIL " + words[1] + " " + words[2] + " -> " + words[3])
            for first <= int day <= last
                string[] rooms = [for int room = room_order(state, kind)[]
                    if unavailable(state, room, day, day + 1) < 0 then state.rooms[room].number.string()]
                emit("  " + date_weekday(day) + " free " + len(rooms).string() + (if len(rooms) == 0 then "" else " " + rooms.join(" ")))
        elif action == "STATS"
            emit("STATS " + words[1] + " -> " + words[2])
            int[] totals = array(3, fill = 0)
            for first <= int day <= last
                int[] values = occupancy(state, day)
                int available = values[0] - values[1]
                emit("  " + date_weekday(day) + " " + metrics(available, values[2], values[3]))
                totals[0] += available
                totals[1] += values[2]
                totals[2] += values[3]
            emit("  total " + metrics(totals[0], totals[1], totals[2]))
        elif action == "OCCUPANCY"
            emit("OCCUPANCY " + date_weekday(first) + " " + occupancy_text(occupancy(state, first)))
            for 0 <= int group < 3
                int[] values = occupancy(state, first, group)
                if values[0] > 0
                    emit("  " + type_name(group) + " " + occupancy_text(values))
        else
            int[] arrivals = []
            int[] departures = []
            for int index = reservation_order(state)[]
                Booking entry = state.bookings[index]
                if entry.arrival == first and entry.status != 3
                    arrivals = arrivals.append(index)
                if entry.departure == first and entry.status <= 2
                    departures = departures.append(index)
            emit("SCHEDULE " + date_weekday(first) + " arrivals " + len(arrivals).string() + " departures " + len(departures).string())
            for 0 <= int stage < 2
                int[] selected = if stage == 0 then arrivals else departures
                for int index = selected[]
                    Booking entry = state.bookings[index]
                    emit("  " + (if stage == 0 then "arrival " else "departure ") + entry.id + " " + entry.guest + " room " + state.rooms[entry.room].number.string() + " " + status_name(entry.status))
        return
    if action == "ROOMS"
        emit("ROOMS " + date_weekday(state.today) + " rooms " + state.room_used.string())
        for int room = room_order(state)[]
            Room entry = state.rooms[room]
            string situation = if entry.inhouse >= 0 then "occupied " + state.bookings[entry.inhouse].id elif state.blocked[room][state.today] then "blocked" else "vacant"
            int next = -1
            for 0 <= int k < state.created_used
                int index = state.creation_order[k]
                if state.bookings[index].status == 0 and state.bookings[index].room == room and (next < 0 or state.bookings[index].arrival < state.bookings[next].arrival)
                    next = index
            string text = "  " + entry.number.string() + " " + type_name(entry.kind) + " base " + money(entry.rate) + " tonight " + money(night_rate(state, room, state.today)) + (if entry.dirty then " dirty " else " clean ") + situation
            if next >= 0
                text += " next " + state.bookings[next].id + " " + date_text(state.bookings[next].arrival)
            emit(text)
        return
    if action == "LIST"
        int status = 0
        for 0 <= int k < 5
            if status_name(k) == words[1]
                status = k
        int[] order = reservation_order(state, status, 1)
        emit("LIST " + words[1] + " " + len(order).string())
        for int index = order[]
            Booking entry = state.bookings[index]
            emit("  " + entry.id + " " + entry.guest + " room " + state.rooms[entry.room].number.string() + " " + date_text(entry.arrival) + " -> " + date_text(entry.departure))
        return
    if action == "QUEUE"
        emit("QUEUE " + state.wait_used.string())
        for 0 <= int k < state.wait_used
            Booking entry = state.bookings[state.waiting[k]]
            emit("  " + (k + 1).string() + " " + entry.id + " " + entry.guest + " " + type_name(entry.kind) + " " + date_text(entry.arrival) + " -> " + date_text(entry.departure))
        return
    if action == "GUEST"
        int[] selected = [for int index = state.creation_order[:<state.created_used][]
            if state.bookings[index].guest == words[1] then index]
        if len(selected) == 0
            fail("unknown guest " + words[1])
            return
        emit("GUEST " + words[1])
        for int index = selected[]
            Booking entry = state.bookings[index]
            emit("  " + entry.id + " room " + state.rooms[entry.room].number.string() + " " + type_name(state.rooms[entry.room].kind) + " " + date_text(entry.arrival) + " -> " + date_text(entry.departure) + " " + status_name(entry.status) + (if entry.status <= 1 then " deposit " + money(entry.deposit) else " paid " + money(entry.paid)))
        int paid = total_paid(state, words[1])
        int points = paid / 100
        emit("  total paid " + money(paid) + " points " + points.string() + " tier " + tier_name(points))
        return
    if action == "CANCEL"
        int position = wait_position(state, words[1])
        if position >= 0
            state.bookings[state.waiting[position]].status = -2
            remove_wait(&state, position)
            emit("CANCEL " + words[1] + " waitlist removed")
            return
    int index = reservation_id(state, words[1])
    if index < 0
        fail("unknown reservation " + words[1])
        return
    Booking entry = state.bookings[index]
    string id = entry.id
    if action != "INVOICE"
        bool valid = if action == "MODIFY" or action == "CANCEL" or action == "CHECKIN" then entry.status == 0 elif action == "PAY" then entry.status <= 1 else entry.status == 1
        if not valid
            fail("invalid status " + id + " " + status_name(entry.status))
            return
    if action == "MODIFY"
        string reason = range_error(state, words[2], words[3], true, true, 30)
        if reason != ""
            fail(reason)
            return
        int first = day_number(words[2])
        int last = day_number(words[3])
        int room = entry.room
        if unavailable(state, room, first, last, index) >= 0
            room = free_room(state, state.rooms[entry.room].kind, first, last, index)
        if room < 0
            fail("no availability " + type_name(state.rooms[entry.room].kind) + " " + words[2] + " " + words[3])
            return
        clear_nights(&state, index, 0)
        state.bookings[index].room = room
        state.bookings[index].arrival = first
        state.bookings[index].departure = last
        state.bookings[index].nights = last - first
        price_nights(&state, index, room, first, last)
        emit("MODIFY " + id + " room " + state.rooms[room].number.string() + (if room == entry.room then " kept " else " reassigned ") + words[2] + " -> " + words[3] + " nights " + (last - first).string() + " total " + money(lodging(state, index)))
    elif action == "CANCEL"
        int days = entry.arrival - state.today
        int first_rate = state.night_rates[index][0]
        int fee = if days >= 7 then 0 elif days >= 1 then first_rate / 2 else first_rate
        state.bookings[index].fee = fee
        state.bookings[index].paid = fee
        state.bookings[index].status = 3
        state.bookings[index].posting = state.today
        clear_nights(&state, index, 0)
        emit("CANCEL " + id + " days " + days.string() + " fee " + money(fee) + " " + deposit_text(entry, fee))
    elif action == "CHECKIN"
        int room = entry.room
        if entry.arrival != state.today
            fail("not arrival date " + id + " " + date_text(entry.arrival))
        elif state.rooms[room].inhouse >= 0
            fail("room occupied " + state.rooms[room].number.string() + " " + state.bookings[state.rooms[room].inhouse].id)
        elif state.rooms[room].dirty
            fail("room dirty " + state.rooms[room].number.string())
        else
            state.bookings[index].status = 1
            state.rooms[room].inhouse = index
            emit("CHECKIN " + id + " " + entry.guest + " room " + state.rooms[room].number.string() + " until " + date_text(entry.departure))
    elif action == "MOVE"
        int room = room_id(state, integer_value(words[2]))
        if room < 0
            fail("unknown room " + words[2])
            return
        if room == entry.room
            fail("same room " + words[2])
            return
        int remaining = entry.departure - state.today
        if remaining <= 0
            fail("no remaining nights " + id)
            return
        int day = unavailable(state, room, state.today, entry.departure, index)
        if day >= 0
            fail("room unavailable " + words[2] + " " + date_text(day))
        elif state.rooms[room].inhouse >= 0
            fail("room occupied " + words[2] + " " + state.bookings[state.rooms[room].inhouse].id)
        elif state.rooms[room].dirty
            fail("room dirty " + words[2])
        else
            for state.today <= int night < entry.departure
                int position = night - entry.arrival
                state.occupied[state.night_rooms[index][position]][night] = -1
                state.night_rooms[index][position] = room
                state.occupied[room][night] = index
            emit("MOVE " + id + " " + state.rooms[entry.room].number.string() + " -> " + words[2] + " nights " + remaining.string())
            state.rooms[entry.room].dirty = true
            state.rooms[entry.room].inhouse = -1
            state.rooms[room].inhouse = index
            state.bookings[index].room = room
    elif action == "EXTEND"
        int last = day_number(words[2])
        if last < 0
            fail("invalid date " + words[2])
        elif last <= entry.departure
            fail("invalid range " + date_text(entry.departure) + " " + words[2])
        elif last - entry.arrival > 30
            fail("too long " + (last - entry.arrival).string())
        else
            int day = unavailable(state, entry.room, entry.departure, last, index)
            if day >= 0
                fail("room unavailable " + state.rooms[entry.room].number.string() + " " + date_text(day))
            else
                price_nights(&state, index, entry.room, entry.departure, last)
                state.bookings[index].departure = last
                state.bookings[index].nights = last - entry.arrival
                emit("EXTEND " + id + " until " + words[2] + " nights " + state.bookings[index].nights.string() + " total " + money(lodging(state, index)))
    elif action == "CHARGE" or action == "PAY"
        int amount = cents(words[2])
        if amount == 0
            fail("invalid amount")
        elif action == "PAY"
            state.bookings[index].deposit += amount
            emit("PAY " + id + " " + money(amount) + " deposit " + money(state.bookings[index].deposit))
        else
            int charge = state.charge_used
            state.charge_used += 1
            state.charges[charge] = Extra(words[3], amount, -1)
            if entry.extra_tail < 0
                state.bookings[index].extra_head = charge
            else
                state.charges[entry.extra_tail].next = charge
            state.bookings[index].extra_tail = charge
            state.bookings[index].extras += amount
            emit("CHARGE " + id + " " + words[3] + " " + money(amount) + " extras " + money(state.bookings[index].extras))
    elif action == "CHECKOUT"
        check_out(&state, index, state.today)
    else
        emit("INVOICE " + id + " " + entry.guest + " room " + state.rooms[entry.room].number.string() + " " + type_name(state.rooms[entry.room].kind) + " " + status_name(entry.status))
        if entry.status == 3 or entry.status == 4
            emit("  " + (if entry.status == 3 then "cancellation" else "noshow") + " fee " + money(entry.fee))
            emit("  total " + money(entry.fee))
            emit("  " + deposit_text(entry, entry.fee))
        else
            for 0 <= int k < entry.nights
                emit("  " + date_weekday(entry.arrival + k) + " room " + state.rooms[state.night_rooms[index][k]].number.string() + " " + money(state.night_rates[index][k]))
            int[] bill = if entry.status == 2 then entry.bill else calculate_bill(state, index)
            emit("  lodging " + money(bill[0]))
            emit("  discount " + money(bill[1]))
            if entry.penalty_day >= 0
                emit("  penalty " + date_weekday(entry.penalty_day) + " " + money(bill[2]))
            int cursor = entry.extra_head
            while cursor >= 0
                Extra charge = state.charges[cursor]
                emit("  extra " + charge.name + " " + money(charge.amount))
                cursor = charge.next
            emit("  tax " + money(bill[4]))
            emit("  total " + money(bill[5]))
            emit("  " + deposit_text(entry, bill[5]))

int command_count = 0
scan(&command_count)
State hotel = State()
for 0 <= int line_number < command_count
    string input_line = ""
    scan(&input_line)
    command(&hotel, input_line)
    process_waitlist(&hotel)
