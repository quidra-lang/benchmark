void emit(string text)
    print(text + NL)

bool has_text(string[] items, string wanted)
    for string item = items[]
        if item == wanted
            return true
    return false

string[] words(string text)
    return [for string word = text.split(" ")[] if word != "" then word]

nat power_two(nat exponent)
    nat result = 1
    for nat i < exponent
        result *= 2
    return result

nat bit_count(nat number)
    nat result = 0
    nat remaining = number
    while remaining > 0
        result += remaining % 2
        remaining /= 2
    return result

nat xor_numbers(nat a, nat b)
    nat first = a
    nat second = b
    nat bit = 1
    nat result = 0
    while first > 0 or second > 0
        if first % 2 != second % 2
            result += bit
        first /= 2
        second /= 2
        bit *= 2
    return result

string row_pattern(nat row, nat size)
    string result = ""
    for nat i < size
        result += if row / power_two(size - i - 1) % 2 == 0 then "0" else "1"
    return result

string swap_pattern(string pattern)
    string result = ""
    for nat i < len(pattern)
        result += if pattern[i] == "0" then "1" else (if pattern[i] == "1" then "0" else "-")
    return result

string omit_zeros(string pattern)
    string result = ""
    for nat i < len(pattern)
        result += if pattern[i] == "0" then "-" else pattern[i]
    return result

nat literal_count(string pattern)
    nat result = 0
    for nat i < len(pattern)
        if pattern[i] != "-"
            result += 1
    return result

string pattern_key(string pattern)
    string result = ""
    for nat i < len(pattern)
        result += if pattern[i] == "1" then "0" else (if pattern[i] == "0" then "1" else "2")
    return result

string[] order_patterns(string[] patterns)
    map.Map<string, string> by_key
    for string pattern = patterns[]
        .by_key.set(pattern_key(pattern), pattern)
    string[] result = []
    for string key = by_key.keys().sorted()[]
        match by_key.get(key)
            string pattern
                result = result.append(pattern)
            none
                void
    return result

bool contains_row(string pattern, string bits)
    for nat i < len(pattern)
        if pattern[i] != "-" and pattern[i] != bits[i]
            return false
    return true

string pattern_text(string pattern, string[] var_list, bool clause = false)
    string[] literals = []
    for nat i < len(pattern)
        if pattern[i] != "-"
            literals = literals.append((if pattern[i] == "0" then "~" else "") + var_list[i])
    if len(literals) == 0
        return if clause then "0" else "1"
    return literals.join(if clause then " | " else " & ")

string products_text(string[] patterns, string[] var_list, bool clauses = false)
    string[] parts = []
    for string pattern = patterns[]
        string part = pattern_text(pattern, var_list, clauses)
        if clauses and len(patterns) >= 2 and literal_count(pattern) >= 2
            part = "(" + part + ")"
        parts = parts.append(part)
    return if len(parts) == 0 then (if clauses then "1" else "0") else parts.join(if clauses then " & " else " | ")

string assignment_text(nat row, string[] var_list)
    string bits = row_pattern(row, len(var_list))
    string[] parts = []
    for nat i < len(var_list)
        parts = parts.append(var_list[i] + "=" + bits[i])
    return "{{" + parts.join(" ") + "}}"

string yes_no(bool flag)
    return if flag then "yes" else "no"

bool valid_name(string text)
    if text == "" or len(text) > 8 or not "abcdefghijklmnopqrstuvwxyz".contains(text[0])
        return false
    for nat i < len(text)
        if not "abcdefghijklmnopqrstuvwxyz0123456789".contains(text[i])
            return false
    return true

bool variable_word(string text)
    return len(text) == 1 and "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(text)

string | none merge_patterns(string a, string b);
string[] tidy_clauses(string[] items);

class FormulaNode(string operation, string text = "", nat left = 0, nat right = 0)
class Forest()
    FormulaNode[] nodes = []
    map.Map<nat, nat> nnf_memo
    map.Map<nat, string[]> clause_memo

    nat .leaf(string text)
        nat result = len(nodes)
        nodes = nodes.append(FormulaNode(if text == "0" or text == "1" then "C" else "V", text))
        return result

    nat .unary(nat child)
        nat result = len(nodes)
        nodes = nodes.append(FormulaNode("~", left = child))
        return result

    nat .binary(string operation, nat a, nat b)
        nat result = len(nodes)
        nodes = nodes.append(FormulaNode(operation, left = a, right = b))
        return result

    nat precedence(nat root)
        string operation = nodes[root].operation
        if operation == "<->"
            return 1
        if operation == "->"
            return 2
        if operation == "|"
            return 3
        if operation == "^"
            return 4
        if operation == "&"
            return 5
        return 6

    string notation(nat root)
        FormulaNode item = nodes[root]
        if item.operation == "C" or item.operation == "V"
            return item.text
        string first = notation(item.left)
        if item.operation == "~"
            return "~" + (if precedence(item.left) < 6 then "(" + first + ")" else first)
        string second = notation(item.right)
        if precedence(item.left) < precedence(root) or (item.operation == "->" and nodes[item.left].operation == "->")
            first = "(" + first + ")"
        if precedence(item.right) < precedence(root) or (item.operation != "->" and nodes[item.right].operation == item.operation)
            second = "(" + second + ")"
        return first + " " + item.operation + " " + second

    string[] variables(nat root)
        FormulaNode item = nodes[root]
        if item.operation == "C"
            return []
        if item.operation == "V"
            return [item.text]
        string[] result = variables(item.left)
        if item.operation != "~"
            for string name = variables(item.right)[]
                if not has_text(result, name)
                    result = result.append(name)
        return result.sorted()

    nat tree_size(nat root)
        FormulaNode item = nodes[root]
        if item.operation == "C" or item.operation == "V"
            return 1
        return 1 + tree_size(item.left) + (if item.operation == "~" then 0 else tree_size(item.right))

    nat tree_depth(nat root)
        FormulaNode item = nodes[root]
        if item.operation == "C" or item.operation == "V"
            return 1
        nat first = tree_depth(item.left)
        nat second = if item.operation == "~" then 0 else tree_depth(item.right)
        return 1 + (if first > second then first else second)

    bool same_tree(nat a, nat b)
        if a == b
            return true
        FormulaNode first = nodes[a]
        FormulaNode second = nodes[b]
        if first.operation != second.operation or first.text != second.text
            return false
        if first.operation == "C" or first.operation == "V"
            return true
        return same_tree(first.left, second.left) and (first.operation == "~" or same_tree(first.right, second.right))

    bool evaluate(nat root, string[] var_list, nat row)
        FormulaNode item = nodes[root]
        if item.operation == "C"
            return item.text == "1"
        if item.operation == "V"
            for nat i < len(var_list)
                if var_list[i] == item.text
                    return row / power_two(len(var_list) - i - 1) % 2 == 1
            return false
        bool a = evaluate(item.left, var_list, row)
        if item.operation == "~"
            return not a
        bool b = evaluate(item.right, var_list, row)
        if item.operation == "&"
            return a and b
        if item.operation == "|"
            return a or b
        if item.operation == "^"
            return a != b
        if item.operation == "->"
            return not a or b
        return a == b

    bool[] truth_values(nat root, string[] var_list)
        return [for nat row < power_two(len(var_list)) then evaluate(root, var_list, row)]

    nat .negated(nat root)
        FormulaNode item = nodes[root]
        if item.operation == "C"
            return .leaf(if item.text == "0" then "1" else "0")
        return if item.operation == "~" then item.left else .unary(root)

    nat .combine(string operation, nat a, nat b)
        FormulaNode first = nodes[a]
        FormulaNode second = nodes[b]
        bool a0 = first.operation == "C" and first.text == "0"
        bool a1 = first.operation == "C" and first.text == "1"
        bool b0 = second.operation == "C" and second.text == "0"
        bool b1 = second.operation == "C" and second.text == "1"
        bool equal = same_tree(a, b)
        bool complementary = (first.operation == "~" and same_tree(first.left, b)) or (second.operation == "~" and same_tree(a, second.left))
        if operation == "&"
            if a0 or b0
                return .leaf("0")
            if a1
                return b
            if b1 or equal
                return a
            if complementary
                return .leaf("0")
        elif operation == "|"
            if a1 or b1
                return .leaf("1")
            if a0
                return b
            if b0 or equal
                return a
            if complementary
                return .leaf("1")
        elif operation == "^"
            if a0
                return b
            if b0
                return a
            if a1
                return .negated(b)
            if b1
                return .negated(a)
            if equal or complementary
                return .leaf(if equal then "0" else "1")
        elif operation == "->"
            if a0 or b1
                return .leaf("1")
            if a1
                return b
            if b0
                return .negated(a)
            if equal
                return .leaf("1")
            if complementary
                return b
        else
            if a1
                return b
            if b1
                return a
            if a0
                return .negated(b)
            if b0
                return .negated(a)
            if equal or complementary
                return .leaf(if equal then "1" else "0")
        return .binary(operation, a, b)

    nat .simplify(nat root, map.Map<string, bool> assigned)
        FormulaNode item = nodes[root]
        if item.operation == "V"
            match assigned.get(item.text)
                bool value
                    return .leaf(if value then "1" else "0")
                none
                    return root
        if item.operation == "C"
            return root
        nat a = .simplify(item.left, assigned)
        if item.operation == "~"
            return .negated(a)
        nat b = .simplify(item.right, assigned)
        return .combine(item.operation, a, b)

    nat .nnf(nat root, bool positive = true)
        nat key = root * 2 + (if positive then 1 else 0)
        match nnf_memo.get(key)
            nat saved
                return saved
            none
                void
        FormulaNode item = nodes[root]
        nat result = root
        if item.operation == "V"
            if not positive
                result = .unary(root)
        elif item.operation == "C"
            if not positive
                result = .leaf(if item.text == "0" then "1" else "0")
        elif item.operation == "~"
            result = .nnf(item.left, not positive)
        elif item.operation == "&" or item.operation == "|"
            string operation = item.operation
            if not positive
                operation = if operation == "&" then "|" else "&"
            nat a = .nnf(item.left, positive)
            nat b = .nnf(item.right, positive)
            result = .binary(operation, a, b)
        elif item.operation == "->"
            nat a = .nnf(item.left, not positive)
            nat b = .nnf(item.right, positive)
            result = .binary(if positive then "|" else "&", a, b)
        else
            nat a = .nnf(item.left)
            nat na = .nnf(item.left, false)
            nat b = .nnf(item.right)
            nat nb = .nnf(item.right, false)
            bool same = (item.operation == "<->") == positive
            nat first = .binary("&", a, if same then b else nb)
            nat second = .binary("&", na, if same then nb else b)
            result = .binary("|", first, second)
        .nnf_memo.set(key, result)
        return result

    nat .dual(nat root)
        FormulaNode item = nodes[root]
        if item.operation == "V"
            return root
        if item.operation == "C"
            return .leaf(if item.text == "0" then "1" else "0")
        nat a = .dual(item.left)
        if item.operation == "~"
            return .unary(a)
        nat b = .dual(item.right)
        if item.operation == "->"
            return .binary("&", .unary(a), b)
        string operation = if item.operation == "&" then "|" else (if item.operation == "|" then "&" else (if item.operation == "^" then "<->" else "^"))
        return .binary(operation, a, b)

    void .reset_clauses()
        map.Map<nat, string[]> empty_cache
        clause_memo = empty_cache

    string[] .clauses_of(nat root, string[] var_list)
        match clause_memo.get(root)
            string[] saved
                return saved
            none
                void
        FormulaNode item = nodes[root]
        string[] result = []
        if item.operation == "C"
            if item.text == "0"
                result = [string.repeat("-", len(var_list))]
        elif item.operation == "V" or item.operation == "~"
            string name = if item.operation == "V" then item.text else nodes[item.left].text
            string pattern = ""
            for string variable = var_list[]
                pattern += if variable == name then (if item.operation == "V" then "1" else "0") else "-"
            result = [pattern]
        else
            string[] a = .clauses_of(item.left, var_list)
            string[] b = .clauses_of(item.right, var_list)
            if item.operation == "&"
                result = tidy_clauses(a.concat(b))
            else
                for string first = a[]
                    for string second = b[]
                        match merge_patterns(first, second)
                            string merged
                                result = result.append(merged)
                            none
                                void
                result = tidy_clauses(result)
        .clause_memo.set(root, result)
        return result

string | none merge_patterns(string a, string b)
    string result = ""
    for nat i < len(a)
        if a[i] != "-" and b[i] != "-" and a[i] != b[i]
            return none
        result += if a[i] == "-" then b[i] else a[i]
    return result

bool proper_contains(string a, string b)
    if a == b
        return false
    for nat i < len(a)
        if b[i] != "-" and a[i] != b[i]
            return false
    return true

string[] tidy_clauses(string[] items)
    map.Map<string, bool> distinct
    for string item = items[]
        .distinct.set(item, true)
    string[] patterns = distinct.keys()
    string[] result = []
    for string pattern = patterns[]
        bool keep = true
        for string other = patterns[]
            if proper_contains(pattern, other)
                keep = false
                break
        if keep
            result = result.append(pattern)
    return result

class Token(string text, nat position)
Token[] | error tokenize(string text, nat start)
    Token[] tokens = []
    nat cursor = 0
    while cursor < len(text)
        string c = text[cursor]
        if c == " "
            cursor += 1
            continue
        nat finish = cursor + 1
        if cursor + 3 <= len(text) and text[cursor:<cursor + 3] == "<->"
            finish = cursor + 3
        elif cursor + 2 <= len(text) and text[cursor:<cursor + 2] == "->"
            finish = cursor + 2
        elif "abcdefghijklmnopqrstuvwxyz".contains(c)
            while finish < len(text) and "abcdefghijklmnopqrstuvwxyz0123456789".contains(text[finish])
                finish += 1
        elif not "ABCDEFGHIJKLMNOPQRSTUVWXYZ01~&^|()".contains(c)
            return error("invalid character '" + c + "' at {start + cursor}")
        tokens = tokens.append(Token(text[cursor:<finish], start + cursor))
        cursor = finish
    return tokens.append(Token("", start + len(text)))

class Reader(Token[] tokens, map.Map<string, nat> definitions)
    nat cursor = 0

    Token peek()
        return tokens[cursor]

    error problem()
        Token token = peek()
        return if token.text == "" then error("unexpected end of formula at {token.position}") else error("unexpected '" + token.text + "' at {token.position}")

    nat | error .atom(Forest &tree)
        Token token = peek()
        if token.text == "("
            cursor += 1
            nat result = try .read_level(&tree, 0)
            if peek().text != ")"
                return problem()
            cursor += 1
            return result
        if token.text == "0" or token.text == "1" or variable_word(token.text)
            cursor += 1
            return .tree.leaf(token.text)
        if token.text != "" and "abcdefghijklmnopqrstuvwxyz".contains(token.text[0])
            match definitions.get(token.text)
                nat found
                    cursor += 1
                    return found
                none
                    return error("undefined name '" + token.text + "' at {token.position}")
        return problem()

    nat | error .read_level(Forest &tree, nat level)
        if level == 5
            if peek().text == "~"
                cursor += 1
                nat child = try .read_level(&tree, 5)
                return .tree.unary(child)
            return .atom(&tree)
        string[] operations = ["<->", "->", "|", "^", "&"]
        string operation = operations[level]
        nat result = try .read_level(&tree, level + 1)
        while peek().text == operation
            cursor += 1
            nat other = try .read_level(&tree, if level == 1 then level else level + 1)
            result = .tree.binary(operation, result, other)
            if level == 1
                break
        return result

    nat | error .parse(Forest &tree)
        nat result = try .read_level(&tree, 0)
        if peek().text != ""
            return problem()
        return result

bool[] anf_coefficients(bool[] values, nat size)
    bool[] result = values
    for nat i < size
        nat bit = power_two(i)
        for nat row < len(result)
            if row / bit % 2 == 1
                result[row] = result[row] != result[row - bit]
    return result

class BddNode(nat level, nat low, nat high)
class Diagram()
    BddNode[] nodes = []

    nat .build(bool[] values, nat level = 0)
        if len(values) == 1
            return if values[0] then 1 else 0
        nat half = len(values) / 2
        nat low = .build(values[:<half], level + 1)
        nat high = .build(values[half:], level + 1)
        if low == high
            return low
        for nat i < len(nodes)
            if nodes[i].level == level and nodes[i].low == low and nodes[i].high == high
                return i + 2
        nodes = nodes.append(BddNode(level, low, high))
        return len(nodes) + 1

class Stage(nat implicants, nat primes)
class Minimum(Stage[] stages, string[] targets, string[] essential, string[] cover)
Minimum minimize(nat[] on, nat[] dc, nat size, bool swapped = false)
    map.Map<string, bool> initial
    for nat row = on.concat(dc)[]
        .initial.set(row_pattern(row, size), true)
    string[] stage = initial.keys()
    Stage[] statistics = []
    string[] primes = []
    while true
        map.Map<string, bool> merged
        map.Map<string, bool> combined
        map.Map<string, bool> current
        for string pattern = stage[]
            .current.set(pattern, true)
        for string pattern = stage[]
            for nat i < size
                if pattern[i] == "-"
                    continue
                string partner = pattern[:<i] + (if pattern[i] == "0" then "1" else "0") + pattern[i + 1:]
                if current.has(partner)
                    .combined.set(pattern, true)
                    .merged.set(pattern[:<i] + "-" + pattern[i + 1:], true)
        nat count = 0
        for string pattern = stage[]
            if not combined.has(pattern)
                primes = primes.append(pattern)
                count += 1
        statistics = statistics.append(Stage(len(stage), count))
        if merged.size() == 0
            break
        stage = merged.keys()
    string[] targets = []
    nat[][] coverage = []
    for string pattern = order_patterns(primes)[]
        nat[] covered = []
        for nat i < len(on)
            if contains_row(pattern, row_pattern(on[i], size))
                covered = covered.append(i)
        if len(covered) > 0
            targets = targets.append(pattern)
            coverage = coverage.append(covered)
    bool[] essential_flags = [for nat i < len(targets) then false]
    for nat i < len(on)
        nat count = 0
        nat chosen = 0
        for nat j < len(targets)
            for nat covered = coverage[j][]
                if covered == i
                    count += 1
                    chosen = j
        if count == 1
            essential_flags[chosen] = true
    string[] essential = []
    nat[] optional = []
    bool[] covered_initial = [for nat i < len(on) then false]
    for nat j < len(targets)
        if essential_flags[j]
            essential = essential.append(targets[j])
            for nat covered = coverage[j][]
                covered_initial[covered] = true
        else
            optional = optional.append(j)
    string[] best = []
    string[] best_keys = []
    nat best_literals = 0
    bool found = false
    for nat mask < power_two(len(optional))
        string[] candidate = essential
        bool[] covered = covered_initial
        for nat k < len(optional)
            if mask / power_two(k) % 2 == 1
                nat j = optional[k]
                candidate = candidate.append(targets[j])
                for nat row = coverage[j][]
                    covered[row] = true
        bool complete = true
        for bool present = covered[]
            if not present
                complete = false
        if not complete
            continue
        nat count = 0
        for string pattern = candidate[]
            count += literal_count(pattern)
        string[] shown = order_patterns([for string pattern = candidate[] then (if swapped then swap_pattern(pattern) else pattern)])
        string[] keys = [for string pattern = shown[] then pattern_key(pattern)]
        bool earlier = false
        if found and len(candidate) == len(best) and count == best_literals
            for nat i < len(keys)
                if keys[i] != best_keys[i]
                    earlier = keys[i] < best_keys[i]
                    break
        if not found or len(candidate) < len(best) or (len(candidate) == len(best) and (count < best_literals or (count == best_literals and earlier)))
            found = true
            best = order_patterns(candidate)
            best_keys = keys
            best_literals = count
    return Minimum(statistics, targets, essential, best)

class Workbench()
    Forest forest = Forest()
    map.Map<string, nat> definitions

    nat | error .parse_formula(string text, nat start)
        Token[] tokens = try tokenize(text, start)
        Reader reader = Reader(tokens, definitions)
        return .reader.parse(&forest)

    string[] .assign_definition(string name, nat root)
        string action = if definitions.has(name) then "redefined " else "defined "
        .definitions.set(name, root)
        return [action + name + " = " + forest.notation(root)]

    string[] | error .run_command(string line)
        string command = line
        string argument = ""
        bool has_argument = false
        match line.find(" ")
            nat position
                command = line[:<position]
                argument = line[position + 1:]
                has_argument = true
            none
                void
        string[] commands = "DEF DEFSUM DEL LIST PRINT TABLE MINTERMS MAXTERMS DNF CNF NNF DUAL ANF SIMPLIFY RESTRICT COFACTOR MINIMIZE MINDC MINPOS KMAP SAT TAUT COUNT EQUIV IMPLIES PROPS BDD CLAUSES DP".split(" ")
        if not has_text(commands, command)
            return error("unknown command " + command)
        if command == "LIST"
            if has_argument
                return error("unexpected argument")
            string[] output = ["names: {definitions.size()}"]
            for string name = definitions.keys().sorted()[]
                match definitions.get(name)
                    nat root
                        output = output.append(name + " = " + forest.notation(root))
                    none
                        void
            return output
        if not has_argument
            return error("missing argument")
        if command == "DEL"
            if not valid_name(argument)
                return error("invalid name '" + argument + "'")
            if not definitions.has(argument)
                return error("undefined name '" + argument + "'")
            .definitions.remove(argument)
            return ["deleted " + argument]
        if command == "DEF"
            nat separator = 0
            match argument.find(" ")
                nat position
                    separator = position
                none
                    return error("missing argument")
            string name = argument[:<separator]
            if not valid_name(name)
                return error("invalid name '" + name + "'")
            nat root = try .parse_formula(argument[separator + 1:], len(name) + 6)
            return .assign_definition(name, root)
        if command == "DEFSUM"
            nat separator = 0
            match argument.find(";")
                nat position
                    separator = position
                none
                    return error("missing ';'")
            string[] parts = words(argument[:<separator])
            if len(parts) == 0
                return error("missing argument")
            string name = parts[0]
            if not valid_name(name)
                return error("invalid name '" + name + "'")
            string[] var_list = parts[1:]
            bool valid = len(var_list) > 0
            for nat i < len(var_list)
                if not variable_word(var_list[i]) or (i > 0 and var_list[i - 1] >= var_list[i])
                    valid = false
            if not valid
                return error("bad variable list")
            if len(var_list) >= 9
                return error("too many variables: {len(var_list)}")
            nat[] rows = []
            for string word = words(argument[separator + 1:])[]
                bool numeric = true
                for nat i < len(word)
                    if not "0123456789".contains(word[i])
                        numeric = false
                if not numeric or (len(word) > 1 and word[0] == "0")
                    return error("bad minterm '" + word + "'")
                nat row = nat.parse(word)
                if row >= power_two(len(var_list)) or (len(rows) > 0 and row <= rows[len(rows) - 1])
                    return error("bad minterm '" + word + "'")
                rows = rows.append(row)
            nat[] terms = []
            for nat row = rows[]
                string bits = row_pattern(row, len(var_list))
                nat term = 0
                for nat i < len(var_list)
                    nat factor = .forest.leaf(var_list[i])
                    if bits[i] == "0"
                        factor = .forest.unary(factor)
                    term = if i == 0 then factor else .forest.binary("&", term, factor)
                terms = terms.append(term)
            nat root = if len(terms) == 0 then .forest.leaf("0") else terms[0]
            for 1 <= nat i < len(terms)
                root = .forest.binary("|", root, terms[i])
            return .assign_definition(name, root)
        bool split_command = has_text(["RESTRICT", "COFACTOR", "MINDC", "EQUIV", "IMPLIES"], command)
        string front = argument
        string back = ""
        nat second_start = 0
        if split_command
            match argument.find(";")
                nat position
                    front = argument[:<position]
                    back = argument[position + 1:]
                    second_start = len(command) + 3 + position
                none
                    return error("missing ';'")
        nat root = try .parse_formula(front, len(command) + 2)
        nat other = root
        bool pair_command = has_text(["MINDC", "EQUIV", "IMPLIES"], command)
        if pair_command
            other = try .parse_formula(back, second_start)
        map.Map<string, bool> assigned
        if command == "RESTRICT"
            string[] assignments = words(back)
            if len(assignments) == 0
                return error("missing assignment")
            for string word = assignments[]
                if len(word) != 3 or not variable_word(word[0]) or word[1] != "=" or (word[2] != "0" and word[2] != "1")
                    return error("bad assignment '" + word + "'")
                if assigned.has(word[0])
                    return error("duplicate variable " + word[0])
                .assigned.set(word[0], word[2] == "1")
            nat result = .forest.simplify(root, assigned)
            return ["restricted: " + forest.notation(result)]
        if command == "COFACTOR"
            string[] parts = words(back)
            if len(parts) != 1 or not variable_word(parts[0])
                return error("bad variable")
            string name = parts[0]
            .assigned.set(name, true)
            nat high = .forest.simplify(root, assigned)
            .assigned.set(name, false)
            nat low = .forest.simplify(root, assigned)
            nat difference = .forest.combine("^", high, low)
            return ["cofactor " + name + "=1: " + forest.notation(high), "cofactor " + name + "=0: " + forest.notation(low), "difference: " + forest.notation(difference)]
        string[] var_list = forest.variables(root)
        if pair_command
            for string name = forest.variables(other)[]
                if not has_text(var_list, name)
                    var_list = var_list.append(name)
            var_list = var_list.sorted()
        string[] table_commands = "TABLE MINTERMS MAXTERMS DNF CNF ANF SAT TAUT COUNT EQUIV IMPLIES PROPS KMAP BDD MINIMIZE MINDC MINPOS".split(" ")
        if has_text(table_commands, command) and len(var_list) >= 9
            return error("too many variables: {len(var_list)}")
        if command == "PRINT"
            return ["formula: " + forest.notation(root), "variables: " + (if len(var_list) == 0 then "none" else var_list.join(" ")), "size {forest.tree_size(root)} depth {forest.tree_depth(root)}"]
        if command == "NNF"
            nat result = .forest.nnf(root)
            return ["nnf: " + forest.notation(result)]
        if command == "DUAL"
            nat result = .forest.dual(root)
            return ["dual: " + forest.notation(result)]
        if command == "SIMPLIFY"
            nat result = .forest.simplify(root, assigned)
            return ["simplified: " + forest.notation(result)]
        if command == "CLAUSES" or command == "DP"
            .forest.reset_clauses()
            nat normal = .forest.nnf(root)
            string[] clauses = .forest.clauses_of(normal, var_list)
            if command == "CLAUSES"
                return ["clauses: " + products_text(order_patterns(clauses), var_list, true)]
            string[] output = ["start: clauses {len(clauses)}"]
            string empty_clause = string.repeat("-", len(var_list))
            for nat i < len(var_list)
                if len(clauses) == 0 or has_text(clauses, empty_clause)
                    break
                string[] positive = [for string clause = clauses[] if clause[i] == "1" then clause]
                string[] negative = [for string clause = clauses[] if clause[i] == "0" then clause]
                string[] kept = [for string clause = clauses[] if clause[i] == "-" then clause]
                map.Map<string, bool> resolvents
                for string a = positive[]
                    for string b = negative[]
                        string first = a[:<i] + "-" + a[i + 1:]
                        string second = b[:<i] + "-" + b[i + 1:]
                        match merge_patterns(first, second)
                            string merged
                                .resolvents.set(merged, true)
                            none
                                void
                clauses = tidy_clauses(kept.concat(resolvents.keys()))
                output = output.append("eliminate " + var_list[i] + ": resolvents {resolvents.size()} clauses {len(clauses)}")
            return output.append(if has_text(clauses, empty_clause) then "result: unsatisfiable" else "result: satisfiable")
        bool[] values = forest.truth_values(root, var_list)
        bool[] others = if pair_command then forest.truth_values(other, var_list) else []
        nat[] on = [for nat row < len(values) if values[row] then row]
        nat[] off = [for nat row < len(values) if not values[row] then row]
        if command == "TABLE"
            string[] output = [(if len(var_list) == 0 then "" else var_list.join(" ") + " ") + "| F"]
            for nat row < len(values)
                string bits = row_pattern(row, len(var_list))
                string[] cells = [for nat i < len(bits) then bits[i]]
                output = output.append((if len(cells) == 0 then "" else cells.join(" ") + " ") + "| " + (if values[row] then "1" else "0"))
            return output
        if command == "MINTERMS" or command == "MAXTERMS"
            nat[] rows = if command == "MINTERMS" then on else off
            string[] numbers = [for nat row = rows[] then row.string()]
            return [(if command == "MINTERMS" then "minterms: " else "maxterms: ") + (if len(numbers) == 0 then "none" else numbers.join(" "))]
        if command == "DNF" or command == "CNF"
            bool clause = command == "CNF"
            nat[] rows = if clause then off else on
            string[] patterns = [for nat row = rows[] then (if clause then swap_pattern(row_pattern(row, len(var_list))) else row_pattern(row, len(var_list)))]
            return [(if clause then "cnf: " else "dnf: ") + products_text(patterns, var_list, clause)]
        if command == "SAT"
            return [if len(on) == 0 then "unsatisfiable" else "satisfiable: " + assignment_text(on[0], var_list)]
        if command == "TAUT"
            return [if len(off) == 0 then "tautology" else "not a tautology: " + assignment_text(off[0], var_list)]
        if command == "COUNT"
            return ["models: {len(on)} of {len(values)}"]
        if command == "EQUIV" or command == "IMPLIES"
            for nat row < len(values)
                if command == "EQUIV" and values[row] != others[row]
                    return ["not equivalent: " + assignment_text(row, var_list) + " f=" + (if values[row] then "1" else "0") + " g=" + (if others[row] then "1" else "0")]
                if command == "IMPLIES" and values[row] and not others[row]
                    return ["does not imply: " + assignment_text(row, var_list)]
            return [if command == "EQUIV" then "equivalent" else "implies"]
        if command == "KMAP"
            if len(var_list) < 2 or len(var_list) > 4
                return error("kmap needs 2 to 4 variables")
            nat p = len(var_list) / 2
            nat q = len(var_list) - p
            string label = var_list[:<p].join("") + "\" + var_list[p:].join("")
            string[] columns = [for nat i < power_two(q) then row_pattern(xor_numbers(i, i / 2), q)]
            string[] output = [label + " " + columns.join(" ")]
            for nat i < power_two(p)
                nat gray = xor_numbers(i, i / 2)
                string row = row_pattern(gray, p) + string.repeat(" ", len(label) - p)
                for nat j < len(columns)
                    nat column = xor_numbers(j, j / 2)
                    row += string.repeat(" ", q) + (if values[gray * power_two(q) + column] then "1" else "0")
                output = output.append(row)
            return output
        if command == "BDD"
            Diagram diagram = Diagram()
            nat result = .diagram.build(values)
            nat[] paths = [0, 1]
            string[] output = ["nodes: {len(diagram.nodes)}"]
            for nat i < len(diagram.nodes)
                BddNode node = diagram.nodes[i]
                paths = paths.append(paths[node.low] + paths[node.high])
                output = output.append("{i + 2} = ite(" + var_list[node.level] + ", {node.high}, {node.low})")
            return output.concat(["root: {result}", "paths: {paths[result]}"])
        bool[] coefficients = anf_coefficients(values, len(var_list))
        if command == "ANF"
            string[] patterns = []
            for nat degree <= len(var_list)
                string[] selected = []
                for nat row < len(coefficients)
                    if coefficients[row] and bit_count(row) == degree
                        selected = selected.append(omit_zeros(row_pattern(row, len(var_list))))
                patterns = patterns.concat(order_patterns(selected))
            string[] terms = [for string pattern = patterns[] then pattern_text(pattern, var_list)]
            return ["anf: " + (if len(terms) == 0 then "0" else terms.join(" ^ "))]
        if command == "PROPS"
            string[] depends = []
            bool monotone = true
            for nat i < len(var_list)
                nat bit = power_two(len(var_list) - i - 1)
                bool changes = false
                for nat row < len(values)
                    nat flipped = if row / bit % 2 == 0 then row + bit else row - bit
                    if values[row] != values[flipped]
                        changes = true
                    if row / bit % 2 == 0 and values[row] and not values[row + bit]
                        monotone = false
                if changes
                    depends = depends.append(var_list[i])
            bool self_dual = true
            bool linear = true
            bool symmetric = true
            for nat row < len(values)
                if values[row] == values[len(values) - row - 1]
                    self_dual = false
                if coefficients[row] and bit_count(row) > 1
                    linear = false
                if values[row] != values[power_two(bit_count(row)) - 1]
                    symmetric = false
            return ["depends: " + (if len(depends) == 0 then "none" else depends.join(" ")), "zero-preserving: " + yes_no(not values[0]), "one-preserving: " + yes_no(values[len(values) - 1]), "self-dual: " + yes_no(self_dual), "monotone: " + yes_no(monotone), "linear: " + yes_no(linear), "symmetric: " + yes_no(symmetric)]
        nat[] dc = []
        if command == "MINDC"
            dc = [for nat row < len(others) if others[row] then row]
            on = [for nat row = on[] if not others[row] then row]
        bool product = command == "MINPOS"
        Minimum result = minimize(if product then off else on, dc, len(var_list), product)
        string[] shown = if product then order_patterns([for string pattern = result.cover[] then swap_pattern(pattern)]) else result.cover
        nat total_literals = 0
        for string pattern = result.cover[]
            total_literals += literal_count(pattern)
        if product
            return ["minimal: " + products_text(shown, var_list, true), "clauses {len(result.cover)} literals {total_literals}"]
        string[] output = []
        for nat i < len(result.stages)
            output = output.append("stage {i}: implicants {result.stages[i].implicants} primes {result.stages[i].primes}")
        string[] primes = [for string pattern = result.targets[] then pattern_text(pattern, var_list)]
        string[] essential = [for string pattern = result.essential[] then pattern_text(pattern, var_list)]
        return output.concat(["primes: " + (if len(primes) == 0 then "none" else primes.join(", ")), "essential: " + (if len(essential) == 0 then "none" else essential.join(", ")), "minimal: " + products_text(shown, var_list), "terms {len(result.cover)} literals {total_literals}"])

void read_commands()
    string line = ""
    scan(&line)
    nat count = nat.parse(line)
    Workbench workbench = Workbench()
    for nat i < count
        scan(&line)
        match .workbench.run_command(line)
            string[] output
                for string text = output[]
                    emit(text)
            error failure
                emit("error: " + failure.message)

read_commands()
