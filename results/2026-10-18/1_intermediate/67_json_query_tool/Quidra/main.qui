bool one_of(string[] words, string word)
    for string item = words[]
        if item == word
            return true
    return false

bool all_chars(string text, string alphabet)
    for nat i < len(text)
        if not alphabet.contains(text[i])
            return false
    return true

bool identifier(string text)
    return text != "" and all_chars(text[0], "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_") and all_chars(text, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789")

bool integer_word(string text)
    if text == "0"
        return true
    string digits = if text.starts_with("-") then text[1:] else text
    return len(digits) >= 1 and len(digits) <= 9 and digits[0] != "0" and all_chars(digits, "0123456789")

nat find_at(string text, string needle)
    match text.find(needle)
        nat at
            return at
        none
            return len(text)

int hex_value(string text)
    if len(text) != 4
        return -1
    int result = 0
    for nat i < 4
        string ch = text[i]
        nat at = find_at("0123456789abcdef", ch)
        if at == 16
            at = find_at("0123456789ABCDEF", ch)
        if at == 16
            return -1
        result = result * 16 + int(at)
    return result

string ascii(nat code)
    return string.from_utf8(bin([nat8(code)]))

string quote_text(string text, string mark = DQ)
    string result = mark
    for int code = text.codepoints()[]
        string ch = ascii(nat(code))
        if ch == mark or ch == "\"
            result += "\" + ch
        elif code == 8
            result += "\b"
        elif code == 12
            result += "\f"
        elif code == 10
            result += "\n"
        elif code == 13
            result += "\r"
        elif code == 9
            result += "\t"
        elif code < 32 or code == 127
            result += "\u00" + "0123456789abcdef"[code / 16] + "0123456789abcdef"[code % 16]
        else
            result += ch
    return result + mark

class Value(string kind, string text = "", int number = 0)
    string[] keys = []
    nat[] items = []
class Step(bool key_step, string key, nat position)
class Match(nat node, Step[] steps)
class Segment(string kind, string key = "", int index = 0)
    int | none start = none
    int | none stop = none
    bool descendant = false

class Tree(Value[] nodes, nat root)
    nat .add(Value value)
        nat index = len(nodes)
        nodes = nodes.append(value)
        return index

    int key_index(nat index, string key)
        for string item = nodes[index].keys[nat i]
            if item == key
                return int(i)
        return -1

    nat count_nodes(nat index)
        nat total = 1
        for nat item = nodes[index].items[]
            total += count_nodes(item)
        return total

    nat depth(nat index)
        nat longest = 0
        for nat item = nodes[index].items[]
            nat child_depth = depth(item)
            if child_depth > longest
                longest = child_depth
        return longest + 1

    string compact(nat index)
        Value value = nodes[index]
        if value.kind == "string"
            return quote_text(value.text)
        if value.kind == "number"
            return "{value.number}"
        if value.kind == "null" or value.kind == "boolean"
            return value.text
        string[] parts = []
        for nat item = value.items[nat i]
            parts = parts.append((if value.kind == "object" then quote_text(value.keys[i]) + ":" else "") + compact(item))
        return (if value.kind == "object" then "{{" else "[") + parts.join(",") + (if value.kind == "object" then "}}" else "]")

    string pretty(nat index, string indent = "")
        Value value = nodes[index]
        if len(value.items) == 0
            return compact(index)
        string inner = indent + "  "
        string[] parts = []
        for nat item = value.items[nat i]
            parts = parts.append(inner + (if value.kind == "object" then quote_text(value.keys[i]) + ": " else "") + pretty(item, inner))
        return (if value.kind == "object" then "{{" else "[") + NL + parts.join("," + NL) + NL + indent + (if value.kind == "object" then "}}" else "]")

    Match child(Match parent, nat position)
        Value value = nodes[parent.node]
        auto step = Step(value.kind == "object", if value.kind == "object" then value.keys[position] else "", position)
        return Match(value.items[position], parent.steps.append(step))

    Match[] preorder(Match parent)
        Match[] result = [parent]
        for nat i < len(nodes[parent.node].items)
            result = result.concat(preorder(child(parent, i)))
        return result

    int child_position(nat index, Segment selector)
        Value value = nodes[index]
        if selector.kind == "key"
            return if value.kind == "object" then key_index(index, selector.key) else -1
        if value.kind != "array"
            return -1
        int j = if selector.index < 0 then int(len(value.items)) + selector.index else selector.index
        return if j >= 0 and j < int(len(value.items)) then j else -1

    nat bound(int | none value, nat size, nat fallback)
        match value
            int number
                int j = if number < 0 then int(size) + number else number
                return if j < 0 then 0 else if j > int(size) then size else nat(j)
            none
                return fallback

    Match[] select(Segment selector, Match[] matches)
        Match[] result = []
        for Match parent = matches[]
            Match[] sources = if selector.descendant then preorder(parent) else [parent]
            for Match source = sources[]
                Value value = nodes[source.node]
                if selector.kind == "all"
                    for nat i < len(value.items)
                        result = result.append(child(source, i))
                elif selector.kind == "slice"
                    if value.kind == "array"
                        nat a = bound(selector.start, len(value.items), 0)
                        nat b = bound(selector.stop, len(value.items), len(value.items))
                        for a <= nat i < b
                            result = result.append(child(source, i))
                else
                    int position = child_position(source.node, selector)
                    if position >= 0
                        result = result.append(child(source, nat(position)))
        return result

    Match[] evaluate(Segment[] selectors)
        Match[] result = [Match(root, [])]
        for Segment selector = selectors[]
            result = select(selector, result)
        return result

    int field_value(nat index, Segment[] selectors)
        nat current = index
        for Segment selector = selectors[]
            int position = child_position(current, selector)
            if position < 0
                return -1
            current = nodes[current].items[position]
        return int(current)

    bool equal_value(nat a, Tree other, nat b)
        Value first = nodes[a]
        Value second = other.nodes[b]
        if first.kind != second.kind
            return false
        if first.kind == "object" or first.kind == "array"
            if len(first.items) != len(second.items)
                return false
            for nat item = first.items[nat i]
                int j = if first.kind == "object" then other.key_index(b, first.keys[i]) else int(i)
                if j < 0 or not equal_value(item, other, second.items[j])
                    return false
            return true
        return first.text == second.text and first.number == second.number

    nat resolve(Step[] steps)
        nat current = root
        for Step step = steps[]
            current = nodes[current].items[step.position]
        return current

    nat .copy_from(Tree other, nat index)
        Value value = other.nodes[index]
        nat[] children = []
        for nat item = value.items[]
            children = children.append(.copy_from(other, item))
        value.items = children
        return .add(value)

    void .merge_into(nat index, Tree other, nat patch)
        for nat item = other.nodes[patch].items[nat i]
            string key = other.nodes[patch].keys[i]
            int position = key_index(index, key)
            if position >= 0 and nodes[nodes[index].items[position]].kind == "object" and other.nodes[item].kind == "object"
                .merge_into(nodes[index].items[position], other, item)
            else
                nat copied = .copy_from(other, item)
                if position < 0
                    nodes[index].keys = nodes[index].keys.append(key)
                    nodes[index].items = nodes[index].items.append(copied)
                else
                    nodes[index].items[position] = copied

class JsonReader(string text)
    nat position = 0
    Tree tree = Tree([], 0)
    string reason = ""
    nat error_at = 0

    string current()
        return if position < len(text) then text[position] else ""

    error .bad(string message, nat at)
        reason = message
        error_at = at
        return error(message)

    void .skip()
        while current() == " " or current() == NL
            position += 1

    void | error .expect(string ch, string message)
        if current() == ""
            return .bad("unexpected end of input", position)
        if current() != ch
            return .bad(message, position)

    string | error .read_string()
        position += 1
        string result = ""
        while true
            string ch = current()
            if ch == "" or ch == NL
                return .bad("unterminated string", position)
            position += 1
            if ch == DQ
                return result
            if ch != "\"
                result += ch
                continue
            nat start = position - 1
            string escaped = current()
            if escaped == "" or escaped == NL
                return .bad("unterminated string", position)
            if escaped == "u"
                int code = if position + 4 < len(text) then hex_value(text[position + 1:<position + 5]) else -1
                if code < 0
                    return .bad("bad unicode escape", start)
                if code > 127
                    return .bad("non-ascii escape", start)
                result += ascii(nat(code))
                position += 5
            else
                nat at = find_at(DQ + "\/bfnrt", escaped)
                if at == 8
                    return .bad("invalid escape '\{escaped}'", start)
                result += [DQ, "\", "/", ascii(8), ascii(12), NL, ascii(13), ascii(9)][at]
                position += 1

    nat | error .read_number()
        nat start = position
        bool negative = current() == "-"
        if negative
            position += 1
        nat first = position
        while current() != "" and "0123456789".contains(current())
            position += 1
        string digits = text[first:<position]
        if digits == ""
            return .bad("invalid number", start)
        if len(digits) >= 2 and digits[0] == "0"
            return .bad("leading zero", first)
        if current() == "."
            return .bad("fraction not allowed", position)
        if current() == "e" or current() == "E"
            return .bad("exponent not allowed", position)
        if len(digits) >= 10
            return .bad("number out of range", start)
        return .tree.add(Value("number", "", int.parse(digits) * (if negative then -1 else 1)))

    nat | error .read_value()
        .skip()
        string ch = current()
        if ch == ""
            return .bad("unexpected end of input", position)
        if ch == DQ
            string result = try .read_string()
            return .tree.add(Value("string", result))
        if ch == "-" or "0123456789".contains(ch)
            return .read_number()
        if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(ch)
            nat start = position
            while current() != "" and "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(current())
                position += 1
            string word = text[start:<position]
            if word == "null" or word == "true" or word == "false"
                return .tree.add(Value(if word == "null" then "null" else "boolean", word))
            return .bad("invalid literal '{word}'", start)
        if ch != "{{" and ch != "["
            return .bad("unexpected character '{ch}'", position)
        bool object = ch == "{{"
        string closing = if object then "}}" else "]"
        auto value = Value(if object then "object" else "array")
        position += 1
        .skip()
        if current() == closing
            position += 1
            return .tree.add(value)
        while true
            if object
                .skip()
                try .expect(DQ, "expected key")
                nat start = position
                string key = try .read_string()
                if one_of(value.keys, key)
                    return .bad("duplicate key " + quote_text(key), start)
                .skip()
                try .expect(":", "expected ':'")
                position += 1
                value.keys = value.keys.append(key)
            nat item = try .read_value()
            value.items = value.items.append(item)
            .skip()
            if current() == closing
                position += 1
                return .tree.add(value)
            try .expect(",", if object then "expected ',' or '}}'" else "expected ',' or ']'")
            position += 1
            .skip()
            if current() == closing
                return .bad("trailing comma", position)

    Tree | error .parse()
        nat index = try .read_value()
        .skip()
        if position < len(text)
            return .bad("trailing characters", position)
        tree.root = index
        return tree

class PathReader(string text, string message)
    nat position = 0

    string current()
        return if position < len(text) then text[position] else ""

    bool .accept(string ch)
        if current() != ch
            return false
        position += 1
        return true

    void | error .expect(string ch)
        if not .accept(ch)
            return error(message)

    string | error .read_identifier()
        nat start = position
        if current() == "" or not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(current())
            return error(message)
        while current() != "" and "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".contains(current())
            position += 1
        return text[start:<position]

    string | error .read_key()
        try .expect("'")
        string result = ""
        while true
            string ch = current()
            if ch == ""
                return error(message)
            position += 1
            if ch == "'"
                return result
            if ch != "\"
                result += ch
                continue
            string escaped = current()
            if escaped == ""
                return error(message)
            position += 1
            if escaped == "u"
                int code = if position + 4 <= len(text) then hex_value(text[position:<position + 4]) else -1
                if code < 0 or code > 127
                    return error(message)
                position += 4
                result += ascii(nat(code))
            else
                nat at = find_at("'\/bfnrt", escaped)
                if at == 8
                    return error(message)
                result += ["'", "\", "/", ascii(8), ascii(12), NL, ascii(13), ascii(9)][at]

    Segment | error .selection()
        if current() == "'"
            string key = try .read_key()
            try .expect("]")
            return Segment("key", key)
        nat start = position
        while current() != "" and current() != "]"
            position += 1
        string content = text[start:<position]
        try .expect("]")
        if content == "*"
            return Segment("all")
        if integer_word(content)
            return Segment("index", "", int.parse(content))
        string[] parts = content.split(":")
        if len(parts) != 2
            return error(message)
        auto result = Segment("slice")
        for nat i < 2
            if parts[i] != "" and not integer_word(parts[i])
                return error(message)
        if parts[0] != ""
            result.start = int.parse(parts[0])
        if parts[1] != ""
            result.stop = int.parse(parts[1])
        return result

    Segment[] | error .parse(bool field = false)
        try .expect(if field then "@" else "$")
        Segment[] result = []
        while position < len(text)
            Segment selector = Segment("key")
            if .accept("[")
                selector = try .selection()
                if field and selector.kind != "key" and selector.kind != "index"
                    return error(message)
            else
                try .expect(".")
                bool descendant = not field and .accept(".")
                if not field and .accept("*")
                    selector = Segment("all")
                elif descendant and .accept("[")
                    selector = try .selection()
                else
                    string key = try .read_identifier()
                    selector = Segment("key", key)
                selector.descendant = descendant
            result = result.append(selector)
        return result

Segment[] | error parse_path(string text, bool field = false)
    auto reader = PathReader(text, if field then "bad field" else "bad path")
    return .reader.parse(field)

string | error parse_key(string text)
    auto reader = PathReader(text, "bad key")
    string result = if reader.current() == "'" then try .reader.read_key() else try .reader.read_identifier()
    return if reader.position != len(text) then error("bad key") else result

string location(Match selected)
    string result = "$"
    for Step step = selected.steps[]
        result += if not step.key_step then "[{step.position}]" else if identifier(step.key) then "." + step.key else "[" + quote_text(step.key, "'") + "]"
    return result

bool earlier(Match first, Match second)
    nat n = if len(first.steps) < len(second.steps) then len(first.steps) else len(second.steps)
    for nat i < n
        if first.steps[i].position != second.steps[i].position
            return first.steps[i].position < second.steps[i].position
    return len(first.steps) < len(second.steps)

Match[] targets(Match[] matches)
    Match[] result = []
    for Match selected = matches[]
        bool present = false
        nat at = len(result)
        for Match other = result[nat i]
            if not earlier(selected, other) and not earlier(other, selected)
                present = true
                break
            if earlier(other, selected)
                at = i
                break
        if not present
            result = result[:<at].append(selected).concat(result[at:])
    return result

string[] | error words(string argument, bool present, nat minimum, nat maximum)
    string[] result = if present then argument.split(" ") else []
    return if len(result) < minimum or len(result) > maximum then error("bad arguments") else result

string[] | error split_arguments(string argument, bool present, nat count)
    if not present
        return error("bad arguments")
    string[] result = []
    string rest = argument
    for nat i < count - 1
        nat at = find_at(rest, " ")
        if at == len(rest)
            return error("bad arguments")
        result = result.append(rest[:<at])
        rest = rest[at + 1:]
    return result.append(rest)

class QueryTool()
    Tree document = Tree([Value("null", "null")], 0)
    Tree[] history = []

    void .commit(Tree next)
        history = history.append(document)
        document = next

    string .load(string text)
        auto reader = JsonReader(text)
        match .reader.parse()
            Tree next
                .commit(next)
                return "LOADED nodes={document.count_nodes(document.root)} depth={document.depth(document.root)}"
            error problem
                nat line = 1
                nat column = 1
                for nat i < reader.error_at
                    if text[i] == NL
                        line += 1
                        column = 1
                    else
                        column += 1
                return "PARSE ERROR line {line} col {column}: {reader.reason}"

    Tree | error json_argument(string text)
        auto reader = JsonReader(text)
        match .reader.parse()
            Tree result
                return result
            error problem
                return error("PARSE ERROR col {reader.error_at + 1}: {reader.reason}")

    bool holds(string operator, int candidate, Tree reference)
        if operator == "EXISTS"
            return candidate >= 0
        bool equal = candidate >= 0 and document.equal_value(nat(candidate), reference, reference.root)
        if operator == "==" or operator == "!="
            return if operator == "==" then equal else not equal
        if candidate < 0
            return false
        Value a = document.nodes[candidate]
        Value b = reference.nodes[reference.root]
        if a.kind != b.kind or (a.kind != "number" and a.kind != "string")
            return false
        int order = if a.kind == "number" then (if a.number < b.number then -1 else if a.number > b.number then 1 else 0) else if a.text < b.text then -1 else if a.text > b.text then 1 else 0
        return if operator == "<" then order < 0 else if operator == "<=" then order <= 0 else if operator == ">" then order > 0 else order >= 0

    nat rank_key(Tree current, int index)
        if index < 0
            return 3
        string kind = current.nodes[index].kind
        return if kind == "null" then 0 else if kind == "number" then 1 else if kind == "string" then 2 else 3

    bool sort_less(Tree current, nat a, nat b, Segment[] field)
        int first = current.field_value(a, field)
        int second = current.field_value(b, field)
        nat ar = rank_key(current, first)
        nat br = rank_key(current, second)
        if ar != br
            return ar < br
        if ar == 1
            return current.nodes[first].number < current.nodes[second].number
        if ar == 2
            return current.nodes[first].text < current.nodes[second].text
        return false

    string | error .execute(string line)
        nat space = find_at(line, " ")
        string command = line[:<space]
        bool present = space < len(line)
        string argument = if present then line[space + 1:] else ""
        if not one_of(["GET", "COMPACT", "PRETTY", "TYPE", "LENGTH", "KEYS", "FLATTEN", "COUNT", "SUM", "MIN", "MAX", "AVG", "FILTER", "SET", "DELETE", "INSERT", "MERGE", "SORT", "RENAME", "UNDO"], command)
            return error("unknown command '{command}'")
        if command == "UNDO"
            string[] args = try words(argument, present, 0, 0)
            if len(history) == 0
                return error("nothing to undo")
            document = history[len(history) - 1]
            history = history[:<len(history) - 1]
            return "UNDO {len(history)}"
        Segment[] path = []
        Segment[] field = []
        Tree reference = Tree([Value("null", "null")], 0)
        string operator = ""
        string new_key = ""
        int index = 0
        bool descending = false
        if command == "SET" or command == "MERGE"
            string[] args = try split_arguments(argument, present, 2)
            path = try parse_path(args[0])
            reference = try json_argument(args[1])
            if command == "MERGE" and reference.nodes[reference.root].kind != "object"
                return error("merge value is not an object")
        elif command == "INSERT"
            string[] args = try split_arguments(argument, present, 3)
            path = try parse_path(args[0])
            if not integer_word(args[1])
                return error("bad index")
            index = int.parse(args[1])
            reference = try json_argument(args[2])
        elif command == "FILTER"
            string[] args = if present then argument.split(" ") else []
            nat first = find_at(argument, " ")
            nat second = if first < len(argument) then first + 1 + find_at(argument[first + 1:], " ") else len(argument)
            nat third = if second < len(argument) then second + 1 + find_at(argument[second + 1:], " ") else len(argument)
            if first == len(argument) or second == len(argument)
                return error("bad arguments")
            operator = argument[second + 1:<third]
            if (third < len(argument)) == (operator == "EXISTS")
                return error("bad arguments")
            path = try parse_path(argument[:<first])
            field = try parse_path(argument[first + 1:<second], true)
            if not one_of(["==", "!=", "<", "<=", ">", ">=", "EXISTS"], operator)
                return error("bad operator")
            if third < len(argument)
                reference = try json_argument(argument[third + 1:])
        elif command == "SORT"
            string[] args = try words(argument, present, 1, 3)
            string[] options = args[1:]
            descending = len(options) > 0 and options[len(options) - 1] == "DESC"
            if descending
                options = options[:<len(options) - 1]
            if len(options) > 1 or one_of(options, "DESC")
                return error("bad arguments")
            path = try parse_path(args[0])
            field = try parse_path(if len(options) == 0 then "@" else options[0], true)
        elif command == "RENAME"
            string[] args = try words(argument, present, 2, 2)
            path = try parse_path(args[0])
            new_key = try parse_key(args[1])
        else
            bool optional = one_of(["COMPACT", "PRETTY", "FLATTEN"], command)
            string[] args = try words(argument, present, if optional then 0 else 1, 1)
            path = try parse_path(if len(args) == 0 then "$" else args[0])
        if command == "DELETE" and len(path) == 0
            return error("cannot delete root")
        Match[] matches = document.evaluate(path)
        for Match selected = matches[]
            string kind = document.nodes[selected.node].kind
            if command == "LENGTH" and not one_of(["object", "array", "string"], kind)
                return error("no length at {location(selected)}")
            if (command == "KEYS" or command == "MERGE") and kind != "object"
                return error("not an object at {location(selected)}")
            if one_of(["FILTER", "INSERT", "SORT"], command) and kind != "array"
                return error("not an array at {location(selected)}")
        for Match selected = matches[]
            if command == "INSERT"
                int size = int(len(document.nodes[selected.node].items))
                if index < -size - 1 or index > size
                    return error("index out of range at {location(selected)}")
            if command == "RENAME" and (len(selected.steps) == 0 or not selected.steps[len(selected.steps) - 1].key_step)
                return error("not a member at {location(selected)}")
        if command == "COUNT"
            return "COUNT {len(matches)}"
        if one_of(["SUM", "MIN", "MAX", "AVG"], command)
            int total = 0
            int count = 0
            int low = 0
            int high = 0
            for Match selected = matches[]
                Value value = document.nodes[selected.node]
                if value.kind == "number"
                    if count == 0 or value.number < low
                        low = value.number
                    if count == 0 or value.number > high
                        high = value.number
                    total += value.number
                    count += 1
            if command == "SUM"
                return "SUM {total}"
            if count == 0
                return "{command} null"
            if command == "MIN" or command == "MAX"
                return "{command} {if command == "MIN" then low else high}"
            int absolute = if total < 0 then -total else total
            int rounded = (absolute * 200 + count) / (2 * count)
            string cents = "{rounded % 100}"
            return "AVG " + (if total < 0 and rounded > 0 then "-" else "") + "{rounded / 100}." + (if len(cents) == 1 then "0" else "") + cents
        if command == "FILTER"
            string[] output = []
            for Match selected = matches[]
                for nat i < len(document.nodes[selected.node].items)
                    Match element = document.child(selected, i)
                    if holds(operator, document.field_value(element.node, field), reference)
                        output = output.append("{location(element)} = {document.compact(element.node)}")
            return if len(output) == 0 then "no match" else output.join(NL)
        if one_of(["SET", "DELETE", "INSERT", "MERGE", "SORT", "RENAME"], command)
            Match[] chosen = matches
            if command == "SET" and len(path) > 0
                chosen = []
                Segment last = path[len(path) - 1]
                for Match parent = document.evaluate(path[:<len(path) - 1])[]
                    if last.kind == "key" and not last.descendant and document.nodes[parent.node].kind == "object"
                        int position = document.key_index(parent.node, last.key)
                        if position < 0
                            position = int(len(document.nodes[parent.node].items))
                        chosen = chosen.append(Match(0, parent.steps.append(Step(true, last.key, nat(position)))))
                    else
                        chosen = chosen.concat(document.select(last, [parent]))
            chosen = targets(chosen)
            Tree next = document
            for Match selected = chosen[]
                nat container = if len(selected.steps) == 0 then next.root else next.resolve(selected.steps[:<len(selected.steps) - 1])
                nat position = if len(selected.steps) == 0 then 0 else selected.steps[len(selected.steps) - 1].position
                if command == "SET"
                    nat copied = .next.copy_from(reference, reference.root)
                    if len(selected.steps) == 0
                        next.root = copied
                    elif position == len(next.nodes[container].items)
                        next.nodes[container].keys = next.nodes[container].keys.append(selected.steps[len(selected.steps) - 1].key)
                        next.nodes[container].items = next.nodes[container].items.append(copied)
                    else
                        next.nodes[container].items[position] = copied
                elif command == "DELETE"
                    next.nodes[container].items = next.nodes[container].items[:<position].concat(next.nodes[container].items[position + 1:])
                    if next.nodes[container].kind == "object"
                        next.nodes[container].keys = next.nodes[container].keys[:<position].concat(next.nodes[container].keys[position + 1:])
                elif command == "RENAME"
                    if next.nodes[container].keys[position] != new_key and next.key_index(container, new_key) >= 0
                        return error("key exists at {location(selected)}")
                    next.nodes[container].keys[position] = new_key
                else
                    nat target = next.resolve(selected.steps)
                    if command == "INSERT"
                        nat at = if index < 0 then nat(int(len(next.nodes[target].items)) + 1 + index) else nat(index)
                        nat copied = .next.copy_from(reference, reference.root)
                        next.nodes[target].items = next.nodes[target].items[:<at].append(copied).concat(next.nodes[target].items[at:])
                    elif command == "MERGE"
                        .next.merge_into(target, reference, reference.root)
                    else
                        nat[] items = next.nodes[target].items
                        for 1 <= nat i < len(items)
                            nat j = i
                            while j > 0 and (if descending then sort_less(next, items[j - 1], items[j], field) else sort_less(next, items[j], items[j - 1], field))
                                nat held = items[j]
                                items[j] = items[j - 1]
                                items[j - 1] = held
                                j -= 1
                        next.nodes[target].items = items
            .commit(next)
            return "{command} {len(chosen)}"
        string[] output = []
        for Match selected = matches[]
            Value value = document.nodes[selected.node]
            if command == "GET"
                output = output.append("{location(selected)} = {document.compact(selected.node)}")
            elif command == "COMPACT" or command == "PRETTY"
                output = output.append(if command == "COMPACT" then document.compact(selected.node) else document.pretty(selected.node))
            elif command == "TYPE"
                output = output.append("{location(selected)} {value.kind}")
            elif command == "LENGTH"
                output = output.append("{location(selected)} {if value.kind == "string" then len(value.text) else len(value.items)}")
            elif command == "KEYS"
                string[] keys = [for string key = value.keys[] then quote_text(key)]
                output = output.append(location(selected) + " [" + keys.join(",") + "]")
            else
                for Match leaf = document.preorder(selected)[]
                    if len(document.nodes[leaf.node].items) == 0
                        output = output.append("{location(leaf)} = {document.compact(leaf.node)}")
        return if len(output) == 0 then "no match" else output.join(NL)

auto tool = QueryTool()
string[] block = []
bool reading = true
while true
    string line
    scan(&line)
    if reading
        if line == "%%"
            print(.tool.load(block.join(NL)) + NL)
            block = []
            reading = false
        else
            block = block.append(line)
    elif line == "END"
        break
    elif line == "LOAD"
        reading = true
    else
        match .tool.execute(line)
            string result
                print(result + NL)
            error problem
                print((if problem.message.starts_with("PARSE ERROR ") then "" else "ERROR ") + problem.message + NL)
