import math

void emit(string text)
    print(text + NL)

int index_of(const string[] values, string target)
    for nat index = values.indices()[]
        if values[index] == target
            return int(index)
    return -1

bool includes(const int[] values, int target)
    for int value = values[]
        if value == target
            return true
    return false

int position_of(const int[] values, int target)
    for nat index = values.indices()[]
        if values[index] == target
            return int(index)
    return -1

int | error number_word(string text)
    if len(text) > 10 or (len(text) > 1 and text[0] == "0")
        return error("bad arguments")
    for int point = text.codepoints()[]
        if point < 48 or point > 57
            return error("bad arguments")
    return int.parse(text)

string fraction(int numerator, int denominator)
    int left = numerator
    int right = denominator
    while right != 0
        int remainder = left % right
        left = right
        right = remainder
    return "{numerator / left}/{denominator / left}"

class Move(string kind, int cell)
class UndoRecord(string kind, bool[] revealed, int[] marks, Move[] moves)

class Board(int width, int height, int mine_count, int seed)
    bool placed = false
    bool[] mines = array(nat(width * height), fill = false)
    int[] numbers = array(nat(width * height), fill = 0)
    bool[] revealed = array(nat(width * height), fill = false)
    int[] marks = array(nat(width * height), fill = 0)
    int[][] neighbors = []
    string state = "ready"
    int exploded = -1
    Move[] moves = []
    UndoRecord[] undos = []

Board new_board(int width, int height, int mine_count, int seed)
    auto board = Board(width, height, mine_count, seed)
    for 0 <= int row < height
        for 0 <= int column < width
            int[] neighbors = []
            for -1 <= int dy <= 1
                for -1 <= int dx <= 1
                    int x = column + dx
                    int y = row + dy
                    if (dx != 0 or dy != 0) and 0 <= x < width and 0 <= y < height
                        neighbors = neighbors.append(x + width * y)
            board.neighbors = board.neighbors.append(neighbors)
    return board

string cell_text(const Board board, int cell)
    return "{cell % board.width},{cell / board.width}"

string size_text(const Board board)
    return "{board.width}x{board.height}"

int remaining_mines(const Board board)
    return board.mine_count - int(len([for int mark = board.marks[] if mark == 1 then mark]))

int revealed_count(const Board board)
    return int(len([for bool open = board.revealed[] if open then open]))

int safe_count(const Board board)
    return board.width * board.height - board.mine_count

bool is_unknown(const Board board, int cell)
    return not board.revealed[cell] and board.marks[cell] != 1

int[] unknown_cells(const Board board)
    return [for nat cell = board.revealed.indices()[] if is_unknown(board, int(cell)) then int(cell)]

bool finished(const Board board)
    return board.state == "won" or board.state == "lost"

void compute_numbers(Board &board)
    for nat cell = board.numbers.indices()[]
        board.numbers[cell] = int(len([for int neighbor = board.neighbors[cell][] if board.mines[neighbor] then neighbor]))

void place_mines(Board &board, int first, string safety)
    int x = first % board.width
    int y = first / board.width
    int[] choices = []
    for 0 <= int cell < board.width * board.height
        bool allowed = safety == "none" or (safety == "cell" and cell != first)
        if safety == "block"
            allowed = math.abs(cell % board.width - x) >= 2 or math.abs(cell / board.width - y) >= 2
        if allowed
            choices = choices.append(cell)
    int generator = board.seed
    for 0 <= int placed < board.mine_count
        generator = 48271 * generator % 2147483647
        int index = generator % int(len(choices))
        board.mines[choices[index]] = true
        choices = choices[0:<index].concat(choices[index + 1:])
    compute_numbers(&board)
    board.placed = true
    board.state = "playing"

void reset_board(Board &board)
    board.revealed = array(nat(board.width * board.height), fill = false)
    board.marks = array(nat(board.width * board.height), fill = 0)
    board.moves = []
    board.undos = []
    board.exploded = -1
    board.state = if board.placed then "playing" else "ready"

int reveal_cell(Board &board, int cell, string safety)
    if not board.placed
        place_mines(&board, cell, safety)
    if board.mines[cell]
        board.state = "lost"
        board.exploded = cell
        return 0
    board.revealed[cell] = true
    board.marks[cell] = 0
    int[] queue = [cell]
    nat head = 0
    while head < len(queue)
        int current = queue[head]
        head += 1
        if board.numbers[current] == 0
            for int neighbor = board.neighbors[current][]
                if is_unknown(board, neighbor)
                    board.revealed[neighbor] = true
                    board.marks[neighbor] = 0
                    queue = queue.append(neighbor)
    return int(len(queue))

int chord_cells(Board &board, int cell, string safety)
    int opened = 0
    for int neighbor = board.neighbors[cell][]
        if is_unknown(board, neighbor)
            opened += reveal_cell(&board, neighbor, safety)
            if board.state == "lost"
                break
    return opened

void win_check(Board &board)
    if board.state == "playing" and revealed_count(board) == safe_count(board)
        board.state = "won"
        for nat cell = board.mines.indices()[]
            if board.mines[cell]
                board.marks[cell] = 1

void show_board(const Board board)
    string[] hidden = ["#", "F", "?"]
    for 0 <= int row < board.height
        string text = ""
        for 0 <= int column < board.width
            int cell = column + row * board.width
            string symbol = hidden[board.marks[cell]]
            if board.state == "lost" and board.mines[cell]
                symbol = if cell == board.exploded then "!" elif board.marks[cell] == 1 then "F" else "*"
            elif board.state == "lost" and board.marks[cell] == 1
                symbol = "X"
            elif board.revealed[cell]
                symbol = if board.numbers[cell] == 0 then "." else "{board.numbers[cell]}"
            text += symbol
        emit(text)

void finish_output(const Board board)
    if board.state == "lost"
        emit("boom {cell_text(board, board.exploded)}")
        show_board(board)
    elif board.state == "won"
        emit("win moves {len(board.moves)}")

class Constraint(int cell, int[] unknown, int remaining)

Constraint[] constraints(const Board board)
    Constraint[] result = []
    for nat cell = board.revealed.indices()[]
        if not board.revealed[cell] or board.numbers[cell] == 0
            continue
        int[] unknown = [for int neighbor = board.neighbors[cell][] if is_unknown(board, neighbor) then neighbor]
        if len(unknown) > 0
            int flags = int(len([for int neighbor = board.neighbors[cell][] if board.marks[neighbor] == 1 then neighbor]))
            result = result.append(Constraint(int(cell), unknown, board.numbers[cell] - flags))
    return result

class Deduction()
    map.Map<int, string> safe = map.Map<int, string>()
    map.Map<int, string> mines = map.Map<int, string>()

void add_reasons(map.Map<int, string> &reasons, const int[] cells, string reason)
    for int cell = cells[]
        if not reasons.has(cell)
            .reasons.set(cell, reason)

bool has_deduction(const Deduction result)
    return result.safe.size() > 0 or result.mines.size() > 0

Deduction deduction(const Board board)
    Constraint[] known = constraints(board)
    auto result = Deduction()
    for Constraint clue = known[]
        if clue.remaining == 0
            add_reasons(&result.safe, clue.unknown, "single {cell_text(board, clue.cell)}")
    if has_deduction(result)
        return result
    for Constraint clue = known[]
        if clue.remaining == int(len(clue.unknown))
            add_reasons(&result.mines, clue.unknown, "single {cell_text(board, clue.cell)}")
    if has_deduction(result)
        return result
    for Constraint left = known[]
        for Constraint right = known[]
            if len(left.unknown) >= len(right.unknown)
                continue
            bool contained = true
            for int cell = left.unknown[]
                if not includes(right.unknown, cell)
                    contained = false
                    break
            if not contained
                continue
            int[] difference = [for int cell = right.unknown[] if not includes(left.unknown, cell) then cell]
            int needed = right.remaining - left.remaining
            string reason = "subset {cell_text(board, left.cell)} {cell_text(board, right.cell)}"
            if needed == 0
                add_reasons(&result.safe, difference, reason)
            elif needed == int(len(difference))
                add_reasons(&result.mines, difference, reason)
    if not has_deduction(result) and board.state == "playing" and remaining_mines(board) == 0
        add_reasons(&result.safe, unknown_cells(board), "count")
    return result

class AutoResult()
    int rounds = 0
    int flagged = 0
    int opened = 0

AutoResult auto_play(Board &board, string safety)
    auto totals = AutoResult()
    while board.state == "playing"
        Deduction found = deduction(board)
        if not has_deduction(found)
            break
        totals.rounds += 1
        for int cell = found.safe.keys().sorted()[]
            if not board.revealed[cell]
                board.moves = board.moves.append(Move("auto-reveal", cell))
                totals.opened += reveal_cell(&board, cell, safety)
                win_check(&board)
                if finished(board)
                    break
        if finished(board)
            break
        for int cell = found.mines.keys().sorted()[]
            if is_unknown(board, cell)
                board.marks[cell] = 1
                totals.flagged += 1
                board.moves = board.moves.append(Move("auto-flag", cell))
    return totals

class Component(int[] cells, int[] mine_counts, int configurations, int minimum, int maximum)
class Frontier(bool[] cells, Component[] components)

class Search(int[] required, int[] left, int[][] touches, int[] order)
    int[] sums = array(len(required), fill = 0)
    int[] values = array(len(touches), fill = 0)
    int[] mine_counts = array(len(touches), fill = 0)
    int configurations = 0
    int minimum = 0
    int maximum = 0

void search_configs(Search &search, int depth)
    if depth == int(len(search.order))
        search.configurations += 1
        search.mine_counts += search.values
        int total = math.sum(search.values)
        if search.configurations == 1
            search.minimum = total
            search.maximum = total
        else
            search.minimum = math.min(search.minimum, total)
            search.maximum = math.max(search.maximum, total)
        return
    int cell = search.order[depth]
    int[] affected = search.touches[cell]
    for int index = affected[]
        search.left[index] -= 1
    for 0 <= int value <= 1
        bool valid = true
        for int index = affected[]
            search.sums[index] += value
            int needed = search.required[index] - search.sums[index]
            if needed < 0 or needed > search.left[index]
                valid = false
        if valid
            search.values[cell] = value
            search_configs(&search, depth + 1)
        for int index = affected[]
            search.sums[index] -= value
    for int index = affected[]
        search.left[index] += 1

Component count_component(const int[] cells, const Constraint[] known)
    int[][] touches = array(len(cells), fill = [])
    for nat index = known.indices()[]
        for int cell = known[index].unknown[]
            int local_index = position_of(cells, cell)
            touches[local_index] = touches[local_index].append(int(index))
    int[] degrees = [for int[] adjacent = touches[] then int(len(adjacent))]
    int width = int(len(cells)) + 1
    int largest = math.max_all(degrees)
    int[] keys = [for nat index = degrees.indices()[] then (largest - degrees[index]) * width + int(index)]
    int[] order = keys.sorted() % width
    int[] required = [for Constraint clue = known[] then clue.remaining]
    int[] left = [for Constraint clue = known[] then int(len(clue.unknown))]
    auto search = Search(required, left, touches, order)
    bool possible = true
    for nat index = known.indices()[]
        if required[index] < 0 or required[index] > left[index]
            possible = false
    if possible
        search_configs(&search, 0)
    return Component(cells, search.mine_counts, search.configurations, search.minimum, search.maximum)

// PROB counts only its target component; a negative target counts all components.
Frontier frontier(const Board board, int target = -1)
    Constraint[] known = constraints(board)
    int[][] members = array(len(board.revealed), fill = [])
    bool[] cells = array(len(board.revealed), fill = false)
    for nat index = known.indices()[]
        for int cell = known[index].unknown[]
            cells[cell] = true
            members[cell] = members[cell].append(int(index))
    bool[] seen = array(len(cells), fill = false)
    Component[] components = []
    for nat start = cells.indices()[]
        if not cells[start] or seen[start]
            continue
        int[] queue = [int(start)]
        seen[start] = true
        bool[] used = array(len(known), fill = false)
        nat head = 0
        while head < len(queue)
            int cell = queue[head]
            head += 1
            for int index = members[cell][]
                if used[index]
                    continue
                used[index] = true
                for int neighbor = known[index].unknown[]
                    if not seen[neighbor]
                        seen[neighbor] = true
                        queue = queue.append(neighbor)
        if target < 0 or includes(queue, target)
            Constraint[] selected = [for nat index = known.indices()[] if used[index] then known[index]]
            components = components.append(count_component(queue.sorted(), selected))
    return Frontier(cells, components)

int guess_cell(const Board board)
    Frontier boundary = frontier(board)
    int[] unknown = unknown_cells(board)
    int[] numerators = array(len(board.revealed), fill = -1)
    int[] denominators = array(len(board.revealed), fill = 1)
    for Component component = boundary.components[]
        if component.configurations > 0
            for nat index = component.cells.indices()[]
                int cell = component.cells[index]
                numerators[cell] = component.mine_counts[index]
                denominators[cell] = component.configurations
    int remainder = math.max(remaining_mines(board), 0)
    for int cell = unknown[]
        if not boundary.cells[cell]
            numerators[cell] = remainder
            denominators[cell] = int(len(unknown))
    int chosen = -1
    int best_numerator = 0
    int best_denominator = 1
    for int cell = unknown[]
        if numerators[cell] >= 0 and (chosen < 0 or numerators[cell] * best_denominator < best_numerator * denominators[cell])
            chosen = cell
            best_numerator = numerators[cell]
            best_denominator = denominators[cell]
    return chosen

class SolveResult(int guesses, AutoResult totals)

SolveResult solve_play(Board &board, string safety)
    int guesses = 0
    auto totals = AutoResult()
    while true
        AutoResult automatic = auto_play(&board, safety)
        totals.rounds += automatic.rounds
        totals.flagged += automatic.flagged
        totals.opened += automatic.opened
        if finished(board)
            break
        int cell = guess_cell(board)
        if cell < 0
            break
        guesses += 1
        board.moves = board.moves.append(Move("guess", cell))
        totals.opened += reveal_cell(&board, cell, safety)
        win_check(&board)
        if finished(board)
            break
    return SolveResult(guesses, totals)

void board_info(const Board board)
    bool[] blank = [for nat cell = board.mines.indices()[] then not board.mines[cell] and board.numbers[cell] == 0]
    bool[] seen = array(len(blank), fill = false)
    bool[] covered = array(len(blank), fill = false)
    int openings = 0
    int largest = 0
    for nat start = blank.indices()[]
        if not blank[start] or seen[start]
            continue
        openings += 1
        int[] queue = [int(start)]
        seen[start] = true
        bool[] area = array(len(blank), fill = false)
        nat head = 0
        while head < len(queue)
            int cell = queue[head]
            head += 1
            area[cell] = true
            for int neighbor = board.neighbors[cell][]
                area[neighbor] = true
                if blank[neighbor] and not seen[neighbor]
                    seen[neighbor] = true
                    queue = queue.append(neighbor)
        int size = int(len([for bool member = area[] if member then member]))
        largest = math.max(largest, size)
        for nat cell = area.indices()[]
            covered[cell] = covered[cell] or area[cell]
    int isolated = int(len([for nat cell = covered.indices()[] if not covered[cell] and not board.mines[cell] then cell]))
    emit("3bv {openings + isolated} openings {openings} largest {largest} mines {board.mine_count} safe {safe_count(board)}")

void replay(const Board board, int count, string safety)
    emit("replay {count}/{len(board.moves)}")
    Board copy = board
    reset_board(&copy)
    for 0 <= int index < count
        Move move = board.moves[index]
        copy.moves = copy.moves.append(move)
        if index_of(["reveal", "auto-reveal", "guess"], move.kind) >= 0
            reveal_cell(&copy, move.cell, safety)
        elif move.kind == "chord"
            chord_cells(&copy, move.cell, safety)
        elif move.kind == "flag" or move.kind == "auto-flag"
            copy.marks[move.cell] = 1
        elif move.kind == "unflag"
            copy.marks[move.cell] = 0
        else
            copy.marks[move.cell] = if copy.marks[move.cell] == 2 then 0 else 2
        win_check(&copy)
    show_board(copy)

class Statistics()
    int played = 0
    int wins = 0
    int losses = 0
    int streak = 0
    int best = 0
    int | none fastest = none

void update_stats(Statistics &stats, const Board board)
    stats.played += 1
    if board.state == "won"
        stats.wins += 1
        stats.streak += 1
        stats.best = math.max(stats.best, stats.streak)
        int moves = int(len(board.moves))
        match stats.fastest
            int previous
                stats.fastest = math.min(previous, moves)
            none
                stats.fastest = moves
    else
        stats.losses += 1
        stats.streak = 0

void print_stats(const Statistics stats)
    string rate = if stats.played == 0 then "-" else "{100 * stats.wins / stats.played}%"
    string fastest = "-"
    match stats.fastest
        int moves
            fastest = "{moves}"
        none
            fastest = "-"
    emit("stats played {stats.played} won {stats.wins} lost {stats.losses} rate {rate} streak {stats.streak} best {stats.best} fastest {fastest}")

class Program()
    string safety = "block"
    Board | none board = none
    Statistics stats = Statistics()

Board | error require_board(const Program program)
    match program.board
        Board found
            return found
        none
            return error("no game")

void | error layout_command(Program &program, int width, int height, const string[] rows)
    for nat index = rows.indices()[]
        bool valid = len(rows[index]) == nat(width)
        for int point = rows[index].codepoints()[]
            if point != 42 and point != 46
                valid = false
        if not valid
            return error("bad row {index + 1}")
    string flat = rows.join("")
    bool[] mines = [for int point = flat.codepoints()[] then point == 42]
    int count = int(len([for bool mine = mines[] if mine then mine]))
    if count == 0 or count == width * height
        return error("bad mine count {count}")
    Board board = new_board(width, height, count, 0)
    board.placed = true
    board.state = "playing"
    board.mines = mines
    compute_numbers(&board)
    program.board = board
    emit("layout {size_text(board)} mines {count}")
    return void

void print_hint(const Board board)
    Deduction found = deduction(board)
    map.Map<int, string> reasons = found.safe
    string kind = "safe"
    if reasons.size() == 0
        reasons = found.mines
        kind = "mine"
    if reasons.size() == 0
        emit("hint none")
        return
    int cell = reasons.keys().sorted()[0]
    match reasons.get(cell)
        string reason
            emit("hint {kind} {cell_text(board, cell)} by {reason}")
        none
            return

void print_probability(const Board board, int cell)
    Frontier boundary = frontier(board, cell)
    if not boundary.cells[cell]
        emit("prob {cell_text(board, cell)} unconstrained")
        return
    for Component component = boundary.components[]
        int index = position_of(component.cells, cell)
        if index < 0
            continue
        if component.configurations == 0
            emit("prob {cell_text(board, cell)} inconsistent")
        else
            emit("prob {cell_text(board, cell)} {fraction(component.mine_counts[index], component.configurations)} size {len(component.cells)} configs {component.configurations}")
        return

void print_frontier(const Board board)
    Frontier boundary = frontier(board)
    int cells = int(len([for bool member = boundary.cells[] if member then member]))
    emit("frontier {cells} components {len(boundary.components)}")
    for Component component = boundary.components[]
        string text = "component {cell_text(board, component.cells[0])} size {len(component.cells)}"
        if component.configurations == 0
            emit(text + " inconsistent")
        else
            emit(text + " configs {component.configurations} min {component.minimum} max {component.maximum}")

void | error command(Program &program, const string[] tokens)
    string[] commands = ["NEW", "PRESET", "LAYOUT", "SAFETY", "RESTART", "REVEAL", "FLAG", "UNFLAG", "QUESTION", "CHORD", "UNDO", "SHOW", "STATUS", "CELL", "HISTORY", "REPLAY", "HINT", "AUTO", "ANALYZE", "PROB", "FRONTIER", "SOLVE", "BOARDINFO", "STATS"]
    int[] arities = [4, 2, 2, 1, 0, 2, 2, 2, 2, 2, 0, 0, 0, 2, 1, 1, 0, 0, 0, 2, 0, 0, 0, 0]
    string op = tokens[0]
    int operation = index_of(commands, op)
    if operation < 0
        return error("unknown command " + op)
    if int(len(tokens)) != arities[operation] + 1
        return error("bad arguments")
    int[] values = []
    string mode = ""
    if op == "PRESET"
        int preset = index_of(["beginner", "intermediate", "expert"], tokens[1])
        if preset < 0
            return error("bad arguments")
        int seed = try number_word(tokens[2])
        int[][] settings = [[9, 9, 10], [16, 16, 40], [30, 16, 99]]
        values = settings[preset].append(seed)
    elif op == "SAFETY"
        mode = tokens[1]
        if index_of(["block", "cell", "none"], mode) < 0
            return error("bad arguments")
    else
        for string token = tokens[1:][]
            int value = try number_word(token)
            values = values.append(value)
    if op == "NEW" or op == "PRESET"
        int width = values[0]
        int height = values[1]
        int mines = values[2]
        int seed = values[3]
        if width < 1 or width > 30 or height < 1 or height > 30 or mines < 1 or mines > width * height - 9 or seed < 1 or seed > 2147483646
            return error("bad value")
        Board created = new_board(width, height, mines, seed)
        program.board = created
        emit("new {size_text(created)} mines {mines}")
        return void
    if op == "HISTORY" and values[0] == 0
        return error("bad value")
    if op == "SAFETY"
        program.safety = mode
        emit("safety " + mode)
        return void
    if op == "STATS"
        print_stats(program.stats)
        return void
    Board board = try require_board(program)
    int cell = -1
    if index_of(["REVEAL", "FLAG", "UNFLAG", "QUESTION", "CHORD", "CELL", "PROB"], op) >= 0
        if values[0] >= board.width or values[1] >= board.height
            return error("out of range")
        cell = values[0] + board.width * values[1]
    if index_of(["REVEAL", "FLAG", "UNFLAG", "QUESTION", "CHORD", "UNDO", "HINT", "AUTO", "ANALYZE", "PROB", "FRONTIER", "SOLVE"], op) >= 0 and finished(board)
        return error("game over")
    if (op == "ANALYZE" or op == "BOARDINFO") and not board.placed
        return error("not started")
    int undo_index = index_of(["REVEAL", "FLAG", "UNFLAG", "QUESTION", "CHORD", "AUTO", "SOLVE"], op)
    string undo_name = ""
    if undo_index >= 0
        string[] names = ["reveal", "flag", "unflag", "question", "chord", "auto", "solve"]
        undo_name = names[undo_index]
    auto before = UndoRecord(undo_name, board.revealed, board.marks, board.moves)
    int previous_moves = int(len(board.moves))
    if op == "RESTART"
        reset_board(&board)
        emit("restart {size_text(board)} mines {board.mine_count}")
    elif index_of(["REVEAL", "FLAG", "UNFLAG", "QUESTION", "PROB"], op) >= 0
        if board.revealed[cell]
            return error("already revealed")
        if (op == "REVEAL" or op == "PROB") and board.marks[cell] == 1
            return error("flagged")
        if op == "FLAG" and board.marks[cell] == 1
            return error("already flagged")
        if op == "UNFLAG" and board.marks[cell] != 1
            return error("not flagged")
        if op == "REVEAL"
            board.moves = board.moves.append(Move("reveal", cell))
            int opened = reveal_cell(&board, cell, program.safety)
            if board.state != "lost"
                emit("revealed {opened}")
                win_check(&board)
            finish_output(board)
        elif op == "FLAG"
            board.marks[cell] = 1
            board.moves = board.moves.append(Move("flag", cell))
            emit("flagged {cell_text(board, cell)} left {remaining_mines(board)}")
        elif op == "UNFLAG"
            board.marks[cell] = 0
            board.moves = board.moves.append(Move("unflag", cell))
            emit("unflagged {cell_text(board, cell)} left {remaining_mines(board)}")
        elif op == "QUESTION"
            bool marked = board.marks[cell] != 2
            board.marks[cell] = if marked then 2 else 0
            board.moves = board.moves.append(Move("question", cell))
            string verb = if marked then "questioned" else "unmarked"
            emit("{verb} {cell_text(board, cell)} left {remaining_mines(board)}")
        else
            print_probability(board, cell)
    elif op == "CHORD"
        if not board.revealed[cell]
            return error("not revealed")
        int number = board.numbers[cell]
        if number == 0
            return error("no number")
        int flags = int(len([for int neighbor = board.neighbors[cell][] if board.marks[neighbor] == 1 then neighbor]))
        if flags != number
            return error("flags {flags} of {number}")
        if len([for int neighbor = board.neighbors[cell][] if is_unknown(board, neighbor) then neighbor]) == 0
            return error("nothing to reveal")
        board.moves = board.moves.append(Move("chord", cell))
        int opened = chord_cells(&board, cell, program.safety)
        if board.state != "lost"
            emit("chorded {opened}")
            win_check(&board)
        finish_output(board)
    elif op == "UNDO"
        if len(board.undos) == 0
            return error("nothing to undo")
        UndoRecord saved = board.undos[len(board.undos) - 1]
        board.undos = board.undos[0:<int(len(board.undos)) - 1]
        board.revealed = saved.revealed
        board.marks = saved.marks
        board.moves = saved.moves
        emit("undo {saved.kind} moves {len(board.moves)}")
    elif op == "SHOW"
        show_board(board)
    elif op == "STATUS"
        emit("status {board.state} left {remaining_mines(board)} moves {len(board.moves)} revealed {revealed_count(board)}/{safe_count(board)}")
    elif op == "CELL"
        if board.revealed[cell]
            int flags = int(len([for int neighbor = board.neighbors[cell][] if board.marks[neighbor] == 1 then neighbor]))
            int unknown = int(len([for int neighbor = board.neighbors[cell][] if is_unknown(board, neighbor) then neighbor]))
            emit("cell {cell_text(board, cell)} number {board.numbers[cell]} flags {flags} unknown {unknown}")
        else
            string[] names = ["none", "flag", "question"]
            int open = int(len([for int neighbor = board.neighbors[cell][] if board.revealed[neighbor] then neighbor]))
            emit("cell {cell_text(board, cell)} hidden mark {names[board.marks[cell]]} open {open}")
    elif op == "HISTORY"
        emit("history {len(board.moves)}")
        int start = math.max(0, int(len(board.moves)) - values[0])
        for start <= int index < int(len(board.moves))
            Move move = board.moves[index]
            emit("{index + 1} {move.kind} {cell_text(board, move.cell)}")
    elif op == "REPLAY"
        if values[0] > int(len(board.moves))
            return error("no move {values[0]}")
        replay(board, values[0], program.safety)
    elif op == "HINT"
        print_hint(board)
    elif op == "AUTO"
        AutoResult result = auto_play(&board, program.safety)
        emit("auto rounds {result.rounds} flagged {result.flagged} revealed {result.opened}")
        finish_output(board)
    elif op == "ANALYZE"
        Board copy = board
        AutoResult result = auto_play(&copy, program.safety)
        if copy.state == "lost"
            emit("analyze boom {cell_text(copy, copy.exploded)} rounds {result.rounds}")
        elif copy.state == "won"
            emit("analyze clear rounds {result.rounds}")
        else
            emit("analyze stuck rounds {result.rounds} revealed {revealed_count(copy)}/{safe_count(copy)}")
    elif op == "FRONTIER"
        print_frontier(board)
    elif op == "SOLVE"
        SolveResult result = solve_play(&board, program.safety)
        emit("solve guesses {result.guesses} rounds {result.totals.rounds} flagged {result.totals.flagged} revealed {result.totals.opened}")
        finish_output(board)
    elif op == "BOARDINFO"
        board_info(board)
    if undo_index >= 0 and int(len(board.moves)) > previous_moves
        board.undos = board.undos.append(before)
        if finished(board)
            update_stats(&program.stats, board)
    program.board = board
    return void

string count_line
scan(&count_line)
int command_count = int.parse(count_line)
auto program = Program()
for 0 <= int command_number < command_count
    string line
    scan(&line)
    string[] tokens = line.split(" ")
    void | error outcome
    if tokens[0] == "LAYOUT"
        int width = int.parse(tokens[1])
        int height = int.parse(tokens[2])
        string[] rows = []
        for 0 <= int row < height
            string text
            scan(&text)
            rows = rows.append(text)
        outcome = layout_command(&program, width, height, rows)
    else
        outcome = command(&program, tokens)
    match outcome
        void
            continue
        error problem
            emit("error: " + problem.message)
