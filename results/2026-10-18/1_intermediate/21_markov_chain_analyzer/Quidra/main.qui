import math

int parse_integer(string text)
    return int.parse(text)

void emit(string text)
    print(text + NL)

string yes(bool condition)
    return if condition then "yes" else "no"

int gcd(int left, int right)
    left = math.abs(left)
    right = math.abs(right)
    while right != 0
        int remainder = left % right
        left = right
        right = remainder
    return left

class Ratio(int numerator, int denominator)

Ratio ratio_parts(real quantity)
    string text = quantity.string()
    string[] fields = text.split("/")
    if len(fields) == 2
        return Ratio(parse_integer(fields[0]), parse_integer(fields[1]))
    fields = text.split(".")
    if len(fields) == 1
        return Ratio(parse_integer(text), 1)
    int denominator = 10 ^ int(len(fields[1]))
    int numerator = parse_integer(fields[0]) * denominator + (if text.starts_with("-") then -1 else 1) * parse_integer(fields[1])
    int divisor = gcd(numerator, denominator)
    return Ratio(numerator / divisor, denominator / divisor)

string fraction_text(real quantity)
    Ratio parts = ratio_parts(quantity)
    return "{parts.numerator}/{parts.denominator}"

string value_text(real quantity)
    Ratio parts = ratio_parts(quantity)
    int whole = parts.numerator / parts.denominator
    int tail = (parts.numerator % parts.denominator) * 1000000 / parts.denominator
    return "{parts.numerator}/{parts.denominator}({whole}.{tail:int=6,zero})"

real | error probability(string text)
    string[] fields = text.split("/")
    int numerator = parse_integer(fields[0])
    int denominator = if len(fields) == 2 then parse_integer(fields[1]) else 1
    if denominator == 0 or numerator > denominator
        return error("BAD PROBABILITY")
    return real(numerator) / real(denominator)

real[] | error probability_row(const string[] fields)
    real[] result = []
    for string token = fields[]
        real chance = try probability(token)
        result = result.append(chance)
    return result

real ordered_sum(const real[] terms)
    real result = 0.0
    for real term = terms[]
        result += term
    return result

real unit_value(int row, int column)
    return if row == column then 1.0 else 0.0

real[][] matrix(int rows, int columns)
    return array(nat(rows), fill = array(nat(columns), fill = real(0)))

real[][] identity(int size)
    real[][] result = matrix(size, size)
    for 0 <= int index < size
        result[index][index] = 1.0
    return result

real[][] multiply(const real[][] left, const real[][] right)
    real[][] result = matrix(int(len(left)), int(len(right[0])))
    for nat row = left.indices()[]
        for nat column = right[0].indices()[]
            real[] values = [for real[] entries = right[] then entries[column]]
            result[row][column] = ordered_sum(left[row] * values)
    return result

real[][] solve(real[][] rows)
    int size = int(len(rows))
    for 0 <= int column < size
        int pivot_row = column
        while rows[pivot_row][column] == 0.0
            pivot_row += 1
        real[] saved = rows[column]
        rows[column] = rows[pivot_row]
        rows[pivot_row] = saved
        real pivot = rows[column][column]
        rows[column] = rows[column] / pivot
        for 0 <= int row < size
            if row == column
                continue
            real factor = rows[row][column]
            if factor != 0.0
                rows[row] = rows[row] - rows[column] * factor
    return [for real[] entries = rows[] then entries[size:]]

class Chain(string[] names, real[][] transitions)

int[] state_numbers(const Chain chain)
    return int(chain.names.indices())

int | error state_index(const Chain chain, string name)
    for int index = state_numbers(chain)[]
        if chain.names[index] == name
            return index
    return error("UNKNOWN STATE " + name)

int[] | error state_set(const Chain chain, const string[] requested)
    bool[] seen = array(len(chain.names), fill = false)
    for string name = requested[]
        int index = try state_index(chain, name)
        if seen[index]
            return error("DUPLICATE STATE " + name)
        seen[index] = true
    return [for int index = state_numbers(chain)[] if seen[index] then index]

string labels(const Chain chain, const int[] states, string separator = " ")
    return chain.names[states].join(separator)

real block_sum(const Chain chain, int source, const int[] targets)
    return ordered_sum(chain.transitions[source][targets])

void display(const string[] names, const real[][] rows, string prefix = "ROW")
    emit("STATES " + names.join(" "))
    for nat index = names.indices()[]
        string[] entries = [for real chance = rows[index][] then fraction_text(chance)]
        emit(prefix + " " + names[index] + " " + entries.join(" "))

class Component(int[] members, bool closed, int[] levels, int period)
class Graph(bool[][] reachable, Component[] classes, int[] membership)

Graph decompose(const Chain chain)
    int size = int(len(chain.names))
    int[] states = state_numbers(chain)
    bool[][] reachable = chain.transitions > 0.0
    for int index = states[]
        reachable[index][index] = true
    for int middle = states[]
        for int source = states[]
            for int target = states[]
                reachable[source][target] = reachable[source][target] or (reachable[source][middle] and reachable[middle][target])
    Component[] classes = []
    int[] membership = array(nat(size), fill = -1)
    for int root = states[]
        if membership[root] >= 0
            continue
        int[] members = [for int index = states[] if reachable[root][index] and reachable[index][root] then index]
        bool[] inside = array(nat(size), fill = false)
        for int member = members[]
            membership[member] = int(len(classes))
            inside[member] = true
        bool closed = true
        for int source = members[]
            for int target = states[]
                if not inside[target] and chain.transitions[source][target] > 0.0
                    closed = false
        int[] levels = array(nat(size), fill = -1)
        levels[root] = 0
        int[] queue = [root]
        int head = 0
        while head < int(len(queue))
            int source = queue[head]
            head += 1
            for int target = members[]
                if levels[target] < 0 and chain.transitions[source][target] > 0.0
                    levels[target] = levels[source] + 1
                    queue = queue.append(target)
        int period = 0
        for int source = members[]
            for int target = members[]
                if chain.transitions[source][target] > 0.0
                    period = gcd(period, levels[source] + 1 - levels[target])
        classes = classes.append(Component(members, closed, levels, period))
    return Graph(reachable, classes, membership)

real[] stationary(const Chain chain, const int[] members)
    int size = int(len(members))
    real[][] rows = matrix(size, size + 1)
    for 0 <= int row < size - 1
        for 0 <= int column < size
            rows[row][column] = chain.transitions[members[column]][members[row]] - unit_value(column, row)
    rows[size - 1] = array(nat(size + 1), fill = real(1))
    return [for real[] entries = solve(rows)[] then entries[0]]

real[] | error irreducible(const Chain chain, const Graph graph)
    if len(graph.classes) != 1
        return error("NOT IRREDUCIBLE")
    return stationary(chain, graph.classes[0].members)

class HittingResult(real[] chances, real[] durations)

HittingResult hitting(const Chain chain, const int[] targets, const bool[][] reachable, bool with_times = true)
    int size = int(len(chain.names))
    real[] chances = array(nat(size), fill = real(0))
    real[] durations = array(nat(size), fill = real(0))
    bool[] inside = array(nat(size), fill = false)
    for int target = targets[]
        chances[target] = 1.0
        inside[target] = true
    int[] unknown = []
    for int index = state_numbers(chain)[]
        bool reaches = false
        for int target = targets[]
            reaches = reaches or reachable[index][target]
        if not inside[index] and reaches
            unknown = unknown.append(index)
    int count = int(len(unknown))
    if count > 0
        real[][] rows = matrix(count, count + 1)
        for 0 <= int row < count
            for 0 <= int column < count
                rows[row][column] = unit_value(row, column) - chain.transitions[unknown[row]][unknown[column]]
            rows[row][count] = block_sum(chain, unknown[row], targets)
        real[][] solution = solve(rows)
        for 0 <= int index < count
            chances[unknown[index]] = solution[index][0]
    if with_times
        int[] certain = [for int index = unknown[] if chances[index] == 1.0 then index]
        int count_certain = int(len(certain))
        if count_certain > 0
            real[][] rows = matrix(count_certain, count_certain + 1)
            for 0 <= int row < count_certain
                for 0 <= int column < count_certain
                    rows[row][column] = unit_value(row, column) - chain.transitions[certain[row]][certain[column]]
                rows[row][count_certain] = 1.0
            real[][] solution = solve(rows)
            for 0 <= int index < count_certain
                durations[certain[index]] = solution[index][0]
    return HittingResult(chances, durations)

int[] absorbing_states(const Chain chain)
    return [for int index = state_numbers(chain)[] if chain.transitions[index][index] == 1.0 then index]

class AbsorptionResult(int[] transient, int[] absorbing, real[][] fundamental, real[] means, real[] variances, real[][] chances)

AbsorptionResult absorption(const Chain chain)
    int[] absorbing = absorbing_states(chain)
    int[] transient = [for int index = state_numbers(chain)[] if chain.transitions[index][index] != 1.0 then index]
    int count = int(len(transient))
    real[][] rows = matrix(count, 2 * count)
    for 0 <= int row < count
        for 0 <= int column < count
            rows[row][column] = unit_value(row, column) - chain.transitions[transient[row]][transient[column]]
        rows[row][count + row] = 1.0
    real[][] fundamental = solve(rows)
    real[] means = [for real[] entries = fundamental[] then ordered_sum(entries)]
    real[] variances = []
    real[][] chances = matrix(count, int(len(absorbing)))
    for 0 <= int row < count
        real[] terms = []
        for 0 <= int column < count
            terms = terms.append((2.0 * fundamental[row][column] - unit_value(row, column)) * means[column])
        variances = variances.append(ordered_sum(terms) - means[row] * means[row])
        for nat column = absorbing.indices()[]
            real[] arrivals = [for int index = transient[] then chain.transitions[index][absorbing[column]]]
            chances[row][column] = ordered_sum(fundamental[row] * arrivals)
    return AbsorptionResult(transient, absorbing, fundamental, means, variances, chances)

int regular_exponent(const Chain chain)
    int size = int(len(chain.names))
    int[] states = state_numbers(chain)
    bool[][] edges = chain.transitions > 0.0
    bool[][] power = edges
    int bound = (size - 1) * (size - 1) + 1
    for 1 <= int exponent <= bound
        bool positive = true
        for bool[] entries = power[]
            for bool edge = entries[]
                positive = positive and edge
        if positive
            return exponent
        if exponent == bound
            break
        bool[][] next = array(nat(size), fill = array(nat(size), fill = false))
        for int source = states[]
            for int target = states[]
                for int middle = states[]
                    next[source][target] = next[source][target] or (power[source][middle] and edges[middle][target])
        power = next
    return 0

void | error create(map.Map<string, Chain> &chains, const string[] words)
    string op = words[0]
    string name = words[1]
    if op == "CHAIN"
        string[] names = words[2:]
        if len(names) > 10
            return error("TOO MANY STATES")
        set.Set<string> seen = set.Set<string>()
        for string label = names[]
            if seen.has(label)
                return error("DUPLICATE STATE " + label)
            .seen.add(label)
        .chains.set(name, Chain(names, matrix(int(len(names)), int(len(names)))))
        emit("CHAIN {name} states={len(names)}")
    elif op == "BUILD"
        int order = parse_integer(words[2])
        if order != 1 and order != 2
            return error("BAD ORDER")
        string[] tokens = words[3:]
        if int(len(tokens)) <= order
            return error("TOO FEW TOKENS")
        string[] observations = tokens
        if order == 2
            observations = []
            for 0 <= int index < int(len(tokens)) - 1
                observations = observations.append(tokens[index] + "." + tokens[index + 1])
        string[] names = []
        map.Map<string, int> positions = map.Map<string, int>()
        int[] sequence = []
        for string observation = observations[]
            match positions.get(observation)
                int index
                    sequence = sequence.append(index)
                none
                    int position = int(len(names))
                    .positions.set(observation, position)
                    sequence = sequence.append(position)
                    names = names.append(observation)
        int size = int(len(names))
        if size > 10
            return error("TOO MANY STATES")
        int[][] counts = array(nat(size), fill = array(nat(size), fill = 0))
        for 1 <= int index < int(len(sequence))
            counts[sequence[index - 1]][sequence[index]] += 1
        real[][] transitions = matrix(size, size)
        int[] totals = [for int[] entries = counts[] then math.sum(entries)]
        for 0 <= int row < size
            if totals[row] == 0
                transitions[row][row] = 1.0
            else
                transitions[row] = real(counts[row]) / real(totals[row])
        .chains.set(name, Chain(names, transitions))
        emit("BUILD {name} order={order} states={size} transitions={int(len(observations)) - 1}")
        for 0 <= int row < size
            string detail = "absorbing"
            if totals[row] > 0
                string[] entries = []
                for 0 <= int column < size
                    if counts[row][column] > 0
                        entries = entries.append("{names[column]}:{counts[row][column]}")
                detail = entries.join(" ")
            emit("FROM {names[row]} total={totals[row]} {detail}")
    else
        int goal = parse_integer(words[2])
        int start = parse_integer(words[3])
        if goal == 0 or goal > 9
            return error("BAD SIZE")
        if start > goal
            return error("BAD START")
        real chance = try probability(words[4])
        if chance == 0.0 or chance == 1.0
            return error("BAD PROBABILITY")
        string[] names = []
        for 0 <= int capital <= goal
            names = names.append("s{capital}")
        real[][] transitions = matrix(goal + 1, goal + 1)
        transitions[0][0] = 1.0
        transitions[goal][goal] = 1.0
        for 1 <= int capital < goal
            transitions[capital][capital + 1] = chance
            transitions[capital][capital - 1] = 1.0 - chance
        auto chain = Chain(names, transitions)
        AbsorptionResult result = absorption(chain)
        real[] ruin = array(nat(goal + 1), fill = real(0))
        real[] duration = array(nat(goal + 1), fill = real(0))
        ruin[0] = 1.0
        for 1 <= int capital < goal
            ruin[capital] = result.chances[capital - 1][0]
            duration[capital] = result.means[capital - 1]
        .chains.set(name, chain)
        emit("GAMBLER {name} g={goal} p={fraction_text(chance)} start=s{start} ruin={value_text(ruin[start])} duration={value_text(duration[start])}")
        for 0 <= int capital <= goal
            emit("CAPITAL s{capital} ruin={value_text(ruin[capital])} win={value_text(1.0 - ruin[capital])} duration={value_text(duration[capital])}")
    return void

void | error command(map.Map<string, Chain> &chains, const string[] words)
    string op = words[0]
    string name = words[1]
    if op == "CHAIN" or op == "BUILD" or op == "GAMBLER"
        return create(&chains, words)
    Chain chain
    match chains.get(name)
        Chain found
            chain = found
        none
            return error("UNKNOWN CHAIN " + name)
    int size = int(len(chain.names))
    int[] states = state_numbers(chain)
    if op == "P"
        int source = try state_index(chain, words[2])
        int target = try state_index(chain, words[3])
        real chance = try probability(words[4])
        chain.transitions[source][target] = chance
        .chains.set(name, chain)
        emit("P {name} {words[2]} {words[3]} {fraction_text(chance)} rowsum={fraction_text(ordered_sum(chain.transitions[source]))}")
        return void
    elif op == "ROW"
        int source = try state_index(chain, words[2])
        if int(len(words)) - 3 != size
            return error("BAD LENGTH")
        real[] entries = try probability_row(words[3:])
        chain.transitions[source] = entries
        .chains.set(name, chain)
        emit("ROW {name} {words[2]} rowsum={fraction_text(ordered_sum(entries))}")
        return void
    elif op == "SHOW"
        emit("MATRIX {name} states={size}")
        display(chain.names, chain.transitions)
        return void
    elif op == "CHECK"
        real[] totals = [for real[] entries = chain.transitions[] then ordered_sum(entries)]
        int[] bad = [for int index = states[] if totals[index] != 1.0 then index]
        emit("CHECK {name} " + (if len(bad) == 0 then "ok" else "bad={len(bad)}"))
        for int index = bad[]
            emit("BADROW {chain.names[index]} sum={fraction_text(totals[index])}")
        return void
    for int index = states[]
        if ordered_sum(chain.transitions[index]) != 1.0
            return error("NOT STOCHASTIC " + chain.names[index])
    Graph graph = decompose(chain)
    if op == "CLASSES"
        emit("CLASSES {name} count={len(graph.classes)}")
        for nat index = graph.classes.indices()[]
            Component group = graph.classes[index]
            string kind = if group.closed then "RECURRENT" else "TRANSIENT"
            emit("CLASS {index + 1} {kind} period={group.period} size={len(group.members)} " + labels(chain, group.members))
            if group.period >= 2
                for 0 <= int residue < group.period
                    int[] selected = [for int member = group.members[] if group.levels[member] % group.period == residue then member]
                    emit("CYCLIC {residue} " + labels(chain, selected))
    elif op == "CLASSIFY"
        int[] absorbing = absorbing_states(chain)
        bool absorbs = len(absorbing) > 0
        for int source = states[]
            bool reaches = false
            for int target = absorbing[]
                reaches = reaches or graph.reachable[source][target]
            absorbs = absorbs and reaches
        int exponent = regular_exponent(chain)
        string exponent_text = if exponent == 0 then "-" else exponent.string()
        emit("CLASSIFY {name} absorbing_states={len(absorbing)} absorbing={yes(absorbs)} ergodic={yes(len(graph.classes) == 1)} regular={yes(exponent > 0)} exponent={exponent_text}")
    elif op == "STEP"
        string initial = words[2]
        int steps = parse_integer(words[3])
        real[] distribution = array(nat(size), fill = real(0))
        if "0123456789".contains(initial[0])
            string[] entries = initial.split(",")
            if int(len(entries)) != size
                return error("BAD LENGTH")
            distribution = try probability_row(entries)
            if ordered_sum(distribution) != 1.0
                return error("BAD DISTRIBUTION")
        else
            int source = try state_index(chain, initial)
            distribution[source] = 1.0
        for 0 <= int iteration < steps
            distribution = multiply([distribution], chain.transitions)[0]
        emit("STEP {name} k={steps}")
        for int index = states[]
            emit("PROB {chain.names[index]} {value_text(distribution[index])}")
    elif op == "POWER"
        int steps = parse_integer(words[2])
        real[][] power = identity(size)
        for 0 <= int iteration < steps
            power = multiply(power, chain.transitions)
        emit("POWER {name} k={steps}")
        display(chain.names, power)
    elif op == "STATIONARY"
        int[] closed = [for nat index = graph.classes.indices()[] if graph.classes[index].closed then int(index)]
        emit("STATIONARY {name} count={len(closed)}")
        int ordinal = 0
        for int index = closed[]
            int[] members = graph.classes[index].members
            real[] pi = stationary(chain, members)
            ordinal += 1
            emit("DIST {ordinal} class={index + 1} size={len(members)}")
            for nat position = members.indices()[]
                emit("PI {chain.names[members[position]]} {value_text(pi[position])}")
    elif op == "RECURRENCE"
        int source = try state_index(chain, words[2])
        Component group = graph.classes[graph.membership[source]]
        if not group.closed
            return error("TRANSIENT STATE " + words[2])
        real[] pi = stationary(chain, group.members)
        for nat index = group.members.indices()[]
            if group.members[index] == source
                real rho = pi[index]
                emit("RECURRENCE {name} {words[2]} pi={value_text(rho)} mean={value_text(1.0 / rho)} period={group.period}")
    elif op == "ABSORB"
        int[] absorbing = absorbing_states(chain)
        if len(absorbing) == 0
            return error("NO ABSORBING STATE")
        for int source = states[]
            bool reaches = false
            for int target = absorbing[]
                reaches = reaches or graph.reachable[source][target]
            if not reaches
                return error("NOT ABSORBING " + chain.names[source])
        AbsorptionResult result = absorption(chain)
        emit("ABSORB {name} transient={len(result.transient)} absorbing={len(absorbing)}")
        if len(result.transient) == 0
            return void
        emit("TRANSIENT " + labels(chain, result.transient))
        emit("ABSORBING " + labels(chain, absorbing))
        for nat index = result.transient.indices()[]
            string[] entries = [for real chance = result.fundamental[index][] then fraction_text(chance)]
            emit("N {chain.names[result.transient[index]]} " + entries.join(" "))
        for nat index = result.transient.indices()[]
            emit("STEPS {chain.names[result.transient[index]]} mean={value_text(result.means[index])} var={value_text(result.variances[index])}")
        for nat index = result.transient.indices()[]
            string[] entries = [for real chance = result.chances[index][] then fraction_text(chance)]
            emit("B {chain.names[result.transient[index]]} " + entries.join(" "))
    elif op == "HITTING"
        int[] targets = try state_set(chain, words[2:])
        HittingResult result = hitting(chain, targets, graph.reachable)
        emit("HITTING {name} targets=" + labels(chain, targets, ","))
        for int index = states[]
            string duration = if result.chances[index] == 1.0 then value_text(result.durations[index]) else "inf"
            emit("HIT {chain.names[index]} prob={value_text(result.chances[index])} time={duration}")
    elif op == "PASSAGE"
        real[] pi = try irreducible(chain, graph)
        real[][] passage = matrix(size, size)
        for int target = states[]
            HittingResult result = hitting(chain, [target], graph.reachable)
            for int source = states[]
                passage[source][target] = if source == target then 1.0 / pi[target] else result.durations[source]
        real kemeny = ordered_sum(pi[1:] * passage[0][1:])
        emit("PASSAGE {name} kemeny={value_text(kemeny)}")
        display(chain.names, passage, "M")
    elif op == "FIRSTPASSAGE"
        int source = try state_index(chain, words[2])
        int target = try state_index(chain, words[3])
        int steps = parse_integer(words[4])
        if steps == 0
            return error("BAD STEPS")
        real[] previous = [for real[] entries = chain.transitions[] then entries[target]]
        real[] first = []
        real[] cumulative = []
        real total = 0.0
        int[] others = [for int index = states[] if index != target then index]
        for 1 <= int iteration <= steps
            first = first.append(previous[source])
            total += previous[source]
            cumulative = cumulative.append(total)
            if iteration == steps
                break
            previous = [for real[] entries = chain.transitions[] then ordered_sum(entries[others] * previous[others])]
        emit("FIRSTPASSAGE {name} {words[2]} {words[3]} k={steps} total={value_text(total)}")
        for nat index = first.indices()[]
            emit("FP {index + 1} {value_text(first[index])} cum={value_text(cumulative[index])}")
    elif op == "PATHPROB"
        int[] path = []
        for string token = words[2:][]
            int index = try state_index(chain, token)
            path = path.append(index)
        real chance = 1.0
        int zero_at = 0
        for 1 <= int index < int(len(path))
            chance *= chain.transitions[path[index - 1]][path[index]]
            if chance == 0.0 and zero_at == 0
                zero_at = index
        string ending = if zero_at == 0 then "" else " zero_at={zero_at}"
        emit("PATHPROB {name} steps={int(len(path)) - 1} prob={value_text(chance)}{ending}")
    elif op == "MOSTLIKELY"
        int start = try state_index(chain, words[2])
        int steps = parse_integer(words[3])
        if steps == 0
            return error("BAD STEPS")
        real[][] best = matrix(steps + 1, size)
        best[steps] = array(nat(size), fill = real(1))
        for steps > int iteration >= 0
            for int source = states[]
                best[iteration][source] = math.max_all(chain.transitions[source] * best[iteration + 1])
        int[] path = [start]
        for 0 <= int iteration < steps
            int current = path[len(path) - 1]
            for int target = states[]
                if chain.transitions[current][target] * best[iteration + 1][target] == best[iteration][current]
                    path = path.append(target)
                    break
        emit("MOSTLIKELY {name} {words[2]} k={steps} prob={value_text(best[0][start])}")
        emit("PATH " + labels(chain, path))
    elif op == "REVERSIBLE" or op == "REVERSE"
        real[] pi = try irreducible(chain, graph)
        if op == "REVERSIBLE"
            string[] violations = []
            for int source = states[]
                for source + 1 <= int target < size
                    real forward = pi[source] * chain.transitions[source][target]
                    real backward = pi[target] * chain.transitions[target][source]
                    if forward != backward
                        violations = violations.append("VIOLATION {chain.names[source]} {chain.names[target]} {value_text(forward)} {value_text(backward)}")
            emit("REVERSIBLE {name} " + (if len(violations) == 0 then "yes" else "no violations={len(violations)}"))
            for string line = violations[]
                emit(line)
        else
            real[][] reversed = matrix(size, size)
            for int source = states[]
                for int target = states[]
                    reversed[source][target] = pi[target] * chain.transitions[target][source] / pi[source]
            .chains.set(words[2], Chain(chain.names, reversed))
            emit("REVERSE {name} {words[2]} reversible={yes(reversed == chain.transitions)}")
            display(chain.names, reversed)
    elif op == "MIXING"
        int steps = parse_integer(words[2])
        if steps == 0
            return error("BAD STEPS")
        real epsilon = try probability(words[3])
        real[] pi = try irreducible(chain, graph)
        real[][] power = identity(size)
        real[] distances = []
        int[] worst = []
        int mixing_time = 0
        for 1 <= int iteration <= steps
            power = multiply(power, chain.transitions)
            real[] row_distances = [for real[] entries = power[] then ordered_sum(math.abs(entries - pi)) / 2.0]
            real greatest = math.max_all(row_distances)
            distances = distances.append(greatest)
            for int index = states[]
                if row_distances[index] == greatest
                    worst = worst.append(index)
                    break
            if mixing_time == 0 and greatest <= epsilon
                mixing_time = iteration
        string duration = if mixing_time == 0 then "none" else mixing_time.string()
        emit("MIXING {name} k={steps} eps={fraction_text(epsilon)} time={duration}")
        for nat index = distances.indices()[]
            emit("TV {index + 1} {value_text(distances[index])} from={chain.names[worst[index]]}")
    elif op == "LUMP"
        int[][] blocks = []
        bool[] seen = array(nat(size), fill = false)
        for string block = words[3].split("|")[]
            int[] members = []
            for string token = block.split(",")[]
                int index = try state_index(chain, token)
                if seen[index]
                    return error("BAD PARTITION")
                seen[index] = true
                members = members.append(index)
            blocks = blocks.append(members.sorted())
        for bool included = seen[]
            if not included
                return error("BAD PARTITION")
        int[] heads = [for int[] block = blocks[] then block[0]]
        int[] representatives = heads.sorted()
        int[][] ordered = []
        for int representative = representatives[]
            for int[] block = blocks[]
                if block[0] == representative
                    ordered = ordered.append(block)
        blocks = ordered
        real[][] lumped = matrix(int(len(blocks)), int(len(blocks)))
        for nat source = blocks.indices()[]
            for nat target = blocks.indices()[]
                int representative = blocks[source][0]
                real expected = block_sum(chain, representative, blocks[target])
                for int member = blocks[source][]
                    real actual = block_sum(chain, member, blocks[target])
                    if actual != expected
                        emit("LUMP {name} not lumpable block={chain.names[representative]} target={chain.names[blocks[target][0]]} {chain.names[representative]}={value_text(expected)} {chain.names[member]}={value_text(actual)}")
                        return void
                lumped[source][target] = expected
        string[] names = chain.names[representatives]
        .chains.set(words[2], Chain(names, lumped))
        emit("LUMP {name} {words[2]} blocks={len(blocks)}")
        display(names, lumped)
    elif op == "REWARD"
        if int(len(words)) - 3 != size
            return error("BAD LENGTH")
        real gamma = try probability(words[2])
        if gamma == 1.0
            return error("BAD DISCOUNT")
        real[] rewards = [for string token = words[3:][] then real(parse_integer(token))]
        real[][] rows = matrix(size, size + 1)
        for int source = states[]
            for int target = states[]
                rows[source][target] = unit_value(source, target) - gamma * chain.transitions[source][target]
            rows[source][size] = rewards[source]
        real[][] discounted = solve(rows)
        real[] gains = array(nat(size), fill = real(0))
        for Component group = graph.classes[]
            if not group.closed
                continue
            real[] pi = stationary(chain, group.members)
            real average = ordered_sum(pi * rewards[group.members])
            HittingResult result = hitting(chain, group.members, graph.reachable, with_times = false)
            gains += result.chances * average
        emit("REWARD {name} gamma={fraction_text(gamma)}")
        for int index = states[]
            emit("VALUE {chain.names[index]} discounted={value_text(discounted[index][0])} gain={value_text(gains[index])}")
    elif op == "RESTRICT"
        int[] selected = try state_set(chain, words[3:])
        bool[] inside = array(nat(size), fill = false)
        for int member = selected[]
            inside[member] = true
        for int source = selected[]
            for int target = states[]
                if not inside[target] and chain.transitions[source][target] > 0.0
                    return error("NOT CLOSED " + chain.names[source])
        real[][] restricted = [for int member = selected[] then chain.transitions[member][selected]]
        string[] names = chain.names[selected]
        .chains.set(words[2], Chain(names, restricted))
        emit("RESTRICT {name} {words[2]} states={len(selected)}")
        display(names, restricted)
    elif op == "SIMULATE"
        int start = try state_index(chain, words[2])
        int steps = parse_integer(words[3])
        if steps == 0
            return error("BAD STEPS")
        int seed = parse_integer(words[4])
        if seed == 0 or seed >= 2147483647
            return error("BAD SEED")
        int generator = seed
        int current = start
        int[] path = [start]
        int[] visits = array(nat(size), fill = 0)
        visits[start] = 1
        for 0 <= int iteration < steps
            int common = 1
            for real chance = chain.transitions[current][]
                Ratio parts = ratio_parts(chance)
                common = common / gcd(common, parts.denominator) * parts.denominator
            generator = 48271 * generator % 2147483647
            int threshold = generator % common
            real cumulative = 0.0
            for int target = states[]
                cumulative += chain.transitions[current][target]
                if cumulative * real(common) > real(threshold)
                    current = target
                    break
            path = path.append(current)
            visits[current] += 1
        emit("SIMULATE {name} {words[2]} steps={steps} seed={seed} end={chain.names[current]}")
        emit("PATH " + labels(chain, path))
        for int index = states[]
            emit("VISIT {chain.names[index]} {visits[index]}")
    return void

string count_line
scan(&count_line)
int count = parse_integer(count_line)
map.Map<string, Chain> chains = map.Map<string, Chain>()
for 0 <= int command_number < count
    string line
    scan(&line)
    match command(&chains, line.split(" "))
        void
            continue
        error problem
            emit("ERROR " + problem.message)
