import math

// All monetary amounts and calendar values are exact integers.
int parse_integer(string text)
    return int.parse(text)

int cents(string text)
    string[] parts = text.split(".")
    return parse_integer(parts[0]) * 100 + parse_integer(parts[1])

string money(int value)
    return "{value / 100}.{value % 100:int=2,zero}"

string folded(string text)
    string result = ""
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower = "abcdefghijklmnopqrstuvwxyz"
    for 0 <= int k < int(len(text))
        string character = text[k]
        match upper.find(character)
            nat position
                result += lower[position]
            none
                result += character
    return result

bool before(string a, string b)
    int[] aa = a.codepoints()
    int[] bb = b.codepoints()
    for 0 <= int k < math.min(int(len(aa)), int(len(bb)))
        if aa[k] != bb[k]
            return aa[k] < bb[k]
    return len(aa) < len(bb)

string padded(int value)
    return "{value:int=8,zero}"

string isbn_value(string text)
    string raw = [for 0 <= int k < int(len(text)) if text[k] != "-" then text[k]].join("")
    if len(raw) != 10 and len(raw) != 13
        return ""
    int total = 0
    for 0 <= int k < int(len(raw))
        int digit
        match "0123456789".find(raw[k])
            nat position
                digit = int(position)
            none
                digit = -1
        if len(raw) == 10 and k == 9 and raw[k] == "X"
            digit = 10
        if digit < 0
            return ""
        total += digit * (if len(raw) == 10 then 10 - k elif k % 2 == 0 then 1 else 3)
    if len(raw) == 10
        if total % 11 != 0
            return ""
        raw = "978" + raw[:<9]
        total = 0
        for 0 <= int k < 12
            total += parse_integer(raw[k]) * (if k % 2 == 0 then 1 else 3)
        return raw + ((10 - total % 10) % 10).string()
    if total % 10 != 0 or (not raw.starts_with("978") and not raw.starts_with("979"))
        return ""
    return raw

class Charge(int day, string kind, int title, int amount, int unpaid)
class Patron(string id, string category, string name, Charge[] items, string[] history)
class Title(string isbn, string name, int price, int[] copies, int[] queue, int borrowed)
class Copy(int title, int number, int status, int member, int loan_day, int due, int renewals, int expiry)
class Ordered(int index, string key)
class State()
    int day = 1
    int[] closed = []
    Patron[] patrons = []
    Title[] titles = []
    Copy[] copies = []
    int copy_used = 0
    // borrowed, returned, renewed, lost, fines, fees, prices, paid, waived
    int[] totals = array(9, fill = 0)

// Only growth copies existing records; ordinary additions write one slot.
void add_copy(State &state, Copy item)
    if state.copy_used == int(len(state.copies))
        int capacity = math.max(16, 2 * int(len(state.copies)))
        Copy[] grown = array(nat(capacity), fill = Copy(-1, 0, 0, -1, 0, 0, 0, 0))
        for 0 <= int k < state.copy_used
            grown[k] = state.copies[k]
        state.copies = grown
    state.copies[state.copy_used] = item
    state.copy_used += 1

void emit(string text)
    print(text + NL)

void error_line(string reason)
    emit("ERROR " + reason)

int[] ordered(Ordered[] entries)
    for 1 <= int k < int(len(entries))
        Ordered item = entries[k]
        int position = k
        while position > 0 and before(item.key, entries[position - 1].key)
            entries[position] = entries[position - 1]
            position -= 1
        entries[position] = item
    return [for Ordered item = entries[] then item.index]

int member_id(const State state, string text)
    for 0 <= int k < int(len(state.patrons))
        if state.patrons[k].id == text
            return k
    return -1

int title_id(const State state, string text)
    for 0 <= int k < int(len(state.titles))
        if state.titles[k].isbn == text
            return k
    return -1

int[] title_order(const State state)
    return ordered([for 0 <= int k < int(len(state.titles)) then Ordered(k, state.titles[k].isbn)])

int[] member_order(const State state)
    return ordered([for 0 <= int k < int(len(state.patrons)) then Ordered(k, state.patrons[k].id)])

int rule(const State state, int person, int field)
    int[] student = [3, 14, 25, 1000, 2, 50]
    int[] staff = [10, 28, 10, 2000, 5, 100]
    return if state.patrons[person].category == "STUDENT" then student[field] else staff[field]

bool is_closed(const State state, int date)
    for int entry = state.closed[]
        if entry == date
            return true
    return false

int open_day(const State state, int date)
    while is_closed(state, date)
        date += 1
    return date

int balance(const State state, int person)
    int[] unpaid = [for Charge item = state.patrons[person].items[] then item.unpaid]
    return unpaid.sum()

int[] counts(const State state, int book = -1)
    int[] result = array(5, fill = 0)
    if book >= 0
        for int index = state.titles[book].copies[]
            result[state.copies[index].status] += 1
    else
        for 0 <= int copy_index < state.copy_used
            Copy item = state.copies[copy_index]
            result[item.status] += 1
    return result

int holdings(const State state, int book)
    int[] values = counts(state, book)
    return values[:<3].sum()

int queue_position(const State state, int person, int book)
    for 0 <= int k < int(len(state.titles[book].queue))
        if state.titles[book].queue[k] == person
            return k
    return -1

int copy_of(const State state, int person, int book, int status)
    for int index = state.titles[book].copies[]
        if state.copies[index].status == status and state.copies[index].member == person
            return index
    return -1

int[] member_copies(const State state, int person, int status, bool isbn_only = false)
    Ordered[] entries = []
    for 0 <= int k < state.copy_used
        Copy item = state.copies[k]
        if item.status == status and item.member == person
            string key = state.titles[item.title].isbn
            if not isbn_only
                key = padded(if status == 1 then item.due else item.expiry) + key
            entries = entries.append(Ordered(k, key))
    return ordered(entries)

int reservations(const State state, int person)
    int result = int(len(member_copies(state, person, 2)))
    for 0 <= int k < int(len(state.titles))
        if queue_position(state, person, k) >= 0
            result += 1
    return result

int late_days(const State state, int index)
    return math.max(0, state.day - state.copies[index].due)

int fine_amount(const State state, int index)
    return math.min(late_days(state, index) * rule(state, state.copies[index].member, 2), rule(state, state.copies[index].member, 3))

void charge(State &state, int person, int book, string kind, int amount)
    if amount > 0
        state.patrons[person].items = state.patrons[person].items.append(Charge(state.day, kind, book, amount, amount))
        state.totals[if kind == "FINE" then 4 elif kind == "FEE" then 5 else 6] += amount

void release_copy(State &state, int index)
    int book = state.copies[index].title
    state.copies[index].member = -1
    if len(state.titles[book].queue) == 0
        state.copies[index].status = 0
        return
    int person = state.titles[book].queue[0]
    state.titles[book].queue = state.titles[book].queue[1:]
    state.copies[index].status = 2
    state.copies[index].member = person
    state.copies[index].expiry = open_day(state, state.day + 3)
    emit("HOLD " + state.titles[book].isbn + " copy " + state.copies[index].number.string() + " " + state.patrons[person].id + " until " + state.copies[index].expiry.string())

void end_loan(State &state, int index, bool lost)
    Copy item = state.copies[index]
    int late = late_days(state, index)
    int amount = fine_amount(state, index)
    charge(&state, item.member, item.title, "FINE", amount)
    string entry = (if lost then "LOST" else "RETURNED") + " " + state.titles[item.title].isbn + " copy " + item.number.string() + " from " + item.loan_day.string() + " to " + state.day.string() + " late " + late.string() + " fine " + money(amount)
    if lost
        entry += " price " + money(state.titles[item.title].price)
    state.patrons[item.member].history = state.patrons[item.member].history.append(entry)

void lose_copy(State &state, int index, string heading)
    Copy item = state.copies[index]
    int late = late_days(state, index)
    int amount = fine_amount(state, index)
    end_loan(&state, index, true)
    charge(&state, item.member, item.title, "PRICE", state.titles[item.title].price)
    state.copies[index].status = 3
    state.totals[3] += 1
    emit(heading + " " + state.patrons[item.member].id + " " + state.titles[item.title].isbn + " copy " + item.number.string() + " late " + late.string() + " fine " + money(amount) + " price " + money(state.titles[item.title].price) + " balance " + money(balance(state, item.member)))
    if holdings(state, item.title) == 0
        for int person = state.titles[item.title].queue[]
            emit("DROPPED " + state.titles[item.title].isbn + " " + state.patrons[person].id)
        state.titles[item.title].queue = []

void advance_day(State &state, int target)
    emit("DAY " + target.string())
    while true
        int next_day = target + 1
        for 0 <= int copy_index < state.copy_used
            Copy item = state.copies[copy_index]
            if item.status == 1
                next_day = math.min(next_day, math.max(state.day + 1, item.due + 365))
            elif item.status == 2
                next_day = math.min(next_day, math.max(state.day + 1, item.expiry + 1))
        if next_day > target
            state.day = target
            return
        state.day = next_day
        Ordered[] losses = []
        for 0 <= int k < state.copy_used
            Copy item = state.copies[k]
            if item.status == 1 and item.due + 365 <= state.day
                losses = losses.append(Ordered(k, state.patrons[item.member].id + " " + state.titles[item.title].isbn))
        for int index = ordered(losses)[]
            lose_copy(&state, index, "AUTOLOST")
        // Snapshot expiry candidates only after the complete loss stage.
        Ordered[] expiries = []
        for 0 <= int k < state.copy_used
            Copy item = state.copies[k]
            if item.status == 2 and item.expiry < state.day
                expiries = expiries.append(Ordered(k, state.titles[item.title].isbn + padded(item.number)))
        for int index = ordered(expiries)[]
            Copy item = state.copies[index]
            int amount = rule(state, item.member, 5)
            charge(&state, item.member, item.title, "FEE", amount)
            emit("EXPIRED " + state.titles[item.title].isbn + " copy " + item.number.string() + " " + state.patrons[item.member].id + " fee " + money(amount))
            release_copy(&state, index)

string renewal_error(const State state, int index)
    Copy item = state.copies[index]
    if item.due < state.day
        return "loan overdue"
    if item.renewals == 2
        return "renewal limit"
    if len(state.titles[item.title].queue) > 0
        return "title reserved"
    return ""

void renew_copy(State &state, int index)
    int person = state.copies[index].member
    state.copies[index].due = open_day(state, state.day + rule(state, person, 1))
    state.copies[index].renewals += 1
    state.totals[2] += 1
    emit("RENEW " + state.patrons[person].id + " " + state.titles[state.copies[index].title].isbn + " copy " + state.copies[index].number.string() + " due " + state.copies[index].due.string() + " renewals " + state.copies[index].renewals.string())

void command(State &state, string line)
    string[] words = line.split(" ")
    string action = words[0]
    if action == "DAY" or action == "CLOSED"
        int date = parse_integer(words[1])
        if date <= state.day
            error_line("invalid day")
        elif action == "DAY"
            advance_day(&state, date)
        elif is_closed(state, date)
            error_line("already closed")
        else
            state.closed = state.closed.append(date)
            emit("CLOSED " + date.string())
            for int book = title_order(state)[]
                for int index = state.titles[book].copies[]
                    Copy item = state.copies[index]
                    if (item.status == 1 and item.due == date) or (item.status == 2 and item.expiry == date)
                        int replacement = open_day(state, date)
                        if item.status == 1
                            state.copies[index].due = replacement
                        else
                            state.copies[index].expiry = replacement
                        emit("MOVED " + state.titles[book].isbn + " copy " + item.number.string() + " " + state.patrons[item.member].id + (if item.status == 1 then " due " else " until ") + replacement.string())
        return
    if action == "ADDMEMBER"
        if member_id(state, words[1]) >= 0
            error_line("duplicate member")
        elif words[2] != "STUDENT" and words[2] != "STAFF"
            error_line("unknown type")
        else
            state.patrons = state.patrons.append(Patron(words[1], words[2], words[3:].join(" "), [], []))
            int person = int(len(state.patrons)) - 1
            emit("ADDMEMBER " + words[1] + " " + words[2] + " loans " + rule(state, person, 0).string() + " days " + rule(state, person, 1).string())
        return
    if action == "ADDBOOK" or action == "WITHDRAW" or action == "BOOK"
        string normalized = isbn_value(words[1])
        int book = title_id(state, normalized)
        if normalized == ""
            error_line("invalid isbn")
            return
        if action != "ADDBOOK" and book < 0
            error_line("unknown book")
            return
        if action == "ADDBOOK"
            string name = words[4:].join(" ")
            if book >= 0 and state.titles[book].name != name
                error_line("title mismatch")
                return
            int price = cents(words[3])
            if book < 0
                book = int(len(state.titles))
                state.titles = state.titles.append(Title(normalized, name, price, [], [], 0))
            state.titles[book].price = price
            int count = parse_integer(words[2])
            int first = state.copy_used
            for 0 <= int k < count
                int index = state.copy_used
                int number = int(len(state.titles[book].copies)) + 1
                add_copy(&state, Copy(book, number, 0, -1, 0, 0, 0, 0))
                state.titles[book].copies = state.titles[book].copies.append(index)
            emit("ADDBOOK " + normalized + " added " + count.string() + " total " + holdings(state, book).string())
            for first <= int index < first + count
                release_copy(&state, index)
        elif action == "WITHDRAW"
            int number = parse_integer(words[2])
            if number < 1 or number > int(len(state.titles[book].copies))
                error_line("unknown copy")
            else
                int index = state.titles[book].copies[number - 1]
                if state.copies[index].status != 0
                    error_line("copy not available")
                else
                    state.copies[index].status = 4
                    emit("WITHDRAW " + normalized + " copy " + number.string() + " total " + holdings(state, book).string())
        else
            Title item = state.titles[book]
            emit("BOOK " + item.isbn + " " + item.name)
            emit("PRICE " + money(item.price) + " copies " + holdings(state, book).string() + " borrowed " + item.borrowed.string())
            for int index = item.copies[]
                Copy copy = state.copies[index]
                string text = "COPY " + copy.number.string() + " " + ["AVAILABLE", "LOANED", "HOLD", "LOST", "WITHDRAWN"][copy.status]
                if copy.status == 1 or copy.status == 2
                    text += " " + state.patrons[copy.member].id + (if copy.status == 1 then " due " else " until ") + (if copy.status == 1 then copy.due else copy.expiry).string()
                emit(text)
            string text = "QUEUE " + len(item.queue).string()
            for int person = item.queue[]
                text += " " + state.patrons[person].id
            emit(text)
        return
    string[] personal = ["BORROW", "RETURN", "RENEW", "RENEWALL", "RESERVE", "CANCEL", "LOST", "PAYFINE", "WAIVE", "FINES", "MEMBER", "HISTORY"]
    bool needs_member = false
    for string name = personal[]
        if action == name
            needs_member = true
    if needs_member
        int person = member_id(state, words[1])
        if person < 0
            error_line("unknown member")
            return
        int loan_count = int(len(member_copies(state, person, 1)))
        int reserved_count = reservations(state, person)
        int outstanding = balance(state, person)
        string id = state.patrons[person].id
        if action == "PAYFINE"
            if outstanding == 0
                error_line("no fines")
                return
            int offered = cents(words[2])
            int remaining = offered
            string[] details = []
            for 0 <= int k < int(len(state.patrons[person].items))
                int applied = math.min(remaining, state.patrons[person].items[k].unpaid)
                if applied > 0
                    state.patrons[person].items[k].unpaid -= applied
                    remaining -= applied
                    details = details.append("ITEM " + (k + 1).string() + " " + state.patrons[person].items[k].kind + " paid " + money(applied) + " remaining " + money(state.patrons[person].items[k].unpaid))
            state.totals[7] += offered - remaining
            emit("PAYFINE " + id + " paid " + money(offered - remaining) + " change " + money(remaining) + " balance " + money(balance(state, person)))
            for string detail = details[]
                emit(detail)
            return
        if action == "WAIVE"
            int number = parse_integer(words[2])
            if number < 1 or number > int(len(state.patrons[person].items))
                error_line("unknown item")
            elif state.patrons[person].items[number - 1].unpaid == 0
                error_line("item settled")
            else
                int amount = state.patrons[person].items[number - 1].unpaid
                state.patrons[person].items[number - 1].unpaid = 0
                state.totals[8] += amount
                emit("WAIVE " + id + " item " + number.string() + " " + state.patrons[person].items[number - 1].kind + " amount " + money(amount) + " balance " + money(balance(state, person)))
            return
        if action == "FINES"
            int count = 0
            for Charge item = state.patrons[person].items[]
                if item.unpaid > 0
                    count += 1
            emit("FINES " + id + " items " + count.string() + " balance " + money(outstanding))
            for 0 <= int k < int(len(state.patrons[person].items))
                Charge item = state.patrons[person].items[k]
                if item.unpaid > 0
                    emit((k + 1).string() + " day " + item.day.string() + " " + item.kind + " " + state.titles[item.title].isbn + " amount " + money(item.amount) + " remaining " + money(item.unpaid))
            return
        if action == "HISTORY"
            emit("HISTORY " + id + " " + len(state.patrons[person].history).string())
            for string entry = state.patrons[person].history[]
                emit(entry)
            return
        if action == "MEMBER"
            emit("MEMBER " + id + " " + state.patrons[person].category + " " + state.patrons[person].name)
            emit("STATUS loans " + loan_count.string() + "/" + rule(state, person, 0).string() + " reservations " + reserved_count.string() + "/" + rule(state, person, 4).string() + " balance " + money(outstanding) + (if outstanding > 500 then " BLOCKED" else " OK"))
            for int index = member_copies(state, person, 1)[]
                Copy item = state.copies[index]
                string text = "LOAN " + state.titles[item.title].isbn + " copy " + item.number.string() + " due " + item.due.string() + " renewals " + item.renewals.string()
                if item.due < state.day
                    text += " late " + late_days(state, index).string() + " fine " + money(fine_amount(state, index))
                emit(text)
            for int index = member_copies(state, person, 2)[]
                Copy item = state.copies[index]
                emit("HOLD " + state.titles[item.title].isbn + " copy " + item.number.string() + " until " + item.expiry.string())
            for int book = title_order(state)[]
                int position = queue_position(state, person, book)
                if position >= 0
                    emit("QUEUE " + state.titles[book].isbn + " position " + (position + 1).string())
            return
        if action == "RENEWALL"
            if loan_count == 0
                error_line("no loans")
            elif outstanding > 500
                error_line("member blocked")
            else
                int renewed = 0
                int skipped = 0
                for int index = member_copies(state, person, 1, true)[]
                    string reason = renewal_error(state, index)
                    if reason != ""
                        emit("SKIP " + state.titles[state.copies[index].title].isbn + " " + reason)
                        skipped += 1
                    else
                        renew_copy(&state, index)
                        renewed += 1
                emit("RENEWALL " + id + " renewed " + renewed.string() + " skipped " + skipped.string())
            return
        string normalized = isbn_value(words[2])
        int book = title_id(state, normalized)
        if normalized == ""
            error_line("invalid isbn")
            return
        if book < 0
            error_line("unknown book")
            return
        int loan = copy_of(state, person, book, 1)
        int hold = copy_of(state, person, book, 2)
        int position = queue_position(state, person, book)
        if action == "BORROW"
            bool overdue = false
            for int index = member_copies(state, person, 1)[]
                if state.copies[index].due < state.day
                    overdue = true
            int available = -1
            bool other_hold = false
            for int index = state.titles[book].copies[]
                if state.copies[index].status == 0 and available < 0
                    available = index
                if state.copies[index].status == 2
                    other_hold = true
            string reason = if is_closed(state, state.day) then "library closed" elif loan >= 0 then "already borrowed" elif outstanding > 500 then "member blocked" elif overdue then "overdue loans" elif loan_count >= rule(state, person, 0) then "loan limit" elif hold < 0 and available < 0 then (if other_hold then "all copies on hold" else "no copy available") else ""
            if reason != ""
                error_line(reason)
                return
            int index = if hold >= 0 then hold else available
            state.copies[index].status = 1
            state.copies[index].member = person
            state.copies[index].loan_day = state.day
            state.copies[index].due = open_day(state, state.day + rule(state, person, 1))
            state.copies[index].renewals = 0
            state.titles[book].borrowed += 1
            state.totals[0] += 1
            emit("BORROW " + id + " " + normalized + " copy " + state.copies[index].number.string() + " due " + state.copies[index].due.string())
        elif action == "RETURN" or action == "LOST" or action == "RENEW"
            if loan < 0
                error_line("not borrowed")
            elif action == "LOST"
                lose_copy(&state, loan, "LOST")
            elif action == "RENEW"
                string reason = if outstanding > 500 then "member blocked" else renewal_error(state, loan)
                if reason != ""
                    error_line(reason)
                else
                    renew_copy(&state, loan)
            else
                int late = late_days(state, loan)
                int amount = fine_amount(state, loan)
                end_loan(&state, loan, false)
                state.totals[1] += 1
                emit("RETURN " + id + " " + normalized + " copy " + state.copies[loan].number.string() + " late " + late.string() + " fine " + money(amount) + " balance " + money(balance(state, person)))
                release_copy(&state, loan)
        elif action == "CANCEL"
            if position < 0 and hold < 0
                error_line("not reserved")
            elif position >= 0
                state.titles[book].queue = state.titles[book].queue[:<position].concat(state.titles[book].queue[position + 1:])
                emit("CANCEL " + id + " " + normalized + " queue")
            else
                emit("CANCEL " + id + " " + normalized + " hold copy " + state.copies[hold].number.string())
                release_copy(&state, hold)
        else
            int[] values = counts(state, book)
            string reason = if loan >= 0 then "already borrowed" elif position >= 0 or hold >= 0 then "already reserved" elif outstanding > 500 then "member blocked" elif reserved_count >= rule(state, person, 4) then "reservation limit" elif holdings(state, book) == 0 then "no copies" elif values[0] > 0 then "copy available" else ""
            if reason != ""
                error_line(reason)
                return
            state.titles[book].queue = state.titles[book].queue.append(person)
            int count = int(len(state.titles[book].queue))
            Ordered[] estimates = []
            for int index = state.titles[book].copies[]
                if state.copies[index].status == 1
                    estimates = estimates.append(Ordered(index, padded(state.copies[index].due)))
            int[] due_order = ordered(estimates)
            string estimate = if int(len(due_order)) >= count then state.copies[due_order[count - 1]].due.string() else "none"
            emit("RESERVE " + id + " " + normalized + " position " + count.string() + " estimate " + estimate)
        return
    if action == "MEMBERS"
        emit("MEMBERS " + len(state.patrons).string())
        for int person = member_order(state)[]
            int outstanding = balance(state, person)
            emit(state.patrons[person].id + " " + state.patrons[person].category + " loans " + len(member_copies(state, person, 1)).string() + " reservations " + reservations(state, person).string() + " balance " + money(outstanding) + (if outstanding > 500 then " BLOCKED" else " OK"))
    elif action == "SEARCH"
        string keyword = folded(words[1:].join(" "))
        Ordered[] entries = []
        for 0 <= int k < int(len(state.titles))
            string name = folded(state.titles[k].name)
            if name.contains(keyword)
                entries = entries.append(Ordered(k, name + NL + state.titles[k].isbn))
        int[] found = ordered(entries)
        emit("SEARCH " + len(found).string())
        for int book = found[]
            int[] values = counts(state, book)
            emit(state.titles[book].isbn + " " + values[0].string() + "/" + holdings(state, book).string() + " " + state.titles[book].name)
    elif action == "INVENTORY"
        int[] values = counts(state)
        emit("INVENTORY titles " + len(state.titles).string() + " copies " + (values[0] + values[1] + values[2]).string() + " available " + values[0].string() + " loaned " + values[1].string() + " hold " + values[2].string() + " lost " + values[3].string() + " withdrawn " + values[4].string())
        for int book = title_order(state)[]
            int[] local_counts = counts(state, book)
            emit(state.titles[book].isbn + " copies " + holdings(state, book).string() + " available " + local_counts[0].string() + " loaned " + local_counts[1].string() + " hold " + local_counts[2].string() + " queue " + len(state.titles[book].queue).string())
    elif action == "OVERDUE"
        Ordered[] entries = []
        for 0 <= int k < state.copy_used
            Copy item = state.copies[k]
            if item.status == 1 and item.due < state.day
                entries = entries.append(Ordered(k, padded(item.due) + state.patrons[item.member].id + " " + state.titles[item.title].isbn))
        int[] found = ordered(entries)
        emit("OVERDUE " + len(found).string())
        for int index = found[]
            Copy item = state.copies[index]
            emit(state.patrons[item.member].id + " " + state.titles[item.title].isbn + " copy " + item.number.string() + " due " + item.due.string() + " late " + late_days(state, index).string() + " fine " + money(fine_amount(state, index)))
    elif action == "NOTICES"
        string[] notices = []
        for int person = member_order(state)[]
            for 0 <= int stage < 3
                for int index = member_copies(state, person, if stage == 2 then 2 else 1)[]
                    Copy item = state.copies[index]
                    if stage == 2 or (stage == 0 and item.due < state.day) or (stage == 1 and state.day <= item.due <= state.day + 2)
                        notices = notices.append(["OVERDUE", "DUESOON", "PICKUP"][stage] + " " + state.patrons[person].id + " " + state.titles[item.title].isbn + (if stage == 2 then " until " else " due ") + (if stage == 2 then item.expiry else item.due).string())
        emit("NOTICES " + len(notices).string())
        for string text = notices[]
            emit(text)
    else
        int[] values = counts(state)
        int[] balances = [for 0 <= int person < int(len(state.patrons)) then balance(state, person)]
        int outstanding = balances.sum()
        emit("STATS day " + state.day.string() + " titles " + len(state.titles).string() + " members " + len(state.patrons).string() + " closed " + len(state.closed).string())
        emit("LOANS borrowed " + state.totals[0].string() + " returned " + state.totals[1].string() + " renewed " + state.totals[2].string() + " lost " + state.totals[3].string() + " active " + values[1].string())
        emit("MONEY fines " + money(state.totals[4]) + " fees " + money(state.totals[5]) + " charges " + money(state.totals[6]) + " paid " + money(state.totals[7]) + " waived " + money(state.totals[8]) + " outstanding " + money(outstanding))
        Ordered[] entries = []
        for 0 <= int k < int(len(state.titles))
            if state.titles[k].borrowed > 0
                entries = entries.append(Ordered(k, padded(1001 - state.titles[k].borrowed) + state.titles[k].isbn))
        int[] ranking = ordered(entries)
        for 0 <= int k < math.min(3, int(len(ranking)))
            Title item = state.titles[ranking[k]]
            emit("TOP " + (k + 1).string() + " " + item.isbn + " " + item.borrowed.string() + " " + item.name)

if main
    int count = 0
    scan(&count)
    State state = State()
    for 0 <= int k < count
        string line = ""
        scan(&line)
        command(&state, line)
