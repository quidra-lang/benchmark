void emit(string text)
    print(text + NL)

bool includes(string[] items, string text)
    for string item = items[]
        if item == text
            return true
    return false

nat locate(string[] items, string text)
    for nat i < len(items)
        if items[i] == text
            return i
    return len(items)

nat[] ordered_set(nat[] items)
    nat[] result = []
    for nat item = items.sorted()[]
        if len(result) == 0 or result[len(result) - 1] != item
            result = result.append(item)
    return result

string index_key(nat[] items)
    return [for nat item = items[] then item.string()].join(",")

string sorted_alphabet(string text)
    return [for nat i < len(text) then text[i]].sorted().join("")

string[] series(string prefix, nat count)
    return [for nat i < count then prefix + i.string()]

string word_text(string text)
    return if text == "" then "e" else text

class Edge(nat source, nat column, nat target)
class Automaton(string kind, string[] states, string alphabet, nat start, nat[] accepting, nat[][][] cells)
    nat transition_count()
        nat result = 0
        for nat[][] row = cells[]
            for nat[] targets = row[]
                result += len(targets)
        return result

    string summary(string name)
        return kind + " " + name + ": alphabet=" + alphabet + " states={len(states)} accepting={len(accepting)} transitions={transition_count()}"

    string set_text(nat[] indices)
        return "{{" + [for nat i = ordered_set(indices)[] then states[i]].join(",") + "}}"

    string list_text(nat[] indices)
        return if len(indices) == 0 then "none" else [for nat i = ordered_set(indices)[] then states[i]].join(",")

    bool accepts(nat[] indices)
        for nat i = indices[]
            for nat member = accepting[]
                if i == member
                    return true
        return false

    nat[] closure(nat[] seeds)
        bool[] seen = [for nat i < len(states) then false]
        nat[] pending = []
        for nat item = seeds[]
            if not seen[item]
                seen[item] = true
                pending = pending.append(item)
        nat cursor = 0
        while cursor < len(pending)
            nat current = pending[cursor]
            cursor += 1
            for nat target = cells[current][len(alphabet)][]
                if not seen[target]
                    seen[target] = true
                    pending = pending.append(target)
        return [for nat i < len(states) if seen[i] then i]

    nat[] destination(nat[] source_set, nat symbol_index)
        nat[] targets = []
        for nat source = source_set[]
            targets = targets.concat(cells[source][symbol_index])
        return closure(ordered_set(targets))

    nat delta(nat source, nat symbol_index)
        return cells[source][symbol_index][0]

    bool has_epsilon()
        for nat i < len(states)
            if len(cells[i][len(alphabet)]) > 0
                return true
        return false

    nat[] reachable()
        bool[] seen = [for nat i < len(states) then false]
        nat[] pending = [start]
        seen[start] = true
        nat cursor = 0
        while cursor < len(pending)
            nat current = pending[cursor]
            cursor += 1
            for nat[] targets = cells[current][]
                for nat target = targets[]
                    if not seen[target]
                        seen[target] = true
                        pending = pending.append(target)
        return [for nat i < len(states) if seen[i] then i]

    nat[] live()
        nat[][] reverse_edges = [for nat i < len(states) then []]
        for nat source < len(states)
            for nat[] targets = cells[source][]
                for nat target = targets[]
                    reverse_edges[target] = reverse_edges[target].append(source)
        bool[] seen = [for nat i < len(states) then false]
        nat[] pending = accepting
        for nat item = pending[]
            seen[item] = true
        nat cursor = 0
        while cursor < len(pending)
            nat current = pending[cursor]
            cursor += 1
            for nat source = reverse_edges[current][]
                if not seen[source]
                    seen[source] = true
                    pending = pending.append(source)
        return [for nat i < len(states) if seen[i] then i]

Automaton make_automaton(string kind, string[] names, string alphabet, nat start, nat[] final_states, Edge[] edges)
    nat[][][] cells = [for nat i < len(names) then [for nat j <= len(alphabet) then []]]
    for Edge edge = edges[]
        cells[edge.source][edge.column] = cells[edge.source][edge.column].append(edge.target)
    for nat i < len(names)
        for nat j <= len(alphabet)
            cells[i][j] = ordered_set(cells[i][j])
    return Automaton(kind, names, alphabet, start, ordered_set(final_states), cells)

Edge[] all_edges(Automaton machine, nat offset = 0)
    Edge[] result = []
    for nat i < len(machine.states)
        for nat j <= len(machine.alphabet)
            for nat target = machine.cells[i][j][]
                result = result.append(Edge(i + offset, j, target + offset))
    return result

class Conversion(Automaton machine, string[] details)
Conversion determinize(Automaton machine)
    nat[][] subsets = [machine.closure([machine.start])]
    map.Map<string, nat> indices
    .indices.set(index_key(subsets[0]), 0)
    Edge[] edges = []
    nat[] final_states = []
    nat cursor = 0
    while cursor < len(subsets)
        nat[] current = subsets[cursor]
        if machine.accepts(current)
            final_states = final_states.append(cursor)
        for nat c < len(machine.alphabet)
            nat[] target = machine.destination(current, c)
            string key = index_key(target)
            nat target_index = len(subsets)
            match indices.get(key)
                nat found
                    target_index = found
                none
                    .indices.set(key, target_index)
                    subsets = subsets.append(target)
            edges = edges.append(Edge(cursor, c, target_index))
        cursor += 1
    string[] names = series("D", len(subsets))
    string[] details = [for nat i < len(subsets) then "  " + names[i] + " = " + machine.set_text(subsets[i])]
    return Conversion(make_automaton("DFA", names, machine.alphabet, 0, final_states, edges), details)

Conversion minimize_dfa(Automaton machine)
    nat[] reachable_states = machine.reachable()
    bool[] reachable_flags = [for nat i < len(machine.states) then false]
    for nat item = reachable_states[]
        reachable_flags[item] = true
    nat[] lost = [for nat i < len(machine.states) if not reachable_flags[i] then i]
    nat[][] blocks = []
    nat[] positive = [for nat i = reachable_states[] if machine.accepts([i]) then i]
    nat[] negative = [for nat i = reachable_states[] if not machine.accepts([i]) then i]
    if len(positive) > 0
        blocks = blocks.append(positive)
    if len(negative) > 0
        if len(blocks) > 0 and negative[0] < blocks[0][0]
            blocks = [negative].concat(blocks)
        else
            blocks = blocks.append(negative)
    string[] details = ["  unreachable: " + machine.list_text(lost), "  round 0: " + [for nat[] group = blocks[] then machine.set_text(group)].join(" ")]
    nat round_number = 1
    nat[] membership = [for nat i < len(machine.states) then 0]
    while true
        for nat i < len(blocks)
            for nat item = blocks[i][]
                membership[item] = i
        map.Map<string, nat> signatures
        nat[][] refined = []
        for nat item = reachable_states[]
            nat[] signature = [membership[item]]
            for nat c < len(machine.alphabet)
                signature = signature.append(membership[machine.delta(item, c)])
            string key = index_key(signature)
            nat group_index = len(refined)
            match signatures.get(key)
                nat found
                    group_index = found
                none
                    .signatures.set(key, group_index)
                    refined = refined.append([])
            refined[group_index] = refined[group_index].append(item)
        if len(refined) == len(blocks)
            break
        blocks = refined
        details = details.append("  round {round_number}: " + [for nat[] group = blocks[] then machine.set_text(group)].join(" "))
        round_number += 1
    nat[] order = [membership[machine.start]]
    nat[] renamed = [for nat i < len(blocks) then len(blocks)]
    renamed[order[0]] = 0
    Edge[] edges = []
    nat[] final_states = []
    nat cursor = 0
    while cursor < len(order)
        nat old_group = order[cursor]
        nat representative = blocks[old_group][0]
        if machine.accepts([representative])
            final_states = final_states.append(cursor)
        details = details.append("  M{cursor} = " + machine.set_text(blocks[old_group]))
        for nat c < len(machine.alphabet)
            nat target_group = membership[machine.delta(representative, c)]
            if renamed[target_group] == len(blocks)
                renamed[target_group] = len(order)
                order = order.append(target_group)
            edges = edges.append(Edge(cursor, c, renamed[target_group]))
        cursor += 1
    return Conversion(make_automaton("DFA", series("M", len(order)), machine.alphabet, 0, final_states, edges), details)

class RegexNode(string kind, string symbol = "", nat[] children = [])
class RegexReader(string text)
    nat cursor = 0
    RegexNode[] nodes = []

    string next_character()
        return if cursor == len(text) then "" else text[cursor]

    error problem()
        return error("syntax error at {cursor + 1}")

    nat .append_node(RegexNode item)
        nodes = nodes.append(item)
        return len(nodes) - 1

    nat | error .atom()
        string character = next_character()
        if character != "" and "abcdefghijklmnopqrstuvwxyz0123456789".contains(character)
            cursor += 1
            return .append_node(RegexNode("literal", character))
        if character != "("
            return problem()
        cursor += 1
        nat result = try .alternation()
        if next_character() != ")"
            return problem()
        cursor += 1
        return result

    nat | error .factor()
        nat result = try .atom()
        while next_character() != "" and "*+?".contains(next_character())
            string operation = next_character()
            cursor += 1
            result = .append_node(RegexNode(operation, children = [result]))
        return result

    nat | error .concatenation()
        nat[] parts = [try .factor()]
        while next_character() != "" and "abcdefghijklmnopqrstuvwxyz0123456789(".contains(next_character())
            parts = parts.append(try .factor())
        return if len(parts) == 1 then parts[0] else .append_node(RegexNode("concat", children = parts))

    nat | error .alternation()
        nat[] parts = [try .concatenation()]
        while next_character() == "|"
            cursor += 1
            parts = parts.append(try .concatenation())
        return if len(parts) == 1 then parts[0] else .append_node(RegexNode("alternate", children = parts))

    nat | error .parse()
        nat result = try .alternation()
        if cursor != len(text)
            return problem()
        return result

class Fragment(nat entry, nat exit)
class Thompson(RegexNode[] nodes, string alphabet)
    nat count = 0
    Edge[] edges = []

    nat .allocate()
        nat result = count
        count += 1
        return result

    void .connect(nat source, nat column, nat target)
        edges = edges.append(Edge(source, column, target))

    Fragment .construct(nat root)
        RegexNode item = nodes[root]
        nat epsilon = len(alphabet)
        if item.kind == "literal"
            nat entry = .allocate()
            nat exit = .allocate()
            nat column = epsilon
            if item.symbol != "e"
                for nat i < len(alphabet)
                    if alphabet[i] == item.symbol
                        column = i
            .connect(entry, column, exit)
            return Fragment(entry, exit)
        if item.kind == "concat"
            Fragment first = .construct(item.children[0])
            nat end_state = first.exit
            for 1 <= nat i < len(item.children)
                Fragment part = .construct(item.children[i])
                .connect(end_state, epsilon, part.entry)
                end_state = part.exit
            return Fragment(first.entry, end_state)
        nat entry = .allocate()
        if item.kind == "alternate"
            Fragment[] parts = []
            for nat child = item.children[]
                parts = parts.append(.construct(child))
            nat exit = .allocate()
            for Fragment part = parts[]
                .connect(entry, epsilon, part.entry)
                .connect(part.exit, epsilon, exit)
            return Fragment(entry, exit)
        Fragment inner = .construct(item.children[0])
        nat exit = .allocate()
        .connect(entry, epsilon, inner.entry)
        .connect(inner.exit, epsilon, exit)
        if item.kind != "?"
            .connect(inner.exit, epsilon, inner.entry)
        if item.kind != "+"
            .connect(entry, epsilon, exit)
        return Fragment(entry, exit)

class LanguageStatus(bool empty, bool infinite)
LanguageStatus language_status(Automaton machine)
    nat[] live_states = machine.live()
    bool[] useful = [for nat i < len(machine.states) then false]
    for nat item = live_states[]
        useful[item] = true
    if not useful[machine.start]
        return LanguageStatus(true, false)
    nat[] indegree = [for nat i < len(machine.states) then 0]
    for nat source = live_states[]
        for nat c < len(machine.alphabet)
            nat target = machine.delta(source, c)
            if useful[target]
                indegree[target] += 1
    nat[] pending = [for nat item = live_states[] if indegree[item] == 0 then item]
    nat cursor = 0
    while cursor < len(pending)
        nat source = pending[cursor]
        cursor += 1
        for nat c < len(machine.alphabet)
            nat target = machine.delta(source, c)
            if useful[target]
                indegree[target] -= 1
                if indegree[target] == 0
                    pending = pending.append(target)
    return LanguageStatus(false, len(pending) != len(live_states))

nat[] next_counts(Automaton machine, nat[] counts)
    nat[] result = [for nat i < len(machine.states) then 0]
    for nat source < len(machine.states)
        for nat c < len(machine.alphabet)
            result[machine.delta(source, c)] += counts[source]
    return result

nat accepted_count(Automaton machine, nat[] counts)
    nat result = 0
    for nat item = machine.accepting[]
        result += counts[item]
    return result

string | none smallest_word(Automaton machine)
    bool[] seen = [for nat i < len(machine.states) then false]
    nat[] pending = [machine.start]
    string[] labels = [""]
    seen[machine.start] = true
    nat cursor = 0
    while cursor < len(pending)
        nat current = pending[cursor]
        string label = labels[cursor]
        cursor += 1
        if machine.accepts([current])
            return label
        for nat c < len(machine.alphabet)
            nat target = machine.delta(current, c)
            if not seen[target]
                seen[target] = true
                pending = pending.append(target)
                labels = labels.append(label + machine.alphabet[c])
    return none

class Pair(nat first, nat second)
string pair_key(Pair item)
    return "{item.first}:{item.second}"

Conversion product_dfa(Automaton a, Automaton b, string operation)
    Pair[] pairs = [Pair(a.start, b.start)]
    map.Map<string, nat> indices
    .indices.set(pair_key(pairs[0]), 0)
    Edge[] edges = []
    nat[] final_states = []
    string[] details = []
    nat cursor = 0
    while cursor < len(pairs)
        Pair current = pairs[cursor]
        bool first_accepts = a.accepts([current.first])
        bool second_accepts = b.accepts([current.second])
        bool final = if operation == "UNION" then first_accepts or second_accepts else (if operation == "INTERSECT" then first_accepts and second_accepts else first_accepts and not second_accepts)
        if final
            final_states = final_states.append(cursor)
        details = details.append("  P{cursor} = (" + a.states[current.first] + "," + b.states[current.second] + ")")
        for nat c < len(a.alphabet)
            Pair target = Pair(a.delta(current.first, c), b.delta(current.second, c))
            string key = pair_key(target)
            nat target_index = len(pairs)
            match indices.get(key)
                nat found
                    target_index = found
                none
                    .indices.set(key, target_index)
                    pairs = pairs.append(target)
            edges = edges.append(Edge(cursor, c, target_index))
        cursor += 1
    return Conversion(make_automaton("DFA", series("P", len(pairs)), a.alphabet, 0, final_states, edges), details)

string equivalent_text(Automaton a, Automaton b, string first_name, string second_name)
    Pair[] pairs = [Pair(a.start, b.start)]
    string[] labels = [""]
    map.Map<string, bool> seen
    .seen.set(pair_key(pairs[0]), true)
    nat cursor = 0
    while cursor < len(pairs)
        Pair current = pairs[cursor]
        string label = labels[cursor]
        cursor += 1
        bool first_accepts = a.accepts([current.first])
        bool second_accepts = b.accepts([current.second])
        if first_accepts != second_accepts
            return "NOT EQUIVALENT: " + word_text(label) + " is accepted only by " + (if first_accepts then first_name else second_name)
        for nat c < len(a.alphabet)
            Pair target = Pair(a.delta(current.first, c), b.delta(current.second, c))
            string key = pair_key(target)
            if not seen.has(key)
                .seen.set(key, true)
                pairs = pairs.append(target)
                labels = labels.append(label + a.alphabet[c])
    return "EQUIVALENT"

string synchronize(Automaton machine)
    nat[][] subsets = [[for nat i < len(machine.states) then i]]
    string[] labels = [""]
    map.Map<string, bool> seen
    .seen.set(index_key(subsets[0]), true)
    nat cursor = 0
    while cursor < len(subsets)
        nat[] current = subsets[cursor]
        string label = labels[cursor]
        cursor += 1
        if len(current) == 1
            return "SYNCHRONIZING " + word_text(label) + " -> " + machine.states[current[0]]
        for nat c < len(machine.alphabet)
            nat[] target = ordered_set([for nat item = current[] then machine.delta(item, c)])
            string key = index_key(target)
            if not seen.has(key)
                .seen.set(key, true)
                subsets = subsets.append(target)
                labels = labels.append(label + machine.alphabet[c])
    return "NOT SYNCHRONIZING"

string[] table_lines(Automaton machine)
    nat columns = len(machine.alphabet) + (if machine.kind == "NFA" and machine.has_epsilon() then 1 else 0)
    string[][] rows = [[""].concat([for nat c < columns then (if c == len(machine.alphabet) then "e" else machine.alphabet[c])])]
    for nat i < len(machine.states)
        string label = (if i == machine.start then "->" else "  ") + (if machine.accepts([i]) then "*" else " ") + machine.states[i]
        string[] row = [label]
        for nat c < columns
            nat[] targets = machine.cells[i][c]
            row = row.append(if machine.kind == "DFA" then machine.states[targets[0]] else (if len(targets) == 0 then "-" else machine.set_text(targets)))
        rows = rows.append(row)
    nat[] widths = [for nat c <= columns then 0]
    for string[] row = rows[]
        for nat c <= columns
            widths[c] = if widths[c] < len(row[c]) then len(row[c]) else widths[c]
    string[] output = []
    for string[] row = rows[]
        string[] cells = [for nat c <= columns then row[c] + string.repeat(" ", widths[c] - len(row[c]))]
        string text = cells.join("  ")
        while len(text) > 0 and text[len(text) - 1] == " "
            text = text[:<len(text) - 1]
        output = output.append(text)
    return output

string show_line(Automaton machine, string name)
    string final_text = if len(machine.accepting) == 0 then "-" else [for nat i = machine.accepting[] then machine.states[i]].join(",")
    string[] parts = [machine.kind, name, machine.states.join(","), machine.alphabet, machine.states[machine.start], final_text]
    for Edge edge = all_edges(machine)[]
        string symbol = if edge.column == len(machine.alphabet) then "e" else machine.alphabet[edge.column]
        parts = parts.append(machine.states[edge.source] + ":" + symbol + ":" + machine.states[edge.target])
    return parts.join(" ")

class Toolkit()
    string[] names = []
    Automaton[] machines = []

    string[] .register(string name, Automaton machine, string[] details = [])
        names = names.append(name)
        machines = machines.append(machine)
        return [machine.summary(name)].concat(details)

    string[] | error .define_machine(string[] arguments, string kind)
        if len(arguments) < 5
            return error("wrong number of arguments")
        string name = arguments[0]
        if includes(names, name)
            return error(name + " already exists")
        string[] state_names = arguments[1].split(",")
        string[] seen_states = []
        for string item = state_names[]
            if includes(seen_states, item)
                return error("duplicate state " + item)
            seen_states = seen_states.append(item)
        string alphabet = sorted_alphabet(arguments[2])
        nat start = locate(state_names, arguments[3])
        if start == len(state_names)
            return error("unknown state " + arguments[3])
        nat[] final_states = []
        if arguments[4] != "-"
            for string item = arguments[4].split(",")[]
                nat index = locate(state_names, item)
                if index == len(state_names)
                    return error("unknown state " + item)
                for nat existing = final_states[]
                    if existing == index
                        return error("duplicate state " + item)
                final_states = final_states.append(index)
        Edge[] edges = []
        string[] seen_words = []
        string[] seen_pairs = []
        for 5 <= nat i < len(arguments)
            string word = arguments[i]
            string[] parts = word.split(":")
            nat source = locate(state_names, parts[0])
            if source == len(state_names)
                return error("unknown state " + parts[0])
            string symbol = parts[1]
            if symbol == "e" and kind == "DFA"
                return error("epsilon transition in DFA")
            if symbol != "e" and not alphabet.contains(symbol)
                return error("unknown symbol " + symbol)
            nat target = locate(state_names, parts[2])
            if target == len(state_names)
                return error("unknown state " + parts[2])
            if includes(seen_words, word)
                return error("duplicate transition " + word)
            string key = parts[0] + ":" + symbol
            if kind == "DFA" and includes(seen_pairs, key)
                return error("conflicting transition " + word)
            seen_words = seen_words.append(word)
            seen_pairs = seen_pairs.append(key)
            nat column = len(alphabet)
            for nat c < len(alphabet)
                if alphabet[c] == symbol
                    column = c
            edges = edges.append(Edge(source, column, target))
        if kind == "DFA"
            for string item = state_names[]
                for nat c < len(alphabet)
                    if not includes(seen_pairs, item + ":" + alphabet[c])
                        return error("missing transition " + item + ":" + alphabet[c])
        return .register(name, make_automaton(kind, state_names, alphabet, start, final_states, edges))

    string[] | error .define_regex(string[] arguments)
        if len(arguments) != 3
            return error("wrong number of arguments")
        string name = arguments[0]
        if includes(names, name)
            return error(name + " already exists")
        string alphabet = sorted_alphabet(arguments[1])
        string expression = arguments[2]
        for nat i < len(expression)
            string character = expression[i]
            if character != "e" and "abcdefghijklmnopqrstuvwxyz0123456789".contains(character) and not alphabet.contains(character)
                return error("unknown symbol " + character)
        RegexReader reader = RegexReader(expression)
        nat root = try .reader.parse()
        Thompson builder = Thompson(reader.nodes, alphabet)
        Fragment whole = .builder.construct(root)
        return .register(name, make_automaton("NFA", series("N", builder.count), alphabet, whole.entry, [whole.exit], builder.edges))

    string[] | error .command(string line)
        string[] parts = line.split(" ")
        string operation = parts[0]
        string[] arguments = parts[1:]
        string[] commands = "DFA NFA REGEX ACCEPT CLOSURE TODFA EPSFREE MINIMIZE EQUIV UNION INTERSECT DIFF COMPLEMENT REVERSE CONCAT STAR ENUM COUNT EMPTY FINITE INFO TABLE SHOW SYNC LIST DELETE".split(" ")
        if not includes(commands, operation)
            return error("unknown command " + operation)
        if operation == "DFA" or operation == "NFA"
            return try .define_machine(arguments, operation)
        if operation == "REGEX"
            return try .define_regex(arguments)
        nat expected = if operation == "LIST" then 0 else (if includes(["EMPTY", "FINITE", "INFO", "TABLE", "SHOW", "SYNC", "DELETE"], operation) then 1 else (if includes(["UNION", "INTERSECT", "DIFF", "CONCAT"], operation) then 3 else 2))
        if len(arguments) != expected
            return error("wrong number of arguments")
        if operation == "LIST"
            return if len(names) == 0 then ["(none)"] else [for nat i < len(names) then machines[i].summary(names[i])]
        bool paired = includes(["EQUIV", "UNION", "INTERSECT", "DIFF", "CONCAT"], operation)
        nat references = if paired then 2 else 1
        for nat i < references
            if not includes(names, arguments[i])
                return error("unknown automaton " + arguments[i])
        bool creates = includes(["TODFA", "EPSFREE", "MINIMIZE", "UNION", "INTERSECT", "DIFF", "COMPLEMENT", "REVERSE", "CONCAT", "STAR"], operation)
        string new_name = if creates then arguments[len(arguments) - 1] else ""
        if creates and includes(names, new_name)
            return error(new_name + " already exists")
        bool needs_dfa = includes(["MINIMIZE", "COMPLEMENT", "UNION", "INTERSECT", "DIFF", "SYNC"], operation)
        if needs_dfa
            for nat i < references
                if machines[locate(names, arguments[i])].kind != "DFA"
                    return error(arguments[i] + " is not a DFA")
        nat index = locate(names, arguments[0])
        Automaton machine = machines[index]
        Automaton other = if paired then machines[locate(names, arguments[1])] else machine
        if paired and machine.alphabet != other.alphabet
            return error("alphabets differ")
        if operation == "DELETE"
            names = names[:<index].concat(names[index + 1:])
            machines = machines[:<index].concat(machines[index + 1:])
            return ["deleted " + arguments[0]]
        if operation == "ACCEPT"
            string word = if arguments[1] == "e" then "" else arguments[1]
            for nat i < len(word)
                if not machine.alphabet.contains(word[i])
                    return error("unknown symbol " + word[i])
            nat[] current = machine.closure([machine.start])
            string path = if machine.kind == "DFA" then machine.states[current[0]] else machine.set_text(current)
            for nat i < len(word)
                nat column = 0
                for nat c < len(machine.alphabet)
                    if machine.alphabet[c] == word[i]
                        column = c
                current = machine.destination(current, column)
                path += " -" + word[i] + "-> " + (if machine.kind == "DFA" then machine.states[current[0]] else machine.set_text(current))
            return [(if machine.accepts(current) then "ACCEPT " else "REJECT ") + path]
        if operation == "CLOSURE"
            nat[] seeds = []
            for string item = arguments[1].split(",")[]
                nat state_index = locate(machine.states, item)
                if state_index == len(machine.states)
                    return error("unknown state " + item)
                seeds = seeds.append(state_index)
            return [machine.set_text(machine.closure(seeds))]
        if operation == "TODFA" or operation == "MINIMIZE"
            Conversion result = if operation == "TODFA" then determinize(machine) else minimize_dfa(machine)
            return .register(new_name, result.machine, result.details)
        if operation == "EPSFREE"
            Edge[] edges = []
            nat[] final_states = []
            for nat i < len(machine.states)
                nat[] expanded = machine.closure([i])
                if machine.accepts(expanded)
                    final_states = final_states.append(i)
                for nat c < len(machine.alphabet)
                    for nat target = machine.destination(expanded, c)[]
                        edges = edges.append(Edge(i, c, target))
            return .register(new_name, make_automaton("NFA", machine.states, machine.alphabet, machine.start, final_states, edges))
        if operation == "EQUIV"
            Automaton a = determinize(machine).machine
            Automaton b = determinize(other).machine
            return [equivalent_text(a, b, arguments[0], arguments[1])]
        if includes(["UNION", "INTERSECT", "DIFF"], operation)
            Conversion result = product_dfa(machine, other, operation)
            return .register(new_name, result.machine, result.details)
        if operation == "COMPLEMENT"
            nat[] final_states = [for nat i < len(machine.states) if not machine.accepts([i]) then i]
            return .register(new_name, make_automaton("DFA", machine.states, machine.alphabet, machine.start, final_states, all_edges(machine)))
        if operation == "REVERSE" or operation == "STAR" or operation == "CONCAT"
            nat offset = if operation == "CONCAT" then 0 else 1
            nat count = len(machine.states) + (if operation == "CONCAT" then len(other.states) else 1)
            Edge[] edges = all_edges(machine, offset)
            nat[] final_states = []
            nat initial = 0
            nat epsilon = len(machine.alphabet)
            if operation == "REVERSE"
                edges = [for Edge edge = edges[] then Edge(edge.target, edge.column, edge.source)]
                for nat item = machine.accepting[]
                    edges = edges.append(Edge(0, epsilon, item + 1))
                final_states = [machine.start + 1]
            if operation == "STAR"
                edges = edges.append(Edge(0, epsilon, machine.start + 1))
                final_states = [0]
                for nat item = machine.accepting[]
                    final_states = final_states.append(item + 1)
                    edges = edges.append(Edge(item + 1, epsilon, machine.start + 1))
            if operation == "CONCAT"
                nat shift = len(machine.states)
                edges = edges.concat(all_edges(other, shift))
                for nat item = machine.accepting[]
                    edges = edges.append(Edge(item, epsilon, other.start + shift))
                final_states = [for nat item = other.accepting[] then item + shift]
                initial = machine.start
            return .register(new_name, make_automaton("NFA", series("N", count), machine.alphabet, initial, final_states, edges))
        if operation == "SYNC"
            return [synchronize(machine)]
        if operation == "TABLE"
            return table_lines(machine)
        if operation == "SHOW"
            return [show_line(machine, arguments[0])]
        Automaton dfa = determinize(machine).machine
        if operation == "COUNT" or operation == "FINITE"
            nat limit = if operation == "COUNT" then nat.parse(arguments[1]) else len(machine.states) - 1
            if operation == "FINITE" and language_status(dfa).infinite
                return ["INFINITE"]
            nat[] counts = [for nat i < len(dfa.states) then (if i == dfa.start then 1 else 0)]
            nat total = if operation == "FINITE" then accepted_count(dfa, counts) else 0
            for nat i < limit
                counts = next_counts(dfa, counts)
                if operation == "FINITE"
                    total += accepted_count(dfa, counts)
            return [if operation == "COUNT" then accepted_count(dfa, counts).string() else "FINITE {total}"]
        if operation == "ENUM"
            nat limit = nat.parse(arguments[1])
            nat[] pending = [dfa.start]
            string[] labels = [""]
            nat cursor = 0
            nat total = 0
            string[] shown = []
            while cursor < len(pending)
                nat current = pending[cursor]
                string label = labels[cursor]
                cursor += 1
                if dfa.accepts([current])
                    total += 1
                    if len(shown) < 50
                        shown = shown.append(word_text(label))
                if len(label) < limit
                    for nat c < len(dfa.alphabet)
                        pending = pending.append(dfa.delta(current, c))
                        labels = labels.append(label + dfa.alphabet[c])
            return [total.string() + (if len(shown) == 0 then "" else " " + shown.join(" ")) + (if total > 50 then " ..." else "")]
        if operation == "EMPTY"
            match smallest_word(dfa)
                string word
                    return ["NOT EMPTY " + word_text(word)]
                none
                    return ["EMPTY"]
        LanguageStatus status = language_status(dfa)
        nat epsilon_count = 0
        bool deterministic = true
        bool complete = true
        for nat i < len(machine.states)
            epsilon_count += len(machine.cells[i][len(machine.alphabet)])
            for nat c < len(machine.alphabet)
                if len(machine.cells[i][c]) > 1
                    deterministic = false
                if len(machine.cells[i][c]) == 0
                    complete = false
        if epsilon_count > 0
            deterministic = false
        Conversion minimal = minimize_dfa(dfa)
        return [machine.summary(arguments[0]), "  epsilon transitions: {epsilon_count}", "  reachable: " + machine.list_text(machine.reachable()), "  live: " + machine.list_text(machine.live()), "  deterministic: " + (if deterministic then "yes" else "no"), "  complete: " + (if complete then "yes" else "no"), "  language: " + (if status.empty then "empty" else (if status.infinite then "infinite" else "finite")), "  minimal DFA states: {len(minimal.machine.states)}"]

void read_commands()
    string line = ""
    scan(&line)
    nat count = nat.parse(line)
    Toolkit toolkit = Toolkit()
    for nat i < count
        scan(&line)
        if line[0] == "#"
            continue
        match .toolkit.command(line)
            string[] output
                for string text = output[]
                    emit(text)
            error failure
                emit("error: " + failure.message)

read_commands()
