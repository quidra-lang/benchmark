string[] step_names()
    return ["1a", "1b", "1c", "2", "3", "4", "5a", "5b"]

string[] step_4_suffixes()
    return [
        "al", "ance", "ence", "er", "ic", "able", "ible", "ant", "ement", "ment",
        "ent", "ion", "ou", "ism", "ate", "iti", "ous", "ive", "ize",
    ]

bool includes(string[] values, string value)
    for auto candidate = values[]
        if candidate == value
            return true
    return false

bool is_letter(string character)
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".contains(character)

bool is_word(string text)
    if not (1 <= len(text) <= 30)
        return false
    for nat index < len(text)
        if not is_letter(text[index])
            return false
    return true

string lowercase(string text)
    string uppercase_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lowercase_letters = "abcdefghijklmnopqrstuvwxyz"
    string result = ""
    for nat index < len(text)
        string character = text[index]
        match uppercase_letters.find(character)
            nat position
                result += lowercase_letters[position]
            none
                result += character
    return result

string drop_last(string text)
    return text[0:<len(text) - 1]

bool text_before(string left, string right)
    int[] left_codes = left.codepoints()
    int[] right_codes = right.codepoints()
    for nat index < len(left_codes)
        if index == len(right_codes)
            return false
        if left_codes[index] != right_codes[index]
            return left_codes[index] < right_codes[index]
    return len(left_codes) < len(right_codes)

string letter_pattern(string word)
    string kinds = ""
    for nat index < len(word)
        string letter = word[index]
        bool after_consonant = index > 0 and kinds[index - 1] == "C"
        bool vowel = "aeiou".contains(letter) or (letter == "y" and after_consonant)
        kinds += if vowel then "V" else "C"
    return kinds

nat measure(string word)
    string pattern = letter_pattern(word)
    nat count = 0
    for 1 <= nat index < len(pattern)
        if pattern[index - 1] == "V" and pattern[index] == "C"
            count += 1
    return count

bool has_vowel(string word)
    return letter_pattern(word).contains("V")

bool ends_double(string word)
    nat size = len(word)
    return letter_pattern(word).ends_with("CC") and word[size - 1] == word[size - 2]

bool ends_cvc(string word)
    return letter_pattern(word).ends_with("CVC") and not "wxy".contains(word[len(word) - 1])

bool always(string remainder)
    return true

bool measure_above_zero(string remainder)
    return measure(remainder) > 0

bool measure_above_one(string remainder)
    return measure(remainder) > 1

bool ion_condition(string remainder)
    return measure(remainder) > 1 and (remainder.ends_with("s") or remainder.ends_with("t"))

bool final_e_condition(string remainder)
    nat value = measure(remainder)
    return value > 1 or (value == 1 and not ends_cvc(remainder))

class Rule(string suffix, string replacement, func<bool>(string) condition)

Rule[] rules_with(func<bool>(string) condition, (string, string)[] replacements)
    Rule[] rules = []
    for (string suffix, string replacement) = replacements[]
        rules = rules.append(Rule(suffix, replacement, condition))
    return rules

Rule[] step_4_rules()
    Rule[] rules = []
    string[] suffixes = step_4_suffixes()
    for auto suffix = suffixes[]
        func<bool>(string) condition = measure_above_one
        if suffix == "ion"
            condition = ion_condition
        rules = rules.append(Rule(suffix, "", condition))
    return rules

Rule[] rule_table(string step)
    if step == "1a"
        return rules_with(always, [("sses", "ss"), ("ies", "i"), ("ss", "ss"), ("s", "")])
    elif step == "1b"
        return [
            Rule("eed", "ee", measure_above_zero),
            Rule("ed", "", has_vowel),
            Rule("ing", "", has_vowel),
        ]
    elif step == "1c"
        return [Rule("y", "i", has_vowel)]
    elif step == "2"
        return rules_with(measure_above_zero, [
            ("ational", "ate"), ("tional", "tion"), ("enci", "ence"), ("anci", "ance"),
            ("izer", "ize"), ("abli", "able"), ("alli", "al"), ("entli", "ent"), ("eli", "e"),
            ("ousli", "ous"), ("ization", "ize"), ("ation", "ate"), ("ator", "ate"),
            ("alism", "al"), ("iveness", "ive"), ("fulness", "ful"), ("ousness", "ous"),
            ("aliti", "al"), ("iviti", "ive"), ("biliti", "ble"),
        ])
    elif step == "3"
        return rules_with(measure_above_zero, [
            ("icate", "ic"), ("ative", ""), ("alize", "al"), ("iciti", "ic"),
            ("ical", "ic"), ("ful", ""), ("ness", ""),
        ])
    elif step == "4"
        return step_4_rules()
    return [Rule("e", "", final_e_condition)]

// Apply the rule with the longest matching suffix; return the word and the applied suffix.
(string, string) apply_rules(string word, Rule[] rules)
    nat selected = len(rules)
    nat selected_length = 0
    for Rule candidate = rules[nat index]
        if word.ends_with(candidate.suffix) and len(candidate.suffix) > selected_length
            selected = index
            selected_length = len(candidate.suffix)
    if selected == len(rules)
        return (word, "")
    Rule rule = rules[selected]
    string remainder = word[0:<len(word) - selected_length]
    func<bool>(string) condition = rule.condition
    if not condition(remainder)
        return (word, "")
    return (remainder + rule.replacement, rule.suffix)

string tidy_step_1b(string word)
    if word.ends_with("at") or word.ends_with("bl") or word.ends_with("iz")
        return word + "e"
    if ends_double(word) and not "lsz".contains(word[len(word) - 1])
        return drop_last(word)
    if measure(word) == 1 and ends_cvc(word)
        return word + "e"
    return word

string apply_step(string name, string word)
    if name == "5b"
        if measure(word) > 1 and ends_double(word) and word.ends_with("l")
            return drop_last(word)
        return word
    (string result, string suffix) = apply_rules(word, rule_table(name))
    if name == "1b" and (suffix == "ed" or suffix == "ing")
        return tidy_step_1b(result)
    return result

class StepChange(string step, string word)

class Stemming(string stem, StepChange[] changes)

Stemming stemming_steps(string word)
    StepChange[] changes = []
    string current = word
    if len(word) > 2
        string[] names = step_names()
        for auto name = names[]
            string result = apply_step(name, current)
            if result != current
                changes = changes.append(StepChange(name, result))
            current = result
    return Stemming(current, changes)

string porter_stem(string word)
    return stemming_steps(word).stem

string yes_no(bool flag)
    return if flag then "YES" else "NO"

string | error word_argument(string text)
    if not is_word(text)
        return error("BAD WORD {text}")
    return lowercase(text)

nat | error number_argument(string text, nat minimum, nat maximum)
    bool numeric = 1 <= len(text) <= 7
    for nat index < len(text)
        if not "0123456789".contains(text[index])
            numeric = false
    if not numeric
        return error("BAD NUMBER {text}")
    nat value = try nat.parse(text)
    if not (minimum <= value <= maximum)
        return error("BAD NUMBER {text}")
    return value

string[] split_arguments(string name, string rest)
    if name == "SEARCH"
        return [rest]
    if name == "APPEND"
        match rest.find(" ")
            nat space
                return [rest[0:<space], rest[space + 1:<len(rest)]]
            none
                return [rest]
    return rest.split(" ")

void emit(string head, string[] items = [])
    if len(items) == 0
        print("{head}{NL}")
    else
        string joined = items.join(" ")
        print("{head} {joined}{NL}")

nat count_of(map.Map<string, nat> counts, string key)
    match counts.get(key)
        nat count
            return count
        none
            return 0

void increment(map.Map<string, nat> &counts, string key, nat amount = 1)
    match counts.get(key)
        nat count
            .counts.set(key, count + amount)
        none
            .counts.set(key, amount)

T[] sort_by<T>(T[] values, func<bool>(T, T) before)
    if len(values) < 2
        return values
    nat middle = len(values) / 2
    T[] left = sort_by<T>(values[0:<middle], before)
    T[] right = sort_by<T>(values[middle:<len(values)], before)
    T[] merged = []
    nat left_index = 0
    nat right_index = 0
    while left_index < len(left) and right_index < len(right)
        if before(right[right_index], left[left_index])
            merged = merged.append(right[right_index])
            right_index += 1
        else
            merged = merged.append(left[left_index])
            left_index += 1
    return merged.concat(left[left_index:<len(left)]).concat(right[right_index:<len(right)])

T[] limited<T>(T[] values, nat limit)
    if len(values) <= limit
        return values
    return values[0:<limit]

class StemCount(string stem, nat count)

bool count_before(StemCount left, StemCount right)
    if left.count != right.count
        return left.count > right.count
    return text_before(left.stem, right.stem)

StemCount[] ranked_counts(map.Map<string, nat> counts)
    StemCount[] entries = []
    string[] stems = counts.keys()
    for auto stem = stems[]
        entries = entries.append(StemCount(stem, count_of(counts, stem)))
    return sort_by<StemCount>(entries, count_before)

class Marker(nat position, nat source)

bool marker_before(Marker left, Marker right)
    return left.position < right.position

nat | none closest_distance(nat[] positions, nat[] others, bool same_stem)
    nat[] gaps = []
    if same_stem
        for 1 <= nat index < len(positions)
            gaps = gaps.append(positions[index] - positions[index - 1])
    else
        // The closest pair of different stems is adjacent in the merged order.
        Marker[] markers = []
        for auto position = positions[]
            markers = markers.append(Marker(position, 0))
        for auto other = others[]
            markers = markers.append(Marker(other, 1))
        Marker[] merged = sort_by<Marker>(markers, marker_before)
        for 1 <= nat index < len(merged)
            if merged[index - 1].source != merged[index].source
                gaps = gaps.append(merged[index].position - merged[index - 1].position)
    if len(gaps) == 0
        return none
    nat smallest = gaps[0]
    for auto gap = gaps[]
        if gap < smallest
            smallest = gap
    return smallest

nat gcd(nat first, nat second)
    nat larger = first
    nat smaller = second
    while smaller != 0
        nat remainder = larger % smaller
        larger = smaller
        smaller = remainder
    return larger

(nat, nat) jaccard(nat common, nat total)
    if total == 0
        return (0, 1)
    nat divisor = gcd(common, total)
    return (common / divisor, total / divisor)

class Similarity(nat number, nat numerator, nat denominator)

bool similarity_before(Similarity left, Similarity right)
    nat left_score = left.numerator * right.denominator
    nat right_score = right.numerator * left.denominator
    if left_score != right_score
        return left_score > right_score
    return left.number < right.number

class Ranking(nat number, nat matched, nat total)

bool ranking_before(Ranking left, Ranking right)
    if left.matched != right.matched
        return left.matched > right.matched
    if left.total != right.total
        return left.total > right.total
    return left.number < right.number

class Token(string text, string form, string stem, nat line, nat position, nat start)
    nat end()
        return start + len(text)

class Document(nat number)
    string[] lines = []
    Token[] tokens = []

    Token[] .add_line(string text)
        lines = lines.append(text)
        Token[] added = []
        nat index = 0
        while index < len(text)
            if not is_letter(text[index])
                index += 1
                continue
            nat start = index
            while index < len(text) and is_letter(text[index])
                index += 1
            string word = text[start:<index]
            string form = lowercase(word)
            auto token = Token(word, form, porter_stem(form), len(lines), len(tokens) + 1, start)
            tokens = tokens.append(token)
            added = added.append(token)
        return added

    Token[] line_tokens(nat line_number)
        return [for Token token = tokens[] if token.line == line_number then token]

    string reference(Token token)
        return "{number}:{token.line}:{token.position}"

class Occurrence(nat index, Token token)

nat document_count(Occurrence[] occurrences)
    set.Set<nat> indices
    for Occurrence occurrence = occurrences[]
        .indices.add(occurrence.index)
    return indices.size()

class QueryItem(string kind, string spelling)

string[] lexemes(string expression)
    string[] result = []
    string current = ""
    for nat index < len(expression)
        string character = expression[index]
        if includes([" ", "(", ")"], character)
            if current != ""
                result = result.append(current)
                current = ""
            if character != " "
                result = result.append(character)
        else
            current += character
    if current != ""
        result = result.append(current)
    return result

QueryItem | error classify(string lexeme)
    if includes(["AND", "OR", "NOT", "(", ")"], lexeme)
        return QueryItem(lexeme, lexeme)
    if is_word(lexeme)
        return QueryItem("term", lowercase(lexeme))
    string letters = drop_last(lexeme)
    if lexeme.ends_with("*") and is_word(letters)
        return QueryItem("prefix", lowercase(letters))
    return error("BAD TERM {lexeme}")

class QueryResult(string canonical, bool[] documents)

bool[] union_of(bool[] left, bool[] right)
    bool[] result = left
    for nat index < len(right)
        result[index] = left[index] or right[index]
    return result

bool[] intersection_of(bool[] left, bool[] right)
    bool[] result = left
    for nat index < len(right)
        result[index] = left[index] and right[index]
    return result

bool has_prefix(set.Set<string> stems, string prefix)
    string[] values = stems.values()
    for auto stem = values[]
        if stem.starts_with(prefix)
            return true
    return false

class QueryParser(QueryItem[] items, set.Set<string>[] stem_sets)
    nat position = 0

    string peek()
        if position < len(items)
            return items[position].kind
        return ""

    QueryItem | error .take()
        if position >= len(items)
            return error("SYNTAX")
        position += 1
        return items[position - 1]

    QueryResult | error .parse()
        QueryResult result = try .expression()
        if position < len(items)
            return error("SYNTAX")
        return result

    QueryResult | error .expression()
        QueryResult result = try .conjunction()
        while peek() == "OR"
            position += 1
            QueryResult right = try .conjunction()
            string canonical = "({result.canonical} OR {right.canonical})"
            result = QueryResult(canonical, union_of(result.documents, right.documents))
        return result

    QueryResult | error .conjunction()
        QueryResult result = try .negation()
        while includes(["AND", "NOT", "(", "term", "prefix"], peek())
            if peek() == "AND"
                position += 1
            QueryResult right = try .negation()
            string canonical = "({result.canonical} AND {right.canonical})"
            result = QueryResult(canonical, intersection_of(result.documents, right.documents))
        return result

    QueryResult | error .negation()
        if peek() != "NOT"
            return .element()
        position += 1
        QueryResult inner = try .negation()
        bool[] documents = inner.documents
        for nat index < len(documents)
            documents[index] = not documents[index]
        return QueryResult("(NOT {inner.canonical})", documents)

    QueryResult | error .element()
        QueryItem item = try .take()
        if item.kind == "("
            QueryResult result = try .expression()
            QueryItem closing = try .take()
            if closing.kind != ")"
                return error("SYNTAX")
            return result
        if item.kind == "term"
            string stem = porter_stem(item.spelling)
            return QueryResult(stem, [for auto stems = stem_sets[] then stems.has(stem)])
        if item.kind == "prefix"
            bool[] documents = [
                for auto stems = stem_sets[] then has_prefix(stems, item.spelling)
            ]
            return QueryResult("{item.spelling}*", documents)
        return error("SYNTAX")

class Command(string name, nat minimum, nat maximum)

Command[] commands()
    return [
        Command("STEM", 1, 10),
        Command("STEPS", 1, 1),
        Command("MEASURE", 1, 1),
        Command("INDEX", 0, 1),
        Command("SEARCH", 1, 1),
        Command("PHRASE", 2, 10),
        Command("NEAR", 3, 3),
        Command("TOP", 1, 2),
        Command("KWIC", 1, 1),
        Command("TF", 2, 2),
        Command("DF", 1, 1),
        Command("VARIANTS", 1, 1),
        Command("SIMILAR", 2, 2),
        Command("RANK", 2, 11),
        Command("INFO", 1, 1),
        Command("LINE", 2, 2),
        Command("STATS", 0, 0),
        Command("STOP", 1, 1),
        Command("UNSTOP", 1, 1),
        Command("APPEND", 2, 2),
        Command("DELETE", 1, 1),
    ]

Command | error find_command(string name)
    Command[] known = commands()
    for auto command = known[]
        if command.name == name
            return command
    return error("UNKNOWN COMMAND {name}")

class SearchEngine(string[] stopwords)
    const nat kwic_width = 30
    const nat max_count = 100
    const nat max_document_number = 999
    const nat max_line_number = 999
    Document[] documents = []

    nat .add_document(nat number)
        nat index = 0
        while index < len(documents) and documents[index].number < number
            index += 1
        Document[] before = documents[0:<index]
        documents = before.append(Document(number)).concat(documents[index:<len(documents)])
        return index

    Token[] .add_line(nat index, string text)
        return .documents[index].add_line(text)

    nat | none find_document(nat number)
        for nat index < len(documents)
            if documents[index].number == number
                return index
        return none

    bool is_indexed(Token token)
        return not includes(stopwords, token.form)

    map.Map<string, nat> term_frequencies(Document document)
        map.Map<string, nat> counts
        for Token token = document.tokens[]
            if is_indexed(token)
                increment(&counts, token.stem)
        return counts

    set.Set<string> stem_set(Document document)
        set.Set<string> stems
        for Token token = document.tokens[]
            if is_indexed(token)
                .stems.add(token.stem)
        return stems

    map.Map<string, nat> total_frequencies()
        map.Map<string, nat> totals
        for Document document = documents[]
            map.Map<string, nat> counts = term_frequencies(document)
            string[] stems = counts.keys()
            for auto stem = stems[]
                increment(&totals, stem, count_of(counts, stem))
        return totals

    map.Map<string, Occurrence[]> occurrence_map()
        map.Map<string, Occurrence[]> occurrences
        for nat index < len(documents)
            for Token token = documents[index].tokens[]
                if is_indexed(token)
                    auto occurrence = Occurrence(index, token)
                    match occurrences.get(token.stem)
                        Occurrence[] found
                            .occurrences.set(token.stem, found.append(occurrence))
                        none
                            .occurrences.set(token.stem, [occurrence])
        return occurrences

    Occurrence[] occurrences_of(string stem)
        match occurrence_map().get(stem)
            Occurrence[] found
                return found
            none
                return []

    string reference_of(Occurrence occurrence)
        return documents[occurrence.index].reference(occurrence.token)

    nat[] stem_positions(Document document, string stem)
        return [
            for Token token = document.tokens[]
            if is_indexed(token) and token.stem == stem
            then token.position
        ]

    nat form_count(string form)
        nat count = 0
        for Document document = documents[]
            for Token token = document.tokens[]
                if token.form == form
                    count += 1
        return count

    bool token_matches(Token token, string target)
        return target == "?" or (is_indexed(token) and token.stem == target)

    bool phrase_matches(Token[] tokens, nat start, string[] targets)
        for string target = targets[nat offset]
            if not token_matches(tokens[start + offset], target)
                return false
        return true

    string describe_token(Token token)
        if is_indexed(token)
            return "{token.form}/{token.stem}"
        return "{token.form}/-"

    string | error term_argument(string text)
        string word = try word_argument(text)
        if includes(stopwords, word)
            return error("STOPWORD {word}")
        return porter_stem(word)

    nat | error document_argument(string text)
        nat number = try number_argument(text, 1, max_document_number)
        match find_document(number)
            nat index
                return index
            none
                return error("NO DOC {number}")

    void | error stem_words(string[] arguments)
        string[] items = []
        for auto argument = arguments[]
            string word = try word_argument(argument)
            items = items.append("{word}:{porter_stem(word)}")
        emit("STEM", items)
        return void

    void | error show_steps(string[] arguments)
        string word = try word_argument(arguments[0])
        StepChange[] changes = stemming_steps(word).changes
        if len(changes) == 0
            emit("STEPS {word} NONE")
        else
            emit("STEPS {word}", [
                for StepChange change = changes[] then "{change.step}:{change.word}"
            ])
        return void

    void | error show_measure(string[] arguments)
        string word = try word_argument(arguments[0])
        string pattern = "{letter_pattern(word)} m={measure(word)}"
        string flags = "vowel={yes_no(has_vowel(word))} double={yes_no(ends_double(word))}"
        emit("MEASURE {word} {pattern} {flags} cvc={yes_no(ends_cvc(word))}")
        return void

    void | error show_index(string[] arguments)
        string prefix = ""
        if len(arguments) == 1
            prefix = try word_argument(arguments[0])
        map.Map<string, Occurrence[]> occurrences = occurrence_map()
        string[] keys = occurrences.keys()
        string[] stems = [for auto stem = keys[] if stem.starts_with(prefix) then stem]
        stems = stems.sorted()
        emit("INDEX stems={len(stems)}")
        for auto stem = stems[]
            match occurrences.get(stem)
                Occurrence[] found
                    string[] references = [
                        for Occurrence occurrence = found[] then reference_of(occurrence)
                    ]
                    emit("{stem} df={document_count(found)}", references)
                none
                    void
        return void

    void | error search(string[] arguments)
        QueryItem[] items = []
        string[] words = lexemes(arguments[0])
        for auto lexeme = words[]
            items = items.append(try classify(lexeme))
        set.Set<string>[] stem_sets = [for Document document = documents[] then stem_set(document)]
        auto parser = QueryParser(items, stem_sets)
        QueryResult result = try .parser.parse()
        for QueryItem item = items[]
            if item.kind == "term" and includes(stopwords, item.spelling)
                return error("STOPWORD {item.spelling}")
        string[] numbers = []
        for bool selected = result.documents[nat index]
            if selected
                numbers = numbers.append(documents[index].number.string())
        emit("SEARCH {result.canonical} count={len(numbers)}", numbers)
        return void

    void | error phrase(string[] arguments)
        string[] words = []
        for auto argument = arguments[]
            words = words.append(try word_argument(argument))
        bool only_stopwords = true
        for auto word = words[]
            if not includes(stopwords, word)
                only_stopwords = false
        if only_stopwords
            return error("STOPWORDS ONLY")
        string[] targets = []
        for auto word = words[]
            targets = targets.append(if includes(stopwords, word) then "?" else porter_stem(word))
        string[] matches = []
        for Document document = documents[]
            if len(targets) <= len(document.tokens)
                for 0 <= nat start <= len(document.tokens) - len(targets)
                    if phrase_matches(document.tokens, start, targets)
                        matches = matches.append(document.reference(document.tokens[start]))
        string phrase_text = targets.join(" ")
        emit("PHRASE {DQ}{phrase_text}{DQ} matches={len(matches)}", matches)
        return void

    void | error near(string[] arguments)
        string first = try term_argument(arguments[0])
        string second = try term_argument(arguments[1])
        nat limit = try number_argument(arguments[2], 1, max_count)
        string[] found = []
        for Document document = documents[]
            nat[] positions = stem_positions(document, first)
            nat[] others = stem_positions(document, second)
            match closest_distance(positions, others, first == second)
                nat distance
                    if distance <= limit
                        found = found.append("{document.number}:{distance}")
                none
                    void
        emit("NEAR {first} {second} {limit} count={len(found)}", found)
        return void

    void | error top(string[] arguments)
        nat limit = try number_argument(arguments[0], 1, max_count)
        map.Map<string, nat> counts
        string header = "TOP {limit}"
        if len(arguments) == 2
            nat index = try document_argument(arguments[1])
            counts = term_frequencies(documents[index])
            header = "TOP {limit} doc={documents[index].number}"
        else
            counts = total_frequencies()
        StemCount[] ranked = limited<StemCount>(ranked_counts(counts), limit)
        emit(header, [for StemCount entry = ranked[] then "{entry.stem}:{entry.count}"])
        return void

    void | error kwic(string[] arguments)
        string stem = try term_argument(arguments[0])
        Occurrence[] found = occurrences_of(stem)
        emit("KWIC {stem} count={len(found)}")
        for Occurrence occurrence = found[]
            Token token = occurrence.token
            string text = documents[occurrence.index].lines[token.line - 1]
            nat before_start = if token.start > kwic_width then token.start - kwic_width else 0
            nat after_end = token.end() + kwic_width
            if after_end > len(text)
                after_end = len(text)
            string before = text[before_start:<token.start]
            string after = text[token.end():<after_end]
            string left_padding = string.repeat(" ", kwic_width - len(before))
            string right_padding = string.repeat(" ", kwic_width - len(after))
            string context = "|{left_padding}{before}[{token.text}]{after}{right_padding}|"
            emit(context, [reference_of(occurrence)])
        return void

    void | error term_frequency(string[] arguments)
        nat index = try document_argument(arguments[0])
        string stem = try term_argument(arguments[1])
        nat count = count_of(term_frequencies(documents[index]), stem)
        emit("TF {documents[index].number} {stem} {count}")
        return void

    void | error document_frequency(string[] arguments)
        string stem = try term_argument(arguments[0])
        emit("DF {stem} {document_count(occurrences_of(stem))}")
        return void

    void | error variants(string[] arguments)
        string stem = try term_argument(arguments[0])
        map.Map<string, nat> forms
        Occurrence[] found = occurrences_of(stem)
        for Occurrence occurrence = found[]
            increment(&forms, occurrence.token.form)
        string[] names = forms.keys()
        names = names.sorted()
        string[] items = [for auto form = names[] then "{form}:{count_of(forms, form)}"]
        emit("VARIANTS {stem} count={forms.size()}", items)
        return void

    void | error similar(string[] arguments)
        nat index = try document_argument(arguments[0])
        nat limit = try number_argument(arguments[1], 1, max_count)
        set.Set<string> stems = stem_set(documents[index])
        string[] stem_values = stems.values()
        Similarity[] scores = []
        for nat other < len(documents)
            if other != index
                set.Set<string> other_stems = stem_set(documents[other])
                nat common = 0
                for auto stem = stem_values[]
                    if other_stems.has(stem)
                        common += 1
                nat union_size = stems.size() + other_stems.size() - common
                (nat numerator, nat denominator) = jaccard(common, union_size)
                scores = scores.append(Similarity(documents[other].number, numerator, denominator))
        scores = sort_by<Similarity>(scores, similarity_before)
        Similarity[] shown = limited<Similarity>(scores, limit)
        string[] items = [
            for Similarity score = shown[] then "{score.number}:{score.numerator}/{score.denominator}"
        ]
        emit("SIMILAR {documents[index].number}", items)
        return void

    void | error rank(string[] arguments)
        nat limit = try number_argument(arguments[0], 1, max_count)
        set.Set<string> query
        for 1 <= nat position < len(arguments)
            .query.add(try term_argument(arguments[position]))
        string[] query_stems = query.values()
        Ranking[] ranked = []
        for Document document = documents[]
            map.Map<string, nat> counts = term_frequencies(document)
            nat matched = 0
            nat total = 0
            for auto stem = query_stems[]
                nat count = count_of(counts, stem)
                if count > 0
                    matched += 1
                total += count
            if matched > 0
                ranked = ranked.append(Ranking(document.number, matched, total))
        ranked = sort_by<Ranking>(ranked, ranking_before)
        Ranking[] shown = limited<Ranking>(ranked, limit)
        string[] items = [
            for Ranking entry = shown[] then "{entry.number}:{entry.matched}:{entry.total}"
        ]
        emit("RANK count={len(ranked)}", items)
        return void

    void | error info(string[] arguments)
        nat index = try document_argument(arguments[0])
        Document document = documents[index]
        map.Map<string, nat> counts = term_frequencies(document)
        StemCount[] ranked = ranked_counts(counts)
        string top_stem = if len(ranked) == 0 then "-" else "{ranked[0].stem}:{ranked[0].count}"
        nat indexed = 0
        for StemCount entry = ranked[]
            indexed += entry.count
        string sizes = "lines={len(document.lines)} tokens={len(document.tokens)}"
        emit("INFO {document.number} {sizes} indexed={indexed} stems={counts.size()} top={top_stem}")
        return void

    void | error show_line(string[] arguments)
        nat index = try document_argument(arguments[0])
        nat line_number = try number_argument(arguments[1], 1, max_line_number)
        Document document = documents[index]
        if line_number > len(document.lines)
            return error("NO LINE {document.number}:{line_number}")
        Token[] tokens = document.line_tokens(line_number)
        string[] items = [for Token token = tokens[] then describe_token(token)]
        emit("LINE {document.number}:{line_number} tokens={len(tokens)}", items)
        return void

    void | error stats(string[] arguments)
        nat lines = 0
        nat tokens = 0
        nat indexed = 0
        for Document document = documents[]
            lines += len(document.lines)
            tokens += len(document.tokens)
            for Token token = document.tokens[]
                if is_indexed(token)
                    indexed += 1
        string totals = "lines={lines} tokens={tokens} indexed={indexed}"
        string sizes = "stems={total_frequencies().size()} stopwords={len(stopwords)}"
        emit("STATS docs={len(documents)} {totals} {sizes}")
        return void

    void | error .stop_word(string[] arguments)
        string word = try word_argument(arguments[0])
        if includes(stopwords, word)
            return error("ALREADY STOPWORD {word}")
        stopwords = stopwords.append(word)
        emit("STOP {word} unindexed={form_count(word)}")
        return void

    void | error .unstop_word(string[] arguments)
        string word = try word_argument(arguments[0])
        if not includes(stopwords, word)
            return error("NOT STOPWORD {word}")
        stopwords = [for auto stopword = stopwords[] if stopword != word then stopword]
        emit("UNSTOP {word} indexed={form_count(word)}")
        return void

    void | error .append_line(string[] arguments)
        nat number = try number_argument(arguments[0], 1, max_document_number)
        bool created = false
        nat index = 0
        match find_document(number)
            nat found
                index = found
            none
                index = .add_document(number)
                created = true
        Token[] tokens = .add_line(index, arguments[1])
        nat indexed = 0
        for Token token = tokens[]
            if is_indexed(token)
                indexed += 1
        string counts = "tokens={len(tokens)} indexed={indexed}"
        emit("APPEND {number} line={len(documents[index].lines)} {counts} new={yes_no(created)}")
        return void

    void | error .delete_document(string[] arguments)
        nat index = try document_argument(arguments[0])
        Document document = documents[index]
        documents = documents[0:<index].concat(documents[index + 1:<len(documents)])
        string sizes = "lines={len(document.lines)} tokens={len(document.tokens)}"
        emit("DELETE {document.number} {sizes}")
        return void

    void | error .run(string line)
        string name = line
        string[] arguments = []
        match line.find(" ")
            nat space
                name = line[0:<space]
                arguments = split_arguments(name, line[space + 1:<len(line)])
            none
                void
        Command command = try find_command(name)
        if not (command.minimum <= len(arguments) <= command.maximum)
            return error("BAD ARGUMENTS {name}")
        if name == "STEM"
            return stem_words(arguments)
        elif name == "STEPS"
            return show_steps(arguments)
        elif name == "MEASURE"
            return show_measure(arguments)
        elif name == "INDEX"
            return show_index(arguments)
        elif name == "SEARCH"
            return search(arguments)
        elif name == "PHRASE"
            return phrase(arguments)
        elif name == "NEAR"
            return near(arguments)
        elif name == "TOP"
            return top(arguments)
        elif name == "KWIC"
            return kwic(arguments)
        elif name == "TF"
            return term_frequency(arguments)
        elif name == "DF"
            return document_frequency(arguments)
        elif name == "VARIANTS"
            return variants(arguments)
        elif name == "SIMILAR"
            return similar(arguments)
        elif name == "RANK"
            return rank(arguments)
        elif name == "INFO"
            return info(arguments)
        elif name == "LINE"
            return show_line(arguments)
        elif name == "STATS"
            return stats(arguments)
        elif name == "STOP"
            return .stop_word(arguments)
        elif name == "UNSTOP"
            return .unstop_word(arguments)
        elif name == "APPEND"
            return .append_line(arguments)
        return .delete_document(arguments)

    void .execute(string line)
        match .run(line)
            void
                void
            error problem
                print("ERROR {problem.message}{NL}")

string[] read_lines()
    string[] lines = []
    string line = ""
    bool reading = true
    while reading
        match scan(&line)
            void
                lines = lines.append(line)
            error
                reading = false
    return lines

string[] input_lines = read_lines()
string[] header_words = input_lines[0].split(" ")
auto engine = SearchEngine(header_words[1:<len(header_words)])
nat line_index = 1
while input_lines[line_index].starts_with("DOC ")
    string document_line = input_lines[line_index]
    nat document_index = .engine.add_document(nat.parse(document_line[4:<len(document_line)]))
    line_index += 1
    while input_lines[line_index] != "ENDDOC"
        .engine.add_line(document_index, input_lines[line_index])
        line_index += 1
    line_index += 1
while input_lines[line_index] != "END"
    .engine.execute(input_lines[line_index])
    line_index += 1
