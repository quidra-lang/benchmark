void emit(string text)
    print(text + NL)

int absolute(int value)
    return if value < 0 then -value else value

int sign(int value)
    return if value < 0 then -1 elif value > 0 then 1 else 0

int character_index(string text, string character)
    for nat i < len(text)
        if text[i] == character
            return int(i)
    return -1

string upper(string piece)
    int found = character_index("kqrbnp", piece)
    return if found < 0 then piece else "KQRBNP"[found]

string lower(string piece)
    int found = character_index("KQRBNP", piece)
    return if found < 0 then piece else "kqrbnp"[found]

string color(string piece)
    return if "KQRBNP".contains(piece) then "w" else "b"

string opposite(string side)
    return if side == "w" then "b" else "w"

string colored(string kind, string side)
    return if side == "w" then kind else lower(kind)

string square_name(int square)
    return "abcdefgh"[square % 8] + "12345678"[square / 8]

int square_value(string text)
    if len(text) != 2
        return -1
    int file_index = character_index("abcdefgh", text[0])
    int rank = character_index("12345678", text[1])
    return if file_index < 0 or rank < 0 then -1 else rank * 8 + file_index

int numeric(string text, int low, int high)
    if len(text) == 0 or (len(text) > 1 and text[0] == "0")
        return -1
    for nat i < len(text)
        if not "0123456789".contains(text[i])
            return -1
    int result = int.parse(text)
    return if low <= result <= high then result else -1

class Move(int source, int target, string promotion = "")
    string uci()
        return square_name(source) + square_name(target) + lower(promotion)

class Position(string[] board, string side, string rights, int ep, int halfmove, int fullmove)
    bool attacks(int source, int target)
        if source == target or board[source] == "."
            return false
        int dx = target % 8 - source % 8
        int dy = target / 8 - source / 8
        string piece = board[source]
        string kind = upper(piece)
        if kind == "P"
            return absolute(dx) == 1 and dy == (if color(piece) == "w" then 1 else -1)
        if kind == "N"
            return absolute(dx) * absolute(dy) == 2
        if kind == "K"
            return absolute(dx) <= 1 and absolute(dy) <= 1
        bool straight = dx == 0 or dy == 0
        bool diagonal = absolute(dx) == absolute(dy)
        if not ((kind == "R" and straight) or (kind == "B" and diagonal) or (kind == "Q" and (straight or diagonal)))
            return false
        int step = sign(dx) + 8 * sign(dy)
        int at = source + step
        while at != target
            if board[at] != "."
                return false
            at += step
        return true

    int[] attackers(int target, string attacker_color)
        return [for int source < 64 if board[source] != "." and color(board[source]) == attacker_color and attacks(source, target) then source]

    int king(string king_color)
        for int square < 64
            if board[square] == colored("K", king_color)
                return square
        return -1

    bool checked(string king_color)
        return len(attackers(king(king_color), opposite(king_color))) > 0

    bool castle(Move move)
        return upper(board[move.source]) == "K" and absolute(move.target - move.source) == 2

    bool en_passant(Move move)
        return upper(board[move.source]) == "P" and move.source % 8 != move.target % 8 and board[move.target] == "."

    bool capture(Move move)
        return board[move.target] != "." or en_passant(move)

    Position after(Move move)
        string[] next_board = board
        string piece = board[move.source]
        string kind = upper(piece)
        int direction = if side == "w" then 8 else -8
        if en_passant(move)
            next_board[move.target - direction] = "."
        if castle(move)
            int base = if side == "w" then 0 else 56
            int rook_source = base + (if move.target > move.source then 7 else 0)
            int rook_target = base + (if move.target > move.source then 5 else 3)
            next_board[rook_target] = next_board[rook_source]
            next_board[rook_source] = "."
        next_board[move.target] = if move.promotion == "" then piece else colored(move.promotion, side)
        next_board[move.source] = "."
        string next_rights = ""
        int[] rook_squares = [7, 0, 63, 56]
        for nat i < len(rights)
            string right = rights[i]
            int rook_square = rook_squares[character_index("KQkq", right)]
            if (kind != "K" or color(right) != side) and move.source != rook_square and move.target != rook_square
                next_rights += right
        int next_ep = if kind == "P" and absolute(move.target - move.source) == 16 then (move.source + move.target) / 2 else -1
        int next_half = if kind == "P" or capture(move) then 0 else halfmove + 1
        return Position(next_board, opposite(side), next_rights, next_ep, next_half, fullmove + (if side == "b" then 1 else 0))

    string castle_reason(bool kingside)
        string right = colored(if kingside then "K" else "Q", side)
        int base = if side == "w" then 0 else 56
        if not rights.contains(right)
            return "no castling right"
        int[] path = if kingside then [5, 6] else [1, 2, 3]
        for int file_index = path[]
            if board[base + file_index] != "."
                return "path blocked"
        if checked(side)
            return "in check"
        if len(attackers(base + (if kingside then 5 else 3), opposite(side))) > 0
            return "through check"
        Position resulting = after(Move(base + 4, base + (if kingside then 6 else 2)))
        if resulting.checked(side)
            return "into check"
        return ""

    Move[] pseudo()
        Move[] result = []
        for int source < 64
            string piece = board[source]
            if piece == "." or color(piece) != side
                continue
            string kind = upper(piece)
            int direction = if side == "w" then 8 else -8
            for int target < 64
                bool possible = false
                if kind != "P"
                    possible = attacks(source, target) and (board[target] == "." or color(board[target]) != side)
                else
                    if attacks(source, target)
                        possible = target == ep or (board[target] != "." and color(board[target]) != side)
                    elif target == source + direction
                        possible = board[target] == "."
                    elif target == source + 2 * direction and source / 8 == (if side == "w" then 1 else 6)
                        possible = board[target] == "." and board[source + direction] == "."
                if possible
                    if kind == "P" and target / 8 == (if side == "w" then 7 else 0)
                        for string promotion = ["Q", "R", "B", "N"][]
                            result = result.append(Move(source, target, promotion))
                    else
                        result = result.append(Move(source, target))
        return result

    Move[] legal()
        Move[] result = []
        for Move move = pseudo()[]
            Position resulting = after(move)
            if not resulting.checked(side)
                result = result.append(move)
        int base = if side == "w" then 0 else 56
        for bool kingside = [true, false][]
            if castle_reason(kingside) == ""
                result = result.append(Move(base + 4, base + (if kingside then 6 else 2)))
        return result

    string disambiguation(Move move, Move[] moves)
        bool any_other = false
        bool same_file = false
        bool same_rank = false
        for Move other = moves[]
            if other.target == move.target and other.source != move.source and board[other.source] == board[move.source] and not castle(other)
                any_other = true
                same_file = same_file or other.source % 8 == move.source % 8
                same_rank = same_rank or other.source / 8 == move.source / 8
        if not any_other
            return ""
        string name = square_name(move.source)
        return if not same_file then name[0] elif not same_rank then name[1] else name

    string mark(Move move)
        Position resulting = after(move)
        if not resulting.checked(resulting.side)
            return ""
        return if len(resulting.legal()) == 0 then "#" else "+"

    string san(Move move, Move[] moves)
        string notation = ""
        string kind = upper(board[move.source])
        if castle(move)
            notation = if move.target > move.source then "O-O" else "O-O-O"
        elif kind == "P"
            if capture(move)
                notation = square_name(move.source)[0] + "x"
            notation += square_name(move.target)
            if move.promotion != ""
                notation += "=" + move.promotion
        else
            notation = kind + disambiguation(move, moves) + (if capture(move) then "x" else "") + square_name(move.target)
        return notation + mark(move)

    string fen()
        string[] ranks = []
        for 7 >= int rank >= 0
            string row = ""
            int empty = 0
            for int file_index < 8
                string piece = board[rank * 8 + file_index]
                if piece == "."
                    empty += 1
                else
                    if empty > 0
                        row += empty.string()
                        empty = 0
                    row += piece
            if empty > 0
                row += empty.string()
            ranks = ranks.append(row)
        return ranks.join("/") + " " + side + " " + (if rights == "" then "-" else rights) + " " + (if ep < 0 then "-" else square_name(ep)) + " {halfmove} {fullmove}"

    string key()
        int relevant_ep = -1
        for Move move = legal()[]
            if en_passant(move)
                relevant_ep = ep
        return board.join("") + side + rights + " {relevant_ep}"

    bool insufficient()
        int non_kings = 0
        bool bishops_only = true
        int bishop_color = -1
        for int square < 64
            string kind = upper(board[square])
            if kind == "." or kind == "K"
                continue
            if kind == "P" or kind == "R" or kind == "Q"
                return false
            non_kings += 1
            if kind != "B"
                bishops_only = false
            else
                int parity = (square / 8 + square % 8) % 2
                if bishop_color >= 0 and bishop_color != parity
                    bishops_only = false
                bishop_color = parity
        return non_kings <= 1 or bishops_only

Position | error parse_fen(string[] fields)
    if len(fields) != 6
        return error("fields")
    string[] rows = fields[0].split("/")
    if len(rows) != 8
        return error("placement")
    string[] board = array(64, fill = ".")
    for nat row < 8
        int file_index = 0
        bool previous_digit = false
        for nat i < len(rows[row])
            string character = rows[row][i]
            bool digit = "12345678".contains(character)
            if digit
                if previous_digit
                    return error("placement")
                file_index += int.parse(character)
            else
                if not "KQRBNPkqrbnp".contains(character) or file_index >= 8
                    return error("placement")
                board[(7 - int(row)) * 8 + file_index] = character
                file_index += 1
            previous_digit = digit
        if file_index != 8
            return error("placement")
    int white_kings = 0
    int black_kings = 0
    for string piece = board[]
        if piece == "K"
            white_kings += 1
        if piece == "k"
            black_kings += 1
    if white_kings != 1 or black_kings != 1
        return error("kings")
    for int square < 64
        if (square < 8 or square >= 56) and upper(board[square]) == "P"
            return error("pawns")
    if fields[1] != "w" and fields[1] != "b"
        return error("side")
    string rights = if fields[2] == "-" then "" else fields[2]
    int last = -1
    int[] rook_squares = [7, 0, 63, 56]
    for nat i < len(rights)
        int at = character_index("KQkq", rights[i])
        if at <= last or at < 0
            return error("castling")
        last = at
        int base = if at < 2 then 0 else 56
        string side = if at < 2 then "w" else "b"
        if board[base + 4] != colored("K", side) or board[rook_squares[at]] != colored("R", side)
            return error("castling")
    int ep = -1
    if fields[3] != "-"
        ep = square_value(fields[3])
        if ep < 0
            return error("en passant")
        int direction = if fields[1] == "w" then 8 else -8
        if ep / 8 != (if fields[1] == "w" then 5 else 2) or board[ep] != "." or board[ep + direction] != "." or board[ep - direction] != colored("P", opposite(fields[1]))
            return error("en passant")
    int halfmove = numeric(fields[4], 0, 999)
    int fullmove = numeric(fields[5], 1, 999)
    if halfmove < 0 or fullmove < 0 or (ep >= 0 and halfmove != 0)
        return error("clocks")
    Position position = Position(board, fields[1], rights, ep, halfmove, fullmove)
    if position.checked(opposite(position.side))
        return error("check")
    return position

Position initial()
    Position result = parse_fen("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1".split(" "))
    return result

Move | error read_uci(Position position, string text)
    if len(text) != 4 and len(text) != 5
        return error("syntax")
    int source = square_value(text[:<2])
    int target = square_value(text[2:<4])
    string promotion = if len(text) == 5 then upper(text[4]) else ""
    if source < 0 or target < 0 or (len(text) == 5 and not "qrbn".contains(text[4]))
        return error("syntax")
    Move[] moves = position.legal()
    if len(moves) == 0
        return error("game over")
    if position.board[source] == "." or color(position.board[source]) != position.side
        return error("no piece")
    Move[] matching = [for Move move = moves[] if move.source == source and move.target == target then move]
    if len(matching) == 0
        for Move move = position.pseudo()[]
            if move.source == source and move.target == target
                return error("leaves king in check")
        return error("no such move")
    if matching[0].promotion != "" and promotion == ""
        return error("missing promotion")
    if matching[0].promotion == "" and promotion != ""
        return error("invalid promotion")
    return Move(source, target, promotion)

class SanRequest(string kind, int target, bool capture, string file_index, string rank, string promotion, string mark, int castling)

SanRequest | error parse_san(string text)
    string remaining = text
    string mark = ""
    if len(remaining) > 0 and (remaining[len(remaining) - 1] == "+" or remaining[len(remaining) - 1] == "#")
        mark = remaining[len(remaining) - 1]
        remaining = remaining[:<len(remaining) - 1]
    if remaining == "O-O" or remaining == "O-O-O"
        return SanRequest("K", -1, false, "", "", "", mark, if remaining == "O-O" then 1 else 2)
    string promotion = ""
    if len(remaining) >= 2 and remaining[len(remaining) - 2] == "="
        promotion = remaining[len(remaining) - 1]
        if not "QRBN".contains(promotion)
            return error("syntax")
        remaining = remaining[:<len(remaining) - 2]
    if len(remaining) < 2
        return error("syntax")
    int target = square_value(remaining[len(remaining) - 2:])
    if target < 0
        return error("syntax")
    remaining = remaining[:<len(remaining) - 2]
    bool capture = len(remaining) > 0 and remaining[len(remaining) - 1] == "x"
    if capture
        remaining = remaining[:<len(remaining) - 1]
    string kind = "P"
    string file_index = ""
    string rank = ""
    if len(remaining) > 0 and "KQRBN".contains(remaining[0])
        kind = remaining[0]
        remaining = remaining[1:]
        if len(remaining) > 0 and "abcdefgh".contains(remaining[0])
            file_index = remaining[0]
            remaining = remaining[1:]
        if len(remaining) > 0 and "12345678".contains(remaining[0])
            rank = remaining[0]
            remaining = remaining[1:]
        if remaining != "" or promotion != ""
            return error("syntax")
    elif capture
        if len(remaining) != 1 or not "abcdefgh".contains(remaining)
            return error("syntax")
        file_index = remaining
    elif remaining != ""
        return error("syntax")
    return SanRequest(kind, target, capture, file_index, rank, promotion, mark, 0)

bool matches(Position position, Move move, SanRequest request)
    string source = square_name(move.source)
    return upper(position.board[move.source]) == request.kind and move.target == request.target and not position.castle(move) and (request.file_index == "" or request.file_index == source[0]) and (request.rank == "" or request.rank == source[1]) and (request.kind != "P" or (move.source % 8 != move.target % 8) == request.capture)

Move | error read_san(Position position, string text)
    SanRequest request = try parse_san(text)
    Move[] moves = position.legal()
    if len(moves) == 0
        return error("game over")
    Move selected = Move(0, 0)
    if request.castling != 0
        string reason = position.castle_reason(request.castling == 1)
        if reason != ""
            return error(reason)
        int base = if position.side == "w" then 0 else 56
        selected = Move(base + 4, base + (if request.castling == 1 then 6 else 2))
    else
        Move[] matching = [for Move move = moves[] if matches(position, move, request) then move]
        if len(matching) == 0
            for Move move = position.pseudo()[]
                if matches(position, move, request)
                    return error("leaves king in check")
            return error("no such move")
        selected = matching[0]
        for Move move = matching[]
            if move.source != selected.source
                return error("ambiguous")
        if position.capture(selected) != request.capture
            return error("capture mark")
        if selected.promotion != "" and request.promotion == ""
            return error("missing promotion")
        if selected.promotion == "" and request.promotion != ""
            return error("invalid promotion")
        if request.kind != "P" and request.file_index + request.rank != position.disambiguation(selected, moves)
            return error("disambiguation")
        selected = Move(selected.source, selected.target, request.promotion)
    if position.mark(selected) != request.mark
        return error("check mark")
    return selected

int[] perft(Position position, int depth)
    if depth == 0
        return [1, 0, 0, 0, 0, 0, 0]
    int[] result = array(7, fill = 0)
    for Move move = position.legal()[]
        Position resulting = position.after(move)
        if depth > 1
            int[] counts = perft(resulting, depth - 1)
            for nat i < 7
                result[i] += counts[i]
        else
            result[0] += 1
            if position.capture(move)
                result[1] += 1
            if position.en_passant(move)
                result[2] += 1
            if position.castle(move)
                result[3] += 1
            if move.promotion != ""
                result[4] += 1
            if resulting.checked(resulting.side)
                result[5] += 1
                if len(resulting.legal()) == 0
                    result[6] += 1
    return result

class Record(Position before, string san, string uci, string captured)

class Game()
    Position current = initial()
    Position start = current
    Record[] records = []
    bool loaded = false

    void .play(Move move)
        string captured = if current.board[move.target] != "." then lower(current.board[move.target]) elif current.en_passant(move) then "p" else "-"
        records = records.append(Record(current, current.san(move, current.legal()), move.uci(), captured))
        current = current.after(move)

    int repetitions()
        string target = current.key()
        int count = 1
        for Record record = records[]
            if record.before.key() == target
                count += 1
        return count

    string state()
        bool checked = current.checked(current.side)
        bool mobile = len(current.legal()) > 0
        return if checked then (if mobile then "check" else "checkmate") else (if mobile then "normal" else "stalemate")

    string[] draws()
        string[] result = []
        if current.halfmove >= 100
            result = result.append("fifty")
        if repetitions() >= 3
            result = result.append("threefold")
        if current.insufficient()
            result = result.append("insufficient")
        return result

    string game_result()
        string status = state()
        if status == "checkmate"
            return if current.side == "b" then "1-0" else "0-1"
        return if status == "stalemate" or len(draws()) > 0 then "1/2-1/2" else "*"

    void .execute(string[] words)
        string command = words[0]
        string[] args = words[1:]
        string[] commands = ["NEW", "LOAD", "FEN", "BOARD", "MOVE", "UCI", "LEGAL", "STATUS", "UNDO", "PERFT", "DIVIDE", "ATTACKS", "PINS", "HISTORY", "PGN"]
        bool known = false
        for string item = commands[]
            if item == command
                known = true
        if not known
            emit("ERROR unknown command")
            return
        bool valid = true
        int numeric_arg = -1
        if command == "LOAD"
            match parse_fen(args)
                Position position
                    current = position
                    start = position
                    records = []
                    loaded = true
                    emit("OK")
                error failure
                    emit("ERROR bad fen (" + failure.message + ")")
            return
        if command == "MOVE" or command == "UCI"
            valid = len(args) > 0
        elif command == "LEGAL"
            valid = len(args) <= 1 and (len(args) == 0 or square_value(args[0]) >= 0)
        elif command == "ATTACKS"
            valid = len(args) == 1 and square_value(args[0]) >= 0
        elif command == "UNDO" or command == "PERFT" or command == "DIVIDE"
            if len(args) == 1
                numeric_arg = numeric(args[0], 1, if command == "UNDO" then 9999 else 3)
            valid = numeric_arg >= 0
        else
            valid = len(args) == 0
        if not valid
            emit("ERROR bad arguments")
            return
        if command == "NEW"
            current = initial()
            start = current
            records = []
            loaded = false
            emit("OK")
        elif command == "FEN"
            emit(current.fen())
        elif command == "BOARD"
            for 7 >= int rank >= 0
                emit((rank + 1).string() + " " + current.board[rank * 8:<rank * 8 + 8].join(" "))
            emit("  a b c d e f g h")
        elif command == "MOVE" or command == "UCI"
            string[] played = []
            string failure_line = ""
            for nat i < len(args)
                Move | error attempt = if command == "MOVE" then read_san(current, args[i]) else read_uci(current, args[i])
                match attempt
                    Move move
                        .play(move)
                        played = played.append(records[len(records) - 1].san)
                    error failure
                        failure_line = "ILLEGAL move {i + 1}: {args[i]} (" + failure.message + ")"
                if failure_line != ""
                    break
            if command == "UCI" and len(played) > 0
                emit("san " + played.join(" "))
            if failure_line != ""
                emit(failure_line)
            elif command == "MOVE"
                emit("OK")
        elif command == "LEGAL" or command == "DIVIDE"
            Move[] moves = current.legal()
            string[] names = [for Move move = moves[] then current.san(move, moves)]
            string[] sorted_names = names.sorted()
            string[] selected = []
            int total = 0
            for string name = sorted_names[]
                for nat i < len(moves)
                    if names[i] != name
                        continue
                    if command == "LEGAL"
                        if len(args) == 0 or moves[i].source == square_value(args[0])
                            selected = selected.append(name)
                    else
                        int count = perft(current.after(moves[i]), numeric_arg - 1)[0]
                        total += count
                        emit("{name} {count}")
            if command == "DIVIDE"
                emit("total {total}")
            else
                emit(["legal {len(selected)}"].concat(selected).join(" "))
        elif command == "STATUS"
            string side_word = if current.side == "w" then "white" else "black"
            emit(["status {side_word} " + state() + " rep {repetitions()}"].concat(draws()).join(" "))
        elif command == "UNDO"
            if numeric_arg > int(len(records))
                emit("ERROR cannot undo")
            else
                nat retained = len(records) - nat(numeric_arg)
                current = records[retained].before
                records = records[:<retained]
                emit("OK")
        elif command == "PERFT"
            int[] counts = perft(current, numeric_arg)
            string[] fields = ["nodes", "captures", "ep", "castles", "promotions", "checks", "mates"]
            string[] output = ["perft {numeric_arg}"]
            for nat i < 7
                output = output.append(fields[i] + " {counts[i]}")
            emit(output.join(" "))
        elif command == "ATTACKS"
            int target = square_value(args[0])
            string[] output = ["attacks " + args[0]]
            for string side = ["w", "b"][]
                int[] sources = current.attackers(target, side)
                output = output.append((if side == "w" then "white" else "black") + " {len(sources)}")
                for int source = sources[]
                    output = output.append(square_name(source))
            emit(output.join(" "))
        elif command == "PINS"
            int king_square = current.king(current.side)
            int[] pinning = array(64, fill = -1)
            for -1 <= int dx <= 1
                for -1 <= int dy <= 1
                    if dx == 0 and dy == 0
                        continue
                    int file_index = king_square % 8 + dx
                    int rank = king_square / 8 + dy
                    int candidate = -1
                    while 0 <= file_index < 8 and 0 <= rank < 8
                        int square = rank * 8 + file_index
                        string piece = current.board[square]
                        if piece != "."
                            if candidate < 0 and color(piece) == current.side
                                candidate = square
                            else
                                string kind = upper(piece)
                                if candidate >= 0 and color(piece) != current.side and (kind == "Q" or (kind == "R" and (dx == 0 or dy == 0)) or (kind == "B" and dx != 0 and dy != 0))
                                    pinning[candidate] = square
                                break
                        file_index += dx
                        rank += dy
            string[] entries = [for int square < 64 if pinning[square] >= 0 then square_name(square) + "-" + square_name(pinning[square])]
            emit(["pins {len(entries)}"].concat(entries).join(" "))
        elif command == "HISTORY"
            emit("history {len(records)}")
            for nat i < len(records)
                Record record = records[i]
                emit("{i + 1} {record.uci} {record.san} {record.captured}")
        else
            string outcome = game_result()
            emit("[Result " + DQ + outcome + DQ + "]")
            if loaded
                emit("[SetUp " + DQ + "1" + DQ + "]")
                emit("[FEN " + DQ + start.fen() + DQ + "]")
            string[] output = []
            for nat i < len(records)
                Record record = records[i]
                if record.before.side == "w"
                    output = output.append("{record.before.fullmove}.")
                elif i == 0
                    output = output.append("{record.before.fullmove}...")
                output = output.append(record.san)
            emit(output.append(outcome).join(" "))

void run_commands()
    Game game = Game()
    nat count = 0
    scan(&count)
    for nat i < count
        string line = ""
        scan(&line)
        .game.execute(line.split(" "))

run_commands()
