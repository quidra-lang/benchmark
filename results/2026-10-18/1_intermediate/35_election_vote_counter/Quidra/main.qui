import math

enum MethodKind
    Plurality
    Runoff
    Irv
    Coombs
    Bucklin
    Borda
    Baldwin
    Nanson
    Black
    Veto
    Condorcet
    Copeland
    Minimax
    Schulze
    RankedPairs
    Kemeny
    Approval
    Stv

enum MinimaxKind
    Winning
    Margin
    Opposition

class Method(MethodKind kind, int parameter = 0, MinimaxKind score = MinimaxKind.Winning)
class Ballot(int votes, int[] ranking)
class Tallies(int[] first, int[] last, int[] borda, int[][] approval, int nonblank)
class Outcome(int[] order, string[] rows)
class Choice(int candidate, bool tie)
class Edge(int from, int to)
class Election(int number, string[] names)
    bool[] active = array(len(names), fill = true)
    int[] tiebreak = []
    int[] priority = array(len(names), fill = 0)
    Ballot[] groups = []
    int[] ends = []
    int total = 0
    map.Map<int, Tallies> cache = map.Map<int, Tallies>()
    int[][] pairs = []

class Laboratory
    int number = 0
    Election | none current = none

int position_of<T>(const T[] values, T value)
    for nat index = values.indices()[]
        if values[index] == value
            return int(index)
    return -1

int[] sequence(int count)
    int[] result = []
    for 0 <= int index < count
        result = result.append(index)
    return result

int[] active_field(const Election election)
    int[] result = []
    for nat candidate = election.names.indices()[]
        if election.active[candidate]
            result = result.append(int(candidate))
    return result

int[] without(const int[] values, const int[] removed)
    int[] result = []
    for int value = values[]
        if position_of(removed, value) < 0
            result = result.append(value)
    return result

int[] effective(const int[] ranking, const int[] field)
    int[] result = []
    for int candidate = ranking[]
        if position_of(field, candidate) >= 0
            result = result.append(candidate)
    return result

int[] selected(const int[] values, const int[] indices)
    int[] result = []
    for int index = indices[]
        result = result.append(values[index])
    return result

int field_id(const int[] field)
    int[] powers = []
    for int candidate = field[]
        powers = powers.append(2 ^ candidate)
    return math.sum(powers)

int[] members(int field, int count)
    int[] result = []
    for 0 <= int candidate < count
        if field / (2 ^ candidate) % 2 == 1
            result = result.append(candidate)
    return result

string name_list(const Election election, const int[] candidates, string separator = ", ")
    string[] parts = []
    for int candidate = candidates[]
        parts = parts.append(election.names[candidate])
    return parts.join(separator)

string tie_text(bool tie)
    return if tie then " (tie)" else ""

string money(int value)
    string fraction = (value % 100).string()
    if len(fraction) == 1
        fraction = "0" + fraction
    return (value / 100).string() + "." + fraction

string value_list(const Election election, const int[] field, const int[] values, bool cents = false)
    string[] parts = []
    for int candidate = field[]
        string value = if cents then money(values[candidate]) else values[candidate].string()
        parts = parts.append(election.names[candidate] + " " + value)
    return parts.join(", ")

// Numeric grouping retains the supplied order at equal values.
int[] stable_order(const int[] original, const int[] values, bool descending)
    int[] distinct = []
    for int candidate = original[]
        if position_of(distinct, values[candidate]) < 0
            distinct = distinct.append(values[candidate])
    int[] result = []
    for int value = distinct.sorted(descending = descending)[]
        for int candidate = original[]
            if values[candidate] == value
                result = result.append(candidate)
    return result

int[] ordered(const Election election, const int[] field, const int[] values, bool descending)
    return stable_order(effective(election.tiebreak, field), values, descending)

Outcome finish(const Election election, const int[] order, bool tie, const string[] rows)
    return Outcome(order, rows.append("winner: " + election.names[order[0]] + tie_text(tie)))

int | error candidate_index(const Election election, string name)
    int index = position_of(election.names, name)
    if index < 0
        return error("unknown candidate " + name)
    return index

int[] | error checked_names(const Election election, const string[] names)
    int[] result = []
    for string name = names[]
        int candidate = try candidate_index(election, name)
        if position_of(result, candidate) >= 0
            return error("duplicate candidate " + name)
        result = result.append(candidate)
    return result

void invalidate(Election &election)
    election.cache = map.Map<int, Tallies>()
    election.pairs = []

Tallies count_field(const Election election, const int[] field)
    int[] zero = array(len(election.names), fill = 0)
    auto result = Tallies(zero, zero, zero, array(len(field), fill = zero), 0)
    int size = int(len(field))
    for Ballot group = election.groups[]
        int[] ranking = effective(group.ranking, field)
        if len(ranking) > 0
            result.first[ranking[0]] += group.votes
            result.nonblank += group.votes
        if len(ranking) == len(field)
            result.last[ranking[size - 1]] += group.votes
        else
            for int candidate = without(field, ranking)[]
                result.last[candidate] += group.votes
        for nat place = ranking.indices()[]
            int candidate = ranking[place]
            result.borda[candidate] += group.votes * (size - int(place) - 1)
            for int(place) <= int depth < size
                result.approval[depth][candidate] += group.votes
    return result

Tallies tallies(Election &election, const int[] field)
    int key = field_id(field)
    match election.cache.get(key)
        Tallies cached
            return cached
        none
            Tallies result = count_field(election, field)
            .election.cache.set(key, result)
            return result

int[][] pairwise(Election &election)
    if len(election.pairs) > 0
        return election.pairs
    nat count = len(election.names)
    int[][] result = array(count, fill = array(count, fill = 0))
    for Ballot group = election.groups[]
        int[] positions = array(count, fill = int(count))
        for nat place = group.ranking.indices()[]
            positions[group.ranking[place]] = int(place)
        for nat first = election.names.indices()[]
            for nat second = election.names.indices()[]
                if positions[first] < positions[second]
                    result[first][second] += group.votes
    election.pairs = result
    return result

bool majority(const int[] field, const int[] values)
    int total = math.sum(selected(values, field))
    return 2 * math.max_all(selected(values, field)) > total

Choice look_back(const Election election, const int[] field, const int[][] history)
    int[] choices = field
    bool tie = false
    for int(len(history)) - 1 >= int round >= 0
        int minimum = math.min_all(selected(history[round], choices))
        int[] following = []
        for int candidate = choices[]
            if history[round][candidate] == minimum
                following = following.append(candidate)
        choices = following
        if round == int(len(history)) - 1
            tie = len(choices) > 1
    int[] order = effective(election.tiebreak, choices)
    return Choice(order[int(len(order)) - 1], tie)

int condorcet(Election &election, const int[] field, bool loser)
    int[][] matrix = pairwise(&election)
    for int candidate = field[]
        bool all = true
        for int other = without(field, [candidate])[]
            if (loser and matrix[candidate][other] >= matrix[other][candidate]) or (not loser and matrix[candidate][other] <= matrix[other][candidate])
                all = false
        if all
            return candidate
    return -1

Outcome elimination(Election &election, const int[] field, bool coombs, bool exhausted = false)
    int[] remaining = field
    int[] removed = []
    int[][] history = []
    string[] rows = []
    while true
        Tallies scores = tallies(&election, remaining)
        int round = int(len(rows)) + 1
        string row
        if exhausted
            int active = math.sum(selected(scores.first, remaining))
            row = "round {round}: active {active}, exhausted {election.total - active}"
        else
            row = "round {round}: " + value_list(election, remaining, scores.first)
        if len(remaining) == 1 or majority(remaining, scores.first)
            int[] order = ordered(election, remaining, scores.first, true)
            for int(len(removed)) - 1 >= int index >= 0
                order = order.append(removed[index])
            rows = rows.append(row)
            return if exhausted then Outcome(order, rows) else finish(election, order, false, rows)
        Choice choice
        if coombs
            int maximum = math.max_all(selected(scores.last, remaining))
            int[] choices = []
            for int candidate = remaining[]
                if scores.last[candidate] == maximum
                    choices = choices.append(candidate)
            int[] order = ordered(election, choices, scores.first, true)
            choice = Choice(order[int(len(order)) - 1], len(choices) > 1)
            row = row + "; last " + value_list(election, remaining, scores.last)
        else
            history = history.append(scores.first)
            choice = look_back(election, remaining, history)
        if not exhausted
            row = row + "; eliminated " + election.names[choice.candidate] + tie_text(choice.tie)
        rows = rows.append(row)
        removed = removed.append(choice.candidate)
        remaining = without(remaining, [choice.candidate])

Outcome runoff(Election &election, const int[] field)
    Tallies first = tallies(&election, field)
    int[] order = ordered(election, field, first.first, true)
    string[] rows = ["round 1: " + value_list(election, field, first.first)]
    bool tie = false
    if not majority(field, first.first)
        int first_candidate = order[0]
        int second_candidate = order[1]
        int[] finalists = [first_candidate, second_candidate].sorted()
        bool advance = len(order) >= 3 and first.first[order[1]] == first.first[order[2]]
        Tallies second = tallies(&election, finalists)
        tie = second.first[first_candidate] == second.first[second_candidate]
        if second.first[second_candidate] > second.first[first_candidate]
            (order[0], order[1]) = (order[1], order[0])
        rows = rows.append("finalists: " + name_list(election, finalists) + tie_text(advance))
        rows = rows.append("round 2: " + value_list(election, finalists, second.first))
    return finish(election, order, tie, rows)

Outcome bucklin(Election &election, const int[] field)
    Tallies scores = tallies(&election, field)
    int line = scores.nonblank / 2 + 1
    string[] rows = ["majority: {line}"]
    int[] order = effective(election.tiebreak, field)
    int[] final = []
    for nat depth = field.indices()[]
        final = scores.approval[depth]
        order = stable_order(order, final, true)
        rows = rows.append("round {depth + 1}: " + value_list(election, field, final))
        if math.max_all(selected(final, field)) >= line
            break
    return finish(election, order, final[order[0]] == final[order[1]], rows)

Outcome borda_elimination(Election &election, const int[] field, bool nanson)
    int[] remaining = field
    int[] tail = []
    int[][] history = []
    string[] rows = []
    while len(remaining) >= 2
        int[] scores = tallies(&election, remaining).borda
        string row = "round {len(rows) + 1}: " + value_list(election, remaining, scores)
        int[] removed
        if nanson
            int total = math.sum(selected(scores, remaining))
            int[] below = []
            for int candidate = remaining[]
                if scores[candidate] * int(len(remaining)) < total
                    below = below.append(candidate)
            if len(below) == 0
                rows = rows.append(row)
                break
            row = row + "; eliminated " + name_list(election, below)
            removed = ordered(election, below, scores, true)
        else
            history = history.append(scores)
            Choice choice = look_back(election, remaining, history)
            removed = [choice.candidate]
            row = row + "; eliminated " + election.names[choice.candidate] + tie_text(choice.tie)
        rows = rows.append(row)
        remaining = without(remaining, removed)
        tail = removed.concat(tail)
    int[] order = effective(election.tiebreak, remaining).concat(tail)
    return finish(election, order, nanson and len(remaining) > 1, rows)

string[] pair_lines(const Election election, const int[] field, const int[][] matrix)
    string[] rows = []
    for nat index = field.indices()[]
        int first = field[index]
        for int second = field[int(index) + 1:][]
            int forward = matrix[first][second]
            int backward = matrix[second][first]
            string result = if forward == backward then "tie" elif forward > backward then election.names[first] else election.names[second]
            rows = rows.append(election.names[first] + " vs " + election.names[second] + ": {forward}-{backward} ({result})")
    return rows

bool[][] closure(const int[] field, bool[][] relation)
    for int via = field[]
        for int first = field[]
            for int second = field[]
                relation[first][second] = relation[first][second] or (relation[first][via] and relation[via][second])
    return relation

Outcome condorcet_report(Election &election, const int[] field)
    int win = condorcet(&election, field, false)
    int lose = condorcet(&election, field, true)
    int[][] matrix = pairwise(&election)
    bool[][] weak = array(len(election.names), fill = array(len(election.names), fill = false))
    bool[][] strong = weak
    for int first = field[]
        for int second = field[]
            weak[first][second] = matrix[first][second] >= matrix[second][first]
            strong[first][second] = matrix[first][second] > matrix[second][first]
    weak = closure(field, weak)
    strong = closure(field, strong)
    int[] smith = []
    int[] schwartz = []
    for int candidate = field[]
        bool top = true
        bool unbeaten = true
        for int other = field[]
            top = top and weak[candidate][other]
            unbeaten = unbeaten and (not strong[other][candidate] or strong[candidate][other])
        if top
            smith = smith.append(candidate)
        if unbeaten
            schwartz = schwartz.append(candidate)
    string winner = if win < 0 then "NONE" else election.names[win]
    string loser = if lose < 0 then "NONE" else election.names[lose]
    return Outcome([], ["winner: " + winner, "loser: " + loser, "smith: " + name_list(election, smith), "schwartz: " + name_list(election, schwartz)])

(int[], bool) topological(const Election election, const int[] field, const bool[][] relation)
    int[] remaining = field
    int[] order = []
    bool tie = false
    while len(remaining) > 0
        int[] choices = []
        for int candidate = remaining[]
            bool incoming = false
            for int other = without(remaining, [candidate])[]
                incoming = incoming or relation[other][candidate]
            if not incoming
                choices = choices.append(candidate)
        if len(order) == 0
            tie = len(choices) > 1
        int chosen = effective(election.tiebreak, choices)[0]
        order = order.append(chosen)
        remaining = without(remaining, [chosen])
    return (order, tie)

Outcome schulze(Election &election, const int[] field)
    int[][] matrix = pairwise(&election)
    int[][] paths = array(len(election.names), fill = array(len(election.names), fill = 0))
    for int first = field[]
        for int second = field[]
            if matrix[first][second] > matrix[second][first]
                paths[first][second] = matrix[first][second]
    for int via = field[]
        for int first = without(field, [via])[]
            for int second = without(field, [via, first])[]
                paths[first][second] = math.max(paths[first][second], math.min(paths[first][via], paths[via][second]))
    bool[][] relation = array(len(election.names), fill = array(len(election.names), fill = false))
    for int first = field[]
        for int second = field[]
            relation[first][second] = paths[first][second] > paths[second][first]
    (int[] order, bool tie) = topological(election, field, relation)
    string[] rows = pair_lines(election, field, paths).append("ranking: " + name_list(election, order, " > "))
    return finish(election, order, tie, rows)

Outcome ranked_pairs(Election &election, const int[] field)
    int[][] matrix = pairwise(&election)
    Edge[] edges = []
    int[] wins = []
    int[] losses = []
    int[] sources = []
    int[] destinations = []
    for int first = field[]
        for int second = field[]
            if matrix[first][second] > matrix[second][first]
                edges = edges.append(Edge(first, second))
                wins = wins.append(matrix[first][second])
                losses = losses.append(matrix[second][first])
                sources = sources.append(election.priority[first])
                destinations = destinations.append(election.priority[second])
    int[] order = stable_order(sequence(int(len(edges))), destinations, false)
    order = stable_order(order, sources, false)
    order = stable_order(order, losses, false)
    order = stable_order(order, wins, true)
    bool[][] locked = array(len(election.names), fill = array(len(election.names), fill = false))
    bool[][] reached = locked
    string[] rows = []
    for int index = order[]
        Edge edge = edges[index]
        bool accepted = not reached[edge.to][edge.from]
        string label = if accepted then "lock" else "skip"
        rows = rows.append(label + " " + election.names[edge.from] + ">" + election.names[edge.to] + " " + matrix[edge.from][edge.to].string() + "-" + matrix[edge.to][edge.from].string())
        if accepted
            locked[edge.from][edge.to] = true
            reached[edge.from][edge.to] = true
            reached = closure(field, reached)
    (int[] standings, bool tie) = topological(election, field, locked)
    return finish(election, standings, tie, rows)

Outcome kemeny(Election &election, const int[] field)
    int[][] matrix = pairwise(&election)
    int limit = 2 ^ int(len(election.names))
    int[] best = array(nat(limit), fill = 0)
    int[] ways = array(nat(limit), fill = 0)
    int[][] heads = array(nat(limit), fill = [])
    ways[0] = 1
    for 1 <= int subset < limit
        int[] candidates = members(subset, int(len(election.names)))
        if len(without(candidates, field)) > 0
            continue
        best[subset] = -1
        for int candidate = candidates[]
            int rest = subset - 2 ^ candidate
            int score = best[rest] + math.sum(selected(matrix[candidate], without(candidates, [candidate])))
            if score > best[subset]
                best[subset] = score
                ways[subset] = 0
                heads[subset] = []
            if score == best[subset]
                ways[subset] += ways[rest]
                heads[subset] = heads[subset].append(candidate)
    int key = field_id(field)
    int remaining = key
    int[] order = []
    while remaining > 0
        int candidate = effective(election.tiebreak, heads[remaining])[0]
        order = order.append(candidate)
        remaining -= 2 ^ candidate
    string[] rows = ["score: " + best[key].string(), "optimal: " + ways[key].string(), "ranking: " + name_list(election, order, " > ")]
    return finish(election, order, len(heads[key]) > 1, rows)

Outcome stv(Election &election, const int[] field, int seats)
    int[] values = array(len(election.groups), fill = 0)
    for nat index = election.groups.indices()[]
        if len(effective(election.groups[index].ranking, field)) > 0
            values[index] = 100
    int quota = tallies(&election, field).nonblank * 100 / (seats + 1) + 1
    int[] continuing = field
    int[] elected = []
    int[][] history = []
    string[] rows = ["quota: " + money(quota)]
    while true
        int[] scores = array(len(election.names), fill = 0)
        int[] owners = array(len(election.groups), fill = -1)
        int exhausted = 0
        for nat index = election.groups.indices()[]
            if values[index] == 0
                continue
            Ballot group = election.groups[index]
            int[] ranking = effective(group.ranking, continuing)
            int value = group.votes * values[index]
            if len(ranking) > 0
                owners[index] = ranking[0]
                scores[ranking[0]] += value
            else
                exhausted += value
        history = history.append(scores)
        string row = "round {len(history)}: " + value_list(election, continuing, scores, true) + "; exhausted " + money(exhausted)
        int[] order = ordered(election, continuing, scores, true)
        if int(len(continuing)) == seats - int(len(elected))
            elected = elected.concat(order)
            rows = rows.append(row + "; elected " + name_list(election, order))
            break
        int chosen = order[0]
        if scores[chosen] >= quota
            int surplus = scores[chosen] - quota
            elected = elected.append(chosen)
            continuing = without(continuing, [chosen])
            for nat index = owners.indices()[]
                if owners[index] == chosen
                    values[index] = values[index] * surplus / scores[chosen]
            rows = rows.append(row + "; elected " + election.names[chosen] + " (surplus " + money(surplus) + ")")
            if int(len(elected)) == seats
                break
        else
            Choice choice = look_back(election, continuing, history)
            continuing = without(continuing, [choice.candidate])
            rows = rows.append(row + "; excluded " + election.names[choice.candidate] + tie_text(choice.tie))
    return Outcome([], rows.append("elected: " + name_list(election, elected)))

string[] method_names()
    return ["PLURALITY", "RUNOFF", "IRV", "COOMBS", "BUCKLIN", "BORDA", "BALDWIN", "NANSON", "BLACK", "VETO", "CONDORCET", "COPELAND", "MINIMAX", "SCHULZE", "RANKEDPAIRS", "KEMENY", "APPROVAL", "STV"]

MethodKind[] method_kinds()
    return [MethodKind.Plurality, MethodKind.Runoff, MethodKind.Irv, MethodKind.Coombs, MethodKind.Bucklin, MethodKind.Borda, MethodKind.Baldwin, MethodKind.Nanson, MethodKind.Black, MethodKind.Veto, MethodKind.Condorcet, MethodKind.Copeland, MethodKind.Minimax, MethodKind.Schulze, MethodKind.RankedPairs, MethodKind.Kemeny, MethodKind.Approval, MethodKind.Stv]

Method parse_method(const string[] words)
    MethodKind kind = method_kinds()[position_of(method_names(), words[0])]
    auto method = Method(kind)
    if kind == MethodKind.Approval or kind == MethodKind.Stv
        method.parameter = int.parse(words[1])
    elif kind == MethodKind.Minimax
        method.score = if words[1] == "WINNING" then MinimaxKind.Winning elif words[1] == "MARGIN" then MinimaxKind.Margin else MinimaxKind.Opposition
    return method

string method_text(const Method method)
    string name = method_names()[position_of(method_kinds(), method.kind)]
    if method.kind == MethodKind.Minimax
        string kind = if method.score == MinimaxKind.Winning then "WINNING" elif method.score == MinimaxKind.Margin then "MARGIN" else "OPPOSITION"
        return name + " " + kind
    if method.kind == MethodKind.Approval or method.kind == MethodKind.Stv
        return name + " " + method.parameter.string()
    return name

Method[] summary_methods()
    return [Method(MethodKind.Plurality), Method(MethodKind.Runoff), Method(MethodKind.Irv), Method(MethodKind.Coombs), Method(MethodKind.Bucklin), Method(MethodKind.Borda), Method(MethodKind.Baldwin), Method(MethodKind.Nanson), Method(MethodKind.Black), Method(MethodKind.Veto), Method(MethodKind.Copeland), Method(MethodKind.Minimax), Method(MethodKind.Schulze), Method(MethodKind.RankedPairs), Method(MethodKind.Kemeny)]

Outcome tally(Election &election, const int[] field, const Method method)
    MethodKind kind = method.kind
    if kind == MethodKind.Runoff
        return runoff(&election, field)
    elif kind == MethodKind.Irv or kind == MethodKind.Coombs
        return elimination(&election, field, kind == MethodKind.Coombs)
    elif kind == MethodKind.Bucklin
        return bucklin(&election, field)
    elif kind == MethodKind.Baldwin or kind == MethodKind.Nanson
        return borda_elimination(&election, field, kind == MethodKind.Nanson)
    elif kind == MethodKind.Condorcet
        return condorcet_report(&election, field)
    elif kind == MethodKind.Schulze
        return schulze(&election, field)
    elif kind == MethodKind.RankedPairs
        return ranked_pairs(&election, field)
    elif kind == MethodKind.Kemeny
        return kemeny(&election, field)
    elif kind == MethodKind.Stv
        return stv(&election, field, method.parameter)
    Tallies base = tallies(&election, field)
    int[] scores = array(len(election.names), fill = 0)
    string label = "scores"
    bool descending = true
    string[] rows = []
    int winner = -1
    if kind == MethodKind.Plurality
        scores = base.first
        label = "votes"
    elif kind == MethodKind.Borda or kind == MethodKind.Black
        scores = base.borda
        if kind == MethodKind.Black
            winner = condorcet(&election, field, false)
            rows = rows.append("condorcet: " + (if winner < 0 then "NONE" else election.names[winner]))
    elif kind == MethodKind.Veto
        scores = base.last
        label = "vetoes"
        descending = false
    elif kind == MethodKind.Approval
        scores = base.approval[math.min(method.parameter, int(len(field))) - 1]
        label = "approvals"
    elif kind == MethodKind.Copeland
        int[][] matrix = pairwise(&election)
        string[] parts = []
        for int candidate = field[]
            int wins = 0
            int draws = 0
            int losses = 0
            for int other = without(field, [candidate])[]
                if matrix[candidate][other] > matrix[other][candidate]
                    wins += 1
                elif matrix[candidate][other] == matrix[other][candidate]
                    draws += 1
                else
                    losses += 1
            scores[candidate] = 2 * wins + draws
            int score = scores[candidate]
            parts = parts.append(election.names[candidate] + " {score / 2}.{score % 2 * 5} ({wins}-{draws}-{losses})")
        rows = rows.append("scores: " + parts.join(", "))
    elif kind == MethodKind.Minimax
        int[][] matrix = pairwise(&election)
        descending = false
        for int candidate = field[]
            int[] possibilities = []
            for int other = without(field, [candidate])[]
                int opposition = matrix[other][candidate]
                int support = matrix[candidate][other]
                int value = 0
                if method.score == MinimaxKind.Opposition
                    value = opposition
                elif opposition > support
                    value = if method.score == MinimaxKind.Margin then opposition - support else opposition
                possibilities = possibilities.append(value)
            scores[candidate] = math.max_all(possibilities)
    int[] order = ordered(election, field, scores, descending)
    bool tie = scores[order[0]] == scores[order[1]]
    if winner >= 0
        order = [winner].concat(without(order, [winner]))
        tie = false
    if kind != MethodKind.Copeland
        rows = rows.append(label + ": " + value_list(election, field, scores))
    return finish(election, order, tie, rows)

int count_or_zero(const map.Map<string, int> counts, string key)
    match counts.get(key)
        int count
            return count
        none
            return 0

string[] ballots_report(const Election election)
    map.Map<string, int> counts = map.Map<string, int>()
    int[] field = active_field(election)
    int blank = 0
    for Ballot group = election.groups[]
        int[] ranking = effective(group.ranking, field)
        string notation = if len(ranking) == 0 then "-" else name_list(election, ranking, ">")
        if len(ranking) == 0
            blank += group.votes
        .counts.set(notation, count_or_zero(counts, notation) + group.votes)
    string[] notations = counts.keys().sorted()
    int[] votes = []
    for string notation = notations[]
        votes = votes.append(count_or_zero(counts, notation))
    int[] order = stable_order(sequence(int(len(notations))), votes, true)
    string[] rows = ["total {election.total}, blank {blank}, distinct {len(notations)}"]
    for int index = order[]
        rows = rows.append(votes[index].string() + " " + notations[index])
    return rows

string[] status(const Election election)
    int[] withdrawn = []
    for nat candidate = election.names.indices()[]
        if not election.active[candidate]
            withdrawn = withdrawn.append(int(candidate))
    string missing = if len(withdrawn) == 0 then "none" else name_list(election, withdrawn)
    return ["election {election.number}", "active: " + name_list(election, active_field(election)), "withdrawn: " + missing, "tiebreak: " + name_list(election, election.tiebreak), "ballots: {election.total} in {len(election.ends)} entries"]

string[] | error execute_election(Election &election, const string[] words, string line)
    string command = words[0]
    if command == "BALLOT"
        int[] ranking = []
        if words[2] != "-"
            ranking = try checked_names(election, words[2].split(">"))
        int votes = int.parse(words[1])
        election.groups = election.groups.append(Ballot(votes, ranking))
        election.total += votes
        election.ends = election.ends.append(int(len(election.groups)))
        invalidate(&election)
        return []
    elif command == "RANDOM"
        int count = int.parse(words[1])
        int state = int.parse(words[2])
        for 0 <= int group < count
            int[] ranking = active_field(election)
            for int(len(ranking)) - 1 >= int place >= 1
                state = 48271 * state % 2147483647
                int other = state % (place + 1)
                (ranking[place], ranking[other]) = (ranking[other], ranking[place])
            state = 48271 * state % 2147483647
            int length = state % int(len(ranking)) + 1
            election.groups = election.groups.append(Ballot(1, ranking[:<length]))
        election.total += count
        election.ends = election.ends.append(int(len(election.groups)))
        invalidate(&election)
        return []
    elif command == "UNDO"
        if len(election.ends) == 0
            return error("nothing to undo")
        election.ends = election.ends[:<int(len(election.ends)) - 1]
        int end = if len(election.ends) == 0 then 0 else election.ends[int(len(election.ends)) - 1]
        int[] removed = []
        for Ballot group = election.groups[end:][]
            removed = removed.append(group.votes)
        election.total -= math.sum(removed)
        election.groups = election.groups[:<end]
        invalidate(&election)
        return []
    elif command == "WITHDRAW" or command == "RESTORE"
        int candidate = try candidate_index(election, words[1])
        if command == "WITHDRAW"
            if not election.active[candidate]
                return error("already withdrawn " + words[1])
            if len(active_field(election)) <= 2
                return error("too few candidates")
            election.active[candidate] = false
        else
            if election.active[candidate]
                return error("not withdrawn " + words[1])
            election.active[candidate] = true
        return []
    elif command == "TIEBREAK"
        int[] order = try checked_names(election, words[1:])
        if len(order) != len(election.names)
            return error("incomplete tiebreak")
        election.tiebreak = order
        for nat place = order.indices()[]
            election.priority[order[place]] = int(place)
        return []
    string[] rows = ["[" + line + "]"]
    if command == "STATUS"
        return rows.concat(status(election))
    if len(election.ends) == 0
        return error("no ballots")
    int[] field = active_field(election)
    if command == "RANKING" or command == "SPOILERS"
        Method method = parse_method(words[1:])
        if method.kind == MethodKind.Condorcet or method.kind == MethodKind.Stv
            return error("not rankable")
        if command == "SPOILERS" and len(field) < 3
            return error("too few candidates")
        Outcome result = tally(&election, field, method)
        if command == "RANKING"
            return rows.append(name_list(election, result.order, " > "))
        int winner = result.order[0]
        rows = rows.append("winner: " + election.names[winner])
        for int candidate = without(field, [winner])[]
            int other = tally(&election, without(field, [candidate]), method).order[0]
            string suffix = if other == winner then "" else " (changed)"
            rows = rows.append("without " + election.names[candidate] + ": " + election.names[other] + suffix)
        return rows
    int[] compared = []
    if command == "COMPARE"
        for string name = words[1:][]
            int candidate = try candidate_index(election, name)
            if not election.active[candidate]
                return error("withdrawn candidate " + name)
            compared = compared.append(candidate)
        if compared[0] == compared[1]
            return error("same candidate")
    if command == "STV" and int.parse(words[1]) >= int(len(field))
        return error("too many seats")
    if command == "BALLOTS"
        return rows.concat(ballots_report(election))
    elif command == "PROFILE"
        Tallies scores = tallies(&election, field)
        for int candidate = field[]
            string[] counts = []
            int previous = 0
            for nat depth = field.indices()[]
                int cumulative = scores.approval[depth][candidate]
                counts = counts.append((cumulative - previous).string())
                previous = cumulative
            rows = rows.append(election.names[candidate] + ": " + counts.join(" ") + " unranked {election.total - previous}")
        return rows
    elif command == "PAIRWISE"
        int[][] matrix = pairwise(&election)
        return rows.concat(pair_lines(election, field, matrix))
    elif command == "EXHAUSTED"
        return rows.concat(elimination(&election, field, false, true).rows)
    elif command == "SUMMARY" or command == "COMPARE"
        int[] wins = array(len(election.names), fill = 0)
        string[][] ahead = [[], []]
        for Method method = summary_methods()[]
            Outcome result = tally(&election, field, method)
            string label = method_text(method)
            if command == "SUMMARY"
                int winner = result.order[0]
                wins[winner] += 1
                rows = rows.append(label + ": " + election.names[winner])
            else
                int side = if position_of(result.order, compared[0]) < position_of(result.order, compared[1]) then 0 else 1
                ahead[side] = ahead[side].append(label)
        if command == "SUMMARY"
            return rows.append("wins: " + value_list(election, field, wins))
        int[][] matrix = pairwise(&election)
        int first = compared[0]
        int second = compared[1]
        int forward = matrix[first][second]
        int backward = matrix[second][first]
        rows = rows.append(election.names[first] + " {forward}, " + election.names[second] + " {backward}, neither {election.total - forward - backward}")
        for 0 <= int side < 2
            string text = if len(ahead[side]) == 0 then "none" else ahead[side].join(", ")
            rows = rows.append(election.names[compared[side]] + " ahead: " + text)
        return rows
    return rows.concat(tally(&election, field, parse_method(words)).rows)

string[] | error execute(Laboratory &lab, string line)
    string[] words = line.split(" ")
    if words[0] == "CANDIDATES"
        string[] names = words[1:]
        if len(names) == 1
            return error("too few candidates")
        string[] seen = []
        for string name = names[]
            if position_of(seen, name) >= 0
                return error("duplicate candidate " + name)
            seen = seen.append(name)
        auto election = Election(lab.number + 1, names)
        for string name = names.sorted()[]
            election.tiebreak = election.tiebreak.append(position_of(names, name))
        for nat place = election.tiebreak.indices()[]
            election.priority[election.tiebreak[place]] = int(place)
        lab.number += 1
        lab.current = election
        return ["election {lab.number}: {len(names)} candidates"]
    match lab.current
        Election election
            string[] rows = try execute_election(&election, words, line)
            lab.current = election
            return rows
        none
            return error("no election")

auto election_lab = Laboratory()
int command_count
scan(&command_count)
for 0 <= int command_index < command_count
    string command_line
    scan(&command_line)
    match execute(&election_lab, command_line)
        string[] rows
            for string row = rows[]
                print(row + NL)
        error problem
            print("ERROR " + problem.message + NL)
