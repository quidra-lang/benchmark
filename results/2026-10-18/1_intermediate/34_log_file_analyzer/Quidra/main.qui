import math

bool one_of(string value, string choices)
    return (" " + choices + " ").contains(" " + value + " ")

string[] words(string text)
    string[] result = []
    for string part = text.split(" ")[]
        if part != ""
            result = result.append(part)
    return result

bool digits(string text)
    if len(text) == 0
        return false
    for nat position < len(text)
        if not "0123456789".contains(text[position])
            return false
    return true

bool canonical(string text, int limit)
    return 0 < int(len(text)) <= limit and digits(text) and (len(text) == 1 or text[0] != "0")

bool leap(int year)
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

int month_days(int year, int month)
    int[] lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    return if month == 2 and leap(year) then 29 else lengths[month - 1]

bool valid_date(string text)
    if len(text) != 10 or text[4] != "-" or text[7] != "-"
        return false
    string year_text = text[0:<4]
    string month_text = text[5:<7]
    string day_text = text[8:<10]
    if not digits(year_text + month_text + day_text)
        return false
    int year = int.parse(year_text)
    int month = int.parse(month_text)
    int day = int.parse(day_text)
    return 2000 <= year <= 2059 and 1 <= month <= 12 and 1 <= day <= month_days(year, month)

bool valid_clock(string text)
    if len(text) != 8 or text[2] != ":" or text[5] != ":"
        return false
    if not digits(text[0:<2] + text[3:<5] + text[6:<8])
        return false
    return int.parse(text[0:<2]) < 24 and int.parse(text[3:<5]) < 60 and int.parse(text[6:<8]) < 60

bool valid_ip(string text)
    string[] parts = text.split(".")
    if len(parts) != 4
        return false
    for string part = parts[]
        if not canonical(part, 3) or int.parse(part) > 255
            return false
    return true

int ip_number(string text)
    int result = 0
    for string part = text.split(".")[]
        result = result * 256 + int.parse(part)
    return result

bool valid_status(string text)
    return len(text) == 3 and digits(text) and 100 <= int.parse(text) <= 599

bool status_matches(string pattern, int status)
    if one_of(pattern, "1xx 2xx 3xx 4xx 5xx")
        return status / 100 == int.parse(pattern[0])
    return status == int.parse(pattern)

bool valid_filter(string key, string value)
    if key == "METHOD"
        return one_of(value, "GET HEAD POST PUT DELETE PATCH OPTIONS")
    if key == "STATUS"
        return one_of(value, "1xx 2xx 3xx 4xx 5xx") or valid_status(value)
    if key == "IP"
        return valid_ip(value)
    return value.starts_with("/")

string argument_error(string kind, string value, const string[] args)
    if one_of(kind, "limit minutes width threshold length times")
        int upper = 100000
        if kind == "limit"
            upper = 100
        elif kind == "minutes"
            upper = 1440
        elif kind == "length"
            upper = 86400
        elif kind == "times"
            upper = 1000
        if not canonical(value, 6) or not (1 <= int.parse(value) <= upper)
            return "invalid number"
    elif kind == "kind"
        if not one_of(value, "PATHS IPS")
            return "invalid kind"
    elif kind == "path"
        if not value.starts_with("/")
            return "invalid path"
    elif kind == "ip"
        if not valid_ip(value)
            return "invalid ip"
    elif kind == "date"
        if not valid_date(value)
            return "invalid timestamp"
    elif kind == "clock"
        if not valid_clock(value)
            return "invalid timestamp"
    elif kind == "key"
        if not one_of(value, "METHOD STATUS IP PATH")
            return "invalid key"
    elif kind == "subject"
        if not one_of(value, "METHOD STATUS IP PATH RANGE")
            return "invalid key"
    elif kind == "value"
        if not valid_filter(args[0], value)
            return "invalid value"
    return ""

string[] query_form(string command)
    if command == "TOP"
        return ["kind", "limit"]
    if command == "TIMELINE"
        return ["minutes"]
    if command == "LATENCY"
        return ["path"]
    if command == "HISTOGRAM"
        return ["width"]
    if command == "APDEX"
        return ["threshold"]
    if command == "SLOWEST"
        return ["limit"]
    if command == "SESSIONS"
        return ["ip", "minutes"]
    if command == "BURST"
        return ["length", "times"]
    if one_of(command, "PEAK GAPS")
        return ["length"]
    if command == "IP"
        return ["ip"]
    if command == "RANGE"
        return ["date", "clock", "date", "clock"]
    if command == "FILTER"
        return ["key", "value"]
    if command == "UNFILTER"
        return ["subject"]
    return []

string malformed_reason(const string[] fields)
    if len(fields) != 8
        return "fields"
    if not valid_date(fields[0])
        return "date"
    if not valid_clock(fields[1])
        return "time"
    if not valid_ip(fields[2])
        return "ip"
    if not one_of(fields[3], "GET HEAD POST PUT DELETE PATCH OPTIONS")
        return "method"
    if not fields[4].starts_with("/")
        return "path"
    if not valid_status(fields[5])
        return "status"
    if not canonical(fields[6], 8)
        return "bytes"
    if not canonical(fields[7], 6)
        return "latency"
    return ""

int seconds_of(string date, string clock)
    int year = int.parse(date[0:<4])
    int month = int.parse(date[5:<7])
    int days = int.parse(date[8:<10]) - 1
    for 2000 <= int prior < year
        days += if leap(prior) then 366 else 365
    for 1 <= int prior < month
        days += month_days(year, prior)
    return days * 86400 + int.parse(clock[0:<2]) * 3600 + int.parse(clock[3:<5]) * 60 + int.parse(clock[6:<8])

string padded(int value, int width)
    string text = value.string()
    return string.repeat("0", nat(math.max(0, width - int(len(text))))) + text

string interval_label(int seconds)
    int days = seconds / 86400
    int minutes = seconds % 86400 / 60
    int year = 2000
    while days >= (if leap(year) then 366 else 365)
        days -= if leap(year) then 366 else 365
        year += 1
    int month = 1
    while days >= month_days(year, month)
        days -= month_days(year, month)
        month += 1
    return "{year}-{padded(month, 2)}-{padded(days + 1, 2)} {padded(minutes / 60, 2)}:{padded(minutes % 60, 2)}"

string normalize_path(string raw)
    string[] parts = []
    string path = raw.split("?")[0]
    for string part = path.split("/")[]
        if part == ".."
            if len(parts) > 0
                parts = parts[0:<int(len(parts)) - 1]
        elif part != "" and part != "."
            parts = parts.append(part)
    string result = "/"
    for nat position < len(parts)
        string part = parts[position]
        if digits(part)
            part = "{{id}}"
        elif len(part) >= 8
            bool hexadecimal = true
            bool has_digit = false
            for nat offset < len(part)
                hexadecimal = hexadecimal and "0123456789abcdef".contains(part[offset])
                has_digit = has_digit or "0123456789".contains(part[offset])
            if hexadecimal and has_digit
                part = "{{hex}}"
        if position > 0
            result += "/"
        result += part
    return result

string decimal(int numerator, int denominator, int places)
    int scale = 10 ^ places
    int value = numerator * scale / denominator
    return "{value / scale}.{padded(value % scale, places)}"

string percentage(int amount, int total)
    return decimal(amount * 100, total, 2) + "%"

string byte_text(int size)
    if size >= 1073741824
        return decimal(size, 1073741824, 1) + "GB"
    if size >= 1048576
        return decimal(size, 1048576, 1) + "MB"
    if size >= 1024
        return decimal(size, 1024, 1) + "KB"
    return "{size}B"

void emit(string text)
    print(text + NL)

void bar_line(string label, int count, int maximum)
    if count == 0
        emit("{label} 0")
    else
        string bar = string.repeat("#", nat((count * 30 + maximum - 1) / maximum))
        emit("{label} {count} {bar}")

class LogData()
    int line_count = 0
    string[] dates = []
    string[] stamps = []
    string[] ips = []
    string[] methods = []
    string[] paths = []
    int[] moments = []
    int[] hours = []
    int[] statuses = []
    int[] sizes = []
    int[] latencies = []
    int[] ip_codes = []
    int[] bad_lines = []
    string[] bad_reasons = []
    int[] order = []
    string method_filter = ""
    string status_filter = ""
    string ip_filter = ""
    string path_filter = ""
    int first_second = -1
    int last_second = -1
    string first_label = ""
    string last_label = ""

    void .ingest(string text)
        line_count += 1
        string[] fields = words(text)
        string reason = malformed_reason(fields)
        if reason != ""
            bad_lines = bad_lines.append(line_count)
            bad_reasons = bad_reasons.append(reason)
            return
        dates = dates.append(fields[0])
        stamps = stamps.append(fields[0] + " " + fields[1])
        ips = ips.append(fields[2])
        methods = methods.append(fields[3])
        paths = paths.append(normalize_path(fields[4]))
        moments = moments.append(seconds_of(fields[0], fields[1]))
        hours = hours.append(int.parse(fields[1][0:<2]))
        statuses = statuses.append(int.parse(fields[5]))
        sizes = sizes.append(int.parse(fields[6]))
        latencies = latencies.append(int.parse(fields[7]))
        ip_codes = ip_codes.append(ip_number(fields[2]))

    void .prepare()
        map.Map<int, int> positions
        int length = int(len(moments))
        for 0 <= int index < length
            .positions.set(moments[index] * (length + 1) + index, index)
        order = []
        for int key = positions.keys().sorted()[]
            match positions.get(key)
                int index
                    order = order.append(index)
                none
                    process.exit(1)

    int[] selected()
        int[] result = []
        for int index = order[]
            if first_second >= 0 and not (first_second <= moments[index] <= last_second)
                continue
            if method_filter != "" and methods[index] != method_filter
                continue
            if status_filter != "" and not status_matches(status_filter, statuses[index])
                continue
            if ip_filter != "" and ips[index] != ip_filter
                continue
            if path_filter != "" and paths[index] != path_filter
                continue
            result = result.append(index)
        return result

    string key_at(int index, string kind)
        if kind == "IP"
            return ips[index]
        if kind == "METHOD"
            return methods[index]
        if kind == "DATE"
            return dates[index]
        if kind == "ENDPOINT"
            return paths[index] + " " + methods[index]
        return paths[index]

    int unique_count(const int[] members, string kind)
        set.Set<string> seen
        for int index = members[]
            .seen.add(key_at(index, kind))
        return int(seen.size())

class Group(string label, int tie, int[] members, local const LogData data, local int threshold)
    int count = int(len(members))
    int bytes = data.sizes[members].sum()
    int total_latency = data.latencies[members].sum()
    int maximum = data.latencies[members].max_all()
    local int[] codes = data.statuses[members]
    local int[] delays = data.latencies[members]
    local int[] failures = codes[codes >= 400]
    int client = int(len(failures[failures < 500]))
    int server = int(len(codes[codes >= 500]))
    local int[] eligible = delays[codes < 500]
    int satisfied = int(len(eligible[eligible <= threshold]))
    local int[] slower = eligible[eligible > threshold]
    int tolerating = int(len(slower[slower <= 4 * threshold]))
    int peak_count = 0
    int peak_first = 0
    int peak_last = 0

    int points()
        return 2 * satisfied + tolerating

    string rating()
        int score = points() * 100
        int total = 2 * count
        if score >= 94 * total
            return "excellent"
        if score >= 85 * total
            return "good"
        if score >= 70 * total
            return "fair"
        if score >= 50 * total
            return "poor"
        return "unacceptable"

Group[] grouped(const LogData data, const int[] members, string kind, int threshold = 0)
    map.Map<string, int[]> buckets
    for int index = members[]
        string key = data.key_at(index, kind)
        int[] bucket = []
        match buckets.get(key)
            int[] existing
                bucket = existing
            none
                bucket = []
        .buckets.set(key, bucket.append(index))
    Group[] result = []
    string[] names = buckets.keys().sorted()
    for nat position < len(names)
        string key = names[position]
        match buckets.get(key)
            int[] bucket
                int tie = if kind == "IP" then data.ip_codes[bucket[0]] else int(position)
                result = result.append(Group(key, tie, bucket, data, threshold))
            none
                process.exit(1)
    return result

bool group_before(const Group left, const Group right, string mode)
    int comparison = right.count - left.count
    if mode == "APDEX"
        comparison = left.points() * right.count - right.points() * left.count
        if comparison == 0
            comparison = right.count - left.count
    elif mode == "ERRORS"
        int left_errors = left.client + left.server
        int right_errors = right.client + right.server
        comparison = right_errors * left.count - left_errors * right.count
        if comparison == 0
            comparison = right_errors - left_errors
    elif mode == "SLOWEST"
        comparison = right.total_latency * left.count - left.total_latency * right.count
        if comparison == 0
            comparison = right.maximum - left.maximum
    elif mode == "BURST"
        comparison = right.peak_count - left.peak_count
    return if comparison != 0 then comparison < 0 else left.tie < right.tie

Group[] ranked(const Group[] values, string mode)
    int length = int(len(values))
    if length < 2
        return values
    int middle = length / 2
    Group[] left = ranked(values[0:<middle], mode)
    Group[] right = ranked(values[middle:], mode)
    Group[] result = []
    int i = 0
    int j = 0
    while i < int(len(left)) and j < int(len(right))
        if group_before(right[j], left[i], mode)
            result = result.append(right[j])
            j += 1
        else
            result = result.append(left[i])
            i += 1
    if i < int(len(left))
        result = result.concat(left[i:])
    if j < int(len(right))
        result = result.concat(right[j:])
    return result

(int, int, int) peak(const LogData data, const int[] members, int width)
    int begin = 0
    int best = 0
    int first_index = members[0]
    int last_index = members[0]
    for 0 <= int end < int(len(members))
        while data.moments[members[end]] - data.moments[members[begin]] >= width
            begin += 1
        if end - begin + 1 > best
            best = end - begin + 1
            first_index = members[begin]
            last_index = members[end]
    return (best, first_index, last_index)

void run_query(LogData &data, string command, const string[] args, const int[] ids)
    int n = int(len(ids))
    if command == "SUMMARY"
        int ip_count = data.unique_count(ids, "IP")
        int path_count = data.unique_count(ids, "PATH")
        emit("SUMMARY lines {data.line_count} valid {len(data.moments)} malformed {len(data.bad_lines)}")
        emit("requests {n} bytes {data.sizes[ids].sum()} ips {ip_count} paths {path_count}")
        if n == 0
            emit("span none")
        else
            emit("span {data.stamps[ids[0]]} {data.stamps[ids[n - 1]]} {data.moments[ids[n - 1]] - data.moments[ids[0]]}")
    elif command == "MALFORMED"
        emit("MALFORMED {len(data.bad_lines)}")
        for string reason = "fields date time ip method path status bytes latency".split(" ")[]
            int[] lines = []
            for nat position < len(data.bad_lines)
                if data.bad_reasons[position] == reason
                    lines = lines.append(data.bad_lines[position])
            if len(lines) > 0
                print("{reason} {len(lines)}")
                for int number = lines[]
                    print(" {number}")
                print(NL)
    elif command == "STATUS"
        emit("STATUS {n}")
        int[] codes = data.statuses[ids]
        for 1 <= int category <= 5
            int[] subset = codes[codes >= category * 100]
            int count = int(len(subset[subset < (category + 1) * 100]))
            emit("{category}xx {count} {percentage(count, n)}")
        int previous = -1
        for int code = codes.sorted()[]
            if code == previous
                continue
            previous = code
            int[] subset = codes[codes >= code]
            int count = int(len(subset[subset <= code]))
            emit("{code} {count} {percentage(count, n)}")
    elif command == "METHODS" or command == "TOP"
        string kind = if command == "METHODS" then "METHOD" elif args[0] == "IPS" then "IP" else "PATH"
        Group[] groups = ranked(grouped(data, ids, kind), "COUNT")
        int shown = if command == "METHODS" then int(len(groups)) else math.min(int.parse(args[1]), int(len(groups)))
        if command == "METHODS"
            emit("METHODS {n}")
        else
            emit("TOP {args[0]} {shown} of {len(groups)}")
        int rank = 0
        for 0 <= int position < shown
            Group item = groups[position]
            if position == 0 or item.count != groups[position - 1].count
                rank = position + 1
            if command == "TOP"
                print("{rank} ")
            emit("{item.label} {item.count} {percentage(item.count, n)}")
    elif command == "HOURLY"
        int[] counts = array(24, fill = 0)
        for int index = ids[]
            counts[data.hours[index]] += 1
        int maximum = counts.max_all()
        int first_hour = 0
        while counts[first_hour] != maximum
            first_hour += 1
        emit("HOURLY {n} peak {padded(first_hour, 2)} {maximum}")
        for 0 <= int hour < 24
            bar_line(padded(hour, 2), counts[hour], maximum)
    elif command == "TIMELINE" or command == "HISTOGRAM"
        int parameter = int.parse(args[0])
        int width = if command == "TIMELINE" then 60 * parameter else parameter
        int[] values = if command == "TIMELINE" then data.moments[ids] / width else data.latencies[ids] / width
        int low = values.min_all()
        int high = values.max_all()
        if high - low + 1 > 60
            emit("ERROR too many buckets")
            return
        int[] counts = array(nat(high - low + 1), fill = 0)
        for int value = values[]
            counts[value - low] += 1
        emit("{command} {parameter} {len(counts)}")
        int maximum = counts.max_all()
        for 0 <= int position < int(len(counts))
            int begin = (low + position) * width
            string label = if command == "TIMELINE" then interval_label(begin) else "{begin}-{begin + width - 1}"
            bar_line(label, counts[position], maximum)
    elif command == "BANDWIDTH" or command == "VISITORS"
        Group[] days = grouped(data, ids, "DATE")
        if command == "BANDWIDTH"
            int total = data.sizes[ids].sum()
            emit("BANDWIDTH {len(days)} {total} {byte_text(total)}")
            for Group day = days[]
                emit("{day.label} {day.count} {day.bytes} {byte_text(day.bytes)}")
        else
            set.Set<string> visited
            int ip_count = data.unique_count(ids, "IP")
            emit("VISITORS {len(days)} {ip_count}")
            for Group day = days[]
                set.Set<string> today
                int newcomers = 0
                for int index = day.members[]
                    string address = data.ips[index]
                    if not visited.has(address)
                        .visited.add(address)
                        newcomers += 1
                    .today.add(address)
                emit("{day.label} unique {today.size()} new {newcomers} returning {int(today.size()) - newcomers}")
    elif command == "LATENCY"
        int[] members = ids
        string label = "all"
        if len(args) > 0
            label = normalize_path(args[0])
            members = []
            for int index = ids[]
                if data.paths[index] == label
                    members = members.append(index)
        int count = int(len(members))
        if count == 0
            emit("LATENCY no records")
            return
        int[] values = data.latencies[members].sorted()
        int trim = count / 10
        int[] trimmed = values[trim:<count - trim]
        string mean = decimal(values.sum(), count, 2)
        string trimmed_mean = decimal(trimmed.sum(), int(len(trimmed)), 2)
        emit("LATENCY {label} count {count} min {values[0]} p50 {values[(50 * count + 99) / 100 - 1]} p90 {values[(90 * count + 99) / 100 - 1]} p99 {values[(99 * count + 99) / 100 - 1]} max {values[count - 1]} mean {mean} trimmed {trimmed_mean}")
    elif command == "APDEX"
        int threshold = int.parse(args[0])
        auto overall = Group("", 0, ids, data, threshold)
        emit("APDEX {threshold} {decimal(overall.points(), 2 * n, 3)} {overall.rating()} satisfied {overall.satisfied} tolerating {overall.tolerating} frustrated {n - overall.satisfied - overall.tolerating}")
        for Group item = ranked(grouped(data, ids, "PATH", threshold), "APDEX")[]
            emit("{item.label} {decimal(item.points(), 2 * item.count, 3)} {item.rating()} {item.count}")
    elif command == "ERRORS"
        int[] codes = data.statuses[ids]
        int failed = int(len(codes[codes >= 400]))
        emit("ERRORS {failed} of {n} {percentage(failed, n)}")
        for Group item = ranked(grouped(data, ids, "PATH"), "ERRORS")[]
            int failures = item.client + item.server
            if failures > 0
                emit("{item.label} {item.count} {item.client} {item.server} {percentage(failures, item.count)}")
    elif command == "SLOWEST"
        Group[] groups = ranked(grouped(data, ids, "ENDPOINT"), "SLOWEST")
        int shown = math.min(int.parse(args[0]), int(len(groups)))
        emit("SLOWEST {shown} of {len(groups)}")
        for 0 <= int position < shown
            Group item = groups[position]
            int sample = item.members[0]
            emit("{position + 1} {data.methods[sample]} {data.paths[sample]} count {item.count} avg {decimal(item.total_latency, item.count, 2)} max {item.maximum}")
    elif command == "SESSIONS" or command == "IP"
        int[] found = []
        for int index = ids[]
            if data.ips[index] == args[0]
                found = found.append(index)
        int count = int(len(found))
        if count == 0
            emit("{command} no records")
            return
        if command == "SESSIONS"
            int minutes = if len(args) == 2 then int.parse(args[1]) else 30
            int[] starts = [0]
            for 1 <= int position < count
                if data.moments[found[position]] - data.moments[found[position - 1]] > minutes * 60
                    starts = starts.append(position)
            starts = starts.append(count)
            int session_count = int(len(starts)) - 1
            int[] durations = []
            for 0 <= int position < session_count
                durations = durations.append(data.moments[found[starts[position + 1] - 1]] - data.moments[found[starts[position]]])
            emit("SESSIONS {args[0]} timeout {minutes} count {session_count} requests {count} avg_duration {decimal(durations.sum(), session_count, 1)} avg_requests {decimal(count, session_count, 1)}")
            for 0 <= int position < session_count
                int[] session = found[starts[position]:<starts[position + 1]]
                int path_count = data.unique_count(session, "PATH")
                emit("{position + 1} {data.stamps[session[0]]} {data.stamps[session[int(len(session)) - 1]]} {durations[position]} {len(session)} {path_count}")
        else
            int[] codes = data.statuses[found]
            int failed = int(len(codes[codes >= 400]))
            int path_count = data.unique_count(found, "PATH")
            emit("IP {args[0]} requests {count} bytes {data.sizes[found].sum()} errors {failed} paths {path_count}")
            emit("first {data.stamps[found[0]]} last {data.stamps[found[count - 1]]}")
            print("methods")
            for Group item = ranked(grouped(data, found, "METHOD"), "COUNT")[]
                print(" {item.label} {item.count}")
            print(NL + "classes")
            for 1 <= int category <= 5
                int[] subset = codes[codes >= category * 100]
                int amount = int(len(subset[subset < (category + 1) * 100]))
                print(" {category}xx {amount}")
            print(NL)
            Group[] paths = ranked(grouped(data, found, "PATH"), "COUNT")
            for 0 <= int position < math.min(3, int(len(paths)))
                emit("path {paths[position].label} {paths[position].count}")
    elif command == "BURST"
        int width = int.parse(args[0])
        int threshold = int.parse(args[1])
        int[] codes = data.statuses[ids]
        int[] failed = ids[codes >= 400]
        Group[] candidates = []
        for Group item = grouped(data, failed, "IP")[]
            (int count, int first, int last) = peak(data, item.members, width)
            if count >= threshold
                item.peak_count = count
                item.peak_first = first
                item.peak_last = last
                candidates = candidates.append(item)
        emit("BURST {width} {threshold} {len(candidates)}")
        for Group item = ranked(candidates, "BURST")[]
            emit("{item.label} {item.peak_count} {data.stamps[item.peak_first]} {data.stamps[item.peak_last]}")
    elif command == "PEAK"
        int width = int.parse(args[0])
        (int count, int first, int last) = peak(data, ids, width)
        emit("PEAK {width} {count} {data.stamps[first]} {data.stamps[last]}")
    elif command == "GAPS"
        int width = int.parse(args[0])
        int[] gaps = []
        for 1 <= int position < n
            if data.moments[ids[position]] - data.moments[ids[position - 1]] >= width
                gaps = gaps.append(position)
        emit("GAPS {width} {len(gaps)}")
        for int position = gaps[]
            int first = ids[position - 1]
            int last = ids[position]
            emit("{data.stamps[first]} {data.stamps[last]} {data.moments[last] - data.moments[first]}")
    elif command == "RANGE"
        int first = seconds_of(args[0], args[1])
        int last = seconds_of(args[2], args[3])
        if first > last
            emit("ERROR invalid range")
            return
        data.first_second = first
        data.last_second = last
        data.first_label = args[0] + " " + args[1]
        data.last_label = args[2] + " " + args[3]
        emit("RANGE {data.first_label} {data.last_label} active {len(data.selected())}")
    elif command == "FILTER" or command == "UNFILTER"
        string key = args[0]
        if key == "RANGE"
            if data.first_second < 0
                emit("ERROR not filtered")
                return
            data.first_second = -1
            data.last_second = -1
        else
            string &destination
            if key == "METHOD"
                &destination = &data.method_filter
            elif key == "STATUS"
                &destination = &data.status_filter
            elif key == "IP"
                &destination = &data.ip_filter
            else
                &destination = &data.path_filter
            if command == "UNFILTER"
                if destination == ""
                    emit("ERROR not filtered")
                    return
                destination = ""
            else
                destination = if key == "PATH" then normalize_path(args[1]) else args[1]
                emit("FILTER {key} {destination} active {len(data.selected())}")
                return
        emit("UNFILTER {key} active {len(data.selected())}")
    elif command == "RESET"
        data.method_filter = ""
        data.status_filter = ""
        data.ip_filter = ""
        data.path_filter = ""
        data.first_second = -1
        data.last_second = -1
        emit("RESET active {len(data.selected())}")
    elif command == "STATE"
        string period = if data.first_second < 0 then "-" else data.first_label + " " + data.last_label
        string method = if data.method_filter == "" then "-" else data.method_filter
        string status = if data.status_filter == "" then "-" else data.status_filter
        string ip = if data.ip_filter == "" then "-" else data.ip_filter
        string path = if data.path_filter == "" then "-" else data.path_filter
        emit("STATE active {n} range {period} method {method} status {status} ip {ip} path {path}")

void execute(LogData &data, string text)
    string[] fields = words(text)
    string command = fields[0]
    if not one_of(command, "SUMMARY MALFORMED STATUS METHODS TOP HOURLY TIMELINE BANDWIDTH VISITORS LATENCY HISTOGRAM APDEX ERRORS SLOWEST SESSIONS BURST PEAK GAPS IP RANGE FILTER UNFILTER RESET STATE")
        emit("ERROR unknown query")
        return
    string[] args = []
    if len(fields) > 1
        args = fields[1:]
    string[] form = query_form(command)
    int count = int(len(args))
    int maximum = int(len(form))
    int minimum = maximum - (if one_of(command, "LATENCY SESSIONS") then 1 else 0)
    if count < minimum or count > maximum
        emit("ERROR wrong arguments")
        return
    for 0 <= int position < count
        string reason = argument_error(form[position], args[position], args)
        if reason != ""
            emit("ERROR {reason}")
            return
    int[] members = data.selected()
    if len(members) == 0 and one_of(command, "STATUS METHODS TOP HOURLY TIMELINE BANDWIDTH VISITORS HISTOGRAM APDEX ERRORS SLOWEST BURST PEAK GAPS")
        emit("{command} no records")
        return
    run_query(&data, command, args, members)

auto analyzer = LogData()
while true
    string input_line
    scan(&input_line)
    if input_line == "---"
        break
    .analyzer.ingest(input_line)
.analyzer.prepare()
while true
    string input_line
    scan(&input_line)
    if input_line == "END"
        break
    execute(&analyzer, input_line)
