string[] setting_keys()
    return "PROTOCOL FRAMES WINDOW SEQBITS TIMEOUT DELAY INTERVAL MAXTICKS DUPACK NAK BACKOFF CONGESTION UNSAFE TRACE RANDOM LOSEDATA LOSECTRL CORRUPTDATA CORRUPTCTRL DELAYDATA DELAYCTRL SNAPSHOT".split(" ")
int lookup(const string[] items, string target)
    for nat j < len(items)
        if items[j] == target
            return int(j)
    return -1
int int_at(const int[] items, int target)
    for nat j < len(items)
        if items[j] == target
            return int(j)
    return -1
T[] erase<T>(const T[] items, int at)
    T[] result = []
    for nat j < len(items)
        if int(j) != at
            result = result.append(items[j])
    return result
int minimum(int a, int b)
    return if a < b then a else b
int maximum(int a, int b)
    return if a > b then a else b
int modulo(int a, int b)
    return ((a % b) + b) % b
string fixed(int numerator, int denominator, int digits)
    int scale = if digits == 2 then 100 else 10
    int value = numerator * scale / denominator
    int fraction = value % scale
    return "{value / scale}." + (if digits == 2 and fraction < 10 then "0" else "") + fraction.string()
string time_text(int tick)
    return if tick < 0 then "-" else tick.string()
string on_off(bool enabled)
    return if enabled then "on" else "off"
class Settings()
    string[][] values = [[], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], []]
    bool[] present = array(22, fill = false)
    string protocol = ""
    string trace = "ALL"
    int frames = 0
    int window = 0
    int bits = 0
    int timeout = 0
    int delay = 0
    int interval = 0
    int limit = 1000
    int dupack = 0
    bool nak = false
    bool backoff = false
    bool congestion = false
    bool unsafe = false
    int seed = 0
    int loss = 0
    int corruption = 0
    bool contains(int key, int target)
        for string word = values[key][]
            if int.parse(word) == target
                return true
        return false
    int extra(int key, int target)
        for string word = values[key][]
            string[] parts = word.split(":")
            if int.parse(parts[0]) == target
                return int.parse(parts[1])
        return 0
    string .validate(string earlier)
        if earlier != ""
            return earlier
        string[] names = setting_keys()
        for int j < 6
            if not present[j]
                return "missing key {names[j]}"
        int[] lower = [0, 1, 1, 1, 1, 1, 0, 1, 1]
        int[] upper = [0, 60, 32, 6, 50, 10, 10, 2000, 10]
        for int j < 22
            if not present[j]
                continue
            bool bad = false
            if j == 0
                bad = lookup(["SW", "GBN", "SR"], values[j][0]) < 0
            elif j <= 8
                int value = int.parse(values[j][0])
                bad = value < lower[j] or value > upper[j]
            elif j <= 12
                bad = lookup(["ON", "OFF"], values[j][0]) < 0
            elif j == 13
                bad = lookup(["ALL", "SENDER", "RECEIVER", "NONE"], values[j][0]) < 0
            elif j == 14
                int random_seed = int.parse(values[j][0])
                int p = int.parse(values[j][1])
                int c = int.parse(values[j][2])
                bad = random_seed < 1 or random_seed > 2147483646 or p < 0 or c < 0 or p + c > 100
            else
                int[] seen = []
                for string word = values[j][]
                    string[] parts = word.split(":")
                    int value = int.parse(parts[0])
                    if value < (if j == 21 then 0 else 1) or value > (if j == 21 then 2000 else 9999) or int_at(seen, value) >= 0
                        bad = true
                    seen = seen.append(value)
                    if j == 19 or j == 20
                        int extra_delay = int.parse(parts[1])
                        if extra_delay < 1 or extra_delay > 50
                            bad = true
            if bad
                return "bad value for {names[j]}"
        protocol = values[0][0]
        frames = int.parse(values[1][0])
        window = int.parse(values[2][0])
        bits = int.parse(values[3][0])
        timeout = int.parse(values[4][0])
        delay = int.parse(values[5][0])
        if present[6]
            interval = int.parse(values[6][0])
        if present[7]
            limit = int.parse(values[7][0])
        if present[8]
            dupack = int.parse(values[8][0])
        if present[9]
            nak = values[9][0] == "ON"
        if present[10]
            backoff = values[10][0] == "ON"
        if present[11]
            congestion = values[11][0] == "ON"
        if present[12]
            unsafe = values[12][0] == "ON"
        if present[13]
            trace = values[13][0]
        if present[14]
            seed = int.parse(values[14][0])
            loss = int.parse(values[14][1])
            corruption = int.parse(values[14][2])
        if protocol == "SR" and present[8]
            return "DUPACK not supported for SR"
        int modulus = 2 ^ bits
        int window_limit = if protocol == "SW" then 1 elif protocol == "GBN" then modulus - 1 else modulus / 2
        if window > window_limit and (not unsafe or protocol == "SW")
            return "window {window} exceeds limit {window_limit} for {protocol}"
        for int kind < 2
            int smallest = 10000
            for string word = values[15 + kind][]
                int value = int.parse(word)
                if contains(17 + kind, value)
                    smallest = minimum(smallest, value)
            if smallest < 10000
                string label = if kind == 0 then "data" else "control"
                return "{label} #{smallest} both lost and corrupted"
        return ""
class Event(int arrival, int value, int number, int outcome, bool nak = false)
class Buffered(int position, int payload)
class Record()
    int transmissions = 0
    int first = -1
    int delivered = -1
    int acked = -1
    int timer = -1
    bool marked = false
class Result(string name)
    string protocol = ""
    string status = "invalid"
    int delivered = 0
    int completion = 0
    int data = 0
class Simulation(Settings config)
    int tick = 0
    int base = 0
    int high = 0
    int next_frame = 0
    int current = config.timeout
    int timer = -1
    int duplicates = 0
    int receiver = 0
    bool nak_sent = false
    int cwnd = 1
    int threshold = config.window
    int growth = 0
    int random_state = config.seed
    Record[] records = array(nat(config.frames), fill = Record())
    Event[] data_events = []
    Event[] control_events = []
    Buffered[] buffer = []
    int[] queue = []
    int data = 0
    int resent = 0
    int control = 0
    int naks = 0
    int timeouts = 0
    int fast = 0
    int lost_data = 0
    int lost_ctrl = 0
    int corrupt_data = 0
    int corrupt_ctrl = 0
    int delivered = 0
    int errors = 0
    int discarded = 0
    int max_buffer = 0
    int latency = 0
    bool sr()
        return config.protocol == "SR"
    int modulus()
        return 2 ^ config.bits
    int effective()
        return if config.congestion then minimum(config.window, cwnd) else config.window
    void log(string side, string message)
        if config.trace == "ALL" or config.trace == side
            print("{tick} {message}{NL}")
    int .outcome(int number, bool is_control)
        int result = 0
        if config.seed != 0
            random_state = (48271 * random_state) % 2147483647
            int value = random_state % 100
            result = if value < config.loss then 1 elif value < config.loss + config.corruption then 2 else 0
        int offset = if is_control then 1 else 0
        if config.contains(15 + offset, number)
            result = 1
        if config.contains(17 + offset, number)
            result = 2
        return result
    void .send_control(int value, bool is_nak)
        control += 1
        if is_nak
            naks += 1
        string label = if is_nak then "NAK" else "ACK"
        log("RECEIVER", "{label} a={value} #{control}")
        int result = .outcome(control, true)
        control_events = control_events.append(Event(tick + config.delay + config.extra(20, control), value, control, result, is_nak))
    void .deliver(int payload)
        if payload == receiver
            log("RECEIVER", "DELIVER f={receiver}")
            delivered += 1
            records[payload].delivered = tick
            latency += tick - records[payload].first
        else
            log("RECEIVER", "DELIVER f={receiver} wrong={payload}")
            errors += 1
        receiver += 1
        nak_sent = false
    int buffered(int target)
        for nat j < len(buffer)
            if buffer[j].position == target
                return int(j)
        return -1
    void .discard(int sequence)
        discarded += 1
        log("RECEIVER", "DISCARD seq={sequence}")
    void .receive(const Event event)
        int sequence = event.value % modulus()
        log("RECEIVER", "RECV seq={sequence} #{event.number}")
        if not sr()
            if sequence == receiver % modulus()
                .deliver(event.value)
                .send_control(sequence, false)
            else
                .discard(sequence)
                if config.nak and not nak_sent
                    .send_control(receiver % modulus(), true)
                    nak_sent = true
                elif receiver > 0
                    .send_control((receiver - 1) % modulus(), false)
            return
        int offset = modulo(sequence - receiver, modulus())
        if offset < config.window
            int target = receiver + offset
            if buffered(target) >= 0
                .discard(sequence)
                .send_control(sequence, false)
            elif offset == 0
                .deliver(event.value)
                while buffered(receiver) >= 0
                    int at = buffered(receiver)
                    int payload = buffer[at].payload
                    buffer = erase(buffer, at)
                    .deliver(payload)
                .send_control(sequence, false)
            else
                buffer = buffer.append(Buffered(target, event.value))
                max_buffer = maximum(max_buffer, int(len(buffer)))
                log("RECEIVER", "BUFFER f={target}")
                .send_control(sequence, false)
                if config.nak and not nak_sent
                    .send_control(receiver % modulus(), true)
                    nak_sent = true
        else
            .discard(sequence)
            if modulo(receiver - sequence, modulus()) <= config.window
                .send_control(sequence, false)
    void .enqueue(int frame)
        if int_at(queue, frame) < 0
            queue = queue.append(frame)
    void .go_back()
        next_frame = base
        timer = -1
        duplicates = 0
    void .increase(int count)
        if not config.congestion
            return
        for int j < count
            if cwnd < config.window
                if cwnd < threshold
                    cwnd += 1
                else
                    growth += 1
                    if growth == cwnd
                        cwnd += 1
                        growth = 0
    void .decrease(bool timed_out)
        if config.congestion
            threshold = maximum(cwnd / 2, 1)
            cwnd = if timed_out then 1 else threshold
            growth = 0
    void changed(int old_cwnd, int old_threshold)
        if config.congestion and (old_cwnd != cwnd or old_threshold != threshold)
            log("SENDER", "CWND {cwnd} ssthresh={threshold}")
    void .control_arrival(const Event event)
        int old_cwnd = cwnd
        int old_threshold = threshold
        int old_base = base
        int frame = base + modulo(event.value - base, modulus())
        bool accepted = false
        if not sr()
            accepted = if event.nak then frame <= high else frame < high
            if accepted
                base = frame + (if event.nak then 0 else 1)
                if base > old_base
                    current = config.timeout
                    duplicates = 0
                    for old_base <= int j < base
                        if records[j].acked < 0
                            records[j].acked = tick
                .increase(base - old_base)
                if event.nak
                    .go_back()
                    .decrease(false)
                else
                    next_frame = maximum(next_frame, base)
                    timer = if base == next_frame then -1 else tick + current
        else
            accepted = frame < high and not records[frame].marked
            if accepted
                records[frame].timer = -1
                if event.nak
                    .enqueue(frame)
                    .decrease(false)
                else
                    records[frame].marked = true
                    records[frame].acked = tick
                    queue = erase(queue, int_at(queue, frame))
                    while base < high and records[base].marked
                        base += 1
                    if base > old_base
                        current = config.timeout
                    .increase(1)
        string label = if event.nak then "NAK" else "ACK"
        if accepted
            log("SENDER", "GOT{label} a={event.value} #{event.number} base={base}")
        else
            log("SENDER", "OLD{label} a={event.value} #{event.number}")
            if not sr() and not event.nak and config.dupack > 0 and base >= 1 and event.value == (base - 1) % modulus()
                duplicates += 1
                if duplicates == config.dupack
                    fast += 1
                    log("SENDER", "FASTRETX f={base}")
                    .go_back()
                    .decrease(false)
        changed(old_cwnd, old_threshold)
    void .timeout_frame(int frame)
        int old_cwnd = cwnd
        int old_threshold = threshold
        timeouts += 1
        log("SENDER", "TIMEOUT f={frame}")
        if sr()
            records[frame].timer = -1
            .enqueue(frame)
        else
            .go_back()
        if config.backoff
            current = minimum(current * 2, config.timeout * 8)
        .decrease(true)
        changed(old_cwnd, old_threshold)
    void .send_frame(int frame)
        bool retransmission = records[frame].transmissions > 0
        if retransmission
            resent += 1
        else
            records[frame].first = tick
        records[frame].transmissions += 1
        data += 1
        string label = if retransmission then "RESEND" else "SEND"
        log("SENDER", "{label} f={frame} seq={frame % modulus()} #{data}")
        int result = .outcome(data, false)
        data_events = data_events.append(Event(tick + config.delay + config.extra(19, data), frame, data, result))
    void snapshot()
        string sender_text = ""
        string receiver_text = ""
        for int frame < config.frames
            bool acknowledged = if sr() then records[frame].marked else frame < base
            bool waiting = if sr() then int_at(queue, frame) >= 0 else next_frame <= frame < high
            bool sent = if sr() then frame < high else frame < next_frame
            sender_text += if acknowledged then "A" elif waiting then "R" elif sent then "O" elif frame < base + effective() then "W" else "."
            receiver_text += if frame < receiver then "D" elif sr() and buffered(frame) >= 0 then "B" elif (sr() and frame < receiver + config.window) or (not sr() and frame == receiver) then "W" else "."
        print("{tick} SNAPSHOT sender={sender_text} receiver={receiver_text}{NL}")
    Result .run(string name)
        print("config: {config.protocol} n={config.frames} w={config.window} k={config.bits} T={config.timeout} d={config.delay}{NL}")
        string duplicate_text = if config.dupack == 0 then "off" else config.dupack.string()
        string random_text = if config.seed == 0 then "off" else "{config.seed}/{config.loss}/{config.corruption}"
        string trace_text = ["all", "sender", "receiver", "none"][lookup(["ALL", "SENDER", "RECEIVER", "NONE"], config.trace)]
        print("options: interval={config.interval} limit={config.limit} dupack={duplicate_text} nak={on_off(config.nak)} backoff={on_off(config.backoff)} congestion={on_off(config.congestion)} unsafe={on_off(config.unsafe)} trace={trace_text} random={random_text}{NL}")
        bool completed = false
        while true
            for Event event = data_events[]
                if event.arrival == tick
                    if event.outcome == 0
                        .receive(event)
                    else
                        string label = if event.outcome == 1 then "LOST" else "CORRUPT"
                        if event.outcome == 1
                            lost_data += 1
                        else
                            corrupt_data += 1
                        log("RECEIVER", "{label} data #{event.number}")
            for Event event = control_events[]
                if event.arrival == tick
                    if event.outcome == 0
                        .control_arrival(event)
                    else
                        string label = if event.outcome == 1 then "LOST" else "CORRUPT"
                        string kind = if event.nak then "nak" else "ack"
                        if event.outcome == 1
                            lost_ctrl += 1
                        else
                            corrupt_ctrl += 1
                        log("SENDER", "{label} {kind} #{event.number}")
            completed = base == config.frames
            if not completed
                if sr()
                    for base <= int frame < high
                        if records[frame].timer == tick
                            .timeout_frame(frame)
                    int selected = -1
                    if len(queue) > 0
                        selected = queue[0]
                        queue = erase(queue, 0)
                    elif high < config.frames and high < base + effective() and high * config.interval <= tick
                        selected = high
                        high += 1
                    if selected >= 0
                        .send_frame(selected)
                        records[selected].timer = tick + current
                else
                    if timer == tick
                        .timeout_frame(base)
                    if next_frame < config.frames and next_frame < base + effective() and (next_frame < high or next_frame * config.interval <= tick)
                        .send_frame(next_frame)
                        high = maximum(high, next_frame + 1)
                        next_frame += 1
                        if timer < 0
                            timer = tick + current
            if config.contains(21, tick)
                snapshot()
            if completed or tick == config.limit
                string ending = if completed then "DONE" else "ABORT"
                print("{tick} {ending}{NL}")
                break
            tick += 1
        for int frame < config.frames
            Record record = records[frame]
            print("frame {frame}: seq={frame % modulus()} tx={record.transmissions} first={time_text(record.first)} delivered={time_text(record.delivered)} acked={time_text(record.acked)}{NL}")
        print("totals: data={data} resent={resent} control={control} nak={naks} timeouts={timeouts} fastretx={fast}{NL}")
        print("channel: lost_data={lost_data} lost_ctrl={lost_ctrl} corrupt_data={corrupt_data} corrupt_ctrl={corrupt_ctrl}{NL}")
        print("receiver: delivered={delivered} errors={errors} discarded={discarded} max_buffer={max_buffer}{NL}")
        string completion_text = if completed then tick.string() else "-"
        string goodput = if completed then fixed(delivered, tick, 2) else "-"
        string latency_text = if delivered == 0 then "-" else fixed(latency, delivered, 2)
        print("result: completion={completion_text} goodput={goodput} efficiency={fixed(delivered * 100, data, 1)}% utilization={fixed(data * 100, tick + 1, 1)}% latency={latency_text}{NL}")
        Result result = Result(name)
        result.protocol = config.protocol
        result.status = if completed then "done" else "aborted"
        result.delivered = delivered
        result.completion = tick
        result.data = data
        return result
int count
scan(&count)
Result[] results = []
for int scenario_index < count
    string header
    scan(&header)
    string name = header.split(" ")[1]
    Settings config = Settings()
    string problem = ""
    while true
        string line
        scan(&line)
        string[] words = line.split(" ")
        if words[0] == "END"
            break
        if problem != ""
            continue
        int key = lookup(setting_keys(), words[0])
        if key < 0
            problem = "unknown key {words[0]}"
        elif config.present[key]
            problem = "duplicate key {words[0]}"
        else
            config.present[key] = true
            bool correct = if key == 14 then len(words) == 4 elif key >= 15 then len(words) >= 2 else len(words) == 2
            if not correct
                problem = "wrong number of values for {words[0]}"
            else
                config.values[key] = words[1:]
    problem = .config.validate(problem)
    print("== {name} =={NL}")
    if problem != ""
        print("error: {problem}{NL}")
        results = results.append(Result(name))
    else
        Simulation simulation = Simulation(config)
        results = results.append(.simulation.run(name))
int[] ranked = []
for nat j < len(results)
    if results[j].status == "done"
        ranked = ranked.append(int(j))
for 1 <= int j < int(len(ranked))
    int selected = ranked[j]
    int at = j
    while at > 0
        Result previous = results[ranked[at - 1]]
        Result current = results[selected]
        int left = current.delivered * previous.completion
        int right = previous.delivered * current.completion
        if left < right or (left == right and current.delivered * previous.data <= previous.delivered * current.data)
            break
        ranked[at] = ranked[at - 1]
        at -= 1
    ranked[at] = selected
print("== ranking =={NL}")
for nat j < len(ranked)
    Result result = results[ranked[j]]
    print("{j + 1}. {result.name} {result.protocol} goodput={fixed(result.delivered, result.completion, 2)} efficiency={fixed(result.delivered * 100, result.data, 1)}%{NL}")
for Result result = results[]
    if result.status != "done"
        print("- {result.name} {result.status}{NL}")
print("== protocols =={NL}")
for string protocol_name = ["SW", "GBN", "SR"][]
    int runs = 0
    int total_delivered = 0
    int total_ticks = 0
    int total_data = 0
    for Result result = results[]
        if result.status == "done" and result.protocol == protocol_name
            runs += 1
            total_delivered += result.delivered
            total_ticks += result.completion
            total_data += result.data
    if runs > 0
        print("{protocol_name}: runs={runs} goodput={fixed(total_delivered, total_ticks, 2)} efficiency={fixed(total_delivered * 100, total_data, 1)}%{NL}")
