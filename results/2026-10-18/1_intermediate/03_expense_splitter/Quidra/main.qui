// Monetary values, distributions, rates and subset dynamic programming are integral.
int minimum(int a, int b)
    return if a < b then a else b

int maximum(int a, int b)
    return if a > b then a else b

int absolute(int value)
    return if value < 0 then -value else value

int locate(string needle, string[] haystack)
    for 0 <= int k < int(len(haystack))
        if haystack[k] == needle
            return k
    return -1

int sum_values(int[] values)
    int result = 0
    for int value = values[]
        result += value
    return result

int money_value(string value)
    string[] parts = value.split(".")
    int whole = int.parse(parts[0])
    int cents = int.parse(parts[1])
    return whole * 100 + cents

string padded(int value, int width)
    string text = value.string()
    return string.repeat("0", nat(maximum(0, width - int(len(text))))) + text

string money(int value)
    return (value / 100).string() + "." + padded(value % 100, 2)

string signed_money(int value)
    return (if value > 0 then "+" elif value < 0 then "-" else "") + money(absolute(value))

string percentage(int part, int whole)
    return money(part * 10000 / whole) + "%"

string rate_text(int value)
    return (value / 10000).string() + "." + padded(value % 10000, 4)

int[] equal_distribution(int total, int count)
    int[] result = []
    for 0 <= int k < count
        result = result.append(total / count + (if k < total % count then 1 else 0))
    return result

int[] largest_remainder(int total, int[] weights)
    int whole = sum_values(weights)
    int[] result = []
    int[] order = []
    for 0 <= int k < int(len(weights))
        result = result.append(total * weights[k] / whole)
        order = order.append(k)
        int p = k
        while p > 0 and total * weights[k] % whole > total * weights[order[p - 1]] % whole
            order[p] = order[p - 1]
            p -= 1
        order[p] = k
    int remainder = total - sum_values(result)
    for 0 <= int k < remainder
        result[order[k]] += 1
    return result

class Member(string name, bool active, int status_day)
class Expense(string id, int day, int record, string[] payers, int[] payments, int amount, string currency, string category, string mode, string[] participants, int[] specified, int total, int[] shares, int[] contributions, int interval, int next_day, int copies)
class Settlement(int day, int record, string sender, string receiver, int amount, string currency, int total)
class Ledger()
    int current_day = 1
    int serial = 0
    Member[] members = []
    string[] currency_codes = []
    int[] rates = []
    Expense[] expenses = []
    Settlement[] settlements = []
    string[] budget_categories = []
    int[] budgets = []
    string[] used_ids = []

int member_id(const Ledger state, string name)
    for 0 <= int k < int(len(state.members))
        if state.members[k].name == name
            return k
    return -1

int expense_id(const Ledger state, string reference)
    for 0 <= int k < int(len(state.expenses))
        if state.expenses[k].id == reference
            return k
    return -1

string[] member_names(const Ledger state, bool active_only = false)
    string[] result = []
    for Member member = state.members[]
        if not active_only or member.active
            result = result.append(member.name)
    return result.sorted()

string member_problem(const Ledger state, string name)
    int k = member_id(state, name)
    if k < 0
        return "ERROR unknown member " + name
    if not state.members[k].active
        return "ERROR inactive member " + name
    return ""

string frozen_member(const Ledger state, const Expense expense)
    for string name = expense.payers.concat(expense.participants)[]
        if not state.members[member_id(state, name)].active
            return name
    return ""

int current_rate(const Ledger state, string code)
    if code == ""
        return 10000
    int k = locate(code, state.currency_codes)
    return if k < 0 then -1 else state.rates[k]

int converted_total(int amount, int rate)
    return (amount * rate + 5000) / 10000

Expense computed(const Expense original, int rate)
    Expense result = original
    result.total = converted_total(result.amount, rate)
    int[] portions = result.specified
    if result.mode == "EQUAL"
        portions = equal_distribution(result.amount, int(len(result.participants)))
    elif result.mode == "PERCENT" or result.mode == "SHARES"
        portions = largest_remainder(result.amount, result.specified)
    elif result.mode == "ADJUST"
        int[] base = equal_distribution(result.amount - sum_values(result.specified), int(len(result.participants)))
        portions = base + result.specified
    result.shares = largest_remainder(result.total, portions)
    result.contributions = largest_remainder(result.total, result.payments)
    return result

string currency_note(int amount, string code)
    return if code == "" then "" else " [" + money(amount) + " " + code + "]"

int[] expense_net(const Ledger state, const Expense expense)
    int[] result = array(len(state.members), fill = 0)
    for 0 <= int k < int(len(expense.payers))
        result[member_id(state, expense.payers[k])] += expense.contributions[k]
    for 0 <= int k < int(len(expense.participants))
        result[member_id(state, expense.participants[k])] -= expense.shares[k]
    return result

int[] balances_of(const Ledger state)
    int[] result = array(len(state.members), fill = 0)
    for Expense expense = state.expenses[]
        result = result + expense_net(state, expense)
    for Settlement settlement = state.settlements[]
        result[member_id(state, settlement.sender)] += settlement.total
        result[member_id(state, settlement.receiver)] -= settlement.total
    return result

bool involved(const Expense expense, string name)
    return locate(name, expense.payers) >= 0 or locate(name, expense.participants) >= 0

int spent(const Ledger state, string category)
    int result = 0
    for Expense expense = state.expenses[]
        if expense.category == category
            result += expense.total
    return result

string[] warning(const Ledger state, string category)
    int k = locate(category, state.budget_categories)
    if k >= 0
        int excess = spent(state, category) - state.budgets[k]
        if excess > 0
            return ["  WARNING " + category + " over budget by " + money(excess)]
    return []

string expense_result(const Expense expense, string command, bool payer_list = false)
    string[] names = if payer_list then expense.payers else expense.participants
    int[] amounts = if payer_list then expense.contributions else expense.shares
    string[] parts = []
    for 0 <= int k < int(len(names))
        parts = parts.append(names[k] + " " + money(amounts[k]))
    return command + " " + expense.id + " " + money(expense.total) + currency_note(expense.amount, expense.currency) + " = " + parts.join(" + ")

int[] chronological(const Ledger state)
    int[] order = []
    for 0 <= int k < int(len(state.expenses))
        order = order.append(k)
        int p = k
        while p > 0
            Expense earlier = state.expenses[order[p - 1]]
            Expense current = state.expenses[k]
            if earlier.day < current.day or (earlier.day == current.day and earlier.record < current.record)
                break
            order[p] = order[p - 1]
            p -= 1
        order[p] = k
    return order

int[][] debts_of(const Ledger state)
    int[][] raw = array(len(state.members), fill = array(len(state.members), fill = 0))
    string[] names = member_names(state)
    for Expense expense = state.expenses[]
        int[] net = expense_net(state, expense)
        int[] borrowers = []
        int[] lenders = []
        for string name = names[]
            int k = member_id(state, name)
            if net[k] < 0
                borrowers = borrowers.append(k)
            elif net[k] > 0
                lenders = lenders.append(k)
        int b = 0
        int l = 0
        while b < int(len(borrowers)) and l < int(len(lenders))
            int sender = borrowers[b]
            int receiver = lenders[l]
            int amount = minimum(-net[sender], net[receiver])
            raw[sender][receiver] += amount
            net[sender] += amount
            net[receiver] -= amount
            if net[sender] == 0
                b += 1
            if net[receiver] == 0
                l += 1
    for Settlement settlement = state.settlements[]
        raw[member_id(state, settlement.sender)][member_id(state, settlement.receiver)] -= settlement.total
    int[][] result = array(len(state.members), fill = array(len(state.members), fill = 0))
    for 0 <= int r < int(len(state.members))
        for 0 <= int c < int(len(state.members))
            result[r][c] = raw[r][c] - raw[c][r]
    return result

class HistoryItem(int day, int record, string label, int change)

string[] history_of(const Ledger state, string name)
    HistoryItem[] items = []
    int member = member_id(state, name)
    for Expense expense = state.expenses[]
        if involved(expense, name)
            items = items.append(HistoryItem(expense.day, expense.record, expense.id, expense_net(state, expense)[member]))
    for Settlement settlement = state.settlements[]
        if settlement.sender == name or settlement.receiver == name
            int change = if settlement.sender == name then settlement.total else -settlement.total
            items = items.append(HistoryItem(settlement.day, settlement.record, settlement.sender + "->" + settlement.receiver, change))
    for 1 <= int k < int(len(items))
        HistoryItem current = items[k]
        int p = k
        while p > 0 and (items[p - 1].day > current.day or (items[p - 1].day == current.day and items[p - 1].record > current.record))
            items[p] = items[p - 1]
            p -= 1
        items[p] = current
    string[] result = ["HISTORY " + name]
    int running = 0
    for HistoryItem item = items[]
        running += item.change
        result = result.append("  day " + item.day.string() + " " + item.label + " " + signed_money(item.change) + " balance " + signed_money(running))
    return if len(items) == 0 then result.append("  (none)") else result

string[] greedy_transfers(string[] names, int[] amounts, string indent)
    int[] remaining = amounts
    string[] result = []
    while true
        int sender = -1
        int receiver = -1
        for 0 <= int k < int(len(names))
            if remaining[k] < 0 and (sender < 0 or remaining[k] < remaining[sender])
                sender = k
            if remaining[k] > 0 and (receiver < 0 or remaining[k] > remaining[receiver])
                receiver = k
        if sender < 0
            break
        int amount = minimum(-remaining[sender], remaining[receiver])
        result = result.append(indent + names[sender] + " -> " + names[receiver] + " " + money(amount))
        remaining[sender] += amount
        remaining[receiver] -= amount
    return result

bool subset_of(int subset, int mask, int[] powers)
    for int power = powers[]
        if subset / power % 2 == 1 and mask / power % 2 == 0
            return false
    return true

int[] subset_indices(int mask, int[] powers)
    int[] result = []
    for 0 <= int k < int(len(powers))
        if mask / powers[k] % 2 == 1
            result = result.append(k)
    return result

bool lex_before(int[] left, int[] right)
    for 0 <= int k < minimum(int(len(left)), int(len(right)))
        if left[k] != right[k]
            return left[k] < right[k]
    return len(left) < len(right)

string[] simplify(const Ledger state, bool optimal)
    int[] balances = balances_of(state)
    string[] names = []
    int[] amounts = []
    for string name = member_names(state)[]
        int amount = balances[member_id(state, name)]
        if amount != 0
            names = names.append(name)
            amounts = amounts.append(amount)
    if not optimal
        string[] transfers = greedy_transfers(names, amounts, "  ")
        return ["SIMPLIFY GREEDY transfers " + len(transfers).string()].concat(transfers)
    int count = int(len(names))
    if count > 12
        return ["ERROR too many members"]
    int[] powers = []
    int size = 1
    for 0 <= int k < count
        powers = powers.append(size)
        size *= 2
    int[] sums = array(nat(size), fill = 0)
    int[] dp = array(nat(size), fill = 0)
    for 1 <= int mask < size
        int best = 0
        bool sum_found = false
        for 0 <= int k < count
            if mask / powers[k] % 2 == 1
                int prior = mask - powers[k]
                best = maximum(best, dp[prior])
                if not sum_found
                    sums[mask] = sums[prior] + amounts[k]
                    sum_found = true
        dp[mask] = best + (if sums[mask] == 0 then 1 else 0)
    int mask = size - 1
    string[] output = []
    int transfer_count = 0
    int groups = 0
    while mask > 0
        int first = subset_indices(mask, powers)[0]
        int selected = -1
        int[] best_members = []
        for 1 <= int candidate < size
            if candidate / powers[first] % 2 == 0 or sums[candidate] != 0
                continue
            if not subset_of(candidate, mask, powers)
                continue
            if 1 + dp[mask - candidate] != dp[mask]
                continue
            int[] members = subset_indices(candidate, powers)
            if selected < 0 or lex_before(members, best_members)
                selected = candidate
                best_members = members
        string[] group_names = []
        int[] group_amounts = []
        for int k = best_members[]
            group_names = group_names.append(names[k])
            group_amounts = group_amounts.append(amounts[k])
        output = output.append("  group " + group_names.join(" "))
        string[] transfers = greedy_transfers(group_names, group_amounts, "    ")
        output = output.concat(transfers)
        transfer_count += int(len(transfers))
        groups += 1
        mask -= selected
    return ["SIMPLIFY OPTIMAL transfers " + transfer_count.string() + " groups " + groups.string()].concat(output)

string[] execute(string input_line, Ledger &state)
    string[] fields = input_line.split(" ")
    string command = fields[0]
    if command == "MEMBER"
        string name = fields[1]
        int k = member_id(state, name)
        if k >= 0 and state.members[k].active
            return ["ERROR duplicate member " + name]
        bool rejoined = k >= 0
        if rejoined
            state.members[k].active = true
            state.members[k].status_day = state.current_day
        else
            state.members = state.members.append(Member(name, true, state.current_day))
        return ["MEMBER " + name + (if rejoined then " rejoined" else " joined")]
    if command == "LEAVE"
        string name = fields[1]
        string problem = member_problem(state, name)
        if problem != ""
            return [problem]
        int k = member_id(state, name)
        if balances_of(state)[k] != 0
            return ["ERROR member has a balance " + name]
        state.members[k].active = false
        state.members[k].status_day = state.current_day
        return ["LEAVE " + name]
    if command == "CURRENCY"
        string code = fields[1]
        int rate = int.parse(fields[2])
        int k = locate(code, state.currency_codes)
        string result = "CURRENCY " + code + " " + rate_text(rate)
        if k >= 0
            result += " was " + rate_text(state.rates[k])
            state.rates[k] = rate
        else
            state.currency_codes = state.currency_codes.append(code)
            state.rates = state.rates.append(rate)
        return [result]
    if command == "EXPENSE" or command == "EDIT"
        string reference = fields[1]
        int existing = expense_id(state, reference)
        if command == "EXPENSE"
            if locate(reference, state.used_ids) >= 0
                return ["ERROR duplicate id " + reference]
        else
            if existing < 0
                return ["ERROR unknown expense " + reference]
            string inactive = frozen_member(state, state.expenses[existing])
            if inactive != ""
                return ["ERROR inactive member " + inactive]
        string problem = member_problem(state, fields[2])
        if problem != ""
            return [problem]
        string[] amount_spec = fields[3].split("@")
        int amount = money_value(amount_spec[0])
        string code = if len(amount_spec) == 1 then "" else amount_spec[1]
        int rate = current_rate(state, code)
        if rate < 0
            return ["ERROR unknown currency " + code]
        if amount == 0 or converted_total(amount, rate) == 0
            return ["ERROR invalid amount"]
        string mode = fields[5]
        string[] participants = []
        int[] specified = []
        if mode == "EQUAL" and fields[6] == "ALL"
            participants = member_names(state, true)
            specified = array(len(participants), fill = 0)
        else
            for 6 <= int k < int(len(fields))
                string[] part = fields[k].split(":")
                string name = part[0]
                problem = member_problem(state, name)
                if problem != ""
                    return [problem]
                if locate(name, participants) >= 0
                    return ["ERROR duplicate member " + name]
                participants = participants.append(name)
                int value = 0
                if len(part) == 2
                    if mode == "PERCENT" or mode == "SHARES"
                        value = int.parse(part[1])
                    else
                        value = money_value(part[1])
                specified = specified.append(value)
        int whole = sum_values(specified)
        if (mode == "EXACT" and whole != amount) or (mode == "PERCENT" and whole != 10000) or (mode == "SHARES" and whole < 1) or (mode == "ADJUST" and whole > amount)
            return ["ERROR splits do not add up"]
        Expense expense = Expense(reference, state.current_day, state.serial + 1, [fields[2]], [amount], amount, code, fields[4], mode, participants, specified, 0, [], [], 0, 0, 0)
        if command == "EDIT"
            Expense old = state.expenses[existing]
            expense.day = old.day
            expense.record = old.record
            expense.interval = old.interval
            expense.next_day = old.next_day
            expense.copies = old.copies
        expense = computed(expense, rate)
        if command == "EXPENSE"
            state.serial += 1
            state.expenses = state.expenses.append(expense)
            state.used_ids = state.used_ids.append(reference)
        else
            state.expenses[existing] = expense
        return [expense_result(expense, command)].concat(warning(state, expense.category))
    if command == "PAYERS" or command == "DELETE" or command == "RECURRING" or command == "SHOW"
        string reference = fields[1]
        int k = expense_id(state, reference)
        if k < 0
            return ["ERROR unknown expense " + reference]
        Expense expense = state.expenses[k]
        if command == "PAYERS" or command == "DELETE"
            string inactive = frozen_member(state, expense)
            if inactive != ""
                return ["ERROR inactive member " + inactive]
        if command == "DELETE"
            state.expenses = state.expenses[:<k].concat(state.expenses[k + 1:])
            return ["DELETE " + reference]
        if command == "PAYERS"
            string[] payers = []
            int[] payments = []
            for 2 <= int j < int(len(fields))
                string[] part = fields[j].split(":")
                string problem = member_problem(state, part[0])
                if problem != ""
                    return [problem]
                if locate(part[0], payers) >= 0
                    return ["ERROR duplicate member " + part[0]]
                payers = payers.append(part[0])
                payments = payments.append(money_value(part[1]))
            if sum_values(payments) != expense.amount
                return ["ERROR payers do not add up"]
            expense.payers = payers
            expense.payments = payments
            expense.contributions = largest_remainder(expense.total, payments)
            state.expenses[k] = expense
            return [expense_result(expense, "PAYERS", true)]
        if command == "RECURRING"
            int interval = int.parse(fields[2])
            state.expenses[k].interval = interval
            state.expenses[k].next_day = if interval == 0 then 0 else state.current_day + interval
            return ["RECURRING " + reference + (if interval == 0 then " stopped" else " interval " + interval.string() + " next " + state.expenses[k].next_day.string())]
        string[] output = ["SHOW " + reference, "  day " + expense.day.string() + " category " + expense.category + " mode " + expense.mode + " total " + money(expense.total) + currency_note(expense.amount, expense.currency)]
        for 0 <= int j < int(len(expense.payers))
            output = output.append("  paid " + expense.payers[j] + " " + money(expense.contributions[j]))
        for 0 <= int j < int(len(expense.participants))
            string suffix = ""
            int value = expense.specified[j]
            if expense.mode == "EXACT"
                suffix = " " + money(value)
            elif expense.mode == "PERCENT"
                suffix = " " + money(value) + "%"
            elif expense.mode == "SHARES"
                suffix = " " + value.string() + "/" + sum_values(expense.specified).string()
            elif expense.mode == "ADJUST"
                suffix = " +" + money(value)
            output = output.append("  share " + expense.participants[j] + " " + money(expense.shares[j]) + suffix)
        if expense.interval > 0
            output = output.append("  recurring interval " + expense.interval.string() + " next " + expense.next_day.string())
        return output
    if command == "SETTLE"
        for 1 <= int k <= 2
            string problem = member_problem(state, fields[k])
            if problem != ""
                return [problem]
        if fields[1] == fields[2]
            return ["ERROR same member " + fields[1]]
        string[] amount_spec = fields[3].split("@")
        int amount = money_value(amount_spec[0])
        string code = if len(amount_spec) == 1 then "" else amount_spec[1]
        int rate = current_rate(state, code)
        if rate < 0
            return ["ERROR unknown currency " + code]
        int total = converted_total(amount, rate)
        if amount == 0 or total == 0
            return ["ERROR invalid amount"]
        state.serial += 1
        state.settlements = state.settlements.append(Settlement(state.current_day, state.serial, fields[1], fields[2], amount, code, total))
        return ["SETTLE " + fields[1] + " -> " + fields[2] + " " + money(total) + currency_note(amount, code)]
    if command == "BUDGET"
        string category = fields[1]
        int amount = money_value(fields[2])
        int k = locate(category, state.budget_categories)
        if amount == 0
            if k >= 0
                state.budget_categories = state.budget_categories[:<k].concat(state.budget_categories[k + 1:])
                state.budgets = state.budgets[:<k].concat(state.budgets[k + 1:])
            return ["BUDGET " + category + " removed"]
        if k < 0
            state.budget_categories = state.budget_categories.append(category)
            state.budgets = state.budgets.append(amount)
        else
            state.budgets[k] = amount
        return ["BUDGET " + category + " " + money(amount)]
    if command == "DAY"
        int day = int.parse(fields[1])
        if day <= state.current_day
            return ["ERROR invalid day " + fields[1]]
        string[] output = ["DAY " + day.string()]
        while true
            int selected = -1
            for 0 <= int k < int(len(state.expenses))
                Expense candidate = state.expenses[k]
                if candidate.interval == 0 or candidate.next_day > day
                    continue
                if selected < 0 or candidate.next_day < state.expenses[selected].next_day or (candidate.next_day == state.expenses[selected].next_day and candidate.record < state.expenses[selected].record)
                    selected = k
            if selected < 0
                break
            Expense template = state.expenses[selected]
            int rate = current_rate(state, template.currency)
            if frozen_member(state, template) != "" or converted_total(template.amount, rate) == 0
                state.expenses[selected].interval = 0
                state.expenses[selected].next_day = 0
                output = output.append("  CANCEL " + template.id)
            else
                state.expenses[selected].copies += 1
                state.expenses[selected].next_day += template.interval
                Expense copy = template
                copy.id = template.id + "#" + (template.copies + 2).string()
                copy.day = template.next_day
                state.serial += 1
                copy.record = state.serial
                copy.interval = 0
                copy.next_day = 0
                copy.copies = 0
                copy = computed(copy, rate)
                state.expenses = state.expenses.append(copy)
                state.used_ids = state.used_ids.append(copy.id)
                output = output.append("  RECUR " + copy.id + " " + money(copy.total)).concat(warning(state, copy.category))
        state.current_day = day
        return output
    if command == "SIMPLIFY"
        return simplify(state, fields[1] == "OPTIMAL")
    if command == "OWES" or command == "HISTORY" or (command == "EXPENSES" and fields[1] == "MEMBER")
        string name = fields[if command == "EXPENSES" then 2 else 1]
        if member_id(state, name) < 0
            return ["ERROR unknown member " + name]
    if command == "HISTORY"
        return history_of(state, fields[1])
    if command == "BALANCES"
        int[] balances = balances_of(state)
        string[] output = ["BALANCES"]
        for string name = member_names(state, true)[]
            output = output.append("  " + name + " " + signed_money(balances[member_id(state, name)]))
        return if len(output) == 1 then output.append("  (none)") else output
    if command == "OWES"
        int[][] debts = debts_of(state)
        string name = fields[1]
        int k = member_id(state, name)
        string[] output = ["OWES " + name]
        for string other = member_names(state)[]
            int amount = debts[k][member_id(state, other)]
            if amount > 0
                output = output.append("  " + name + " owes " + other + " " + money(amount))
            elif amount < 0
                output = output.append("  " + other + " owes " + name + " " + money(-amount))
        return if len(output) == 1 then output.append("  (none)") else output
    if command == "MATRIX"
        string[] names = member_names(state, true)
        if len(names) == 0
            return ["MATRIX", "  (none)"]
        int[][] debts = debts_of(state)
        int label_width = 0
        int cell_width = 0
        string[][] cells = []
        for string name = names[]
            label_width = maximum(label_width, int(len(name)))
            cell_width = maximum(cell_width, int(len(name)))
            string[] row = []
            for string other = names[]
                int amount = maximum(0, debts[member_id(state, name)][member_id(state, other)])
                string cell = if name == other then "-" else money(amount)
                cell_width = maximum(cell_width, int(len(cell)))
                row = row.append(cell)
            cells = cells.append(row)
        string heading = string.repeat(" ", nat(label_width))
        for string name = names[]
            heading += "  " + string.repeat(" ", nat(cell_width - int(len(name)))) + name
        string[] output = ["MATRIX", heading]
        for 0 <= int k < int(len(names))
            string row = names[k] + string.repeat(" ", nat(label_width - int(len(names[k]))))
            for string cell = cells[k][]
                row += "  " + string.repeat(" ", nat(cell_width - int(len(cell)))) + cell
            output = output.append(row)
        return output
    if command == "MEMBERS" or command == "TOTALS"
        string[] output = [command]
        for string name = member_names(state)[]
            int k = member_id(state, name)
            Member member = state.members[k]
            int count = 0
            int paid = 0
            int share = 0
            int sent = 0
            int received = 0
            for Expense expense = state.expenses[]
                if involved(expense, name)
                    count += 1
                int payer = locate(name, expense.payers)
                int participant = locate(name, expense.participants)
                if payer >= 0
                    paid += expense.contributions[payer]
                if participant >= 0
                    share += expense.shares[participant]
            for Settlement settlement = state.settlements[]
                if settlement.sender == name
                    sent += settlement.total
                if settlement.receiver == name
                    received += settlement.total
            if command == "MEMBERS"
                output = output.append("  " + name + (if member.active then " active day " else " left day ") + member.status_day.string() + " expenses " + count.string())
            else
                output = output.append("  " + name + " paid " + money(paid) + " share " + money(share) + " sent " + money(sent) + " received " + money(received))
        if command == "MEMBERS"
            return if len(output) == 1 then output.append("  (none)") else output
        for string code = state.currency_codes.sorted()[]
            int count = 0
            int amount = 0
            int total = 0
            for Expense expense = state.expenses[]
                if expense.currency == code
                    count += 1
                    amount += expense.amount
                    total += expense.total
            if count > 0
                output = output.append("  currency " + code + " expenses " + count.string() + " amount " + money(amount) + " base " + money(total))
        int total = 0
        int settlement_total = 0
        for Expense expense = state.expenses[]
            total += expense.total
        for Settlement settlement = state.settlements[]
            settlement_total += settlement.total
        return output.append("  expenses " + len(state.expenses).string() + " total " + money(total) + " settlements " + len(state.settlements).string() + " total " + money(settlement_total))
    if command == "BUDGETS"
        string[] output = ["BUDGETS"]
        for string category = state.budget_categories.sorted()[]
            int amount = state.budgets[locate(category, state.budget_categories)]
            int total = spent(state, category)
            output = output.append("  " + category + " spent " + money(total) + " budget " + money(amount) + " used " + percentage(total, amount) + (if total <= amount then " left " else " over ") + money(absolute(amount - total)))
        return if len(output) == 1 then output.append("  (none)") else output
    if command == "CATEGORY"
        string[] categories = []
        int grand_total = 0
        for Expense expense = state.expenses[]
            if locate(expense.category, categories) < 0
                categories = categories.append(expense.category)
            grand_total += expense.total
        categories = categories.sorted()
        int[] category_totals = []
        for string category = categories[]
            category_totals = category_totals.append(spent(state, category))
        for 1 <= int k < int(len(categories))
            string category = categories[k]
            int category_total = category_totals[k]
            int p = k
            while p > 0 and category_total > category_totals[p - 1]
                categories[p] = categories[p - 1]
                category_totals[p] = category_totals[p - 1]
                p -= 1
            categories[p] = category
            category_totals[p] = category_total
        string[] output = ["CATEGORY"]
        for 0 <= int category_index < int(len(categories))
            string category = categories[category_index]
            int total = category_totals[category_index]
            output = output.append("  " + category + " " + money(total) + " " + percentage(total, grand_total))
            string[] names = member_names(state)
            int[] shares = []
            for string name = names[]
                int share = 0
                for Expense expense = state.expenses[]
                    if expense.category == category
                        int participant = locate(name, expense.participants)
                        if participant >= 0
                            share += expense.shares[participant]
                shares = shares.append(share)
            int[] order = []
            for 0 <= int k < int(len(names))
                order = order.append(k)
                int p = k
                while p > 0 and shares[k] > shares[order[p - 1]]
                    order[p] = order[p - 1]
                    p -= 1
                order[p] = k
            for int k = order[]
                if shares[k] > 0
                    output = output.append("    " + names[k] + " " + money(shares[k]) + " " + percentage(shares[k], total))
        return if len(output) == 1 then output.append("  (none)") else output
    int[] order = chronological(state)
    if command == "EXPENSES"
        string[] output = [input_line]
        int count = 0
        int total = 0
        for int k = order[]
            Expense expense = state.expenses[k]
            bool selected = fields[1] == "ALL"
            if fields[1] == "CATEGORY"
                selected = expense.category == fields[2]
            elif fields[1] == "MEMBER"
                selected = involved(expense, fields[2])
            elif fields[1] == "DAYS"
                int first_day = int.parse(fields[2])
                int last_day = int.parse(fields[3])
                selected = first_day <= expense.day <= last_day
            if selected
                output = output.append("  day " + expense.day.string() + " " + expense.id + " " + expense.category + " " + money(expense.total) + " by " + expense.payers.join(","))
                count += 1
                total += expense.total
        return output.append("  count " + count.string() + " total " + money(total))
    // PERIODS, in increasing bucket order, using chronological expense traversal.
    int interval = int.parse(fields[1])
    string[] output = ["PERIODS " + interval.string()]
    int bucket = -1
    int count = 0
    int total = 0
    for int k = order[]
        Expense expense = state.expenses[k]
        int next_bucket = (expense.day - 1) / interval
        if bucket >= 0 and bucket != next_bucket
            output = output.append("  days " + (bucket * interval + 1).string() + "-" + (bucket * interval + interval).string() + " expenses " + count.string() + " total " + money(total))
            count = 0
            total = 0
        bucket = next_bucket
        count += 1
        total += expense.total
    if bucket >= 0
        output = output.append("  days " + (bucket * interval + 1).string() + "-" + (bucket * interval + interval).string() + " expenses " + count.string() + " total " + money(total))
    return if len(output) == 1 then output.append("  (none)") else output

Ledger ledger = Ledger()
int command_count
scan(&command_count)
for 0 <= int line_number < command_count
    string input_line
    scan(&input_line)
    for string output_line = execute(input_line, &ledger)[]
        print(output_line + NL)
