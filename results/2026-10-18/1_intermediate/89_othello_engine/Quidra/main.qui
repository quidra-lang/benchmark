void emit(string line)
    print(line + NL)

bool has(string[] values, string item)
    for string value = values[]
        if value == item
            return true
    return false

bool has_int(int[] values, int target)
    for int value = values[]
        if value == target
            return true
    return false

string other(string side)
    return if side == "B" then "W" else "B"

string[] initial_board()
    string[] board = array(64, fill = ".")
    board[27] = "W"
    board[36] = "W"
    board[28] = "B"
    board[35] = "B"
    return board

string square_name(int cell)
    return "abcdefgh"[cell % 8] + "{cell / 8 + 1}"

int square_number(string word)
    return 8 * (int.parse(word[1]) - 1) + word.codepoints()[0] - 97

bool inside(int row, int column)
    return 0 <= row < 8 and 0 <= column < 8

int[] flips(string[] board, string side, int cell)
    int[] result = []
    if board[cell] != "."
        return result
    int row = cell / 8
    int column = cell % 8
    for -1 <= int dr <= 1
        for -1 <= int dc <= 1
            if dr == 0 and dc == 0
                continue
            int y = row + dr
            int x = column + dc
            int[] line = []
            while inside(y, x) and board[8 * y + x] == other(side)
                line = line.append(8 * y + x)
                y += dr
                x += dc
            if len(line) > 0 and inside(y, x) and board[8 * y + x] == side
                result = result.concat(line)
    return result.sorted()

int[] legal(string[] board, string side)
    return [for int cell < 64 if board[cell] == "." and len(flips(board, side, cell)) > 0 then cell]

string[] place(string[] board, string side, int cell)
    string[] next = board
    for int target = flips(board, side, cell)[]
        next[target] = side
    next[cell] = side
    return next

int count(string[] board, string piece)
    int total = 0
    for string item = board[]
        if item == piece
            total += 1
    return total

bool terminal(string[] board)
    return len(legal(board, "B")) == 0 and len(legal(board, "W")) == 0

string game_over(string[] board)
    int black = count(board, "B")
    int white = count(board, "W")
    string winner = if black > white then "winner B" elif white > black then "winner W" else "draw"
    return "game over B {black} W {white} {winner}"

int[] evaluate(string[] board, string side)
    int[] weights = [100, -20, 10, 5, 5, 10, -20, 100,
        -20, -50, -2, -2, -2, -2, -50, -20,
        10, -2, -1, -1, -1, -1, -2, 10,
        5, -2, -1, -1, -1, -1, -2, 5,
        5, -2, -1, -1, -1, -1, -2, 5,
        10, -2, -1, -1, -1, -1, -2, 10,
        -20, -50, -2, -2, -2, -2, -50, -20,
        100, -20, 10, 5, 5, 10, -20, 100]
    int w = 0
    for int cell < 64
        if board[cell] == side
            w += weights[cell]
        elif board[cell] == other(side)
            w -= weights[cell]
    int own = int(len(legal(board, side)))
    int enemy = int(len(legal(board, other(side))))
    return [w + 10 * (own - enemy), w, own, enemy]

int search(string[] board, string side, int depth)
    int[] moves = legal(board, side)
    string enemy = other(side)
    if len(moves) == 0 and len(legal(board, enemy)) == 0
        return (if depth < 0 then 1 else 1000) * (count(board, side) - count(board, enemy))
    if depth == 0
        return evaluate(board, side)[0]
    int next_depth = if depth < 0 then -1 else depth - 1
    if len(moves) == 0
        return -search(board, enemy, next_depth)
    int best = -10000000
    for int cell = moves[]
        int value = -search(place(board, side, cell), enemy, next_depth)
        if value > best
            best = value
    return best

class Ranking(int cell, int value)

Ranking[] ranked(string[] board, string side, int depth)
    Ranking[] choices = []
    int next_depth = if depth < 0 then -1 else depth - 1
    for int cell = legal(board, side)[]
        choices = choices.append(Ranking(cell, -search(place(board, side, cell), other(side), next_depth)))
    for 1 <= int i < int(len(choices))
        int j = i
        while j > 0 and (choices[j].value > choices[j - 1].value or (choices[j].value == choices[j - 1].value and choices[j].cell < choices[j - 1].cell))
            Ranking temp = choices[j]
            choices[j] = choices[j - 1]
            choices[j - 1] = temp
            j -= 1
    return choices

class Variation(string[] moves, string[] board)

Variation variation(string[] board, string side, int depth)
    string[] current = board
    string turn = side
    string[] path = []
    int remaining = depth
    while remaining != 0 and not terminal(current)
        Ranking[] choices = ranked(current, turn, remaining)
        if len(choices) == 0
            path = path.append("pass")
        else
            int cell = choices[0].cell
            path = path.append(square_name(cell))
            current = place(current, turn, cell)
        turn = other(turn)
        if remaining > 0
            remaining -= 1
    return Variation(path, current)

int perft(string[] board, string side, int depth)
    if depth == 0
        return 1
    int[] moves = legal(board, side)
    string enemy = other(side)
    if len(moves) == 0
        return if len(legal(board, enemy)) == 0 then 1 else perft(board, enemy, depth - 1)
    int result = 0
    for int cell = moves[]
        result += perft(place(board, side, cell), enemy, depth - 1)
    return result

int[] stable(string[] board)
    bool[] seen = array(64, fill = false)
    int[] rows = [0, 1, 1, 1]
    int[] columns = [1, 0, 1, -1]
    while true
        int[] found = []
        for int cell < 64
            if board[cell] == "." or seen[cell]
                continue
            bool valid = true
            for int axis < 4
                bool full = true
                bool anchor = false
                for int sign = [-1, 1][]
                    int y = cell / 8 + rows[axis] * sign
                    int x = cell % 8 + columns[axis] * sign
                    if not inside(y, x) or (seen[8 * y + x] and board[8 * y + x] == board[cell])
                        anchor = true
                    while inside(y, x)
                        if board[8 * y + x] == "."
                            full = false
                        y += rows[axis] * sign
                        x += columns[axis] * sign
                if not full and not anchor
                    valid = false
                    break
            if valid
                found = found.append(cell)
        if len(found) == 0
            break
        for int cell = found[]
            seen[cell] = true
    int black = 0
    int white = 0
    for int cell < 64
        if seen[cell] and board[cell] == "B"
            black += 1
        if seen[cell] and board[cell] == "W"
            white += 1
    return [black, white]

int transformed_square(int cell, string operation)
    int r = cell / 8
    int c = cell % 8
    if operation == "rot90"
        return 8 * c + 7 - r
    if operation == "rot180"
        return 63 - cell
    if operation == "rot270"
        return 8 * (7 - c) + r
    if operation == "mirror"
        return 8 * r + 7 - c
    if operation == "flip"
        return 8 * (7 - r) + c
    if operation == "diag"
        return 8 * c + r
    return 8 * (7 - c) + 7 - r

string[] transformed_board(string[] board, string operation)
    string[] result = array(64, fill = ".")
    for int cell < 64
        result[transformed_square(cell, operation)] = board[cell]
    return result

int random_step(int state)
    return 48271 * state % 2147483647

string[] random_game(string[] board, string side, int &state)
    string[] current = board
    string turn = side
    while true
        int[] moves = legal(current, turn)
        if len(moves) > 0
            state = random_step(state)
            current = place(current, turn, moves[state % int(len(moves))])
        elif len(legal(current, other(turn))) == 0
            return current
        turn = other(turn)

string average(int total, int n)
    int scaled = 100 * total / n
    int remainder = scaled % 100
    return "{scaled / 100}." + (if remainder < 10 then "0" else "") + remainder.string()

class Position(string[] board, string side, bool over)
class Move(string side, int cell, int flipped, bool passed, Position before, Position after)

class Game()
    Position position = Position(initial_board(), "B", false)
    Move[] history = []
    Move[] redo = []

void reset(Game &game)
    game.position = Position(initial_board(), "B", false)
    game.history = []
    game.redo = []

string status(Game game)
    return if game.position.over then game_over(game.position.board) else game.position.side + " to move"

bool adjust(Game &game, bool quiet)
    if len(legal(game.position.board, game.position.side)) > 0
        return false
    if len(legal(game.position.board, other(game.position.side))) > 0
        if not quiet
            emit(game.position.side + " passes")
        game.position.side = other(game.position.side)
        return true
    game.position.over = true
    if not quiet
        emit(game_over(game.position.board))
    return false

bool play(Game &game, int cell, bool quiet, int value = 0, bool report_value = false)
    Position before = game.position
    string side = game.position.side
    int flipped = int(len(flips(before.board, side, cell)))
    game.position.board = place(before.board, side, cell)
    if not quiet
        string line = side + " " + square_name(cell) + " flips {flipped}"
        if report_value
            line += " value {value}"
        emit(line)
    game.position.side = other(side)
    bool passed = adjust(&game, quiet)
    game.history = game.history.append(Move(side, cell, flipped, passed, before, game.position))
    game.redo = []
    return passed

string reason(Game game, int cell)
    if game.position.over
        return "game over"
    if game.position.board[cell] != "."
        return "occupied"
    if len(flips(game.position.board, game.position.side, cell)) == 0
        return "no flips"
    return ""

void record(Game &game, string text)
    Game trial = Game()
    int[] played = []
    int passes = 0
    for 0 <= int i < int(len(text)) step 2
        int cell = square_number(text[i:<i + 2])
        string why = reason(trial, cell)
        if why != ""
            emit("ILLEGAL move {i / 2 + 1} {square_name(cell)} {why}")
            return
        played = played.append(cell)
        if play(&trial, cell, true)
            passes += 1
    game.position = trial.position
    game.history = trial.history
    game.redo = []
    string first = square_name(played[0])
    string transformation = if first == "e6" then "diag" elif first == "d3" then "anti" elif first == "c4" then "rot180" else ""
    string normalized = ""
    for int cell = played[]
        normalized += square_name(if transformation == "" then cell else transformed_square(cell, transformation))
    emit("record {len(played)} moves {passes} passes")
    emit("normal " + normalized)
    emit(status(game))

string pad3(string word)
    string result = word
    while len(result) < 3
        result = " " + result
    return result

void sheet(Game game)
    string[] fields = if len(game.history) == 0 then game.position.board else game.history[0].before.board
    for nat i < len(game.history)
        fields[game.history[i].cell] = "{i + 1}"
    string header = " "
    for nat c < 8
        header += pad3("abcdefgh"[c])
    emit(header)
    for int r < 8
        string row = "{r + 1}"
        for int c < 8
            row += pad3(fields[8 * r + c])
        emit(row)

void stats(Game game)
    int total = 0
    int passes = 0
    for Move entry = game.history[]
        total += entry.flipped
        if entry.passed
            passes += 1
    if len(game.history) == 0
        emit("moves 0")
    else
        emit("moves {len(game.history)} flips {total} avg {average(total, int(len(game.history)))} passes {passes}")
    for string side = ["B", "W"][]
        int moves = 0
        int flipped = 0
        int maximum = -1
        int best = -1
        int corners = 0
        for Move entry = game.history[]
            if entry.side != side
                continue
            moves += 1
            flipped += entry.flipped
            if entry.flipped > maximum
                maximum = entry.flipped
                best = entry.cell
            if entry.cell == 0 or entry.cell == 7 or entry.cell == 56 or entry.cell == 63
                corners += 1
        if moves == 0
            emit("{side} moves 0")
        else
            emit("{side} moves {moves} flips {flipped} avg {average(flipped, moves)} max {maximum} {square_name(best)} corners {corners}")

void transform_game(Game &game, string operation)
    game.position.board = transformed_board(game.position.board, operation)
    for nat i < len(game.history)
        Move row = game.history[i]
        row.cell = transformed_square(row.cell, operation)
        row.before.board = transformed_board(row.before.board, operation)
        row.after.board = transformed_board(row.after.board, operation)
        game.history[i] = row
    for nat i < len(game.redo)
        Move row = game.redo[i]
        row.cell = transformed_square(row.cell, operation)
        row.before.board = transformed_board(row.before.board, operation)
        row.after.board = transformed_board(row.after.board, operation)
        game.redo[i] = row

void automatic(Game &game, int black, int white, bool randomized, int seed)
    string sequence = ""
    int moves = 0
    int passes = 0
    int state = seed
    while not game.position.over
        int cell = 0
        if randomized
            int[] choices = legal(game.position.board, game.position.side)
            state = random_step(state)
            cell = choices[state % int(len(choices))]
        else
            int depth = if game.position.side == "B" then black else white
            cell = ranked(game.position.board, game.position.side, depth)[0].cell
        sequence += square_name(cell)
        if play(&game, cell, true)
            passes += 1
        moves += 1
    emit((if randomized then "random" else "autoplay") + " {moves} moves {passes} passes")
    emit("moves " + sequence)
    emit(game_over(game.position.board))

void monte_carlo(Game game, int trials, int seed)
    int state = seed
    int best_value = -1
    int best_cell = 0
    for int cell = legal(game.position.board, game.position.side)[]
        int wins = 0
        int draws = 0
        int losses = 0
        string[] start = place(game.position.board, game.position.side, cell)
        for int i < trials
            string[] last = random_game(start, other(game.position.side), &state)
            int difference = count(last, game.position.side) - count(last, other(game.position.side))
            if difference > 0
                wins += 1
            elif difference == 0
                draws += 1
            else
                losses += 1
        emit("{square_name(cell)} {wins} {draws} {losses}")
        int points = 2 * wins + draws
        if points > best_value
            best_value = points
            best_cell = cell
    emit("best {square_name(best_cell)} {best_value}")

bool numeric_word(string text, int minimum, int maximum)
    if text == "" or len(text) > 10
        return false
    for nat i < len(text)
        if not "0123456789".contains(text[i])
            return false
    match int.parse(text)
        int value
            return minimum <= value <= maximum
        error problem
            return false

bool valid_square(string text)
    return len(text) == 2 and "abcdefgh".contains(text[0]) and "12345678".contains(text[1])

bool valid_record(string text)
    if len(text) == 0 or len(text) > 120 or len(text) % 2 != 0
        return false
    for 0 <= int i < int(len(text)) step 2
        if not valid_square(text[i:<i + 2])
            return false
    return true

bool valid_board(string text)
    if len(text) != 64
        return false
    for nat i < 64
        if not ".BW".contains(text[i])
            return false
    return true

void execute(Game &game, string line)
    string[] words = line.split(" ")
    string command = words[0]
    string[] args = words[1:]
    string[] no_arguments = "NEW DUMP SHOW SCORE LEGAL HISTORY SHEET STATS EVAL STABLE SOLVE".split(" ")
    string[] numeric_commands = "UNDO REDO HINT PV AI ANALYZE RANDOM PERFT DIVIDE".split(" ")
    string[] additional = "LOAD TRANSFORM AUTOPLAY MC FLIPS MOVE PLAY RECORD".split(" ")
    string[] active = "FLIPS MOVE PLAY HINT PV AI SOLVE AUTOPLAY RANDOM MC DIVIDE".split(" ")
    if not has(no_arguments, command) and not has(numeric_commands, command) and not has(additional, command)
        emit("ERROR unknown command")
        return
    string problem = ""
    if command == "LOAD"
        if len(args) != 2 or not valid_board(args[0]) or (args[1] != "B" and args[1] != "W")
            problem = "bad board"
    elif command == "MOVE" or command == "FLIPS"
        if len(args) != 1
            problem = "bad arguments"
        elif not valid_square(args[0])
            problem = "bad square"
    elif command == "PLAY" or command == "RECORD"
        if len(args) != 1
            problem = "bad arguments"
        elif not valid_record(args[0])
            problem = "bad record"
    elif has(no_arguments, command)
        if len(args) != 0
            problem = "bad arguments"
    elif command == "TRANSFORM"
        if len(args) != 1 or not has("rot90 rot180 rot270 mirror flip diag anti".split(" "), args[0])
            problem = "bad arguments"
    else
        int expected = if command == "MC" or command == "AUTOPLAY" then 2 else 1
        if int(len(args)) != expected
            problem = "bad arguments"
        else
            if not numeric_word(args[0], 0, 2147483647)
                problem = "bad arguments"
            if expected == 2 and not numeric_word(args[1], 0, 2147483647)
                problem = "bad arguments"
            if problem == ""
                int first = int.parse(args[0])
                int second = if expected == 2 then int.parse(args[1]) else 0
                bool valid = true
                if command == "AUTOPLAY"
                    valid = 1 <= first <= 4 and 1 <= second <= 4
                elif command == "HINT" or command == "PV" or command == "AI" or command == "ANALYZE"
                    valid = 1 <= first <= 4
                elif command == "PERFT" or command == "DIVIDE"
                    valid = 1 <= first <= 8
                elif command == "MC"
                    valid = 1 <= first <= 100 and 1 <= second <= 2147483646
                elif command == "RANDOM"
                    valid = 1 <= first <= 2147483646
                else
                    valid = first >= 1
                if not valid
                    problem = "bad arguments"
    if problem != ""
        emit("ERROR " + problem)
        return
    if game.position.over and has(active, command)
        emit("ERROR game over")
        return
    int n = 0
    if has(numeric_commands, command) or command == "AUTOPLAY" or command == "MC"
        n = int.parse(args[0])
    if command == "NEW"
        reset(&game)
        emit("OK")
    elif command == "LOAD"
        game.position = Position([for nat i < 64 then args[0][i]], args[1], false)
        game.history = []
        game.redo = []
        emit("OK")
        adjust(&game, false)
    elif command == "DUMP"
        emit("board " + game.position.board.join("") + " " + game.position.side)
    elif command == "SHOW"
        emit("  a b c d e f g h")
        int[] possible = if game.position.over then [] else legal(game.position.board, game.position.side)
        for int row < 8
            string result = "{row + 1}"
            for int column < 8
                int cell = 8 * row + column
                string item = if has_int(possible, cell) then "*" else game.position.board[cell]
                result += " " + item
            emit(result)
        emit(status(game))
    elif command == "SCORE"
        emit("score B {count(game.position.board, "B")} W {count(game.position.board, "W")} empty {count(game.position.board, ".")}")
    elif command == "LEGAL"
        int[] moves = if game.position.over then [] else legal(game.position.board, game.position.side)
        string result = "legal {len(moves)}"
        for int cell = moves[]
            result += " " + square_name(cell)
        emit(result)
    elif command == "MOVE" or command == "FLIPS"
        int cell = square_number(args[0])
        string why = reason(game, cell)
        if why != ""
            emit("ILLEGAL " + why)
        elif command == "MOVE"
            play(&game, cell, false)
        else
            int[] flipped = flips(game.position.board, game.position.side, cell)
            string result = "flips {args[0]} {len(flipped)}"
            for int point = flipped[]
                result += " " + square_name(point)
            emit(result)
    elif command == "PLAY"
        string text = args[0]
        for 0 <= int i < int(len(text)) step 2
            int cell = square_number(text[i:<i + 2])
            string why = reason(game, cell)
            if why != ""
                emit("ILLEGAL move {i / 2 + 1} {square_name(cell)} {why}")
                break
            play(&game, cell, false)
    elif command == "RECORD"
        record(&game, args[0])
    elif command == "UNDO"
        if n > int(len(game.history))
            emit("ERROR cannot undo")
        else
            int start = int(len(game.history)) - n
            game.position = game.history[start].before
            Move[] removed = [for start <= int i < int(len(game.history)) then game.history[i]]
            Move[] remaining = [for int i < start then game.history[i]]
            game.history = remaining
            game.redo = removed.concat(game.redo)
            emit(status(game))
    elif command == "REDO"
        if n > int(len(game.redo))
            emit("ERROR cannot redo")
        else
            Move[] restored = [for int i < n then game.redo[i]]
            game.redo = [for n <= int i < int(len(game.redo)) then game.redo[i]]
            game.history = game.history.concat(restored)
            game.position = restored[n - 1].after
            emit(status(game))
    elif command == "HISTORY"
        emit("history {len(game.history)}")
        for nat i < len(game.history)
            Move item = game.history[i]
            emit("{i + 1} {item.side} {square_name(item.cell)} {item.flipped}" + (if item.passed then " pass" else ""))
    elif command == "SHEET"
        sheet(game)
    elif command == "STATS"
        stats(game)
    elif command == "TRANSFORM"
        transform_game(&game, args[0])
        emit("OK")
    elif command == "EVAL"
        int[] values = evaluate(game.position.board, game.position.side)
        emit("eval {values[0]} weights {values[1]} mobility {values[2]} {values[3]}")
    elif command == "STABLE"
        int[] values = stable(game.position.board)
        emit("stable B {values[0]} W {values[1]}")
    elif command == "HINT"
        for Ranking item = ranked(game.position.board, game.position.side, n)[]
            emit("{square_name(item.cell)} {item.value}")
    elif command == "PV"
        Variation line = variation(game.position.board, game.position.side, n)
        emit("pv {search(game.position.board, game.position.side, n)} " + line.moves.join(" "))
    elif command == "AI"
        Ranking best = ranked(game.position.board, game.position.side, n)[0]
        play(&game, best.cell, false, best.value, true)
    elif command == "ANALYZE"
        int black_loss = 0
        int white_loss = 0
        for nat i < len(game.history)
            Move item = game.history[i]
            Ranking[] choices = ranked(item.before.board, item.side, n)
            Ranking best = choices[0]
            int actual = best.value
            for Ranking choice = choices[]
                if choice.cell == item.cell
                    actual = choice.value
            if item.side == "B"
                black_loss += best.value - actual
            else
                white_loss += best.value - actual
            emit("{i + 1} {item.side} {square_name(item.cell)} {actual} best {square_name(best.cell)} {best.value}")
        emit("loss B {black_loss} W {white_loss}")
    elif command == "SOLVE"
        if count(game.position.board, ".") >= 9
            emit("ERROR too many empties")
        else
            for Ranking choice = ranked(game.position.board, game.position.side, -1)[]
                emit("{square_name(choice.cell)} {choice.value}")
            Variation line = variation(game.position.board, game.position.side, -1)
            emit("line " + line.moves.join(" "))
            emit("final B {count(line.board, "B")} W {count(line.board, "W")}")
    elif command == "AUTOPLAY"
        automatic(&game, n, int.parse(args[1]), false, 0)
    elif command == "RANDOM"
        automatic(&game, 0, 0, true, n)
    elif command == "MC"
        monte_carlo(game, n, int.parse(args[1]))
    elif command == "PERFT"
        emit("perft {n} {perft(game.position.board, game.position.side, n)}")
    elif command == "DIVIDE"
        int total = 0
        for int cell = legal(game.position.board, game.position.side)[]
            int found = perft(place(game.position.board, game.position.side, cell), other(game.position.side), n - 1)
            emit("{square_name(cell)} {found}")
            total += found
        emit("total {total}")

string count_line
scan(&count_line)
int commands = int.parse(count_line)
Game game = Game()
for int i < commands
    string line
    scan(&line)
    execute(&game, line)
