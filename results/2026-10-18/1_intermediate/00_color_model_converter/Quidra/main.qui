// All fractional formulas use exact integer numerators and denominators.
int minimum(int a, int b)
    return if a < b then a else b

int maximum(int a, int b)
    return if a > b then a else b

int absolute(int value)
    return if value < 0 then -value else value

int floor_ratio(int numerator, int denominator)
    if numerator >= 0
        return numerator / denominator
    return -((-numerator + denominator - 1) / denominator)

int rounded(int numerator, int denominator)
    return floor_ratio(2 * numerator + denominator, 2 * denominator)

int away(int numerator, int denominator)
    return if numerator < 0 then -rounded(-numerator, denominator) else rounded(numerator, denominator)

int modulo(int value, int divisor)
    return (value % divisor + divisor) % divisor

int clamp(int value)
    return minimum(255, maximum(0, value))

int root_ratio(int numerator, int denominator)
    int low = 0
    int high = 1
    while high * high * denominator <= numerator
        high *= 2
    while low + 1 < high
        int middle = (low + high) / 2
        if middle * middle * denominator <= numerator
            low = middle
        else
            high = middle
    return low

int index_of(string value, string[] values)
    for 0 <= int i < int(len(values))
        if values[i] == value
            return i
    return -1

bool member(string value, string words)
    return index_of(value, words.split(" ")) >= 0

string[] builtin_names()
    return ["black", "maroon", "green", "olive", "navy", "purple", "teal", "silver", "gray", "red", "lime", "yellow", "blue", "magenta", "cyan", "white", "orange", "pink", "brown", "gold", "coral", "salmon", "violet", "indigo"]

int[][] builtin_colors()
    return [[0, 0, 0], [128, 0, 0], [0, 128, 0], [128, 128, 0], [0, 0, 128], [128, 0, 128], [0, 128, 128], [192, 192, 192], [128, 128, 128], [255, 0, 0], [0, 255, 0], [255, 255, 0], [0, 0, 255], [255, 0, 255], [0, 255, 255], [255, 255, 255], [255, 165, 0], [255, 192, 203], [165, 42, 42], [255, 215, 0], [255, 127, 80], [250, 128, 114], [238, 130, 238], [75, 0, 130]]

int hex_digit(string character)
    string alphabet = "0123456789abcdefABCDEF"
    match alphabet.find(character)
        nat position
            return if position < 16 then int(position) else int(position) - 6
        none
            return -1

bool digits(string text)
    if len(text) == 0
        return false
    for nat i < len(text)
        if not "0123456789".contains(text[i])
            return false
    return true

(bool, int) integer(string text, int low, int high)
    string magnitude = text
    bool negative = false
    if text.starts_with("-")
        magnitude = text[1:]
        negative = true
    if len(magnitude) < 1 or len(magnitude) > 9 or not digits(magnitude)
        return (false, 0)
    int value = int.parse(magnitude)
    if negative
        value = -value
    return (low <= value <= high, value)

bool valid_name(string text)
    if len(text) < 1 or len(text) > 12
        return false
    for nat i < len(text)
        if not "abcdefghijklmnopqrstuvwxyz".contains(text[i])
            return false
    return true

int[] parse_color(string text, string[] names, int[][] colors)
    if text.starts_with("#")
        if len(text) != 4 and len(text) != 7
            return []
        int[] result = []
        int width = if len(text) == 4 then 1 else 2
        for 0 <= int i < 3
            int first = hex_digit(text[1 + i * width])
            int second = if width == 1 then first else hex_digit(text[2 + i * width])
            if first < 0 or second < 0
                return []
            result = result.append(first * 16 + second)
        return result
    if text.starts_with("rgb(") and text.ends_with(")")
        string[] components = text[4:<len(text) - 1].split(",")
        if len(components) != 3
            return []
        int[] result = []
        for string component = components[]
            if len(component) < 1 or len(component) > 3 or not digits(component)
                return []
            int value = int.parse(component)
            if value > 255
                return []
            result = result.append(value)
        return result
    int position = index_of(text, names)
    return if position < 0 then [] else colors[position]

string hexadecimal(int value, int width)
    string alphabet = "0123456789ABCDEF"
    string result = ""
    for 0 <= int i < width
        result = alphabet[value % 16] + result
        value /= 16
    return result

string color_text(int[] color)
    return "#" + hexadecimal(color[0], 2) + hexadecimal(color[1], 2) + hexadecimal(color[2], 2)

string sequence_text(int[][] colors)
    string[] fields = [for int[] color = colors[] then color_text(color)]
    return fields.join(" ")

int distance(int[] first, int[] second)
    int total = 0
    for 0 <= int i < 3
        int difference = first[i] - second[i]
        total += difference * difference
    return total

int hue(int[] color)
    int r = color[0]
    int g = color[1]
    int b = color[2]
    int largest = maximum(r, maximum(g, b))
    int delta = largest - minimum(r, minimum(g, b))
    if delta == 0
        return 0
    int numerator = 0
    if largest == r
        numerator = 60 * (g - b)
        if numerator < 0
            numerator += 360 * delta
    elif largest == g
        numerator = 60 * (b - r) + 120 * delta
    else
        numerator = 60 * (r - g) + 240 * delta
    return modulo(rounded(numerator, delta), 360)

int[] hsl(int[] color)
    int largest = maximum(color[0], maximum(color[1], color[2]))
    int smallest = minimum(color[0], minimum(color[1], color[2]))
    int delta = largest - smallest
    int saturation = if delta == 0 then 0 else rounded(100 * delta, 255 - absolute(largest + smallest - 255))
    return [hue(color), saturation, rounded(100 * (largest + smallest), 510)]

int[] factors(int angle)
    int sector = angle / 60
    int fraction = angle % 60
    int x = if sector % 2 == 0 then fraction else 60 - fraction
    int[][] choices = [[60, x, 0], [x, 60, 0], [0, 60, x], [0, x, 60], [x, 0, 60], [60, 0, x]]
    return choices[sector]

int[] from_hsl(int angle, int saturation, int lightness)
    int chroma = (100 - absolute(2 * lightness - 100)) * saturation
    int[] base_factors = factors(angle)
    int[] result = []
    for int factor = base_factors[]
        result = result.append(rounded(255 * (chroma * (factor - 30) + 6000 * lightness), 600000))
    return result

int[] from_hsv(int angle, int saturation, int value)
    int chroma = value * saturation
    int[] base_factors = factors(angle)
    int[] result = []
    for int factor = base_factors[]
        result = result.append(rounded(255 * (chroma * (factor - 60) + 6000 * value), 600000))
    return result

int[] from_hwb(int angle, int whiteness, int blackness)
    if whiteness + blackness >= 100
        int value = rounded(255 * whiteness, whiteness + blackness)
        return [value, value, value]
    int[] base_factors = factors(angle)
    int[] result = []
    for int factor = base_factors[]
        result = result.append(rounded(255 * (factor * (100 - whiteness - blackness) + 60 * whiteness), 6000))
    return result

int[] model(string name, int[] color)
    int r = color[0]
    int g = color[1]
    int b = color[2]
    int largest = maximum(r, maximum(g, b))
    int smallest = minimum(r, minimum(g, b))
    int delta = largest - smallest
    if name == "HSL"
        return hsl(color)
    if name == "HSV"
        int saturation = if largest == 0 then 0 else rounded(100 * delta, largest)
        return [hue(color), saturation, rounded(100 * largest, 255)]
    if name == "HWB"
        return [hue(color), rounded(100 * smallest, 255), rounded(100 * (255 - largest), 255)]
    if name == "CMYK"
        if largest == 0
            return [0, 0, 0, 100]
        return [rounded(100 * (largest - r), largest), rounded(100 * (largest - g), largest), rounded(100 * (largest - b), largest), rounded(100 * (255 - largest), 255)]
    int y = rounded(299 * r + 587 * g + 114 * b, 1000)
    if name == "YIQ"
        return [y, rounded(596 * r - 274 * g - 322 * b, 1000), rounded(211 * r - 523 * g + 312 * b, 1000)]
    return [clamp(y), clamp(rounded(128000 - 169 * r - 331 * g + 500 * b, 1000)), clamp(rounded(128000 + 500 * r - 419 * g - 81 * b, 1000))]

string model_text(string name, int[] color)
    int[] values = model(name, color)
    if name == "HSL"
        return "hsl({values[0]},{values[1]}%,{values[2]}%)"
    if name == "HSV"
        return "hsv({values[0]},{values[1]}%,{values[2]}%)"
    if name == "HWB"
        return "hwb({values[0]},{values[1]}%,{values[2]}%)"
    if name == "CMYK"
        return "cmyk({values[0]}%,{values[1]}%,{values[2]}%,{values[3]}%)"
    if name == "YIQ"
        return "yiq({values[0]},{values[1]},{values[2]})"
    return "ycbcr({values[0]},{values[1]},{values[2]})"

int[] ansi_color(int number)
    if number < 16
        int[][] colors = builtin_colors()
        return colors[number]
    if number >= 232
        int value = 8 + 10 * (number - 232)
        return [value, value, value]
    int[] levels = [0, 95, 135, 175, 215, 255]
    int value = number - 16
    return [levels[value / 36], levels[value / 6 % 6], levels[value % 6]]

int luminance(int[] color)
    return 2126 * color[0] * color[0] + 7152 * color[1] * color[1] + 722 * color[2] * color[2]

int[] contrast(int[] first, int[] second)
    int a = luminance(first)
    int b = luminance(second)
    int high = maximum(a, b) + 32512500
    int low = minimum(a, b) + 32512500
    int verdict = if high >= 7 * low then 2 elif 2 * high >= 9 * low then 1 else 0
    return [rounded(100 * high, low), verdict]

string contrast_text(int[] first, int[] second)
    int[] result = contrast(first, second)
    int whole = result[0] / 100
    int fraction = result[0] % 100
    string[] verdicts = ["FAIL", "AA", "AAA"]
    return "{whole}.{fraction:int=2,zero} {verdicts[result[1]]}"

int[][] gradient(int[] first, int[] second, int count)
    int[][] result = []
    for 0 <= int i < count
        int[] color = []
        for 0 <= int channel < 3
            color = color.append(first[channel] + away((second[channel] - first[channel]) * i, count - 1))
        result = result.append(color)
    return result

int[] mean_color(int[][] colors)
    int[] totals = [0, 0, 0]
    for int[] color = colors[]
        totals += color
    for 0 <= int channel < 3
        totals[channel] = rounded(totals[channel], int(len(colors)))
    return totals

int[] widths(int[][] colors)
    int[] low = colors[0]
    int[] high = colors[0]
    for int[] color = colors[]
        for 0 <= int channel < 3
            low[channel] = minimum(low[channel], color[channel])
            high[channel] = maximum(high[channel], color[channel])
    return high - low

int[][][] palette(int[][] colors, int count)
    int[][][] boxes = [colors]
    while int(len(boxes)) < count
        int selected = -1
        int widest = -1
        int channel = 0
        for 0 <= int i < int(len(boxes))
            if len(boxes[i]) < 2
                continue
            int[] spans = widths(boxes[i])
            int component = 0
            for 1 <= int j < 3
                if spans[j] > spans[component]
                    component = j
            if spans[component] > widest
                selected = i
                widest = spans[component]
                channel = component
        int[][] box = boxes[selected]
        for 1 <= int i < int(len(box))
            int[] value = box[i]
            int j = i - 1
            while j >= 0 and box[j][channel] > value[channel]
                box[j + 1] = box[j]
                j -= 1
            box[j + 1] = value
        int middle = int(len(box)) / 2
        int[][][] next = []
        for 0 <= int i < int(len(boxes))
            if i == selected
                next = next.append(box[:<middle])
                next = next.append(box[middle:])
            else
                next = next.append(boxes[i])
        boxes = next
    return boxes

int blend_component(string mode, int x, int y)
    int multiplied = x * y / 255
    int screened = 255 - (255 - x) * (255 - y) / 255
    if mode == "MULTIPLY"
        return multiplied
    if mode == "SCREEN"
        return screened
    if mode == "OVERLAY" or mode == "HARDLIGHT"
        bool low = if mode == "OVERLAY" then x < 128 else y < 128
        return if low then 2 * x * y / 255 else 255 - 2 * (255 - x) * (255 - y) / 255
    if mode == "SOFTLIGHT"
        return ((255 - x) * multiplied + x * screened) / 255
    if mode == "DARKEN"
        return minimum(x, y)
    if mode == "LIGHTEN"
        return maximum(x, y)
    if mode == "DIFFERENCE"
        return absolute(x - y)
    if mode == "EXCLUSION"
        return x + y - 2 * x * y / 255
    if mode == "ADD"
        return minimum(255, x + y)
    if mode == "SUBTRACT"
        return maximum(0, x - y)
    if mode == "COLORDODGE"
        return if y == 255 then 255 else minimum(255, 255 * x / (255 - y))
    return if y == 0 then 0 else maximum(0, 255 - 255 * (255 - x) / y)

string schema(string command, int count)
    if command == "BEST"
        return if 2 <= count <= 33 then string.repeat("C", nat(count)) else "?"
    if command == "SORT" or command == "DITHER"
        return if 1 <= count <= 32 then string.repeat("C", nat(count)) else "?"
    if command == "PALETTE" or command == "KMEANS"
        return if 2 <= count <= 33 then "B" + string.repeat("C", nat(count - 1)) else "?"
    string[] definitions = ["PARSE C", "DEFINE NC", "UNDEFINE N", "LIST", "HSL C", "FROMHSL HPP", "HSV C", "FROMHSV HPP", "HWB C", "FROMHWB HPP", "CMYK C", "FROMCMYK PPPP", "YCBCR C", "FROMYCBCR YYY", "YIQ C", "FROMYIQ YII", "RGB565 C", "FROM565 X", "ANSI C", "FROMANSI Y", "WEBSAFE C", "GRAY CK", "INVERT C", "MIX CCP", "MIXHSL CCP", "GRADIENT CCG", "TINTS CT", "SHADES CT", "TONES CT", "BLEND KCC", "ALPHA CPCP", "SIMULATE CK", "ROTATE CD", "COMPLEMENT C", "TRIADIC C", "TETRADIC C", "SPLITCOMP C", "ANALOGOUS CAS", "LIGHTEN CP", "DARKEN CP", "SATURATE CP", "DESATURATE CP", "NEAREST C", "DISTANCE CC", "CONTRAST CC", "ACCESSIBLE CC", "DESCRIBE C", "RANDOM RU"]
    for string definition = definitions[]
        string[] parts = definition.split(" ")
        if parts[0] == command
            string result = if len(parts) == 1 then "" else parts[1]
            return if int(len(result)) == count then result else "?"
    return "?"

string execute(string[] words, string[] &registered_names, int[][] &registered_colors)
    string command = words[0]
    string[] arguments = words[1:]
    string kinds = schema(command, int(len(arguments)))
    if kinds == "?"
        return "INVALID"
    string[] names = builtin_names().concat(registered_names)
    int[][] colors = builtin_colors().concat(registered_colors)
    int[] empty_color = []
    int[][] parsed = array(len(arguments), fill = empty_color)
    int[] numbers = array(len(arguments), fill = 0)
    for nat i < len(arguments)
        string kind = kinds[i]
        string argument = arguments[i]
        if kind == "C"
            parsed[i] = parse_color(argument, names, colors)
            if len(parsed[i]) != 3
                return "INVALID"
        elif kind == "N"
            if not valid_name(argument)
                return "INVALID"
        elif kind == "K"
            string keywords = if command == "GRAY" then "LUMA AVERAGE LIGHTNESS HSP" elif command == "SIMULATE" then "PROTANOPIA DEUTERANOPIA TRITANOPIA ACHROMATOPSIA" else "MULTIPLY SCREEN OVERLAY HARDLIGHT SOFTLIGHT DARKEN LIGHTEN DIFFERENCE EXCLUSION ADD SUBTRACT COLORDODGE COLORBURN HUE SATURATION COLOR LUMINOSITY"
            if not member(argument, keywords)
                return "INVALID"
        elif kind == "X"
            if len(argument) != 6 or not argument.starts_with("0x")
                return "INVALID"
            int value = 0
            for 2 <= int j < 6
                int digit = hex_digit(argument[j])
                if digit < 0
                    return "INVALID"
                value = value * 16 + digit
            numbers[i] = value
        else
            int low = 0
            int high = 100
            if kind == "H"
                high = 359
            elif kind == "Y"
                high = 255
            elif kind == "I"
                low = -255
                high = 255
            elif kind == "D"
                low = -720
                high = 720
            elif kind == "G"
                low = 2
                high = 16
            elif kind == "T"
                low = 1
                high = 10
            elif kind == "A"
                low = 1
                high = 6
            elif kind == "S"
                low = 1
                high = 60
            elif kind == "R"
                low = 1
                high = 999999999
            elif kind == "U"
                low = 1
                high = 16
            elif kind == "B"
                low = 1
                high = 32
            (bool valid, int value) = integer(argument, low, high)
            if not valid
                return "INVALID"
            numbers[i] = value
    if (command == "PALETTE" or command == "KMEANS") and numbers[0] > int(len(arguments)) - 1
        return "INVALID"

    if command == "DEFINE"
        string name = arguments[0]
        if index_of(name, builtin_names()) >= 0
            return "INVALID"
        int position = index_of(name, registered_names)
        if position >= 0
            registered_colors[position] = parsed[1]
        else
            registered_names = registered_names.append(name)
            registered_colors = registered_colors.append(parsed[1])
        return name + " " + color_text(parsed[1])
    if command == "UNDEFINE"
        int position = index_of(arguments[0], registered_names)
        if position < 0
            return "INVALID"
        string[] next_names = []
        int[][] next_colors = []
        for 0 <= int i < int(len(registered_names))
            if i != position
                next_names = next_names.append(registered_names[i])
                next_colors = next_colors.append(registered_colors[i])
        registered_names = next_names
        registered_colors = next_colors
        return arguments[0] + " removed"
    if command == "LIST"
        if len(registered_names) == 0
            return "NONE"
        string[] ordered = registered_names.sorted()
        string[] result = []
        for string name = ordered[]
            int position = index_of(name, registered_names)
            result = result.append(name + "=" + color_text(registered_colors[position]))
        return result.join(" ")

    int[] first = if len(parsed) > 0 then parsed[0] else []
    int[] second = if len(parsed) > 1 then parsed[1] else []
    if member(command, "HSL HSV HWB CMYK YCBCR YIQ")
        return model_text(command, first)
    if command == "PARSE"
        string matching = "-"
        for nat i < len(names)
            if colors[i] == first
                matching = names[i]
                break
        string[] result = [color_text(first), "rgb({first[0]},{first[1]},{first[2]})"]
        string[] models = ["HSL", "HSV", "HWB", "CMYK", "YCBCR", "YIQ"]
        for string name = models[]
            result = result.append(model_text(name, first))
        result = result.append(matching)
        return result.join(" ")
    if command == "FROMHSL"
        return color_text(from_hsl(numbers[0], numbers[1], numbers[2]))
    if command == "FROMHSV"
        return color_text(from_hsv(numbers[0], numbers[1], numbers[2]))
    if command == "FROMHWB"
        return color_text(from_hwb(numbers[0], numbers[1], numbers[2]))
    if command == "FROMCMYK"
        int[] result = []
        for 0 <= int i < 3
            result = result.append(rounded(255 * (100 - numbers[i]) * (100 - numbers[3]), 10000))
        return color_text(result)
    if command == "FROMYCBCR"
        int y = numbers[0]
        int cb = numbers[1] - 128
        int cr = numbers[2] - 128
        return color_text([clamp(rounded(1000 * y + 1402 * cr, 1000)), clamp(rounded(1000 * y - 344 * cb - 714 * cr, 1000)), clamp(rounded(1000 * y + 1772 * cb, 1000))])
    if command == "FROMYIQ"
        int y = numbers[0]
        int i = numbers[1]
        int q = numbers[2]
        return color_text([clamp(rounded(1000 * y + 956 * i + 619 * q, 1000)), clamp(rounded(1000 * y - 272 * i - 647 * q, 1000)), clamp(rounded(1000 * y - 1106 * i + 1703 * q, 1000))])
    if command == "RGB565"
        int value = 2048 * rounded(31 * first[0], 255) + 32 * rounded(63 * first[1], 255) + rounded(31 * first[2], 255)
        return "0x" + hexadecimal(value, 4)
    if command == "FROM565"
        int value = numbers[0]
        return color_text([rounded(255 * (value / 2048), 31), rounded(255 * (value / 32 % 64), 63), rounded(255 * (value % 32), 31)])
    if command == "FROMANSI"
        return color_text(ansi_color(numbers[0]))
    if command == "ANSI" or command == "NEAREST"
        int best = -1
        int best_distance = -1
        int start = if command == "ANSI" then 16 else 0
        int stop = if command == "ANSI" then 256 else int(len(colors))
        for start <= int i < stop
            int[] candidate = if command == "ANSI" then ansi_color(i) else colors[i]
            int difference = distance(first, candidate)
            if best == -1 or difference < best_distance
                best = i
                best_distance = difference
        int[] selected = if command == "ANSI" then ansi_color(best) else colors[best]
        string label = if command == "ANSI" then best.string() else names[best]
        return "{label} {color_text(selected)} {best_distance}"
    if command == "WEBSAFE" or command == "INVERT" or command == "GRAY"
        int[] result = []
        if command == "GRAY"
            string method = arguments[1]
            int value = 0
            if method == "LUMA"
                value = rounded(299 * first[0] + 587 * first[1] + 114 * first[2], 1000)
            elif method == "AVERAGE"
                value = rounded(first[0] + first[1] + first[2], 3)
            elif method == "LIGHTNESS"
                value = rounded(maximum(first[0], maximum(first[1], first[2])) + minimum(first[0], minimum(first[1], first[2])), 2)
            else
                value = root_ratio(299 * first[0] * first[0] + 587 * first[1] * first[1] + 114 * first[2] * first[2], 1000)
            return color_text([value, value, value])
        for int component = first[]
            result = result.append(if command == "INVERT" then 255 - component else 51 * rounded(component, 51))
        return color_text(result)
    if command == "MIX"
        int p = numbers[2]
        int[] result = []
        for 0 <= int channel < 3
            result = result.append(rounded(first[channel] * (100 - p) + second[channel] * p, 100))
        return color_text(result)
    if command == "MIXHSL"
        int[] a = hsl(first)
        int[] b = hsl(second)
        int p = numbers[2]
        int delta = modulo(b[0] - a[0], 360)
        if delta > 180
            delta -= 360
        return color_text(from_hsl(modulo(a[0] + away(delta * p, 100), 360), a[1] + away((b[1] - a[1]) * p, 100), a[2] + away((b[2] - a[2]) * p, 100)))
    if command == "GRADIENT"
        return sequence_text(gradient(first, second, numbers[2]))
    if member(command, "TINTS SHADES TONES")
        int value = if command == "TINTS" then 255 elif command == "SHADES" then 0 else 128
        int count = numbers[1]
        int[][] result = gradient(first, [value, value, value], count + 2)
        return sequence_text(result[1:<count + 1])
    if command == "BLEND"
        string mode = arguments[0]
        int[] base_color = parsed[1]
        int[] top_color = parsed[2]
        if member(mode, "HUE SATURATION COLOR LUMINOSITY")
            int[] a = hsl(base_color)
            int[] b = hsl(top_color)
            if mode == "HUE" or mode == "COLOR"
                a[0] = b[0]
            if mode == "SATURATION" or mode == "COLOR"
                a[1] = b[1]
            if mode == "LUMINOSITY"
                a[2] = b[2]
            return color_text(from_hsl(a[0], a[1], a[2]))
        int[] result = []
        for 0 <= int i < 3
            result = result.append(blend_component(mode, base_color[i], top_color[i]))
        return color_text(result)
    if command == "ALPHA"
        int p = numbers[1]
        int q = numbers[3]
        int opacity = 100 * p + q * (100 - p)
        int[] result = [0, 0, 0]
        if opacity > 0
            for 0 <= int channel < 3
                result[channel] = rounded(100 * p * parsed[0][channel] + q * (100 - p) * parsed[2][channel], opacity)
        return "{color_text(result)} {rounded(opacity, 100)}%"
    if command == "SIMULATE"
        string type = arguments[1]
        int[][] matrix = [[299, 587, 114], [299, 587, 114], [299, 587, 114]]
        if type == "PROTANOPIA"
            matrix = [[567, 433, 0], [558, 442, 0], [0, 242, 758]]
        elif type == "DEUTERANOPIA"
            matrix = [[625, 375, 0], [700, 300, 0], [0, 300, 700]]
        elif type == "TRITANOPIA"
            matrix = [[950, 50, 0], [0, 433, 567], [0, 475, 525]]
        int[] result = []
        for int[] row = matrix[]
            result = result.append(rounded(row[0] * first[0] + row[1] * first[1] + row[2] * first[2], 1000))
        return color_text(result)
    if member(command, "ROTATE COMPLEMENT TRIADIC TETRADIC SPLITCOMP ANALOGOUS LIGHTEN DARKEN SATURATE DESATURATE")
        int[] values = hsl(first)
        int[] shifts = []
        if command == "ROTATE"
            shifts = [numbers[1]]
        elif command == "COMPLEMENT"
            shifts = [180]
        elif command == "TRIADIC"
            shifts = [120, 240]
        elif command == "TETRADIC"
            shifts = [90, 180, 270]
        elif command == "SPLITCOMP"
            shifts = [150, 210]
        elif command == "ANALOGOUS"
            int k = numbers[1]
            for -k <= int i <= k
                if i != 0
                    shifts = shifts.append(i * numbers[2])
        else
            int p = numbers[1]
            if command == "LIGHTEN"
                values[2] = minimum(100, values[2] + p)
            elif command == "DARKEN"
                values[2] = maximum(0, values[2] - p)
            elif command == "SATURATE"
                values[1] = minimum(100, values[1] + p)
            else
                values[1] = maximum(0, values[1] - p)
            return color_text(from_hsl(values[0], values[1], values[2]))
        int[][] result = []
        for int shift = shifts[]
            result = result.append(from_hsl(modulo(values[0] + shift, 360), values[1], values[2]))
        return sequence_text(result)
    if command == "DISTANCE"
        int dr = first[0] - second[0]
        int dg = first[1] - second[1]
        int db = first[2] - second[2]
        int weighted = (1024 + first[0] + second[0]) * dr * dr + 2048 * dg * dg + (1534 - first[0] - second[0]) * db * db
        return "{distance(first, second)} {root_ratio(weighted, 512)}"
    if command == "CONTRAST"
        return contrast_text(first, second)
    if command == "ACCESSIBLE"
        int[] selected = first
        int[] original = contrast(first, second)
        if original[1] == 0
            int[] values = hsl(first)
            bool found = false
            for 1 <= int step <= 100
                int[] lightnesses = [values[2] - step, values[2] + step]
                for int lightness = lightnesses[]
                    if 0 <= lightness <= 100
                        int[] candidate = from_hsl(values[0], values[1], lightness)
                        int[] assessment = contrast(candidate, second)
                        if assessment[1] != 0
                            selected = candidate
                            found = true
                            break
                if found
                    break
        return "{color_text(selected)} {contrast_text(selected, second)}"
    if command == "BEST"
        int best = 1
        int[] assessment = contrast(parsed[1], first)
        for 2 <= int i < int(len(parsed))
            int[] candidate = contrast(parsed[i], first)
            if candidate[0] > assessment[0]
                best = i
                assessment = candidate
        return "{color_text(parsed[best])} {contrast_text(parsed[best], first)}"
    if command == "DESCRIBE"
        int[] values = hsl(first)
        int lightness = values[2]
        if lightness <= 5
            return "black"
        if lightness >= 95
            return "white"
        string light_word = if lightness <= 20 then "very dark" elif lightness <= 40 then "dark" elif lightness <= 60 then "medium" elif lightness <= 80 then "light" else "very light"
        if values[1] < 10
            return light_word + " gray"
        string saturation = if values[1] < 40 then "muted" elif values[1] < 80 then "moderate" else "vivid"
        string[] hues = ["red", "orange", "yellow", "chartreuse", "green", "spring-green", "cyan", "azure", "blue", "violet", "magenta", "rose"]
        return light_word + " " + saturation + " " + hues[(values[0] + 15) % 360 / 30]
    if command == "PALETTE" or command == "KMEANS"
        int k = numbers[0]
        int[][] source = parsed[1:]
        int[][][] boxes = palette(source, k)
        int[][] representatives = []
        for int[][] box = boxes[]
            representatives = representatives.append(mean_color(box))
        int[] counts = []
        int iterations = 0
        if command == "PALETTE"
            for int[][] box = boxes[]
                counts = counts.append(int(len(box)))
        else
            for 1 <= int iteration <= 20
                iterations = iteration
                int[][][] assigned = array(nat(k), fill = source[:<0])
                for int[] color = source[]
                    int best = 0
                    int best_distance = distance(color, representatives[0])
                    for 1 <= int j < k
                        int difference = distance(color, representatives[j])
                        if difference < best_distance
                            best = j
                            best_distance = difference
                    assigned[best] = assigned[best].append(color)
                int[][] next = representatives
                counts = []
                for 0 <= int j < k
                    counts = counts.append(int(len(assigned[j])))
                    if len(assigned[j]) > 0
                        next[j] = mean_color(assigned[j])
                bool equal = next == representatives
                representatives = next
                if equal
                    break
        string[] result = []
        if command == "KMEANS"
            result = result.append(iterations.string())
        for 0 <= int i < k
            result = result.append(color_text(representatives[i]) + ":" + counts[i].string())
        return result.join(" ")
    if command == "SORT"
        int[][] result = parsed
        for 1 <= int i < int(len(result))
            int[] color = result[i]
            int[] key = hsl(color)
            int j = i - 1
            while j >= 0
                int[] previous = hsl(result[j])
                bool greater = false
                for 0 <= int channel < 3
                    if previous[channel] != key[channel]
                        greater = previous[channel] > key[channel]
                        break
                if not greater
                    break
                result[j + 1] = result[j]
                j -= 1
            result[j + 1] = color
        return sequence_text(result)
    if command == "DITHER"
        int[][] choices = builtin_colors()
        int[] diffusion = [0, 0, 0]
        string[] result = []
        for int[] color = parsed[]
            int[] adjusted = []
            for 0 <= int channel < 3
                adjusted = adjusted.append(clamp(color[channel] + diffusion[channel]))
            int best = 0
            int best_distance = distance(adjusted, choices[0])
            for 1 <= int i < 16
                int difference = distance(adjusted, choices[i])
                if difference < best_distance
                    best = i
                    best_distance = difference
            diffusion = adjusted - choices[best]
            result = result.append(names[best])
        return result.join(" ")
    if command == "RANDOM"
        int state = numbers[0]
        int[][] result = []
        for 0 <= int i < numbers[1]
            state = state * 48271 % 2147483647
            int angle = state % 360
            state = state * 48271 % 2147483647
            int saturation = 40 + state % 61
            state = state * 48271 % 2147483647
            int lightness = 25 + state % 51
            result = result.append(from_hsl(angle, saturation, lightness))
        return sequence_text(result)
    return "INVALID"

int command_count
scan(&command_count)
string[] registered_names = []
int[][] registered_colors = []
for 0 <= int line < command_count
    string input_line
    scan(&input_line)
    string[] words = input_line.split(" ")
    string result = execute(words, &registered_names, &registered_colors)
    print(result + NL)
