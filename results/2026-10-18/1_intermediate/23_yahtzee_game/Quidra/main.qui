import math

void emit(string text)
    print(text + NL)

string[] category_names()
    return ["ONES", "TWOS", "THREES", "FOURS", "FIVES", "SIXES", "THREEKIND", "FOURKIND", "FULLHOUSE", "SMALL", "LARGE", "YAHTZEE", "CHANCE"]

bool includes(const string[] values, string target)
    for string value = values[]
        if value == target
            return true
    return false

int | error integer_word(string text, int minimum, int maximum)
    int start = if text[0] == "-" then 1 else 0
    if start == int(len(text)) or text == "-0"
        return error("bad value " + text)
    if int(len(text)) - start > 1 and text[start] == "0"
        return error("bad value " + text)
    for start <= int index < int(len(text))
        if not "0123456789".contains(text[index])
            return error("bad value " + text)
    int value = int.parse(text)
    if value < minimum or value > maximum
        return error("bad value " + text)
    return value

string | error player_name(string text)
    if len(text) > 8
        return error("bad name " + text)
    for int point = text.codepoints()[]
        if point < 65 or point > 90
            return error("bad name " + text)
    return text

string | error strategy_word(string text)
    if not includes(["KIND", "STRAIGHT", "HIGH", "UPPER"], text)
        return error("bad strategy " + text)
    return text

int | error category_word(string text)
    string[] names = category_names()
    for nat index = names.indices()[]
        if names[index] == text
            return int(index)
    return error("bad category " + text)

bool[] | error hold_pattern(string text)
    if len(text) != 5
        return error("bad pattern " + text)
    bool[] marks = []
    for 0 <= int index < 5
        if text[index] != "0" and text[index] != "1"
            return error("bad pattern " + text)
        marks = marks.append(text[index] == "1")
    return marks

int[] | error face_words(const string[] tokens)
    int[] faces = []
    for string token = tokens[]
        int face = try integer_word(token, 1, 6)
        faces = faces.append(face)
    return faces

string fraction(int numerator, int denominator)
    int left = numerator
    int right = denominator
    while right != 0
        int remainder = left % right
        left = right
        right = remainder
    numerator /= left
    denominator /= left
    return if denominator == 1 then "{numerator}" else "{numerator}/{denominator}"

string average(int total, int count)
    int value = if count == 0 then 0 else 100 * total / count
    return "{value / 100}.{value % 100:int=2,zero}"

string faces_text(const int[] dice)
    return if len(dice) == 0 then "-" else [for int face = dice[] then "{face}"].join(" ")

string pattern_text(const bool[] marks)
    return [for bool mark = marks[] then if mark then "1" else "0"].join("")

int[] held_faces(const int[] dice, const bool[] marks)
    return [for nat index = dice.indices()[] if marks[index] then dice[index]]

int held_count(const bool[] marks)
    int[] selected = [for bool mark = marks[] if mark then 1]
    return math.sum(selected)

int[] face_counts(const int[] dice)
    int[] counts = array(6, fill = 0)
    for int face = dice[]
        counts[face - 1] += 1
    return counts

int most_frequent(const int[] counts)
    int maximum = math.max_all(counts)
    int chosen = 0
    for nat index = counts.indices()[]
        if counts[index] == maximum
            chosen = int(index)
    return chosen

class Rules()
    int rolls = 3
    string joker = "FORCED"

class Player(string name, string strategy = "KIND")
    int[] boxes = array(13, fill = -1)
    int yahtzee_bonus = 0

int upper_subtotal(const Player player)
    return math.sum([for int score = player.boxes[0:<6][] if score >= 0 then score])

int player_total(const Player player)
    return math.sum([for int score = player.boxes[] if score >= 0 then score]) + player.yahtzee_bonus + (if upper_subtotal(player) >= 63 then 35 else 0)

int player_round(const Player player)
    return int(len([for int score = player.boxes[] if score >= 0 then score])) + 1

class CandidateScores()
    bool joker = false
    bool[] allowed = array(13, fill = false)
    int[] points = array(13, fill = 0)
    int best = 0
    string requirement = ""

CandidateScores candidates(const Player player, const int[] counts, string joker_rule)
    auto result = CandidateScores()
    result.allowed = [for int score = player.boxes[] then score < 0]
    int largest = math.max_all(counts)
    int total = math.sum(counts * [1, 2, 3, 4, 5, 6])
    result.joker = joker_rule != "OFF" and largest == 5 and player.boxes[11] >= 0
    if result.joker and joker_rule == "FORCED"
        int face = most_frequent(counts)
        if player.boxes[face] < 0
            result.allowed = array(13, fill = false)
            result.allowed[face] = true
            result.requirement = category_names()[face]
        elif len([for bool available = result.allowed[6:][] if available then available]) > 0
            for 0 <= int index < 6
                result.allowed[index] = false
            result.requirement = "lower box"
    int best_points = -1
    for 0 <= int box < 13
        if not result.allowed[box]
            continue
        int score = 0
        if box < 6
            score = (box + 1) * counts[box]
        elif box == 6 or box == 7
            score = if largest >= box - 3 then total else 0
        elif box == 8
            score = if result.joker or (largest == 3 and len([for int frequency = counts[] if frequency == 2 then frequency]) > 0) then 25 else 0
        elif box == 9 or box == 10
            int length = box - 5
            for 0 <= int start <= 6 - length
                if len([for int frequency = counts[start:<start + length][] if frequency > 0 then frequency]) == nat(length)
                    score = if box == 9 then 30 else 40
            if result.joker
                score = if box == 9 then 30 else 40
        elif box == 11
            score = if largest == 5 then 50 else 0
        else
            score = total
        result.points[box] = score
        if score > best_points
            best_points = score
            result.best = box
    return result

class Turn(int player)
    int rolls = 0
    int[] dice = []
    bool[] holds = array(5, fill = false)

class ScoreEntry(Turn turn, int category, int points, int yahtzee_bonus, bool joker)
class RedoEntry(Turn resume, ScoreEntry score)

class Game(int state, Player[] players, Rules rules, bool silent = false)
    Turn turn = Turn(0)
    int[] loaded = []
    int[] face_totals = array(6, fill = 0)
    ScoreEntry[] entries = []
    RedoEntry[] redo = []

void game_emit(const Game table, string text)
    if not table.silent
        emit(text)

void | error turn_check(const Game table)
    if table.turn.player < 0
        return error("game over")
    return void

void | error rolled_check(const Game table)
    try turn_check(table)
    if table.turn.rolls == 0
        return error("not rolled")
    return void

void | error rolls_left_check(const Game table)
    try rolled_check(table)
    if table.turn.rolls == table.rules.rolls
        return error("no rolls left")
    return void

string turn_text(const Game table)
    if table.turn.player < 0
        return "game over"
    Player player = table.players[table.turn.player]
    return "turn {player_round(player)} {player.name}"

void roll_dice(Game &table)
    if table.turn.rolls == 0
        table.turn.dice = array(5, fill = 0)
    for 0 <= int die < 5
        if table.turn.holds[die]
            continue
        int face
        if len(table.loaded) > 0
            face = table.loaded[0]
            table.loaded = table.loaded[1:]
        else
            table.state = table.state * 48271 % 2147483647
            face = table.state % 6 + 1
        table.turn.dice[die] = face
        table.face_totals[face - 1] += 1
    table.turn.rolls += 1
    table.redo = []
    game_emit(table, "{table.players[table.turn.player].name} roll {table.turn.rolls}: {faces_text(table.turn.dice)}")

void set_holds(Game &table, const bool[] marks)
    table.turn.holds = marks
    table.redo = []
    game_emit(table, "{table.players[table.turn.player].name} holds {pattern_text(marks)}: {faces_text(held_faces(table.turn.dice, marks))}")

ScoreEntry score_details(const Game table, int category)
    Player player = table.players[table.turn.player]
    int[] counts = face_counts(table.turn.dice)
    CandidateScores options = candidates(player, counts, table.rules.joker)
    int bonus = if math.max_all(counts) == 5 and player.boxes[11] == 50 then 100 else 0
    return ScoreEntry(table.turn, category, options.points[category], bonus, options.joker)

void | error score_check(const Game table, int category)
    try rolled_check(table)
    Player player = table.players[table.turn.player]
    if player.boxes[category] >= 0
        return error(category_names()[category] + " already used")
    CandidateScores options = candidates(player, face_counts(table.turn.dice), table.rules.joker)
    if not options.allowed[category]
        return error("joker requires " + options.requirement)
    return void

string score_text(const Game table, const ScoreEntry entry, bool hypothetical = false)
    Player player = table.players[entry.turn.player]
    int upper = upper_subtotal(player)
    int after = upper + (if entry.category < 6 then entry.points else 0)
    int added_upper = if upper < 63 and after >= 63 then 35 else 0
    string verb = if hypothetical then "would score" else "scores"
    string text = "{player.name} {verb} {entry.points} in {category_names()[entry.category]}"
    if entry.joker
        text += " joker"
    if entry.yahtzee_bonus > 0
        text += " ybonus 100"
    if added_upper > 0
        text += " ubonus 35"
    return text + " total {player_total(player) + entry.points + entry.yahtzee_bonus + added_upper}"

void enter_score(Game &table, int category)
    ScoreEntry entry = score_details(table, category)
    game_emit(table, score_text(table, entry))
    table.players[entry.turn.player].boxes[category] = entry.points
    table.players[entry.turn.player].yahtzee_bonus += entry.yahtzee_bonus
    table.entries = table.entries.append(entry)
    table.redo = []
    int next = if len(table.entries) == 13 * len(table.players) then -1 else (entry.turn.player + 1) % int(len(table.players))
    table.turn = Turn(next)
    game_emit(table, turn_text(table))

bool[] bot_holds(string strategy, const int[] dice)
    if strategy == "HIGH"
        return [for int face = dice[] then face >= 5]
    int[] counts = face_counts(dice)
    if strategy == "STRAIGHT"
        int best_start = 0
        int best_length = 0
        for 0 <= int start < 6
            int length = 0
            while start + length < 6 and counts[start + length] > 0
                length += 1
            if length >= best_length
                best_start = start
                best_length = length
        if best_length >= 3
            bool[] marks = array(5, fill = false)
            for best_start + 1 <= int face <= best_start + best_length
                for nat index = dice.indices()[]
                    if dice[index] == face
                        marks[index] = true
                        break
            return marks
    int target = most_frequent(counts) + 1
    return [for int face = dice[] then face == target]

void bot_turn(Game &table)
    if table.turn.rolls == 0
        roll_dice(&table)
    string strategy = table.players[table.turn.player].strategy
    while table.turn.rolls < table.rules.rolls
        bool[] marks = bot_holds(strategy, table.turn.dice)
        if held_count(marks) == 5
            break
        set_holds(&table, marks)
        roll_dice(&table)
    int[] counts = face_counts(table.turn.dice)
    CandidateScores options = candidates(table.players[table.turn.player], counts, table.rules.joker)
    int face = most_frequent(counts)
    int category = if strategy == "UPPER" and counts[face] >= 3 and options.allowed[face] then face else options.best
    enter_score(&table, category)

class Outcome(int[] counts, int weight)

void collect_outcomes(int total, int remaining, int face, int[] &counts, Outcome[] &outcomes)
    if face == 5
        counts[face] = remaining
        int[] factorials = [1, 1, 2, 6, 24, 120]
        int divisor = 1
        for int count = counts[]
            divisor *= factorials[count]
        outcomes = outcomes.append(Outcome(counts, factorials[total] / divisor))
        return
    for 0 <= int count <= remaining
        counts[face] = count
        collect_outcomes(total, remaining - count, face + 1, &counts, &outcomes)

Outcome[] distribution(int total)
    int[] counts = array(6, fill = 0)
    Outcome[] outcomes = []
    collect_outcomes(total, total, 0, &counts, &outcomes)
    return outcomes

int count_key(const int[] counts)
    return math.sum(counts * [7776, 1296, 216, 36, 6, 1])

bool is_subset(const int[] held, const int[] full)
    for int kept = held[], int available = full[]
        if kept > available
            return false
    return true

class RollTables()
    Outcome[][] outcomes = []
    int[][] held = []
    int[][] full = []
    int[] held_index = array(46656, fill = -1)
    int[][] next_states = []
    int[][] weights = []
    int[][] subsets = []

RollTables make_tables()
    auto tables = RollTables()
    for 0 <= int count < 6
        Outcome[] outcomes = distribution(count)
        tables.outcomes = tables.outcomes.append(outcomes)
        tables.held = tables.held.concat([for Outcome outcome = outcomes[] then outcome.counts])
    tables.full = [for Outcome outcome = tables.outcomes[5][] then outcome.counts]
    int[] full_index = array(46656, fill = -1)
    for nat index = tables.full.indices()[]
        full_index[count_key(tables.full[index])] = int(index)
    for nat index = tables.held.indices()[]
        tables.held_index[count_key(tables.held[index])] = int(index)
    for int[] held = tables.held[]
        int kept = math.sum(held)
        Outcome[] outcomes = tables.outcomes[5 - kept]
        tables.next_states = tables.next_states.append([for Outcome outcome = outcomes[] then full_index[count_key(held + outcome.counts)]])
        tables.weights = tables.weights.append([for Outcome outcome = outcomes[] then outcome.weight * 6 ^ kept])
    for int[] full = tables.full[]
        tables.subsets = tables.subsets.append([for nat index = tables.held.indices()[] if is_subset(tables.held[index], full) then int(index)])
    return tables

void print_odds(const Game table, const RollTables tables, const bool[] marks)
    int[] held = face_counts(held_faces(table.turn.dice, marks))
    int kept = math.sum(held)
    int denominator = 6 ^ (5 - kept)
    Player player = table.players[table.turn.player]
    int[] totals = array(13, fill = 0)
    int[] chances = array(13, fill = 0)
    int best_total = 0
    for Outcome outcome = tables.outcomes[5 - kept][]
        CandidateScores options = candidates(player, held + outcome.counts, table.rules.joker)
        totals += outcome.weight * options.points
        chances += outcome.weight * [for int value = options.points[] then if value > 0 then 1 else 0]
        best_total += outcome.weight * options.points[options.best]
    emit("odds {pattern_text(marks)} outcomes {denominator}")
    string[] names = category_names()
    for 0 <= int category < 13
        if player.boxes[category] < 0
            emit("{names[category]} expect {fraction(totals[category], denominator)} chance {fraction(chances[category], denominator)}")
    emit("best expect {fraction(best_total, denominator)}")

void print_advice(const Game table, const RollTables tables)
    Player player = table.players[table.turn.player]
    int[] values = []
    for int[] counts = tables.full[]
        CandidateScores options = candidates(player, counts, table.rules.joker)
        values = values.append(options.points[options.best])
    int remaining = table.rules.rolls - table.turn.rolls
    int[] expected = []
    for 0 <= int depth < remaining
        expected = []
        for nat index = tables.held.indices()[]
            int[] next = [for int state = tables.next_states[index][] then values[state]]
            expected = expected.append(math.sum(tables.weights[index] * next))
        if depth + 1 < remaining
            values = [for int[] subset = tables.subsets[] then math.max_all([for int index = subset[] then expected[index]])]
    int maximum = -1
    bool[] chosen = array(5, fill = false)
    for 0 <= int mask < 32
        bool[] marks = [for 0 <= int index < 5 then mask / (2 ^ (4 - index)) % 2 == 1]
        int index = tables.held_index[count_key(face_counts(held_faces(table.turn.dice, marks)))]
        int expectation = expected[index]
        if expectation > maximum
            maximum = expectation
            chosen = marks
    emit("advise {pattern_text(chosen)}: {faces_text(held_faces(table.turn.dice, chosen))} expect {fraction(maximum, 7776 ^ remaining)}")

int[] ranked_indices(const int[] values)
    int width = int(len(values)) + 1
    int maximum = math.max_all(values)
    int[] keys = [for nat index = values.indices()[] then (maximum - values[index]) * width + int(index)]
    return keys.sorted() % width

void card_row(string heading, const Player[] players, const string[] cells)
    string text = heading + string.repeat(" ", nat(9 - int(len(heading))))
    for nat index = players.indices()[]
        int width = math.max(4, int(len(players[index].name)))
        text += " " + string.repeat(" ", nat(math.max(0, width - int(len(cells[index]))))) + cells[index]
    emit(text)

void print_card(const Game table)
    card_row("CATEGORY", table.players, [for Player player = table.players[] then player.name])
    string[] names = category_names()
    for 0 <= int category < 13
        card_row(names[category], table.players, [for Player player = table.players[] then if player.boxes[category] < 0 then "-" else "{player.boxes[category]}"])
    card_row("UPPER", table.players, [for Player player = table.players[] then "{upper_subtotal(player)}"])
    card_row("BONUS", table.players, [for Player player = table.players[] then if upper_subtotal(player) >= 63 then "35" else "0"])
    card_row("YBONUS", table.players, [for Player player = table.players[] then "{player.yahtzee_bonus}"])
    card_row("TOTAL", table.players, [for Player player = table.players[] then "{player_total(player)}"])

void print_stats(const Game table)
    for nat seat = table.players.indices()[]
        ScoreEntry[] entries = [for ScoreEntry entry = table.entries[] if entry.turn.player == int(seat) then entry]
        int turns = int(len(entries))
        int rolls = math.sum([for ScoreEntry entry = entries[] then entry.turn.rolls])
        int zeros = int(len([for ScoreEntry entry = entries[] if entry.points == 0 then entry]))
        int yahtzees = int(len([for ScoreEntry entry = entries[] if math.max_all(face_counts(entry.turn.dice)) == 5 then entry]))
        int total = math.sum([for ScoreEntry entry = entries[] then entry.points])
        emit("stats {table.players[seat].name} turns {turns} rolls {rolls} zeros {zeros} yahtzees {yahtzees} average {average(total, turns)}")

class Record()
    int games = 0
    int wins = 0
    int best = 0
    int total = 0

Record get_record(const map.Map<string, Record> records, string name)
    match records.get(name)
        Record found
            return found
        none
            return Record()

void record_game(map.Map<string, Record> &records, const Game table)
    int[] totals = [for Player player = table.players[] then player_total(player)]
    int winner = ranked_indices(totals)[0]
    for nat seat = table.players.indices()[]
        string name = table.players[seat].name
        Record record = get_record(records, name)
        record.games += 1
        record.wins += if int(seat) == winner then 1 else 0
        record.best = math.max(record.best, totals[seat])
        record.total += totals[seat]
        .records.set(name, record)

void print_records(const map.Map<string, Record> records)
    string[] names = records.keys().sorted()
    if len(names) == 0
        emit("no records")
        return
    int maximum_best = math.max_all([for string name = names[] then get_record(records, name).best])
    int[] priorities = [for string name = names[] then get_record(records, name).wins * (maximum_best + 1) + get_record(records, name).best]
    for int index = ranked_indices(priorities)[]
        string name = names[index]
        Record record = get_record(records, name)
        emit("record {name} games {record.games} wins {record.wins} best {record.best} average {average(record.total, record.games)}")

class SimulationTotal()
    int wins = 0
    int total = 0
    int best = 0
    int bonus = 0
    int yahtzee = 0

void simulate(int seed, int count, const string[] strategies, const Rules rules)
    SimulationTotal[] totals = array(len(strategies), fill = SimulationTotal())
    string[] names = ["A", "B", "C", "D", "E", "F"]
    int generator = seed
    for 0 <= int game_number < count
        Player[] players = [for nat seat = strategies.indices()[] then Player(names[seat], strategies[seat])]
        auto table = Game(generator, players, rules, true)
        while table.turn.player >= 0
            bot_turn(&table)
        generator = table.state
        int[] scores = [for Player player = table.players[] then player_total(player)]
        totals[ranked_indices(scores)[0]].wins += 1
        for nat seat = strategies.indices()[]
            totals[seat].total += scores[seat]
            totals[seat].best = math.max(totals[seat].best, scores[seat])
            totals[seat].bonus += if upper_subtotal(table.players[seat]) >= 63 then 1 else 0
            totals[seat].yahtzee += if table.players[seat].boxes[11] == 50 then 1 else 0
    emit("sim seed {seed} games {count} players {len(strategies)}")
    for nat seat = strategies.indices()[]
        SimulationTotal result = totals[seat]
        emit("seat {seat + 1} {strategies[seat]} wins {result.wins} average {average(result.total, count)} best {result.best} bonus {result.bonus} yahtzee {result.yahtzee}")

class Program(RollTables tables)
    Rules rules = Rules()
    Game | none game = none
    map.Map<string, Record> records = map.Map<string, Record>()

Game | error require_game(const Program program)
    match program.game
        Game table
            return table
        none
            return error("no game")

void | error game_command(Program &program, const string[] tokens)
    string op = tokens[0]
    string name = ""
    string strategy = ""
    int count = 0
    int category = 0
    int[] faces = []
    bool[] marks = []
    if op == "BOT"
        name = try player_name(tokens[1])
        strategy = try strategy_word(tokens[2])
    elif op == "LOAD" or op == "KEEP"
        faces = try face_words(tokens[1:])
    elif op == "HOLD" or op == "ODDS"
        marks = try hold_pattern(tokens[1])
    elif op == "SCORE" or op == "WHATIF"
        category = try category_word(tokens[1])
    elif op == "AUTO"
        count = try integer_word(tokens[1], 1, 100)
    Game table = try require_game(program)
    if op == "BOT"
        int seat = -1
        for nat index = table.players.indices()[]
            if table.players[index].name == name
                seat = int(index)
        if seat < 0
            return error("no player " + name)
        table.players[seat].strategy = strategy
        emit("bot {name} {strategy}")
    elif op == "LOAD"
        table.loaded = table.loaded.concat(faces)
        emit("loaded {len(table.loaded)}")
    elif op == "ROLL"
        try turn_check(table)
        if table.turn.rolls == table.rules.rolls
            return error("no rolls left")
        if held_count(table.turn.holds) == 5
            return error("all dice held")
        roll_dice(&table)
    elif op == "HOLD"
        try rolls_left_check(table)
        set_holds(&table, marks)
    elif op == "KEEP"
        try rolls_left_check(table)
        marks = array(5, fill = false)
        for int face = faces[]
            int chosen = -1
            for 0 <= int die < 5
                if not marks[die] and table.turn.dice[die] == face
                    chosen = die
                    break
            if chosen < 0
                return error("not showing {face}")
            marks[chosen] = true
        set_holds(&table, marks)
    elif op == "SCORE" or op == "WHATIF"
        try score_check(table, category)
        if op == "WHATIF"
            emit(score_text(table, score_details(table, category), true))
        else
            enter_score(&table, category)
    elif op == "UNDO"
        if len(table.entries) == 0
            return error("nothing to undo")
        ScoreEntry entry = table.entries[len(table.entries) - 1]
        table.entries = table.entries[0:<int(len(table.entries)) - 1]
        table.redo = table.redo.append(RedoEntry(table.turn, entry))
        table.players[entry.turn.player].boxes[entry.category] = -1
        table.players[entry.turn.player].yahtzee_bonus -= entry.yahtzee_bonus
        table.turn = entry.turn
        emit("undo {table.players[entry.turn.player].name} {category_names()[entry.category]} {entry.points}")
    elif op == "REDO"
        if len(table.redo) == 0
            return error("nothing to redo")
        RedoEntry saved = table.redo[len(table.redo) - 1]
        table.redo = table.redo[0:<int(len(table.redo)) - 1]
        ScoreEntry entry = saved.score
        table.players[entry.turn.player].boxes[entry.category] = entry.points
        table.players[entry.turn.player].yahtzee_bonus += entry.yahtzee_bonus
        table.entries = table.entries.append(entry)
        table.turn = saved.resume
        emit("redo {table.players[entry.turn.player].name} {category_names()[entry.category]} {entry.points}")
    elif op == "SUGGEST"
        try rolled_check(table)
        Player player = table.players[table.turn.player]
        CandidateScores options = candidates(player, face_counts(table.turn.dice), table.rules.joker)
        string[] names = category_names()
        string text = "suggest"
        for 0 <= int box < 13
            if player.boxes[box] < 0
                text += " {names[box]} {options.points[box]}"
        emit(text + " best {names[options.best]} {options.points[options.best]}")
    elif op == "ODDS"
        try rolls_left_check(table)
        print_odds(table, program.tables, marks)
    elif op == "ADVISE"
        try rolls_left_check(table)
        print_advice(table, program.tables)
    elif op == "AUTO"
        try turn_check(table)
        table.redo = []
        for 0 <= int iteration < count
            if table.turn.player < 0
                break
            bot_turn(&table)
    elif op == "STATUS"
        if table.turn.player < 0
            emit("status game over")
        else
            Player player = table.players[table.turn.player]
            emit("status round {player_round(player)} player {player.name} rolls {table.turn.rolls} dice {faces_text(table.turn.dice)} holds {pattern_text(table.turn.holds)}")
    elif op == "CARD"
        print_card(table)
    elif op == "BONUS"
        for Player player = table.players[]
            int upper = upper_subtotal(player)
            int maximum = upper + math.sum([for 0 <= int face < 6 if player.boxes[face] < 0 then 5 * (face + 1)])
            string status = if upper >= 63 then "made" elif maximum < 63 then "lost" else "open"
            emit("bonus {player.name} upper {upper} need {math.max(63 - upper, 0)} max {maximum} {status}")
    elif op == "STATS"
        print_stats(table)
    elif op == "LOG"
        if len(table.entries) == 0
            emit("no scores")
        for nat index = table.entries.indices()[]
            ScoreEntry entry = table.entries[index]
            string text = "log {index + 1} {table.players[entry.turn.player].name} {faces_text(entry.turn.dice)} {category_names()[entry.category]} {entry.points}"
            if entry.joker
                text += " joker"
            if entry.yahtzee_bonus > 0
                text += " ybonus 100"
            emit(text)
    elif op == "FACES"
        int total = math.sum(table.face_totals)
        string chi = if total == 0 then "0" else fraction(6 * math.sum(table.face_totals * table.face_totals) - total * total, total)
        emit("faces {faces_text(table.face_totals)} total {total} chi2 {chi}")
    elif op == "STANDINGS" or op == "END"
        int[] totals = [for Player player = table.players[] then player_total(player)]
        int[] order = ranked_indices(totals)
        bool finished = table.turn.player < 0
        if op == "END"
            emit(if finished then "end final" else "end abandoned")
        for nat rank = order.indices()[]
            int seat = order[rank]
            if op == "STANDINGS"
                emit("standing {rank + 1} {table.players[seat].name} {totals[seat]} behind {totals[order[0]] - totals[seat]}")
            else
                emit("rank {rank + 1} {table.players[seat].name} {totals[seat]}")
        if op == "END"
            if finished
                record_game(&program.records, table)
            program.game = none
            return void
    program.game = table
    return void

void | error command(Program &program, const string[] tokens)
    string op = tokens[0]
    string[] commands = ["RULE", "GAME", "BOT", "LOAD", "ROLL", "HOLD", "KEEP", "SCORE", "WHATIF", "UNDO", "REDO", "SUGGEST", "ODDS", "ADVISE", "AUTO", "STATUS", "CARD", "BONUS", "STATS", "LOG", "FACES", "STANDINGS", "END", "RECORDS", "SIM"]
    if not includes(commands, op)
        return error("unknown command " + op)
    if op == "RULE"
        string rule = tokens[1]
        string value = tokens[2]
        Rules changed = program.rules
        if rule == "ROLLS"
            changed.rolls = try integer_word(value, 1, 4)
        elif rule == "JOKER"
            if not includes(["FORCED", "FREE", "OFF"], value)
                return error("bad value " + value)
            changed.joker = value
        else
            return error("unknown rule " + rule)
        match program.game
            Game
                return error("game in progress")
            none
                program.rules = changed
        emit("rule {rule} {value}")
    elif op == "GAME"
        int seed = try integer_word(tokens[1], 1, 2147483646)
        string[] names = tokens[2:]
        for string name = names[]
            try player_name(name)
        if len(names) > 6
            return error("too many players")
        match program.game
            Game
                return error("game in progress")
            none
                string[] seen = []
                for string name = names[]
                    if includes(seen, name)
                        return error("duplicate name " + name)
                    seen = seen.append(name)
        Player[] players = [for string name = names[] then Player(name)]
        program.game = Game(seed, players, program.rules)
        emit("game seed {seed} players {names.join(" ")}")
        emit("turn 1 {names[0]}")
    elif op == "RECORDS"
        print_records(program.records)
    elif op == "SIM"
        int seed = try integer_word(tokens[1], 1, 2147483646)
        int count = try integer_word(tokens[2], 1, 50)
        string[] strategies = []
        for string token = tokens[3:][]
            string strategy = try strategy_word(token)
            strategies = strategies.append(strategy)
        if len(strategies) > 6
            return error("too many players")
        simulate(seed, count, strategies, program.rules)
    else
        try game_command(&program, tokens)
    return void

string count_line
scan(&count_line)
int command_count = int.parse(count_line)
auto program = Program(make_tables())
for 0 <= int command_number < command_count
    string line
    scan(&line)
    match command(&program, line.split(" "))
        void
            continue
        error problem
            emit("error: " + problem.message)
