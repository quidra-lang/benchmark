import math

const string uppercase_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const string lowercase_letters = "abcdefghijklmnopqrstuvwxyz"
const string decimal_digits = "0123456789"

enum Style
    APA
    IEEE
    Chicago
    MLA

string[] known_fields()
    return "author editor title journal booktitle edition volume number pages publisher institution school address howpublished month year doi note".split(" ")

string[] entry_types()
    return "article book inproceedings incollection techreport phdthesis misc".split(" ")

string[] required_fields(string kind)
    if kind == "article"
        return ["author", "title", "journal", "year"]
    if kind == "book"
        return ["author", "title", "publisher", "year"]
    if kind == "inproceedings"
        return ["author", "title", "booktitle", "year"]
    if kind == "incollection"
        return ["author", "title", "booktitle", "publisher", "year"]
    if kind == "techreport"
        return ["author", "title", "institution", "year"]
    if kind == "phdthesis"
        return ["author", "title", "school", "year"]
    return ["author", "title", "year"]

string[] months()
    return "January February March April May June July August September October November December".split(" ")

bool includes<T>(const T[] values, T sought)
    for T item = values[]
        if item == sought
            return true
    return false

int find_index(string text, string needle)
    match text.find(needle)
        nat position
            return int(position)
        none
            return -1

string map_text(const map.Map<string, string> fields, string name)
    match fields.get(name)
        string value
            return value
        none
            return ""

int map_count(const map.Map<string, int> counts, string key)
    match counts.get(key)
        int value
            return value
        none
            return 0

bool letter(string character)
    return len(character) == 1 and (uppercase_letters + lowercase_letters).contains(character)

bool all_digits(string text)
    if len(text) == 0
        return false
    for nat index < len(text)
        if not decimal_digits.contains(text[index])
            return false
    return true

string letter_case(string text, bool upper)
    string result = ""
    int[] points = text.codepoints()
    for nat index < len(points)
        int point = points[index]
        if upper and 97 <= point <= 122
            result += uppercase_letters[point - 97]
        elif not upper and 65 <= point <= 90
            result += lowercase_letters[point - 65]
        else
            result += text[index]
    return result

string plain(string text)
    string result = ""
    for nat index < len(text)
        if text[index] != "{{" and text[index] != "}}"
            result += text[index]
    return result

string letters_only(string text)
    string result = ""
    for nat index < len(text)
        if letter(text[index])
            result += text[index]
    return letter_case(result, false)

bool small_word(string text)
    return includes("a an and as at but by for from in into nor of on or over per so the to up via with yet".split(" "), text)

string[] split_depth(string text, string delimiter)
    string[] parts = []
    int depth = 0
    int start = 0
    int position = 0
    while position < int(len(text))
        if depth == 0 and text[position:].starts_with(delimiter)
            parts = parts.append(text[start:<position])
            position += int(len(delimiter))
            start = position
        else
            if text[position] == "{{"
                depth += 1
            elif text[position] == "}}"
                depth -= 1
            position += 1
    return parts.append(text[start:])

string | error evaluate(string expression, const map.Map<string, string> macros)
    int depth = 0
    for nat index < len(expression)
        if expression[index] == "{{"
            depth += 1
        elif expression[index] == "}}"
            depth -= 1
        if depth < 0
            return error("unbalanced braces")
    if depth != 0
        return error("unbalanced braces")
    string result = ""
    for string term = expression.split(" # ")[]
        if term.starts_with("{{") or term.starts_with(DQ)
            result += term[1:<int(len(term)) - 1]
        elif all_digits(term)
            result += term
        else
            match macros.get(term)
                string value
                    result += value
                none
                    return error("unknown macro '{term}'")
    return result

class Accent(string character, int width)

Accent | none accent_at(string text, int position)
    if position + 1 >= int(len(text)) or text[position] != "\"
        return none
    string command = text[position + 1]
    if command == "&"
        return Accent("&", 2)
    bool symbol = ("'`^~=." + DQ).contains(command)
    if symbol and position + 2 < int(len(text)) and letter(text[position + 2])
        return Accent(text[position + 2], 3)
    if (symbol or "cuvH".contains(command)) and position + 4 < int(len(text))
        if text[position + 2] == "{{" and letter(text[position + 3]) and text[position + 4] == "}}"
            return Accent(text[position + 3], 5)
    return none

string normalize(string text)
    string result = ""
    int position = 0
    while position < int(len(text))
        bool wrapped = false
        if text[position] == "{{"
            match accent_at(text, position + 1)
                Accent enclosed
                    int closing = position + enclosed.width + 1
                    if closing < int(len(text)) and text[closing] == "}}"
                        result += enclosed.character
                        position = closing + 1
                        wrapped = true
                none
                    wrapped = false
        if wrapped
            continue
        match accent_at(text, position)
            Accent found
                result += found.character
                position += found.width
            none
                result += if text[position] == "~" then " " else text[position]
                position += 1
    string[] words = []
    for string word = result.split(" ")[]
        if word != ""
            words = words.append(word)
    return words.join(" ")

class Person(string first = "", string von = "", string last = "", string junior = "")

class NameList(Person[] names = [], bool etal = false)

Person parse_person(string text)
    string[] parts = [for string part = split_depth(text, ",")[] then part.trim()]
    string[] words = split_depth(parts[0], " ")
    int[] lowercase = []
    for 0 <= int index < int(len(words)) - 1
        if lowercase_letters.contains(words[index][0])
            lowercase = lowercase.append(index)
    auto person = Person()
    if len(parts) == 1
        int start = if len(lowercase) == 0 then int(len(words)) - 1 else lowercase[0]
        int finish = if len(lowercase) == 0 then start else lowercase[len(lowercase) - 1] + 1
        person.first = words[0:<start].join(" ")
        person.von = words[start:<finish].join(" ")
        person.last = words[finish:].join(" ")
    else
        int finish = if len(lowercase) == 0 then 0 else lowercase[len(lowercase) - 1] + 1
        person.von = words[0:<finish].join(" ")
        person.last = words[finish:].join(" ")
        person.first = parts[len(parts) - 1]
        if len(parts) == 3
            person.junior = parts[1]
    return person

NameList parse_names(string text)
    string[] parts = split_depth(text, " and ")
    bool etal = parts[len(parts) - 1] == "others"
    if etal
        parts = parts[0:<int(len(parts)) - 1]
    return NameList([for string part = parts[] then parse_person(part)], etal)

bool singular(const NameList names)
    return len(names.names) == 1 and not names.etal

string surname(const Person person)
    return plain((if person.von == "" then "" else person.von + " ") + person.last)

string initials(string given)
    string unprotected = plain(given)
    if unprotected == ""
        return ""
    string[] result = []
    for string word = unprotected.split(" ")[]
        string[] pieces = []
        for string piece = word.split("-")[]
            string letters = letters_only(piece)
            pieces = pieces.append(letter_case(letters[0], true) + ".")
        result = result.append(pieces.join("-"))
    return result.join(" ")

string name_text(const Person person, bool inverted, bool abbreviated)
    string given = if abbreviated then initials(person.first) else plain(person.first)
    string result = surname(person)
    if person.first != ""
        result = if inverted then result + ", " + given else given + " " + result
    if person.junior != ""
        result += ", " + plain(person.junior)
    return result

class Entry(string key, string kind, map.Map<string, string> fields)
    NameList primary = NameList()
    NameList | none editors = none
    string sort_title = ""
    string bibliography_key = ""
    string suffix = ""

string field(const Entry entry, string name)
    return map_text(entry.fields, name)

Entry make_entry(string key, string kind, const map.Map<string, string> fields)
    auto entry = Entry(key, kind, fields)
    if fields.has("editor")
        entry.editors = parse_names(map_text(fields, "editor"))
    entry.primary = parse_names(map_text(fields, if fields.has("author") then "author" else "editor"))
    entry.sort_title = letter_case(plain(field(entry, "title")), false)
    for string article = ["a ", "an ", "the "][]
        if entry.sort_title.starts_with(article)
            entry.sort_title = entry.sort_title[int(len(article)):]
            break
    // HT precedes every allowed input character, preserving tuple prefix order.
    entry.bibliography_key = letter_case(plain(entry.primary.names[0].last), false) + HT + plain(field(entry, "year")) + HT + entry.sort_title + HT + key
    return entry

int[] ordered_entries(const Entry[] entries, const int[] indices, bool title_only = false)
    map.Map<string, int> positions
    for int index = indices[]
        string key = if title_only then entries[index].sort_title + HT + entries[index].key else entries[index].bibliography_key
        .positions.set(key, index)
    return [for string key = positions.keys().sorted()[] then map_count(positions, key)]

class Database()
    Entry[] entries = []
    map.Map<string, int> lookup = map.Map<string, int>()
    int[] bibliography = []
    int[] record = []

void emit(string text)
    print(text + NL)

Database read_database(const string[] lines)
    auto database = Database()
    map.Map<string, string> macros
    string[] macro_names = "jan feb mar apr may jun jul aug sep oct nov dec".split(" ")
    string[] month_values = months()
    for nat index < len(macro_names)
        .macros.set(macro_names[index], month_values[index])
    int errors = 0
    int position = 0
    while position < int(len(lines))
        string line = lines[position]
        if line == "" or line.starts_with("%")
            position += 1
            continue
        int error_line = position + 1
        string reason = ""
        string name = ""
        if line.starts_with("@string{{")
            int separator = find_index(line, " = ")
            name = line[8:<separator]
            string expression = line[separator + 3:<int(len(line)) - 1]
            match evaluate(expression, macros)
                string value
                    if macros.has(name)
                        reason = "duplicate macro"
                    else
                        .macros.set(name, value)
                error problem
                    reason = problem.message
        else
            int opening = find_index(line, "{{")
            string kind = line[1:<opening]
            name = line[opening + 1:<int(len(line)) - 1]
            map.Map<string, string> fields
            if not includes(entry_types(), kind)
                reason = "unknown type '{kind}'"
            elif database.lookup.has(name)
                reason = "duplicate key"
            position += 1
            while lines[position] != "}}"
                if reason == ""
                    string field_line = lines[position]
                    int separator = find_index(field_line, " = ")
                    string field_name = field_line[2:<separator]
                    int finish = int(len(field_line)) - (if field_line.ends_with(",") then 1 else 0)
                    match evaluate(field_line[separator + 3:<finish], macros)
                        string value
                            if fields.has(field_name)
                                reason = "duplicate field '{field_name}'"
                            else
                                .fields.set(field_name, normalize(value))
                        error problem
                            reason = problem.message
                    if reason != ""
                        error_line = position + 1
                position += 1
            if reason == ""
                for string required = required_fields(kind)[]
                    if fields.has(required) or (kind == "book" and required == "author" and fields.has("editor"))
                        continue
                    reason = "missing field '{required}'"
                    error_line = position + 1
                    break
            if reason == ""
                .database.lookup.set(name, int(len(database.entries)))
                database.entries = database.entries.append(make_entry(name, kind, fields))
        if reason != ""
            errors += 1
            emit("ERROR line {error_line}: {name}: {reason}")
        position += 1
    emit("LOADED entries={len(database.entries)} macros={macros.size() - 12} errors={errors}")
    database.bibliography = ordered_entries(database.entries, [for nat index < len(database.entries) then int(index)])
    bool[] assigned = array(len(database.entries), fill = false)
    for nat index < len(database.entries)
        if assigned[index]
            continue
        int[] group = []
        for nat candidate < len(database.entries)
            if database.entries[index].primary == database.entries[candidate].primary and field(database.entries[index], "year") == field(database.entries[candidate], "year")
                group = group.append(int(candidate))
                assigned[candidate] = true
        if len(group) > 1
            group = ordered_entries(database.entries, group, true)
            for nat suffix_index < len(group)
                database.entries[group[suffix_index]].suffix = lowercase_letters[suffix_index]
    return database

string list_names(const string[] names, string conjunction, bool list_b = false)
    if len(names) == 1
        return names[0]
    if list_b and len(names) == 2
        return "{names[0]} {conjunction} {names[1]}"
    return names[0:<int(len(names)) - 1].join(", ") + ", " + conjunction + " " + names[len(names) - 1]

string author_names(const NameList list, Style style)
    string[] forms = []
    for nat index < len(list.names)
        bool inverted = style == Style.APA or ((style == Style.Chicago or style == Style.MLA) and index == 0)
        forms = forms.append(name_text(list.names[index], inverted, style == Style.APA or style == Style.IEEE))
    if style == Style.APA
        if list.etal
            return forms.join(", ") + ", et al."
        if len(forms) >= 21
            return forms[0:<19].join(", ") + ", . . . " + forms[len(forms) - 1]
        return list_names(forms, "&")
    if style == Style.IEEE
        return if list.etal or len(forms) >= 7 then forms[0] + " et al." else list_names(forms, "and", true)
    if style == Style.Chicago
        return if list.etal or len(forms) >= 11 then forms[0:<math.min(7, int(len(forms)))].join(", ") + ", et al." else list_names(forms, "and")
    return if list.etal or len(forms) >= 3 then forms[0] + ", et al." else list_names(forms, "and")

string editor_names(const NameList list, Style style)
    string[] forms = [for Person person = list.names[] then name_text(person, false, style == Style.APA or style == Style.IEEE)]
    return if list.etal then forms[0] + " et al." else list_names(forms, if style == Style.APA then "&" else "and", true)

string year_label(const Entry entry, Style style)
    return plain(field(entry, "year")) + (if style == Style.APA or style == Style.Chicago then entry.suffix else "")

string convert_outside(string text, int mode)
    string result = ""
    int depth = 0
    bool first_letter = true
    for nat index < len(text)
        string character = text[index]
        if letter(character)
            if depth == 0
                if mode == 0
                    character = letter_case(character, false)
                elif mode == 1
                    bool upper = index == 0 or (index >= 2 and text[index - 2:<index] == ": ")
                    character = letter_case(character, upper)
                elif first_letter
                    character = letter_case(character, true)
            first_letter = false
        if character == "{{"
            depth += 1
        elif character == "}}"
            depth -= 1
        result += character
    return result

string title_text(string title, Style style)
    if style == Style.IEEE
        return plain(title)
    if style == Style.APA
        return plain(convert_outside(title, 1))
    string[] words = split_depth(title, " ")
    string[] converted = []
    for nat index < len(words)
        string word = words[index]
        if not word.starts_with("{{")
            bool small = index > 0 and index + 1 < len(words) and not words[index - 1].ends_with(":") and small_word(letters_only(word))
            word = convert_outside(word, if small then 0 else 2)
        converted = converted.append(word)
    return plain(converted.join(" "))

int style_index(Style style)
    return if style == Style.APA then 0 elif style == Style.IEEE then 1 elif style == Style.Chicago then 2 else 3

string template_source(Style style, string kind)
    string[] templates = [
        "{{author}}. ({{year}}). {{title}}. {{journal}}<, {{volume}}<({{number}})>><, {{pages}}>.< https://doi.org/{{doi}}>",
        "{{author}}. ({{year}}). {{title}}< ({{edition}})>. {{publisher}}.",
        "{{author}}. ({{year}}). {{title}}. In <{{editor}} ({{eds}}), >{{booktitle}}< ({{pp}})>.< {{publisher}}.>",
        "{{author}}. ({{year}}). {{title}}< (Report No. {{number}})>. {{institution}}.",
        "{{author}}. ({{year}}). {{title}} [Doctoral dissertation, {{school}}].",
        "{{author}}. ({{year}}<, {{month}}>). {{title}}.< {{howpublished}}.>< {{note}}.>",
        "{{author}}, {DQ}{{title}},{DQ} {{journal}}<, vol. {{volume}}><, no. {{number}}><, {{pp}}>, <{{mon}} >{{year}}<, doi: {{doi}}>.",
        "{{author}}, {{title}}<, {{edition}}>. <{{address}}: >{{publisher}}, {{year}}.",
        "{{author}}, {DQ}{{title}},{DQ} in {{booktitle}}<, {{editor}}, {{eds}}><, {{address}}><, {{publisher}}>, {{year}}<, {{pp}}>.",
        "{{author}}, {DQ}{{title}},{DQ} {{institution}}<, {{address}}>, Tech. Rep.< {{number}}>, {{year}}.",
        "{{author}}, {DQ}{{title}},{DQ} Ph.D. dissertation, {{school}}<, {{address}}>, {{year}}.",
        "{{author}}, {DQ}{{title}},{DQ}< {{howpublished}},> <{{mon}} >{{year}}.< {{note}}.>",
        "{{author}}. {{year}}. {DQ}{{title}}.{DQ} {{journal}}< {{volume}}>< ({{number}})><: {{pages}}>.< https://doi.org/{{doi}}.>",
        "{{author}}. {{year}}. {{title}}.< {{edition}}.> <{{address}}: >{{publisher}}.",
        "{{author}}. {{year}}. {DQ}{{title}}.{DQ} In {{booktitle}}<, edited by {{editor}}><, {{pages}}>.< <{{address}}: >{{publisher}}.>",
        "{{author}}. {{year}}. {{title}}. Technical Report< {{number}}>. <{{address}}: >{{institution}}.",
        "{{author}}. {{year}}. {DQ}{{title}}.{DQ} PhD diss., {{school}}.",
        "{{author}}. {{year}}. {{title}}.< {{howpublished}}.>< {{note}}.>",
        "{{author}}. {DQ}{{title}}.{DQ} {{journal}}<, vol. {{volume}}><, no. {{number}}>, <{{mon}} >{{year}}<, {{pp}}>.< https://doi.org/{{doi}}.>",
        "{{author}}. {{title}}.< {{edition}},> {{publisher}}, {{year}}.",
        "{{author}}. {DQ}{{title}}.{DQ} {{booktitle}},< edited by {{editor}},>< {{publisher}},> {{year}}<, {{pp}}>.",
        "{{author}}. {{title}}. {{institution}}, {{year}}.< Technical Report {{number}}.>",
        "{{author}}. {{title}}. {{year}}. {{school}}, PhD dissertation.",
        "{{author}}. {{title}}.< {{howpublished}},> <{{mon}} >{{year}}.< {{note}}.>",
    ]
    int category = if kind == "article" then 0 elif kind == "book" then 1 elif kind == "inproceedings" or kind == "incollection" then 2 elif kind == "techreport" then 3 elif kind == "phdthesis" then 4 else 5
    return templates[6 * style_index(style) + category]

int optional_end(string source, int start)
    int depth = 1
    int position = start + 1
    while depth > 0
        if source[position] == "<"
            depth += 1
        elif source[position] == ">"
            depth -= 1
        position += 1
    return position - 1

bool optional_present(string source, int start, int finish, const map.Map<string, string> values)
    int position = start
    while position < finish
        if source[position] == "<"
            position = optional_end(source, position)
        elif source[position] == "{{"
            int closing = position + find_index(source[position:], "}}")
            if map_text(values, source[position + 1:<closing]) == ""
                return false
            position = closing
        position += 1
    return true

void render_template(string source, int start, int finish, const map.Map<string, string> values, string &result)
    int position = start
    while position < finish
        string character = source[position]
        if character == "<"
            int closing = optional_end(source, position)
            if optional_present(source, position + 1, closing, values)
                render_template(source, position + 1, closing, values, &result)
            position = closing
        elif character == "{{"
            int closing = position + find_index(source[position:], "}}")
            result += map_text(values, source[position + 1:<closing])
            position = closing
        elif character != "." or len(result) == 0 or not ".?!".contains(result[len(result) - 1])
            result += character
        position += 1

string edition_text(string text)
    if not all_digits(text)
        return text + " ed."
    int value = int.parse(text)
    int last = value % 10
    string suffix = if 11 <= value % 100 <= 13 then "th" elif last == 1 then "st" elif last == 2 then "nd" elif last == 3 then "rd" else "th"
    return "{value}{suffix} ed."

string reference(const Entry entry, Style style, int number, bool repeated = false)
    map.Map<string, string> values
    for string name = known_fields()[]
        .values.set(name, plain(field(entry, name)))
    .values.set("eds", "")
    .values.set("pp", "")
    .values.set("mon", "")
    string author = if repeated then "---" else author_names(entry.primary, style)
    if not entry.fields.has("author")
        string[] labels = [" (Ed.)", " (Eds.)", ", Ed.", ", Eds.", ", ed.", ", eds.", ", editor", ", editors"]
        author += labels[2 * style_index(style) + (if singular(entry.primary) then 0 else 1)]
    .values.set("author", author)
    match entry.editors
        NameList editors
            .values.set("editor", editor_names(editors, style))
            .values.set("eds", if singular(editors) then "Ed." else "Eds.")
        none
            .values.set("editor", "")
    .values.set("title", title_text(field(entry, "title"), style))
    .values.set("year", year_label(entry, style))
    if entry.fields.has("pages")
        string pages = plain(field(entry, "pages")).split("--").join("-")
        .values.set("pages", pages)
        .values.set("pp", (if pages.contains("-") then "pp. " else "p. ") + pages)
    if entry.fields.has("edition")
        .values.set("edition", edition_text(plain(field(entry, "edition"))))
    string month = plain(field(entry, "month"))
    string[] month_names = months()
    string[] abbreviations = ["Jan.", "Feb.", "Mar.", "Apr.", "May", "June", "July", "Aug.", "Sep.", "Oct.", "Nov.", "Dec."]
    for nat index < len(month_names)
        if month == month_names[index]
            month = abbreviations[index]
            break
    .values.set("mon", month)
    string source = template_source(style, entry.kind)
    string result = if style == Style.IEEE then "[{number}] " else ""
    render_template(source, 0, int(len(source)), values, &result)
    return result

class Ranking(int[] order, int[] numbers)

Ranking ieee_order(const Database database)
    int[] order = database.record
    for string key = database.lookup.keys().sorted()[]
        int index = map_count(database.lookup, key)
        if not includes(order, index)
            order = order.append(index)
    int[] numbers = array(len(database.entries), fill = 0)
    for nat index < len(order)
        numbers[order[index]] = int(index) + 1
    return Ranking(order, numbers)

string short_name(const Entry entry, Style style, bool parenthetical)
    string[] names = [for Person person = entry.primary.names[] then surname(person)]
    int threshold = if style == Style.Chicago then 4 else 3
    if entry.primary.etal or int(len(names)) >= threshold
        return names[0] + " et al."
    return list_names(names, if style == Style.APA and parenthetical then "&" else "and", true)

enum CitationKind
    Parenthetical
    Narrative
    Author
    Year

class Citation(int start, int finish, CitationKind kind, int[] entries)

string citation_text(const Database database, const Citation citation, Style style, const int[] numbers)
    bool parenthetical = citation.kind == CitationKind.Parenthetical
    string[] pieces = []
    if citation.kind == CitationKind.Author or citation.kind == CitationKind.Year or style == Style.MLA or (style == Style.IEEE and not parenthetical)
        for int index = citation.entries[]
            Entry entry = database.entries[index]
            string text = if citation.kind == CitationKind.Year then year_label(entry, style) else short_name(entry, style, false)
            if style == Style.IEEE and citation.kind == CitationKind.Narrative
                text += " [{numbers[index]}]"
            pieces = pieces.append(text)
        string result = pieces.join(if citation.kind == CitationKind.Year then ", " else "; ")
        return if style == Style.MLA and parenthetical then "({result})" else result
    if style == Style.IEEE
        int[] sorted = [for int index = citation.entries[] then numbers[index]]
        sorted = sorted.sorted()
        int position = 0
        while position < int(len(sorted))
            int finish = position + 1
            while finish < int(len(sorted)) and sorted[finish] == sorted[finish - 1] + 1
                finish += 1
            if finish - position >= 3
                pieces = pieces.append("[{sorted[position]}]-[{sorted[finish - 1]}]")
            else
                for position <= int index < finish
                    pieces = pieces.append("[{sorted[index]}]")
            position = finish
        return pieces.join(", ")
    int[] entries = if parenthetical then ordered_entries(database.entries, citation.entries) else citation.entries
    int position = 0
    while position < int(len(entries))
        string name = short_name(database.entries[entries[position]], style, parenthetical)
        int finish = position + 1
        while finish < int(len(entries)) and short_name(database.entries[entries[finish]], style, parenthetical) == name
            finish += 1
        string[] years = [for position <= int index < finish then year_label(database.entries[entries[index]], style)]
        string text = if parenthetical then name + (if style == Style.APA then ", " else " ") + years.join(", ") else name + " (" + years.join(", ") + ")"
        pieces = pieces.append(text)
        position = finish
    string result = pieces.join("; ")
    return if parenthetical then "({result})" else result

string | error cite(Database &database, Style style, string text)
    Citation[] citations = []
    int position = 0
    while position < int(len(text))
        int offset = find_index(text[position:], "\")
        if offset < 0
            break
        int start = position + offset
        int opening = start + find_index(text[start:], "{{")
        int closing = opening + find_index(text[opening:], "}}")
        string name = text[start + 1:<opening]
        CitationKind kind = if name == "citet" then CitationKind.Narrative elif name == "citeauthor" then CitationKind.Author elif name == "citeyear" then CitationKind.Year else CitationKind.Parenthetical
        int[] entries = []
        for string key = text[opening + 1:<closing].split(",")[]
            if not database.lookup.has(key)
                return error("unknown key '{key}'")
            int index = map_count(database.lookup, key)
            if not includes(entries, index)
                entries = entries.append(index)
        citations = citations.append(Citation(start, closing + 1, kind, entries))
        position = closing + 1
    // Validation finishes before any citation in this command changes numbering.
    for Citation item = citations[]
        for int index = item.entries[]
            if not includes(database.record, index)
                database.record = database.record.append(index)
    Ranking ranking = ieee_order(database)
    string result = ""
    position = 0
    for Citation item = citations[]
        result += text[position:<item.start] + citation_text(database, item, style, ranking.numbers)
        position = item.finish
    return result + text[position:]

void increment(map.Map<string, int> &counts, string key)
    .counts.set(key, map_count(counts, key) + 1)

string base_key(const Entry entry)
    string result = letters_only(plain(entry.primary.names[0].last))
    string year = field(entry, "year")
    for nat index < len(year)
        if decimal_digits.contains(year[index])
            result += year[index]
    for string word = plain(field(entry, "title")).split(" ")[]
        string letters = letters_only(word)
        if letters != "" and not small_word(letters)
            result += letters
            break
    return result

string key_suffix(int ordinal)
    if ordinal < 26
        return lowercase_letters[ordinal]
    int point = 97 + ordinal
    int[] octets = if point < 128 then [point] else [192 + point / 64, 128 + point % 64]
    string bits = ""
    for int octet = octets[]
        for 7 >= int place >= 0 step -1
            bits += if octet / (2 ^ place) % 2 == 0 then "0" else "1"
    bin encoded = bin.parse(bits)
    return string.from_utf8(encoded)

void keygen(const Database database)
    string[] bases = [for Entry entry = database.entries[] then base_key(entry)]
    map.Map<string, int> counts
    map.Map<string, int> used
    for string base = bases[]
        increment(&counts, base)
    for nat index < len(bases)
        string base = bases[index]
        string suffix = if map_count(counts, base) > 1 then key_suffix(map_count(used, base)) else ""
        increment(&used, base)
        emit(database.entries[index].key + " -> " + base + suffix)

string[] unknown_fields(const Entry entry)
    string[] unknown = []
    for string name = entry.fields.keys()[]
        if not includes(known_fields(), name)
            unknown = unknown.append(name)
    return unknown.sorted()

void check_entries(const Database database)
    int warnings = 0
    map.Map<string, string> seen_titles
    for Entry entry = database.entries[]
        string[] messages = []
        if entry.fields.has("pages")
            string pages = plain(field(entry, "pages"))
            if pages.contains("-") and not pages.contains("--")
                messages = messages.append("pages use a single hyphen")
            string[] parts = []
            for string part = pages.split("-")[]
                if part != ""
                    parts = parts.append(part)
            if len(parts) == 2 and all_digits(parts[0]) and all_digits(parts[1])
                if int.parse(parts[0]) > int.parse(parts[1])
                    messages = messages.append("pages are reversed")
        string year = plain(field(entry, "year"))
        if len(year) != 4 or not all_digits(year)
            messages = messages.append("year is not 4 digits")
        string title = plain(field(entry, "title"))
        bool has_lowercase = false
        int capitals = 0
        for nat index < len(title)
            if lowercase_letters.contains(title[index])
                has_lowercase = true
            elif uppercase_letters.contains(title[index])
                capitals += 1
        if not has_lowercase and capitals >= 2
            messages = messages.append("title is all caps")
        if entry.kind == "article" and not entry.fields.has("doi")
            messages = messages.append("article has no doi")
        string title_key = letter_case(title, false)
        match seen_titles.get(title_key)
            string prior
                messages = messages.append("same title as " + prior)
            none
                .seen_titles.set(title_key, entry.key)
        for string name = unknown_fields(entry)[]
            messages = messages.append("unknown field '{name}'")
        for string message = messages[]
            emit("WARN {entry.key}: {message}")
        warnings += int(len(messages))
    emit("CHECK warnings={warnings}")

void export_entry(const Entry entry)
    emit("@" + entry.kind + "{{" + entry.key + ",")
    string[] names = []
    for string name = known_fields()[]
        if entry.fields.has(name)
            names = names.append(name)
    names = names.concat(unknown_fields(entry))
    for nat index < len(names)
        string name = names[index]
        string suffix = if index + 1 == len(names) then "" else ","
        emit("  " + name + " = {{" + field(entry, name) + "}}" + suffix)
    emit("}}")

void statistics(const Database database)
    map.Map<string, int> types
    map.Map<string, int> years
    map.Map<string, int> pairs
    set.Set<string> authors
    for Entry entry = database.entries[]
        increment(&types, entry.kind)
        increment(&years, plain(field(entry, "year")))
        if not entry.fields.has("author")
            continue
        set.Set<string> distinct
        for Person person = entry.primary.names[]
            string name = name_text(person, false, false)
            .authors.add(name)
            .distinct.add(name)
        string[] names = distinct.values().sorted()
        for nat first < len(names)
            for first + 1 <= nat second < len(names)
                increment(&pairs, names[first] + HT + names[second])
    emit("ENTRIES {len(database.entries)}")
    for string kind = types.keys().sorted()[]
        emit("TYPE {kind} {map_count(types, kind)}")
    for string year = years.keys().sorted()[]
        emit("YEAR {year} {map_count(years, year)}")
    emit("AUTHORS {authors.size()}")
    string best = ""
    int maximum = 0
    for string pair = pairs.keys().sorted()[]
        int count = map_count(pairs, pair)
        if count > maximum
            best = pair
            maximum = count
    if maximum == 0
        emit("PAIR none")
    else
        string[] names = best.split(HT)
        emit("PAIR {names[0]} & {names[1]} {maximum}")

Style | none parse_style(string name)
    if name == "APA"
        return Style.APA
    if name == "IEEE"
        return Style.IEEE
    if name == "CHICAGO"
        return Style.Chicago
    if name == "MLA"
        return Style.MLA
    return none

string[] command_words(string line)
    string[] words = line.split(" ")
    if words[0] != "CITE" and words[0] != "SEARCH"
        return words
    int first = find_index(line, " ")
    if first < 0
        return words
    int offset = find_index(line[first + 1:], " ")
    if offset < 0
        return words
    int second = first + 1 + offset
    return [line[0:<first], line[first + 1:<second], line[second + 1:]]

void | error execute(Database &database, string line)
    string[] words = command_words(line)
    string command = words[0]
    if not includes(["FORMAT", "BIBLIOGRAPHY", "CITE", "KEYGEN", "CHECK", "SEARCH", "EXPORT", "STATS"], command)
        return error("unknown command '{command}'")
    int count = int(len(words)) - 1
    int required = if command == "FORMAT" or command == "CITE" or command == "SEARCH" then 2 elif command == "BIBLIOGRAPHY" or command == "EXPORT" then 1 else 0
    if (command == "FORMAT" and count < required) or (command != "FORMAT" and count != required)
        return error("wrong number of arguments")
    Style style = Style.APA
    if command == "FORMAT" or command == "BIBLIOGRAPHY" or command == "CITE"
        match parse_style(words[1])
            Style parsed
                style = parsed
            none
                return error("unknown style '{words[1]}'")
    if command == "FORMAT"
        Ranking ranking = ieee_order(database)
        for string key = words[2:][]
            if not database.lookup.has(key)
                emit("ERROR unknown key '{key}'")
            else
                int index = map_count(database.lookup, key)
                emit(reference(database.entries[index], style, ranking.numbers[index]))
    elif command == "BIBLIOGRAPHY"
        emit(if style == Style.MLA then "Works Cited" else "References")
        Ranking ranking = ieee_order(database)
        int[] order = if style == Style.IEEE then ranking.order else database.bibliography
        int previous = -1
        for int index = order[]
            bool repeated = previous >= 0 and (style == Style.Chicago or style == Style.MLA) and database.entries[previous].primary == database.entries[index].primary
            emit(reference(database.entries[index], style, ranking.numbers[index], repeated))
            previous = index
    elif command == "CITE"
        string text = try cite(&database, style, words[2])
        emit(text)
    elif command == "KEYGEN"
        keygen(database)
    elif command == "CHECK"
        check_entries(database)
    elif command == "SEARCH"
        string[] keys = []
        string needle = letter_case(words[2], false)
        for Entry entry = database.entries[]
            if entry.fields.has(words[1]) and letter_case(plain(field(entry, words[1])), false).contains(needle)
                keys = keys.append(entry.key)
        emit(if len(keys) == 0 then "MATCHES 0" else "MATCHES {len(keys)}: " + keys.join(" "))
    elif command == "EXPORT"
        if not database.lookup.has(words[1])
            return error("unknown key '{words[1]}'")
        export_entry(database.entries[map_count(database.lookup, words[1])])
    else
        statistics(database)
    return void

string[] database_lines = []
while true
    string database_line
    scan(&database_line)
    if database_line == "%%"
        break
    database_lines = database_lines.append(database_line)
Database formatter = read_database(database_lines)
int command_count
scan(&command_count)
for 0 <= int command_index < command_count
    string command_line
    scan(&command_line)
    match execute(&formatter, command_line)
        void
            continue
        error problem
            emit("ERROR " + problem.message)
