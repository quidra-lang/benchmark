int[] offsets()
    return [-12, 12, -1, 1]

bool has(int[] cells, int cell)
    for auto value = cells[]
        if value == cell
            return true
    return false

bool includes(string[] items, string item)
    for string value = items[]
        if value == item
            return true
    return false

string translate(string text, string from, string to)
    string result = ""
    for nat i < len(text)
        match from.find(text[i])
            nat index
                result += to[index]
            none
                result += text[i]
    return result

string lower(string text)
    return translate(text, "UDLR", "udlr")

nat direction_index(string letter)
    match "udlr".find(lower(letter))
        nat index
            return index
        none
            return 0

bool allowed(string text, string alphabet)
    for nat i < len(text)
        if not alphabet.contains(text[i])
            return false
    return true

string | none decode(string text, string alphabet)
    string result = ""
    nat i = 0
    while i < len(text)
        nat start = i
        while i < len(text) and "0123456789".contains(text[i])
            i += 1
        nat count = 1
        if i > start
            if i - start > 2 or text[start] == "0"
                return none
            count = nat.parse(text[start:<i])
        if i == len(text) or not alphabet.contains(text[i])
            return none
        result += string.repeat(text[i], count)
        i += 1
    return result

string encode(string text)
    string result = ""
    nat i = 0
    while i < len(text)
        nat end = i + 1
        while end < len(text) and text[end] == text[i]
            end += 1
        if end - i > 1
            result += "{end - i}"
        result += text[i]
        i = end
    return result

nat pushes(string text)
    nat count = 0
    for nat i < len(text)
        if "UDLR".contains(text[i])
            count += 1
    return count

string cell_text(int cell)
    return "{cell / 12} {cell % 12}"

int[] moved_box(int[] boxes, int source, int target)
    int[] result = boxes
    for nat i < len(result)
        if result[i] == source
            result[i] = target
    return result.sorted()

class Position(int player, int[] boxes)

class Walk(bool[] reached, int[] previous, nat[] directions)
    int representative()
        for nat i < len(reached)
            if reached[i]
                return int(i)
        return -1

    string path(int start, int target)
        string result = ""
        int cell = target
        while cell != start
            result = "udlr"[directions[cell]] + result
            cell = previous[cell]
        return result

class Simulation(Position position, string letters, string failure)

class Level(local string[] loaded_rows)
    nat height = len(loaded_rows)
    nat width = len(loaded_rows[0])
    bool[] walls = array(144, fill = true)
    bool[] goals = array(144, fill = false)
    bool[] interior = array(144, fill = false)
    bool[] dead = array(144, fill = false)
    int[] goal_cells = []
    int[][] distances = []
    string reason = ""
    Position initial = Position(0, [])
    local int[] initial_players = []
    local int[] initial_boxes = []
    for nat r < height
        for nat c < width
            int p = int((r + 1) * 12 + c + 1)
            string ch = loaded_rows[r][c]
            walls[p] = ch == "#"
            goals[p] = ".*+".contains(ch)
            if goals[p]
                goal_cells = goal_cells.append(p)
            if "@+".contains(ch)
                initial_players = initial_players.append(p)
            if "$*".contains(ch)
                initial_boxes = initial_boxes.append(p)
    if len(initial_players) == 1
        initial = Position(initial_players[0], initial_boxes)
        local int[] queue = initial_players
        interior[initial_players[0]] = true
        local nat head = 0
        while head < len(queue)
            local int p = queue[head]
            head += 1
            for int delta = offsets()[]
                local int q = p + delta
                if not walls[q] and not interior[q]
                    interior[q] = true
                    queue = queue.append(q)
    else
        initial = Position(0, initial_boxes)
    if len(initial_players) != 1
        reason = "players {len(initial_players)}"
    elif len(initial_boxes) == 0
        reason = "no boxes"
    elif len(initial_boxes) != len(goal_cells)
        reason = "boxes {len(initial_boxes)} goals {len(goal_cells)}"
    else
        for 1 <= nat r <= height
            for 1 <= nat c <= width
                local int p = int(r * 12 + c)
                if reason == "" and interior[p] and (r == 1 or r == height or c == 1 or c == width)
                    reason = "open {cell_text(p)}"
        for int p < 144
            if reason == "" and (has(initial_boxes, p) or goals[p]) and not interior[p]
                reason = "outside {cell_text(p)}"
    if reason == ""
        .analyze()

    void .analyze()
        goal_cells = []
        distances = []
        dead = interior
        for int p < 144
            if goals[p]
                goal_cells = goal_cells.append(p)
        for int goal = goal_cells[]
            int[] distance = array(144, fill = -1)
            distance[goal] = 0
            int[] queue = [goal]
            nat head = 0
            while head < len(queue)
                int p = queue[head]
                head += 1
                for int delta = offsets()[]
                    int q = p - delta
                    int behind = q - delta
                    if 0 <= behind < 144 and interior[q] and interior[behind] and distance[q] < 0
                        distance[q] = distance[p] + 1
                        queue = queue.append(q)
            for int p < 144
                if distance[p] >= 0
                    dead[p] = false
            distances = distances.append(distance)

    Walk walk(Position position)
        bool[] reached = array(144, fill = false)
        int[] previous = array(144, fill = -1)
        nat[] directions = array(144, fill = nat(0))
        int[] queue = [position.player]
        reached[position.player] = true
        nat head = 0
        while head < len(queue)
            int p = queue[head]
            head += 1
            for int delta = offsets()[nat d]
                int q = p + delta
                if interior[q] and not has(position.boxes, q) and not reached[q]
                    reached[q] = true
                    previous[q] = p
                    directions[q] = d
                    queue = queue.append(q)
        return Walk(reached, previous, directions)

    bool solved(int[] boxes)
        for int box = boxes[]
            if not goals[box]
                return false
        return true

    bool pushable(int box, nat d, int[] boxes, Walk reachable)
        int delta = offsets()[d]
        return reachable.reached[box - delta] and interior[box + delta] and not has(boxes, box + delta)

    bool frozen(int box, int[] boxes, int[] assumed)
        int[] next = assumed.append(box)
        for int axis = [1, 12][]
            int a = box - axis
            int b = box + axis
            bool blocked = walls[a] or walls[b] or has(assumed, a) or has(assumed, b)
            blocked = blocked or (dead[a] and dead[b])
            if not blocked and has(boxes, a)
                blocked = frozen(a, boxes, next)
            if not blocked and has(boxes, b)
                blocked = frozen(b, boxes, next)
            if not blocked
                return false
        return true

    bool frozen_box(int[] boxes)
        for int box = boxes[]
            if not goals[box] and frozen(box, boxes, [])
                return true
        return false

    Simulation simulate(Position start, string steps)
        Position position = start
        string letters = ""
        for nat i < len(steps)
            nat d = direction_index(steps[i])
            int delta = offsets()[d]
            int target = position.player + delta
            string failure = ""
            if walls[target]
                failure = "wall"
            elif has(position.boxes, target) and (walls[target + delta] or has(position.boxes, target + delta))
                failure = "blocked"
            if failure != ""
                return Simulation(position, letters, "step {i + 1} {failure}")
            bool push = has(position.boxes, target)
            if push
                position.boxes = moved_box(position.boxes, target, target + delta)
            position.player = target
            letters += if push then "UDLR"[d] else "udlr"[d]
        return Simulation(position, letters, "")

    string[] render(Position position, bool dead_map = false)
        string[] rows = []
        for 1 <= nat r <= height
            string row = ""
            for 1 <= nat c <= width
                int p = int(r * 12 + c)
                string ch = "-"
                if walls[p]
                    ch = "#"
                elif dead_map
                    ch = if goals[p] then "." elif dead[p] then "x" else "-"
                elif p == position.player
                    ch = if goals[p] then "+" else "@"
                elif has(position.boxes, p)
                    ch = if goals[p] then "*" else "$"
                elif goals[p]
                    ch = "."
                row += ch
            rows = rows.append(row)
        return rows

class Push(int box, nat direction)
class Node(Position position, nat parent, Push push)
class SearchResult(string outcome, nat expanded, nat states, string notation = "")

string state_key(Position position)
    string[] parts = ["{position.player}"]
    for int box = position.boxes[]
        parts = parts.append("{box}")
    return parts.join(",")

SearchResult search(Level level, Position start, int[] fixed, int target, nat limit)
    auto first = Position(level.walk(start).representative(), start.boxes)
    Node[] nodes = [Node(first, 0, Push(0, 0))]
    set.Set<string> known
    .known.add(state_key(first))
    nat expanded = 0
    while expanded < len(nodes)
        if limit != 0 and expanded == limit
            return SearchResult("limit", expanded, len(nodes))
        nat parent = expanded
        Position position = nodes[parent].position
        expanded += 1
        Walk reachable = level.walk(position)
        for int box = position.boxes[]
            if has(fixed, box)
                continue
            for nat d < 4
                if not level.pushable(box, d, position.boxes, reachable)
                    continue
                int destination = box + offsets()[d]
                int[] boxes = moved_box(position.boxes, box, destination)
                if target < 0 and (level.dead[destination] or level.frozen_box(boxes))
                    continue
                auto next = Position(level.walk(Position(box, boxes)).representative(), boxes)
                string key = state_key(next)
                if known.has(key)
                    continue
                .known.add(key)
                nodes = nodes.append(Node(next, parent, Push(box, d)))
                if (target < 0 and level.solved(boxes)) or destination == target
                    Push[] route = []
                    nat index = len(nodes) - 1
                    while index > 0
                        route = [nodes[index].push].concat(route)
                        index = nodes[index].parent
                    Position replay = start
                    string notation = ""
                    for Push push = route[]
                        int delta = offsets()[push.direction]
                        notation += level.walk(replay).path(replay.player, push.box - delta)
                        notation += "UDLR"[push.direction]
                        replay = Position(push.box, moved_box(replay.boxes, push.box, push.box + delta))
                    return SearchResult("found", expanded, len(nodes), notation)
    return SearchResult("no solution", expanded, len(nodes))

class Assignment(int total, nat[] goals)

Assignment assign(Level level, int[] boxes, nat[] order = [], int total = 0)
    if len(order) == len(boxes)
        return Assignment(total, order)
    auto best = Assignment(-1, [])
    for nat goal < len(level.goal_cells)
        bool used = false
        for nat item = order[]
            if item == goal
                used = true
        int distance = level.distances[goal][boxes[len(order)]]
        if not used and distance >= 0
            Assignment candidate = assign(level, boxes, order.append(goal), total + distance)
            if candidate.total >= 0 and (best.total < 0 or candidate.total < best.total)
                best = candidate
    return best

int transformed_cell(string kind, int cell, int height, int width)
    int r = cell / 12
    int c = cell % 12
    if kind == "ROT90"
        return c * 12 + height + 1 - r
    if kind == "ROT180"
        return (height + 1 - r) * 12 + width + 1 - c
    if kind == "ROT270"
        return (width + 1 - c) * 12 + r
    if kind == "FLIPH"
        return r * 12 + width + 1 - c
    return (height + 1 - r) * 12 + c

Position transformed_position(string kind, Position position, int height, int width)
    int[] boxes = []
    for int box = position.boxes[]
        boxes = boxes.append(transformed_cell(kind, box, height, width))
    return Position(transformed_cell(kind, position.player, height, width), boxes.sorted())

string transformed_steps(string kind, string text)
    string letters = "durlDURL"
    if kind == "ROT90"
        letters = "rludRLUD"
    elif kind == "ROT270"
        letters = "lrduLRDU"
    elif kind == "FLIPH"
        letters = "udrlUDRL"
    elif kind == "FLIPV"
        letters = "dulrDULR"
    return translate(text, "udlrUDLR", letters)

class Snapshot(Position position, string history)
class Solution(Position position, string notation)

string | none command_format(string name)
    if includes(["VALID", "INFO", "SHOW", "EXPORT", "RESET", "STATUS", "HISTORY", "BOXES", "REACH", "DEADSQUARES", "DEADLOCK", "BOUND", "PLAY"], name)
        return ""
    if name == "IMPORT"
        return "a"
    if name == "MOVE" or name == "CHECK"
        return "s"
    if name == "PUSH"
        return "nnd"
    if name == "BRING"
        return "nnnn"
    if name == "PATH"
        return "nn"
    if includes(["UNDO", "REDO", "SOLVE", "HINT"], name)
        return "n"
    if name == "SAVE" or name == "RESTORE"
        return "k"
    if name == "TRANSFORM"
        return "t"
    return none

bool valid_argument(string kind, string text)
    if kind == "n"
        return 1 <= len(text) <= 6 and allowed(text, "0123456789") and (len(text) == 1 or text[0] != "0")
    if kind == "k"
        return 1 <= len(text) <= 8 and allowed(text, "abcdefghijklmnopqrstuvwxyz")
    if kind == "d"
        return len(text) == 1 and "udlr".contains(text)
    if kind == "t"
        return includes(["ROT90", "ROT180", "ROT270", "FLIPH", "FLIPV"], text)
    if kind == "s"
        match decode(text, "udlrUDLR")
            string
                return true
            none
                return false
    return true

void emit(string text)
    print("{text}{NL}")

class Game(local string[] loaded_rows)
    Level level = Level(loaded_rows)
    Position initial = level.initial
    Position current = initial
    string history = ""
    string redo = ""
    map.Map<string, Snapshot> snapshots
    Solution | none solution = none

    void .load(string[] rows)
        level = Level(rows)
        initial = level.initial
        current = initial
        history = ""
        redo = ""
        map.Map<string, Snapshot> empty
        snapshots = empty
        solution = none
        emit("loaded {level.height}x{level.width}")

    Simulation .take(string steps)
        Simulation result = level.simulate(current, steps)
        current = result.position
        history += result.letters
        if result.letters != ""
            redo = ""
        return result

    string progress(int[] boxes)
        nat count = 0
        for int box = boxes[]
            if level.goals[box]
                count += 1
        string text = "goals {count}/{len(boxes)}"
        return text + (if count == len(boxes) then " solved" else "")

    void .transform(string kind)
        int h = int(level.height)
        int w = int(level.width)
        bool[] walls = array(144, fill = true)
        bool[] goals = array(144, fill = false)
        bool[] interior = array(144, fill = false)
        for 1 <= int r <= h
            for 1 <= int c <= w
                int p = r * 12 + c
                int q = transformed_cell(kind, p, h, w)
                walls[q] = level.walls[p]
                goals[q] = level.goals[p]
                interior[q] = level.interior[p]
        level.walls = walls
        level.goals = goals
        level.interior = interior
        if kind == "ROT90" or kind == "ROT270"
            level.height = nat(w)
            level.width = nat(h)
        .level.analyze()
        initial = transformed_position(kind, initial, h, w)
        level.initial = initial
        current = transformed_position(kind, current, h, w)
        history = transformed_steps(kind, history)
        redo = transformed_steps(kind, redo)
        for string name = snapshots.keys()[]
            match snapshots.get(name)
                Snapshot snapshot
                    .snapshots.set(name, Snapshot(transformed_position(kind, snapshot.position, h, w), transformed_steps(kind, snapshot.history)))
                none
                    void
        match solution
            Solution saved
                solution = Solution(transformed_position(kind, saved.position, h, w), transformed_steps(kind, saved.notation))
            none
                void
        emit("transformed {level.height}x{level.width}")

    void | error .run(string[] words, string[] rows)
        string name = words[0]
        string[] args = words[1:]
        if name == "LOAD"
            nat width = nat.parse(args[1])
            for string row = rows[nat i]
                if len(row) != width or not allowed(row, "#-.$*@+")
                    return error("bad row {i + 1}")
            .load(rows)
            return
        string format = ""
        match command_format(name)
            string found
                format = found
            none
                return error("unknown command {name}")
        if len(args) != len(format)
            return error("bad arguments")
        for nat i < len(args)
            if not valid_argument(format[i], args[i])
                return error("bad arguments")
        if name == "IMPORT"
            string[] decoded = []
            for string part = args[0].split("|")[]
                match decode(part, "#-.$*@+")
                    string row
                        decoded = decoded.append(row)
                    none
                        return error("bad level")
            if len(decoded) > 10 or len(decoded) == 0 or not (1 <= len(decoded[0]) <= 10)
                return error("bad level")
            for string row = decoded[]
                if len(row) != len(decoded[0])
                    return error("bad level")
            .load(decoded)
            return
        if name == "VALID"
            emit(if level.reason == "" then "valid" else "invalid {level.reason}")
            return
        if level.reason != ""
            return error("invalid level")
        nat pairs = if name == "BRING" then 2 elif name == "PATH" or name == "PUSH" then 1 else 0
        int[] cells = []
        for nat i < pairs
            nat r = nat.parse(args[2 * i])
            nat c = nat.parse(args[2 * i + 1])
            if not (1 <= r <= level.height and 1 <= c <= level.width)
                return error("bad value")
            cells = cells.append(int(r * 12 + c))
        if name == "UNDO" or name == "REDO"
            if nat.parse(args[0]) == 0
                return error("bad value")
        if name == "SOLVE" or name == "HINT"
            if not (1 <= nat.parse(args[0]) <= 100000)
                return error("bad value")
        if name == "INFO"
            nat wall_count = 0
            nat inside_count = 0
            nat dead_count = 0
            for 1 <= nat r <= level.height
                for 1 <= nat c <= level.width
                    nat p = r * 12 + c
                    if level.walls[p]
                        wall_count += 1
                    if level.interior[p]
                        inside_count += 1
                    if level.dead[p]
                        dead_count += 1
            emit("size {level.height}x{level.width} walls {wall_count} cells {inside_count} boxes {len(current.boxes)} dead {dead_count}")
        elif name == "SHOW" or name == "EXPORT" or name == "DEADSQUARES"
            string[] drawing = level.render(current, name == "DEADSQUARES")
            if name == "EXPORT"
                string[] encoded = [for string row = drawing[] then encode(row)]
                emit("level {encoded.join("|")}")
            else
                if name == "DEADSQUARES"
                    nat count = 0
                    for bool dead = level.dead[]
                        if dead
                            count += 1
                    emit("dead {count}")
                for string row = drawing[]
                    emit(row)
        elif name == "MOVE" or name == "CHECK"
            string steps = ""
            match decode(args[0], "udlrUDLR")
                string decoded
                    steps = decoded
                none
                    return error("bad arguments")
            Simulation result = level.simulate(current, steps)
            if name == "CHECK"
                if result.failure != ""
                    emit("check fail {result.failure}")
                else
                    emit("check ok moves {len(result.letters)} pushes {pushes(result.letters)} {progress(result.position.boxes)}")
            else
                result = .take(steps)
                if result.letters != ""
                    emit("moved {result.letters}")
                if result.failure != ""
                    return error(result.failure)
        elif name == "PATH" or name == "PUSH"
            Walk reachable = level.walk(current)
            int target = cells[0]
            string suffix = ""
            if name == "PUSH"
                nat d = direction_index(args[2])
                int delta = offsets()[d]
                if not has(current.boxes, target)
                    return error("no box")
                if not level.interior[target + delta] or has(current.boxes, target + delta)
                    return error("blocked")
                target -= delta
                suffix = args[2]
            if not reachable.reached[target]
                return error("unreachable")
            string path = reachable.path(current.player, target) + suffix
            Simulation result = .take(path)
            if name == "PUSH"
                emit("pushed {result.letters}")
            elif path == ""
                emit("path 0")
            else
                emit("path {len(path)} {result.letters}")
        elif name == "BRING"
            if not has(current.boxes, cells[0])
                return error("no box")
            if cells[0] == cells[1]
                emit("brought 0")
            else
                int[] fixed = [for int box = current.boxes[] if box != cells[0] then box]
                SearchResult result = search(level, current, fixed, cells[1], 0)
                if result.outcome != "found"
                    return error("no route")
                .take(result.notation)
                emit("brought {pushes(result.notation)} {result.notation}")
        elif name == "UNDO" or name == "REDO"
            nat available = if name == "UNDO" then len(history) else len(redo)
            if available == 0
                return error(if name == "UNDO" then "nothing to undo" else "nothing to redo")
            nat count = nat.parse(args[0])
            if count > available
                count = available
            for nat i < count
                if name == "UNDO"
                    string letter = history[len(history) - 1]
                    history = history[:<len(history) - 1]
                    int delta = offsets()[direction_index(letter)]
                    if "UDLR".contains(letter)
                        current.boxes = moved_box(current.boxes, current.player + delta, current.player)
                    current.player -= delta
                    redo += lower(letter)
                else
                    string letter = redo[len(redo) - 1]
                    redo = redo[:<len(redo) - 1]
                    Simulation result = level.simulate(current, letter)
                    current = result.position
                    history += result.letters
            emit(if name == "UNDO" then "undone {count}" else "redone {count}")
        elif name == "RESET"
            current = initial
            history = ""
            redo = ""
            emit("reset")
        elif name == "STATUS"
            emit("moves {len(history)} pushes {pushes(history)} {progress(current.boxes)}")
        elif name == "HISTORY"
            emit(if history == "" then "history 0" else "history {len(history)} {history}")
        elif name == "REACH"
            Walk reachable = level.walk(current)
            nat count = 0
            for bool reached = reachable.reached[]
                if reached
                    count += 1
            emit("reach {count} first {cell_text(reachable.representative())}")
        elif name == "BOXES"
            emit("boxes {len(current.boxes)}")
            Walk reachable = level.walk(current)
            for int box = current.boxes[]
                int best = -1
                for int[] distance = level.distances[]
                    if distance[box] >= 0 and (best < 0 or distance[box] < best)
                        best = distance[box]
                string directions = ""
                for nat d < 4
                    if level.pushable(box, d, current.boxes, reachable)
                        directions += "udlr"[d]
                string distance = if best < 0 then "dead" else "{best}"
                if directions == ""
                    directions = "-"
                emit("box {cell_text(box)} {distance} {directions}")
        elif name == "DEADLOCK"
            for int box = current.boxes[]
                if level.dead[box]
                    emit("deadlock dead {cell_text(box)}")
                    return
            for int box = current.boxes[]
                if not level.goals[box] and level.frozen(box, current.boxes, [])
                    emit("deadlock frozen {cell_text(box)}")
                    return
            emit("no deadlock")
        elif name == "BOUND"
            Assignment best = assign(level, current.boxes)
            if best.total < 0
                emit("bound none")
            else
                emit("bound {best.total}")
                for int box = current.boxes[nat i]
                    nat goal = best.goals[i]
                    emit("box {cell_text(box)} goal {cell_text(level.goal_cells[goal])} pushes {level.distances[goal][box]}")
        elif name == "SAVE"
            .snapshots.set(args[0], Snapshot(current, history))
            emit("saved {args[0]} moves {len(history)}")
        elif name == "RESTORE"
            match snapshots.get(args[0])
                Snapshot snapshot
                    current = snapshot.position
                    history = snapshot.history
                    redo = ""
                    emit("restored {args[0]} moves {len(history)}")
                none
                    return error("no snapshot {args[0]}")
        elif name == "SOLVE" or name == "HINT"
            if name == "SOLVE"
                solution = none
            if level.solved(current.boxes)
                emit("already solved")
                return
            SearchResult result = search(level, current, [], -1, nat.parse(args[0]))
            if result.outcome != "found"
                emit("{result.outcome} expanded {result.expanded} states {result.states}")
            elif name == "SOLVE"
                emit("solution pushes {pushes(result.notation)} moves {len(result.notation)} expanded {result.expanded} states {result.states}")
                emit(result.notation)
                solution = Solution(current, result.notation)
            else
                nat end = 0
                while not "UDLR".contains(result.notation[end])
                    end += 1
                string part = result.notation[:<end + 1]
                .take(part)
                emit("hint {part}")
        elif name == "PLAY"
            match solution
                Solution saved
                    if saved.position != current
                        return error("no solution")
                    .take(saved.notation)
                    emit("played pushes {pushes(saved.notation)} moves {len(saved.notation)}")
                none
                    return error("no solution")
        elif name == "TRANSFORM"
            .transform(args[0])
        return

string read_line()
    string line
    scan(&line)
    return line

string[] header = read_line().split(" ")
nat height = nat.parse(header[0])
string[] initial_rows = []
for nat i < height
    initial_rows = initial_rows.append(read_line())
auto game = Game(initial_rows)
nat commands = nat.parse(read_line())
for nat i < commands
    string[] words = read_line().split(" ")
    string[] rows = []
    if words[0] == "LOAD"
        for nat r < nat.parse(words[1])
            rows = rows.append(read_line())
    match .game.run(words, rows)
        void
            void
        error problem
            emit("error: {problem.message}")
