void emit(string text)
    print(text + NL)

int minimum(int a, int b)
    return if a < b then a else b

int maximum(int a, int b)
    return if a > b then a else b

int absolute(int value)
    return if value < 0 then -value else value

bool has_text(string[] choices, string value)
    for string choice = choices[]
        if choice == value
            return true
    return false

class Box(int x1, int y1, int x2, int y2)
class Rectangle(string name, string layer, Box box)
class Relation(nat kind, Box common, int ox, int oy, int gap, string direction)
class Span(int first, int last)
class Cell(int x, int y)
class Hole(int amount, Box bounds)
class Pair(Rectangle first, Rectangle second)
class Rule(string kind, string layer, string other, int value)
class Snapshot(map.Map<string, Rectangle> rectangles, string command_line)

string box_text(Box box)
    return "({box.x1},{box.y1})-({box.x2},{box.y2})"

string point_text(int x, int y)
    return "({x},{y})"

int rectangle_width(Rectangle rect)
    return rect.box.x2 - rect.box.x1

int rectangle_height(Rectangle rect)
    return rect.box.y2 - rect.box.y1

int rectangle_area(Rectangle rect)
    return rectangle_width(rect) * rectangle_height(rect)

string name_list(Rectangle[] rects)
    return if len(rects) == 0 then "none" else [for Rectangle rect = rects[] then rect.name].join(" ")

int minimum_margin(Rectangle outer, Rectangle inner)
    return minimum(minimum(inner.box.x1 - outer.box.x1, inner.box.y1 - outer.box.y1), minimum(outer.box.x2 - inner.box.x2, outer.box.y2 - inner.box.y2))

Relation relation(Rectangle a, Rectangle b)
    Box common = Box(maximum(a.box.x1, b.box.x1), maximum(a.box.y1, b.box.y1), minimum(a.box.x2, b.box.x2), minimum(a.box.y2, b.box.y2))
    int ox = common.x2 - common.x1
    int oy = common.y2 - common.y1
    nat kind = if ox > 0 and oy > 0 then 0 else (if ox < 0 or oy < 0 then 3 else (if ox == 0 and oy == 0 then 2 else 1))
    string direction = if ox < 0 and oy < 0 then "diagonal" else (if ox < 0 then "x" else "y")
    return Relation(kind, common, ox, oy, maximum(0, maximum(-ox, -oy)), direction)

bool connected(Rectangle a, Rectangle b)
    return relation(a, b).kind <= 1

Box bounding_box(Rectangle[] rects)
    Box result = rects[0].box
    for Rectangle rect = rects[]
        result.x1 = minimum(result.x1, rect.box.x1)
        result.y1 = minimum(result.y1, rect.box.y1)
        result.x2 = maximum(result.x2, rect.box.x2)
        result.y2 = maximum(result.y2, rect.box.y2)
    return result

int[] unique_ints(int[] values)
    int[] result = []
    for int value = values.sorted()[]
        if len(result) == 0 or result[len(result) - 1] != value
            result = result.append(value)
    return result

nat int_index(int[] values, int value)
    for nat i < len(values)
        if values[i] == value
            return i
    return len(values)

Span[] runs(bool[] flags, int[] coordinates)
    Span[] result = []
    nat i = 0
    while i < len(flags)
        if not flags[i]
            i += 1
            continue
        nat first = i
        while i < len(flags) and flags[i]
            i += 1
        result = result.append(Span(coordinates[first], coordinates[i]))
    return result

bool has_span(Span[] spans, Span value)
    for Span entry = spans[]
        if entry.first == value.first and entry.last == value.last
            return true
    return false

class Coverage(int[] xs, int[] ys, int[][] counts)
    int column_count()
        return int(len(xs)) - 1

    int row_count()
        return int(len(ys)) - 1

    bool covered(int i, int j)
        return i >= 0 and j >= 0 and i < column_count() and j < row_count() and counts[i][j] > 0

    int cell_area(int i, int j)
        return (xs[i + 1] - xs[i]) * (ys[j + 1] - ys[j])

    int area(int threshold = 1)
        int result = 0
        for int i < column_count()
            for int j < row_count()
                if counts[i][j] >= threshold
                    result += cell_area(i, j)
        return result

    int perimeter()
        int result = 0
        for int i <= column_count()
            for int j < row_count()
                if covered(i - 1, j) != covered(i, j)
                    result += ys[j + 1] - ys[j]
        for int j <= row_count()
            for int i < column_count()
                if covered(i, j - 1) != covered(i, j)
                    result += xs[i + 1] - xs[i]
        return result

    Hole[] holes()
        bool[][] seen = [for int i < column_count() then [for int j < row_count() then false]]
        Hole[] result = []
        for int j < row_count()
            for int i < column_count()
                if seen[i][j] or counts[i][j] > 0
                    continue
                Cell[] pending = [Cell(i, j)]
                seen[i][j] = true
                bool boundary = false
                int amount = 0
                Box bounds = Box(xs[i], ys[j], xs[i + 1], ys[j + 1])
                while len(pending) > 0
                    Cell current = pending[len(pending) - 1]
                    pending = pending[:<len(pending) - 1]
                    int x = current.x
                    int y = current.y
                    boundary = boundary or x == 0 or y == 0 or x == column_count() - 1 or y == row_count() - 1
                    amount += cell_area(x, y)
                    bounds.x1 = minimum(bounds.x1, xs[x])
                    bounds.y1 = minimum(bounds.y1, ys[y])
                    bounds.x2 = maximum(bounds.x2, xs[x + 1])
                    bounds.y2 = maximum(bounds.y2, ys[y + 1])
                    for Cell next = [Cell(x - 1, y), Cell(x + 1, y), Cell(x, y - 1), Cell(x, y + 1)][]
                        if next.x >= 0 and next.x < column_count() and next.y >= 0 and next.y < row_count() and not seen[next.x][next.y] and counts[next.x][next.y] == 0
                            seen[next.x][next.y] = true
                            pending = pending.append(next)
                if not boundary
                    result = result.append(Hole(amount, bounds))
        return result

    Box[] pieces()
        Span[][] row_runs = []
        for int j < row_count()
            row_runs = row_runs.append(runs([for int i < column_count() then counts[i][j] > 0], xs))
        Box[] result = []
        for nat j < len(row_runs)
            for Span span = row_runs[j][]
                if j > 0 and has_span(row_runs[j - 1], span)
                    continue
                nat top = j + 1
                while top < len(row_runs) and has_span(row_runs[top], span)
                    top += 1
                result = result.append(Box(span.first, ys[j], span.last, ys[top]))
        return result

    Box | none largest_empty()
        bool found = false
        int best_area = 0
        Box best = Box(0, 0, 0, 0)
        for int a < column_count()
            bool[] free = [for int j < row_count() then true]
            for a + 1 <= int b <= column_count()
                for int j < row_count()
                    free[j] = free[j] and counts[b - 1][j] == 0
                int width = xs[b] - xs[a]
                for Span span = runs(free, ys)[]
                    int amount = width * (span.last - span.first)
                    bool better = not found or amount > best_area
                    if found and amount == best_area
                        better = xs[a] < best.x1 or (xs[a] == best.x1 and (span.first < best.y1 or (span.first == best.y1 and width < best.x2 - best.x1)))
                    if better
                        found = true
                        best_area = amount
                        best = Box(xs[a], span.first, xs[b], span.last)
        return if found then best else none

Coverage make_coverage(Rectangle[] rects, int[] extra_xs = [], int[] extra_ys = [])
    int[] xs = extra_xs
    int[] ys = extra_ys
    for Rectangle rect = rects[]
        xs = xs.append(rect.box.x1).append(rect.box.x2)
        ys = ys.append(rect.box.y1).append(rect.box.y2)
    xs = unique_ints(xs)
    ys = unique_ints(ys)
    int[][] counts = [for nat i < len(xs) - 1 then [for nat j < len(ys) - 1 then 0]]
    for Rectangle rect = rects[]
        for int_index(xs, rect.box.x1) <= nat i < int_index(xs, rect.box.x2)
            for int_index(ys, rect.box.y1) <= nat j < int_index(ys, rect.box.y2)
                counts[i][j] += 1
    return Coverage(xs, ys, counts)

Rectangle[][] find_nets(Rectangle[] rects)
    bool[] seen = [for nat i < len(rects) then false]
    Rectangle[][] result = []
    for nat start < len(rects)
        if seen[start]
            continue
        nat[] pending = [start]
        seen[start] = true
        bool[] included = [for nat i < len(rects) then false]
        while len(pending) > 0
            nat current = pending[len(pending) - 1]
            pending = pending[:<len(pending) - 1]
            included[current] = true
            for nat i < len(rects)
                if not seen[i] and connected(rects[current], rects[i])
                    seen[i] = true
                    pending = pending.append(i)
        Rectangle[] group = []
        for nat i < len(rects)
            if included[i]
                group = group.append(rects[i])
        result = result.append(group)
    return result

string[] overlap_lines(Rectangle[] rects)
    string[] result = []
    for nat i < len(rects)
        for i + 1 <= nat j < len(rects)
            Rectangle a = rects[i]
            Rectangle b = rects[j]
            Relation current = relation(a, b)
            if current.kind == 0
                result = result.append(a.name + " " + b.name + " " + box_text(current.common) + " area {current.ox * current.oy}")
    return result

class Violation(int gap, string first, string second, string direction)

string[] spacing_lines(Rectangle[] rects, int spacing)
    Violation[] found = []
    for nat i < len(rects)
        for i + 1 <= nat j < len(rects)
            Relation current = relation(rects[i], rects[j])
            if current.kind != 2 and not (current.kind == 3 and current.gap < spacing)
                continue
            Violation entry = Violation(current.gap, rects[i].name, rects[j].name, if current.kind == 2 then "corner" else current.direction)
            nat at = 0
            while at < len(found) and found[at].gap <= entry.gap
                at += 1
            found = found[:<at].append(entry).concat(found[at:])
    return [for Violation entry = found[] then entry.first + " " + entry.second + " gap {entry.gap} " + entry.direction]

string percentage(int amount, int denominator)
    int hundredths = 10000 * amount / denominator
    return "{hundredths / 100}.{hundredths % 100:int=2,zero}"

void report(string heading, string[] lines)
    emit(heading)
    for string line = lines[]
        emit(line)

class Layout()
    map.Map<string, Rectangle> rect_table
    map.Map<string, Rule> rule_table
    Snapshot[] history = []

    Rectangle[] all_rects()
        Rectangle[] result = []
        for string name = rect_table.keys().sorted()[]
            match rect_table.get(name)
                Rectangle value
                    result = result.append(value)
                none
                    void
        return result

    string[] layer_names()
        string[] result = []
        for Rectangle rect = all_rects()[]
            if not has_text(result, rect.layer)
                result = result.append(rect.layer)
        return result.sorted()

    Rectangle[] on_layer(string layer)
        Rectangle[] result = []
        for Rectangle rect = all_rects()[]
            if rect.layer == layer
                result = result.append(rect)
        return result

    Rectangle[] | error require_layer(string layer)
        Rectangle[] result = on_layer(layer)
        if len(result) == 0
            return error("no rectangles on " + layer)
        return result

    Rectangle | error get_rect(string name)
        match rect_table.get(name)
            Rectangle value
                return value
            none
                return error("unknown rectangle " + name)

    void | error unused(string name)
        match rect_table.get(name)
            Rectangle value
                return error("duplicate rectangle " + name)
            none
                void

    Pair | error get_pair(string a, string b)
        Rectangle first = try get_rect(a)
        Rectangle second = try get_rect(b)
        if a == b
            return error("same rectangle " + a)
        return Pair(first, second)

    void | error .place(Rectangle rect)
        if absolute(rect.box.x1) > 10000 or absolute(rect.box.y1) > 10000 or absolute(rect.box.x2) > 10000 or absolute(rect.box.y2) > 10000
            return error("out of bounds")
        .rect_table.set(rect.name, rect)

    string[] rule_violations(Rule rule)
        Rectangle[] rects = on_layer(rule.layer)
        if rule.kind == "spacing"
            return spacing_lines(rects, rule.value)
        string[] result = []
        for Rectangle rect = rects[]
            if rule.kind == "width"
                int size = minimum(rectangle_width(rect), rectangle_height(rect))
                if size < rule.value
                    result = result.append(rect.name + " width {size}")
            else
                Rectangle[] outers = on_layer(rule.other)
                bool found = false
                int best = 0
                for Rectangle outer = outers[]
                    int value = minimum_margin(outer, rect)
                    if not found or value > best
                        best = value
                        found = true
                if not found or best < rule.value
                    result = result.append(rect.name + " best margin " + (if found then best.string() else "none"))
        return result

    void | error .execute(string line)
        string[] parts = line.split(" ")
        string command = parts[0]
        string[] args = parts[1:]
        map.Map<string, Rectangle> before = rect_table
        if command == "ADD"
            string name = args[0]
            string layer = args[1]
            try unused(name)
            Box bounds = Box(int.parse(args[2]), int.parse(args[3]), int.parse(args[4]), int.parse(args[5]))
            if bounds.x1 >= bounds.x2 or bounds.y1 >= bounds.y2
                return error("invalid rectangle")
            try .place(Rectangle(name, layer, bounds))
            emit("added " + name + " " + layer + " " + box_text(bounds))
        elif has_text(["COPY", "MOVE", "RESIZE", "SPLIT", "LAYER", "DELETE"], command)
            string name = args[0]
            Rectangle rect = try get_rect(name)
            Box bounds = rect.box
            if command == "COPY" or command == "MOVE"
                string new_name = if command == "COPY" then args[1] else name
                nat offset = if command == "COPY" then 2 else 1
                if command == "COPY"
                    try unused(new_name)
                int dx = int.parse(args[offset])
                int dy = int.parse(args[offset + 1])
                Box moved = Box(bounds.x1 + dx, bounds.y1 + dy, bounds.x2 + dx, bounds.y2 + dy)
                try .place(Rectangle(new_name, rect.layer, moved))
                emit(if command == "COPY" then "copied " + name + " to " + new_name + " " + box_text(moved) else "moved " + name + " to " + box_text(moved))
            elif command == "RESIZE"
                int width = int.parse(args[1])
                int height = int.parse(args[2])
                if width <= 0 or height <= 0
                    return error("invalid size")
                bounds.x2 = bounds.x1 + width
                bounds.y2 = bounds.y1 + height
                try .place(Rectangle(name, rect.layer, bounds))
                emit("resized " + name + " to " + box_text(bounds))
            elif command == "SPLIT"
                string axis = args[1]
                int position = int.parse(args[2])
                string new_name = args[3]
                try unused(new_name)
                if (axis == "x" and not (bounds.x1 < position and position < bounds.x2)) or (axis == "y" and not (bounds.y1 < position and position < bounds.y2))
                    return error("cut outside " + name)
                Box kept = bounds
                Box piece = bounds
                if axis == "x"
                    kept.x2 = position
                    piece.x1 = position
                else
                    kept.y2 = position
                    piece.y1 = position
                .rect_table.set(name, Rectangle(name, rect.layer, kept))
                .rect_table.set(new_name, Rectangle(new_name, rect.layer, piece))
                emit("split " + name + " at " + axis + "={position}: " + name + " " + box_text(kept) + ", " + new_name + " " + box_text(piece))
            elif command == "LAYER"
                string layer = args[1]
                if layer == rect.layer
                    return error("already on " + layer)
                .rect_table.set(name, Rectangle(name, layer, bounds))
                emit("layer " + name + " " + rect.layer + " -> " + layer)
            else
                .rect_table.remove(name)
                emit("deleted " + name)
        elif command == "UNDO"
            if len(history) == 0
                return error("nothing to undo")
            Snapshot last = history[len(history) - 1]
            history = history[:<len(history) - 1]
            rect_table = last.rectangles
            emit("undo: " + last.command_line)
        elif command == "LIST"
            Rectangle[] rects = all_rects()
            report("rectangles: {len(rects)}", [for Rectangle rect = rects[] then rect.name + " " + rect.layer + " " + box_text(rect.box) + " {rectangle_width(rect)}x{rectangle_height(rect)}"])
        elif command == "INFO"
            string name = args[0]
            Rectangle rect = try get_rect(name)
            emit(name + " " + rect.layer + " " + box_text(rect.box) + " {rectangle_width(rect)}x{rectangle_height(rect)} area {rectangle_area(rect)}")
            Rectangle[] others = []
            for Rectangle other = all_rects()[]
                if other.name != name
                    others = others.append(other)
            string[] labels = ["overlaps", "touches", "corners"]
            for nat kind < 3
                Rectangle[] found = []
                for Rectangle other = others[]
                    if other.layer == rect.layer and relation(rect, other).kind == kind
                        found = found.append(other)
                emit(labels[kind] + ": " + name_list(found))
            Rectangle[] enclosed = []
            Rectangle[] enclosing = []
            for Rectangle other = others[]
                if minimum_margin(rect, other) >= 0
                    enclosed = enclosed.append(other)
                if minimum_margin(other, rect) >= 0
                    enclosing = enclosing.append(other)
            emit("encloses: " + name_list(enclosed))
            emit("enclosed by: " + name_list(enclosing))
        elif command == "LAYERS"
            string[] layers = layer_names()
            emit("layers: {len(layers)}")
            for string layer = layers[]
                Rectangle[] rects = on_layer(layer)
                emit(layer + ": {len(rects)} rectangles, area {make_coverage(rects).area()}, nets {len(find_nets(rects))}")
        elif command == "OVERLAPS"
            string[] lines = []
            if len(args) == 0
                for string layer = layer_names()[]
                    for string entry = overlap_lines(on_layer(layer))[]
                        lines = lines.append(layer + " " + entry)
                report("overlaps all layers: {len(lines)}", lines)
            else
                lines = overlap_lines(try require_layer(args[0]))
                report("overlaps " + args[0] + ": {len(lines)}", lines)
        elif has_text(["INTERSECT", "ADJACENT", "ENCLOSE", "PATH"], command)
            string a = args[0]
            string b = args[1]
            Pair pair = try get_pair(a, b)
            Rectangle first = pair.first
            Rectangle second = pair.second
            Relation current = relation(first, second)
            if command == "INTERSECT"
                string detail = ""
                if current.kind == 0
                    detail = box_text(current.common) + " area {current.ox * current.oy}"
                elif current.kind == 1
                    detail = "segment " + box_text(current.common) + " length {current.ox + current.oy}"
                elif current.kind == 2
                    detail = "point " + point_text(current.common.x1, current.common.y1)
                else
                    detail = "none, gap {current.gap}"
                emit("intersect " + a + " " + b + ": " + detail)
            elif command == "ADJACENT"
                string detail = ""
                if current.kind == 0
                    detail = "overlapping"
                elif current.kind == 1
                    string side = if current.ox == 0 then (if first.box.x2 == current.common.x1 then "west" else "east") else (if first.box.y2 == current.common.y1 then "south" else "north")
                    detail = a + " is " + side + " of " + b + ", edge " + box_text(current.common) + ", length {current.ox + current.oy}"
                elif current.kind == 2
                    detail = "corner only at " + point_text(current.common.x1, current.common.y1)
                else
                    detail = "not adjacent"
                emit("adjacent " + a + " " + b + ": " + detail)
            elif command == "ENCLOSE"
                int left = second.box.x1 - first.box.x1
                int bottom = second.box.y1 - first.box.y1
                int right = first.box.x2 - second.box.x2
                int top = first.box.y2 - second.box.y2
                int smallest = minimum_margin(first, second)
                string detail = "margins left {left} bottom {bottom} right {right} top {top}"
                emit("enclose " + a + " " + b + ": " + (if smallest >= 0 then "yes, " + detail + ", min {smallest}" else "no, " + detail))
            else
                if first.layer != second.layer
                    return error("different layers")
                Rectangle[] rects = on_layer(first.layer)
                int[] distances = [for nat i < len(rects) then -1]
                nat start = 0
                nat destination = 0
                for nat i < len(rects)
                    if rects[i].name == a
                        start = i
                    if rects[i].name == b
                        destination = i
                nat[] queue = [destination]
                distances[destination] = 0
                nat at = 0
                while at < len(queue)
                    nat index = queue[at]
                    at += 1
                    for nat i < len(rects)
                        if distances[i] < 0 and connected(rects[index], rects[i])
                            distances[i] = distances[index] + 1
                            queue = queue.append(i)
                if distances[start] < 0
                    emit("path " + a + " " + b + ": none")
                else
                    string[] path = [a]
                    nat index = start
                    while index != destination
                        for nat i < len(rects)
                            if distances[i] == distances[index] - 1 and connected(rects[index], rects[i])
                                index = i
                                path = path.append(rects[i].name)
                                break
                    emit("path " + a + " " + b + ": " + path.join(" -> ") + " ({len(path) - 1} steps)")
        elif command == "AT"
            int x = int.parse(args[0])
            int y = int.parse(args[1])
            string[] found = []
            for Rectangle rect = all_rects()[]
                Box bounds = rect.box
                if bounds.x1 <= x and x <= bounds.x2 and bounds.y1 <= y and y <= bounds.y2
                    bool on_x = x == bounds.x1 or x == bounds.x2
                    bool on_y = y == bounds.y1 or y == bounds.y2
                    string position = if on_x and on_y then "corner" else (if on_x or on_y then "edge" else "inside")
                    found = found.append(rect.name + " " + rect.layer + " " + position)
            emit("at " + point_text(x, y) + ": " + (if len(found) == 0 then "none" else found.join(", ")))
        elif command == "NEAREST"
            Rectangle rect = try get_rect(args[0])
            string closest = ""
            int best_gap = 0
            for Rectangle other = on_layer(rect.layer)[]
                if other.name == rect.name
                    continue
                int gap = relation(rect, other).gap
                if closest == "" or gap < best_gap
                    best_gap = gap
                    closest = other.name
            emit("nearest " + rect.name + ": " + (if closest == "" then "none" else closest + " gap {best_gap}"))
        elif command == "RULE"
            string kind = if args[0] == "ENCLOSE" then "enclose" else (if args[0] == "SPACING" then "spacing" else "width")
            string layer = args[1]
            string other = if kind == "enclose" then args[2] else ""
            int value = int.parse(args[len(args) - 1])
            if kind == "enclose" and layer == other
                return error("same layer " + layer)
            .rule_table.set(kind + " " + layer + " " + other, Rule(kind, layer, other, value))
            emit("rule " + kind + " " + args[1:].join(" "))
        elif command == "CHECK"
            string[] keys = rule_table.keys().sorted()
            if len(keys) == 0
                return error("no rules")
            nat total = 0
            for string key = keys[]
                match rule_table.get(key)
                    Rule rule
                        string[] lines = rule_violations(rule)
                        string heading = rule.kind + " " + rule.layer + (if rule.kind == "enclose" then " " + rule.other else "") + " {rule.value}"
                        report(heading + ": {len(lines)} violations", lines)
                        total += len(lines)
                    none
                        void
            emit("check: {total} violations in {len(keys)} rules")
        else
            int threshold = if command == "COVER" then int.parse(args[0]) else 1
            string layer = args[if command == "COVER" then 1 else 0]
            Rectangle[] rects = try require_layer(layer)
            if command == "DRC"
                int spacing = int.parse(args[1])
                string[] lines = spacing_lines(rects, spacing)
                report("drc " + layer + " spacing {spacing}: {len(lines)} violations", lines)
            elif command == "NETS"
                Rectangle[][] groups = find_nets(rects)
                emit("nets " + layer + ": {len(groups)}")
                for nat i < len(groups)
                    emit("net {i + 1}: " + name_list(groups[i]) + " area {make_coverage(groups[i]).area()}")
            elif command == "RENDER"
                Box bounds = Box(int.parse(args[1]), int.parse(args[2]), int.parse(args[3]), int.parse(args[4]))
                if bounds.x1 >= bounds.x2 or bounds.y1 >= bounds.y2
                    return error("invalid window")
                if bounds.x2 - bounds.x1 > 60 or bounds.y2 - bounds.y1 > 40
                    return error("window too large")
                emit("render " + layer + " " + box_text(bounds))
                for bounds.y2 > int y >= bounds.y1
                    string row = ""
                    for bounds.x1 <= int x < bounds.x2
                        nat count = 0
                        for Rectangle rect = rects[]
                            if rect.box.x1 <= x and x < rect.box.x2 and rect.box.y1 <= y and y < rect.box.y2
                                count += 1
                        row += if count == 0 then "." else (if count < 10 then count.string() else "*")
                    emit(row)
            elif command == "BBOX" or command == "DENSITY"
                Box bounds = bounding_box(rects)
                int width = bounds.x2 - bounds.x1
                int height = bounds.y2 - bounds.y1
                if command == "BBOX"
                    emit("bbox " + layer + ": " + box_text(bounds) + " {width}x{height}, {len(rects)} rectangles, density " + percentage(make_coverage(rects).area(), width * height) + "%")
                else
                    int window = int.parse(args[1])
                    int nc = (width + window - 1) / window
                    int nr = (height + window - 1) / window
                    if nc > 20 or nr > 20
                        return error("too many windows")
                    Coverage coverage = make_coverage(rects, [for int i <= nc then bounds.x1 + i * window], [for int j <= nr then bounds.y1 + j * window])
                    int[][] tiles = [for int i < nc then [for int j < nr then 0]]
                    for int i < coverage.column_count()
                        for int j < coverage.row_count()
                            if coverage.counts[i][j] > 0
                                int a = (coverage.xs[i] - bounds.x1) / window
                                int b = (coverage.ys[j] - bounds.y1) / window
                                tiles[a][b] += coverage.cell_area(i, j)
                    int denominator = window * window
                    emit("density " + layer + " window {window}: {nc}x{nr}")
                    for nr > int j >= 0
                        emit([for int i < nc then (100 * tiles[i][j] / denominator).string()].join(" "))
                    for string label = ["min", "max"][]
                        int best = tiles[0][0]
                        int best_i = 0
                        int best_j = 0
                        for int j < nr
                            for int i < nc
                                if (label == "min" and tiles[i][j] < best) or (label == "max" and tiles[i][j] > best)
                                    best = tiles[i][j]
                                    best_i = i
                                    best_j = j
                        emit(label + " " + percentage(best, denominator) + "% at " + point_text(bounds.x1 + best_i * window, bounds.y1 + best_j * window))
            else
                Coverage coverage = make_coverage(rects)
                if command == "AREA"
                    emit("area " + layer + ": {coverage.area()}")
                elif command == "COVER"
                    emit("cover " + layer + " >= {threshold}: {coverage.area(threshold)}")
                elif command == "PERIMETER"
                    emit("perimeter " + layer + ": {coverage.perimeter()}")
                elif command == "EMPTY"
                    match coverage.largest_empty()
                        Box bounds
                            int amount = (bounds.x2 - bounds.x1) * (bounds.y2 - bounds.y1)
                            emit("empty " + layer + ": " + box_text(bounds) + " area {amount}")
                        none
                            emit("empty " + layer + ": none")
                elif command == "HOLES"
                    Hole[] found = coverage.holes()
                    emit("holes " + layer + ": {len(found)}")
                    for nat i < len(found)
                        emit("hole {i + 1}: area {found[i].amount}, bbox " + box_text(found[i].bounds))
                elif command == "MERGE"
                    Box[] pieces = coverage.pieces()
                    report("merge " + layer + ": {len(pieces)} pieces", [for Box piece = pieces[] then box_text(piece)])
        if has_text(["ADD", "COPY", "MOVE", "RESIZE", "SPLIT", "LAYER", "DELETE"], command)
            history = history.append(Snapshot(before, line))

void run_program()
    string line = ""
    scan(&line)
    nat count = nat.parse(line)
    Layout workbench = Layout()
    for nat i < count
        scan(&line)
        match .workbench.execute(line)
            error failure
                emit("error: " + failure.message)
            void
                void

run_program()
