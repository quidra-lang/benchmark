int compare_text(string first, string second)
    int[] left_codes = first.codepoints()
    int[] right_codes = second.codepoints()
    nat count = if len(left_codes) < len(right_codes) then len(left_codes) else len(right_codes)
    for nat i < count
        if left_codes[i] != right_codes[i]
            return if left_codes[i] < right_codes[i] then -1 else 1
    return if len(left_codes) < len(right_codes) then -1 elif len(left_codes) > len(right_codes) then 1 else 0

void emit(string text)
    print(text + NL)

bool has<T>(T[] items, T item)
    for T value = items[]
        if value == item
            return true
    return false

int index(string[] items, string item)
    for nat i < len(items)
        if items[i] == item
            return int(i)
    return -1

bool name_ok(string word, bool upper = false)
    string letters = if upper then "ABCDEFGHIJKLMNOPQRSTUVWXYZ" else "abcdefghijklmnopqrstuvwxyz"
    if len(word) == 0 or len(word) > 16 or not letters.contains(word[0])
        return false
    for nat i < len(word)
        if not (letters + "0123456789_").contains(word[i])
            return false
    return true

bool number_ok(string word)
    if len(word) == 0 or len(word) > 9 or (len(word) > 1 and word[0] == "0")
        return false
    for nat i < len(word)
        if not "0123456789".contains(word[i])
            return false
    return true

int | error number(string word, bool positive = false)
    if not number_ok(word)
        return error("bad number " + word)
    int value = int.parse(word)
    if positive and value == 0
        return error("bad number " + word)
    return value

string | error value_word(string word)
    if not has(["0", "1", "X"], word)
        return error("bad value " + word)
    return word

string bits(int row, nat width)
    string result = ""
    int remaining = row
    for nat i < width
        result = (remaining % 2).string() + result
        remaining /= 2
    return result

string gate_value(string kind, string[] values)
    string result = values[0]
    if kind == "AND" or kind == "NAND"
        result = if has(values, "0") then "0" elif has(values, "X") then "X" else "1"
    elif kind == "OR" or kind == "NOR"
        result = if has(values, "1") then "1" elif has(values, "X") then "X" else "0"
    elif kind == "XOR" or kind == "XNOR"
        int count = 0
        for string item = values[]
            if item == "1"
                count += 1
        result = if has(values, "X") then "X" else (count % 2).string()
    elif kind == "MUX2"
        result = if values[0] == "0" then values[1] elif values[0] == "1" then values[2] elif values[1] == values[2] then values[1] else "X"
    if has(["NAND", "NOR", "XNOR", "NOT"], kind)
        result = if result == "0" then "1" elif result == "1" then "0" else "X"
    return result

class Gate(string label, string kind, string[] inputs, string output, int delay)
class Instance(string label, int module_id, string[] ports, string[] signals)
class Module(string label, string[] inputs, string[] outputs, Gate[] gates, Instance[] instances, int[] order)
class Event(int timestamp, int signal_id, string value)
class Change(int timestamp, string value)

class Circuit(string label = "", string[] inputs = [], string[] outputs = [], Gate[] gates = [])
    string[] signals = inputs.concat([for Gate gate = gates[] then gate.output])
    int[] topological = []
    bool looped = false

    void .initialize()
        string[] ready = inputs
        int remaining = 0
        for Gate gate = gates[]
            if gate.kind == "DFF"
                ready = ready.append(gate.output)
            else
                remaining += 1
        while remaining > 0
            bool changed = false
            for nat i < len(gates)
                Gate gate = gates[i]
                if gate.kind == "DFF" or has(topological, int(i))
                    continue
                bool available = true
                for string source = gate.inputs[]
                    if not has(ready, source)
                        available = false
                if available
                    topological = topological.append(int(i))
                    ready = ready.append(gate.output)
                    remaining -= 1
                    changed = true
            if not changed
                looped = true
                break

    int[] readers(string signal)
        return [for nat i < len(gates) if has(gates[i].inputs, signal) then int(i)]

    void | error combinational()
        for Gate gate = gates[]
            if gate.kind == "DFF"
                return error(label + " is not combinational")
        if looped
            return error(label + " has a combinational loop")
        if len(inputs) > 8
            return error("too many inputs {len(inputs)}")

    string evaluate(string vector, string fault = "", string stuck = "0")
        string[] values = array(len(signals), fill = "X")
        for nat i < len(inputs)
            values[i] = if inputs[i] == fault then stuck else vector[i]
        for int gate_id = topological[]
            Gate gate = gates[gate_id]
            values[index(signals, gate.output)] = if gate.output == fault then stuck else gate_value(gate.kind, [for string source = gate.inputs[] then values[index(signals, source)]])
        return [for string output = outputs[] then values[index(signals, output)]].join("")

    string[] timing(bool period)
        int[] latest = array(len(signals), fill = -1)
        int[] earliest = latest
        int[] previous = latest
        string[] endpoints = outputs
        int flip_count = 0
        if period
            endpoints = []
        else
            for nat i < len(inputs)
                latest[i] = 0
                earliest[i] = 0
        for Gate gate = gates[]
            if gate.kind == "DFF"
                flip_count += 1
                if period
                    int target = index(signals, gate.output)
                    latest[target] = gate.delay
                    earliest[target] = gate.delay
                    endpoints = endpoints.append(gate.inputs[1])
        for int gate_id = topological[]
            Gate gate = gates[gate_id]
            int target = index(signals, gate.output)
            for string source = gate.inputs[]
                int origin = index(signals, source)
                if latest[origin] < 0
                    continue
                if latest[target] < latest[origin] + gate.delay
                    latest[target] = latest[origin] + gate.delay
                    previous[target] = origin
                if earliest[target] < 0 or earliest[target] > earliest[origin] + gate.delay
                    earliest[target] = earliest[origin] + gate.delay
        string[] lines = []
        int best = -1
        for string endpoint = endpoints[]
            int target = index(signals, endpoint)
            if not period
                lines = lines.append(if latest[target] < 0 then endpoint + " unreachable" else "{endpoint} min {earliest[target]} max {latest[target]}")
            if latest[target] >= 0 and (best < 0 or latest[target] > latest[best])
                best = target
        string prefix = if period then "flip-flops {flip_count} period" else "critical"
        if best < 0
            return lines.append(prefix + " none")
        string[] path = []
        int current = best
        while current >= 0
            path = [signals[current]].concat(path)
            current = previous[current]
        return lines.append(prefix + " {latest[best]}: " + path.join(" -> "))

class Simulator()
    string[] kinds = ["AND", "OR", "NAND", "NOR", "XOR", "XNOR", "NOT", "BUF", "MUX2", "DFF"]
    Module[] modules = []
    Circuit circuit = Circuit()
    bool built = false
    string[] values = []
    string[] watch = []
    Event[] queue = []
    Change[][] history = []
    int timestamp = 0
    int processed = 0
    bool halted = false
    int error_line = 0

    int | error lookup(string label)
        for nat i < len(modules)
            if modules[i].label == label
                return int(i)
        return error("unknown module " + label)

    void | error .define(string[] lines, int first_line)
        error_line = first_line
        string[] header = lines[0].split(" ")
        if len(header) < 5 or header[2] != "IN" or header[len(header) - 1] == "OUT"
            return error("bad module header")
        int split = -1
        for 3 <= nat i < len(header)
            if header[i] == "OUT"
                if split >= 0
                    return error("bad module header")
                split = int(i)
        if split < 0
            return error("bad module header")
        string label = header[1]
        if not name_ok(label, true)
            return error("bad module name " + label)
        for Module existing = modules[]
            if existing.label == label
                return error("duplicate module " + label)
        string[] inputs = header[3:<split]
        string[] outputs = header[split + 1:]
        string[] ports = []
        for string port = inputs.concat(outputs)[]
            if not name_ok(port)
                return error("bad name " + port)
            if has(ports, port)
                return error("duplicate port " + port)
            ports = ports.append(port)
        string[] driven = inputs
        string[] used = []
        string[] reads = []
        int[] read_lines = []
        Gate[] gates = []
        Instance[] instances = []
        int[] order = []
        for 1 <= nat row < len(lines)
            error_line = first_line + int(row)
            string[] words = lines[row].split(" ")
            if has(kinds, words[0])
                if len(words) < 5 or words[len(words) - 3] != "->"
                    return error("bad gate syntax")
                int arrows = 0
                for string word = words[]
                    if word == "->"
                        arrows += 1
                if arrows != 1
                    return error("bad gate syntax")
                string gate_name = words[1]
                string kind = words[0]
                string[] sources = words[2:<len(words) - 3]
                string output = words[len(words) - 2]
                string delay_word = words[len(words) - 1]
                if not name_ok(gate_name)
                    return error("bad name " + gate_name)
                nat count = len(sources)
                nat low = if kind == "NOT" or kind == "BUF" then 1 elif kind == "MUX2" then 3 else 2
                nat high = if index(kinds, kind) < 6 then 8 else low
                if count < low or count > high
                    return error("bad input count {count} for {kind}")
                for string signal = sources.append(output)[]
                    if not name_ok(signal)
                        return error("bad name " + signal)
                if not number_ok(delay_word)
                    return error("bad delay " + delay_word)
                int delay = int.parse(delay_word)
                if delay > 1000
                    return error("bad delay " + delay_word)
                if has(used, gate_name)
                    return error("duplicate name " + gate_name)
                if has(driven, output)
                    return error("multiple drivers for " + output)
                driven = driven.append(output)
                used = used.append(gate_name)
                order = order.append(int(len(gates)))
                gates = gates.append(Gate(gate_name, kind, sources, output, delay))
                for string source = sources[]
                    reads = reads.append(source)
                    read_lines = read_lines.append(error_line)
            elif words[0] == "INST"
                if len(words) < 3
                    return error("bad instance syntax")
                string instance_name = words[1]
                if not name_ok(instance_name)
                    return error("bad name " + instance_name)
                int module_id = try lookup(words[2])
                Module nested = modules[module_id]
                string[] connected_ports = []
                string[] connected_signals = []
                for string connection = words[3:][]
                    string[] pair = connection.split("=")
                    if len(pair) != 2 or pair[0] == "" or pair[1] == ""
                        return error("bad connection " + connection)
                    if not has(nested.inputs.concat(nested.outputs), pair[0])
                        return error("unknown port " + pair[0])
                    if has(connected_ports, pair[0])
                        return error("duplicate connection " + pair[0])
                    if not name_ok(pair[1])
                        return error("bad name " + pair[1])
                    connected_ports = connected_ports.append(pair[0])
                    connected_signals = connected_signals.append(pair[1])
                for string port = nested.inputs[]
                    if not has(connected_ports, port)
                        return error("unconnected input " + port)
                if has(used, instance_name)
                    return error("duplicate name " + instance_name)
                for nat i < len(connected_ports)
                    string signal = connected_signals[i]
                    if has(nested.outputs, connected_ports[i])
                        if has(driven, signal)
                            return error("multiple drivers for " + signal)
                        driven = driven.append(signal)
                    else
                        reads = reads.append(signal)
                        read_lines = read_lines.append(error_line)
                used = used.append(instance_name)
                order = order.append(-1 - int(len(instances)))
                instances = instances.append(Instance(instance_name, module_id, connected_ports, connected_signals))
            else
                return error("unknown statement " + words[0])
        for string output = outputs[]
            reads = reads.append(output)
            read_lines = read_lines.append(first_line)
        for nat i < len(reads)
            if not has(driven, reads[i])
                error_line = read_lines[i]
                return error("undriven signal " + reads[i])
        modules = modules.append(Module(label, inputs, outputs, gates, instances, order))
        emit("defined {label} inputs {len(inputs)} outputs {len(outputs)} gates {len(gates)} instances {len(instances)}")

    string actual(string signal, string prefix, string[] ports, string[] destinations)
        int found = index(ports, signal)
        return if found >= 0 then destinations[found] else prefix + signal

    Gate[] expand(int module_id, string prefix, string[] ports, string[] destinations)
        Module definition = modules[module_id]
        Gate[] result = []
        for int item = definition.order[]
            if item >= 0
                Gate gate = definition.gates[item]
                string[] sources = [for string signal = gate.inputs[] then actual(signal, prefix, ports, destinations)]
                result = result.append(Gate(prefix + gate.label, gate.kind, sources, actual(gate.output, prefix, ports, destinations), gate.delay))
            else
                Instance nested = definition.instances[-1 - item]
                string[] mapping = [for string signal = nested.signals[] then actual(signal, prefix, ports, destinations)]
                result = result.concat(expand(nested.module_id, prefix + nested.label + ".", nested.ports, mapping))
        return result

    Circuit flatten(int module_id)
        Module definition = modules[module_id]
        Circuit result = Circuit(definition.label, definition.inputs, definition.outputs, expand(module_id, "", [], []))
        .result.initialize()
        return result

    void hierarchy(int module_id, nat depth)
        for Instance nested = modules[module_id].instances[]
            emit(string.repeat(" ", depth * 2) + nested.label + " " + modules[nested.module_id].label)
            hierarchy(nested.module_id, depth + 1)

    void .reset()
        values = array(len(circuit.signals), fill = "X")
        Change[] empty = []
        history = array(len(circuit.signals), fill = empty)
        queue = []
        timestamp = 0
        processed = 0
        halted = false

    void .schedule(int when, int signal_id, string value)
        nat insertion = len(queue)
        while insertion > 0 and queue[insertion - 1].timestamp > when
            insertion -= 1
        queue = queue[:<insertion].append(Event(when, signal_id, value)).concat(queue[insertion:])

    void .run(int end)
        int event_count = 0
        int glitches = 0
        while len(queue) > 0 and queue[0].timestamp < end
            int when = queue[0].timestamp
            string[] original = values
            bool[] changed = array(len(values), fill = false)
            int step_count = 0
            while len(queue) > 0 and queue[0].timestamp == when
                if step_count == 1000
                    queue = []
                    timestamp = when
                    halted = true
                    emit("halted: oscillation at time {when}")
                    return
                Event event = queue[0]
                queue = queue[1:]
                step_count += 1
                processed += 1
                event_count += 1
                string before = values[event.signal_id]
                if before == event.value
                    continue
                values[event.signal_id] = event.value
                changed[event.signal_id] = true
                string signal = circuit.signals[event.signal_id]
                for int gate_id = circuit.readers(signal)[]
                    Gate gate = circuit.gates[gate_id]
                    if gate.kind != "DFF"
                        string output = gate_value(gate.kind, [for string source = gate.inputs[] then values[index(circuit.signals, source)]])
                        .schedule(when + gate.delay, index(circuit.signals, gate.output), output)
                    elif signal == gate.inputs[0] and before == "0" and event.value == "1"
                        .schedule(when + gate.delay, index(circuit.signals, gate.output), values[index(circuit.signals, gate.inputs[1])])
            for nat i < len(values)
                if values[i] != original[i]
                    history[i] = history[i].append(Change(when, values[i]))
                elif changed[i]
                    glitches += 1
            for string signal = watch[]
                int signal_id = index(circuit.signals, signal)
                if values[signal_id] != original[signal_id]
                    emit("{when} {signal} {values[signal_id]}")
        timestamp = end
        emit("run {end} events {event_count} glitches {glitches} pending {len(queue)}")

    int | error require_signal(string signal, bool input_only = false)
        int result = index(if input_only then circuit.inputs else circuit.signals, signal)
        if result < 0
            return error((if input_only then "not an input " else "unknown signal ") + signal)
        return result

    int | error parse_time(string word)
        int result = try number(word)
        if result < timestamp
            return error("time {result} is in the past")
        return result

    string[] describe(string[] signals)
        return [for string signal = signals[] then signal + "=" + values[index(circuit.signals, signal)]]

    void | error .execute(string[] words)
        string[] commands = ["BUILD", "RESET", "SET", "APPLY", "PULSE", "CLOCK", "RUN", "WATCH", "UNWATCH", "SHOW", "CHECK", "PROBE", "WAVE", "HISTORY", "ACTIVITY", "STATUS", "MODULES", "NETLIST", "HIERARCHY", "STATS", "TRUTHTABLE", "EQUIV", "FAULTS", "CRITICAL", "PERIOD"]
        int[] counts = [1, 0, 3, 2, 3, 4, 1, 1, 1, 0, 2, 1, 2, 1, 1, 0, 0, 1, 1, 1, 1, 2, 1, 1, 1]
        string command = words[0]
        string[] args = words[1:]
        int command_id = index(commands, command)
        if command_id < 0
            return error("unknown command " + command)
        if int(len(args)) < counts[command_id] or (not has(["WATCH", "UNWATCH", "SHOW"], command) and int(len(args)) != counts[command_id])
            return error("wrong argument count")
        if command_id >= 1 and command_id <= 15 and not built
            return error("no circuit")
        if command_id >= 2 and command_id <= 6 and halted
            return error("simulation halted")
        if command == "MODULES"
            emit("modules {len(modules)}")
            for nat i < len(modules)
                Circuit flat = flatten(int(i))
                emit("{flat.label} inputs {len(flat.inputs)} outputs {len(flat.outputs)} gates {len(flat.gates)}")
            return
        if command == "BUILD" or command_id >= 17
            int module_id = try lookup(args[0])
            Circuit flat = flatten(module_id)
            if command == "BUILD"
                circuit = flat
                built = true
                watch = []
                .reset()
                emit("built {flat.label} signals {len(flat.signals)} gates {len(flat.gates)}")
            elif command == "HIERARCHY"
                emit(flat.label)
                hierarchy(module_id, 1)
            elif command == "NETLIST"
                emit("netlist {flat.label} gates {len(flat.gates)} signals {len(flat.signals)}")
                for Gate gate = flat.gates[]
                    emit(gate.label + " " + gate.kind + " " + gate.inputs.join(" ") + " -> {gate.output} {gate.delay}")
            elif command == "STATS"
                int[] levels = array(len(flat.signals), fill = 0)
                int depth = 0
                for int gate_id = flat.topological[]
                    Gate gate = flat.gates[gate_id]
                    int level = 0
                    for string source = gate.inputs[]
                        if levels[index(flat.signals, source)] > level
                            level = levels[index(flat.signals, source)]
                    levels[index(flat.signals, gate.output)] = level + 1
                    if level + 1 > depth
                        depth = level + 1
                string depth_word = if flat.looped then "-" else depth.string()
                emit("stats {flat.label} gates {len(flat.gates)} signals {len(flat.signals)} depth {depth_word}")
                string[] type_words = ["types"]
                for string kind = kinds[]
                    int count = 0
                    for Gate gate = flat.gates[]
                        if gate.kind == kind
                            count += 1
                    if count > 0
                        type_words = type_words.append(kind).append(count.string())
                emit(type_words.join(" "))
                string best = flat.signals[0]
                for string signal = flat.signals[]
                    if len(flat.readers(signal)) > len(flat.readers(best))
                        best = signal
                emit("max fanout {best} {len(flat.readers(best))}")
            elif command == "CRITICAL" or command == "PERIOD"
                bool has_flip = false
                for Gate gate = flat.gates[]
                    if gate.kind == "DFF"
                        has_flip = true
                if command == "PERIOD" and not has_flip
                    return error(flat.label + " has no flip-flops")
                if flat.looped
                    return error(flat.label + " has a combinational loop")
                for string line = flat.timing(command == "PERIOD")[]
                    emit(line)
            else
                Circuit other = Circuit()
                if command == "EQUIV"
                    int other_id = try lookup(args[1])
                    other = flatten(other_id)
                try flat.combinational()
                if command == "EQUIV"
                    try other.combinational()
                    if len(flat.inputs) != len(other.inputs) or len(flat.outputs) != len(other.outputs)
                        return error("port mismatch")
                int row_count = 1
                for nat i < len(flat.inputs)
                    row_count *= 2
                string[] vectors = [for int row < row_count then bits(row, len(flat.inputs))]
                if command == "TRUTHTABLE"
                    emit(flat.inputs.append("|").concat(flat.outputs).join(" "))
                    for string vector = vectors[]
                        string output = flat.evaluate(vector)
                        emit([for nat i < len(vector) then vector[i]].append("|").concat([for nat i < len(output) then output[i]]).join(" "))
                elif command == "EQUIV"
                    for string vector = vectors[]
                        string first = flat.evaluate(vector)
                        string second = other.evaluate(vector)
                        if first != second
                            emit("not equivalent at {vector}: {first} vs {second}")
                            return
                    emit("equivalent")
                else
                    string[] undetected = []
                    bool[] tests = array(len(vectors), fill = false)
                    for string signal = flat.signals[]
                        for string stuck = ["0", "1"][]
                            bool detected = false
                            for nat row < len(vectors)
                                if flat.evaluate(vectors[row], signal, stuck) != flat.evaluate(vectors[row])
                                    tests[row] = true
                                    detected = true
                                    break
                            if not detected
                                undetected = undetected.append(signal + "/" + stuck)
                    nat total = 2 * len(flat.signals)
                    emit("faults {total} detected {total - len(undetected)}")
                    for string fault = undetected[]
                        emit("undetected " + fault)
                    emit(["tests"].concat([for nat row < len(vectors) if tests[row] then vectors[row]]).join(" "))
            return
        if command == "RESET"
            .reset()
            emit("reset")
        elif command == "SET"
            int when = try parse_time(args[0])
            int signal_id = try require_signal(args[1], true)
            string value = try value_word(args[2])
            .schedule(when, signal_id, value)
            emit("set {args[1]} {value} at {when}")
        elif command == "APPLY"
            int when = try parse_time(args[0])
            string vector = args[1]
            bool valid = len(vector) == len(circuit.inputs)
            for nat i < len(vector)
                if not "01X".contains(vector[i])
                    valid = false
            if not valid
                return error("bad vector " + vector)
            for nat i < len(vector)
                .schedule(when, int(i), vector[i])
            emit("apply {vector} at {when}")
        elif command == "PULSE" or command == "CLOCK"
            int signal_id = try require_signal(args[0], true)
            int when = try parse_time(args[1])
            int width = try number(args[2], true)
            if command == "PULSE"
                .schedule(when, signal_id, "1")
                .schedule(when + width, signal_id, "0")
                emit("pulse {args[0]} {when} {when + width}")
            else
                int count = try number(args[3], true)
                for int i < count
                    .schedule(when + i * width, signal_id, (i % 2).string())
                emit("clock {args[0]} events {count} last {when + (count - 1) * width}")
        elif command == "RUN"
            int end = try number(args[0])
            if end <= timestamp
                return error("time {end} is not after {timestamp}")
            .run(end)
        elif command == "WATCH" or command == "UNWATCH"
            string[] seen = []
            for string signal = args[]
                int checked = try require_signal(signal)
                if has(seen, signal) or (has(watch, signal) == (command == "WATCH"))
                    return error((if command == "WATCH" then "already watched " else "not watched ") + signal)
                seen = seen.append(signal)
            watch = if command == "WATCH" then watch.concat(args) else [for string signal = watch[] if not has(args, signal) then signal]
            emit("watching " + (if len(watch) == 0 then "nothing" else watch.join(" ")))
        elif command == "SHOW"
            for string signal = args[]
                int checked = try require_signal(signal)
            emit((if len(args) > 0 then describe(args) else describe(circuit.inputs).append("|").concat(describe(circuit.outputs))).join(" "))
        elif command == "CHECK" or command == "HISTORY" or command == "PROBE"
            string signal = args[0]
            int signal_id = try require_signal(signal)
            if command == "CHECK"
                string expected = try value_word(args[1])
                emit("check {signal}={expected} " + (if values[signal_id] == expected then "ok" else "failed ({values[signal_id]})"))
            elif command == "HISTORY"
                string[] records = ["history {signal} changes {len(history[signal_id])}"]
                for Change change = history[signal_id][]
                    records = records.append("{change.timestamp}:{change.value}")
                emit(records.join(" "))
            else
                string prefix = "{signal}={values[signal_id]} driven by "
                if has(circuit.inputs, signal)
                    emit(prefix + "input")
                else
                    for Gate gate = circuit.gates[]
                        if gate.output == signal
                            emit(prefix + gate.label + " " + gate.kind + " " + describe(gate.inputs).join(" ") + " delay {gate.delay}")
                int[] readers = circuit.readers(signal)
                emit(["fanout {len(readers)}"].concat([for int gate_id = readers[] then circuit.gates[gate_id].label]).join(" "))
        elif command == "WAVE"
            int start = try number(args[0])
            int end = try number(args[1])
            if not (start < end and end <= timestamp)
                return error("bad range {start} {end}")
            if len(watch) == 0
                return error("nothing watched")
            for string signal = watch[]
                Change[] changes = history[index(circuit.signals, signal)]
                nat cursor = 0
                string value = "X"
                string wave = ""
                for start <= int when < end
                    while cursor < len(changes) and changes[cursor].timestamp <= when
                        value = changes[cursor].value
                        cursor += 1
                    wave += value
                emit(signal + " " + wave)
        elif command == "ACTIVITY"
            int count = try number(args[0], true)
            string[] ranked = circuit.signals.sorted()
            for nat i < len(ranked)
                nat best = i
                for i + 1 <= nat j < len(ranked)
                    if len(history[index(circuit.signals, ranked[j])]) > len(history[index(circuit.signals, ranked[best])]) or (len(history[index(circuit.signals, ranked[j])]) == len(history[index(circuit.signals, ranked[best])]) and compare_text(ranked[j], ranked[best]) < 0)
                        best = j
                string saved = ranked[i]
                ranked[i] = ranked[best]
                ranked[best] = saved
            for nat i < len(ranked)
                if int(i) >= count
                    break
                emit("{ranked[i]} {len(history[index(circuit.signals, ranked[i])])}")
        else
            string halted_word = if halted then "yes" else "no"
            emit("circuit {circuit.label} time {timestamp} pending {len(queue)} events {processed} halted {halted_word}")
            string[] totals = []
            for string value = ["0", "1", "X"][]
                int count = 0
                for string actual_value = values[]
                    if actual_value == value
                        count += 1
                totals = totals.append("{value}:{count}")
            emit("values " + totals.join(" "))

void run_commands()
    Simulator simulator = Simulator()
    int line_number = 0
    while true
        string line = ""
        scan(&line)
        line_number += 1
        if line == "END"
            break
        string[] words = line.split(" ")
        if words[0] == "MODULE"
            int first_line = line_number
            string[] lines = [line]
            while true
                scan(&line)
                line_number += 1
                if line == "ENDMODULE"
                    break
                lines = lines.append(line)
            match .simulator.define(lines, first_line)
                void
                    void
                error failure
                    emit("error: line {simulator.error_line}: " + failure.message)
        else
            match .simulator.execute(words)
                void
                    void
                error failure
                    emit("error: line {line_number}: " + failure.message)

run_commands()
