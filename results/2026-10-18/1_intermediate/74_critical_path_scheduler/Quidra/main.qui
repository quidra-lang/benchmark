void emit(string text)
    print(text + NL)

bool has_word(string[] items, string value)
    for string item = items[]
        if item == value
            return true
    return false

nat position(string[] items, string value)
    for string item = items[nat i]
        if item == value
            return i
    return len(items)

bool has_day(int[] items, int value)
    for int item = items[]
        if item == value
            return true
    return false

int sum_numbers(int[] items)
    int result = 0
    for int item = items[]
        result += item
    return result

int maximum(int[] items)
    int result = items[0]
    for int item = items[]
        if item > result
            result = item
    return result

int minimum(int[] items)
    int result = items[0]
    for int item = items[]
        if item < result
            result = item
    return result

string signed_text(int value)
    return (if value >= 0 then "+" else "") + "{value}"

string decimals(int numerator, int denominator)
    int cents = numerator * 100 / denominator
    return "{cents / 100}.{cents % 100:int=2,zero}"

string name_list(string[] items)
    return if len(items) == 0 then "none" else items.sorted().join(" ")

bool leap_year(int year)
    return year % 400 == 0 or (year % 4 == 0 and year % 100 != 0)

int[] month_lengths(int year)
    return [31, if leap_year(year) then 29 else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

int | error parse_date(string text)
    int year = int.parse(text[:<4])
    int month = int.parse(text[5:<7])
    int day = int.parse(text[8:])
    if month < 1 or month > 12
        return error("invalid date {text}")
    int[] lengths = month_lengths(year)
    if day < 1 or day > lengths[nat(month - 1)]
        return error("invalid date {text}")
    int result = day - 1
    for 2000 <= int y < year
        result += if leap_year(y) then 366 else 365
    for 1 <= int m < month
        result += lengths[nat(m - 1)]
    return result

string date_text(int ordinal)
    int year = 2000
    int rest = ordinal
    while rest >= (if leap_year(year) then 366 else 365)
        rest -= if leap_year(year) then 366 else 365
        year += 1
    int[] lengths = month_lengths(year)
    nat month = 0
    while rest >= lengths[month]
        rest -= lengths[month]
        month += 1
    string weekday = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][(ordinal + 5) % 7]
    return "{year:int=4,zero}-{month + 1:int=2,zero}-{rest + 1:int=2,zero} {weekday}"

class WorkTask(int base, string resource, int units)
    int not_before = 0
    int crash_limit = -1
    int crash_cost = 0
    int crashed = 0
    int[] estimate = []

    int current_duration()
        return base - crashed

class Dependency(string a, string b, string kind, int lag)
class Schedule(string[] names, int[] durations, int[] es, int[] ef, int[] ls, int[] lf, int[] tf, int[] ff, int project_length)
    nat at(string name)
        return position(names, name)

    bool critical(string name)
        return tf[at(name)] == 0

    string[] critical_names()
        return [for string name = names[nat i] if tf[i] == 0 then name]

    int margin(Dependency dep)
        nat first = at(dep.a)
        nat last = at(dep.b)
        if dep.kind == "FS"
            return es[last] - ef[first] - dep.lag
        if dep.kind == "SS"
            return es[last] - es[first] - dep.lag
        return ef[last] - ef[first] - dep.lag

    int[] fields(string name)
        nat index = at(name)
        return [es[index], ef[index], ls[index], lf[index], tf[index], ff[index]]

    string[] by_start()
        string[] result = []
        for string name = names[]
            nat index = 0
            while index < len(result) and es[at(result[index])] <= es[at(name)]
                index += 1
            result = result[:<index].append(name).concat(result[index:])
        return result

int start_bound(Dependency dep, string[] names, int[] starts, int[] finishes, int duration)
    nat index = position(names, dep.a)
    if dep.kind == "FS"
        return finishes[index] + dep.lag
    if dep.kind == "SS"
        return starts[index] + dep.lag
    return finishes[index] + dep.lag - duration

int finish_bound(Dependency dep, string[] names, int[] starts, int[] finishes, int duration)
    nat index = position(names, dep.b)
    if dep.kind == "FS"
        return starts[index] - dep.lag
    if dep.kind == "SS"
        return starts[index] - dep.lag + duration
    return finishes[index] - dep.lag

class Project()
    map.Map<string, WorkTask> tasks
    Dependency[] dependencies = []
    int start_date = -1
    int[] holidays = []
    int deadline_date = -1
    map.Map<string, int> capacities
    bool baseline_set = false
    Schedule baseline = Schedule([], [], [], [], [], [], [], [], 0)

    string[] task_names()
        return tasks.keys().sorted()

    WorkTask get_task(string name)
        match tasks.get(name)
            WorkTask value
                return value
            none
                return WorkTask(1, "", 0)

    void | error check_task(string name)
        if not tasks.has(name)
            return error("unknown task {name}")

    Dependency[] pred_links(string name)
        Dependency[] result = []
        for string other = task_names()[]
            for Dependency dep = dependencies[]
                if dep.a == other and dep.b == name
                    result = result.append(dep)
        return result

    Dependency[] succ_links(string name)
        Dependency[] result = []
        for string other = task_names()[]
            for Dependency dep = dependencies[]
                if dep.a == name and dep.b == other
                    result = result.append(dep)
        return result

    string[] topological()
        string[] pending = task_names()
        string[] result = []
        while len(pending) > 0
            string selected = ""
            for string name = pending[]
                bool ready = true
                for Dependency dep = pred_links(name)[]
                    if has_word(pending, dep.a)
                        ready = false
                        break
                if ready
                    selected = name
                    break
            if selected == ""
                return result
            result = result.append(selected)
            pending = [for string name = pending[] if name != selected then name]
        return result

    string cycle_notation(string[] order)
        string[] remaining = [for string name = task_names()[] if not has_word(order, name) then name]
        string[] walk = [remaining[0]]
        while true
            string previous = ""
            for Dependency dep = pred_links(walk[len(walk) - 1])[]
                if has_word(remaining, dep.a)
                    previous = dep.a
                    break
            nat at = position(walk, previous)
            if at < len(walk)
                string[] cycle = [previous].concat(walk[at + 1:][::-1])
                string first = cycle.sorted()[0]
                nat index = position(cycle, first)
                cycle = cycle[index:].concat(cycle[:<index])
                return cycle.append(cycle[0]).join(" -> ")
            walk = walk.append(previous)

    string[] | error analysis_order()
        if tasks.size() == 0
            return error("no tasks")
        string[] result = topological()
        if len(result) < tasks.size()
            return error("cycle {cycle_notation(result)}")
        return result

    Schedule compute_schedule(string[] order, string changed = "", int replacement = 0)
        string[] names = task_names()
        int[] durations = [for string name = names[] then if name == changed then replacement else get_task(name).current_duration()]
        int[] es = array(len(names), fill = 0)
        int[] ef = es
        int[] ls = es
        int[] lf = es
        for string name = order[]
            nat index = position(names, name)
            int start = get_task(name).not_before
            for Dependency dep = pred_links(name)[]
                int bound = start_bound(dep, names, es, ef, durations[index])
                if bound > start
                    start = bound
            es[index] = start
            ef[index] = start + durations[index]
        int project_length = maximum(ef)
        for string name = order[::-1][]
            nat index = position(names, name)
            int finish = project_length
            for Dependency dep = succ_links(name)[]
                int bound = finish_bound(dep, names, ls, lf, durations[index])
                if bound < finish
                    finish = bound
            lf[index] = finish
            ls[index] = finish - durations[index]
        int[] tf = [for nat i < len(names) then ls[i] - es[i]]
        int[] ff = [for nat i < len(names) then project_length - ef[i]]
        Schedule result = Schedule(names, durations, es, ef, ls, lf, tf, ff, project_length)
        for string name = names[nat i]
            for Dependency dep = succ_links(name)[]
                int value = result.margin(dep)
                if value < ff[i]
                    ff[i] = value
        result.ff = ff
        return result

    string[][] critical_walk(Schedule result, string[] path)
        string name = path[len(path) - 1]
        string[][] paths = []
        for Dependency dep = succ_links(name)[]
            if result.critical(dep.b) and result.margin(dep) == 0
                paths = paths.concat(critical_walk(result, path.append(dep.b)))
        return if len(paths) == 0 then [path] else paths

    string[][] critical_paths(Schedule result)
        string[][] paths = []
        for string name = result.critical_names()[]
            bool root = true
            for Dependency dep = pred_links(name)[]
                if result.critical(dep.a) and result.margin(dep) == 0
                    root = false
            if root
                paths = paths.concat(critical_walk(result, [name]))
        return paths

    string[] resources()
        string[] result = []
        for string name = task_names()[]
            string resource = get_task(name).resource
            if not has_word(result, resource)
                result = result.append(resource)
        return result.sorted()

    int[] usage(string resource, string[] names, int[] starts, int[] finishes, int length)
        int[] result = array(nat(length), fill = 0)
        for string name = names[nat i]
            WorkTask task = get_task(name)
            if task.resource == resource
                for starts[i] <= int day < finishes[i]
                    result[nat(day)] += task.units
        return result

    bool working_day(int day)
        return (day + 5) % 7 < 5 and not has_day(holidays, day)

    int[] working_dates(int count)
        int[] result = []
        int day = start_date
        while len(result) < nat(count)
            if working_day(day)
                result = result.append(day)
            day += 1
        return result

    int work_between(int after, int until)
        int result = 0
        for after + 1 <= int day <= until
            if working_day(day)
                result += 1
        return result

    int capacity_for(string resource, int fallback)
        match capacities.get(resource)
            int value
                return value
            none
                return fallback

    void calendar_report(Schedule result)
        int[] dates = working_dates(result.project_length)
        for string name = result.by_start()[]
            nat index = result.at(name)
            emit("{name} {date_text(dates[nat(result.es[index])])} - {date_text(dates[nat(result.ef[index] - 1)])}")
        int first = dates[0]
        int last = dates[len(dates) - 1]
        emit("project {date_text(first)} - {date_text(last)}, {result.project_length} working days, {last - first + 1} calendar days")
        if deadline_date >= 0
            if last <= deadline_date
                emit("deadline {date_text(deadline_date)} met, {work_between(last, deadline_date)} working days to spare")
            else
                emit("deadline {date_text(deadline_date)} missed by {work_between(deadline_date, last)} working days")
        string[] spanned = [for int day = holidays.sorted()[] if (day + 5) % 7 < 5 and day >= first and day <= last then date_text(day)]
        emit("holidays in span: " + (if len(spanned) == 0 then "none" else spanned.join(", ")))

    void | error level_report(Schedule result, int limit)
        string[] names = task_names()
        for string name = names[]
            WorkTask task = get_task(name)
            int capacity = capacity_for(task.resource, limit)
            if task.units > capacity
                return error("capacity {capacity} too small for {name}")
        string[] decided = []
        int[] starts = array(len(names), fill = 0)
        int[] finishes = starts
        while len(decided) < len(names)
            string chosen = ""
            for string name = names[]
                if has_word(decided, name)
                    continue
                bool ready = true
                for Dependency dep = pred_links(name)[]
                    if not has_word(decided, dep.a)
                        ready = false
                if ready and (chosen == "" or result.ls[result.at(name)] < result.ls[result.at(chosen)])
                    chosen = name
            WorkTask task = get_task(chosen)
            nat index = position(names, chosen)
            int duration = task.current_duration()
            int start = task.not_before
            for Dependency dep = pred_links(chosen)[]
                int bound = start_bound(dep, names, starts, finishes, duration)
                if bound > start
                    start = bound
            while true
                bool available = true
                for start <= int day < start + duration
                    int used = 0
                    for string name = decided[]
                        nat other = position(names, name)
                        WorkTask old = get_task(name)
                        if old.resource == task.resource and starts[other] <= day and day < finishes[other]
                            used += old.units
                    if used + task.units > capacity_for(task.resource, limit)
                        available = false
                        break
                if available
                    break
                start += 1
            starts[index] = start
            finishes[index] = start + duration
            decided = decided.append(chosen)
        int length = maximum(finishes)
        emit("level capacity {limit}: duration {result.project_length} -> {length}")
        for string name = decided[]
            nat index = position(names, name)
            emit("{name} start {starts[index]} finish {finishes[index]} shift {starts[index] - result.es[index]}")
        for string resource = resources()[]
            int before = maximum(usage(resource, names, result.es, result.ef, result.project_length))
            int after = maximum(usage(resource, names, starts, finishes, length))
            emit("resource {resource} capacity {capacity_for(resource, limit)} peak {before} -> {after}")

    void .crash_project(string[] order, int budget)
        int remaining = budget
        nat steps = 0
        Schedule result = compute_schedule(order)
        int initial = result.project_length
        string reason = ""
        while true
            string chosen = ""
            for string name = task_names()[]
                WorkTask task = get_task(name)
                if result.critical(name) and task.crash_limit >= 0 and task.crashed < task.crash_limit
                    if compute_schedule(order, name, task.current_duration() - 1).project_length < result.project_length
                        if chosen == "" or task.crash_cost < get_task(chosen).crash_cost
                            chosen = name
            if chosen == ""
                reason = "no candidate"
                break
            WorkTask task = get_task(chosen)
            if task.crash_cost > remaining
                reason = "insufficient budget"
                break
            int previous = task.current_duration()
            task.crashed += 1
            .tasks.set(chosen, task)
            remaining -= task.crash_cost
            steps += 1
            result = compute_schedule(order)
            emit("step {steps}: {chosen} {previous} -> {task.current_duration()}, cost {task.crash_cost}, project {result.project_length}")
        emit("crash done: {steps} days, cost {budget - remaining}, project {initial} -> {result.project_length}, budget left {remaining}, {reason}")

    void | error .execute(string line)
        string[] words = line.split(" ")
        string command = words[0]
        string[] args = words[1:]
        if command == "TASK"
            if tasks.has(args[0])
                return error("task {args[0]} already exists")
            .tasks.set(args[0], WorkTask(int.parse(args[1]), args[2], int.parse(args[3])))
            emit("task {args[0]} added")
        elif command == "DEP" or command == "UNDEP"
            try check_task(args[0])
            try check_task(args[1])
            nat at = len(dependencies)
            for Dependency dep = dependencies[nat i]
                if dep.a == args[0] and dep.b == args[1]
                    at = i
                    break
            if command == "DEP"
                if args[0] == args[1]
                    return error("self dependency {args[0]}")
                if at < len(dependencies)
                    return error("dependency {args[0]} -> {args[1]} already exists")
                int lag = int.parse(args[3])
                dependencies = dependencies.append(Dependency(args[0], args[1], args[2], lag))
                emit("dependency {args[0]} -> {args[1]} {args[2]}{signed_text(lag)} added")
            else
                if at == len(dependencies)
                    return error("no dependency {args[0]} -> {args[1]}")
                dependencies = dependencies[:<at].concat(dependencies[at + 1:])
                emit("dependency {args[0]} -> {args[1]} removed")
        elif command == "REMOVE"
            try check_task(args[0])
            nat old = len(dependencies)
            dependencies = [for Dependency dep = dependencies[] if dep.a != args[0] and dep.b != args[0] then dep]
            bool removed = .tasks.remove(args[0])
            emit("task {args[0]} removed with {old - len(dependencies)} dependencies")
        elif command == "NOTBEFORE" or command == "CRASHCOST" or command == "UNCRASH" or command == "PERT"
            try check_task(args[0])
            WorkTask task = get_task(args[0])
            if command == "NOTBEFORE"
                task.not_before = int.parse(args[1])
                emit("notbefore {args[0]} {args[1]}")
            elif command == "CRASHCOST"
                int limit = int.parse(args[1])
                if limit >= task.base
                    return error("crash limit too large for {args[0]}")
                if limit < task.crashed
                    return error("crash limit below used days for {args[0]}")
                task.crash_limit = limit
                task.crash_cost = int.parse(args[2])
                emit("crash {args[0]} max {limit} cost {args[2]}")
            elif command == "UNCRASH"
                emit("uncrash {args[0]} restored {task.crashed} days")
                task.crashed = 0
            else
                int o = int.parse(args[1])
                int m = int.parse(args[2])
                int p = int.parse(args[3])
                if not (o <= m and m <= p)
                    return error("invalid estimate")
                task.estimate = [o, m, p]
                emit("pert {args[0]} expected {decimals(o + 4 * m + p, 6)} variance {decimals((p - o) ^ 2, 36)}")
            .tasks.set(args[0], task)
        elif command == "CAPACITY"
            .capacities.set(args[0], int.parse(args[1]))
            emit("capacity {args[0]} {args[1]}")
        elif command == "START" or command == "HOLIDAY" or command == "DEADLINE"
            int date = try parse_date(args[0])
            string title = ""
            if command == "START"
                start_date = date
                title = "start"
            elif command == "DEADLINE"
                deadline_date = date
                title = "deadline"
            else
                if has_day(holidays, date)
                    return error("duplicate holiday {args[0]}")
                holidays = holidays.append(date)
                title = "holiday"
            emit("{title} {date_text(date)}")
        elif command == "LIST"
            emit("tasks {tasks.size()}, dependencies {len(dependencies)}, holidays {len(holidays)}")
            for string name = task_names()[]
                WorkTask task = get_task(name)
                string[] previous = [for Dependency dep = pred_links(name)[] then dep.a]
                emit("{name} duration {task.current_duration()} resource {task.resource} units {task.units} preds {name_list(previous)}")
        elif command == "SHOW"
            try check_task(args[0])
            string name = args[0]
            WorkTask task = get_task(name)
            emit("task {name} duration {task.current_duration()} resource {task.resource} units {task.units}" + (if task.not_before == 0 then "" else " notbefore {task.not_before}"))
            string[] previous = [for Dependency dep = pred_links(name)[] then "{dep.a} {dep.kind}{signed_text(dep.lag)}"]
            string[] following = [for Dependency dep = succ_links(name)[] then "{dep.b} {dep.kind}{signed_text(dep.lag)}"]
            emit("preds: " + (if len(previous) == 0 then "none" else previous.join(", ")))
            emit("succs: " + (if len(following) == 0 then "none" else following.join(", ")))
            emit("crash: " + (if task.crash_limit < 0 then "none" else "max {task.crash_limit} used {task.crashed} cost {task.crash_cost}"))
            emit("pert: " + (if len(task.estimate) == 0 then "none" else [for int value = task.estimate[] then value.string()].join(" ")))
            string[] order = topological()
            if len(order) < tasks.size()
                emit("schedule: unavailable")
            else
                Schedule result = compute_schedule(order)
                string[] labels = ["ES", "EF", "LS", "LF", "TF", "FF"]
                string[] fields = [for int value = result.fields(name)[nat i] then "{labels[i]} {value}"]
                emit("schedule: {fields.join(" ")}" + (if result.critical(name) then " critical" else ""))
        elif command == "IMPACT"
            try check_task(args[0])
            string[] reached = []
            string[] queue = [args[0]]
            nat at = 0
            while at < len(queue)
                string current = queue[at]
                at += 1
                for Dependency dep = succ_links(current)[]
                    if not has_word(reached, dep.b)
                        reached = reached.append(dep.b)
                        queue = queue.append(dep.b)
            reached = [for string name = reached[] if name != args[0] then name]
            emit("impact {args[0]}: {name_list(reached)}")
        else
            string[] order = try analysis_order()
            if command == "CALENDAR" and start_date < 0
                return error("no start date")
            if command == "LOAD" and not has_word(resources(), args[0])
                return error("unknown resource {args[0]}")
            if command == "WHATIF"
                try check_task(args[0])
            if command == "VARIANCE" and not baseline_set
                return error("no baseline")
            Schedule result = compute_schedule(order)
            string[] names = task_names()
            if command == "CPM"
                nat width = 4
                for string name = names[]
                    if len(name) > width
                        width = len(name)
                string header = "TASK" + string.repeat(" ", width - 4)
                for string label = ["DUR", "ES", "EF", "LS", "LF", "TF", "FF"][]
                    header += string.repeat(" ", 5 - len(label)) + label
                emit(header)
                for string name = names[nat i]
                    string row = name + string.repeat(" ", width - len(name))
                    for int value = [result.durations[i]].concat(result.fields(name))[]
                        string text = value.string()
                        row += string.repeat(" ", if len(text) < 5 then 5 - len(text) else 0) + text
                    emit(row + (if result.critical(name) then " *" else ""))
                emit("project duration {result.project_length}")
            elif command == "CRITICAL"
                string[][] paths = critical_paths(result)
                emit("critical paths: {len(paths)}")
                for string[] path = paths[]
                    emit(path.join(" -> "))
            elif command == "SLACK"
                int[] seen = []
                for int value = result.tf.sorted()[]
                    if not has_day(seen, value)
                        seen = seen.append(value)
                        emit("float {value}: " + [for string name = names[nat i] if result.tf[i] == value then name].join(" "))
            elif command == "DRAG"
                for string name = result.critical_names()[]
                    emit("{name} drag {result.project_length - compute_schedule(order, name, 0).project_length}")
            elif command == "STATS"
                nat critical = len(result.critical_names())
                nat fs = len([for Dependency dep = dependencies[] if dep.kind == "FS" then dep])
                nat ss = len([for Dependency dep = dependencies[] if dep.kind == "SS" then dep])
                nat ff = len(dependencies) - fs - ss
                emit("tasks {tasks.size()}, critical {critical}, dependencies {len(dependencies)} (FS {fs}, SS {ss}, FF {ff})")
                string[] work = []
                for string resource = resources()[]
                    int total = 0
                    for string name = names[]
                        WorkTask task = get_task(name)
                        if task.resource == resource
                            total += task.current_duration() * task.units
                    work = work.append("{resource} {total}")
                emit("work {work.join(", ")}")
                int total = sum_numbers(result.tf)
                emit("float total {total}, average {decimals(total, int(len(names)))}")
                emit("duration {result.project_length}, critical share {decimals(100 * int(critical), int(len(names)))}%")
            elif command == "CALENDAR"
                calendar_report(result)
            elif command == "GANTT"
                if result.project_length > 60
                    return error("chart too wide ({result.project_length} days)")
                nat width = nat(maximum([for string name = names[] then int(len(name))]))
                string digits = [for int day < result.project_length then (day % 10).string()].join("")
                emit(string.repeat(" ", width) + " |{digits}|")
                for string name = result.by_start()[]
                    nat index = result.at(name)
                    string bar = ""
                    for int day < result.project_length
                        if result.es[index] <= day and day < result.ef[index]
                            bar += if result.critical(name) then "=" else "-"
                        elif result.ef[index] <= day and day < result.lf[index]
                            bar += "."
                        else
                            bar += " "
                    emit(name + string.repeat(" ", width - len(name)) + " |{bar}|")
            elif command == "LEVEL"
                try level_report(result, int.parse(args[0]))
            elif command == "LOAD"
                int[] daily = usage(args[0], names, result.es, result.ef, result.project_length)
                int peak = maximum(daily)
                nat day = 0
                while daily[day] != peak
                    day += 1
                emit("load {args[0]}: " + [for int value = daily[] then value.string()].join(" "))
                emit("peak {peak} on day {day}")
                match capacities.get(args[0])
                    int capacity
                        nat exceeded = len([for int value = daily[] if value > capacity then value])
                        emit("capacity {capacity} exceeded on {exceeded} days")
                    none
                        void
            elif command == "PERTSUM"
                for string[] path = critical_paths(result)[]
                    int mean = 0
                    int variance = 0
                    for string name = path[]
                        WorkTask task = get_task(name)
                        int d = task.current_duration()
                        int[] estimate = if len(task.estimate) == 0 then [d, d, d] else task.estimate
                        mean += estimate[0] + 4 * estimate[1] + estimate[2]
                        variance += (estimate[2] - estimate[0]) ^ 2
                    emit("{path.join(" -> ")}: expected {decimals(mean, 6)} variance {decimals(variance, 36)}")
            elif command == "CRASH"
                .crash_project(order, int.parse(args[0]))
            elif command == "WHATIF"
                int replacement = int.parse(args[1])
                Schedule after = compute_schedule(order, args[0], replacement)
                emit("whatif {args[0]} {get_task(args[0]).current_duration()} -> {replacement}: project {result.project_length} -> {after.project_length}")
                for string name = names[nat i]
                    string[] changes = []
                    int[] old = [result.es[i], result.ef[i], result.tf[i]]
                    int[] new = [after.es[i], after.ef[i], after.tf[i]]
                    string[] labels = ["ES", "EF", "TF"]
                    for nat j < 3
                        if old[j] != new[j]
                            changes = changes.append("{labels[j]} {old[j]}->{new[j]}")
                    if len(changes) > 0
                        emit("{name} {changes.join(" ")}")
                if result.critical_names() != after.critical_names()
                    emit("critical {result.critical_names().join(" ")} -> {after.critical_names().join(" ")}")
            elif command == "BASELINE"
                baseline = result
                baseline_set = true
                emit("baseline saved: {tasks.size()} tasks, duration {result.project_length}")
            elif command == "VARIANCE"
                emit("variance: duration {baseline.project_length} -> {result.project_length} ({signed_text(result.project_length - baseline.project_length)})")
                string[] all = names
                for string name = baseline.names[]
                    if not has_word(all, name)
                        all = all.append(name)
                bool printed = false
                for string name = all.sorted()[]
                    nat old = baseline.at(name)
                    nat new = result.at(name)
                    if new == len(names)
                        emit("{name} removed")
                        printed = true
                    elif old == len(baseline.names)
                        emit("{name} new")
                        printed = true
                    elif baseline.es[old] != result.es[new] or baseline.ef[old] != result.ef[new]
                        emit("{name} start {signed_text(result.es[new] - baseline.es[old])} finish {signed_text(result.ef[new] - baseline.ef[old])}")
                        printed = true
                if not printed
                    emit("no task changes")

auto project = Project()
nat count
scan(&count)
for nat i < count
    string line
    scan(&line)
    match .project.execute(line)
        void
            void
        error issue
            emit("error: {issue.message}")
