// Mora identifiers retain table order; specials are N=108, Q=109, L=110.
int locate(string needle, string[] haystack)
    for 0 <= int k < int(len(haystack))
        if haystack[k] == needle
            return k
    return -1

bool contains(string alphabet, string character)
    for 0 <= int k < int(len(alphabet))
        if alphabet[k] == character
            return true
    return false

string lower_ascii(string value)
    string result = ""
    string upper_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower_letters = "abcdefghijklmnopqrstuvwxyz"
    for 0 <= int k < int(len(value))
        string character = value[k]
        int position = -1
        for 0 <= int j < 26
            if upper_letters[j] == character
                position = j
        result += if position < 0 then character else lower_letters[position]
    return result

string upper_ascii(string value)
    string result = ""
    string upper_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower_letters = "abcdefghijklmnopqrstuvwxyz"
    for 0 <= int k < int(len(value))
        string character = value[k]
        int position = -1
        for 0 <= int j < 26
            if lower_letters[j] == character
                position = j
        result += if position < 0 then character else upper_letters[position]
    return result

class Inventory(string[] ids, string[] rows, int[] row_ids, string[] dans, string[][] spellings)

Inventory inventory()
    string[] rows = "a ka sa ta na ha ma ya ra wa ga za da ba pa".split(" ")
    string[] groups = "a i u e o|ka ki ku ke ko|sa si su se so|ta ti tu te to|na ni nu ne no|ha hi hu he ho|ma mi mu me mo|ya yu yo|ra ri ru re ro|wa wi we wo|ga gi gu ge go|za zi zu ze zo|da di du de do|ba bi bu be bo|pa pi pu pe po".split("|")
    string[] ids = []
    int[] row_ids = []
    string[] dans = []
    for 0 <= int r < 15
        for string identifier = groups[r].split(" ")[]
            ids = ids.append(identifier)
            row_ids = row_ids.append(r)
            dans = dans.append(identifier[int(len(identifier)) - 1])
    for int r = [1, 2, 3, 4, 5, 6, 8, 10, 11, 12, 13, 14][]
        for string suffix = ["ya", "yu", "yo"][]
            ids = ids.append(rows[r][0] + suffix)
            row_ids = row_ids.append(r)
            dans = dans.append(suffix)
    string[][] spellings = []
    string[] exceptions = "si ti tu hu zi di du wi we wo".split(" ")
    string[] hepburn = "shi chi tsu fu ji ji zu i e o".split(" ")
    string[] wapuro = "shi chi tsu fu ji di du wi we wo".split(" ")
    for 0 <= int system_id < 5
        string[] table = []
        for 0 <= int m < 108
            string spelling = ids[m]
            int exception_id = locate(spelling, exceptions)
            if system_id < 2 and exception_id >= 0
                spelling = hepburn[exception_id]
            elif system_id == 4 and exception_id >= 0
                spelling = wapuro[exception_id]
            elif system_id == 2
                if ids[m] == "di"
                    spelling = "zi"
                elif ids[m] == "du"
                    spelling = "zu"
                elif ids[m] == "wi" or ids[m] == "we" or ids[m] == "wo"
                    spelling = ids[m][1]
            if m >= 72
                string prefix = ids[m][:<2]
                string suffix = ids[m][2]
                if system_id < 2 or system_id == 4
                    if prefix == "sy"
                        spelling = "sh" + suffix
                    elif prefix == "ty"
                        spelling = "ch" + suffix
                    elif prefix == "zy" or (prefix == "dy" and system_id < 2)
                        spelling = "j" + suffix
                elif system_id == 2 and prefix == "dy"
                    spelling = "zy" + suffix
            table = table.append(spelling)
        spellings = spellings.append(table)
    return Inventory(ids, rows, row_ids, dans, spellings)

class Reading(string problem, int[] morae, int[] columns)
class Word(string original, int start, int pattern, int[] morae, int[] columns)
class Pieces(string problem, string[] parts)

string at(string value, int position)
    return if 0 <= position < int(len(value)) then value[position] else ""

int case_pattern(string value)
    bool all_lower = true
    bool all_upper = true
    bool title = contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", value[0])
    int letters = 0
    for 0 <= int k < int(len(value))
        string character = value[k]
        if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", character)
            letters += 1
            if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", character)
                all_lower = false
                if k > 0
                    title = false
            else
                all_upper = false
    if all_lower
        return 0
    if title
        return 1
    if all_upper and letters >= 2
        return 2
    return -1

int[] syllable(const Inventory db, int system_id, string value, int position)
    int best = -1
    int width = 0
    for 0 <= int m < 108
        for 0 <= int candidate < 5
            if system_id >= 0 and candidate != system_id
                continue
            string spelling = db.spellings[candidate][m]
            int size = int(len(spelling))
            if size > width and position + size <= int(len(value))
                if value[position:<position + size] == spelling
                    best = m
                    width = size
    return [best, width]

string column_error(int column, string message)
    return "col " + column.string() + ": " + message

Reading read_word(const Inventory db, int system_id, string original, int start)
    string value = lower_ascii(original)
    int[] morae = []
    int[] columns = []
    int p = 0
    while p < int(len(value))
        string c = value[p]
        string c2 = at(value, p + 1)
        string c3 = at(value, p + 2)
        int mora = -1
        int width = 1
        if c == "-"
            if len(morae) == 0 or morae[int(len(morae)) - 1] >= 108
                return Reading(column_error(start + p, "misplaced long mark"), [], [])
            mora = 110
        elif c == "'"
            return Reading(column_error(start + p, "misplaced apostrophe"), [], [])
        else
            int[] matched = syllable(db, system_id, value, p)
            if matched[0] >= 0
                mora = matched[0]
                width = matched[1]
            elif (system_id == 4 or system_id == -1) and p + 3 <= int(len(value)) and value[p:<p + 3] == "xtu"
                mora = 109
                width = 3
            elif c == "n"
                mora = 108
                if system_id == -1
                    if c2 == "'" or (c2 == "n" and not contains("aiueoy'", c3))
                        width = 2
                elif (system_id == 4 and c2 == "n") or (system_id != 4 and c2 == "'")
                    width = 2
            elif (system_id == 1 or system_id == -1) and c == "m" and contains("bmp", c2)
                mora = 108
            elif not contains("aiueon", c) and c == c2 and syllable(db, system_id, value, p + 1)[0] >= 0
                mora = 109
            elif (system_id < 2 or system_id == -1) and c == "t" and c2 == "c" and c3 == "h" and syllable(db, system_id, value, p + 1)[0] >= 0
                mora = 109
            else
                return Reading(column_error(start + p, "unknown syllable"), [], [])
        morae = morae.append(mora)
        columns = columns.append(start + p)
        p += width
    return Reading("", morae, columns)

// Pair flags and long-element flags deliberately differ (e+i, a+a, etc.).
int[][] long_flags(const Inventory db, int[] morae)
    int[] pairs = array(len(morae), fill = 0)
    int[] elements = array(len(morae), fill = 0)
    int p = 0
    while p < int(len(morae))
        int m = morae[p]
        if m == 110
            elements[p] = 1
        if m < 108 and p + 1 < int(len(morae)) and morae[p + 1] < 5
            string vowel = db.ids[m][int(len(db.ids[m])) - 1]
            string next_vowel = db.ids[morae[p + 1]]
            if vowel == next_vowel or (vowel == "o" and next_vowel == "u") or (vowel == "e" and next_vowel == "i")
                pairs[p + 1] = 1
                if vowel == "o" or (vowel == "u" and next_vowel == "u")
                    elements[p + 1] = 1
                p += 2
                continue
        p += 1
    return [pairs, elements]

Pieces write_parts(const Inventory db, int system_id, const Word word, string long_value)
    int[][] flags = long_flags(db, word.morae)
    string[] result = []
    for 0 <= int k < int(len(word.morae))
        int m = word.morae[k]
        int next_mora = if k + 1 < int(len(word.morae)) then word.morae[k + 1] else -1
        string next_spelling = if 0 <= next_mora < 108 then db.spellings[system_id][next_mora] else ""
        string first = at(next_spelling, 0)
        string piece = ""
        if flags[1][k] == 1
            string previous = db.ids[word.morae[k - 1]]
            string vowel = previous[int(len(previous)) - 1]
            if long_value == "KEEP"
                piece = if m == 110 then "-" else db.spellings[system_id][m]
            elif long_value == "PASSPORT"
                piece = if vowel == "o" and not contains("aiueo", first) then "h" else ""
            elif long_value == "HYPHEN"
                piece = "-"
            elif long_value == "DOUBLE"
                piece = vowel
        elif m < 108
            piece = db.spellings[system_id][m]
        elif m == 108
            if system_id == 4
                piece = if next_mora == 108 or contains("aiueoyn", first) then "nn" else "n"
            elif system_id == 1 and contains("bmp", first)
                piece = "m"
            else
                piece = if contains("aiueoy", first) then "n'" else "n"
        elif m == 109
            if first != "" and not contains("aiueon", first)
                piece = if system_id < 2 and int(len(next_spelling)) >= 2 and next_spelling[:<2] == "ch" then "t" else first
            elif system_id == 4
                piece = "xtu"
            else
                return Pieces(column_error(word.columns[k], "small tsu cannot be written"), [])
        result = result.append(piece)
    return Pieces("", result)

string apply_case(string value, int pattern, string case_value)
    int actual = pattern
    if case_value == "LOWER"
        actual = 0
    elif case_value == "TITLE"
        actual = 1
    elif case_value == "UPPER"
        actual = 2
    if actual == 1
        return upper_ascii(value[0]) + value[1:]
    if actual == 2
        return upper_ascii(value)
    return value

string display_mora(const Inventory db, int system_id, int mora)
    if mora < 108
        return db.spellings[system_id][mora]
    return ["N", "Q", "-"][mora - 108]

int[] loose(const Inventory db, int[] morae)
    int[] result = []
    int[][] flags = long_flags(db, morae)
    for 0 <= int k < int(len(morae))
        if flags[1][k] == 0
            result = result.append(morae[k])
    return result

string devoice(string identifier)
    int v = locate(identifier[0], ["g", "z", "d", "b", "p"])
    return if v < 0 then identifier else ["k", "s", "t", "h", "h"][v] + identifier[1:]

// Each key item is a whole vector: ranks, voices, sizes, then L flags.
int[][] key_vectors(const Inventory db, int[] morae, string order_value)
    string[] kana_order = "a i u e o ka ki ku ke ko sa si su se so ta ti tu te to na ni nu ne no ha hi hu he ho ma mi mu me mo ya yu yo ra ri ru re ro wa wi we wo N".split(" ")
    if order_value == "IROHA"
        kana_order = "i ro ha ni ho he to ti ri nu ru wo wa ka yo ta re so tu ne na ra mu u wi no o ku ya ma ke hu ko e te a sa ki yu me mi si we hi mo se su N".split(" ")
    int[] ranks = []
    int[] voices = []
    int[] sizes = []
    int[] marks = []
    for int m = morae[]
        marks = marks.append(if m == 110 then 1 else 0)
        if m == 110
            continue
        int voice = 0
        string base_kana = "N"
        if m == 109
            base_kana = "tu"
        elif m < 108
            base_kana = devoice(db.ids[m])
            int row_id = db.row_ids[m]
            voice = if row_id == 14 then 2 elif row_id >= 10 then 1 else 0
            if m >= 72
                base_kana = base_kana[0] + "i"
        ranks = ranks.append(locate(base_kana, kana_order))
        voices = voices.append(voice)
        sizes = sizes.append(if m == 109 then 1 else 0)
        if 72 <= m < 108
            ranks = ranks.append(locate(db.dans[m], kana_order))
            voices = voices.append(0)
            sizes = sizes.append(1)
    return [ranks, voices, sizes, marks]

string[] base_sequence(const Inventory db, int[] morae)
    string[] kana_order = "a i u e o ka ki ku ke ko sa si su se so ta ti tu te to na ni nu ne no ha hi hu he ho ma mi mu me mo ya yu yo ra ri ru re ro wa wi we wo N".split(" ")
    int[][] key = key_vectors(db, morae, "GOJUON")
    string[] result = []
    for int rank = key[0][]
        result = result.append(kana_order[rank])
    return result

bool key_before(int[][] left_key, int[][] right_key)
    for 0 <= int v < 4
        int count = if len(left_key[v]) < len(right_key[v]) then int(len(left_key[v])) else int(len(right_key[v]))
        for 0 <= int k < count
            if left_key[v][k] != right_key[v][k]
                return left_key[v][k] < right_key[v][k]
        if len(left_key[v]) != len(right_key[v])
            return len(left_key[v]) < len(right_key[v])
    return false

bool matches_pattern(int[] pattern_ids, int[] morae)
    bool[] previous = array(nat(int(len(morae)) + 1), fill = false)
    previous[0] = true
    for int token = pattern_ids[]
        bool[] current = array(len(previous), fill = false)
        for 0 <= int k <= int(len(morae))
            if token == -2
                current[k] = previous[k] or (k > 0 and current[k - 1])
            elif k > 0
                current[k] = previous[k - 1] and (token == -1 or token == morae[k - 1])
        previous = current
    return previous[len(morae)]

string execute(const Inventory db, string input_line, string[] &settings)
    string[] fields = input_line.split(" ")
    string command = fields[0]
    string[] names = "SET TABLE CONVERT NORMALIZE REVERSE VALID DETECT DIFF SAME MORAE SYLLABLES ROW STATS SORT INDEX FIND HAIKU KAIBUN SHIRITORI".split(" ")
    if locate(command, names) < 0
        return "ERROR unknown command " + command
    if command == "SET" or command == "TABLE"
        if len(fields) < 3
            return "ERROR missing argument"
        if len(fields) > 3
            return "ERROR too many arguments"
        if command == "SET"
            int option_id = locate(fields[1], ["LONG", "CASE", "ORDER"])
            if option_id < 0
                return "ERROR unknown option " + fields[1]
            string[][] values = [["KEEP", "DROP", "PASSPORT", "HYPHEN", "DOUBLE"], ["KEEP", "LOWER", "UPPER", "TITLE"], ["GOJUON", "IROHA"]]
            if locate(fields[2], values[option_id]) < 0
                return "ERROR unknown value " + fields[2]
            settings[option_id] = fields[2]
            return fields[1] + "=" + fields[2]
    int argument_count = if command == "NORMALIZE" or command == "DETECT" then 0 elif command == "CONVERT" or command == "DIFF" or command == "SAME" or command == "FIND" then 2 else 1
    if command != "TABLE" and int(len(fields)) < argument_count + 2
        return "ERROR missing argument"
    string[] systems = "HEPBURN TRADITIONAL KUNREI NIHON WAPURO".split(" ")
    int source_id = -1
    int target_id = -1
    if argument_count > 0
        source_id = locate(fields[1], systems)
        if source_id < 0
            return "ERROR unknown system " + fields[1]
        target_id = source_id
    if command == "CONVERT" or command == "DIFF" or command == "SAME"
        target_id = locate(fields[2], systems)
        if target_id < 0
            return "ERROR unknown system " + fields[2]
    if command == "TABLE"
        int row_id = locate(fields[2], db.rows)
        if row_id < 0
            return "ERROR unknown row " + fields[2]
        string[] result = []
        for 0 <= int m < 108
            if db.row_ids[m] == row_id
                result = result.append(db.spellings[source_id][m])
        return result.join(" ")
    int text_start = int(len(command)) + 1
    for 1 <= int k <= argument_count
        text_start += int(len(fields[k])) + 1
    string text = input_line[text_start:]
    int[] pattern_ids = []
    if command == "FIND"
        string segment = ""
        for 0 <= int p <= int(len(fields[2]))
            string c = at(fields[2], p)
            if c == "" or c == "?" or c == "*"
                Reading parsed_segment = read_word(db, source_id, segment, 1)
                if parsed_segment.problem != ""
                    return "ERROR invalid pattern"
                pattern_ids = pattern_ids.concat(parsed_segment.morae)
                if c != ""
                    pattern_ids = pattern_ids.append(if c == "?" then -1 else -2)
                segment = ""
            elif contains("abcdefghijklmnopqrstuvwxyz'-", c)
                segment += c
            else
                return "ERROR invalid pattern"
    bool allow_slash = command == "SAME" or command == "HAIKU"
    string separators = " 0123456789.,!?;:()" + DQ + (if allow_slash then "/" else "")
    string letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'-"
    for 0 <= int p < int(len(text))
        if not contains(separators + letters, text[p])
            return "ERROR " + column_error(p + 1, "invalid character")
    Word[] words = []
    int[] word_lines = []
    int poem_line = 0
    int p = 0
    while p < int(len(text))
        if contains(letters, text[p])
            int start = p
            while p < int(len(text)) and contains(letters, text[p])
                p += 1
            string original = text[start:<p]
            words = words.append(Word(original, start + 1, case_pattern(original), [], []))
            word_lines = word_lines.append(poem_line)
        else
            if text[p] == "/"
                poem_line += 1
            p += 1
    int[] line_words = array(nat(poem_line + 1), fill = 0)
    for int line_id = word_lines[]
        line_words[line_id] += 1
    if command == "SAME" and (poem_line != 1 or line_words[0] == 0 or line_words[1] == 0)
        return "ERROR expected two texts"
    if command == "HAIKU"
        if poem_line != 2 and poem_line != 4
            return "ERROR expected 3 or 5 lines"
        for int count = line_words[]
            if count == 0
                return "ERROR expected 3 or 5 lines"
    if len(words) == 0
        return "ERROR no words"
    for Word word = words[]
        if word.pattern < 0
            return "ERROR " + column_error(word.start, "mixed case")
    if command == "DETECT"
        string[] results = []
        for 0 <= int system_id < 5
            string verdict = "canonical"
            for Word word = words[]
                Reading reading = read_word(db, system_id, word.original, word.start)
                if reading.problem != ""
                    verdict = "error"
                    break
                Word parsed = Word(word.original, word.start, word.pattern, reading.morae, reading.columns)
                Pieces written = write_parts(db, system_id, parsed, "KEEP")
                if written.problem != ""
                    verdict = "error"
                    break
                if apply_case(written.parts.join(""), word.pattern, "KEEP") != word.original
                    verdict = "readable"
            results = results.append(systems[system_id] + "=" + verdict)
        return results.join(" ")
    for 0 <= int k < int(len(words))
        int system_id = if command == "SAME" and word_lines[k] == 1 then target_id else source_id
        Reading reading = read_word(db, system_id, words[k].original, words[k].start)
        if reading.problem != ""
            return "ERROR " + reading.problem
        words[k].morae = reading.morae
        words[k].columns = reading.columns
    if command == "NORMALIZE"
        target_id = 0
    if command == "CONVERT" or command == "NORMALIZE" or command == "REVERSE"
        string result = ""
        int cursor = 0
        for Word word = words[]
            result += text[cursor:<word.start - 1]
            Word writable = word
            if command == "REVERSE"
                for 0 <= int k < int(len(writable.morae))
                    if writable.morae[k] == 110
                        string previous = db.ids[writable.morae[k - 1]]
                        writable.morae[k] = locate(previous[int(len(previous)) - 1], db.ids)
                writable.morae = writable.morae[::-1]
                writable.columns = writable.columns[::-1]
            Pieces written = write_parts(db, target_id, writable, settings[0])
            if written.problem != ""
                return "ERROR " + written.problem
            result += apply_case(written.parts.join(""), word.pattern, settings[1])
            cursor = word.start - 1 + int(len(word.original))
        return result + text[cursor:]
    if command == "VALID"
        // All parsing completed above, even if an earlier word is noncanonical.
        for Word word = words[]
            Pieces written = write_parts(db, source_id, word, "KEEP")
            if written.problem != ""
                return "ERROR " + written.problem
            string canonical = apply_case(written.parts.join(""), word.pattern, "KEEP")
            if canonical != word.original
                int k = 0
                while k < int(len(canonical)) and k < int(len(word.original)) and canonical[k] == word.original[k]
                    k += 1
                return "INVALID col " + (word.start + k).string() + ": expected " + canonical
        return "VALID"
    if command == "DIFF" or command == "FIND"
        string[] selected = []
        for Word word = words[]
            if command == "FIND"
                if matches_pattern(pattern_ids, word.morae)
                    selected = selected.append(word.original)
            else
                Pieces left = write_parts(db, source_id, word, settings[0])
                if left.problem != ""
                    return "ERROR " + left.problem
                Pieces right = write_parts(db, target_id, word, settings[0])
                if right.problem != ""
                    return "ERROR " + right.problem
                string a = apply_case(left.parts.join(""), word.pattern, settings[1])
                string b = apply_case(right.parts.join(""), word.pattern, settings[1])
                if a != b
                    selected = selected.append(a + ">" + b)
        string result = len(selected).string() + " of " + len(words).string()
        return result + (if len(selected) == 0 then "" else ": " + selected.join(" "))
    if command == "SAME"
        int n_left = line_words[0]
        int n_right = line_words[1]
        bool exact = true
        int count = if n_left < n_right then n_left else n_right
        for 0 <= int k < count
            if loose(db, words[k].morae) != loose(db, words[n_left + k].morae)
                return "DIFFERENT at word " + (k + 1).string()
            if words[k].morae != words[n_left + k].morae
                exact = false
        if n_left != n_right
            return "DIFFERENT at word " + (count + 1).string()
        return if exact then "EXACT" else "LOOSE"
    if command == "HAIKU"
        int[] counts = array(nat(poem_line + 1), fill = 0)
        for 0 <= int k < int(len(words))
            counts[word_lines[k]] += int(len(words[k].morae))
        int[] expected = if poem_line == 2 then [5, 7, 5] else [5, 7, 5, 7, 7]
        string[] count_text = []
        for int count = counts[]
            count_text = count_text.append(count.string())
        return (if counts == expected then "OK " else "NG ") + (if poem_line == 2 then "haiku " else "tanka ") + count_text.join("-")
    if command == "MORAE" or command == "SYLLABLES" or command == "ROW" or command == "STATS"
        string[] groups = []
        int total = 0
        int[] row_counts = array(10, fill = 0)
        int[] other_counts = array(6, fill = 0)
        for Word word = words[]
            string[] pieces = []
            if command == "SYLLABLES"
                Pieces written = write_parts(db, source_id, word, "KEEP")
                if written.problem != ""
                    return "ERROR " + written.problem
                pieces = written.parts
            int[][] flags = long_flags(db, word.morae)
            string[] parts = []
            for 0 <= int k < int(len(word.morae))
                int m = word.morae[k]
                string display = display_mora(db, source_id, m)
                if command == "SYLLABLES"
                    if k > 0 and (m >= 108 or flags[0][k] == 1)
                        parts[int(len(parts)) - 1] += pieces[k]
                    else
                        parts = parts.append(pieces[k])
                        total += 1
                elif command == "MORAE"
                    parts = parts.append(display)
                    total += 1
                elif command == "ROW"
                    groups = groups.append(display + ": " + (if m >= 108 then "special" else db.rows[db.row_ids[m]] + " " + db.dans[m]))
                else
                    total += 1
                    if m >= 108
                        other_counts[m - 105] += 1
                    else
                        int r = db.row_ids[m]
                        int base_row = if r < 10 then r else [1, 2, 3, 5, 5][r - 10]
                        row_counts[base_row] += 1
                        if r == 14
                            other_counts[1] += 1
                        elif r >= 10
                            other_counts[0] += 1
                        if m >= 72
                            other_counts[2] += 1
            if command == "MORAE" or command == "SYLLABLES"
                groups = groups.append(parts.join("."))
        if command == "ROW"
            return groups.join(", ")
        if command == "MORAE" or command == "SYLLABLES"
            return total.string() + ": " + groups.join(" ")
        string result = "morae=" + total.string()
        for 0 <= int r < 10
            if row_counts[r] > 0
                result += " " + db.rows[r] + "=" + row_counts[r].string()
        string[] labels = ["voiced", "semivoiced", "contracted", "N", "Q", "L"]
        for 0 <= int k < 6
            result += " " + labels[k] + "=" + other_counts[k].string()
        return result
    if command == "SORT" or command == "INDEX"
        int[] order_ids = []
        int[][][] keys = []
        for 0 <= int k < int(len(words))
            keys = keys.append(key_vectors(db, words[k].morae, settings[2]))
            order_ids = order_ids.append(k)
            int p_insert = k
            while p_insert > 0 and key_before(keys[k], keys[order_ids[p_insert - 1]])
                order_ids[p_insert] = order_ids[p_insert - 1]
                p_insert -= 1
            order_ids[p_insert] = k
        string[] groups = []
        string last_heading = ""
        for int word_id = order_ids[]
            if command == "SORT"
                groups = groups.append(words[word_id].original)
                continue
            string first_kana = base_sequence(db, words[word_id].morae)[0]
            string heading = first_kana
            if settings[2] == "GOJUON" and first_kana != "N"
                heading = db.rows[db.row_ids[locate(first_kana, db.ids)]]
            if heading == last_heading
                groups[int(len(groups)) - 1] += " " + words[word_id].original
            else
                groups = groups.append(heading + ": " + words[word_id].original)
                last_heading = heading
        return groups.join(if command == "SORT" then " " else "; ")
    if command == "KAIBUN"
        string[] sequence = []
        for Word word = words[]
            sequence = sequence.concat(base_sequence(db, word.morae))
        return (if sequence == sequence[::-1] then "YES " else "NO ") + sequence.join(".")
    // SHIRITORI: mismatch, repetition, terminal N, in exactly that order.
    string previous_tail = ""
    for 0 <= int k < int(len(words))
        string[] sequence = base_sequence(db, words[k].morae)
        string prefix = "NG " + (k + 1).string() + ": " + words[k].original
        if k > 0 and sequence[0] != previous_tail
            return prefix + " must start with " + db.spellings[source_id][locate(previous_tail, db.ids)]
        for 0 <= int earlier < k
            if words[earlier].morae == words[k].morae
                return prefix + " is repeated"
        previous_tail = sequence[int(len(sequence)) - 1]
        if previous_tail == "N"
            return prefix + " ends with N"
    return "OK " + len(words).string()

Inventory database = inventory()
string[] current_settings = ["KEEP", "KEEP", "GOJUON"]
int command_count
scan(&command_count)
for 0 <= int line_number < command_count
    string command_line
    scan(&command_line)
    print(execute(database, command_line, &current_settings) + NL)
