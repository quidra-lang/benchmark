int minimum(int a, int b)
    return if a < b then a else b
int maximum(int a, int b)
    return if a > b then a else b
int floor_div(int a, int b)
    int q = a / b
    return if a < 0 and a % b != 0 then q - 1 else q
int integer(string text)
    return int.parse(text)
string hex_value(int value, int width = 2)
    string result = ""
    while value > 0 or int(len(result)) < width
        result = "0123456789ABCDEF"[value % 16] + result
        value /= 16
    return result
int | error unhex(string text)
    int result = 0
    for nat j < len(text)
        int digit = -1
        for int k < 16
            if text[j] == "0123456789ABCDEF"[k]
                digit = k
        if digit < 0
            return error("bad value")
        result = result * 16 + digit
    return result
string note_name(int pitch)
    string[] names = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
    return names[pitch % 12] + (pitch / 12 - 1).string()
int | error note_number(string text)
    for int p < 128
        if note_name(p) == text
            return p
    return error("bad value")
int big_endian(const int[] bytes)
    int result = 0
    for int byte_value = bytes[]
        result = result * 256 + byte_value
    return result
int[] big_bytes(int value, int size)
    int[] result = array(nat(size), fill = 0)
    for int j < size
        result[size - 1 - j] = value % 256
        value /= 256
    return result
int[] vlq_bytes(int value)
    int[] result = [value % 128]
    value /= 128
    while value > 0
        result = [value % 128 + 128].concat(result)
        value /= 128
    return result
string kind_name(int code)
    if code < 240
        return ["NOTE_OFF", "NOTE_ON", "POLY_PRESSURE", "CONTROL", "PROGRAM", "CHANNEL_PRESSURE", "PITCH_BEND"][code / 16 - 8]
    if code == 240 or code == 247
        return if code == 240 then "SYSEX" else "SYSEX_ESCAPE"
    int tag = code - 256
    if 1 <= tag <= 7
        return ["TEXT_EVENT", "COPYRIGHT", "TRACK_NAME", "INSTRUMENT_NAME", "LYRIC", "MARKER", "CUE_POINT"][tag - 1]
    if tag == 0
        return "SEQUENCE_NUMBER"
    if tag == 32
        return "CHANNEL_PREFIX"
    if tag == 47
        return "END_OF_TRACK"
    if tag == 81
        return "TEMPO"
    if tag == 84
        return "SMPTE_OFFSET"
    if tag == 88
        return "TIME_SIGNATURE"
    if tag == 89
        return "KEY_SIGNATURE"
    return if tag == 127 then "SEQUENCER_SPECIFIC" else "META"
bool known_meta(int tag)
    return tag <= 7 or tag == 32 or tag == 47 or tag == 81 or tag == 84 or tag == 88 or tag == 89 or tag == 127
string key_name(int sf, int mi)
    string[] names = if mi == 0 then ["Cb", "Gb", "Db", "Ab", "Eb", "Bb", "F", "C", "G", "D", "A", "E", "B", "F#", "C#"] else ["Ab", "Eb", "Bb", "F", "C", "G", "D", "A", "E", "B", "F#", "C#", "G#", "D#", "A#"]
    return names[sf + 7] + (if mi == 0 then " major" else " minor")
class Event(int tick, int code, int[] payload = [])
    bool channel_message()
        return code < 240
    int channel_number()
        return code % 16 + 1
    bool note_on()
        return code / 16 == 9 and payload[1] > 0
    bool note_off()
        return code / 16 == 8 or (code / 16 == 9 and payload[1] == 0)
    string fields()
        if channel_message()
            string result = channel_number().string()
            int family = code / 16
            if family <= 10
                return result + " " + note_name(payload[0]) + " {payload[1]}"
            if family == 14
                return result + " {payload[0] + 128 * payload[1] - 8192}"
            for int item = payload[]
                result += " {item}"
            return result
        if 257 <= code <= 263
            string text = string.from_utf8(bin(nat8(payload)))
            return DQ + text + DQ
        if code == 256 or code == 337
            return big_endian(payload).string()
        if code == 288
            return (payload[0] + 1).string()
        if code == 303
            return ""
        if code == 340
            string[] words = []
            for int item = payload[]
                words = words.append(item.string())
            return words.join(" ")
        if code == 344
            return "{payload[0]}/{2 ^ payload[1]} {payload[2]} {payload[3]}"
        if code == 345
            int sf = if payload[0] >= 128 then payload[0] - 256 else payload[0]
            return key_name(sf, payload[1])
        string result = if code >= 256 and code != 383 then hex_value(code - 256) + " " else ""
        result += len(payload).string()
        if len(payload) > 0
            result += " "
            for int item = payload[]
                result += hex_value(item)
        return result
    string text_line(int track_number)
        string suffix = fields()
        return "{tick} {track_number} {kind_name(code)}" + (if suffix == "" then "" else " " + suffix)
class Track(Event[] events = [])
class Placed(int track_number, int event_number, Event event)
class Song(int format, int division, Track[] tracks)
    int event_count()
        int result = 0
        for Track track_value = tracks[]
            result += int(len(track_value.events))
        return result
    int length_ticks()
        int result = 0
        for Track track_value = tracks[]
            result = maximum(result, track_value.events[int(len(track_value.events)) - 1].tick)
        return result
    string description()
        return "format {format} tracks {len(tracks)} division {division} events {event_count()}"
    Placed[] global_order()
        Placed[] result = []
        for nat ti < len(tracks)
            for nat ei < len(tracks[ti].events)
                result = result.append(Placed(int(ti), int(ei), tracks[ti].events[ei]))
        // Stable insertion keeps track/event order for simultaneous events.
        for 1 <= int a < int(len(result))
            int b = a
            while b > 0 and result[b].event.tick < result[b - 1].event.tick
                Placed temporary = result[b]
                result[b] = result[b - 1]
                result[b - 1] = temporary
                b -= 1
        return result
    string clock_text(int target)
        int scaled = 0
        int last_tick = 0
        int usec = 500000
        for Placed placed = global_order()[]
            Event ev = placed.event
            if ev.tick > target
                break
            if ev.code == 337
                scaled += (ev.tick - last_tick) * usec
                last_tick = ev.tick
                usec = big_endian(ev.payload)
        int micros = (scaled + (target - last_tick) * usec) / division
        int fraction = micros % 1000
        return "{micros / 1000}.{fraction:int=3,zero}"
    string bar_text(int target)
        int start_tick = 0
        int bar_number = 1
        int numerator = 4
        int beat = division
        for Placed placed = global_order()[]
            Event ev = placed.event
            if ev.tick > target
                break
            if ev.code == 344
                int size = numerator * beat
                bar_number += (ev.tick - start_tick + size - 1) / size
                start_tick = ev.tick
                numerator = ev.payload[0]
                beat = division * 4 / (2 ^ ev.payload[1])
        int delta = target - start_tick
        int size = numerator * beat
        return "{bar_number + delta / size}:{(delta % size) / beat + 1}:{delta % beat}"
class Note(int on_index, int off_index, int start_tick, int duration, int channel_number, int pitch, int velocity)
class Pairing(Placed[] ordered, Note[] notes = [], int[] unmatched = [], int[] pending = [])
Pairing pair_notes(Song song)
    Pairing result = Pairing(song.global_order())
    bool[] consumed = array(len(result.ordered), fill = false)
    for nat oi < len(result.ordered)
        Event ev = result.ordered[oi].event
        if not ev.note_off()
            continue
        int partner = -1
        for nat ni < oi
            Event candidate = result.ordered[ni].event
            if not consumed[ni] and candidate.note_on() and candidate.channel_number() == ev.channel_number() and candidate.payload[0] == ev.payload[0]
                partner = int(ni)
                break
        if partner >= 0
            consumed[partner] = true
            consumed[oi] = true
            Event on_event = result.ordered[partner].event
            result.notes = result.notes.append(Note(partner, int(oi), on_event.tick, ev.tick - on_event.tick, on_event.channel_number(), on_event.payload[0], on_event.payload[1]))
    for nat j < len(result.ordered)
        Event ev = result.ordered[j].event
        if not consumed[j] and (ev.note_on() or ev.note_off())
            result.unmatched = result.unmatched.append(int(j))
            if ev.note_on()
                result.pending = result.pending.append(int(j))
    for 1 <= int a < int(len(result.notes))
        int b = a
        while b > 0
            Note left = result.notes[b]
            Note right = result.notes[b - 1]
            bool before = left.start_tick < right.start_tick or (left.start_tick == right.start_tick and (left.channel_number < right.channel_number or (left.channel_number == right.channel_number and (left.pitch < right.pitch or (left.pitch == right.pitch and left.on_index < right.on_index)))))
            if not before
                break
            result.notes[b] = right
            result.notes[b - 1] = left
            b -= 1
    return result
class Parser(int[] bytes)
    int position = 0
    int limit = 0
    int event_start = 0
    error failure(int where, string reason)
        return error("byte {where}: {reason}")
    int | error chunk(int at, string ident)
        if int(len(bytes)) - at < 8
            return failure(at, "truncated chunk")
        if bytes[at:<at + 4] != ident.codepoints()
            return failure(at, "bad chunk id")
        int size = big_endian(bytes[at + 4:<at + 8])
        if at + 8 + size > int(len(bytes))
            return failure(at, "truncated chunk")
        return size
    int | error .read_byte()
        if position >= limit
            return failure(event_start, "truncated event")
        int result = bytes[position]
        position += 1
        return result
    int | error .read_vlq()
        int at = position
        int result = 0
        for int j < 4
            int byte_value = try .read_byte()
            result = result * 128 + byte_value % 128
            if byte_value < 128
                return result
        return failure(at, "variable-length value too long")
    Song | error .parse_song()
        int header_size = try chunk(0, "MThd")
        if header_size != 6
            return failure(4, "bad header length")
        int format_value = big_endian(bytes[8:<10])
        int track_count = big_endian(bytes[10:<12])
        int division_value = big_endian(bytes[12:<14])
        if format_value > 2
            return failure(8, "bad format")
        if track_count == 0 or (format_value == 0 and track_count != 1)
            return failure(10, "bad track count")
        if division_value >= 32768
            return failure(12, "smpte timing not supported")
        if division_value == 0
            return failure(12, "bad division")
        Song result = Song(format_value, division_value, [])
        position = 14
        for int ti < track_count
            if position == int(len(bytes))
                return failure(position, "missing track")
            int size = try chunk(position, "MTrk")
            position += 8
            limit = position + size
            Track track_value = Track()
            int tick_value = 0
            int running_status = -1
            while position < limit
                if len(track_value.events) > 0 and track_value.events[int(len(track_value.events)) - 1].code == 303
                    return failure(position, "event after end of track")
                event_start = position
                tick_value += try .read_vlq()
                if position >= limit
                    return failure(event_start, "truncated event")
                int status_at = position
                int code_value = bytes[position]
                if code_value < 128
                    if running_status < 0
                        return failure(position, "data byte without running status")
                    code_value = running_status
                else
                    position += 1
                int[] payload_value = []
                if code_value <= 239
                    running_status = code_value
                    int count_bytes = if code_value / 16 == 12 or code_value / 16 == 13 then 1 else 2
                    for int j < count_bytes
                        int data_at = position
                        int byte_value = try .read_byte()
                        if byte_value >= 128
                            return failure(data_at, "bad data byte")
                        payload_value = payload_value.append(byte_value)
                elif code_value == 240 or code_value == 247 or code_value == 255
                    running_status = -1
                    if code_value == 255
                        code_value = 256 + try .read_byte()
                    int count_bytes = try .read_vlq()
                    if position + count_bytes > limit
                        return failure(event_start, "truncated event")
                    payload_value = bytes[position:<position + count_bytes]
                    position += count_bytes
                    if code_value >= 256
                        int tag = code_value - 256
                        int expected = if tag == 0 then 2 elif tag == 32 then 1 elif tag == 47 then 0 elif tag == 81 then 3 elif tag == 84 then 5 elif tag == 88 then 4 elif tag == 89 then 2 else -1
                        if expected >= 0 and int(len(payload_value)) != expected
                            return failure(status_at, "bad meta length")
                        bool valid = true
                        if tag == 81
                            valid = big_endian(payload_value) > 0
                        elif tag == 32
                            valid = payload_value[0] <= 15
                        elif tag == 88
                            valid = payload_value[0] > 0 and payload_value[1] <= 6
                        elif tag == 89
                            int sf = if payload_value[0] >= 128 then payload_value[0] - 256 else payload_value[0]
                            valid = -7 <= sf <= 7 and payload_value[1] <= 1
                        if not valid
                            return failure(status_at, "bad meta data")
                else
                    return failure(status_at, "unknown status byte")
                track_value.events = track_value.events.append(Event(tick_value, code_value, payload_value))
            if len(track_value.events) == 0 or track_value.events[int(len(track_value.events)) - 1].code != 303
                return failure(limit, "missing end of track")
            result.tracks = result.tracks.append(track_value)
        if position < int(len(bytes))
            return failure(position, "extra data")
        return result
int | error bounded(string word, int low, int high)
    int result = integer(word)
    if result < low or result > high
        return error("bad value")
    return result
Event | error text_event(string line)
    string[] words = line.split(" ")
    string name = words[2]
    int code_value = -1
    for int family < 7
        if name == kind_name(128 + family * 16)
            code_value = 128 + family * 16
    for int tag < 256
        if name != "META" and name == kind_name(256 + tag)
            code_value = 256 + tag
    if name == "META"
        code_value = 512
    if name == "SYSEX" or name == "SYSEX_ESCAPE"
        code_value = if name == "SYSEX" then 240 else 247
    if code_value < 0
        return error("unknown event type")
    string[] fields = []
    for 3 <= nat j < len(words)
        fields = fields.append(words[j])
    int[] payload_value = []
    int count_fields = int(len(fields))
    if code_value < 240
        int family = code_value / 16
        int expected = if family == 12 or family == 13 or family == 14 then 2 else 3
        if count_fields != expected
            return error("bad value")
        code_value += (try bounded(fields[0], 1, 16)) - 1
        if family <= 10
            payload_value = [try note_number(fields[1]), try bounded(fields[2], 0, 127)]
        elif family == 14
            int bend = (try bounded(fields[1], -8192, 8191)) + 8192
            payload_value = [bend % 128, bend / 128]
        else
            for 1 <= nat j < len(fields)
                payload_value = payload_value.append(try bounded(fields[j], 0, 127))
    elif 257 <= code_value <= 263
        string quoted = fields.join(" ")
        if len(quoted) < 2 or not quoted.starts_with(DQ) or not quoted.ends_with(DQ)
            return error("bad value")
        string inside = quoted[1:<int(len(quoted)) - 1]
        if inside.contains(DQ)
            return error("bad value")
        payload_value = inside.codepoints()
    elif code_value == 303
        if count_fields != 0
            return error("bad value")
    elif code_value == 256 or code_value == 337 or code_value == 288
        if count_fields != 1
            return error("bad value")
        int scalar = try bounded(fields[0], if code_value == 256 then 0 else 1, if code_value == 256 then 65535 elif code_value == 337 then 16777215 else 16)
        payload_value = if code_value == 288 then [scalar - 1] else big_bytes(scalar, if code_value == 256 then 2 else 3)
    elif code_value == 340
        if count_fields != 5
            return error("bad value")
        for string word = fields[]
            payload_value = payload_value.append(try bounded(word, 0, 255))
    elif code_value == 344
        if count_fields != 3
            return error("bad value")
        string[] signature = fields[0].split("/")
        int nn = try bounded(signature[0], 1, 255)
        int dd = integer(signature[1])
        int exponent = -1
        for int j < 7
            if dd == 2 ^ j
                exponent = j
        if exponent < 0
            return error("bad value")
        payload_value = [nn, exponent, try bounded(fields[1], 0, 255), try bounded(fields[2], 0, 255)]
    elif code_value == 345
        if count_fields != 2
            return error("bad value")
        bool found = false
        for int mi < 2
            for -7 <= int sf <= 7
                if key_name(sf, mi) == fields.join(" ")
                    payload_value = [if sf < 0 then sf + 256 else sf, mi]
                    found = true
        if not found
            return error("bad value")
    else
        int beginning = 0
        if code_value == 512
            if count_fields < 2 or len(fields[0]) != 2
                return error("bad value")
            int tag = try unhex(fields[0])
            if known_meta(tag)
                return error("bad value")
            code_value = 256 + tag
            beginning = 1
        if count_fields <= beginning
            return error("bad value")
        int size = try bounded(fields[beginning], 0, 1000000)
        if count_fields != beginning + (if size == 0 then 1 else 2)
            return error("bad value")
        if size > 0
            string hex_data = fields[beginning + 1]
            if int(len(hex_data)) != size * 2
                return error("bad value")
            for int j < size
                payload_value = payload_value.append(try unhex(hex_data[2 * j:<2 * j + 2]))
    return Event(integer(words[0]), code_value, payload_value)
Song | error read_text(string[] lines)
    string[] header = lines[0].split(" ")
    if len(header) != 4 or header[0] != "HEADER"
        return error("line 1: bad header")
    int f = integer(header[1])
    int t = integer(header[2])
    int d = integer(header[3])
    if not (0 <= f <= 2) or not (1 <= t <= 65535) or not (1 <= d <= 32767) or (f == 0 and t != 1)
        return error("line 1: bad header")
    Song result = Song(f, d, [Track()])
    int current = 0
    for 1 <= nat j < len(lines)
        Event ev
        match text_event(lines[j])
            Event parsed
                ev = parsed
            error problem
                return error("line {j + 1}: {problem.message}")
        int track_number = integer(lines[j].split(" ")[1])
        string reason = ""
        bool ended = len(result.tracks[current].events) > 0 and result.tracks[current].events[int(len(result.tracks[current].events)) - 1].code == 303
        if track_number >= t
            reason = "bad track"
        elif track_number < current
            reason = "out of order"
        elif track_number > current and (not ended or track_number > current + 1)
            reason = "missing end of track"
        elif track_number == current and ended
            reason = "event after end of track"
        elif track_number == current and len(result.tracks[current].events) > 0 and ev.tick < result.tracks[current].events[int(len(result.tracks[current].events)) - 1].tick
            reason = "out of order"
        if reason != ""
            return error("line {j + 1}: {reason}")
        if track_number > current
            current += 1
            result.tracks = result.tracks.append(Track())
        result.tracks[current].events = result.tracks[current].events.append(ev)
    if current + 1 < t or len(result.tracks[current].events) == 0 or result.tracks[current].events[int(len(result.tracks[current].events)) - 1].code != 303
        return error("line {len(lines) + 1}: missing end of track")
    return result
int[] encode_song(Song song, bool running, bool zero_off)
    int[] result = "MThd".codepoints().concat(big_bytes(6, 4)).concat(big_bytes(song.format, 2)).concat(big_bytes(int(len(song.tracks)), 2)).concat(big_bytes(song.division, 2))
    for Track track_value = song.tracks[]
        int[] bytes = []
        int previous = 0
        int status = -1
        for Event ev = track_value.events[]
            bytes = bytes.concat(vlq_bytes(ev.tick - previous))
            previous = ev.tick
            int code_value = ev.code
            int[] payload_value = ev.payload
            if zero_off and code_value / 16 == 8
                code_value += 16
                payload_value[1] = 0
            if code_value < 240
                if not running or status != code_value
                    bytes = bytes.append(code_value)
                bytes = bytes.concat(payload_value)
                status = code_value
            else
                status = -1
                if code_value >= 256
                    bytes = bytes.append(255).append(code_value - 256)
                else
                    bytes = bytes.append(code_value)
                bytes = bytes.concat(vlq_bytes(int(len(payload_value)))).concat(payload_value)
        result = result.concat("MTrk".codepoints()).concat(big_bytes(int(len(bytes)), 4)).concat(bytes)
    return result
class NamedSong(string name, Song song)
class Codec()
    NamedSong[] songs = []
    bool running = true
    bool zero_off = false
    int lookup(string wanted)
        for nat j < len(songs)
            if songs[j].name == wanted
                return int(j)
        return -1
    void .store(string wanted, Song value)
        int at = lookup(wanted)
        if at < 0
            songs = songs.append(NamedSong(wanted, value))
        else
            songs[at].song = value
    string[] .command(string[] words, string[] data_lines)
        string op = words[0]
        string[] commands = ["HEX", "TEXT", "DECODE", "ENCODE", "TIMING", "NOTES", "STATS", "ROLL", "TRANSPOSE", "QUANTIZE", "VELOCITY", "TEMPO", "FILTER", "MERGE", "SPLIT", "COPY", "LIST", "RUNNING", "NOTEOFF"]
        bool known = false
        for string candidate = commands[]
            known = known or candidate == op
        if not known
            return ["error: unknown command"]
        if op == "HEX" or op == "TEXT"
            Song | error parsed = error("uninitialized")
            if op == "TEXT"
                parsed = read_text(data_lines)
            else
                int[] bytes = []
                for string data_line = data_lines[]
                    for string word = data_line.split(" ")[]
                        bytes = bytes.append(unhex(word))
                Parser parser_value = Parser(bytes)
                parsed = .parser_value.parse_song()
            match parsed
                error problem
                    return ["error: " + problem.message]
                Song value
                    .store(words[1], value)
                    return ["loaded {words[1]} {value.description()}"]
        if op == "LIST"
            string[] names = []
            for NamedSong named = songs[]
                names = names.append(named.name)
            string[] output = []
            for string name = names.sorted()[]
                output = output.append("{name} {songs[lookup(name)].song.description()}")
            return if len(output) == 0 then ["no songs"] else output
        if op == "RUNNING" or op == "NOTEOFF"
            if op == "RUNNING"
                if words[1] != "ON" and words[1] != "OFF"
                    return ["error: bad argument"]
                running = words[1] == "ON"
                return [if running then "running on" else "running off"]
            if words[1] != "ZERO" and words[1] != "KEEP"
                return ["error: bad argument"]
            zero_off = words[1] == "ZERO"
            return [if zero_off then "noteoff zero" else "noteoff keep"]
        int at = lookup(words[1])
        if at < 0
            return ["error: no song {words[1]}"]
        Song song = songs[at].song
        int[] arguments = []
        if op != "COPY"
            for 2 <= nat j < len(words)
                arguments = arguments.append(integer(words[j]))
        bool valid = true
        if op == "TRANSPOSE"
            valid = -127 <= arguments[0] <= 127 and (len(arguments) == 1 or 1 <= arguments[1] <= 16)
        elif op == "QUANTIZE"
            valid = 1 <= arguments[0] <= 1000000 and 0 <= arguments[1] <= 100
        elif op == "VELOCITY"
            valid = 0 <= arguments[0] <= 1000 and -127 <= arguments[1] <= 127
        elif op == "TEMPO"
            valid = 1 <= arguments[0] <= 1000 and 1 <= arguments[1] <= 1000
        elif op == "FILTER"
            for int item = arguments[]
                valid = valid and 1 <= item <= 16
        elif op == "ROLL"
            valid = 0 <= arguments[0] <= 10000000 and 1 <= arguments[1] <= 10000000 and 1 <= arguments[2] <= 10000000 and arguments[1] > arguments[0]
            if valid
                valid = (arguments[1] - arguments[0] + arguments[2] - 1) / arguments[2] <= 64
        if not valid
            return ["error: bad argument"]
        if (op == "TIMING" or op == "STATS") and song.format == 2
            return ["error: format 2 not supported"]
        if op == "COPY"
            .store(words[2], song)
            return ["copied {words[1]} to {words[2]}"]
        string[] output = []
        if op == "DECODE"
            output = ["HEADER {song.format} {len(song.tracks)} {song.division}"]
            for nat ti < len(song.tracks)
                for Event ev = song.tracks[ti].events[]
                    output = output.append(ev.text_line(int(ti)))
            return output
        if op == "ENCODE"
            int[] bytes = encode_song(song, running, zero_off)
            for 0 <= int j < int(len(bytes)) step 16
                string[] parts = []
                for j <= int k < minimum(j + 16, int(len(bytes)))
                    parts = parts.append(hex_value(bytes[k]))
                output = output.append(hex_value(j, 4) + ": " + parts.join(" "))
            return output.append("{len(bytes)} bytes")
        if op == "TIMING"
            for Placed placed = song.global_order()[]
                Event ev = placed.event
                output = output.append("{ev.tick} {placed.track_number} {kind_name(ev.code)} {song.clock_text(ev.tick)} {song.bar_text(ev.tick)}")
            int endpoint = song.length_ticks()
            return output.append("end {endpoint} {song.clock_text(endpoint)} {song.bar_text(endpoint)}")
        Pairing pairs = pair_notes(song)
        if op == "NOTES"
            output = ["notes {len(pairs.notes)} unmatched {len(pairs.unmatched)}"]
            for Note note = pairs.notes[]
                output = output.append("{note.start_tick} {note.duration} {note.channel_number} {note_name(note.pitch)} {note.velocity}")
            for int j = pairs.unmatched[]
                Placed placed = pairs.ordered[j]
                Event ev = placed.event
                string direction = if ev.note_on() then "on" else "off"
                output = output.append("unmatched {direction} {ev.tick} {placed.track_number} {ev.channel_number()} {note_name(ev.payload[0])}")
            return output
        if op == "ROLL"
            int columns = (arguments[1] - arguments[0] + arguments[2] - 1) / arguments[2]
            for 127 >= int pitch >= 0 step -1
                string cells = ""
                bool any_cell = false
                for int j < columns
                    int low = arguments[0] + j * arguments[2]
                    string cell = "."
                    for Note note = pairs.notes[]
                        if note.pitch == pitch
                            if low <= note.start_tick < low + arguments[2]
                                cell = "#"
                            elif cell != "#" and note.start_tick <= low < note.start_tick + note.duration
                                cell = "="
                    cells += cell
                    any_cell = any_cell or cell != "."
                if any_cell
                    string label = note_name(pitch)
                    output = output.append(label + string.repeat(" ", nat(maximum(0, 4 - int(len(label))))) + " " + cells)
            return if len(output) == 0 then ["empty"] else output
        if op == "STATS"
            output = [song.description(), "notes {len(pairs.notes)} unmatched {len(pairs.unmatched)}"]
            int lowest = 128
            int highest = -1
            int peak = 0
            int peak_tick = 0
            for 1 <= int channel_id <= 16
                int count_notes = 0
                int low = 128
                int high = -1
                for Note note = pairs.notes[]
                    if note.channel_number == channel_id
                        count_notes += 1
                        low = minimum(low, note.pitch)
                        high = maximum(high, note.pitch)
                if count_notes > 0
                    output = output.append("channel {channel_id} notes {count_notes} range {note_name(low)} {note_name(high)}")
                    lowest = minimum(lowest, low)
                    highest = maximum(highest, high)
            for Note candidate = pairs.notes[]
                int active = 0
                for Note note = pairs.notes[]
                    if note.start_tick <= candidate.start_tick < note.start_tick + note.duration
                        active += 1
                if active > peak
                    peak = active
                    peak_tick = candidate.start_tick
            output = output.append(if highest < 0 then "range none" else "range {note_name(lowest)} {note_name(highest)}")
            int endpoint = song.length_ticks()
            output = output.append("length {endpoint} ticks {song.clock_text(endpoint)} ms")
            return output.append(if peak == 0 then "polyphony 0" else "polyphony {peak} at {peak_tick}")
        if op == "TRANSPOSE" or op == "FILTER"
            int changed = 0
            int dropped = 0
            string[] dropped_lines = []
            for nat ti < len(song.tracks)
                Event[] kept = []
                for Event ev = song.tracks[ti].events[]
                    bool remove = false
                    if op == "FILTER" and ev.channel_message()
                        remove = true
                        for int channel_id = arguments[]
                            if ev.channel_number() == channel_id
                                remove = false
                    elif op == "TRANSPOSE" and ev.code / 16 >= 8 and ev.code / 16 <= 10 and (len(arguments) == 1 or ev.channel_number() == arguments[1])
                        int pitch = ev.payload[0] + arguments[0]
                        if not (0 <= pitch <= 127)
                            remove = true
                            dropped_lines = dropped_lines.append("dropped {ev.tick} {ti} {kind_name(ev.code)} {ev.channel_number()} {note_name(ev.payload[0])}")
                        else
                            ev.payload[0] = pitch
                            changed += 1
                    if remove
                        dropped += 1
                    else
                        kept = kept.append(ev)
                song.tracks[ti].events = kept
            output = if op == "FILTER" then ["removed {dropped}"] else ["transposed {changed} dropped {dropped}"].concat(dropped_lines)
        elif op == "VELOCITY"
            int changed = 0
            int clamped = 0
            for auto &track_value = &song.tracks[]
                for auto &ev = &track_value.events[]
                    if ev.note_on()
                        int v = (ev.payload[1] * arguments[0] + 50) / 100 + arguments[1]
                        if v < 1 or v > 127
                            clamped += 1
                        ev.payload[1] = minimum(127, maximum(1, v))
                        changed += 1
            output = ["velocity {changed} clamped {clamped}"]
        elif op == "TEMPO"
            bool at_zero = false
            int changed = 0
            int inserted_value = (2 * 500000 * arguments[1] + arguments[0]) / (2 * arguments[0])
            for auto &track_value = &song.tracks[]
                for auto &ev = &track_value.events[]
                    if ev.code == 337
                        int value = (2 * big_endian(ev.payload) * arguments[1] + arguments[0]) / (2 * arguments[0])
                        if not (1 <= value <= 16777215)
                            return ["error: tempo out of range"]
                        ev.payload = big_bytes(value, 3)
                        at_zero = at_zero or ev.tick == 0
                        changed += 1
            output = ["scaled {changed}"]
            if not at_zero
                if not (1 <= inserted_value <= 16777215)
                    return ["error: tempo out of range"]
                Event inserted_event = Event(0, 337, big_bytes(inserted_value, 3))
                song.tracks[0].events = [inserted_event].concat(song.tracks[0].events)
                output = output.append("inserted " + inserted_event.text_line(0))
        elif op == "QUANTIZE"
            int[] on_indices = []
            int[] off_indices = []
            for Note note = pairs.notes[]
                on_indices = on_indices.append(note.on_index)
                off_indices = off_indices.append(note.off_index)
            for int j = pairs.pending[]
                on_indices = on_indices.append(j)
                off_indices = off_indices.append(-1)
            int moved = 0
            for nat j < len(on_indices)
                Placed placed = pairs.ordered[on_indices[j]]
                int t = placed.event.tick
                int grid = arguments[0]
                int low = (t / grid) * grid
                int target = if t - low <= low + grid - t then low else low + grid
                int delta = floor_div(2 * (target - t) * arguments[1] + 100, 200)
                song.tracks[placed.track_number].events[placed.event_number].tick += delta
                if off_indices[j] >= 0
                    Placed off_event = pairs.ordered[off_indices[j]]
                    song.tracks[off_event.track_number].events[off_event.event_number].tick += delta
                if delta != 0
                    moved += 1
            for auto &track_value = &song.tracks[]
                Event end_event = track_value.events[int(len(track_value.events)) - 1]
                Event[] ordinary = track_value.events[0:<int(len(track_value.events)) - 1]
                for 1 <= int a < int(len(ordinary))
                    int b = a
                    while b > 0 and ordinary[b].tick < ordinary[b - 1].tick
                        Event temporary = ordinary[b]
                        ordinary[b] = ordinary[b - 1]
                        ordinary[b - 1] = temporary
                        b -= 1
                if len(ordinary) > 0
                    end_event.tick = maximum(end_event.tick, ordinary[int(len(ordinary)) - 1].tick)
                track_value.events = ordinary.append(end_event)
            output = ["quantized {len(on_indices)} moved {moved}"]
        elif op == "MERGE"
            if song.format != 1
                return ["error: not format 1"]
            int original_count = int(len(song.tracks))
            int endpoint = song.length_ticks()
            Event[] merged = []
            for Placed placed = song.global_order()[]
                if placed.event.code != 303
                    merged = merged.append(placed.event)
            song.tracks = [Track(merged.append(Event(endpoint, 303)))]
            song.format = 0
            output = ["merged {original_count} tracks events {song.event_count()}"]
        elif op == "SPLIT"
            if song.format != 0
                return ["error: not format 0"]
            int endpoint = song.length_ticks()
            Track[] tracks_new = [Track()]
            int[] mapping = array(16, fill = -1)
            for int channel_id < 16
                for Event ev = song.tracks[0].events[]
                    if ev.channel_message() and ev.code % 16 == channel_id and mapping[channel_id] < 0
                        mapping[channel_id] = int(len(tracks_new))
                        tracks_new = tracks_new.append(Track())
            for Event ev = song.tracks[0].events[]
                if ev.code != 303
                    int destination = if ev.channel_message() then mapping[ev.code % 16] else 0
                    tracks_new[destination].events = tracks_new[destination].events.append(ev)
            for auto &track_value = &tracks_new[]
                track_value.events = track_value.events.append(Event(endpoint, 303))
            song.tracks = tracks_new
            song.format = 1
            output = ["split tracks {len(song.tracks)} events {song.event_count()}"]
        songs[at].song = song
        return output
Codec codec = Codec()
int command_count
scan(&command_count)
for int command_index < command_count
    string line
    scan(&line)
    string[] words = line.split(" ")
    string[] data_lines = []
    if words[0] == "HEX" or words[0] == "TEXT"
        for int j < integer(words[2])
            string data_line
            scan(&data_line)
            data_lines = data_lines.append(data_line)
    for string result_line = (.codec.command(words, data_lines))[]
        print(result_line + NL)
