void emit(string text)
    print(text + NL)

bool has_word(string[] items, string value)
    for string item = items[]
        if item == value
            return true
    return false

bool has_vertex(nat[] items, nat value)
    for nat item = items[]
        if item == value
            return true
    return false

nat word_index(string[] items, string value)
    for string item = items[nat i]
        if item == value
            return i
    return len(items)

string yes_no(bool value)
    return if value then "yes" else "no"

class Edge(nat u, nat v, int capacity, int cost = 0)
    int lower = 0
    int flow = 0

nat arc_index(int arc)
    return nat(if arc > 0 then arc - 1 else -arc - 1)

nat arc_start(Edge[] edges, int arc)
    return if arc > 0 then edges[arc_index(arc)].u else edges[arc_index(arc)].v

nat arc_end(Edge[] edges, int arc)
    return if arc > 0 then edges[arc_index(arc)].v else edges[arc_index(arc)].u

int arc_residual(Edge[] edges, int arc)
    Edge edge = edges[arc_index(arc)]
    return if arc > 0 then edge.capacity - edge.flow else edge.flow

int arc_cost(Edge[] edges, int arc)
    return if arc > 0 then edges[arc_index(arc)].cost else -edges[arc_index(arc)].cost

Edge[] fresh_edges(Edge[] edges)
    return [for Edge edge = edges[] then Edge(edge.u, edge.v, edge.capacity, edge.cost)]

int outflow(Edge[] edges, nat vertex)
    int result = 0
    for Edge edge = edges[]
        if edge.u == vertex
            result += edge.flow
    return result

int inflow(Edge[] edges, nat vertex)
    int result = 0
    for Edge edge = edges[]
        if edge.v == vertex
            result += edge.flow
    return result

int flow_value(Edge[] edges, nat vertex)
    return outflow(edges, vertex) - inflow(edges, vertex)

int total_cost(Edge[] edges)
    int result = 0
    for Edge edge = edges[]
        result += edge.flow * edge.cost
    return result

class Breadth(int[] levels, int[] parents)
class PathResult(bool found, int unit_cost, int[] path)
class Push(bool found, int amount, int[] path, int marker = 0, int unit_cost = 0)
class DinicResult(nat phases, Push[] pushes)
class CostResult(int amount, int cost, Push[] pushes)

class FlowGraph(nat count, Edge[] edge_list, int[][] arcs, int[] global_arcs)
    Breadth breadth_first(nat source, int threshold = 1)
        int[] levels = array(count, fill = -1)
        int[] parents = array(count, fill = 0)
        levels[source] = 0
        nat[] queue = [source]
        nat at = 0
        while at < len(queue)
            nat vertex = queue[at]
            at += 1
            for int arc = arcs[vertex][]
                nat target = arc_end(edge_list, arc)
                if arc_residual(edge_list, arc) >= threshold and levels[target] < 0
                    levels[target] = levels[vertex] + 1
                    parents[target] = arc
                    queue = queue.append(target)
        return Breadth(levels, parents)

    int[] trace_path(int[] parents, nat source, nat sink)
        int[] result = []
        nat vertex = sink
        while vertex != source
            int arc = parents[vertex]
            result = result.append(arc)
            vertex = arc_start(edge_list, arc)
        return result[::-1]

    int bottleneck(int[] path)
        int result = arc_residual(edge_list, path[0])
        for int arc = path[]
            int capacity = arc_residual(edge_list, arc)
            if capacity < result
                result = capacity
        return result

    void .push_path(int[] path, int amount)
        for int arc = path[]
            edge_list[arc_index(arc)].flow += if arc > 0 then amount else -amount

    Push .augment(nat source, nat sink, int threshold = 1)
        Breadth search = breadth_first(source, threshold)
        if search.levels[sink] < 0
            return Push(false, 0, [])
        int[] path = trace_path(search.parents, source, sink)
        int amount = bottleneck(path)
        .push_path(path, amount)
        return Push(true, amount, path, threshold)

    Push[] .edmonds_karp(nat source, nat sink)
        Push[] result = []
        while true
            Push item = .augment(source, sink)
            if not item.found
                return result
            result = result.append(item)

    DinicResult .dinic(nat source, nat sink)
        nat phases = 0
        Push[] result = []
        while true
            Breadth search = breadth_first(source)
            if search.levels[sink] < 0
                return DinicResult(phases, result)
            phases += 1
            nat[] pointers = array(count, fill = 0)
            int[] path = []
            nat vertex = source
            while true
                if vertex == sink
                    int amount = bottleneck(path)
                    .push_path(path, amount)
                    result = result.append(Push(true, amount, path, int(phases)))
                    path = []
                    vertex = source
                elif pointers[vertex] == len(arcs[vertex])
                    if vertex == source
                        break
                    int arc = path[len(path) - 1]
                    path = path[:<len(path) - 1]
                    vertex = arc_start(edge_list, arc)
                    pointers[vertex] += 1
                else
                    int arc = arcs[vertex][pointers[vertex]]
                    nat target = arc_end(edge_list, arc)
                    if arc_residual(edge_list, arc) > 0 and search.levels[target] == search.levels[vertex] + 1
                        path = path.append(arc)
                        vertex = target
                    else
                        pointers[vertex] += 1

    Push[] .scaling(nat source, nat sink)
        int largest = 0
        for Edge edge = edge_list[]
            if edge.capacity > largest
                largest = edge.capacity
        int threshold = 1
        while threshold * 2 <= largest
            threshold *= 2
        Push[] result = []
        while threshold >= 1
            while true
                Push item = .augment(source, sink, threshold)
                if not item.found
                    break
                result = result.append(item)
            threshold /= 2
        return result

    PathResult cheapest_path(nat source, nat sink)
        int[] usable = [for int arc = global_arcs[] if arc_residual(edge_list, arc) > 0 then arc]
        bool[] known = array(count, fill = false)
        int[] distance = array(count, fill = 0)
        int[] parents = array(count, fill = 0)
        known[source] = true
        while true
            bool changed = false
            for int arc = usable[]
                nat first = arc_start(edge_list, arc)
                nat last = arc_end(edge_list, arc)
                if not known[first]
                    continue
                int candidate = distance[first] + arc_cost(edge_list, arc)
                if not known[last] or candidate < distance[last]
                    distance[last] = candidate
                    known[last] = true
                    parents[last] = arc
                    changed = true
            if not changed
                break
        return PathResult(known[sink], distance[sink], if known[sink] then trace_path(parents, source, sink) else [])

    CostResult .minimum_cost(nat source, nat sink, int target = -1)
        int amount = 0
        int cost = 0
        Push[] result = []
        while target < 0 or amount < target
            PathResult search = cheapest_path(source, sink)
            if not search.found
                break
            int delta = bottleneck(search.path)
            if target >= 0 and delta > target - amount
                delta = target - amount
            .push_path(search.path, delta)
            amount += delta
            cost += delta * search.unit_cost
            result = result.append(Push(true, delta, search.path, 0, search.unit_cost))
        return CostResult(amount, cost, result)

FlowGraph graph_for(nat count, Edge[] edges)
    int[] all_arcs = [for nat i < len(edges) then int(i + 1)]
    all_arcs = all_arcs.concat([for nat i < len(edges) then -int(i + 1)])
    int[][] adjacency = [for nat vertex < count then [for int arc = all_arcs[] if arc_start(edges, arc) == vertex then arc]]
    return FlowGraph(count, edges, adjacency, all_arcs)

bool negative_cycle(nat count, Edge[] edges)
    int[] distance = array(count, fill = 0)
    for nat round < count
        bool changed = false
        for Edge edge = edges[]
            int candidate = distance[edge.u] + edge.cost
            if candidate < distance[edge.v]
                distance[edge.v] = candidate
                changed = true
        if not changed
            return false
        if round + 1 == count
            return true
    return false

int maximum_amount(nat count, Edge[] edges, nat source, nat sink)
    FlowGraph graph = graph_for(count, edges)
    Push[] ignored = .graph.edmonds_karp(source, sink)
    return flow_value(graph.edge_list, source)

class FlowPiece(bool cycle, nat origin, nat[] edges, int amount)

FlowPiece[] decompose(nat count, Edge[] edges)
    int[] remaining = [for Edge edge = edges[] then edge.flow]
    int[] balance = [for nat vertex < count then flow_value(edges, vertex)]
    FlowPiece[] pieces = []
    while true
        nat first_edge = len(edges)
        for nat i < len(edges)
            if remaining[i] > 0
                first_edge = i
                break
        if first_edge == len(edges)
            return pieces
        nat origin = edges[first_edge].u
        for nat vertex < count
            if balance[vertex] > 0
                origin = vertex
                break
        nat[] walk = [origin]
        nat[] used = []
        while true
            nat vertex = walk[len(walk) - 1]
            nat selected = 0
            for Edge edge = edges[nat i]
                if edge.u == vertex and remaining[i] > 0
                    selected = i
                    break
            nat target = edges[selected].v
            used = used.append(selected)
            nat repeated = len(walk)
            for nat item = walk[nat i]
                if item == target
                    repeated = i
                    break
            if repeated < len(walk)
                nat[] cycle = used[repeated:]
                int amount = remaining[cycle[0]]
                for nat i = cycle[]
                    if remaining[i] < amount
                        amount = remaining[i]
                for nat i = cycle[]
                    remaining[i] -= amount
                pieces = pieces.append(FlowPiece(true, target, cycle, amount))
                break
            walk = walk.append(target)
            if balance[target] < 0
                int amount = if balance[origin] < -balance[target] then balance[origin] else -balance[target]
                for nat i = used[]
                    if remaining[i] < amount
                        amount = remaining[i]
                for nat i = used[]
                    remaining[i] -= amount
                balance[origin] -= amount
                balance[target] += amount
                pieces = pieces.append(FlowPiece(false, origin, used, amount))
                break

string path_notation(string[] names, Edge[] edges, nat origin, int[] path)
    string[] words = [names[origin]]
    for int arc = path[]
        words = words.append((if arc > 0 then "+" else "-") + "{arc_index(arc) + 1}")
        words = words.append(names[arc_end(edges, arc)])
    return words.join(" ")

class Link(nat left, nat right)
class Matching(nat left_count, nat right_count, Link[] links)
    int[] left_partner = array(left_count, fill = -1)
    int[] right_partner = array(right_count, fill = -1)
    bool[] examined = array(right_count, fill = false)

    bool .try_left(nat vertex)
        for Link link = links[]
            if link.left != vertex or examined[link.right]
                continue
            examined[link.right] = true
            int partner = right_partner[link.right]
            if partner < 0 or .try_left(nat(partner))
                right_partner[link.right] = int(vertex)
                left_partner[vertex] = int(link.right)
                return true
        return false

    void .solve()
        for nat vertex < left_count
            examined = array(right_count, fill = false)
            bool found = .try_left(vertex)

void | error matching_report(string[] args)
    string[] left = args[0].split(",")
    string[] right = args[1].split(",")
    string[] seen = []
    for string name = left.concat(right)[]
        if has_word(seen, name)
            return error("DUPLICATE VERTEX {name}")
        seen = seen.append(name)
    Link[] links = []
    string[] pairs = if args[2] == "-" then [] else args[2].split(",")
    for string pair = pairs[]
        string[] names = pair.split("-")
        nat a = word_index(left, names[0])
        nat b = word_index(right, names[1])
        if a == len(left)
            return error("UNKNOWN VERTEX {names[0]}")
        if b == len(right)
            return error("UNKNOWN VERTEX {names[1]}")
        for Link link = links[]
            if link.left == a and link.right == b
                return error("DUPLICATE PAIR {pair}")
        links = links.append(Link(a, b))
    auto matching = Matching(len(left), len(right), links)
    .matching.solve()
    bool[] left_in = [for int partner = matching.left_partner[] then partner < 0]
    bool[] right_in = array(len(right), fill = false)
    while true
        bool changed = false
        for Link link = links[]
            if left_in[link.left] and not right_in[link.right] and matching.left_partner[link.left] != int(link.right)
                right_in[link.right] = true
                changed = true
        for int partner = matching.right_partner[nat b]
            if right_in[b] and partner >= 0 and not left_in[nat(partner)]
                left_in[nat(partner)] = true
                changed = true
        if not changed
            break
    nat size = len([for int partner = matching.left_partner[] if partner >= 0 then partner])
    emit("MATCH size={size} left={len(left)} right={len(right)}")
    for int partner = matching.left_partner[nat a]
        if partner >= 0
            emit("PAIR {left[a]} {right[nat(partner)]}")
    string[] free_left = [for string name = left[nat a] if matching.left_partner[a] < 0 then name]
    string[] free_right = [for string name = right[nat b] if matching.right_partner[b] < 0 then name]
    emit("FREE " + (if len(free_left) == 0 then "-" else free_left.join(",")) + " " + (if len(free_right) == 0 then "-" else free_right.join(",")))
    string[] cover = [for string name = left[nat a] if not left_in[a] then name]
    cover = cover.concat([for string name = right[nat b] if right_in[b] then name])
    emit("COVER size={len(cover)}" + (if len(cover) == 0 then "" else " " + cover.join(" ")))
    if len(free_left) > 0
        string[] hall_left = [for string name = left[nat a] if left_in[a] then name]
        string[] hall_right = [for string name = right[nat b] if right_in[b] then name]
        emit("HALL {hall_left.join(",")} " + (if len(hall_right) == 0 then "-" else hall_right.join(",")))

class AssignmentSearch(nat size, string[] values, bool maximize)
    bool found = false
    int best = 0
    nat ways = 0
    nat[] chosen = []

    void .search_branch(nat[] columns, int total)
        nat row = len(columns)
        if row == size
            if not found or (if maximize then total > best else total < best)
                found = true
                best = total
                ways = 1
                chosen = columns
            elif total == best
                ways += 1
            return
        for nat column < size
            string value = values[row * size + column]
            if value == "x" or has_vertex(columns, column)
                continue
            .search_branch(columns.append(column), total + int.parse(value))

void | error assignment_report(string[] args)
    nat size = nat.parse(args[1])
    if size < 1 or size > 8
        return error("BAD SIZE")
    if len(args) - 2 != size * size
        return error("BAD LENGTH")
    auto search = AssignmentSearch(size, args[2:], args[0] == "MAX")
    .search.search_branch([], 0)
    if not search.found
        emit("ASSIGN {args[0]} n={size} infeasible")
        return
    emit("ASSIGN {args[0]} n={size} total={search.best} optimal={search.ways}")
    for nat column = search.chosen[nat row]
        emit("MATE {row + 1} {column + 1} {args[row * size + column + 2]}")

class Network()
    string[] names = []
    int[] demands = []
    Edge[] edge_list = []
    string owner = "none"
    nat source = 0
    nat sink = 0

    nat | error require_node(string name)
        nat at = word_index(names, name)
        if at == len(names)
            return error("UNKNOWN NODE {name}")
        return at

    nat | error require_edge(string text)
        nat number = nat.parse(text)
        if number == 0 or number > len(edge_list)
            return error("UNKNOWN EDGE {text}")
        return number - 1

    void | error check_endpoints(string first, string last)
        nat a = try require_node(first)
        nat b = try require_node(last)
        if a == b
            return error("SAME NODE")

    int .start_flow(nat first, nat last)
        if owner != "flow" or source != first or sink != last
            for nat i < len(edge_list)
                edge_list[i].flow = 0
        owner = "flow"
        source = first
        sink = last
        return flow_value(edge_list, source)

    void flow_list()
        for Edge edge = edge_list[nat i]
            emit("FLOW {i + 1} {names[edge.u]} {names[edge.v]} {edge.flow}/{edge.capacity}")

    void | error .execute(string line)
        string[] words = line.split(" ")
        string command = words[0]
        string[] args = words[1:]
        if command == "NODE"
            string[] seen = names
            for string name = args[]
                if has_word(seen, name)
                    return error("DUPLICATE NODE {name}")
                seen = seen.append(name)
            if len(names) + len(args) > 20
                return error("TOO MANY NODES")
            names = seen
            demands = demands.concat(array(len(args), fill = 0))
            emit("NODE added={len(args)} total={len(names)}")
        elif command == "EDGE"
            nat first = try require_node(args[0])
            nat last = try require_node(args[1])
            if first == last
                return error("SELF LOOP")
            if len(edge_list) == 60
                return error("TOO MANY EDGES")
            int cost = if len(args) == 4 then int.parse(args[3]) else 0
            Edge edge = Edge(first, last, int.parse(args[2]), cost)
            edge_list = edge_list.append(edge)
            emit("EDGE {len(edge_list)} {args[0]} {args[1]} cap={edge.capacity} cost={cost}")
        elif command == "LOWER" or command == "CAP" or command == "COST"
            nat at = try require_edge(args[0])
            int value = int.parse(args[1])
            Edge edge = edge_list[at]
            if command == "LOWER"
                if value > edge.capacity
                    return error("BAD BOUND")
                edge_list[at].lower = value
                emit("LOWER {at + 1} low={value} cap={edge.capacity}")
            elif command == "CAP"
                if value < edge.lower
                    return error("BAD BOUND")
                if value < edge.flow
                    return error("BELOW FLOW")
                edge_list[at].capacity = value
                emit("CAP {at + 1} low={edge.lower} cap={value}")
            else
                edge_list[at].cost = value
                emit("COST {at + 1} cost={value}")
        elif command == "DEMAND"
            nat at = try require_node(args[0])
            demands[at] = int.parse(args[1])
            int total = 0
            for int value = demands[]
                total += value
            emit("DEMAND {args[0]} {args[1]} total={total}")
        elif command == "RESET"
            nat changed = len([for Edge edge = edge_list[] if edge.flow != 0 then edge])
            for nat i < len(edge_list)
                edge_list[i].flow = 0
            owner = "none"
            emit("RESET edges={changed}")
        elif command == "CLEAR"
            emit("CLEAR nodes={len(names)} edges={len(edge_list)}")
            names = []
            demands = []
            edge_list = []
            owner = "none"
            source = 0
            sink = 0
        elif command == "SHOW"
            emit("NETWORK nodes={len(names)} edges={len(edge_list)}")
            if owner == "none"
                emit("STATE none")
            elif owner == "circulation"
                emit("STATE circulation cost={total_cost(edge_list)}")
            else
                emit("STATE flow {names[source]} {names[sink]} value={flow_value(edge_list, source)} cost={total_cost(edge_list)}")
            for string name = names[nat vertex]
                emit("NODE {name} demand={demands[vertex]} out={outflow(edge_list, vertex)} in={inflow(edge_list, vertex)}")
            for Edge edge = edge_list[nat i]
                emit("EDGE {i + 1} {names[edge.u]} {names[edge.v]} cap={edge.capacity} cost={edge.cost} low={edge.lower} flow={edge.flow}")
        elif command == "AUGMENT" or command == "MAXFLOW" or command == "DINIC" or command == "SCALING" or command == "MINCUT"
            try check_endpoints(args[0], args[1])
            nat first = try require_node(args[0])
            nat last = try require_node(args[1])
            int start = .start_flow(first, last)
            FlowGraph graph = graph_for(len(names), edge_list)
            string heading = "{command} {args[0]} {args[1]}"
            if command == "AUGMENT"
                Push item = .graph.augment(first, last)
                edge_list = graph.edge_list
                emit("{heading} value={flow_value(edge_list, first)}" + (if not item.found then " none" else " amount={item.amount} {path_notation(names, edge_list, first, item.path)}"))
                return
            nat phases = 0
            Push[] pushes = []
            if command == "DINIC"
                DinicResult result = .graph.dinic(first, last)
                phases = result.phases
                pushes = result.pushes
            elif command == "SCALING"
                pushes = .graph.scaling(first, last)
            else
                pushes = .graph.edmonds_karp(first, last)
            edge_list = graph.edge_list
            if command == "MINCUT"
                Breadth search = graph.breadth_first(first)
                nat[] cut = [for Edge edge = edge_list[nat i] if search.levels[edge.u] >= 0 and search.levels[edge.v] < 0 then i]
                emit("{heading} value={flow_value(edge_list, first)} edges={len(cut)}")
                emit("SOURCE " + [for string name = names[nat v] if search.levels[v] >= 0 then name].join(" "))
                emit("SINK " + [for string name = names[nat v] if search.levels[v] < 0 then name].join(" "))
                for nat i = cut[]
                    Edge edge = edge_list[i]
                    emit("CUT {i + 1} {names[edge.u]} {names[edge.v]} {edge.capacity}")
            else
                emit("{heading} value={flow_value(edge_list, first)} start={start}" + (if command == "DINIC" then " phases={phases}" else "") + " paths={len(pushes)}")
                for Push item = pushes[nat i]
                    string detail = if command == "DINIC" then " phase={item.marker}" else (if command == "SCALING" then " delta={item.marker}" else "")
                    emit("AUG {i + 1}{detail} amount={item.amount} {path_notation(names, edge_list, first, item.path)}")
                flow_list()
        elif command == "SENSITIVITY"
            try check_endpoints(args[0], args[1])
            nat first = try require_node(args[0])
            nat last = try require_node(args[1])
            int value = maximum_amount(len(names), fresh_edges(edge_list), first, last)
            bool[] up = []
            bool[] down = []
            for Edge edge = edge_list[nat i]
                Edge[] work = fresh_edges(edge_list)
                work[i].capacity += 1
                up = up.append(maximum_amount(len(names), work, first, last) > value)
                bool effective = false
                if edge.capacity > 0
                    work = fresh_edges(edge_list)
                    work[i].capacity -= 1
                    effective = maximum_amount(len(names), work, first, last) < value
                down = down.append(effective)
            nat ups = len([for bool flag = up[] if flag then flag])
            nat downs = len([for bool flag = down[] if flag then flag])
            emit("SENSITIVITY {args[0]} {args[1]} value={value} up={ups} down={downs}")
            for Edge edge = edge_list[nat i]
                if up[i] or down[i]
                    emit("CRITICAL {i + 1} {names[edge.u]} {names[edge.v]} up={yes_no(up[i])} down={yes_no(down[i])}")
        elif command == "MINCOST"
            try check_endpoints(args[0], args[1])
            nat first = try require_node(args[0])
            nat last = try require_node(args[1])
            if negative_cycle(len(names), [for Edge edge = edge_list[] if edge.capacity > 0 then edge])
                return error("NEGATIVE CYCLE")
            int target = if args[2] == "MAX" then -1 else int.parse(args[2])
            FlowGraph graph = graph_for(len(names), fresh_edges(edge_list))
            CostResult result = .graph.minimum_cost(first, last, target)
            string heading = "MINCOST {args[0]} {args[1]} k={args[2]}"
            if target >= 0 and result.amount < target
                emit("{heading} infeasible max={result.amount}")
                return
            for nat i < len(edge_list)
                edge_list[i].flow = graph.edge_list[i].flow
            owner = "flow"
            source = first
            sink = last
            emit("{heading} flow={result.amount} cost={result.cost}")
            for Push item = result.pushes[nat i]
                emit("AUG {i + 1} amount={item.amount} cost={item.unit_cost} {path_notation(names, edge_list, first, item.path)}")
            flow_list()
        elif command == "DISJOINT"
            try check_endpoints(args[0], args[1])
            nat first = try require_node(args[0])
            nat last = try require_node(args[1])
            nat[] exits = [for nat v < len(names) then v]
            nat count = len(names)
            if args[2] == "VERTEX"
                count *= 2
                for nat v < len(names)
                    if v != first and v != last
                        exits[v] = len(names) + v
            Edge[] work = [for Edge edge = edge_list[] then Edge(exits[edge.u], edge.v, if edge.capacity > 0 then 1 else 0)]
            if args[2] == "VERTEX"
                for nat v < len(names)
                    if v != first and v != last
                        work = work.append(Edge(v, exits[v], 1))
            FlowGraph graph = graph_for(count, work)
            Push[] ignored = .graph.edmonds_karp(first, last)
            FlowPiece[] pieces = [for FlowPiece item = decompose(count, graph.edge_list)[] if not item.cycle then item]
            emit("DISJOINT {args[0]} {args[1]} {args[2]} count={len(pieces)}")
            for FlowPiece item = pieces[nat i]
                int[] path = [for nat index = item.edges[] if index < len(edge_list) then int(index + 1)]
                emit("PATH {i + 1} {path_notation(names, edge_list, item.origin, path)}")
        elif command == "DECOMPOSE"
            FlowPiece[] pieces = decompose(len(names), edge_list)
            nat cycles = len([for FlowPiece item = pieces[] if item.cycle then item])
            emit("DECOMPOSE paths={len(pieces) - cycles} cycles={cycles}")
            nat paths = 0
            nat cycle_count = 0
            for FlowPiece item = pieces[]
                string title = ""
                if item.cycle
                    cycle_count += 1
                    title = "CYCLE {cycle_count}"
                else
                    paths += 1
                    title = "PATH {paths}"
                int[] path = [for nat index = item.edges[] then int(index + 1)]
                emit("{title} amount={item.amount} {path_notation(names, edge_list, item.origin, path)}")
        elif command == "VERIFY"
            string[] violations = []
            for Edge edge = edge_list[nat i]
                if edge.flow < edge.lower
                    violations = violations.append("LOW {i + 1} flow={edge.flow} low={edge.lower}")
            for string name = names[nat vertex]
                if owner == "flow" and (vertex == source or vertex == sink)
                    continue
                int need = if owner == "flow" then 0 else demands[vertex]
                int net = inflow(edge_list, vertex) - outflow(edge_list, vertex)
                if net != need
                    violations = violations.append("BALANCE {name} net={net} need={need}")
            if len(violations) == 0
                emit("VERIFY ok")
            else
                emit("VERIFY violations={len(violations)}")
                for string violation = violations[]
                    emit(violation)
        elif command == "CIRCULATION"
            if args[0] == "MINCOST" and negative_cycle(len(names), [for Edge edge = edge_list[] if edge.capacity > edge.lower then edge])
                return error("NEGATIVE CYCLE")
            int imbalance = 0
            for int demand = demands[]
                imbalance += demand
            if imbalance != 0
                emit("CIRCULATION infeasible unbalanced={imbalance}")
                return
            int[] required = demands
            Edge[] work = []
            for Edge edge = edge_list[]
                required[edge.v] -= edge.lower
                required[edge.u] += edge.lower
                work = work.append(Edge(edge.u, edge.v, edge.capacity - edge.lower, edge.cost))
            for int value = required[nat v]
                if value < 0
                    work = work.append(Edge(len(names), v, -value))
            nat[] sink_edges = []
            int total = 0
            for int value = required[nat v]
                if value > 0
                    sink_edges = sink_edges.append(len(work))
                    work = work.append(Edge(v, len(names) + 1, value))
                    total += value
            FlowGraph graph = graph_for(len(names) + 2, work)
            if args[0] == "ANY"
                Push[] ignored = .graph.edmonds_karp(len(names), len(names) + 1)
            else
                CostResult ignored = .graph.minimum_cost(len(names), len(names) + 1)
            int achieved = 0
            for nat i = sink_edges[]
                achieved += graph.edge_list[i].flow
            if achieved < total
                emit("CIRCULATION infeasible required={total} achieved={achieved}")
                Breadth search = graph.breadth_first(len(names))
                emit("CUT " + [for string name = names[nat v] if search.levels[v] >= 0 then name].join(" "))
                return
            for nat i < len(edge_list)
                edge_list[i].flow = edge_list[i].lower + graph.edge_list[i].flow
            owner = "circulation"
            emit("CIRCULATION feasible required={total} cost={total_cost(edge_list)}")
            flow_list()
        elif command == "MATCH"
            try matching_report(args)
        elif command == "ASSIGN"
            try assignment_report(args)

auto network = Network()
nat count
scan(&count)
for nat i < count
    string line
    scan(&line)
    match .network.execute(line)
        void
            void
        error issue
            emit("ERROR {issue.message}")
