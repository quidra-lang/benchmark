void emit(string text)
    print(text + NL)

bool has(int[] items, int target)
    for int item = items[]
        if item == target
            return true
    return false

bool includes(string[] items, string target)
    for string item = items[]
        if item == target
            return true
    return false

string other(string color)
    return if color == "B" then "W" else "B"

string columns()
    return "ABCDEFGHJKLMNOPQRST"

string[] handicap_names(int size)
    if size == 9
        return "C3 G7 C7 G3 C5 G5 E3 E7 E5".split(" ")
    if size == 13
        return "D4 K10 D10 K4 D7 K7 G4 G10 G7".split(" ")
    return "D4 Q16 D16 Q4 D10 Q10 K4 K16 K10".split(" ")

string point_name(int point, int size)
    return columns()[point % size] + "{point / size + 1}"

int point_number(string text, int size)
    if len(text) < 2
        return -1
    match columns().find(text[0])
        nat column
            if column >= nat(size)
                return -1
            string row_text = text[1:]
            if row_text == "" or row_text[0] == "0"
                return -1
            for nat i < len(row_text)
                if not "0123456789".contains(row_text[i])
                    return -1
            match int.parse(row_text)
                int row
                    if not (1 <= row <= size)
                        return -1
                    return size * (row - 1) + int(column)
                error problem
                    return -1
        none
            return -1

string sgf(int point, int size)
    string alphabet = "abcdefghijklmnopqrs"
    return alphabet[point % size] + alphabet[size - 1 - point / size]

int[] adjacent(int point, int size, bool diagonal = false)
    int[] result = []
    int[][] steps = if diagonal then [[-1, -1], [-1, 1], [1, -1], [1, 1]] else [[-1, 0], [1, 0], [0, -1], [0, 1]]
    for int[] delta = steps[]
        int r = point / size + delta[0]
        int c = point % size + delta[1]
        if 0 <= r < size and 0 <= c < size
            result = result.append(size * r + c)
    return result

int[] flood(string[] board, int size, int point, string allowed)
    bool[] seen = array(len(board), fill = false)
    int[] queue = [point]
    seen[point] = true
    nat cursor = 0
    while cursor < len(queue)
        int current = queue[cursor]
        cursor += 1
        for int neighbor = adjacent(current, size)[]
            if not seen[neighbor] and allowed.contains(board[neighbor])
                seen[neighbor] = true
                queue = queue.append(neighbor)
    return queue.sorted()

int[] unique(int[] items)
    int[] result = []
    for int item = items.sorted()[]
        if not has(result, item)
            result = result.append(item)
    return result

class Group(string color, int first, int[] stones, int[] liberties)

Group group(string[] board, int size, int point)
    int[] stones = flood(board, size, point, board[point])
    int[] liberties = []
    for int stone = stones[]
        for int neighbor = adjacent(stone, size)[]
            if board[neighbor] == "."
                liberties = liberties.append(neighbor)
    return Group(board[point], stones[0], stones, unique(liberties))

Group[] groups(string[] board, int size, string color = "")
    bool[] seen = array(len(board), fill = false)
    Group[] result = []
    for int point < int(len(board))
        if board[point] == "." or seen[point] or (color != "" and board[point] != color)
            continue
        Group current = group(board, size, point)
        result = result.append(current)
        for int stone = current.stones[]
            seen[stone] = true
    return result

class Attempt(string[] board, int captured, string reason)

Attempt placement(string[] board, int size, string color, int point)
    if board[point] != "."
        return Attempt(board, 0, "occupied")
    string[] result = board
    result[point] = color
    int captured = 0
    bool[] seen = array(len(board), fill = false)
    for int neighbor = adjacent(point, size)[]
        if result[neighbor] == other(color) and not seen[neighbor]
            Group enemy = group(result, size, neighbor)
            for int stone = enemy.stones[]
                seen[stone] = true
            if len(enemy.liberties) == 0
                for int stone = enemy.stones[]
                    result[stone] = "."
                    captured += 1
    string reason = if len(group(result, size, point).liberties) == 0 then "suicide" else ""
    return Attempt(result, captured, reason)

class Region(int first, int[] points, string owner)

Region[] regions(string[] board, int size)
    bool[] seen = array(len(board), fill = false)
    Region[] result = []
    for int point < int(len(board))
        if board[point] != "." or seen[point]
            continue
        int[] points = flood(board, size, point, ".")
        string[] border = []
        for int current = points[]
            seen[current] = true
            for int neighbor = adjacent(current, size)[]
                if board[neighbor] != "." and not includes(border, board[neighbor])
                    border = border.append(board[neighbor])
        result = result.append(Region(point, points, if len(border) == 1 then border[0] else "neutral"))
    return result

class Area(int[] touching, int[] vital)

Group[] safe(string[] board, int size, string color)
    Group[] own = groups(board, size, color)
    bool[] marked = array(len(board), fill = false)
    Area[] areas = []
    for int point < int(len(board))
        if board[point] == color or marked[point]
            continue
        int[] region = flood(board, size, point, "." + other(color))
        for int cell = region[]
            marked[cell] = true
        int[] touching = []
        int[] vital = []
        for nat i < len(own)
            Group g = own[i]
            bool touches = false
            bool all_liberties = true
            for int cell = region[]
                if board[cell] == "." and not has(g.liberties, cell)
                    all_liberties = false
                for int neighbor = adjacent(cell, size)[]
                    if has(g.stones, neighbor)
                        touches = true
            if touches
                touching = touching.append(int(i))
            if all_liberties
                vital = vital.append(int(i))
        areas = areas.append(Area(touching, vital))
    bool[] kept_groups = array(len(own), fill = true)
    bool[] kept_areas = array(len(areas), fill = true)
    while true
        bool changed = false
        for nat i < len(own)
            if not kept_groups[i]
                continue
            int count = 0
            for nat j < len(areas)
                if kept_areas[j] and has(areas[j].vital, int(i))
                    count += 1
            if count < 2
                kept_groups[i] = false
                changed = true
        for nat j < len(areas)
            if not kept_areas[j]
                continue
            for int i = areas[j].touching[]
                if not kept_groups[i]
                    kept_areas[j] = false
                    changed = true
                    break
        if not changed
            break
    Group[] result = []
    for nat i < len(own)
        if kept_groups[i]
            result = result.append(own[i])
    return result

class Reading(bool success, int point)

Reading defend(string[] board, int size, int point, int depth)
    if depth >= 40
        return Reading(true, -1)
    string defender = board[point]
    string attacker = other(defender)
    Group g = group(board, size, point)
    int[] choices = g.liberties
    bool[] seen = array(len(board), fill = false)
    for int stone = g.stones[]
        for int neighbor = adjacent(stone, size)[]
            if board[neighbor] == attacker and not seen[neighbor]
                Group enemy = group(board, size, neighbor)
                for int member = enemy.stones[]
                    seen[member] = true
                if len(enemy.liberties) == 1
                    choices = choices.append(enemy.liberties[0])
    for int q = unique(choices)[]
        Attempt candidate = placement(board, size, defender, q)
        if candidate.reason != ""
            continue
        int m = int(len(group(candidate.board, size, point).liberties))
        if m >= 3 or (m == 2 and not attack(candidate.board, size, point, depth + 1).success)
            return Reading(true, q)
    return Reading(false, -1)

Reading attack(string[] board, int size, int point, int depth)
    if depth >= 40
        return Reading(false, -1)
    string attacker = other(board[point])
    for int q = group(board, size, point).liberties[]
        Attempt candidate = placement(board, size, attacker, q)
        if candidate.reason == "" and not defend(candidate.board, size, point, depth + 1).success
            return Reading(true, q)
    return Reading(false, -1)

Reading ladder(string[] board, int size, int point)
    int liberties = int(len(group(board, size, point).liberties))
    if liberties >= 3
        return Reading(true, -1)
    if liberties == 1
        return defend(board, size, point, 0)
    Reading reading = attack(board, size, point, 0)
    return Reading(reading.success, reading.point)

string half(int number)
    int absolute = if number < 0 then -number else number
    return (if number < 0 then "-" else "") + "{absolute / 2}." + (if absolute % 2 == 0 then "0" else "5")

int | none parse_komi(string word)
    bool negative = word.starts_with("-")
    string digits = if negative then word[1:] else word
    string[] parts = digits.split(".")
    if len(parts) < 1 or len(parts) > 2
        return none
    string whole = parts[0]
    if whole == "" or (len(whole) > 1 and whole[0] == "0")
        return none
    for nat i < len(whole)
        if not "0123456789".contains(whole[i])
            return none
    if len(whole) > 3
        return none
    int amount = int.parse(whole)
    if amount > 100
        return none
    int fraction = 0
    if len(parts) == 2
        if parts[1] != "0" and parts[1] != "5"
            return none
        if parts[1] == "5"
            fraction = 1
    int result = 2 * amount + fraction
    if negative and result == 0
        return none
    return if negative then -result else result

int color_index(string color)
    return if color == "B" then 0 else 1

class Position(string[] board, string turn, int[] captures, int passes, bool over)
class Move(string color, int point, int captured, Position before)
class ReplayRecord(string color, int point)

ReplayRecord[] | none parse_record(string sequence, int size)
    ReplayRecord[] records = []
    nat at = 0
    while at < len(sequence)
        if at + 3 >= len(sequence) or sequence[at] != ";" or not includes(["B", "W"], sequence[at + 1]) or sequence[at + 2] != "["
            return none
        string color = sequence[at + 1]
        at += 3
        int point = -1
        if sequence[at] != "]"
            if at + 2 >= len(sequence)
                return none
            string alphabet = "abcdefghijklmnopqrs"
            string letter = sequence[at]
            string row_letter = sequence[at + 1]
            match alphabet.find(letter)
                nat column
                    match alphabet.find(row_letter)
                        nat row
                            if column >= nat(size) or row >= nat(size)
                                return none
                            point = (size - 1 - int(row)) * size + int(column)
                        none
                            return none
                none
                    return none
            at += 2
        if at >= len(sequence) or sequence[at] != "]"
            return none
        at += 1
        records = records.append(ReplayRecord(color, point))
    if len(records) == 0
        return none
    return records

class Game()
    int size = 19
    int komi = 13
    bool superko = false
    Position position = Position(array(361, fill = "."), "B", [0, 0], 0, false)
    int[] handicap = []
    Move[] history = []
    string[][] positions = [array(361, fill = ".")]
    bool[] dead = array(361, fill = false)

void reset(Game &game, int size, int komi)
    game.size = size
    game.komi = komi
    game.position = Position(array(nat(size * size), fill = "."), "B", [0, 0], 0, false)
    game.handicap = []
    game.history = []
    game.positions = [game.position.board]
    game.dead = array(nat(size * size), fill = false)

Attempt check(Game game, string color, int point)
    Attempt result = placement(game.position.board, game.size, color, point)
    string flat = result.board.join("")
    if result.reason == "" and len(game.positions) >= 2 and flat == game.positions[len(game.positions) - 2].join("")
        result.reason = "ko"
    if result.reason == "" and game.superko
        for string[] old = game.positions[]
            if flat == old.join("")
                result.reason = "superko"
                break
    return result

int move(Game &game, string color, int point, Attempt attempt = Attempt([], 0, ""))
    Position before = game.position
    int captured = 0
    if point < 0
        game.position.passes += 1
        if game.position.passes == 2
            game.position.over = true
    else
        Attempt result = if len(attempt.board) != 0 then attempt else check(game, color, point)
        game.position.board = result.board
        captured = result.captured
        game.position.captures[color_index(color)] += captured
        game.position.passes = 0
    game.position.turn = other(color)
    game.history = game.history.append(Move(color, point, captured, before))
    game.positions = game.positions.append(game.position.board)
    game.dead = array(nat(game.size * game.size), fill = false)
    return captured

string[] clean(Game game)
    string[] board = game.position.board
    for int p < int(len(board))
        if game.dead[p]
            board[p] = "."
    return board

void board_display(Game game, bool show_map)
    string[] board = if show_map then clean(game) else game.position.board
    string[] glyphs = board
    bool[] stars = array(nat(game.size * game.size), fill = false)
    string[] names = handicap_names(game.size)
    for nat i < len(names)
        if game.size == 19 or i < 4 or i == 8
            stars[point_number(names[i], game.size)] = true
    if show_map
        for Region region = regions(board, game.size)[]
            for int cell = region.points[]
                glyphs[cell] = if region.owner == "B" then "x" elif region.owner == "W" then "o" else "."
    for int p < int(len(board))
        if board[p] == "B"
            glyphs[p] = if not show_map and game.dead[p] then "x" else "X"
        elif board[p] == "W"
            glyphs[p] = if not show_map and game.dead[p] then "o" else "O"
        elif not show_map
            glyphs[p] = if stars[p] then "+" else "."
    string header = "   " + [for nat c < nat(game.size) then columns()[c]].join(" ")
    emit(header)
    for game.size >= int r >= 1 step -1
        string[] row = []
        for int c < game.size
            row = row.append(glyphs[(r - 1) * game.size + c])
        emit((if r < 10 then " " else "") + "{r} " + row.join(" ") + " {r}")
    emit(header)

void score(Game game, string method)
    string[] board = clean(game)
    int[] territory = [0, 0]
    for Region region = regions(board, game.size)[]
        if region.owner != "neutral"
            territory[color_index(region.owner)] += int(len(region.points))
    int[] totals = [0, 0]
    for string color = ["B", "W"][]
        int index = color_index(color)
        if method == "AREA"
            int stones = 0
            for string disc = board[]
                if disc == color
                    stones += 1
            totals[index] = 2 * (stones + territory[index]) + (if color == "W" then game.komi else 0)
            emit("{color} stones {stones} territory {territory[index]}" + (if color == "W" then " komi {half(game.komi)}" else "") + " total {half(totals[index])}")
        else
            int prisoners = game.position.captures[index]
            for int p < int(len(board))
                if game.dead[p] and game.position.board[p] == other(color)
                    prisoners += 1
            totals[index] = 2 * (territory[index] + prisoners) + (if color == "W" then game.komi else 0)
            emit("{color} territory {territory[index]} prisoners {prisoners}" + (if color == "W" then " komi {half(game.komi)}" else "") + " total {half(totals[index])}")
    int difference = totals[0] - totals[1]
    emit(if difference == 0 then "result Draw" elif difference > 0 then "result B+{half(difference)}" else "result W+{half(-difference)}")

bool valid_color(string word)
    return word == "B" or word == "W"

void execute(Game &game, string line)
    string[] words = line.split(" ")
    string command = words[0]
    string[] args = words[1:]
    string[] names = "BOARD KOMI SUPERKO HANDICAP PLAY PASS REPLAY UNDO SHOW MAP STATUS CAPTURES HISTORY MOVES GROUP GROUPS ATARI LEGAL EYES SAFE LADDER DEAD REGIONS SCORE".split(" ")
    if not includes(names, command)
        emit("ERROR unknown command")
        return
    bool needs_two = command == "BOARD" or command == "PLAY"
    bool needs_one = includes("KOMI SUPERKO HANDICAP PASS REPLAY GROUP LEGAL EYES SAFE LADDER DEAD SCORE".split(" "), command)
    nat expected = if needs_two then 2 elif needs_one then 1 else 0
    if len(args) != expected
        emit("ERROR bad arguments")
        return
    int new_size = game.size
    int parsed_komi = game.komi
    bool valid = true
    if command == "BOARD"
        valid = includes(["9", "13", "19"], args[0])
        if valid
            new_size = int.parse(args[0])
            match parse_komi(args[1])
                int amount
                    parsed_komi = amount
                none
                    valid = false
    elif command == "KOMI"
        match parse_komi(args[0])
            int amount
                parsed_komi = amount
            none
                valid = false
    elif command == "SUPERKO"
        valid = args[0] == "ON" or args[0] == "OFF"
    elif command == "HANDICAP"
        valid = len(args[0]) == 1 and "23456789".contains(args[0])
    elif includes(["PLAY", "PASS", "LEGAL", "EYES", "SAFE"], command)
        valid = valid_color(args[0])
    elif command == "SCORE"
        valid = args[0] == "AREA" or args[0] == "TERRITORY"
    if not valid
        emit("ERROR bad arguments")
        return
    int p = -1
    if includes(["PLAY", "GROUP", "LADDER", "DEAD"], command)
        p = point_number(if command == "PLAY" then args[1] else args[0], game.size)
        if p < 0
            emit("ERROR bad point")
            return
    ReplayRecord[] sequence = []
    if command == "REPLAY"
        match parse_record(args[0], game.size)
            ReplayRecord[] parsed
                sequence = parsed
            none
                emit("ERROR bad sequence")
                return
    if game.position.over and includes(["PLAY", "PASS", "REPLAY"], command)
        emit("ERROR game over")
        return
    if command == "BOARD"
        reset(&game, new_size, parsed_komi)
        emit("board {new_size} komi {half(parsed_komi)}")
    elif command == "KOMI"
        game.komi = parsed_komi
        emit("komi {half(parsed_komi)}")
    elif command == "SUPERKO"
        game.superko = args[0] == "ON"
        emit("superko " + (if game.superko then "on" else "off"))
    elif command == "HANDICAP"
        if len(game.history) != 0 or len([for string disc = game.position.board[] if disc != "." then disc]) > 0
            emit("ERROR handicap not allowed")
            return
        int count = int.parse(args[0])
        int[] indices = if count == 5 then [0, 1, 2, 3, 8] elif count == 7 then [0, 1, 2, 3, 4, 5, 8] else [for int i < count then i]
        string[] names = handicap_names(game.size)
        string result = "handicap {count}"
        for int i = indices[]
            int target = point_number(names[i], game.size)
            game.handicap = game.handicap.append(target)
            game.position.board[target] = "B"
            result += " " + names[i]
        game.position.turn = "W"
        game.positions = [game.position.board]
        game.dead = array(nat(game.size * game.size), fill = false)
        emit(result)
    elif command == "PLAY"
        string color = args[0]
        Attempt candidate = check(game, color, p)
        string why = if color != game.position.turn then "turn" else candidate.reason
        if why != ""
            emit("ILLEGAL {color} {args[1]} {why}")
        else
            int captured = move(&game, color, p, candidate)
            emit("{color} {args[1]}" + (if captured > 0 then " captures {captured}" else ""))
    elif command == "PASS"
        string color = args[0]
        if color != game.position.turn
            emit("ILLEGAL {color} pass turn")
        else
            move(&game, color, -1)
            emit("{color} pass")
            if game.position.over
                emit("game over")
    elif command == "REPLAY"
        int count = 0
        string stopped = ""
        for ReplayRecord entry = sequence[]
            string color = entry.color
            int square = entry.point
            Attempt candidate = if square >= 0 then check(game, color, square) else Attempt([], 0, "")
            string why = if game.position.over then "game over" elif color != game.position.turn then "turn" else candidate.reason
            if why != ""
                stopped = " stopped {color} " + (if square < 0 then "pass" else point_name(square, game.size)) + " {why}"
                break
            move(&game, color, square, candidate)
            count += 1
        emit("replay {count} moves" + stopped)
        if game.position.over
            emit("game over")
    elif command == "UNDO"
        if len(game.history) == 0
            emit("ERROR nothing to undo")
            return
        Move last = game.history[len(game.history) - 1]
        game.history = game.history[:<len(game.history) - 1]
        game.position = last.before
        game.positions = game.positions[:<len(game.positions) - 1]
        game.dead = array(nat(game.size * game.size), fill = false)
        emit("undo {last.color} " + (if last.point < 0 then "pass" else point_name(last.point, game.size)))
    elif command == "SHOW" or command == "MAP"
        board_display(game, command == "MAP")
    elif command == "STATUS"
        emit("size {game.size} komi {half(game.komi)} handicap {len(game.handicap)} superko " + (if game.superko then "on" else "off"))
        emit("moves {len(game.history)} " + (if game.position.over then "game over" else "next {game.position.turn} passes {game.position.passes}"))
    elif command == "CAPTURES"
        emit("captures B {game.position.captures[0]} W {game.position.captures[1]}")
    elif command == "HISTORY"
        emit("history {len(game.history)}")
        for nat i < len(game.history)
            Move item = game.history[i]
            emit("{i + 1} {item.color} " + (if item.point < 0 then "pass" else point_name(item.point, game.size)) + (if item.captured > 0 then " captures {item.captured}" else ""))
    elif command == "MOVES"
        string result = "(;GM[1]FF[4]SZ[{game.size}]KM[{half(game.komi)}]"
        if len(game.handicap) > 0
            result += "HA[{len(game.handicap)}]AB"
            for int point = game.handicap[]
                result += "[" + sgf(point, game.size) + "]"
        for Move item = game.history[]
            result += ";{item.color}[" + (if item.point < 0 then "" else sgf(item.point, game.size)) + "]"
        emit(result + ")")
    elif command == "GROUP" or command == "DEAD" or command == "LADDER"
        if game.position.board[p] == "."
            emit("ERROR no stone")
            return
        Group g = group(game.position.board, game.size, p)
        if command == "GROUP"
            emit("group {g.color} {point_name(g.first, game.size)} size {len(g.stones)} liberties {len(g.liberties)}")
            emit("stones" + [for int q = g.stones[] then " " + point_name(q, game.size)].join(""))
            emit("liberties" + [for int q = g.liberties[] then " " + point_name(q, game.size)].join(""))
        elif command == "DEAD"
            bool was_dead = game.dead[p]
            for int stone = g.stones[]
                game.dead[stone] = not was_dead
            emit((if was_dead then "alive" else "dead") + " {g.color} {point_name(g.first, game.size)} size {len(g.stones)}")
        else
            int liberties = int(len(g.liberties))
            string label = ""
            int chosen = -1
            if liberties >= 3
                label = "safe"
            elif liberties == 1
                Reading result = defend(game.position.board, game.size, p, 0)
                label = if result.success then "escapes" else "captured"
                chosen = if result.success then result.point else -1
            else
                Reading result = attack(game.position.board, game.size, p, 0)
                label = if result.success then "captured" else "escapes"
                chosen = if result.success then result.point else -1
            emit("ladder {args[0]} {label}" + (if chosen >= 0 then " {point_name(chosen, game.size)}" else ""))
    elif command == "GROUPS"
        Group[] all = groups(game.position.board, game.size)
        emit("groups {len(all)}")
        for Group g = all[]
            emit("{g.color} {point_name(g.first, game.size)} size {len(g.stones)} liberties {len(g.liberties)}" + (if game.dead[g.first] then " dead" else ""))
    elif command == "ATARI"
        Group[] all = groups(game.position.board, game.size)
        bool found = false
        for Group g = all[]
            if len(g.liberties) == 1
                found = true
                emit("atari {g.color} {point_name(g.first, game.size)} size {len(g.stones)} at {point_name(g.liberties[0], game.size)}")
        if not found
            emit("atari none")
    elif command == "LEGAL"
        string color = args[0]
        string[] rejected = []
        int legal_count = 0
        for int cell < int(len(game.position.board))
            if game.position.board[cell] != "."
                continue
            Attempt result = check(game, color, cell)
            if result.reason != ""
                rejected = rejected.append(point_name(cell, game.size) + " " + result.reason)
            else
                legal_count += 1
        emit("legal {color} {legal_count}")
        for string entry = rejected[]
            emit(entry)
    elif command == "EYES"
        string color = args[0]
        string[] result = []
        for int cell < int(len(game.position.board))
            if game.position.board[cell] != "."
                continue
            int[] neighbors = adjacent(cell, game.size)
            bool shape = true
            for int p = neighbors[]
                if game.position.board[p] != color
                    shape = false
                    break
            if not shape
                continue
            int opponents = 0
            for int p = adjacent(cell, game.size, true)[]
                if game.position.board[p] == other(color)
                    opponents += 1
            result = result.append(point_name(cell, game.size) + (if opponents <= (if len(neighbors) == 4 then 1 else 0) then " real" else " false"))
        emit("eyes {color} {len(result)}")
        for string line = result[]
            emit(line)
    elif command == "SAFE"
        Group[] all = safe(game.position.board, game.size, args[0])
        emit("safe {args[0]} {len(all)}")
        for Group g = all[]
            emit("{point_name(g.first, game.size)} size {len(g.stones)}")
    elif command == "REGIONS"
        Region[] all = regions(clean(game), game.size)
        emit("regions {len(all)}")
        for Region region = all[]
            emit("{point_name(region.first, game.size)} size {len(region.points)} {region.owner}")
    elif command == "SCORE"
        score(game, args[0])

string number_of_commands
scan(&number_of_commands)
Game game = Game()
for int i < int.parse(number_of_commands)
    string line
    scan(&line)
    execute(&game, line)
