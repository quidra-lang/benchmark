void emit(string text)
    print(text + NL)

bool includes_text(string[] items, string value)
    for string item = items[]
        if item == value
            return true
    return false

string[] unique_words(string[] items)
    string[] result = []
    for string item = items[]
        if not includes_text(result, item)
            result = result.append(item)
    return result

string[] words(string text)
    return [for string item = text.split(" ")[] if item != "" then item]

string trim_left(string text)
    nat at = 0
    while at < len(text) and text[at] == " "
        at += 1
    return text[at:]

string trim_right(string text)
    nat at = len(text)
    while at > 0 and text[at - 1] == " "
        at -= 1
    return text[:<at]

string trim_spaces(string text)
    return trim_right(trim_left(text))

bool numeric_text(string text)
    if text == ""
        return false
    for string ch = text[]
        if ch < "0" or ch > "9"
            return false
    return true

int find_char(string text, string ch)
    for string item = text[nat i]
        if item == ch
            return int(i)
    return -1

int last_char(string text, string ch)
    int result = -1
    for string item = text[nat i]
        if item == ch
            result = int(i)
    return result

int closing_index(string text, nat start)
    string opening = text[start]
    string closing = if opening == "(" then ")" else "}}"
    int depth = 0
    for start <= nat i < len(text)
        if text[i] == opening
            depth += 1
        elif text[i] == closing
            depth -= 1
            if depth == 0
                return int(i)
    return -1

int | error outside_index(string text, string wanted)
    int found = -1
    nat at = 0
    while at < len(text)
        if text[at] != "$"
            if text[at] == wanted and found < 0
                found = int(at)
            at += 1
        elif at + 1 < len(text) and (text[at + 1] == "(" or text[at + 1] == "{{")
            int closing = closing_index(text, at + 1)
            if closing < 0
                return error("unterminated variable reference")
            at = nat(closing) + 1
        else
            at += 2
    return found

string | none pattern_stem(string pattern, string word)
    int at = find_char(pattern, "%")
    if at < 0
        return if pattern == word then "" else none
    string prefix = pattern[:<nat(at)]
    string suffix = pattern[nat(at) + 1:]
    if len(word) < len(prefix) + len(suffix) or not word.starts_with(prefix) or not word.ends_with(suffix)
        return none
    return word[len(prefix):<len(word) - len(suffix)]

string substitute(string text, string stem)
    int at = find_char(text, "%")
    return if at < 0 then text else text[:<nat(at)] + stem + text[nat(at) + 1:]

string replace_word(string word, string pattern, string replacement)
    match pattern_stem(pattern, word)
        string stem
            return if pattern.contains("%") then substitute(replacement, stem) else replacement
        none
            return word

string[] split_arguments(string text, string opening, nat limit)
    string closing = if opening == "(" then ")" else "}}"
    int depth = 0
    nat start = 0
    string[] result = []
    for string ch = text[nat i]
        if ch == opening
            depth += 1
        elif ch == closing
            depth -= 1
        elif ch == "," and depth == 0 and (limit == 0 or len(result) < limit - 1)
            result = result.append(text[start:<i])
            start = i + 1
    return result.append(text[start:])

bool wildcard_match(string pattern, string name)
    bool[] previous = array(len(name) + 1, fill = false)
    previous[0] = true
    for string token = pattern[]
        bool[] next = array(len(name) + 1, fill = false)
        if token == "*"
            next[0] = previous[0]
        for string ch = name[nat i]
            next[i + 1] = if token == "*" then previous[i + 1] or (ch != "/" and next[i]) else previous[i] and (token == ch or (token == "?" and ch != "/"))
        previous = next
    return previous[len(name)]

string[] function_names()
    return ["subst", "patsubst", "strip", "findstring", "filter", "filter-out", "sort", "word", "wordlist", "words", "firstword", "lastword", "dir", "notdir", "suffix", "basename", "addsuffix", "addprefix", "wildcard", "foreach", "if", "call", "value", "info", "warning", "error"]

nat function_minimum(string name)
    if includes_text(["subst", "patsubst", "wordlist", "foreach"], name)
        return 3
    if includes_text(["findstring", "filter", "filter-out", "word", "addsuffix", "addprefix", "if"], name)
        return 2
    return 1

nat function_maximum(string name)
    return if name == "call" then 0 else (if name == "if" then 3 else function_minimum(name))

class Variable(bool recursive, string value)
class RecipeLine(nat number, string command)
class Rule(string[] prerequisites, int recipe_id = -1, string stem = "")
class PatternRule(string target, string[] prerequisites, int recipe_id = -1)
class RuleGroup(string[] targets, nat[] pattern_indices, int recipe_id = -1)
class Condition(bool outer, bool value, nat number, bool seen_else = false)
class Scope(bool call_scope, string name, string[] values)
class ResolvedRule(string[] prerequisites, int recipe_id, string stem, bool source = false)

class Simulator()
    map.Map<string, int> files
    int clock = 0
    bool loaded = false
    map.Map<string, Variable> variables
    map.Map<string, Rule> explicit_rules
    PatternRule[] pattern_rules = []
    RecipeLine[][] recipes = []
    string[] phony = []
    string goal = ""
    Scope[] scopes = []
    string[] expanding = []
    map.Map<string, string> automatic
    string location = "make"
    RuleGroup current_group = RuleGroup([], [])
    bool has_group = false
    string options = ""
    map.Map<string, string> results
    map.Map<string, ResolvedRule> resolved
    string[] building = []
    nat recipe_runs = 0
    bool aborted = false

    void .clear_makefile()
        loaded = false
        variables = map.Map<string, Variable>()
        explicit_rules = map.Map<string, Rule>()
        pattern_rules = []
        recipes = []
        phony = []
        goal = ""
        current_group = RuleGroup([], [])
        has_group = false

    int file_time(string name)
        match files.get(name)
            int value
                return value
            none
                return -1

    void .give_time(string name)
        clock += 1
        .files.set(name, clock)

    string[] wildcard_names(string pattern)
        if pattern.contains("*") or pattern.contains("?")
            return [for string name = files.keys().sorted()[] if wildcard_match(pattern, name) then name]
        return if files.has(pattern) then [pattern] else []

    string | error .expand(string text)
        string result = ""
        nat at = 0
        while at < len(text)
            string ch = text[at]
            if ch != "$"
                result += ch
                at += 1
            elif at + 1 == len(text)
                break
            elif text[at + 1] == "$"
                result += "$"
                at += 2
            elif text[at + 1] == "(" or text[at + 1] == "{{"
                int closing = closing_index(text, at + 1)
                if closing < 0
                    return error("unterminated variable reference")
                result += try .reference(text[at + 2:<nat(closing)], text[at + 1])
                at = nat(closing) + 1
            else
                result += try .reference_value(text[at + 1])
                at += 2
        return result

    string | error .reference(string content, string opening)
        int space = find_char(content, " ")
        if space >= 0 and includes_text(function_names(), content[:<nat(space)])
            return .call_function(content[:<nat(space)], trim_left(content[nat(space) + 1:]), opening)
        string name = try .expand(content)
        int colon = find_char(name, ":")
        if colon >= 0
            string tail = name[nat(colon) + 1:]
            int equals = find_char(tail, "=")
            if equals >= 0
                string pattern = tail[:<nat(equals)]
                string replacement = tail[nat(equals) + 1:]
                if not pattern.contains("%")
                    pattern = "%" + pattern
                    replacement = "%" + replacement
                string value = try .reference_value(name[:<nat(colon)])
                return [for string word = words(value)[] then replace_word(word, pattern, replacement)].join(" ")
        return .reference_value(name)

    string | error .reference_value(string name)
        for Scope scope = scopes[::-1][]
            if not scope.call_scope
                if scope.name == name
                    return scope.values[0]
            elif numeric_text(name)
                nat index = nat.parse(name)
                return if index < len(scope.values) then scope.values[index] else ""
        match automatic.get(name)
            string value
                return value
            none
                return .variable_value(name)

    string | error .variable_value(string name)
        match variables.get(name)
            Variable variable
                if not variable.recursive
                    return variable.value
                if includes_text(expanding, name)
                    return error("Recursive variable '{name}' references itself (eventually)")
                expanding = expanding.append(name)
                string | error result = .expand(variable.value)
                expanding = expanding[:<len(expanding) - 1]
                return result
            none
                return ""

    string | error .call_function(string name, string argument, string opening)
        string[] args = split_arguments(argument, opening, function_maximum(name))
        if len(args) < function_minimum(name)
            return error("insufficient number of arguments ({len(args)}) to function '{name}'")
        if name == "foreach"
            string variable = trim_spaces(try .expand(args[0]))
            string list = try .expand(args[1])
            string[] parts = []
            for string word = words(list)[]
                scopes = scopes.append(Scope(false, variable, [word]))
                string | error value = .expand(args[2])
                scopes = scopes[:<len(scopes) - 1]
                parts = parts.append(try value)
            return parts.join(" ")
        if name == "if"
            string condition = trim_spaces(try .expand(args[0]))
            if condition != ""
                return .expand(args[1])
            return if len(args) == 3 then .expand(args[2]) else ""
        string[] values = []
        for string arg = args[]
            string value = try .expand(arg)
            values = values.append(if name == "subst" or name == "call" then value else trim_spaces(value))
        if name == "subst"
            if values[0] == ""
                return values[2]
            return values[2].split(values[0]).join(values[1])
        if name == "patsubst"
            return [for string word = words(values[2])[] then replace_word(word, values[0], values[1])].join(" ")
        if name == "strip"
            return words(values[0]).join(" ")
        if name == "findstring"
            return if values[1].contains(values[0]) then values[0] else ""
        if name == "filter" or name == "filter-out"
            string[] matches = []
            for string word = words(values[1])[]
                bool matched = false
                for string pattern = words(values[0])[]
                    match pattern_stem(pattern, word)
                        string stem
                            matched = true
                        none
                            void
                if matched == (name == "filter")
                    matches = matches.append(word)
            return matches.join(" ")
        if name == "sort"
            return unique_words(words(values[0])).sorted().join(" ")
        if name == "word"
            if not numeric_text(values[0])
                return error("non-numeric first argument to 'word' function: '{values[0]}'")
            nat index = nat.parse(values[0])
            if index == 0
                return error("first argument to 'word' function must be greater than 0")
            string[] items = words(values[1])
            return if index <= len(items) then items[index - 1] else ""
        if name == "wordlist"
            if not numeric_text(values[0])
                return error("non-numeric first argument to 'wordlist' function: '{values[0]}'")
            if not numeric_text(values[1])
                return error("non-numeric second argument to 'wordlist' function: '{values[1]}'")
            nat first = nat.parse(values[0])
            nat last = nat.parse(values[1])
            if first == 0
                return error("invalid first argument to 'wordlist' function: '{values[0]}'")
            string[] items = words(values[2])
            nat finish = if last < len(items) then last else len(items)
            return if first > finish then "" else items[first - 1:<finish].join(" ")
        if name == "words"
            return len(words(values[0])).string()
        if name == "firstword" or name == "lastword"
            string[] items = words(values[0])
            if len(items) == 0
                return ""
            return if name == "firstword" then items[0] else items[len(items) - 1]
        if includes_text(["dir", "notdir", "suffix", "basename"], name)
            string[] parts = []
            for string word = words(values[0])[]
                int slash = last_char(word, "/")
                int dot = last_char(word, ".")
                if name == "dir"
                    parts = parts.append(if slash < 0 then "./" else word[:<nat(slash + 1)])
                elif name == "notdir"
                    parts = parts.append(word[nat(slash + 1):])
                elif name == "suffix"
                    if dot > slash
                        parts = parts.append(word[nat(dot):])
                else
                    parts = parts.append(if dot > slash then word[:<nat(dot)] else word)
            return parts.join(" ")
        if name == "addsuffix"
            return [for string word = words(values[1])[] then word + values[0]].join(" ")
        if name == "addprefix"
            return [for string word = words(values[1])[] then values[0] + word].join(" ")
        if name == "wildcard"
            string[] found = []
            for string pattern = words(values[0])[]
                found = found.concat(wildcard_names(pattern))
            return found.join(" ")
        if name == "call"
            string variable = trim_spaces(values[0])
            match variables.get(variable)
                Variable entry
                    if not entry.recursive
                        return entry.value
                    scopes = scopes.append(Scope(true, "", [variable].concat(values[1:])))
                    string | error result = .expand(entry.value)
                    scopes = scopes[:<len(scopes) - 1]
                    return result
                none
                    return ""
        if name == "value"
            match variables.get(values[0])
                Variable entry
                    return entry.value
                none
                    return ""
        if name == "info"
            emit(values[0])
        elif name == "warning"
            emit("{location}: {values[0]}")
        elif name == "error"
            return error(values[0])
        return ""

    bool conditions_active(Condition[] conditions)
        return len(conditions) == 0 or (conditions[len(conditions) - 1].outer and conditions[len(conditions) - 1].value)

    bool | error .evaluate_condition(string keyword, string rest)
        if keyword == "ifdef" or keyword == "ifndef"
            string name = trim_spaces(try .expand(rest))
            bool defined = false
            match variables.get(name)
                Variable entry
                    defined = entry.value != ""
                none
                    void
            return defined == (keyword == "ifdef")
        if len(rest) < 2 or not rest.starts_with("(") or not rest.ends_with(")")
            return error("invalid syntax in conditional")
        string inner = rest[1:<len(rest) - 1]
        int depth = 0
        for string ch = inner[nat i]
            if ch == "("
                depth += 1
            elif ch == ")"
                depth -= 1
            elif ch == "," and depth == 0
                string first = trim_spaces(try .expand(inner[:<i]))
                string second = trim_spaces(try .expand(inner[i + 1:]))
                return (first == second) == (keyword == "ifeq")
        return error("invalid syntax in conditional")

    void | error .assign_variable(string text, nat equals)
        string op = ""
        if equals > 0 and includes_text([":", "+", "?"], text[equals - 1])
            op = text[equals - 1]
        string name = trim_spaces(text[:<equals - len(op)])
        string value = trim_spaces(text[equals + 1:])
        if name == ""
            return error("empty variable name")
        if op == ":"
            string expanded = try .expand(value)
            .variables.set(name, Variable(false, expanded))
        elif op == "+" and variables.has(name)
            match variables.get(name)
                Variable entry
                    string addition = if entry.recursive then value else try .expand(value)
                    entry.value = if entry.value == "" then addition else entry.value + " " + addition
                    .variables.set(name, entry)
                none
                    void
        elif op != "?" or not variables.has(name)
            .variables.set(name, Variable(true, value))

    Rule rule_entry(string target)
        match explicit_rules.get(target)
            Rule entry
                return entry
            none
                return Rule([])

    void .register_target(string target, string[] prerequisites)
        Rule entry = rule_entry(target)
        entry.prerequisites = unique_words(entry.prerequisites.concat(prerequisites))
        .explicit_rules.set(target, entry)
        if goal == "" and not target.starts_with(".")
            goal = target

    void .add_recipe(RuleGroup &group, RecipeLine recipe_line)
        if group.recipe_id < 0
            group.recipe_id = int(len(recipes))
            recipes = recipes.append([])
            for string target = group.targets[]
                Rule entry = rule_entry(target)
                if entry.recipe_id >= 0
                    emit("Makefile:{recipe_line.number}: warning: overriding recipe for target '{target}'")
                    emit("Makefile:{recipes[nat(entry.recipe_id)][0].number}: warning: ignoring old recipe for target '{target}'")
                entry.recipe_id = group.recipe_id
                .explicit_rules.set(target, entry)
            for nat index = group.pattern_indices[]
                pattern_rules[index].recipe_id = group.recipe_id
        recipes[nat(group.recipe_id)] = recipes[nat(group.recipe_id)].append(recipe_line)

    RuleGroup | error .define_rule(string target_text, string rest, nat number)
        string[] targets = unique_words(words(try .expand(target_text)))
        bool has_inline = false
        string inline_recipe = ""
        int semicolon = try outside_index(rest, ";")
        if semicolon >= 0
            has_inline = true
            inline_recipe = trim_left(rest[nat(semicolon) + 1:])
            rest = rest[:<nat(semicolon)]
        int colon = try outside_index(rest, ":")
        bool is_static = colon >= 0
        string pattern = ""
        if is_static
            pattern = trim_spaces(try .expand(rest[:<nat(colon)]))
            rest = rest[nat(colon) + 1:]
        string[] prerequisites = words(try .expand(rest))
        RuleGroup group = RuleGroup([], [])
        if targets == [".PHONY"]
            phony = unique_words(phony.concat(prerequisites))
        elif is_static
            if not pattern.contains("%")
                return error("target pattern contains no '%'")
            for string target = targets[]
                string stem = ""
                match pattern_stem(pattern, target)
                    string value
                        stem = value
                    none
                        void
                if stem == ""
                    emit("Makefile:{number}: target '{target}' doesn't match the target pattern")
                else
                    .register_target(target, [for string item = prerequisites[] then substitute(item, stem)])
                    Rule entry = rule_entry(target)
                    entry.stem = stem
                    .explicit_rules.set(target, entry)
                    group.targets = group.targets.append(target)
        else
            bool patterned = false
            bool normal = false
            for string target = targets[]
                if target.contains("%")
                    patterned = true
                else
                    normal = true
            if patterned and normal
                return error("mixed implicit and normal rules")
            if patterned
                for string target = targets[]
                    group.pattern_indices = group.pattern_indices.append(len(pattern_rules))
                    pattern_rules = pattern_rules.append(PatternRule(target, prerequisites))
            else
                for string target = targets[]
                    .register_target(target, prerequisites)
                group.targets = targets
        if has_inline
            .add_recipe(&group, RecipeLine(number, inline_recipe))
        return group

    void | error .load_body(string[] lines)
        Condition[] conditions = []
        nat at = 0
        while at < len(lines)
            nat number = at + 1
            string line = lines[at]
            at += 1
            location = "Makefile:{number}"
            if line.starts_with(">")
                if conditions_active(conditions)
                    if not has_group
                        return error("recipe commences before first target")
                    .add_recipe(&current_group, RecipeLine(number, trim_left(line[1:])))
                continue
            while line.ends_with(BS) and at < len(lines)
                line = trim_right(line[:<len(line) - 1]) + " " + trim_left(lines[at])
                at += 1
            int hash = find_char(line, "#")
            string text = trim_spaces(if hash < 0 then line else line[:<nat(hash)])
            int space = find_char(text, " ")
            string keyword = if space < 0 then text else text[:<nat(space)]
            string rest = if space < 0 then "" else trim_spaces(text[nat(space) + 1:])
            if includes_text(["ifeq", "ifneq", "ifdef", "ifndef", "else", "endif"], keyword)
                if keyword == "else"
                    if len(conditions) == 0
                        return error("extraneous 'else'")
                    nat index = len(conditions) - 1
                    if conditions[index].seen_else
                        return error("only one 'else' per conditional")
                    conditions[index].value = not conditions[index].value
                    conditions[index].seen_else = true
                elif keyword == "endif"
                    if len(conditions) == 0
                        return error("extraneous 'endif'")
                    conditions = conditions[:<len(conditions) - 1]
                else
                    bool outer = conditions_active(conditions)
                    bool value = false
                    if outer
                        value = try .evaluate_condition(keyword, rest)
                    conditions = conditions.append(Condition(outer, value, number))
            elif text != "" and conditions_active(conditions)
                int equals = try outside_index(text, "=")
                int colon = try outside_index(text, ":")
                if equals >= 0 and (colon < 0 or colon >= equals - 1)
                    try .assign_variable(text, nat(equals))
                    has_group = false
                elif colon >= 0
                    current_group = try .define_rule(text[:<nat(colon)], text[nat(colon) + 1:], number)
                    has_group = true
                else
                    string value = trim_spaces(try .expand(text))
                    if value != ""
                        return error("missing separator")
        if len(conditions) > 0
            location = "Makefile:{conditions[len(conditions) - 1].number}"
            return error("missing 'endif'")

    void .load_makefile(string[] lines)
        .clear_makefile()
        match .load_body(lines)
            void
                loaded = true
                nat patterns = len([for PatternRule entry = pattern_rules[] if entry.recipe_id >= 0 then entry])
                string default_goal = if goal == "" then "(none)" else goal
                emit("Makefile loaded: lines={len(lines)} variables={variables.size()} targets={explicit_rules.size()} patterns={patterns} goal={default_goal}")
            error issue
                emit("{location}: *** {issue.message}.  Stop.")
                .clear_makefile()
        location = "make"

    ResolvedRule | none resolve_rule(string target)
        Rule entry = rule_entry(target)
        if explicit_rules.has(target) and entry.recipe_id >= 0
            return ResolvedRule(entry.prerequisites, entry.recipe_id, entry.stem)
        if not includes_text(phony, target)
            nat[] candidates = []
            string[] stems = []
            for PatternRule pattern = pattern_rules[nat i]
                if pattern.recipe_id < 0
                    continue
                match pattern_stem(pattern.target, target)
                    string stem
                        if stem != ""
                            nat index = 0
                            while index < len(candidates) and len(stems[index]) <= len(stem)
                                index += 1
                            candidates = candidates[:<index].append(i).concat(candidates[index:])
                            stems = stems[:<index].append(stem).concat(stems[index:])
                    none
                        void
            for nat index = candidates[nat i]
                PatternRule pattern = pattern_rules[index]
                string[] prerequisites = [for string item = pattern.prerequisites[] then substitute(item, stems[i])]
                bool usable = true
                for string item = prerequisites[]
                    if not files.has(item) and not explicit_rules.has(item)
                        usable = false
                if usable
                    return ResolvedRule(unique_words(prerequisites.concat(if explicit_rules.has(target) then entry.prerequisites else [])), pattern.recipe_id, stems[i])
        if explicit_rules.has(target) or includes_text(phony, target)
            return ResolvedRule(entry.prerequisites, -1, entry.stem)
        if files.has(target)
            return ResolvedRule([], -1, "", true)
        return none

    int target_time(string name)
        return if includes_text(phony, name) then -1 else file_time(name)

    int .execute_recipe(string command)
        string[] parts = words(command)
        string name = parts[0]
        string[] args = parts[1:]
        if name == "echo"
            emit(args.join(" "))
        elif name == "touch"
            for string arg = args[]
                .give_time(arg)
        elif name == "false"
            return 1
        elif name == "exit"
            return if len(args) == 0 then 0 else int.parse(args[0])
        elif name == "rm"
            bool forced = len(args) > 0 and args[0] == "-f"
            if forced
                args = args[1:]
            int status = 0
            for string arg = args[]
                string[] matches = wildcard_names(arg)
                if len(matches) == 0
                    matches = [arg]
                for string item = matches[]
                    if files.has(item)
                        bool removed = .files.remove(item)
                    elif not forced
                        emit("rm: cannot remove '{item}': No such file or directory")
                        status = 1
            return status
        return 0

    bool .run_recipe(string target, ResolvedRule rule, string[] prerequisites, string[] changed)
        .automatic.set("@", target)
        .automatic.set("<", if len(prerequisites) == 0 then "" else prerequisites[0])
        .automatic.set("^", prerequisites.join(" "))
        .automatic.set("?", changed.join(" "))
        .automatic.set("*", rule.stem)
        string[] expanded = []
        RecipeLine[] recipe = recipes[nat(rule.recipe_id)]
        bool failed = false
        for RecipeLine recipe_line = recipe[]
            location = "Makefile:{recipe_line.number}"
            match .expand(recipe_line.command)
                string value
                    expanded = expanded.append(value)
                error issue
                    emit("{location}: *** {issue.message}.  Stop.")
                    failed = true
                    break
        automatic = map.Map<string, string>()
        location = "make"
        if failed
            aborted = true
            return false
        for string text = expanded[nat i]
            nat start = 0
            while start < len(text) and includes_text([" ", "@", "-"], text[start])
                start += 1
            string prefix = text[:<start]
            string command = trim_right(text[start:])
            if command == ""
                continue
            if options.contains("n") or (not prefix.contains("@") and not options.contains("s"))
                emit(command)
            if options.contains("n")
                continue
            int status = .execute_recipe(command)
            if status == 0
                continue
            if prefix.contains("-") or options.contains("i")
                emit("make: [Makefile:{recipe[i].number}: {target}] Error {status} (ignored)")
            else
                emit("make: *** [Makefile:{recipe[i].number}: {target}] Error {status}")
                if not options.contains("k")
                    aborted = true
                return false
        return true

    string .build_target(string target, string parent = "")
        match results.get(target)
            string result
                return result
            none
                void
        ResolvedRule rule = ResolvedRule([], -1, "")
        match resolve_rule(target)
            ResolvedRule entry
                rule = entry
            none
                .results.set(target, "failure")
                string message = "make: *** No rule to make target '{target}'" + (if parent == "" then "." else ", needed by '{parent}'.")
                if not options.contains("k")
                    message += "  Stop."
                    aborted = true
                emit(message)
                return "failure"
        .resolved.set(target, rule)
        if rule.source
            .results.set(target, "success")
            return "success"
        building = building.append(target)
        string[] prerequisites = []
        bool failed = false
        for string dep = rule.prerequisites[]
            if includes_text(building, dep)
                emit("make: Circular {target} <- {dep} dependency dropped.")
                continue
            prerequisites = prerequisites.append(dep)
            string result = .build_target(dep, target)
            if aborted
                return "failure"
            if result != "success"
                failed = true
        building = [for string item = building[] if item != target then item]
        string result = "success"
        if failed
            result = "dependency"
        else
            int timestamp = target_time(target)
            string[] changed = [for string dep = prerequisites[] if options.contains("B") or timestamp < 0 or target_time(dep) < 0 or target_time(dep) > timestamp then dep]
            if rule.recipe_id >= 0 and (options.contains("B") or timestamp < 0 or len(changed) > 0)
                recipe_runs += 1
                if .run_recipe(target, rule, prerequisites, changed)
                    if not includes_text(phony, target)
                        .give_time(target)
                else
                    result = "failure"
        .results.set(target, result)
        return result

    void .run_make(string[] arguments)
        options = ""
        string[] goals = []
        for string arg = arguments[]
            if not arg.starts_with("-")
                goals = goals.append(arg)
            else
                for string option = arg[1:][]
                    if not "nBkis".contains(option)
                        emit("make: invalid option -- '{option}'")
                        return
                    options += option
        if len(goals) == 0
            if not loaded
                emit("make: *** No targets specified and no makefile found.  Stop.")
                return
            if goal == ""
                emit("make: *** No targets.  Stop.")
                return
            goals = [goal]
        map.Map<string, int> saved_files = files
        int saved_clock = clock
        results = map.Map<string, string>()
        resolved = map.Map<string, ResolvedRule>()
        building = []
        recipe_runs = 0
        aborted = false
        for string target = goals[]
            nat before = recipe_runs
            string result = .build_target(target)
            if aborted
                break
            if result == "success" and recipe_runs == before
                bool no_recipe = true
                match resolved.get(target)
                    ResolvedRule rule
                        no_recipe = rule.recipe_id < 0
                    none
                        void
                if includes_text(phony, target) or no_recipe
                    emit("make: Nothing to be done for '{target}'.")
                else
                    emit("make: '{target}' is up to date.")
            elif result == "dependency"
                emit("make: Target '{target}' not remade because of errors.")
        if options.contains("n")
            files = saved_files
            clock = saved_clock

    void print_rule(string target, string[] prerequisites, int recipe_id)
        emit([target + ":"].concat(prerequisites).join(" "))
        if recipe_id >= 0
            for RecipeLine recipe_line = recipes[nat(recipe_id)][]
                emit(">" + recipe_line.command)

    void .execute(string line)
        string[] parts = line.split(" ")
        string command = parts[0]
        string[] args = parts[1:]
        if command == "MAKE"
            .run_make(args)
        elif command == "TOUCH"
            for string name = args[]
                .give_time(name)
        elif command == "RM"
            for string name = args[]
                if files.has(name)
                    bool removed = .files.remove(name)
                else
                    emit("rm: cannot remove '{name}': No such file or directory")
        elif command == "FILES"
            emit("clock {clock}")
            for string name = files.keys().sorted()[]
                emit("{name} {file_time(name)}")
        elif command == "VARS"
            for string name = variables.keys().sorted()[]
                string symbol = "="
                match variables.get(name)
                    Variable entry
                        symbol = if entry.recursive then "=" else ":="
                    none
                        void
                match .variable_value(name)
                    string value
                        string trimmed = trim_spaces(value)
                        emit("{name} {symbol}" + (if trimmed == "" then "" else " " + trimmed))
                    error issue
                        emit("make: *** {issue.message}.  Stop.")
                        return
        elif command == "RULES"
            for string target = explicit_rules.keys().sorted()[]
                Rule entry = rule_entry(target)
                print_rule(target, entry.prerequisites, entry.recipe_id)
            for PatternRule entry = pattern_rules[]
                if entry.recipe_id >= 0
                    print_rule(entry.target, entry.prerequisites, entry.recipe_id)
            if len(phony) > 0
                emit([".PHONY:"].concat(phony.sorted()).join(" "))
        elif command == "EXPAND"
            match .expand(args.join(" "))
                string value
                    emit("[{value}]")
                error issue
                    emit("make: *** {issue.message}.  Stop.")

auto simulator = Simulator()
string first_line
scan(&first_line)
while true
    string line
    scan(&line)
    if line == "END FILES"
        break
    string[] parts = line.split(" ")
    int timestamp = int.parse(parts[1])
    .simulator.files.set(parts[0], timestamp)
    if timestamp > simulator.clock
        simulator.clock = timestamp
while true
    string line
    scan(&line)
    if line == "QUIT"
        break
    emit("$ {line}")
    if line == "MAKEFILE"
        string[] body = []
        while true
            string body_line
            scan(&body_line)
            if body_line == "END MAKEFILE"
                break
            body = body.append(body_line)
        .simulator.load_makefile(body)
    else
        .simulator.execute(line)
