class Item(int number, int size)
class Bin(Item[] items, int load, int category)
class Step(Item item, int bin, int inspected, bool opened, int closed, int category)
class Packing(string method, int parameter, Bin[] bins, Step[] steps, int inspections, int closes)
class BoundRow(int alpha, int j1, int j2, int j3, int bound)
class Bounds(int l1, int l2, BoundRow[] rows)
class Move(Item item, int destination)
class Comparison(string method, int bins, int waste, int inspections)
class Search(Item[] order, int capacity, int limit, int lower, int[] remaining, Bin[] live, Bin[] best, int nodes, int status)
class Piece(int length, int demand)
class Pattern(int[] counts, int trim)
class Rect(int number, int width, int height)
class Placement(Rect rect, int x, int y, int width, int height, bool rotated)
class Shelf(int bottom, int height, int used, Placement[] placed)
class FreeRect(int x, int y, int width, int height)
class Sheet(FreeRect[] free, Placement[] placed, int area)
class Lab()
    Item[] items = []
    int capacity = 0
    bool ready = false

void emit(string text)
    print(text + NL)

void fail(string text)
    emit("ERROR " + text)

int integer(string text)
    return int.parse(text)

int minimum(int a, int b)
    return if a < b then a else b

int maximum(int a, int b)
    return if a > b then a else b

int ceiling(int a, int b)
    return (a + b - 1) / b

string text(Item item)
    return item.number.string() + ":" + item.size.string()

string method_name(string name, int k)
    return name + (if name == "HARMONIC" or name == "KBOUNDED" then " k=" + k.string() else "")

bool parameterized(string name)
    return name == "HARMONIC" or name == "KBOUNDED"

Bin new_bin(int category = 0)
    return Bin([], 0, category)

Bin copy_bin(Bin value)
    return Bin(value.items, value.load, value.category)

int[] descending(Item[] items)
    int[] result = []
    for 0 <= int i < int(len(items))
        int position = int(len(result))
        result = result.append(i)
        while position > 0
            Item a = items[i]
            Item b = items[result[position - 1]]
            if a.size < b.size or (a.size == b.size and a.number > b.number)
                break
            result[position] = result[position - 1]
            position -= 1
        result[position] = i
    return result

void put(Bin &bin, Item item)
    bin.items = bin.items.append(item)
    bin.load += item.size

Packing pack(Item[] items, int capacity, string method, int parameter = 0)
    Packing result = Packing(method, parameter, [], [], 0, 0)
    int[] order = []
    if method == "FFD" or method == "BFD" or method == "WFD"
        order = descending(items)
    else
        for 0 <= int i < int(len(items))
            order = order.append(i)
    int[] active = []
    int[] current = array(51, fill = -1)
    for int index = order[]
        Item item = items[index]
        int before = result.inspections
        int chosen = -1
        int closed = -1
        int category = 0
        if method == "NEXTFIT"
            if len(result.bins) > 0
                result.inspections += 1
                int last = int(len(result.bins)) - 1
                if result.bins[last].load + item.size <= capacity
                    chosen = last
        elif method == "FIRSTFIT" or method == "FFD" or method == "KBOUNDED"
            int[] candidates = []
            if method == "KBOUNDED"
                candidates = active
            else
                for 0 <= int i < int(len(result.bins))
                    candidates = candidates.append(i)
            for int i = candidates[]
                result.inspections += 1
                if result.bins[i].load + item.size <= capacity
                    chosen = i
                    break
        elif method == "HARMONIC"
            category = minimum(capacity / item.size, parameter)
            if current[category] >= 0
                int i = current[category]
                result.inspections += 1
                if result.bins[i].load + item.size <= capacity
                    chosen = i
        else
            result.inspections += int(len(result.bins))
            int[] fitting = []
            for 0 <= int i < int(len(result.bins))
                if result.bins[i].load + item.size <= capacity
                    fitting = fitting.append(i)
            if len(fitting) > 0
                if method == "BESTFIT" or method == "BFD"
                    chosen = fitting[0]
                    for int i = fitting[]
                        if result.bins[i].load > result.bins[chosen].load
                            chosen = i
                else
                    for 1 <= int i < int(len(fitting))
                        int value = fitting[i]
                        int position = i
                        while position > 0 and (result.bins[fitting[position - 1]].load > result.bins[value].load or (result.bins[fitting[position - 1]].load == result.bins[value].load and fitting[position - 1] > value))
                            fitting[position] = fitting[position - 1]
                            position -= 1
                        fitting[position] = value
                    chosen = if method == "ALMOSTWORST" and len(fitting) >= 2 then fitting[1] else fitting[0]
        bool opened = chosen < 0
        if opened
            if method == "KBOUNDED" and len(active) == parameter
                closed = active[0]
                for int i = active[]
                    if result.bins[i].load > result.bins[closed].load
                        closed = i
                int[] next_active = []
                for int i = active[]
                    if i != closed
                        next_active = next_active.append(i)
                active = next_active
                result.closes += 1
            chosen = int(len(result.bins))
            result.bins = result.bins.append(new_bin(category))
            if method == "KBOUNDED"
                active = active.append(chosen)
            if method == "HARMONIC"
                current[category] = chosen
        put(&result.bins[chosen], item)
        result.steps = result.steps.append(Step(item, chosen, result.inspections - before, opened, closed, category))
    return result

string header(Packing result, int capacity, int total)
    string line = method_name(result.method, result.parameter) + " bins=" + len(result.bins).string() + " inspections=" + result.inspections.string() + " waste=" + (int(len(result.bins)) * capacity - total).string()
    if result.method == "KBOUNDED"
        line += " closes=" + result.closes.string()
    return line

void bin_line(int number, Bin bin, int capacity, bool classes = false, bool over = false)
    string line = "BIN " + number.string() + " load=" + bin.load.string() + "/" + capacity.string() + " items=" + [for Item item = bin.items[] then text(item)].join(" ")
    if classes
        line += " class=" + bin.category.string()
    if over
        line += " OVER"
    emit(line)

void bin_lines(Bin[] bins, int capacity, bool classes = false)
    for 0 <= int i < int(len(bins))
        bin_line(i + 1, bins[i], capacity, classes)

Bounds bounds(Item[] items, int capacity)
    int[] thresholds = [0]
    for Item item = items[]
        if 2 * item.size <= capacity
            bool found = false
            for int alpha = thresholds[]
                if alpha == item.size
                    found = true
            if not found
                thresholds = thresholds.append(item.size)
    for 1 <= int i < int(len(thresholds))
        int value = thresholds[i]
        int position = i
        while position > 0 and thresholds[position - 1] > value
            thresholds[position] = thresholds[position - 1]
            position -= 1
        thresholds[position] = value
    BoundRow[] rows = []
    int l2 = 0
    for int alpha = thresholds[]
        int j1 = 0
        int j2 = 0
        int j3 = 0
        int sum2 = 0
        int sum3 = 0
        for Item item = items[]
            int size = item.size
            if size > capacity - alpha
                j1 += 1
            elif 2 * size > capacity
                j2 += 1
                sum2 += size
            elif size >= alpha
                j3 += 1
                sum3 += size
        int excess = sum3 - (j2 * capacity - sum2)
        int bound = j1 + j2 + (if excess > 0 then ceiling(excess, capacity) else 0)
        l2 = maximum(l2, bound)
        rows = rows.append(BoundRow(alpha, j1, j2, j3, bound))
    return Bounds(ceiling([for Item item = items[] then item.size].sum(), capacity), l2, rows)

void command_items(Lab &lab, string[] words)
    int capacity = integer(words[1])
    if capacity == 0
        fail("BAD CAPACITY")
        return
    Item[] items = []
    for 2 <= int i < int(len(words))
        int size = integer(words[i])
        if size == 0 or size > capacity
            fail("BAD ITEM " + (i - 1).string())
            return
        items = items.append(Item(i - 1, size))
    lab.items = items
    lab.capacity = capacity
    lab.ready = true
    emit("ITEMS count=" + len(items).string() + " capacity=" + capacity.string() + " total=" + [for Item item = items[] then item.size].sum().string())

void command_random(Lab &lab, string[] words)
    int count = integer(words[1])
    int capacity = integer(words[2])
    int seed = integer(words[3])
    if count == 0 or count > 40
        fail("BAD COUNT")
        return
    if capacity == 0
        fail("BAD CAPACITY")
        return
    if seed == 0 or seed >= 2147483647
        fail("BAD SEED")
        return
    Item[] items = []
    int[] sizes = []
    for 1 <= int i <= count
        seed = 48271 * seed % 2147483647
        int size = seed % capacity + 1
        items = items.append(Item(i, size))
        sizes = sizes.append(size)
    lab.items = items
    lab.capacity = capacity
    lab.ready = true
    emit("RANDOM count=" + count.string() + " capacity=" + capacity.string() + " total=" + sizes.sum().string())
    emit("SIZES " + [for int size = sizes[] then size.string()].join(" "))

void command_method(Lab lab, string method, int k)
    Packing result = pack(lab.items, lab.capacity, method, k)
    emit(header(result, lab.capacity, [for Item item = lab.items[] then item.size].sum()))
    bin_lines(result.bins, lab.capacity, method == "HARMONIC")

void command_trace(Lab lab, string method, int k)
    Packing result = pack(lab.items, lab.capacity, method, k)
    emit("TRACE " + header(result, lab.capacity, [for Item item = lab.items[] then item.size].sum()))
    for 0 <= int i < int(len(result.steps))
        Step step = result.steps[i]
        string line = "STEP " + (i + 1).string() + " item=" + text(step.item) + " bin=" + (step.bin + 1).string() + " inspected=" + step.inspected.string()
        if step.opened
            line += " new"
        if step.closed >= 0
            line += " closed=" + (step.closed + 1).string()
        if method == "HARMONIC"
            line += " class=" + step.category.string()
        emit(line)

void command_reduce(Lab lab, string method, int k)
    Packing result = pack(lab.items, lab.capacity, method, k)
    int before = int(len(result.bins))
    string[] events = []
    while true
        int[] sources = []
        for 0 <= int i < int(len(result.bins))
            sources = sources.append(i)
        for 1 <= int i < int(len(sources))
            int value = sources[i]
            int position = i
            while position > 0 and (result.bins[sources[position - 1]].load > result.bins[value].load or (result.bins[sources[position - 1]].load == result.bins[value].load and sources[position - 1] > value))
                sources[position] = sources[position - 1]
                position -= 1
            sources[position] = value
        bool eliminated = false
        for int source = sources[]
            int[] loads = [for Bin bin = result.bins[] then bin.load]
            Move[] moves = []
            bool possible = true
            int[] order = descending(result.bins[source].items)
            for int index = order[]
                Item item = result.bins[source].items[index]
                int destination = -1
                for 0 <= int i < int(len(result.bins))
                    if i == source or loads[i] + item.size > lab.capacity
                        continue
                    if destination < 0 or loads[i] > loads[destination]
                        destination = i
                if destination < 0
                    possible = false
                    break
                loads[destination] += item.size
                moves = moves.append(Move(item, destination))
            if not possible
                continue
            string[] descriptions = []
            for Move move = moves[]
                descriptions = descriptions.append(text(move.item) + "->" + (move.destination + 1).string())
            events = events.append("ELIMINATE bin=" + (source + 1).string() + " load=" + result.bins[source].load.string() + " moves=" + descriptions.join(" "))
            for Move move = moves[]
                put(&result.bins[move.destination], move.item)
            Bin[] next_bins = []
            for 0 <= int i < int(len(result.bins))
                if i != source
                    next_bins = next_bins.append(result.bins[i])
            result.bins = next_bins
            eliminated = true
            break
        if not eliminated
            break
    emit("REDUCE " + method_name(method, k) + " before=" + before.string() + " after=" + len(result.bins).string() + " eliminated=" + (before - int(len(result.bins))).string())
    for string event = events[]
        emit(event)
    bin_lines(result.bins, lab.capacity, method == "HARMONIC")

void command_bounds(Lab lab)
    Bounds result = bounds(lab.items, lab.capacity)
    emit("BOUNDS total=" + [for Item item = lab.items[] then item.size].sum().string() + " L1=" + result.l1.string() + " L2=" + result.l2.string())
    for BoundRow row = result.rows[]
        emit("ALPHA " + row.alpha.string() + " j1=" + row.j1.string() + " j2=" + row.j2.string() + " j3=" + row.j3.string() + " bound=" + row.bound.string())

void command_compare(Lab lab, int k)
    Bounds b = bounds(lab.items, lab.capacity)
    string[] names = ["ALMOSTWORST", "BFD", "BESTFIT", "FFD", "FIRSTFIT", "HARMONIC", "KBOUNDED", "NEXTFIT", "WFD", "WORSTFIT"]
    Comparison[] results = []
    int total = [for Item item = lab.items[] then item.size].sum()
    for string method = names[]
        Packing p = pack(lab.items, lab.capacity, method, k)
        results = results.append(Comparison(method, int(len(p.bins)), int(len(p.bins)) * lab.capacity - total, p.inspections))
    for 1 <= int i < int(len(results))
        Comparison value = results[i]
        int position = i
        while position > 0 and results[position - 1].bins > value.bins
            results[position] = results[position - 1]
            position -= 1
        results[position] = value
    emit("COMPARE k=" + k.string() + " L1=" + b.l1.string() + " L2=" + b.l2.string())
    for Comparison entry = results[]
        emit(entry.method + " bins=" + entry.bins.string() + " gap=" + (entry.bins - b.l2).string() + " waste=" + entry.waste.string() + " inspections=" + entry.inspections.string())

void exact_visit(Search &search, int index)
    if search.nodes == search.limit
        search.status = 2
        return
    search.nodes += 1
    int count = int(len(search.live))
    int used = search.remaining[0] - search.remaining[index]
    int free = count * search.capacity - used
    int excess = search.remaining[index] - free
    int minimum = count + (if excess > 0 then ceiling(excess, search.capacity) else 0)
    if minimum >= len(search.best)
        return
    if index == int(len(search.order))
        search.best = [for Bin bin = search.live[] then copy_bin(bin)]
        emit("IMPROVE bins=" + count.string() + " nodes=" + search.nodes.string())
        if count == search.lower
            search.status = 1
        return
    Item item = search.order[index]
    int[] seen = []
    for 0 <= int i < int(len(search.live))
        int old = search.live[i].load
        bool repeated = false
        for int load = seen[]
            if load == old
                repeated = true
        if repeated or old + item.size > search.capacity
            continue
        seen = seen.append(old)
        int old_count = int(len(search.live[i].items))
        put(&search.live[i], item)
        exact_visit(&search, index + 1)
        search.live[i].items = search.live[i].items[:<old_count]
        search.live[i].load = old
        if search.status != 0
            return
    if count + 1 < int(len(search.best))
        search.live = search.live.append(Bin([item], item.size, 0))
        exact_visit(&search, index + 1)
        search.live = search.live[:<count]

void command_exact(Lab lab, int limit)
    Packing ffd = pack(lab.items, lab.capacity, "FFD")
    Bounds b = bounds(lab.items, lab.capacity)
    emit("EXACT ffd=" + len(ffd.bins).string() + " L2=" + b.l2.string())
    int[] order = descending(lab.items)
    Item[] sorted = [for int index = order[] then lab.items[index]]
    int[] remaining = array(int(len(sorted)) + 1, fill = 0)
    int index = int(len(sorted)) - 1
    while index >= 0
        remaining[index] = remaining[index + 1] + sorted[index].size
        index -= 1
    Search search = Search(sorted, lab.capacity, limit, b.l2, remaining, [], [for Bin bin = ffd.bins[] then copy_bin(bin)], 0, 0)
    if len(ffd.bins) == b.l2
        search.status = 1
    else
        exact_visit(&search, 0)
    string status = if search.status == 1 then "bound" elif search.status == 2 then "limit" else "complete"
    emit("RESULT bins=" + len(search.best).string() + " nodes=" + search.nodes.string() + " status=" + status)
    bin_lines(search.best, lab.capacity)

void command_check(Lab lab, string[] words)
    if len(words) - 1 != len(lab.items)
        fail("BAD ASSIGNMENT")
        return
    int[] labels = []
    for 1 <= int i < int(len(words))
        int value = integer(words[i])
        if value == 0
            fail("BAD ASSIGNMENT")
            return
        labels = labels.append(value)
    int[] unique = []
    Bin[] bins = []
    for 0 <= int i < int(len(lab.items))
        int label = labels[i]
        int index = -1
        for 0 <= int j < int(len(unique))
            if unique[j] == label
                index = j
                break
        if index < 0
            index = int(len(unique))
            unique = unique.append(label)
            bins = bins.append(new_bin())
        put(&bins[index], lab.items[i])
    int over = 0
    for Bin bin = bins[]
        if bin.load > lab.capacity
            over += 1
    Bounds b = bounds(lab.items, lab.capacity)
    emit("CHECK bins=" + len(bins).string() + " over=" + over.string() + " L2=" + b.l2.string() + " status=" + (if over == 0 then "valid" else "invalid"))
    int[] order = []
    for 0 <= int i < int(len(unique))
        int position = int(len(order))
        order = order.append(i)
        while position > 0 and unique[order[position - 1]] > unique[i]
            order[position] = order[position - 1]
            position -= 1
        order[position] = i
    for int index = order[]
        bin_line(unique[index], bins[index], lab.capacity, false, bins[index].load > lab.capacity)

void cover_lines(string name, Bin[] bins, int capacity)
    int covered = 0
    int rest = -1
    for 0 <= int i < int(len(bins))
        if bins[i].load >= capacity
            covered += 1
        else
            rest = i
    emit(name + " covered=" + covered.string() + " rest=" + (if rest < 0 then "0" else bins[rest].load.string()))
    int number = 0
    for Bin bin = bins[]
        if bin.load >= capacity
            number += 1
            bin_line(number, bin, capacity)
    if rest >= 0
        emit("REST items=" + [for Item item = bins[rest].items[] then text(item)].join(" "))

void command_cover(Lab lab)
    int total = [for Item item = lab.items[] then item.size].sum()
    emit("COVER total=" + total.string() + " upper=" + (total / lab.capacity).string())
    Bin[] sequential = []
    for Item item = lab.items[]
        if len(sequential) == 0 or sequential[int(len(sequential)) - 1].load >= lab.capacity
            sequential = sequential.append(new_bin())
        put(&sequential[int(len(sequential)) - 1], item)
    cover_lines("DNF", sequential, lab.capacity)
    int[] order = descending(lab.items)
    int front = 0
    int back = int(len(order)) - 1
    Bin[] paired = []
    while front <= back
        Bin bin = new_bin()
        put(&bin, lab.items[order[front]])
        front += 1
        while bin.load < lab.capacity and front <= back
            put(&bin, lab.items[order[back]])
            back -= 1
        paired = paired.append(bin)
    cover_lines("BIGSMALL", paired, lab.capacity)

void machine_lines(Bin[] bins, int count)
    for 0 <= int i < count
        string contents = if len(bins[i].items) == 0 then "-" else [for Item item = bins[i].items[] then text(item)].join(" ")
        emit("MACHINE " + (i + 1).string() + " load=" + bins[i].load.string() + " items=" + contents)

void command_multifit(Lab lab, int m)
    int total = [for Item item = lab.items[] then item.size].sum()
    int largest = 0
    for Item item = lab.items[]
        largest = maximum(largest, item.size)
    int low = maximum(ceiling(total, m), largest)
    int high = maximum(ceiling(2 * total, m), largest)
    emit("MULTIFIT m=" + m.string() + " lower=" + low.string() + " upper=" + high.string())
    while low < high
        int middle = (low + high) / 2
        Packing result = pack(lab.items, middle, "FFD")
        bool ok = len(result.bins) <= m
        emit("TRY cap=" + middle.string() + " bins=" + len(result.bins).string() + " " + (if ok then "ok" else "fail"))
        if ok
            high = middle
        else
            low = middle + 1
    Packing result = pack(lab.items, high, "FFD")
    Bin[] machines = result.bins
    while len(machines) < m
        machines = machines.append(new_bin())
    int makespan = 0
    for Bin bin = machines[]
        makespan = maximum(makespan, bin.load)
    emit("RESULT cap=" + high.string() + " makespan=" + makespan.string())
    machine_lines(machines, m)
    Bin[] lpt = array(m, fill = new_bin())
    int[] order = descending(lab.items)
    for int index = order[]
        int best = 0
        for 1 <= int i < m
            if lpt[i].load < lpt[best].load
                best = i
        put(&lpt[best], lab.items[index])
    makespan = 0
    for Bin bin = lpt[]
        makespan = maximum(makespan, bin.load)
    emit("LPT makespan=" + makespan.string())
    machine_lines(lpt, m)

void enumerate_patterns(Piece[] pieces, int index, int remaining, int[] counts, Pattern[] &patterns)
    int maximum = remaining / pieces[index].length
    if index == int(len(pieces)) - 1
        counts[index] = maximum
        patterns = patterns.append(Pattern(counts, remaining - maximum * pieces[index].length))
        return
    int c = maximum
    while c >= 0
        counts[index] = c
        enumerate_patterns(pieces, index + 1, remaining - c * pieces[index].length, counts, &patterns)
        c -= 1

void command_cutstock(string[] words)
    int length = integer(words[1])
    if length == 0
        fail("BAD CAPACITY")
        return
    Piece[] pieces = []
    for 2 <= int i < int(len(words))
        string[] part = words[i].split(":")
        int size = integer(part[0])
        int demand = integer(part[1])
        if size == 0 or size > length or demand == 0
            fail("BAD PIECE " + (i - 1).string())
            return
        for Piece piece = pieces[]
            if piece.length == size
                fail("DUPLICATE PIECE " + (i - 1).string())
                return
        pieces = pieces.append(Piece(size, demand))
    for 1 <= int i < int(len(pieces))
        Piece value = pieces[i]
        int position = i
        while position > 0 and pieces[position - 1].length < value.length
            pieces[position] = pieces[position - 1]
            position -= 1
        pieces[position] = value
    Pattern[] patterns = []
    enumerate_patterns(pieces, 0, length, array(int(len(pieces)), fill = 0), &patterns)
    emit("CUTSTOCK L=" + length.string() + " pieces=" + len(pieces).string() + " patterns=" + len(patterns).string())
    for 0 <= int i < int(len(patterns))
        Pattern p = patterns[i]
        string[] breakdown = []
        for 0 <= int j < int(len(pieces))
            if p.counts[j] > 0
                breakdown = breakdown.append(p.counts[j].string() + "x" + pieces[j].length.string())
        emit("PATTERN " + (i + 1).string() + " " + breakdown.join("+") + " rest=" + p.trim.string())
    int[] remaining = [for Piece piece = pieces[] then piece.demand]
    int[] cut = array(int(len(pieces)), fill = 0)
    int[] uses = array(int(len(patterns)), fill = 0)
    while remaining.sum() > 0
        int chosen = 0
        int highest = -1
        for 0 <= int i < int(len(patterns))
            int score = 0
            for 0 <= int j < int(len(pieces))
                score += minimum(patterns[i].counts[j], remaining[j])
            if score > highest
                chosen = i
                highest = score
        uses[chosen] += 1
        for 0 <= int i < int(len(pieces))
            int count = patterns[chosen].counts[i]
            cut[i] += count
            remaining[i] = maximum(0, remaining[i] - count)
    int bars = 0
    int trim = 0
    for 0 <= int i < int(len(patterns))
        if uses[i] > 0
            emit("USE " + (i + 1).string() + " bars=" + uses[i].string())
            bars += uses[i]
            trim += uses[i] * patterns[i].trim
    int quantity = 0
    int demand_count = 0
    int[] sizes = []
    Item[] stock = []
    for 0 <= int i < int(len(pieces))
        Piece piece = pieces[i]
        quantity += piece.length * piece.demand
        demand_count += piece.demand
        emit("PIECE " + piece.length.string() + " demand=" + piece.demand.string() + " cut=" + cut[i].string())
        for 0 <= int j < piece.demand
            stock = stock.append(Item(int(len(stock)) + 1, piece.length))
    emit("TOTAL bars=" + bars.string() + " trim=" + trim.string() + " surplus=" + (cut.sum() - demand_count).string() + " waste=" + (bars * length - quantity).string())
    int ffd = int(len(pack(stock, length, "FIRSTFIT").bins))
    emit("FFD bars=" + ffd.string() + " waste=" + (ffd * length - quantity).string())
    emit("LOWER bars=" + ceiling(quantity, length).string())

bool before_rect(Rect a, Rect b, bool area = false)
    if area
        if a.width * a.height != b.width * b.height
            return a.width * a.height > b.width * b.height
    else
        if a.height != b.height
            return a.height > b.height
        if a.width != b.width
            return a.width > b.width
    return a.number < b.number

Rect[] rectangle_order(Rect[] source, bool area = false)
    Rect[] order = []
    for Rect value = source[]
        int position = int(len(order))
        order = order.append(value)
        while position > 0 and before_rect(value, order[position - 1], area)
            order[position] = order[position - 1]
            position -= 1
        order[position] = value
    return order

string letter(Rect rect)
    int[] capitals = [65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90]
    return string.from_codepoints([capitals[rect.number - 1]])

void drawing(int width, int height, Placement[] placements)
    string[][] rows = array(height, fill = array(width, fill = "."))
    for Placement p = placements[]
        for p.y <= int y < p.y + p.height
            for p.x <= int x < p.x + p.width
                rows[y][x] = letter(p.rect)
    int y = height - 1
    while y >= 0
        emit(rows[y].join(""))
        y -= 1

Rect[] parse_rectangles(string[] words, int start)
    Rect[] result = []
    for start <= int i < int(len(words))
        string[] pair = words[i].split("x")
        result = result.append(Rect(i - start + 1, integer(pair[0]), integer(pair[1])))
    return result

void command_shelf(string[] words)
    int width = integer(words[1])
    if width == 0
        fail("BAD CAPACITY")
        return
    Rect[] source = parse_rectangles(words, 2)
    for Rect rect = source[]
        if rect.width == 0 or rect.height == 0 or rect.width > width
            fail("BAD RECT " + rect.number.string())
            return
    int area = 0
    for Rect rect = source[]
        area += rect.width * rect.height
    emit("SHELF W=" + width.string() + " rects=" + len(source).string() + " area=" + area.string())
    Rect[] order = rectangle_order(source)
    string[] methods = ["NFDH", "FFDH", "BFDH"]
    for string method = methods[]
        Shelf[] shelves = []
        Placement[] placements = []
        for Rect rect = order[]
            int chosen = -1
            if method == "NFDH"
                if len(shelves) > 0 and shelves[int(len(shelves)) - 1].used + rect.width <= width
                    chosen = int(len(shelves)) - 1
            else
                for 0 <= int i < int(len(shelves))
                    if shelves[i].used + rect.width > width
                        continue
                    if chosen < 0 or (method == "BFDH" and shelves[i].used > shelves[chosen].used)
                        chosen = i
                    if method == "FFDH"
                        break
            if chosen < 0
                int bottom = if len(shelves) == 0 then 0 else shelves[int(len(shelves)) - 1].bottom + shelves[int(len(shelves)) - 1].height
                shelves = shelves.append(Shelf(bottom, rect.height, 0, []))
                chosen = int(len(shelves)) - 1
            Placement p = Placement(rect, shelves[chosen].used, shelves[chosen].bottom, rect.width, rect.height, false)
            shelves[chosen].placed = shelves[chosen].placed.append(p)
            placements = placements.append(p)
            shelves[chosen].used += rect.width
        int height = shelves[int(len(shelves)) - 1].bottom + shelves[int(len(shelves)) - 1].height
        emit(method + " height=" + height.string() + " shelves=" + len(shelves).string() + " util=" + (area * 100 / (width * height)).string())
        for 0 <= int i < int(len(shelves))
            Shelf shelf = shelves[i]
            string[] contents = [for Placement p = shelf.placed[] then letter(p.rect) + "@" + p.x.string()]
            emit("LEVEL " + (i + 1).string() + " y=" + shelf.bottom.string() + " h=" + shelf.height.string() + " used=" + shelf.used.string() + " items=" + contents.join(" "))
        drawing(width, height, placements)
    int[] columns = array(width, fill = 0)
    Placement[] skyline = []
    for Rect rect = order[]
        int best_x = 0
        int best_y = 2147483647
        for 0 <= int x <= width - rect.width
            int top = 0
            for x <= int j < x + rect.width
                top = maximum(top, columns[j])
            if top < best_y
                best_y = top
                best_x = x
        skyline = skyline.append(Placement(rect, best_x, best_y, rect.width, rect.height, false))
        for best_x <= int x < best_x + rect.width
            columns[x] = best_y + rect.height
    int height = 0
    for int value = columns[]
        height = maximum(height, value)
    emit("SKYLINE height=" + height.string() + " util=" + (area * 100 / (width * height)).string())
    for Placement p = skyline[]
        emit("PLACE " + letter(p.rect) + " x=" + p.x.string() + " y=" + p.y.string() + " w=" + p.width.string() + " h=" + p.height.string())
    drawing(width, height, skyline)

bool fits(Rect rect, FreeRect region, bool rotate)
    return (rect.width <= region.width and rect.height <= region.height) or (rotate and rect.height <= region.width and rect.width <= region.height)

void command_guillotine(string[] words)
    int width = integer(words[1])
    int height = integer(words[2])
    if width == 0 or height == 0
        fail("BAD CAPACITY")
        return
    bool rotate = words[3] == "ROTATE"
    bool best = words[4] == "BEST"
    Rect[] rects = parse_rectangles(words, 5)
    for Rect rect = rects[]
        if rect.width == 0 or rect.height == 0 or not ((rect.width <= width and rect.height <= height) or (rotate and rect.height <= width and rect.width <= height))
            fail("BAD RECT " + rect.number.string())
            return
    Rect[] order = rectangle_order(rects, true)
    int area = 0
    for Rect rect = rects[]
        area += rect.width * rect.height
    Sheet[] sheets = []
    int rotated = 0
    for Rect rect = order[]
        int chosen_sheet = -1
        int chosen_free = -1
        int chosen_area = 2147483647
        for 0 <= int i < int(len(sheets))
            for 0 <= int j < int(len(sheets[i].free))
                FreeRect region = sheets[i].free[j]
                if not fits(rect, region, rotate)
                    continue
                int free_area = region.width * region.height
                if chosen_sheet < 0 or (best and free_area < chosen_area)
                    chosen_sheet = i
                    chosen_free = j
                    chosen_area = free_area
                if not best
                    break
            if chosen_sheet >= 0 and not best
                break
        if chosen_sheet < 0
            chosen_sheet = int(len(sheets))
            chosen_free = 0
            sheets = sheets.append(Sheet([FreeRect(0, 0, width, height)], [], 0))
        FreeRect region = sheets[chosen_sheet].free[chosen_free]
        FreeRect[] next_free = []
        for 0 <= int j < int(len(sheets[chosen_sheet].free))
            if j != chosen_free
                next_free = next_free.append(sheets[chosen_sheet].free[j])
        sheets[chosen_sheet].free = next_free
        bool turned = rect.width > region.width or rect.height > region.height
        int w = if turned then rect.height else rect.width
        int h = if turned then rect.width else rect.height
        if turned
            rotated += 1
        sheets[chosen_sheet].placed = sheets[chosen_sheet].placed.append(Placement(rect, region.x, region.y, w, h, turned))
        sheets[chosen_sheet].area += rect.width * rect.height
        int rw = region.width - w
        int rh = region.height - h
        FreeRect top = if rw <= rh then FreeRect(region.x, region.y + h, region.width, rh) else FreeRect(region.x, region.y + h, w, rh)
        FreeRect right = if rw <= rh then FreeRect(region.x + w, region.y, rw, h) else FreeRect(region.x + w, region.y, rw, region.height)
        if top.width > 0 and top.height > 0
            sheets[chosen_sheet].free = sheets[chosen_sheet].free.append(top)
        if right.width > 0 and right.height > 0
            sheets[chosen_sheet].free = sheets[chosen_sheet].free.append(right)
    emit("GUILLOTINE W=" + width.string() + " H=" + height.string() + " mode=" + words[3] + " rule=" + words[4] + " rects=" + len(order).string() + " sheets=" + len(sheets).string() + " rotated=" + rotated.string() + " util=" + (area * 100 / (int(len(sheets)) * width * height)).string())
    for 0 <= int i < int(len(sheets))
        Sheet sheet = sheets[i]
        emit("SHEET " + (i + 1).string() + " placed=" + len(sheet.placed).string() + " area=" + sheet.area.string())
        for Placement p = sheet.placed[]
            emit("PLACE " + letter(p.rect) + " x=" + p.x.string() + " y=" + p.y.string() + " w=" + p.width.string() + " h=" + p.height.string() + (if p.rotated then " rotated" else ""))
        if len(sheet.free) == 0
            emit("FREE none")
        else
            string[] regions = [for FreeRect r = sheet.free[] then r.x.string() + "," + r.y.string() + "," + r.width.string() + "x" + r.height.string()]
            emit("FREE " + regions.join(" "))
        drawing(width, height, sheet.placed)

void command(Lab &lab, string line)
    string[] words = line.split(" ")
    string action = words[0]
    if action == "ITEMS"
        command_items(&lab, words)
    elif action == "RANDOM"
        command_random(&lab, words)
    elif action == "CUTSTOCK"
        command_cutstock(words)
    elif action == "SHELF"
        command_shelf(words)
    elif action == "GUILLOTINE"
        command_guillotine(words)
    else
        if not lab.ready
            fail("NO ITEMS")
            return
        if action == "TRACE" or action == "REDUCE"
            string method = words[1]
            int k = if parameterized(method) then integer(words[2]) else 0
            if parameterized(method) and k == 0
                fail("BAD PARAMETER")
                return
            if action == "TRACE"
                command_trace(lab, method, k)
            else
                command_reduce(lab, method, k)
        elif action == "BOUNDS"
            command_bounds(lab)
        elif action == "COMPARE"
            int k = integer(words[1])
            if k == 0
                fail("BAD PARAMETER")
            else
                command_compare(lab, k)
        elif action == "EXACT"
            int limit = integer(words[1])
            if limit == 0
                fail("BAD PARAMETER")
            elif len(lab.items) >= 21
                fail("TOO MANY ITEMS")
            else
                command_exact(lab, limit)
        elif action == "CHECK"
            command_check(lab, words)
        elif action == "COVER"
            command_cover(lab)
        elif action == "MULTIFIT"
            int m = integer(words[1])
            if m == 0
                fail("BAD PARAMETER")
            else
                command_multifit(lab, m)
        else
            int k = if parameterized(action) then integer(words[1]) else 0
            if parameterized(action) and k == 0
                fail("BAD PARAMETER")
            else
                command_method(lab, action, k)

int count = 0
scan(&count)
Lab lab = Lab()
for 0 <= int line_number < count
    string line = ""
    scan(&line)
    command(&lab, line)
