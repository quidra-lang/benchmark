string letters()
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

bool all_chars(string text, string alphabet)
    for nat i < len(text)
        if not alphabet.contains(text[i])
            return false
    return true

string lower(string text)
    string result = ""
    for nat i < len(text)
        match "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(text[i])
            nat index
                result += "abcdefghijklmnopqrstuvwxyz"[index]
            none
                result += text[i]
    return result

string punctuation()
    return "!{DQ}#$%&'()*+,-./:;<=>?@[\]^_`{{|}}~"

nat find_at(string text, string needle, nat start = 0)
    if start > len(text)
        return len(text)
    match text[start:].find(needle)
        nat index
            return start + index
        none
            return len(text)

bool starts_at(string text, string prefix, nat at = 0)
    return at <= len(text) and text[at:].starts_with(prefix)

string trim_spaces(string text)
    nat start = 0
    nat end = len(text)
    while start < end and text[start] == " "
        start += 1
    while end > start and text[end - 1] == " "
        end -= 1
    return text[start:<end]

string left_trim(string text)
    nat start = 0
    while start < len(text) and text[start] == " "
        start += 1
    return text[start:]

string escape_html(string text)
    string html = ""
    for nat i < len(text)
        string ch = text[i]
        if ch == "&"
            html += "&amp;"
        elif ch == "<"
            html += "&lt;"
        elif ch == ">"
            html += "&gt;"
        elif ch == DQ
            html += "&quot;"
        else
            html += ch
    return html

string strip_tags(string text)
    string result = ""
    nat at = 0
    while at < len(text)
        if text[at] == "<"
            nat close = find_at(text, ">", at + 1)
            if close < len(text)
                at = close + 1
                continue
        result += text[at]
        at += 1
    return result

string normalize(string text)
    string result = ""
    bool pending = false
    string lowered = lower(text)
    for nat i < len(lowered)
        string ch = lowered[i]
        if ch == " " or ch == NL
            pending = result != ""
        else
            if pending
                result += " "
            result += ch
            pending = false
    return result

nat skip_space(string text, nat start)
    nat at = start
    while at < len(text) and (text[at] == " " or text[at] == NL)
        at += 1
    return at

class Read(string text, nat end)

Read escaped_read(string text, nat start, string stops)
    nat at = start
    string result = ""
    while at < len(text) and not stops.contains(text[at])
        if text[at] == "\" and at + 1 < len(text) and punctuation().contains(text[at + 1])
            at += 1
        result += text[at]
        at += 1
    return Read(result, at)

nat run_end(string text, nat start)
    nat end = start + 1
    while end < len(text) and text[end] == text[start]
        end += 1
    return end

class Reference(string url, string | none title = none)
class Block(string kind, string text = "", nat number = 0, bool ordered = false)
    string[] lines = []
    nat[] children = []
    nat[][] items = []
    string[] alignments = []
    string[][] rows = []

class Fence(string run, string info)

Fence | none opening_fence(string line)
    if line == "" or not "`~".contains(line[0])
        return none
    nat end = run_end(line, 0)
    if end < 3
        return none
    string info = trim_spaces(line[end:])
    if line[0] == "`" and info.contains("`")
        return none
    return Fence(line[:<end], info)

Block | none atx_heading(string line)
    if line == "" or line[0] != "#"
        return none
    nat size = run_end(line, 0)
    if size > 6 or (size < len(line) and line[size] != " ")
        return none
    string text = trim_spaces(line[size:])
    nat end = len(text)
    while end > 0 and text[end - 1] == "#"
        end -= 1
    if end == 0 or text[end - 1] == " "
        text = trim_spaces(text[:<end])
    return Block("heading", text, size)

bool is_rule(string line)
    string text = line.split(" ").join("")
    return len(text) >= 3 and "-*_".contains(text[0]) and all_chars(text, text[0])

class Marker(string kind, bool ordered, nat number, string content)

Marker | none list_marker(string line)
    if len(line) < 2 or is_rule(line)
        return none
    nat end = 0
    bool ordered = false
    nat number = 1
    if "-*+".contains(line[0])
        end = 1
    else
        while end < len(line) and "0123456789".contains(line[end])
            end += 1
        if end == 0 or end > 9 or end == len(line) or not ".)".contains(line[end])
            return none
        number = nat.parse(line[:<end])
        ordered = true
        end += 1
    if end == len(line) or line[end] != " "
        return none
    string kind = line[end - 1]
    return Marker(kind, ordered, number, line[skip_space(line, end):])

bool interrupts(string line)
    if line == "" or line.starts_with(" ")
        return false
    match opening_fence(line)
        Fence
            return true
        none
            void
    match atx_heading(line)
        Block
            return true
        none
            void
    match list_marker(line)
        Marker
            return true
        none
            void
    return is_rule(line) or line.starts_with(">")

string[] split_cells(string line)
    string text = trim_spaces(line)
    nat at = if text.starts_with("|") then 1 else 0
    string[] cells = []
    string cell = ""
    bool separator = false
    while at < len(text)
        string ch = text[at]
        at += 1
        separator = false
        if ch == "\" and at < len(text)
            if text[at] != "|"
                cell += "\"
            cell += text[at]
            at += 1
        elif ch == "|"
            cells = cells.append(trim_spaces(cell))
            cell = ""
            separator = true
        else
            cell += ch
    if not separator
        cells = cells.append(trim_spaces(cell))
    return cells

string | none alignment(string text)
    nat start = if text.starts_with(":") then 1 else 0
    nat end = len(text)
    bool right = text.ends_with(":")
    if right and end > start
        end -= 1
    if end <= start or not all_chars(text[start:<end], "-")
        return none
    return if start == 1 then if right then "center" else "left" else if right then "right" else ""

// Children are arena indices: recursive structure without shared mutable nodes.
class Parser()
    Block[] blocks = []
    map.Map<string, Reference> references
    map.Map<string, string> footnotes

    nat .add(Block block)
        blocks = blocks.append(block)
        return len(blocks) - 1

    bool .definition(string line)
        if not line.starts_with("[")
            return false
        nat close = find_at(line, "]")
        if close == len(line) or not starts_at(line, ":", close + 1)
            return false
        string label = line[1:<close]
        string rest = trim_spaces(line[close + 2:])
        if label.starts_with("^") and len(label) > 1 and all_chars(label[1:], letters() + "-_") and rest != ""
            string name = lower(label[1:])
            if not footnotes.has(name)
                .footnotes.set(name, rest)
            return true
        if label.contains("[") or trim_spaces(label) == "" or label.starts_with("^")
            return false
        Read url = escaped_read(line, skip_space(line, close + 2), " ")
        if url.text == ""
            return false
        nat at = skip_space(line, url.end)
        string | none title = none
        if at < len(line)
            if at == url.end or not (DQ + "'").contains(line[at])
                return false
            Read quoted = escaped_read(line, at + 1, line[at])
            if quoted.end != len(line) - 1
                return false
            title = quoted.text
        string name = normalize(label)
        if not references.has(name)
            .references.set(name, Reference(url.text, title))
        return true

    nat[] .parse(string[] lines)
        nat[] result = []
        nat at = 0
        while at < len(lines)
            string line = lines[at]
            if line == ""
                at += 1
                continue
            if line.starts_with("    ")
                nat end = at
                while end < len(lines) and (lines[end] == "" or lines[end].starts_with("    "))
                    end += 1
                while lines[end - 1] == ""
                    end -= 1
                auto block = Block("code")
                while at < end
                    block.lines = block.lines.append(if lines[at] == "" then "" else lines[at][4:])
                    at += 1
                result = result.append(.add(block))
                continue
            if not line.starts_with(" ")
                match opening_fence(line)
                    Fence fence
                        auto block = Block("code", fence.info.split(" ")[0])
                        at += 1
                        while at < len(lines)
                            string row = lines[at]
                            at += 1
                            if len(row) >= len(fence.run) and all_chars(row, fence.run[0])
                                break
                            block.lines = block.lines.append(row)
                        result = result.append(.add(block))
                        continue
                    none
                        void
                match atx_heading(line)
                    Block block
                        result = result.append(.add(block))
                        at += 1
                        continue
                    none
                        void
                if is_rule(line)
                    result = result.append(.add(Block("rule")))
                    at += 1
                    continue
                if line.starts_with(">")
                    string[] content = []
                    while at < len(lines) and lines[at].starts_with(">")
                        string row = lines[at][1:]
                        content = content.append(if row.starts_with(" ") then row[1:] else row)
                        at += 1
                    auto block = Block("quote")
                    string[] alerts = ["[!NOTE]", "[!TIP]", "[!IMPORTANT]", "[!WARNING]", "[!CAUTION]"]
                    for string alert = alerts[]
                        if content[0] == alert
                            block.kind = "alert"
                            block.text = alert[2:<len(alert) - 1]
                            content = content[1:]
                            break
                    block.children = .parse(content)
                    result = result.append(.add(block))
                    continue
                match list_marker(line)
                    Marker first
                        auto block = Block("list", "", first.number, first.ordered)
                        string body = first.content
                        bool more = true
                        while more
                            string[] content = [body]
                            at += 1
                            while at < len(lines) and lines[at].starts_with("  ")
                                content = content.append(lines[at][2:])
                                at += 1
                            block.items = block.items.append(.parse(content))
                            nat following = at
                            while following < len(lines) and lines[following] == ""
                                following += 1
                            more = false
                            if following < len(lines)
                                match list_marker(lines[following])
                                    Marker next
                                        if next.kind == first.kind and next.ordered == first.ordered
                                            more = true
                                            at = following
                                            body = next.content
                                    none
                                        void
                        result = result.append(.add(block))
                        continue
                    none
                        void
                if .definition(line)
                    at += 1
                    continue
                if at + 1 < len(lines) and line.contains("|") and lines[at + 1].contains("|")
                    string[] header = split_cells(line)
                    string[] delimiters = split_cells(lines[at + 1])
                    string[] aligns = []
                    bool valid = len(header) == len(delimiters)
                    for string cell = delimiters[]
                        match alignment(cell)
                            string align
                                aligns = aligns.append(align)
                            none
                                valid = false
                    if valid
                        auto block = Block("table")
                        block.lines = header
                        block.alignments = aligns
                        at += 2
                        while at < len(lines) and lines[at].contains("|")
                            string[] row = split_cells(lines[at])
                            if len(row) > len(header)
                                row = row[:<len(header)]
                            while len(row) < len(header)
                                row = row.append("")
                            block.rows = block.rows.append(row)
                            at += 1
                        result = result.append(.add(block))
                        continue
            nat end = at + 1
            nat level = 0
            while end < len(lines) and lines[end] != ""
                string following = lines[end]
                if len(following) >= 3 and (all_chars(following, "=") or all_chars(following, "-"))
                    level = if following[0] == "=" then 1 else 2
                    break
                if interrupts(following)
                    break
                end += 1
            string text = [for string row = lines[at:<end][] then left_trim(row)].join(NL)
            string kind = if level > 0 then "heading" else if text == "[TOC]" then "toc" else "paragraph"
            result = result.append(.add(Block(kind, text, level)))
            at = end + (if level > 0 then 1 else 0)
        return result

class Piece(string html, string character = "", nat count = 0, bool opens = false, bool closes = false)

string emphasis(Piece[] pieces, nat start, nat end)
    string html = ""
    nat at = start
    while at < end
        Piece piece = pieces[at]
        nat close = end
        if piece.opens
            for at + 1 <= nat i < end
                Piece candidate = pieces[i]
                if candidate.closes and candidate.character == piece.character and candidate.count == piece.count
                    close = i
                    break
        if close < end
            string opening = "<del>"
            string closing = "</del>"
            if piece.character != "~"
                opening = if piece.count == 1 then "<em>" else if piece.count == 2 then "<strong>" else "<em><strong>"
                closing = if piece.count == 1 then "</em>" else if piece.count == 2 then "</strong>" else "</strong></em>"
            html += opening + emphasis(pieces, at + 1, close) + closing
            at = close + 1
        else
            html += if piece.count == 0 then piece.html else string.repeat(piece.character, piece.count)
            at += 1
    return html

nat tick_closer(string text, nat start, nat count)
    nat at = start
    while at < len(text)
        if text[at] == "`"
            nat end = run_end(text, at)
            if end - at == count
                return at
            at = end
        else
            at += 1
    return len(text)

nat closing_bracket(string text, nat start)
    nat at = start
    nat depth = 0
    while at < len(text)
        if text[at] == "\"
            at += 2
            continue
        if text[at] == "`"
            nat end = run_end(text, at)
            nat close = tick_closer(text, end, end - at)
            at = if close == len(text) then end else close + end - at
            continue
        if text[at] == "["
            depth += 1
        elif text[at] == "]"
            depth -= 1
            if depth == 0
                return at
        at += 1
    return len(text)

bool email_address(string text)
    string[] parts = text.split("@")
    if len(parts) != 2 or parts[0] == "" or not all_chars(parts[0], letters() + ".+-_")
        return false
    string[] domain = parts[1].split(".")
    if len(domain) < 2
        return false
    for string word = domain[]
        if word == "" or not all_chars(word, letters() + "-")
            return false
    return true

class Destination(Reference reference, nat end)
class Heading(nat level, string identifier, string label)

string reference_id(nat number, nat count)
    return if count == 1 then "fnref-{number}" else "fnref-{number}-{count}"

string toc_list(Heading[] headings, int[] parents, int parent)
    string html = "<ul>{NL}"
    for Heading entry = headings[nat i]
        if parents[i] != parent
            continue
        html += "<li><a href={DQ}#{entry.identifier}{DQ}>{entry.label}</a>"
        bool children = false
        for int owner = parents[]
            if owner == int(i)
                children = true
        if children
            html += NL + toc_list(headings, parents, int(i)) + NL
        html += "</li>{NL}"
    return html + "</ul>"

class Renderer(local Parser parser)
    Block[] blocks = parser.blocks
    map.Map<string, Reference> references = parser.references
    map.Map<string, string> definitions = parser.footnotes
    set.Set<string> used_ids
    Heading[] headings = []
    string[] notes = []
    nat[] counts = []

    Destination | none destination(string text, nat at, string label)
        if starts_at(text, "[", at)
            nat close = find_at(text, "]", at + 1)
            if close < len(text) and not text[at + 1:<close].contains("[")
                string raw = text[at + 1:<close]
                match references.get(normalize(if raw == "" then label else raw))
                    Reference reference
                        return Destination(reference, close + 1)
                    none
                        return none
        elif starts_at(text, "(", at)
            Read url = escaped_read(text, skip_space(text, at + 1), " {NL})")
            nat next = skip_space(text, url.end)
            string | none title = none
            bool valid = true
            if next > url.end and next < len(text) and (DQ + "'").contains(text[next])
                Read quoted = escaped_read(text, next + 1, text[next])
                title = quoted.text
                valid = quoted.end < len(text)
                next = skip_space(text, quoted.end + 1)
            if valid and starts_at(text, ")", next)
                return Destination(Reference(url.text, title), next + 1)
        match references.get(normalize(label))
            Reference reference
                return Destination(reference, at)
            none
                return none

    string .note_reference(string name)
        nat index = len(notes)
        for string note = notes[nat i]
            if note == name
                index = i
                break
        if index == len(notes)
            notes = notes.append(name)
            counts = counts.append(0)
        counts[index] += 1
        nat number = index + 1
        string id = reference_id(number, counts[index])
        return "<sup id={DQ}{id}{DQ}><a href={DQ}#fn-{number}{DQ}>{number}</a></sup>"

    string .inline_html(string text, bool links = true, bool footnotes = true)
        Piece[] pieces = []
        nat at = 0
        while at < len(text)
            string ch = text[at]
            if ch == "\"
                if at + 1 < len(text) and punctuation().contains(text[at + 1])
                    pieces = pieces.append(Piece(escape_html(text[at + 1])))
                    at += 2
                elif at + 1 < len(text) and text[at + 1] == NL
                    pieces = pieces.append(Piece("<br />{NL}"))
                    at += 2
                else
                    pieces = pieces.append(Piece("\"))
                    at += 1
                continue
            if ch == "`"
                nat end = run_end(text, at)
                nat count = end - at
                nat close = tick_closer(text, end, count)
                if close == len(text)
                    pieces = pieces.append(Piece(text[at:<end]))
                    at = end
                else
                    string code = text[end:<close].split(NL).join(" ")
                    if code.starts_with(" ") and code.ends_with(" ") and trim_spaces(code) != ""
                        code = code[1:<len(code) - 1]
                    pieces = pieces.append(Piece("<code>{escape_html(code)}</code>"))
                    at = close + count
                continue
            if links and ch == "<"
                nat close = find_at(text, ">", at + 1)
                if close < len(text)
                    string target = text[at + 1:<close]
                    string href = ""
                    bool clean = not target.contains(" ") and not target.contains(NL) and not target.contains("<")
                    if clean and ((target.starts_with("http://") and len(target) > 7) or (target.starts_with("https://") and len(target) > 8))
                        href = target
                    elif email_address(target)
                        href = "mailto:" + target
                    if href != ""
                        pieces = pieces.append(Piece("<a href={DQ}{escape_html(href)}{DQ}>{escape_html(target)}</a>"))
                        at = close + 1
                        continue
            if links and (starts_at(text, "http://", at) or starts_at(text, "https://", at)) and (at == 0 or " {NL}*_~(".contains(text[at - 1]))
                nat end = at
                while end < len(text) and not " {NL}<".contains(text[end])
                    end += 1
                while end > at and ".,:;!?*_~)".contains(text[end - 1])
                    end -= 1
                string url = text[at:<end]
                if url != "http://" and url != "https://"
                    string escaped = escape_html(url)
                    pieces = pieces.append(Piece("<a href={DQ}{escaped}{DQ}>{escaped}</a>"))
                    at = end
                    continue
            if ch == "[" or (ch == "!" and starts_at(text, "[", at + 1))
                if links and footnotes and starts_at(text, "[^", at)
                    nat close = find_at(text, "]", at + 2)
                    if close < len(text)
                        string name = lower(text[at + 2:<close])
                        if definitions.has(name)
                            pieces = pieces.append(Piece(.note_reference(name)))
                            at = close + 1
                            continue
                bool image = ch == "!"
                if image or links
                    nat opening = at + (if image then 1 else 0)
                    nat close = closing_bracket(text, opening)
                    if close < len(text)
                        string label = text[opening + 1:<close]
                        match destination(text, close + 1, label)
                            Destination dest
                                string content = .inline_html(label, false, false)
                                string title = ""
                                match dest.reference.title
                                    string value
                                        title = " title={DQ}{escape_html(value)}{DQ}"
                                    none
                                        void
                                string url = escape_html(dest.reference.url)
                                string html = if image then "<img src={DQ}{url}{DQ} alt={DQ}{strip_tags(content)}{DQ}{title} />" else "<a href={DQ}{url}{DQ}{title}>{content}</a>"
                                pieces = pieces.append(Piece(html))
                                at = dest.end
                                continue
                            none
                                void
            if "*_~".contains(ch)
                nat end = run_end(text, at)
                nat count = end - at
                string before = if at == 0 then " " else text[at - 1]
                string after = if end == len(text) then " " else text[end]
                bool opens = not " {NL}".contains(after)
                bool closes = not " {NL}".contains(before)
                if ch == "_" and letters().contains(before) and letters().contains(after)
                    opens = false
                    closes = false
                if (ch != "~" and count <= 3) or (ch == "~" and count == 2)
                    pieces = pieces.append(Piece("", ch, count, opens, closes))
                else
                    pieces = pieces.append(Piece(text[at:<end]))
                at = end
                continue
            pieces = pieces.append(Piece(escape_html(ch)))
            at += 1
        return emphasis(pieces, 0, len(pieces))

    string .heading_html(Block block)
        string text = block.text
        nat explicit_at = len(text)
        nat at = 0
        while at < len(text)
            nat found = find_at(text, " {{#", at)
            if found == len(text)
                break
            explicit_at = found
            at = found + 1
        string id = ""
        if text.ends_with("}}") and explicit_at < len(text)
            string candidate = text[explicit_at + 3:<len(text) - 1]
            if candidate != "" and all_chars(candidate, letters() + "-_")
                id = candidate
                text = trim_spaces(text[:<explicit_at])
        if id == ""
            string base = ""
            string lowered = lower(text)
            for nat i < len(lowered)
                string ch = lowered[i]
                if "abcdefghijklmnopqrstuvwxyz0123456789-_".contains(ch)
                    base += ch
                elif ch == " " or ch == NL
                    base += "-"
            if base == ""
                base = "heading"
            id = base
            nat suffix = 1
            while used_ids.has(id)
                id = "{base}-{suffix}"
                suffix += 1
        .used_ids.add(id)
        string html = .inline_html(text)
        headings = headings.append(Heading(block.number, id, strip_tags(html)))
        return "<h{block.number} id={DQ}{id}{DQ}>{html}</h{block.number}>"

    string .sequence(nat[] indices)
        string html = ""
        for nat index = indices[]
            html += .render(index) + NL
        return html

    string .item(nat[] indices)
        string html = "<li>"
        for nat index = indices[nat position]
            Block block = blocks[index]
            if block.kind == "paragraph"
                string text = block.text
                if position == 0 and len(text) > 4 and (text.starts_with("[ ] ") or text.starts_with("[x] ") or text.starts_with("[X] "))
                    string checked = if text[1] == " " then "" else " checked={DQ}{DQ}"
                    html += "<input type={DQ}checkbox{DQ}{checked} disabled={DQ}{DQ} /> "
                    text = text[4:]
                html += .inline_html(text)
            else
                if not html.ends_with(NL)
                    html += NL
                html += .render(index) + NL
        return html + "</li>"

    string .table_row(string tag, string[] aligns, string[] cells)
        string[] html = []
        for string cell = cells[nat i]
            string style = if aligns[i] == "" then "" else " style={DQ}text-align:{aligns[i]}{DQ}"
            string content = .inline_html(cell)
            html = html.append("<{tag}{style}>{content}</{tag}>")
        return html.join(NL)

    string .render(nat index)
        Block block = blocks[index]
        if block.kind == "heading"
            return .heading_html(block)
        if block.kind == "paragraph"
            string content = .inline_html(block.text)
            return "<p>{content}</p>"
        if block.kind == "rule"
            return "<hr />"
        if block.kind == "toc"
            return "{HT}toc{HT}"
        if block.kind == "code"
            string attr = if block.text == "" then "" else " class={DQ}language-{escape_html(block.text)}{DQ}"
            string html = "<pre><code{attr}>"
            for string line = block.lines[]
                html += escape_html(line) + NL
            return html + "</code></pre>"
        if block.kind == "quote"
            string content = .sequence(block.children)
            return "<blockquote>{NL}{content}</blockquote>"
        if block.kind == "alert"
            string name = lower(block.text)
            string title = block.text[0] + name[1:]
            string content = .sequence(block.children)
            return "<div class={DQ}alert alert-{name}{DQ}>{NL}<p class={DQ}alert-title{DQ}>{title}</p>{NL}{content}</div>"
        if block.kind == "list"
            string tag = if block.ordered then "ol" else "ul"
            string attr = if block.ordered and block.number != 1 then " start={DQ}{block.number}{DQ}" else ""
            string html = "<{tag}{attr}>{NL}"
            for nat[] indices = block.items[]
                html += .item(indices) + NL
            return html + "</{tag}>"
        string html = "<table>{NL}<thead>{NL}<tr>{NL}"
        html += .table_row("th", block.alignments, block.lines) + "{NL}</tr>{NL}</thead>{NL}"
        if len(block.rows) > 0
            html += "<tbody>{NL}"
            for string[] row = block.rows[]
                html += "<tr>{NL}" + .table_row("td", block.alignments, row) + "{NL}</tr>{NL}"
            html += "</tbody>{NL}"
        return html + "</table>"

    string contents()
        int[] parents = []
        nat[] stack = []
        for Heading entry = headings[nat i]
            while len(stack) > 0 and headings[stack[len(stack) - 1]].level >= entry.level
                stack = stack[:<len(stack) - 1]
            parents = parents.append(if len(stack) == 0 then -1 else int(stack[len(stack) - 1]))
            stack = stack.append(i)
        string body = if len(headings) == 0 then "" else toc_list(headings, parents, -1) + NL
        return "<nav class={DQ}toc{DQ}>{NL}{body}</nav>"

    string .footnote_list()
        if len(notes) == 0
            return ""
        string html = "<section class={DQ}footnotes{DQ}>{NL}<ol>{NL}"
        for string name = notes[nat index]
            string body = ""
            match definitions.get(name)
                string text
                    body = .inline_html(text, true, false)
                none
                    void
            nat number = index + 1
            string[] backlinks = []
            for 1 <= nat count <= counts[index]
                backlinks = backlinks.append("<a href={DQ}#{reference_id(number, count)}{DQ}>&#8617;</a>")
            html += "<li id={DQ}fn-{number}{DQ}>{body} {backlinks.join(" ")}</li>{NL}"
        return html + "</ol>{NL}</section>{NL}"

string[] input_lines = []
string input_line
scan(&input_line)
while input_line != "@@END@@"
    input_lines = input_lines.append(input_line)
    scan(&input_line)
auto parser = Parser()
nat[] document = .parser.parse(input_lines)
auto renderer = Renderer(parser)
string html = .renderer.sequence(document)
html = html.split("{HT}toc{HT}").join(renderer.contents())
print(html + .renderer.footnote_list())
