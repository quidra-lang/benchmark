import math

const string WrongType = "WRONGTYPE Operation against a key holding the wrong kind of value"
const string NotInteger = "ERR value is not an integer or out of range"
const string Positive = "ERR value is out of range, must be positive"
const string Backslash = "\"

string uppercase(string text)
    string result = ""
    for nat position < len(text)
        string character = text[position]
        match "abcdefghijklmnopqrstuvwxyz".find(character)
            nat index
                result += "ABCDEFGHIJKLMNOPQRSTUVWXYZ"[index]
            none
                result += character
    return result

string lowercase(string text)
    string result = ""
    for nat position < len(text)
        string character = text[position]
        match "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(character)
            nat index
                result += "abcdefghijklmnopqrstuvwxyz"[index]
            none
                result += character
    return result

bool one_of(string choices, string sought)
    for string word = choices.split(" ")[]
        if word == sought
            return true
    return false

string quoted(string | none item)
    match item
        none
            return "(nil)"
        string text
            string result = DQ
            for nat position < len(text)
                string character = text[position]
                if character == DQ or character == Backslash
                    result += Backslash
                result += character
            return result + DQ

string integer_reply(int number)
    return "(integer) {number}"

string array_items(const string[] rendered)
    if len(rendered) == 0
        return "(empty array)"
    nat width = len(len(rendered).string())
    string[] lines = []
    for nat index = rendered.indices()[]
        string label = (index + 1).string()
        lines = lines.append(string.repeat(" ", width - len(label)) + label + ") " + rendered[index])
    return lines.join(NL)

string array_reply(const string[] items)
    return array_items([for string item = items[] then quoted(item)])

string[] | none split_line(string line)
    string[] words = []
    int position = 0
    while position < int(len(line))
        if line[position] == " "
            position += 1
            continue
        if line[position] != DQ
            int start = position
            while position < int(len(line)) and line[position] != " "
                position += 1
            words = words.append(line[start:<position])
            continue
        position += 1
        string word = ""
        bool closed = false
        while position < int(len(line))
            string character = line[position]
            position += 1
            if character == DQ
                closed = true
                break
            if character == Backslash
                if position == int(len(line))
                    return none
                character = line[position]
                position += 1
                if character != Backslash and character != DQ
                    return none
            word += character
        if not closed or (position < int(len(line)) and line[position] != " ")
            return none
        words = words.append(word)
    return words

int | none parse_integer(string text)
    if text == "0"
        return 0
    int start = if text.starts_with("-") then 1 else 0
    int digits = int(len(text)) - start
    if not (1 <= digits <= 9)
        return none
    if not "123456789".contains(text[start])
        return none
    for start <= int position < int(len(text))
        if not "0123456789".contains(text[position])
            return none
    return int.parse(text)

int | error integer(string text)
    match parse_integer(text)
        int value
            return value
        none
            return error(NotInteger)

int | error incremented(int previous, int delta)
    int result = previous + delta
    if not (-999999999 <= result <= 999999999)
        return error("ERR increment or decrement would overflow")
    return result

int or_zero(int | none possible)
    match possible
        int value
            return value
        none
            return 0

class Selection(int start, int end)

Selection normalized(int count, int first, int last)
    int start = math.max(0, if first < 0 then first + count else first)
    int stop = math.min(count - 1, if last < 0 then last + count else last)
    return if start <= stop then Selection(start, stop + 1) else Selection(0, 0)

class ScoreBound(int infinity, int value = 0, bool exclusive = false)
    bool accepts(int score, bool lower)
        if infinity != 0
            return lower == (infinity < 0)
        return (if lower then score > value else score < value) or (not exclusive and score == value)

ScoreBound | error score_bound(string text)
    if text == "-inf"
        return ScoreBound(-1)
    if text == "+inf"
        return ScoreBound(1)
    bool exclusive = text.starts_with("(")
    match parse_integer(if exclusive then text[1:] else text)
        int value
            return ScoreBound(0, value, exclusive)
        none
            return error("ERR min or max is not a float")

enum PatternPart
    Literal(string)
    Any
    Star
    Class((bool[], bool))

PatternPart[] | error parse_pattern(string text)
    PatternPart[] parts = []
    int position = 0
    while position < int(len(text))
        string character = text[position]
        position += 1
        if character == Backslash
            if position == int(len(text))
                return error("ERR invalid pattern")
            parts = parts.append(PatternPart.Literal(text[position]))
            position += 1
        elif character == "["
            int end = position
            while end < int(len(text)) and text[end] != "]"
                end += 1
            if end == int(len(text))
                return error("ERR invalid pattern")
            bool negated = position < end and text[position] == "^"
            if negated
                position += 1
            if position == end
                return error("ERR invalid pattern")
            bool[] characters = array(128, fill = false)
            while position < end
                int first = text[position].codepoints()[0]
                if position + 2 < end and text[position + 1] == "-"
                    int last = text[position + 2].codepoints()[0]
                    for math.min(first, last) <= int code <= math.max(first, last)
                        characters[code] = true
                    position += 3
                else
                    characters[first] = true
                    position += 1
            parts = parts.append(PatternPart.Class((characters, negated)))
            position = end + 1
        elif character == "*"
            parts = parts.append(PatternPart.Star)
        elif character == "?"
            parts = parts.append(PatternPart.Any)
        else
            parts = parts.append(PatternPart.Literal(character))
    return parts

bool matches(const PatternPart[] parts, string text)
    bool[] previous = array(len(text) + 1, fill = false)
    previous[0] = true
    for PatternPart part = parts[]
        bool[] following = array(len(previous), fill = false)
        match part
            PatternPart.Star
                following[0] = previous[0]
                for 1 <= nat position < len(following)
                    following[position] = previous[position] or following[position - 1]
            PatternPart.Any
                for nat position < len(text)
                    following[position + 1] = previous[position]
            PatternPart.Literal(character)
                for nat position < len(text)
                    following[position + 1] = previous[position] and text[position] == character
            PatternPart.Class(description)
                (bool[] characters, bool negated) = description
                for nat position < len(text)
                    following[position + 1] = previous[position] and characters[text[position].codepoints()[0]] != negated
        previous = following
    return previous[len(text)]

enum Value
    Text(string)
    List(string[])
    Hash(map.Map<string, string>)
    Set(set.Set<string>)
    Zset(map.Map<string, int>)

string value_kind(const Value content)
    match content
        Value.Text
            return "string"
        Value.List
            return "list"
        Value.Hash
            return "hash"
        Value.Set
            return "set"
        Value.Zset
            return "zset"

bool empty_value(const Value content)
    match content
        Value.Text
            return false
        Value.List(items)
            return len(items) == 0
        Value.Hash(fields)
            return fields.size() == 0
        Value.Set(members)
            return members.size() == 0
        Value.Zset(scores)
            return scores.size() == 0

class Entry(Value content, int | none expiry = none)
class Store()
    map.Map<string, Entry> database = map.Map<string, Entry>()
    map.Map<string, Entry>[] stack = []
    map.Map<string, map.Map<string, Entry>> snapshots = map.Map<string, map.Map<string, Entry>>()
    int clock = 0

V | error required<K, V>(const map.Map<K, V> values, K key)
    match values.get(key)
        V item
            return item
        none
            return error("missing internal value")

Value read_value(const Store source, string key, Value fallback)
    match source.database.get(key)
        Entry record
            return record.content
        none
            return fallback

string | error text_value(const Store source, string key)
    match read_value(source, key, Value.Text(""))
        Value.Text(text)
            return text
        Value.List
            return error(WrongType)
        Value.Hash
            return error(WrongType)
        Value.Set
            return error(WrongType)
        Value.Zset
            return error(WrongType)

string[] | error list_value(const Store source, string key)
    match read_value(source, key, Value.List([]))
        Value.Text
            return error(WrongType)
        Value.List(items)
            return items
        Value.Hash
            return error(WrongType)
        Value.Set
            return error(WrongType)
        Value.Zset
            return error(WrongType)

map.Map<string, string> | error hash_value(const Store source, string key)
    match read_value(source, key, Value.Hash(map.Map<string, string>()))
        Value.Text
            return error(WrongType)
        Value.List
            return error(WrongType)
        Value.Hash(fields)
            return fields
        Value.Set
            return error(WrongType)
        Value.Zset
            return error(WrongType)

set.Set<string> | error set_value(const Store source, string key)
    match read_value(source, key, Value.Set(set.Set<string>()))
        Value.Text
            return error(WrongType)
        Value.List
            return error(WrongType)
        Value.Hash
            return error(WrongType)
        Value.Set(members)
            return members
        Value.Zset
            return error(WrongType)

map.Map<string, int> | error zset_value(const Store source, string key)
    match read_value(source, key, Value.Zset(map.Map<string, int>()))
        Value.Text
            return error(WrongType)
        Value.List
            return error(WrongType)
        Value.Hash
            return error(WrongType)
        Value.Set
            return error(WrongType)
        Value.Zset(scores)
            return scores

void replace_value(Store &source, string key, Value content, int | none expiry = none)
    if empty_value(content)
        .source.database.remove(key)
    else
        .source.database.set(key, Entry(content, expiry))

void update_value(Store &source, string key, Value content)
    int | none expiry = none
    match source.database.get(key)
        Entry record
            expiry = record.expiry
        none
            void
    replace_value(&source, key, content, expiry)

int purge(Store &source)
    int removed = 0
    for string key = source.database.keys()[]
        Entry record = required(source.database, key)
        match record.expiry
            int deadline
                if deadline <= source.clock
                    .source.database.remove(key)
                    removed += 1
            none
                void
    return removed

class Arity(int minimum, int maximum, int parity = -1)
    bool accepts(int count)
        return count >= minimum and (maximum < 0 or count <= maximum) and (parity < 0 or count % 2 == parity)

Arity | none command_arity(string command)
    if one_of("TIME DBSIZE FLUSH INFO BEGIN COMMIT ROLLBACK", command)
        return Arity(0, 0)
    if one_of("GET INCR DECR STRLEN LLEN HGETALL HLEN HKEYS HVALS SMEMBERS SCARD ZCARD TYPE KEYS TTL PERSIST TICK SNAPSHOT RESTORE", command)
        return Arity(1, 1)
    if one_of("INCRBY DECRBY APPEND LINDEX HGET HEXISTS SISMEMBER ZSCORE ZRANK RENAME RENAMENX", command)
        return Arity(2, 2)
    if one_of("GETRANGE LRANGE LSET LREM LTRIM HINCRBY ZINCRBY", command)
        return Arity(3, 3)
    if command == "LINSERT"
        return Arity(4, 4)
    if one_of("LPOP RPOP", command)
        return Arity(1, 2)
    if command == "EXPIRE"
        return Arity(2, 3)
    if one_of("ZRANGE ZRANGEBYSCORE", command)
        return Arity(3, 4)
    if one_of("MGET SINTER SUNION SDIFF DEL EXISTS", command)
        return Arity(1, -1)
    if one_of("SET LPUSH RPUSH HDEL SADD SREM ZREM SINTERSTORE SUNIONSTORE SDIFFSTORE", command)
        return Arity(2, -1)
    if command == "MSET"
        return Arity(2, -1, 0)
    if one_of("HSET ZADD", command)
        return Arity(3, -1, 1)
    return none

string | error set_text(Store &source, const string[] arguments)
    string key = arguments[0]
    set.Set<string> options = set.Set<string>()
    string seconds_text = ""
    int index = 2
    while index < int(len(arguments))
        string option = uppercase(arguments[index])
        index += 1
        if not one_of("NX XX EX KEEPTTL GET", option) or options.has(option)
            return error("ERR syntax error")
        .options.add(option)
        if option == "EX"
            if index == int(len(arguments))
                return error("ERR syntax error")
            seconds_text = arguments[index]
            index += 1
    if (options.has("NX") and options.has("XX")) or (options.has("EX") and options.has("KEEPTTL"))
        return error("ERR syntax error")
    int | none expiry = none
    if options.has("EX")
        int seconds = try integer(seconds_text)
        if seconds <= 0
            return error("ERR invalid expire time in 'set' command")
        expiry = source.clock + seconds
    string | none old_text = none
    if options.has("GET")
        string previous = try text_value(source, key)
        if source.database.has(key)
            old_text = previous
    bool exists = source.database.has(key)
    bool blocked = (options.has("NX") and exists) or (options.has("XX") and not exists)
    if not blocked
        if options.has("KEEPTTL") and exists
            Entry original = required(source.database, key)
            expiry = original.expiry
        replace_value(&source, key, Value.Text(arguments[1]), expiry)
    if options.has("GET")
        return quoted(old_text)
    return if blocked then "(nil)" else "OK"

string | error string_command(Store &source, string command, const string[] arguments)
    string key = arguments[0]
    if command == "SET"
        return try set_text(&source, arguments)
    if command == "MSET"
        for 0 <= int index < int(len(arguments)) step 2
            replace_value(&source, arguments[index], Value.Text(arguments[index + 1]))
        return "OK"
    if command == "MGET"
        string[] items = []
        for string sought = arguments[]
            string reply = "(nil)"
            match source.database.get(sought)
                Entry record
                    if value_kind(record.content) == "string"
                        string text = text_value(source, sought)
                        reply = quoted(text)
                none
                    void
            items = items.append(reply)
        return array_items(items)
    if one_of("INCR DECR INCRBY DECRBY", command)
        int delta = 1
        if len(arguments) == 2
            delta = try integer(arguments[1])
        if command.starts_with("DECR")
            delta = -delta
        string previous = try text_value(source, key)
        int old_number = 0
        if source.database.has(key)
            old_number = try integer(previous)
        int result = try incremented(old_number, delta)
        update_value(&source, key, Value.Text(result.string()))
        return integer_reply(result)
    if command == "APPEND"
        string result = (try text_value(source, key)) + arguments[1]
        update_value(&source, key, Value.Text(result))
        return integer_reply(int(len(result)))
    if command == "GETRANGE"
        int first = try integer(arguments[1])
        int last = try integer(arguments[2])
        string text = try text_value(source, key)
        Selection selected = normalized(int(len(text)), first, last)
        return quoted(text[selected.start:<selected.end])
    string text = try text_value(source, key)
    if command == "STRLEN"
        return integer_reply(int(len(text)))
    return if source.database.has(key) then quoted(text) else "(nil)"

string | error list_command(Store &source, string command, const string[] arguments)
    string key = arguments[0]
    if one_of("LPUSH RPUSH", command)
        string[] items = try list_value(source, key)
        string[] added = arguments[1:]
        if command == "LPUSH"
            items = added[::-1].concat(items)
        else
            items = items.concat(added)
        update_value(&source, key, Value.List(items))
        return integer_reply(int(len(items)))
    if one_of("LPOP RPOP", command)
        int count = 1
        bool explicit_count = len(arguments) == 2
        if explicit_count
            match parse_integer(arguments[1])
                int parsed
                    if parsed < 0
                        return error(Positive)
                    count = parsed
                none
                    return error(Positive)
        string[] items = try list_value(source, key)
        if not source.database.has(key)
            return "(nil)"
        count = math.min(count, int(len(items)))
        string[] removed = []
        if command == "LPOP"
            removed = items[0:<count]
            items = items[count:]
        else
            int end = int(len(items)) - count
            removed = items[end:][::-1]
            items = items[0:<end]
        update_value(&source, key, Value.List(items))
        return if explicit_count then array_reply(removed) else quoted(removed[0])
    if one_of("LRANGE LTRIM", command)
        int first = try integer(arguments[1])
        int last = try integer(arguments[2])
        string[] items = try list_value(source, key)
        Selection selected = normalized(int(len(items)), first, last)
        string[] kept = items[selected.start:<selected.end]
        if command == "LRANGE"
            return array_reply(kept)
        update_value(&source, key, Value.List(kept))
        return "OK"
    if command == "LLEN"
        string[] items = try list_value(source, key)
        return integer_reply(int(len(items)))
    if one_of("LINDEX LSET", command)
        int index = try integer(arguments[1])
        string[] items = try list_value(source, key)
        if command == "LSET" and not source.database.has(key)
            return error("ERR no such key")
        if index < 0
            index += int(len(items))
        if not (0 <= index < int(len(items)))
            return if command == "LINDEX" then "(nil)" else error("ERR index out of range")
        if command == "LINDEX"
            return quoted(items[index])
        items[index] = arguments[2]
        update_value(&source, key, Value.List(items))
        return "OK"
    if command == "LREM"
        int count = try integer(arguments[1])
        string[] items = try list_value(source, key)
        if count < 0
            items = items[::-1]
        string[] kept = []
        int removed = 0
        for string item = items[]
            if item == arguments[2] and (count == 0 or removed < math.abs(count))
                removed += 1
            else
                kept = kept.append(item)
        if count < 0
            kept = kept[::-1]
        update_value(&source, key, Value.List(kept))
        return integer_reply(removed)
    string where = uppercase(arguments[1])
    if not one_of("BEFORE AFTER", where)
        return error("ERR syntax error")
    string[] items = try list_value(source, key)
    if len(items) == 0
        return integer_reply(0)
    for nat index = items.indices()[]
        if items[index] == arguments[2]
            nat position = index + (if where == "AFTER" then 1 else 0)
            items = items[0:<position].append(arguments[3]).concat(items[position:])
            update_value(&source, key, Value.List(items))
            return integer_reply(int(len(items)))
    return integer_reply(-1)

string | error hash_command(Store &source, string command, const string[] arguments)
    string key = arguments[0]
    int delta = 0
    if command == "HINCRBY"
        delta = try integer(arguments[2])
    map.Map<string, string> fields = try hash_value(source, key)
    if command == "HINCRBY"
        int previous = 0
        match fields.get(arguments[1])
            string old_text
                match parse_integer(old_text)
                    int parsed
                        previous = parsed
                    none
                        return error("ERR hash value is not an integer")
            none
                void
        int result = try incremented(previous, delta)
        .fields.set(arguments[1], result.string())
        update_value(&source, key, Value.Hash(fields))
        return integer_reply(result)
    if command == "HSET"
        int added = 0
        for 1 <= int index < int(len(arguments)) step 2
            if not fields.has(arguments[index])
                added += 1
            .fields.set(arguments[index], arguments[index + 1])
        update_value(&source, key, Value.Hash(fields))
        return integer_reply(added)
    if command == "HDEL"
        int removed = 0
        for string field = arguments[1:][]
            bool existed = .fields.remove(field)
            if existed
                removed += 1
        update_value(&source, key, Value.Hash(fields))
        return integer_reply(removed)
    if command == "HGET"
        return quoted(fields.get(arguments[1]))
    if command == "HEXISTS"
        return integer_reply(if fields.has(arguments[1]) then 1 else 0)
    if command == "HLEN"
        return integer_reply(int(fields.size()))
    string[] names = fields.keys().sorted()
    if command == "HKEYS"
        return array_reply(names)
    string[] items = []
    for string field = names[]
        if command == "HGETALL"
            items = items.append(field)
        string text = required(fields, field)
        items = items.append(text)
    return array_reply(items)

string | error set_command(Store &source, string command, const string[] arguments)
    string key = arguments[0]
    if command.starts_with("SINTER") or command.starts_with("SUNION") or command.starts_with("SDIFF")
        bool saving = command.ends_with("STORE")
        int start = if saving then 1 else 0
        set.Set<string>[] sources = []
        for string name = arguments[start:][]
            set.Set<string> members = try set_value(source, name)
            sources = sources.append(members)
        set.Set<string> result = sources[0]
        for set.Set<string> other = sources[1:][]
            if command.starts_with("SUNION")
                for string member = other.values()[]
                    .result.add(member)
            else
                for string member = result.values()[]
                    bool remove_member = if command.starts_with("SINTER") then not other.has(member) else other.has(member)
                    if remove_member
                        .result.remove(member)
        if saving
            replace_value(&source, key, Value.Set(result))
            return integer_reply(int(result.size()))
        return array_reply(result.values().sorted())
    set.Set<string> members = try set_value(source, key)
    if command == "SADD" or command == "SREM"
        int changed = 0
        for string member = arguments[1:][]
            if command == "SADD"
                if not members.has(member)
                    .members.add(member)
                    changed += 1
            else
                bool existed = .members.remove(member)
                if existed
                    changed += 1
        update_value(&source, key, Value.Set(members))
        return integer_reply(changed)
    if command == "SCARD"
        return integer_reply(int(members.size()))
    if command == "SISMEMBER"
        return integer_reply(if members.has(arguments[1]) then 1 else 0)
    return array_reply(members.values().sorted())

string[] zordered(const map.Map<string, int> scores)
    map.Map<int, string[]> groups = map.Map<int, string[]>()
    for string member = scores.keys().sorted()[]
        int score = required(scores, member)
        string[] same_score = []
        match groups.get(score)
            string[] previous
                same_score = previous
            none
                void
        .groups.set(score, same_score.append(member))
    string[] result = []
    for int score = groups.keys().sorted()[]
        string[] members = required(groups, score)
        result = result.concat(members)
    return result

string | error zset_command(Store &source, string command, const string[] arguments)
    string key = arguments[0]
    if command == "ZADD"
        int[] parsed = []
        for 1 <= int index < int(len(arguments)) step 2
            int score = try integer(arguments[index])
            parsed = parsed.append(score)
        map.Map<string, int> scores = try zset_value(source, key)
        int added = 0
        for nat index = parsed.indices()[]
            string member = arguments[2 * index + 2]
            if not scores.has(member)
                added += 1
            .scores.set(member, parsed[index])
        update_value(&source, key, Value.Zset(scores))
        return integer_reply(added)
    if command == "ZINCRBY"
        int delta = try integer(arguments[1])
        map.Map<string, int> scores = try zset_value(source, key)
        int result = try incremented(or_zero(scores.get(arguments[2])), delta)
        .scores.set(arguments[2], result)
        update_value(&source, key, Value.Zset(scores))
        return quoted(result.string())
    bool with_scores = false
    int first = 0
    int last = 0
    auto minimum = ScoreBound(-1)
    auto maximum = ScoreBound(1)
    if command == "ZRANGE" or command == "ZRANGEBYSCORE"
        with_scores = len(arguments) == 4
        if with_scores and uppercase(arguments[3]) != "WITHSCORES"
            return error("ERR syntax error")
        if command == "ZRANGE"
            first = try integer(arguments[1])
            last = try integer(arguments[2])
        else
            minimum = try score_bound(arguments[1])
            maximum = try score_bound(arguments[2])
    map.Map<string, int> scores = try zset_value(source, key)
    if command == "ZREM"
        int removed = 0
        for string member = arguments[1:][]
            bool existed = .scores.remove(member)
            if existed
                removed += 1
        update_value(&source, key, Value.Zset(scores))
        return integer_reply(removed)
    if command == "ZCARD"
        return integer_reply(int(scores.size()))
    if command == "ZSCORE"
        match scores.get(arguments[1])
            int score
                return quoted(score.string())
            none
                return "(nil)"
    string[] ordered = zordered(scores)
    if command == "ZRANK"
        for nat index = ordered.indices()[]
            if ordered[index] == arguments[1]
                return integer_reply(int(index))
        return "(nil)"
    if command == "ZRANGE"
        Selection selected = normalized(int(len(ordered)), first, last)
        ordered = ordered[selected.start:<selected.end]
    string[] items = []
    for string member = ordered[]
        int score = required(scores, member)
        if command == "ZRANGEBYSCORE" and (not minimum.accepts(score, true) or not maximum.accepts(score, false))
            continue
        items = items.append(member)
        if with_scores
            items = items.append(score.string())
    return array_reply(items)

string | error key_command(Store &source, string command, const string[] arguments)
    if command == "TIME"
        return integer_reply(source.clock)
    if command == "DBSIZE"
        return integer_reply(int(source.database.size()))
    if command == "FLUSH"
        source.database = map.Map<string, Entry>()
        return "OK"
    if command == "INFO"
        int[] counts = array(5, fill = 0)
        int expires = 0
        string[] names = ["string", "list", "hash", "set", "zset"]
        for Entry record = source.database.values()[]
            for nat index = names.indices()[]
                if value_kind(record.content) == names[index]
                    counts[index] += 1
            match record.expiry
                int
                    expires += 1
                none
                    void
        return "keys={source.database.size()},expires={expires},string={counts[0]},list={counts[1]},hash={counts[2]},set={counts[3]},zset={counts[4]},time={source.clock},depth={len(source.stack)},snapshots={source.snapshots.size()}"
    if command == "DEL" or command == "EXISTS"
        int count = 0
        for string key = arguments[]
            bool exists = source.database.has(key)
            if command == "DEL"
                .source.database.remove(key)
            if exists
                count += 1
        return integer_reply(count)
    if command == "KEYS"
        PatternPart[] parts = try parse_pattern(arguments[0])
        return array_reply([for string key = source.database.keys().sorted()[] if matches(parts, key) then key])
    if command == "TICK"
        int ticks = try integer(arguments[0])
        if ticks <= 0
            return error(Positive)
        source.clock += ticks
        return integer_reply(purge(&source))
    string key = arguments[0]
    if command == "EXPIRE"
        string condition = if len(arguments) == 3 then uppercase(arguments[2]) else ""
        if len(arguments) == 3 and not one_of("NX XX GT LT", condition)
            return error("ERR Unsupported option " + arguments[2])
        int seconds = try integer(arguments[1])
        if not source.database.has(key)
            return integer_reply(0)
        Entry record = required(source.database, key)
        int deadline = source.clock + seconds
        bool rejected = false
        match record.expiry
            int previous
                rejected = condition == "NX" or (condition == "GT" and deadline <= previous) or (condition == "LT" and deadline >= previous)
            none
                rejected = condition == "XX" or condition == "GT"
        if rejected
            return integer_reply(0)
        if seconds <= 0
            .source.database.remove(key)
        else
            .source.database.set(key, Entry(record.content, deadline))
        return integer_reply(1)
    match source.database.get(key)
        none
            if command == "TYPE"
                return "none"
            if command == "TTL"
                return integer_reply(-2)
            if command == "PERSIST"
                return integer_reply(0)
            return error("ERR no such key")
        Entry record
            if command == "TYPE"
                return value_kind(record.content)
            if command == "TTL"
                match record.expiry
                    int deadline
                        return integer_reply(deadline - source.clock)
                    none
                        return integer_reply(-1)
            if command == "PERSIST"
                match record.expiry
                    int
                        .source.database.set(key, Entry(record.content))
                        return integer_reply(1)
                    none
                        return integer_reply(0)
            string destination = arguments[1]
            if command == "RENAMENX" and source.database.has(destination)
                return integer_reply(0)
            if key != destination
                .source.database.remove(key)
                .source.database.set(destination, record)
            return if command == "RENAME" then "OK" else integer_reply(1)

string | error control_command(Store &source, string command, const string[] arguments)
    if command == "BEGIN"
        source.stack = source.stack.append(source.database)
    elif command == "COMMIT" or command == "ROLLBACK"
        if len(source.stack) == 0
            return error("ERR no transaction")
        nat top = len(source.stack) - 1
        if command == "ROLLBACK"
            source.database = source.stack[top]
            purge(&source)
        source.stack = source.stack[0:<top]
    elif command == "SNAPSHOT"
        .source.snapshots.set(arguments[0], source.database)
    else
        match source.snapshots.get(arguments[0])
            map.Map<string, Entry> saved
                source.database = saved
                purge(&source)
            none
                return error("ERR no such snapshot")
    return "OK"

string | error execute(Store &source, string command, const string[] arguments)
    if one_of("SET GET MSET MGET INCR DECR INCRBY DECRBY APPEND STRLEN GETRANGE", command)
        return try string_command(&source, command, arguments)
    if one_of("LPUSH RPUSH LPOP RPOP LRANGE LLEN LINDEX LSET LREM LTRIM LINSERT", command)
        return try list_command(&source, command, arguments)
    if one_of("HSET HGET HDEL HGETALL HLEN HEXISTS HKEYS HVALS HINCRBY", command)
        return try hash_command(&source, command, arguments)
    if one_of("SADD SREM SISMEMBER SMEMBERS SCARD SINTER SUNION SDIFF SINTERSTORE SUNIONSTORE SDIFFSTORE", command)
        return try set_command(&source, command, arguments)
    if one_of("ZADD ZSCORE ZINCRBY ZREM ZCARD ZRANK ZRANGE ZRANGEBYSCORE", command)
        return try zset_command(&source, command, arguments)
    if one_of("BEGIN COMMIT ROLLBACK SNAPSHOT RESTORE", command)
        return try control_command(&source, command, arguments)
    return try key_command(&source, command, arguments)

auto database_store = Store()
int command_count
scan(&command_count)
for int command_index < command_count
    string line
    scan(&line)
    match split_line(line)
        none
            print("Invalid argument(s)" + NL)
        string[] words
            string command = uppercase(words[0])
            match command_arity(command)
                none
                    print("(error) ERR unknown command '" + words[0] + "'" + NL)
                Arity format
                    if not format.accepts(int(len(words)) - 1)
                        print("(error) ERR wrong number of arguments for '" + lowercase(command) + "' command" + NL)
                    else
                        match execute(&database_store, command, words[1:])
                            string output
                                print(output + NL)
                            error problem
                                print("(error) " + problem.message + NL)
