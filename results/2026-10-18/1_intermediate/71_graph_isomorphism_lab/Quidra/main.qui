int compare_text(string first, string second)
    int[] left = first.codepoints()
    int[] right = second.codepoints()
    for nat i < len(left)
        if i == len(right)
            return 1
        if left[i] != right[i]
            return if left[i] < right[i] then -1 else 1
    return if len(left) < len(right) then -1 else 0

void emit(string text)
    print(text + NL)

string numbers(nat[] items)
    return [for nat item = items[] then item.string()].join(" ")

string yes_no(bool value)
    return if value then "yes" else "no"

bool includes(nat[] items, nat value)
    for nat item = items[]
        if item == value
            return true
    return false

nat[] distinct(nat[] items)
    nat[] result = []
    for nat item = items.sorted()[]
        if len(result) == 0 or result[len(result) - 1] != item
            result = result.append(item)
    return result

bool lex_less(nat[] first, nat[] second)
    for nat i < len(first)
        if i == len(second)
            return false
        if first[i] != second[i]
            return first[i] < second[i]
    return len(first) < len(second)

class Edge(nat u, nat v)

class Graph(nat n)
    bool[][] adj = array(n, fill = array(n, fill = false))

    void .connect(nat u, nat v)
        adj[u][v] = true
        adj[v][u] = true

    Edge[] edges()
        Edge[] result = []
        for nat u < n
            for u + 1 <= nat v < n
                if adj[u][v]
                    result = result.append(Edge(u, v))
        return result

    nat[] degrees()
        return [for nat u < n then len([for nat v < n if adj[u][v] then v])]

    int[] distances(nat root)
        int[] result = array(n, fill = -1)
        result[root] = 0
        nat[] queue = [root]
        nat at = 0
        while at < len(queue)
            nat u = queue[at]
            at += 1
            for nat v < n
                if adj[u][v] and result[v] < 0
                    result[v] = result[u] + 1
                    queue = queue.append(v)
        return result

class Info(nat n, nat m, nat[] degrees, nat triangles, nat[] sizes, string girth, string diameter, string radius, string bipartite)

Info graph_info(Graph graph)
    bool[] seen = array(graph.n, fill = false)
    nat[] sizes = []
    nat[] eccentricities = []
    nat shortest = 0
    bool bipartite = true
    Edge[] edges = graph.edges()
    for nat root < graph.n
        int[] d = graph.distances(root)
        nat eccentricity = 0
        nat size = 0
        for nat v < graph.n
            if d[v] >= 0
                eccentricity = if nat(d[v]) > eccentricity then nat(d[v]) else eccentricity
                size += 1
        eccentricities = eccentricities.append(eccentricity)
        if not seen[root]
            sizes = sizes.append(size)
            for nat v < graph.n
                if d[v] >= 0
                    seen[v] = true
        for Edge edge = edges[]
            if d[edge.u] >= 0 and d[edge.v] >= 0 and (d[edge.u] - d[edge.v]) % 2 == 0
                bipartite = false
        int[] depth = array(graph.n, fill = -1)
        int[] parents = array(graph.n, fill = -1)
        depth[root] = 0
        nat[] queue = [root]
        nat at = 0
        while at < len(queue)
            nat u = queue[at]
            at += 1
            for nat v < graph.n
                if graph.adj[u][v]
                    if depth[v] < 0
                        depth[v] = depth[u] + 1
                        parents[v] = int(u)
                        queue = queue.append(v)
                    elif int(v) != parents[u]
                        nat length = nat(depth[u] + depth[v] + 1)
                        if shortest == 0 or length < shortest
                            shortest = length
    nat triangles = 0
    for Edge edge = edges[]
        for edge.v + 1 <= nat w < graph.n
            if graph.adj[edge.u][w] and graph.adj[edge.v][w]
                triangles += 1
    nat[] degrees = graph.degrees().sorted()
    sizes = sizes.sorted()
    eccentricities = eccentricities.sorted()
    return Info(graph.n, len(edges), degrees[::-1], triangles, sizes[::-1], if shortest == 0 then "none" else shortest.string(), if len(sizes) == 1 then eccentricities[len(eccentricities) - 1].string() else "INF", if len(sizes) == 1 then eccentricities[0].string() else "INF", yes_no(bipartite))

nat[] degree_colors(Graph graph)
    nat[] degrees = graph.degrees()
    nat[] ordered = distinct(degrees)
    return [for nat degree = degrees[] then len([for nat other = ordered[] if other < degree then other])]

class Refinement(nat[] colors, nat rounds)

Refinement refine(Graph graph, nat[] initial)
    nat[] colors = initial
    nat rounds = 0
    while true
        nat[][] signatures = []
        for nat v < graph.n
            nat[] neighbors = [for nat w < graph.n if graph.adj[v][w] then colors[w]]
            signatures = signatures.append([colors[v]].concat(neighbors.sorted()))
        nat[] representatives = []
        for nat v < graph.n
            bool found = false
            for nat w = representatives[]
                if signatures[v] == signatures[w]
                    found = true
                    break
            if not found
                representatives = representatives.append(v)
        nat[] next = []
        for nat v < graph.n
            next = next.append(len([for nat w = representatives[] if lex_less(signatures[w], signatures[v]) then w]))
        if len(representatives) == len(distinct(colors))
            return Refinement(colors, rounds)
        colors = next
        rounds += 1

Refinement stable(Graph graph)
    return refine(graph, degree_colors(graph))

nat[] individualize(nat[] colors, nat vertex)
    return [for nat color = colors[nat w] then if color < colors[vertex] or w == vertex then color else color + 1]

nat[][] cells(nat[] colors)
    return [for nat color < len(distinct(colors)) then [for nat v < len(colors) if colors[v] == color then v]]

string leaf_string(Graph graph, nat[] labels)
    nat[] inverse = array(graph.n, fill = 0)
    for nat v < graph.n
        inverse[labels[v]] = v
    string result = ""
    for nat u < graph.n
        for u + 1 <= nat v < graph.n
            result += if graph.adj[inverse[u]][inverse[v]] then "1" else "0"
    return result

class CanonicalSearch(Graph graph)
    nat nodes = 0
    nat leaves = 0
    string text = ""
    nat[] labels = []
    nat[][] best = []

    void .visit(nat[] colors)
        nodes += 1
        if len(distinct(colors)) == graph.n
            leaves += 1
            string candidate = leaf_string(graph, colors)
            if len(best) == 0 or compare_text(candidate, text) > 0
                text = candidate
                labels = colors
                best = [colors]
            elif candidate == text
                best = best.append(colors)
            return
        nat[] chosen = []
        for nat[] cell = cells(colors)[]
            if len(cell) > 1 and (len(chosen) == 0 or len(cell) < len(chosen))
                chosen = cell
        for nat vertex = chosen[]
            .visit(refine(graph, individualize(colors, vertex)).colors)

CanonicalSearch canonical(Graph graph)
    auto search = CanonicalSearch(graph)
    .search.visit(stable(graph).colors)
    return search

class CliqueSearch(Graph graph)
    nat[] best = []

    void .search_branch(nat[] chosen, nat[] candidates)
        if len(chosen) > len(best)
            best = chosen
        for nat vertex = candidates[]
            .search_branch(chosen.append(vertex), [for nat next = candidates[] if next > vertex and graph.adj[vertex][next] then next])

class ColoringSearch(Graph graph, nat limit)
    nat[] colors = []

    bool .search_branch(nat used)
        nat vertex = len(colors)
        if vertex == graph.n
            return true
        nat available = if used < limit then used + 1 else limit
        for nat color < available
            bool allowed = true
            for nat w < vertex
                if graph.adj[vertex][w] and colors[w] == color
                    allowed = false
                    break
            if allowed
                colors = colors.append(color)
                if .search_branch(if color + 1 > used then color + 1 else used)
                    return true
                colors = colors[:<len(colors) - 1]
        return false

void invariant_report(Graph graph, string name)
    Info info = graph_info(graph)
    emit("invariants {name}")
    emit("degrees {numbers(info.degrees)}")
    emit("edges {info.m} triangles {info.triangles}")
    emit("components {len(info.sizes)} sizes {numbers(info.sizes)}")
    emit("girth {info.girth} diameter {info.diameter} radius {info.radius}")
    emit("bipartite {info.bipartite}")
    if graph.n >= 13
        emit("clique -")
        emit("chromatic -")
        return
    auto clique_search = CliqueSearch(graph)
    .clique_search.search_branch([], [for nat v < graph.n then v])
    emit("clique {len(clique_search.best)} {numbers(clique_search.best)}")
    for len(clique_search.best) <= nat limit <= graph.n
        auto coloring_search = ColoringSearch(graph, limit)
        if .coloring_search.search_branch(0)
            emit("chromatic {limit} {numbers(coloring_search.colors)}")
            return

void iso_report(Graph first, Graph second)
    Info a = graph_info(first)
    Info b = graph_info(second)
    string difference = ""
    if a.n != b.n
        difference = "vertices {a.n} {b.n}"
    elif a.m != b.m
        difference = "edges {a.m} {b.m}"
    elif a.degrees != b.degrees
        difference = "degrees"
    elif a.triangles != b.triangles
        difference = "triangles {a.triangles} {b.triangles}"
    elif len(a.sizes) != len(b.sizes)
        difference = "components {len(a.sizes)} {len(b.sizes)}"
    elif a.girth != b.girth
        difference = "girth {a.girth} {b.girth}"
    elif a.diameter != b.diameter
        difference = "diameter {a.diameter} {b.diameter}"
    elif a.bipartite != b.bipartite
        difference = "bipartite {a.bipartite} {b.bipartite}"
    else
        Refinement x = stable(first)
        Refinement y = stable(second)
        if x.rounds != y.rounds or [for nat[] cell = cells(x.colors)[] then len(cell)] != [for nat[] cell = cells(y.colors)[] then len(cell)]
            difference = "refinement"
    if difference != ""
        emit("not isomorphic {difference}")
        return
    CanonicalSearch x = canonical(first)
    CanonicalSearch y = canonical(second)
    if x.text != y.text
        emit("not isomorphic canonical")
        return
    nat[] inverse = array(second.n, fill = 0)
    for nat v < second.n
        inverse[y.labels[v]] = v
    emit("isomorphic")
    emit("mapping {numbers(inverse[x.labels])}")

nat[][] automorphisms(Graph graph)
    CanonicalSearch form = canonical(graph)
    nat[] inverse = array(graph.n, fill = 0)
    for nat v < graph.n
        inverse[form.labels[v]] = v
    return [for nat[] leaf = form.best[] then inverse[leaf]]

void automorphism_report(Graph graph, string name)
    nat[][] permutations = automorphisms(graph)
    bool[] seen = array(graph.n, fill = false)
    nat[][] vertex_orbits = []
    for nat v < graph.n
        if not seen[v]
            nat[] orbit = distinct([for nat[] permutation = permutations[] then permutation[v]])
            for nat vertex = orbit[]
                seen[vertex] = true
            vertex_orbits = vertex_orbits.append(orbit)
    Edge[] edges = graph.edges()
    bool[] edge_seen = array(len(edges), fill = false)
    string[] edge_orbits = []
    for Edge edge = edges[nat i]
        if edge_seen[i]
            continue
        bool[] orbit = array(len(edges), fill = false)
        for nat[] permutation = permutations[]
            nat u = permutation[edge.u]
            nat v = permutation[edge.v]
            for Edge candidate = edges[nat j]
                if (candidate.u == u and candidate.v == v) or (candidate.u == v and candidate.v == u)
                    orbit[j] = true
        string[] words = []
        for Edge candidate = edges[nat j]
            if orbit[j]
                edge_seen[j] = true
                words = words.append("{candidate.u}-{candidate.v}")
        edge_orbits = edge_orbits.append(words.join(" "))
    emit("aut {name} order {len(permutations)}")
    emit("vertex orbits {len(vertex_orbits)}")
    for nat[] orbit = vertex_orbits[]
        emit("orbit {numbers(orbit)}")
    emit("edge orbits {len(edge_orbits)}")
    for string orbit = edge_orbits[]
        emit("orbit {orbit}")
    emit("transitive vertex {yes_no(len(vertex_orbits) == 1)} edge {yes_no(len(edge_orbits) == 1)}")

class Embedding(nat[] image, bool induced)
class EmbeddingSearch(Graph pattern, Graph target)
    nat total = 0
    nat induced = 0
    Embedding[] shown = []

    void .search_branch(nat[] image)
        nat vertex = len(image)
        if vertex == pattern.n
            bool exact = true
            for nat u < pattern.n
                for u + 1 <= nat v < pattern.n
                    if pattern.adj[u][v] != target.adj[image[u]][image[v]]
                        exact = false
            total += 1
            if exact
                induced += 1
            if len(shown) < 5
                shown = shown.append(Embedding(image, exact))
            return
        for nat next < target.n
            if includes(image, next)
                continue
            bool allowed = true
            for nat u < vertex
                if pattern.adj[vertex][u] and not target.adj[next][image[u]]
                    allowed = false
                    break
            if allowed
                .search_branch(image.append(next))

void subiso_report(Graph pattern, Graph target, string first, string second)
    auto search = EmbeddingSearch(pattern, target)
    .search.search_branch([])
    nat order = len(canonical(pattern).best)
    emit("subiso {first} {second} embeddings {search.total} induced {search.induced}")
    emit("copies {search.total / order} induced {search.induced / order}")
    for Embedding item = search.shown[]
        emit("embedding {numbers(item.image)}" + (if item.induced then " induced" else ""))

void | error size_check(nat value, nat minimum = 1, nat maximum = 16)
    if value < minimum
        return error("bad value")
    if value > maximum
        return error("too large")

void | error classify(nat size)
    try size_check(size, 1, 5)
    string[][] layers = [[canonical(Graph(size)).text]]
    nat edge_count = size * (size - 1) / 2
    nat total = 1
    for nat m < edge_count
        map.Map<string, bool> next
        for string text = layers[m][]
            auto graph = Graph(size)
            nat at = 0
            for nat u < size
                for u + 1 <= nat v < size
                    if text[at] == "1"
                        .graph.connect(u, v)
                    at += 1
            for nat u < size
                for u + 1 <= nat v < size
                    if not graph.adj[u][v]
                        Graph changed = graph
                        .changed.connect(u, v)
                        .next.set(canonical(changed).text, true)
        layers = layers.append(next.keys().sorted())
        total += next.size()
    emit("classify {size} total {total}")
    for string[] layer = layers[nat m]
        emit("edges {m} count {len(layer)} " + [for string text = layer[] then if text == "" then "-" else text].join(" "))

bool name_word(string word)
    if len(word) < 1 or len(word) > 8 or not "abcdefghijklmnopqrstuvwxyz".contains(word[0])
        return false
    for int code = word.codepoints()[]
        if not (code >= 97 and code <= 122) and not (code >= 48 and code <= 57)
            return false
    return true

bool number_word(string word)
    if len(word) < 1 or len(word) > 3 or (len(word) > 1 and word[0] == "0")
        return false
    for int code = word.codepoints()[]
        if code < 48 or code > 57
            return false
    return true

bool edge_word(string word)
    string[] parts = word.split("-")
    return len(parts) == 2 and number_word(parts[0]) and number_word(parts[1])

string[] schema(string command)
    if command == "GRAPH"
        return ["name", "number", "edge*"]
    if command == "CYCLE" or command == "PATH" or command == "COMPLETE" or command == "STAR" or command == "WHEEL" or command == "HYPERCUBE"
        return ["name", "number"]
    if command == "BIPARTITE" or command == "GRID"
        return ["name", "number", "number"]
    if command == "PETERSEN"
        return ["name"]
    if command == "CIRCULANT"
        return ["name", "number", "number+"]
    if command == "COMPLEMENT" or command == "LINE" or command == "CANONIZE"
        return ["name", "graph"]
    if command == "PRODUCT" or command == "UNION"
        return ["name", "graph", "graph"]
    if command == "RELABEL"
        return ["name", "graph", "number*"]
    if command == "INDUCED"
        return ["name", "graph", "number+"]
    if command == "DELETE" or command == "SHOW" or command == "INVARIANTS" or command == "CANON" or command == "AUT"
        return ["graph"]
    if command == "REFINE"
        return ["graph", "number*"]
    if command == "ISO" or command == "SUBISO"
        return ["graph", "graph"]
    if command == "CLASSIFY"
        return ["number"]
    return []

class Registry()
    map.Map<string, Graph> graphs

    Graph get_graph(string name)
        match graphs.get(name)
            Graph value
                return value
            none
                return Graph(1)

    void | error check_arguments(string command, string[] args)
        string[] format = schema(command)
        if len(format) == 0 and command != "LIST"
            return error("unknown command {command}")
        bool repeated = len(format) > 0 and (format[len(format) - 1].ends_with("*") or format[len(format) - 1].ends_with("+"))
        nat fixed = len(format) - (if repeated then 1 else 0)
        if (not repeated and len(args) != fixed) or (repeated and len(args) < fixed + (if format[len(format) - 1].ends_with("+") then 1 else 0))
            return error("bad arguments")
        for string word = args[nat i]
            string kind = if i < fixed then format[i] else format[len(format) - 1][:<len(format[len(format) - 1]) - 1]
            if (kind == "name" or kind == "graph") and not name_word(word)
                return error("bad arguments")
            if kind == "number" and not number_word(word)
                return error("bad arguments")
            if kind == "edge" and not edge_word(word)
                return error("bad arguments")
        for nat i < fixed
            if format[i] == "graph" and not graphs.has(args[i])
                return error("no graph {args[i]}")

    Graph | error build_graph(string command, string[] args)
        if command == "GRAPH" or command == "CYCLE" or command == "PATH" or command == "COMPLETE" or command == "CIRCULANT"
            nat size = nat.parse(args[1])
            try size_check(size, if command == "CYCLE" or command == "CIRCULANT" then 3 else 1)
            auto result = Graph(size)
            if command == "GRAPH"
                for string word = args[2:][]
                    string[] pair = word.split("-")
                    nat u = nat.parse(pair[0])
                    nat v = nat.parse(pair[1])
                    if u >= size or v >= size or u == v
                        return error("bad edge {word}")
                    if result.adj[u][v]
                        return error("duplicate edge {word}")
                    .result.connect(u, v)
            elif command == "CYCLE"
                for nat u < size
                    .result.connect(u, (u + 1) % size)
            elif command == "PATH"
                for 1 <= nat u < size
                    .result.connect(u - 1, u)
            elif command == "COMPLETE"
                for nat u < size
                    for u + 1 <= nat v < size
                        .result.connect(u, v)
            else
                nat previous = 0
                nat[] jumps = []
                for string word = args[2:][]
                    nat jump = nat.parse(word)
                    if jump == 0 or 2 * jump > size or jump <= previous
                        return error("bad value")
                    previous = jump
                    jumps = jumps.append(jump)
                for nat u < size
                    for nat jump = jumps[]
                        .result.connect(u, (u + jump) % size)
            return result
        if command == "BIPARTITE" or command == "GRID"
            nat a = nat.parse(args[1])
            nat b = nat.parse(args[2])
            if a == 0 or b == 0
                return error("bad value")
            nat size = if command == "GRID" then a * b else a + b
            try size_check(size)
            auto result = Graph(size)
            if command == "BIPARTITE"
                for nat u < a
                    for nat v < b
                        .result.connect(u, a + v)
            else
                for nat x < a
                    for nat y < b
                        nat u = x * b + y
                        if y + 1 < b
                            .result.connect(u, u + 1)
                        if x + 1 < a
                            .result.connect(u, u + b)
            return result
        if command == "STAR" or command == "WHEEL"
            nat k = nat.parse(args[1])
            try size_check(k, if command == "WHEEL" then 3 else 1, 15)
            auto result = Graph(k + 1)
            for 1 <= nat v <= k
                .result.connect(0, v)
            if command == "WHEEL"
                for 1 <= nat v <= k
                    .result.connect(v, v % k + 1)
            return result
        if command == "PETERSEN"
            auto result = Graph(10)
            for nat i < 5
                .result.connect(i, (i + 1) % 5)
                .result.connect(i, i + 5)
                .result.connect(i + 5, 5 + (i + 2) % 5)
            return result
        if command == "HYPERCUBE"
            nat dimension = nat.parse(args[1])
            try size_check(dimension, 1, 4)
            nat size = 2 ^ dimension
            auto result = Graph(size)
            for nat u < size
                for nat bit < dimension
                    nat power = 2 ^ bit
                    nat v = if (u / power) % 2 == 0 then u + power else u - power
                    .result.connect(u, v)
            return result
        Graph source = get_graph(args[1])
        nat size = source.n
        if command == "COMPLEMENT"
            auto result = Graph(size)
            for nat u < size
                for u + 1 <= nat v < size
                    if not source.adj[u][v]
                        .result.connect(u, v)
            return result
        if command == "LINE"
            Edge[] edges = source.edges()
            if len(edges) == 0
                return error("no edges")
            try size_check(len(edges))
            auto result = Graph(len(edges))
            for Edge a = edges[nat i]
                for i + 1 <= nat j < len(edges)
                    Edge b = edges[j]
                    if a.u == b.u or a.u == b.v or a.v == b.u or a.v == b.v
                        .result.connect(i, j)
            return result
        if command == "PRODUCT" or command == "UNION"
            Graph other = get_graph(args[2])
            nat count = if command == "PRODUCT" then size * other.n else size + other.n
            try size_check(count)
            auto result = Graph(count)
            if command == "PRODUCT"
                for Edge edge = source.edges()[]
                    for nat y < other.n
                        .result.connect(edge.u * other.n + y, edge.v * other.n + y)
                for Edge edge = other.edges()[]
                    for nat x < size
                        .result.connect(x * other.n + edge.u, x * other.n + edge.v)
            else
                for Edge edge = source.edges()[]
                    .result.connect(edge.u, edge.v)
                for Edge edge = other.edges()[]
                    .result.connect(edge.u + size, edge.v + size)
            return result
        if command == "RELABEL" or command == "CANONIZE"
            nat[] permutation = if command == "CANONIZE" then canonical(source).labels else [for string word = args[2:][] then nat.parse(word)]
            if permutation.sorted() != [for nat v < size then v]
                return error("bad permutation")
            auto result = Graph(size)
            for Edge edge = source.edges()[]
                .result.connect(permutation[edge.u], permutation[edge.v])
            return result
        nat[] selected = [for string word = args[2:][] then nat.parse(word)]
        for nat value = selected[]
            if value >= size
                return error("bad vertices")
        if len(distinct(selected)) != len(selected)
            return error("bad vertices")
        auto result = Graph(len(selected))
        for nat u < len(selected)
            for u + 1 <= nat v < len(selected)
                if source.adj[selected[u]][selected[v]]
                    .result.connect(u, v)
        return result

    void | error .execute(string line)
        string[] words = line.split(" ")
        string command = words[0]
        string[] args = words[1:]
        try check_arguments(command, args)
        string[] format = schema(command)
        if len(format) > 0 and format[0] == "name"
            Graph graph = try build_graph(command, args)
            bool existed = graphs.has(args[0])
            .graphs.set(args[0], graph)
            emit((if existed then "redefined" else "defined") + " {args[0]} n {graph.n} m {len(graph.edges())}")
        elif command == "LIST"
            emit("graphs {graphs.size()}")
            for string name = graphs.keys().sorted()[]
                Graph graph = get_graph(name)
                emit("{name} n {graph.n} m {len(graph.edges())}")
        elif command == "DELETE"
            bool removed = .graphs.remove(args[0])
            emit("deleted {args[0]}")
        elif command == "CLASSIFY"
            try classify(nat.parse(args[0]))
        else
            string name = args[0]
            Graph graph = get_graph(name)
            if command == "SHOW"
                emit("graph {name} n {graph.n} m {len(graph.edges())}")
                for nat v < graph.n
                    nat[] neighbors = [for nat w < graph.n if graph.adj[v][w] then w]
                    emit("{v}:" + (if len(neighbors) == 0 then "" else " {numbers(neighbors)}"))
            elif command == "INVARIANTS"
                invariant_report(graph, name)
            elif command == "CANON"
                CanonicalSearch form = canonical(graph)
                emit("canon {name} nodes {form.nodes} leaves {form.leaves}")
                emit("labels {numbers(form.labels)}")
                emit("string " + (if form.text == "" then "-" else form.text))
            elif command == "REFINE"
                nat[] selected = [for string word = args[1:][] then nat.parse(word)]
                for nat value = selected[]
                    if value >= graph.n
                        return error("bad vertices")
                Refinement result = stable(graph)
                for nat vertex = selected[]
                    if len([for nat color = result.colors[] if color == result.colors[vertex] then color]) == 1
                        return error("singleton {vertex}")
                    Refinement next = refine(graph, individualize(result.colors, vertex))
                    result = Refinement(next.colors, result.rounds + next.rounds)
                nat[][] groups = cells(result.colors)
                emit("refine {name} rounds {result.rounds} cells {len(groups)}")
                for nat[] cell = groups[nat color]
                    emit("{color}: {numbers(cell)}")
            elif command == "ISO"
                iso_report(graph, get_graph(args[1]))
            elif command == "AUT"
                automorphism_report(graph, name)
            elif command == "SUBISO"
                subiso_report(graph, get_graph(args[1]), name, args[1])

void run_program()
    nat count
    scan(&count)
    auto registry = Registry()
    for nat i < count
        string line
        scan(&line)
        match .registry.execute(line)
            void
                void
            error issue
                emit("error: {issue.message}")

run_program()
