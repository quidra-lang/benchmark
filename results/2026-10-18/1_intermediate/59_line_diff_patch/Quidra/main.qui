nat minimum(nat first, nat second)
    return if first < second then first else second

nat maximum(nat first, nat second)
    return if first > second then first else second

bool contains(const string[] words, string word)
    for auto candidate = words[]
        if candidate == word
            return true
    return false

void emit(string line)
    print("{line}{NL}")

void emit_all(const string[] lines)
    for auto line = lines[]
        emit(line)

string[] prefixed(string prefix, const string[] lines)
    return [for auto line = lines[] then prefix + line]

string range_r(nat start, nat count)
    if count >= 2
        return "{start + 1},{start + count}"
    if count == 1
        return "{start + 1}"
    return "{start}"

string range_u(nat start, nat count)
    if count >= 2
        return "{start + 1},{count}"
    if count == 1
        return "{start + 1}"
    return "{start},0"

string range_m(nat start, nat count)
    return "{start + 1},{count}"

string lower_character(string character)
    match "ABCDEFGHIJKLMNOPQRSTUVWXYZ".find(character)
        nat position
            return "abcdefghijklmnopqrstuvwxyz"[position]
        none
            return character

string comparison_key(string line, const string[] options)
    bool ignore_case = contains(options, "ICASE")
    bool ignore_white = contains(options, "IWHITE")
    bool ignore_space = contains(options, "ISPACE")
    string key = ""
    for nat index < len(line)
        string character = line[index]
        bool repeated = index > 0 and line[index - 1] == " "
        if character == " " and (ignore_white or (ignore_space and repeated))
            continue
        key += if ignore_case then lower_character(character) else character
    return key

(nat, nat)[] matched_pairs(const string[] first, const string[] second)
    nat rows = len(first)
    nat columns = len(second)
    nat[] empty_row = array(columns + 1, fill = 0)
    nat[][] table = array(rows + 1, fill = empty_row)
    for 1 <= nat i <= rows
        for 1 <= nat j <= columns
            if first[i - 1] == second[j - 1]
                table[i][j] = table[i - 1][j - 1] + 1
            else
                table[i][j] = maximum(table[i - 1][j], table[i][j - 1])
    (nat, nat)[] pairs = [(rows + 1, columns + 1)]
    nat i = rows
    nat j = columns
    while i >= 1 and j >= 1
        if first[i - 1] == second[j - 1]
            pairs = pairs.append((i, j))
            i -= 1
            j -= 1
        elif table[i - 1][j] >= table[i][j - 1]
            i -= 1
        else
            j -= 1
    pairs = pairs.append((0, 0))
    return pairs[:: -1]

class ChangeBlock(nat p, nat q, nat x, nat y)
    string letter()
        if x >= 1 and y >= 1
            return "c"
        return if y == 0 then "d" else "a"

ChangeBlock[] change_blocks(const string[] first, const string[] second)
    (nat, nat)[] pairs = matched_pairs(first, second)
    ChangeBlock[] blocks = []
    for 1 <= nat index < len(pairs)
        (nat i, nat j) = pairs[index - 1]
        (nat next_i, nat next_j) = pairs[index]
        if next_i - i > 1 or next_j - j > 1
            blocks = blocks.append(ChangeBlock(i, j, next_i - i - 1, next_j - j - 1))
    return blocks

class Step(nat old_index, nat new_index, ChangeBlock | none block)

Step[] walk(const ChangeBlock[] blocks, nat old_start, nat new_start, nat old_end)
    Step[] steps = []
    nat old_index = old_start
    nat new_index = new_start
    for auto block = blocks[]
        while old_index < block.p
            steps = steps.append(Step(old_index, new_index, none))
            old_index += 1
            new_index += 1
        steps = steps.append(Step(old_index, new_index, block))
        old_index = block.p + block.x
        new_index = block.q + block.y
    while old_index < old_end
        steps = steps.append(Step(old_index, new_index, none))
        old_index += 1
        new_index += 1
    return steps

string side_row(string left, string symbol, string right, nat width)
    string left_part = left[:<minimum(width, len(left))]
    string row = left_part + string.repeat(" ", width - len(left_part)) + " " + symbol + " "
    row += right[:<minimum(width, len(right))]
    nat length = len(row)
    while length > 0 and row[length - 1] == " "
        length -= 1
    return row[:<length]

string stat_graph(nat inserted, nat deleted)
    nat total = inserted + deleted
    nat plus = inserted
    nat minus = deleted
    if total > 20
        plus = 20 * inserted / total
        minus = 20 * deleted / total
        if inserted >= 1 and plus == 0
            plus = 1
        if deleted >= 1 and minus == 0
            minus = 1
    return string.repeat("+", plus) + string.repeat("-", minus)

class Hunk(ChangeBlock[] blocks, local nat context, local nat old_total)
    local ChangeBlock first = blocks[0]
    local ChangeBlock last = blocks[len(blocks) - 1]
    local nat before = minimum(context, first.p)
    local nat after = minimum(context, old_total - last.p - last.x)
    nat old_start = first.p - before
    nat old_count = last.p + last.x + after - old_start
    nat new_start = first.q - before
    nat new_count = last.q + last.y + after - new_start

    Step[] steps()
        return walk(blocks, old_start, new_start, old_start + old_count)

class LineDiff(string[] old, string[] new, local string[] options = [])
    ChangeBlock[] blocks = change_blocks(
        [for auto line = old[] then comparison_key(line, options)],
        [for auto line = new[] then comparison_key(line, options)],
    )

    string[] deleted(ChangeBlock block)
        return old[block.p:<block.p + block.x]

    string[] inserted(ChangeBlock block)
        return new[block.q:<block.q + block.y]

    Hunk[] hunks(nat context)
        ChangeBlock[][] groups = []
        for auto block = blocks[]
            if len(groups) > 0
                ChangeBlock[] group = groups[len(groups) - 1]
                ChangeBlock previous = group[len(group) - 1]
                if block.p - (previous.p + previous.x) <= 2 * context
                    groups[len(groups) - 1] = group.append(block)
                    continue
            groups = groups.append([block])
        return [for auto group = groups[] then Hunk(group, context, len(old))]

    string[] normal()
        string[] lines = []
        for auto block = blocks[]
            string letter = block.letter()
            lines = lines.append(range_r(block.p, block.x) + letter + range_r(block.q, block.y))
            lines = lines.concat(prefixed("< ", deleted(block)))
            if letter == "c"
                lines = lines.append("---")
            lines = lines.concat(prefixed("> ", inserted(block)))
        return lines

    string[] ed()
        string[] lines = []
        for len(blocks) > nat index >= 0
            ChangeBlock block = blocks[index]
            string letter = block.letter()
            lines = lines.append(range_r(block.p, block.x) + letter)
            if letter != "d"
                lines = lines.concat(inserted(block)).append(".")
        return lines

    string[] rcs()
        string[] lines = []
        for auto block = blocks[]
            if block.x >= 1
                lines = lines.append("d{block.p + 1} {block.x}")
            if block.y >= 1
                lines = lines.append("a{block.p + block.x} {block.y}")
                lines = lines.concat(inserted(block))
        return lines

    string[] ifdef(string macro)
        string[] lines = []
        for auto step = walk(blocks, 0, 0, len(old))[]
            match step.block
                none
                    lines = lines.append(old[step.old_index])
                ChangeBlock block
                    if block.x >= 1 and block.y >= 1
                        lines = lines.append("#ifndef {macro}").concat(deleted(block))
                        lines = lines.append("#else /* {macro} */").concat(inserted(block))
                        lines = lines.append("#endif /* {macro} */")
                    elif block.y == 0
                        lines = lines.append("#ifndef {macro}").concat(deleted(block))
                        lines = lines.append("#endif /* ! {macro} */")
                    else
                        lines = lines.append("#ifdef {macro}").concat(inserted(block))
                        lines = lines.append("#endif /* {macro} */")
        return lines

    string[] unified(nat context, string old_name, string new_name)
        string[] lines = ["--- {old_name}", "+++ {new_name}"]
        for auto hunk = hunks(context)[]
            string old_range = range_u(hunk.old_start, hunk.old_count)
            string new_range = range_u(hunk.new_start, hunk.new_count)
            lines = lines.append("@@ -{old_range} +{new_range} @@")
            for auto step = hunk.steps()[]
                match step.block
                    none
                        lines = lines.append(" " + old[step.old_index])
                    ChangeBlock block
                        lines = lines.concat(prefixed("-", deleted(block)))
                        lines = lines.concat(prefixed("+", inserted(block)))
        return lines

    string[] context_diff(nat context, string old_name, string new_name)
        string[] lines = ["*** {old_name}", "--- {new_name}"]
        for auto hunk = hunks(context)[]
            bool deletions = false
            bool insertions = false
            for auto block = hunk.blocks[]
                deletions = deletions or block.x >= 1
                insertions = insertions or block.y >= 1
            Step[] steps = hunk.steps()
            lines = lines.append(string.repeat("*", 15))
            lines = lines.append("*** {range_r(hunk.old_start, hunk.old_count)} ****")
            if deletions
                for auto step = steps[]
                    match step.block
                        none
                            lines = lines.append("  " + old[step.old_index])
                        ChangeBlock block
                            string marker = if block.y >= 1 then "! " else "- "
                            lines = lines.concat(prefixed(marker, deleted(block)))
            lines = lines.append("--- {range_r(hunk.new_start, hunk.new_count)} ----")
            if insertions
                for auto step = steps[]
                    match step.block
                        none
                            lines = lines.append("  " + new[step.new_index])
                        ChangeBlock block
                            string marker = if block.x >= 1 then "! " else "+ "
                            lines = lines.concat(prefixed(marker, inserted(block)))
        return lines

    string[] side_by_side(nat width)
        string[] lines = []
        for auto step = walk(blocks, 0, 0, len(old))[]
            match step.block
                none
                    string row = side_row(old[step.old_index], " ", new[step.new_index], width)
                    lines = lines.append(row)
                ChangeBlock block
                    for nat row < maximum(block.x, block.y)
                        if row < block.x and row < block.y
                            string left = old[block.p + row]
                            lines = lines.append(side_row(left, "|", new[block.q + row], width))
                        elif row < block.x
                            lines = lines.append(side_row(old[block.p + row], "<", "", width))
                        else
                            lines = lines.append(side_row("", ">", new[block.q + row], width))
        return lines

class TokenTotals()
    nat deleted = 0
    nat inserted = 0
    nat common = 0

string[] split_tokens(string line, bool by_word)
    if by_word
        return [for auto word = line.split(" ")[] if word != "" then word]
    string[] characters = []
    for nat index < len(line)
        characters = characters.append(line[index])
    return characters

string deletion(const string[] tokens, string separator)
    return "[-" + tokens.join(separator) + "-]"

string insertion(const string[] tokens, string separator)
    return "{{+" + tokens.join(separator) + "+}}"

string compare_tokens(
    const string[] old_tokens,
    const string[] new_tokens,
    string separator,
    TokenTotals &totals,
)
    string[] parts = []
    ChangeBlock[] blocks = change_blocks(old_tokens, new_tokens)
    for auto step = walk(blocks, 0, 0, len(old_tokens))[]
        match step.block
            none
                parts = parts.append(old_tokens[step.old_index])
                totals.common += 1
            ChangeBlock block
                if block.x >= 1
                    string[] removed = old_tokens[block.p:<block.p + block.x]
                    parts = parts.append(deletion(removed, separator))
                if block.y >= 1
                    string[] added = new_tokens[block.q:<block.q + block.y]
                    parts = parts.append(insertion(added, separator))
                totals.deleted += block.x
                totals.inserted += block.y
    return parts.join(separator)

class BodyLine(string kind, string text)

class PatchHunk(nat line_number, nat old_start, nat old_count, nat new_start, nat new_count)
    BodyLine[] body = []

    (string[], string[]) sequences(bool reverse)
        string removed = if reverse then "+" else "-"
        string added = if reverse then "-" else "+"
        string[] old = [for auto line = body[] if line.kind != added then line.text]
        string[] new = [for auto line = body[] if line.kind != removed then line.text]
        return (old, new)

    nat start(bool reverse)
        return if reverse then new_start else old_start

    nat leading_context()
        nat count = 0
        while count < len(body) and body[count].kind == " "
            count += 1
        return count

    nat trailing_context()
        nat count = 0
        while count < len(body) and body[len(body) - 1 - count].kind == " "
            count += 1
        return count

class HunkMatch(nat fuzz, int delta, int position, string[] lines)
    string report(nat number)
        string text = "Hunk #{number} succeeded at {position + 1}"
        if fuzz >= 1
            text += " with fuzz {fuzz}"
        if delta == 1 or delta == -1
            text += " (offset {delta} line)"
        elif delta != 0
            text += " (offset {delta} lines)"
        return text

nat | none parse_number(string text)
    if len(text) < 1 or len(text) > 4
        return none
    for nat index < len(text)
        if not "0123456789".contains(text[index])
            return none
    return nat.parse(text)

class NumberPair(nat first, nat | none second)

NumberPair | none parse_number_pair(string text)
    string[] parts = text.split(",")
    if len(parts) > 2
        return none
    match parse_number(parts[0])
        none
            return none
        nat first
            if len(parts) == 1
                return NumberPair(first, none)
            match parse_number(parts[1])
                none
                    return none
                nat second
                    return NumberPair(first, second)

class HunkRange(nat start, nat count)

HunkRange | none parse_range(string text, string sign)
    if not text.starts_with(sign)
        return none
    match parse_number_pair(text[1:])
        none
            return none
        NumberPair pair
            nat count = 1
            match pair.second
                nat second
                    count = second
                none
                    void
            if pair.first == 0 and count != 0
                return none
            return HunkRange(pair.first, count)

PatchHunk | error parse_hunk_header(string line, nat line_number)
    string[] parts = line.split(" ")
    if len(parts) == 4 and parts[0] == "@@" and parts[3] == "@@"
        match parse_range(parts[1], "-")
            HunkRange old_range
                match parse_range(parts[2], "+")
                    HunkRange new_range
                        return PatchHunk(
                            line_number,
                            old_range.start,
                            old_range.count,
                            new_range.start,
                            new_range.count,
                        )
                    none
                        void
            none
                void
    return error("PATCH ERROR line {line_number}: bad hunk header")

PatchHunk[] | error parse_patch(const string[] patch_lines)
    nat index = 0
    while index < len(patch_lines) and not patch_lines[index].starts_with("@@")
        index += 1
    if index == len(patch_lines)
        return error("PATCH ERROR no hunks")
    PatchHunk[] hunks = []
    while index < len(patch_lines)
        PatchHunk hunk = try parse_hunk_header(patch_lines[index], index + 1)
        index += 1
        nat old_seen = 0
        nat new_seen = 0
        while old_seen < hunk.old_count or new_seen < hunk.new_count
            if index == len(patch_lines)
                return error("PATCH ERROR line {hunk.line_number}: truncated hunk")
            string line = patch_lines[index]
            string kind = line[0]
            bool in_old = kind == " " or kind == "-"
            bool in_new = kind == " " or kind == "+"
            bool old_full = in_old and old_seen == hunk.old_count
            bool new_full = in_new and new_seen == hunk.new_count
            if len(line) < 2 or not (in_old or in_new) or old_full or new_full
                return error("PATCH ERROR line {index + 1}: bad hunk line")
            hunk.body = hunk.body.append(BodyLine(kind, line[1:]))
            if in_old
                old_seen += 1
            if in_new
                new_seen += 1
            index += 1
        if hunk.leading_context() == len(hunk.body)
            return error("PATCH ERROR line {hunk.line_number}: no changes")
        hunks = hunks.append(hunk)
    return hunks

HunkMatch | none search_hunk(
    PatchHunk hunk,
    const string[] lines,
    int adjustment,
    bool reverse,
    nat max_fuzz,
)
    (string[] old, string[] new) = hunk.sequences(reverse)
    int start = int(hunk.start(reverse))
    int expected = if len(old) > 0 then start - 1 + adjustment else start + adjustment
    nat leading = hunk.leading_context()
    nat trailing = hunk.trailing_context()
    int[] offsets = [0, 1, -1, 2, -2, 3, -3]
    for 0 <= nat fuzz <= max_fuzz
        nat head = minimum(fuzz, leading)
        nat tail = minimum(fuzz, trailing)
        string[] old_part = old[head:<len(old) - tail]
        string[] new_part = new[head:<len(new) - tail]
        for auto delta = offsets[]
            int position = expected + int(head) + delta
            int end = position + int(len(old_part))
            if position < 0 or end > int(len(lines))
                continue
            if lines[position:<end] == old_part
                string[] patched = lines[:<position].concat(new_part).concat(lines[end:])
                return HunkMatch(fuzz, delta, position, patched)
    return none

bool hunk_applies(PatchHunk hunk, const string[] lines, bool reverse, nat max_fuzz)
    match search_hunk(hunk, lines, 0, reverse, max_fuzz)
        HunkMatch
            return true
        none
            return false

class EditCommand(string instruction, nat first, nat last)

EditCommand | error parse_edit_command(string line, nat line_number)
    string instruction = line[len(line) - 1]
    if "acd".contains(instruction)
        match parse_number_pair(line[:<len(line) - 1])
            NumberPair pair
                match pair.second
                    none
                        return EditCommand(instruction, pair.first, pair.first)
                    nat second
                        if instruction != "a"
                            return EditCommand(instruction, pair.first, second)
            none
                void
    return error("EDIT ERROR line {line_number}: bad command")

(string[], nat) | error run_edit_script(const string[] original, const string[] script)
    string[] lines = original
    nat executed = 0
    nat index = 0
    while index < len(script)
        nat line_number = index + 1
        EditCommand command = try parse_edit_command(script[index], line_number)
        bool valid
        if command.instruction == "a"
            valid = command.first <= len(lines)
        else
            valid = 1 <= command.first <= command.last <= len(lines)
        if not valid
            return error("EDIT ERROR line {line_number}: bad range")
        index += 1
        string[] text = []
        if command.instruction != "d"
            nat terminator = index
            while terminator < len(script) and script[terminator] != "."
                terminator += 1
            if terminator == len(script)
                return error("EDIT ERROR line {line_number}: missing terminator")
            text = script[index:<terminator]
            index = terminator + 1
        if command.instruction == "a"
            lines = lines[:<command.first].concat(text).concat(lines[command.first:])
        else
            lines = lines[:<command.first - 1].concat(text).concat(lines[command.last:])
        executed += 1
    return (lines, executed)

class Chunk(
    string kind,
    nat base_start,
    nat ours_start,
    nat theirs_start,
    string[] base,
    string[] ours,
    string[] theirs,
)
    string location()
        string base_range = range_m(base_start, len(base))
        string ours_range = range_m(ours_start, len(ours))
        string theirs_range = range_m(theirs_start, len(theirs))
        return "base {base_range} a {ours_range} b {theirs_range}"

string chunk_kind(const string[] base, const string[] ours, const string[] theirs)
    if ours == base
        return "b"
    if theirs == base
        return "a"
    if ours == theirs
        return "both"
    return "conflict"

nat[] match_table(const string[] first, const string[] second)
    nat[] matches = array(len(first) + 2, fill = 0)
    (nat, nat)[] pairs = matched_pairs(first, second)
    for 1 <= nat index < len(pairs) - 1
        (nat i, nat j) = pairs[index]
        matches[i] = j
    return matches

Chunk[] three_way_chunks(const string[] base, const string[] ours, const string[] theirs)
    nat[] ours_match = match_table(base, ours)
    nat[] theirs_match = match_table(base, theirs)
    Chunk[] chunks = []
    nat x = 0
    nat y = 0
    nat z = 0
    while x < len(base) or y < len(ours) or z < len(theirs)
        if x < len(base) and ours_match[x + 1] == y + 1 and theirs_match[x + 1] == z + 1
            chunks = chunks.append(Chunk("stable", x, y, z, [base[x]], [ours[y]], [theirs[z]]))
            x += 1
            y += 1
            z += 1
            continue
        nat anchor = x + 1
        while anchor <= len(base) and (ours_match[anchor] == 0 or theirs_match[anchor] == 0)
            anchor += 1
        nat next_x = len(base)
        nat next_y = len(ours)
        nat next_z = len(theirs)
        if anchor <= len(base)
            next_x = anchor - 1
            next_y = ours_match[anchor] - 1
            next_z = theirs_match[anchor] - 1
        string[] base_part = base[x:<next_x]
        string[] ours_part = ours[y:<next_y]
        string[] theirs_part = theirs[z:<next_z]
        string kind = chunk_kind(base_part, ours_part, theirs_part)
        chunks = chunks.append(Chunk(kind, x, y, z, base_part, ours_part, theirs_part))
        (x, y, z) = (next_x, next_y, next_z)
    return chunks

string kind_counts(const Chunk[] chunks)
    nat a_count = 0
    nat b_count = 0
    nat both_count = 0
    nat conflict_count = 0
    for auto chunk = chunks[]
        if chunk.kind == "a"
            a_count += 1
        elif chunk.kind == "b"
            b_count += 1
        elif chunk.kind == "both"
            both_count += 1
        elif chunk.kind == "conflict"
            conflict_count += 1
    return "a={a_count} b={b_count} both={both_count} conflicts={conflict_count}"

nat common_prefix_length(const string[] first, const string[] second)
    nat length = 0
    while length < len(first) and length < len(second) and first[length] == second[length]
        length += 1
    return length

nat common_suffix_length(const string[] first, const string[] second, nat limit)
    nat length = 0
    while length < limit and first[len(first) - 1 - length] == second[len(second) - 1 - length]
        length += 1
    return length

string[] conflict_lines(
    Chunk chunk,
    string mode,
    string base_name,
    string ours_name,
    string theirs_name,
)
    if mode == "OURS"
        return chunk.ours
    if mode == "THEIRS"
        return chunk.theirs
    if mode == "DIFF3"
        string[] lines = ["<<<<<<< {ours_name}"].concat(chunk.ours)
        lines = lines.append("||||||| {base_name}").concat(chunk.base)
        lines = lines.append("=======").concat(chunk.theirs)
        return lines.append(">>>>>>> {theirs_name}")
    string[] ours = chunk.ours
    string[] theirs = chunk.theirs
    nat head = common_prefix_length(ours, theirs)
    nat tail = common_suffix_length(ours, theirs, minimum(len(ours), len(theirs)) - head)
    string[] ours_middle = ours[head:<len(ours) - tail]
    string[] theirs_middle = theirs[head:<len(theirs) - tail]
    string[] middle
    if mode == "UNION"
        middle = ours_middle.concat(theirs_middle)
    else
        middle = ["<<<<<<< {ours_name}"].concat(ours_middle).append("=======")
        middle = middle.concat(theirs_middle).append(">>>>>>> {theirs_name}")
    return ours[:<head].concat(middle).concat(ours[len(ours) - tail:])

string marker_kind(string line)
    if line == "======="
        return "separator"
    if len(line) == 7 or (len(line) > 7 and line[7] == " ")
        string prefix = line[:<7]
        if prefix == "<<<<<<<"
            return "start"
        if prefix == "|||||||"
            return "base"
        if prefix == ">>>>>>>"
            return "end"
    return ""

nat next_marker(const string[] lines, nat index)
    nat position = index + 1
    while position < len(lines) and marker_kind(lines[position]) == ""
        position += 1
    return position

class ConflictRegion(nat start, nat end, string[] ours, string[] | none base, string[] theirs)
    string[] | none part(string side)
        if side == "OURS"
            return ours
        if side == "THEIRS"
            return theirs
        if side == "BASE"
            return base
        return ours.concat(theirs)

ConflictRegion | none region_at(const string[] lines, nat start)
    if marker_kind(lines[start]) != "start"
        return none
    nat ours_end = next_marker(lines, start)
    nat middle = ours_end
    bool has_base = middle < len(lines) and marker_kind(lines[middle]) == "base"
    if has_base
        middle = next_marker(lines, middle)
    if middle == len(lines) or marker_kind(lines[middle]) != "separator"
        return none
    nat end = next_marker(lines, middle)
    if end == len(lines) or marker_kind(lines[end]) != "end"
        return none
    string[] | none base = if has_base then lines[ours_end + 1:<middle] else none
    string[] ours = lines[start + 1:<ours_end]
    return ConflictRegion(start + 1, end + 1, ours, base, lines[middle + 1:<end])

ConflictRegion[] conflict_regions(const string[] lines)
    ConflictRegion[] regions = []
    nat index = 0
    while index < len(lines)
        match region_at(lines, index)
            none
                index += 1
            ConflictRegion region
                regions = regions.append(region)
                index = region.end
    return regions

class Snapshot(string[] | none lines)

class Workspace()
    map.Map<string, string[]> files = map.Map<string, string[]>()
    map.Map<string, Snapshot[]> history = map.Map<string, Snapshot[]>()

    string[] | error require(string name)
        match files.get(name)
            string[] lines
                return lines
            none
                return error("ERROR no such file {name}")

    Snapshot[] snapshots(string name)
        match history.get(name)
            Snapshot[] states
                return states
            none
                return []

    void .save(string name, const string[] lines)
        .history.set(name, snapshots(name).append(Snapshot(files.get(name))))
        .files.set(name, lines)

    void | error .load_file(const string[] arguments, const string[] data)
        string name = arguments[0]
        .save(name, data)
        emit("FILE {name} lines={len(data)}")
        return

    void | error .copy(const string[] arguments)
        string source = arguments[0]
        string target = arguments[1]
        string[] lines = try require(source)
        .save(target, lines)
        emit("COPY {source} {target} lines={len(lines)}")
        return

    void | error .print_file(const string[] arguments)
        string name = arguments[0]
        string[] lines = try require(name)
        emit("PRINT {name} lines={len(lines)}")
        for nat index < len(lines)
            emit("{index + 1:int=3}| {lines[index]}")
        return

    void | error .list_files()
        emit("FILES count={files.size()}")
        for auto name = files.keys().sorted()[]
            string[] lines = try require(name)
            emit("{name} lines={len(lines)} undo={len(snapshots(name))}")
        return

    void | error .undo(const string[] arguments)
        string name = arguments[0]
        Snapshot[] states = snapshots(name)
        if len(states) == 0
            return error("ERROR nothing to undo {name}")
        Snapshot state = states[len(states) - 1]
        .history.set(name, states[:<len(states) - 1])
        match state.lines
            none
                .files.remove(name)
                emit("UNDO {name} removed")
            string[] lines
                .files.set(name, lines)
                emit("UNDO {name} lines={len(lines)}")
        return

    void | error .diff(const string[] arguments)
        string old_name = arguments[0]
        string new_name = arguments[1]
        string form = arguments[2]
        string[] old = try require(old_name)
        string[] new = try require(new_name)
        string parameter = ""
        string[] options = arguments[3:]
        if contains(["IFDEF", "UNIFIED", "CONTEXT", "SIDE"], form)
            parameter = arguments[3]
            options = arguments[4:]
        LineDiff line_diff = LineDiff(old, new, options)
        if len(line_diff.blocks) == 0
            emit("Files {old_name} and {new_name} are identical")
        elif form == "BRIEF"
            emit("Files {old_name} and {new_name} differ")
        elif form == "NORMAL"
            emit_all(line_diff.normal())
        elif form == "ED"
            emit_all(line_diff.ed())
        elif form == "RCS"
            emit_all(line_diff.rcs())
        elif form == "IFDEF"
            emit_all(line_diff.ifdef(parameter))
        elif form == "UNIFIED"
            emit_all(line_diff.unified(try nat.parse(parameter), old_name, new_name))
        elif form == "CONTEXT"
            emit_all(line_diff.context_diff(try nat.parse(parameter), old_name, new_name))
        else
            emit_all(line_diff.side_by_side(try nat.parse(parameter)))
        return

    void | error .token_diff(const string[] arguments, bool by_word)
        string old_name = arguments[0]
        string new_name = arguments[1]
        string[] old = try require(old_name)
        string[] new = try require(new_name)
        LineDiff line_diff = LineDiff(old, new)
        if len(line_diff.blocks) == 0
            emit("Files {old_name} and {new_name} are identical")
            return
        string separator = if by_word then " " else ""
        TokenTotals totals = TokenTotals()
        for auto block = line_diff.blocks[]
            for nat row < maximum(block.x, block.y)
                nat old_number = block.p + row + 1
                nat new_number = block.q + row + 1
                if row < block.x and row < block.y
                    string[] old_tokens = split_tokens(old[old_number - 1], by_word)
                    string[] new_tokens = split_tokens(new[new_number - 1], by_word)
                    string text = compare_tokens(old_tokens, new_tokens, separator, &totals)
                    emit("a{old_number} b{new_number}: {text}")
                elif row < block.x
                    string[] old_tokens = split_tokens(old[old_number - 1], by_word)
                    totals.deleted += len(old_tokens)
                    emit("a{old_number}: {deletion(old_tokens, separator)}")
                else
                    string[] new_tokens = split_tokens(new[new_number - 1], by_word)
                    totals.inserted += len(new_tokens)
                    emit("b{new_number}: {insertion(new_tokens, separator)}")
        string label = if by_word then "WORDS" else "CHARS"
        emit("{label} deleted={totals.deleted} inserted={totals.inserted} common={totals.common}")
        return

    void | error .stat(const string[] arguments)
        string old_name = arguments[0]
        string new_name = arguments[1]
        string[] old = try require(old_name)
        string[] new = try require(new_name)
        LineDiff line_diff = LineDiff(old, new, arguments[2:])
        nat deleted = 0
        nat inserted = 0
        for auto block = line_diff.blocks[]
            deleted += block.x
            inserted += block.y
        nat total = deleted + inserted
        nat unchanged = len(old) - deleted
        string summary = "{old_name} -> {new_name} | {total}"
        if total > 0
            summary += " " + stat_graph(inserted, deleted)
        emit(summary)
        nat line_total = len(old) + len(new)
        nat similarity = if line_total > 0 then 200 * unchanged / line_total else 100
        string changes = "changes={len(line_diff.blocks)} insertions={inserted}"
        emit("{changes} deletions={deleted} unchanged={unchanged} similarity={similarity}%")
        return

    void | error .patch(const string[] arguments, const string[] data)
        string name = arguments[0]
        string[] lines = try require(name)
        string[] options = arguments[2:]
        bool reverse = contains(options, "REVERSE")
        bool dry_run = contains(options, "DRYRUN")
        nat max_fuzz = 0
        for nat index < len(options)
            if options[index] == "FUZZ"
                max_fuzz = try nat.parse(options[index + 1])
        PatchHunk[] hunks = try parse_patch(data)
        string action = if dry_run then "checking" else "patching"
        emit("{action} file {name}")
        PatchHunk first = hunks[0]
        bool forward = hunk_applies(first, lines, reverse, max_fuzz)
        if not forward and hunk_applies(first, lines, not reverse, max_fuzz)
            emit("Reversed (or previously applied) patch detected! Skipping patch.")
            emit("RESULT applied=0 failed=0 ignored={len(hunks)} lines={len(lines)}")
            return
        int adjustment = 0
        nat applied = 0
        nat failed = 0
        for nat index < len(hunks)
            PatchHunk hunk = hunks[index]
            nat number = index + 1
            match search_hunk(hunk, lines, adjustment, reverse, max_fuzz)
                none
                    failed += 1
                    emit("Hunk #{number} FAILED at {hunk.start(reverse)}")
                HunkMatch found
                    (string[] old, string[] new) = hunk.sequences(reverse)
                    lines = found.lines
                    adjustment += found.delta + int(len(new)) - int(len(old))
                    applied += 1
                    emit(found.report(number))
        emit("RESULT applied={applied} failed={failed} ignored=0 lines={len(lines)}")
        if not dry_run and applied >= 1
            .save(name, lines)
        return

    void | error .edit(const string[] arguments, const string[] data)
        string name = arguments[0]
        (string[] lines, nat executed) = try run_edit_script(try require(name), data)
        emit("EDIT {name} commands={executed} lines={len(lines)}")
        .save(name, lines)
        return

    Chunk[] | error .three_way(string base_name, string ours_name, string theirs_name)
        string[] base = try require(base_name)
        string[] ours = try require(ours_name)
        string[] theirs = try require(theirs_name)
        return three_way_chunks(base, ours, theirs)

    void | error .diff3(const string[] arguments)
        Chunk[] chunks = try .three_way(arguments[0], arguments[1], arguments[2])
        nat changes = 0
        for auto chunk = chunks[]
            if chunk.kind == "stable"
                continue
            changes += 1
            emit("==== {chunk.kind} {chunk.location()}")
            emit_all(prefixed("O ", chunk.base))
            if chunk.kind != "b"
                emit_all(prefixed("A ", chunk.ours))
            if chunk.kind == "b" or chunk.kind == "conflict"
                emit_all(prefixed("B ", chunk.theirs))
        emit("DIFF3 chunks={changes} {kind_counts(chunks)}")
        return

    void | error .merge(const string[] arguments)
        string base_name = arguments[0]
        string ours_name = arguments[1]
        string theirs_name = arguments[2]
        string target = arguments[3]
        string mode = if len(arguments) == 5 then arguments[4] else "MARKERS"
        Chunk[] chunks = try .three_way(base_name, ours_name, theirs_name)
        string[] result = []
        Chunk[] conflict_chunks = []
        for auto chunk = chunks[]
            if chunk.kind == "b"
                result = result.concat(chunk.theirs)
            elif chunk.kind == "conflict"
                string[] lines = conflict_lines(chunk, mode, base_name, ours_name, theirs_name)
                result = result.concat(lines)
                conflict_chunks = conflict_chunks.append(chunk)
            else
                result = result.concat(chunk.ours)
        emit("MERGE {target} lines={len(result)} {kind_counts(chunks)}")
        for nat index < len(conflict_chunks)
            emit("CONFLICT {index + 1} {conflict_chunks[index].location()}")
        .save(target, result)
        return

    void | error .conflicts(const string[] arguments)
        string name = arguments[0]
        ConflictRegion[] regions = conflict_regions(try require(name))
        emit("CONFLICTS {name} count={len(regions)}")
        for nat index < len(regions)
            ConflictRegion region = regions[index]
            string base = "none"
            match region.base
                string[] base_lines
                    base = "{len(base_lines)}"
                none
                    void
            string span = "lines {region.start}-{region.end}"
            string ours = "ours={len(region.ours)}"
            emit("{index + 1}: {span} {ours} base={base} theirs={len(region.theirs)}")
        return

    void | error .resolve(const string[] arguments)
        string name = arguments[0]
        string side = arguments[2]
        string[] lines = try require(name)
        nat number = try nat.parse(arguments[1])
        ConflictRegion[] regions = conflict_regions(lines)
        if len(regions) < number
            return error("ERROR no conflict {number} in {name}")
        ConflictRegion region = regions[number - 1]
        match region.part(side)
            none
                return error("ERROR no base section in conflict {number}")
            string[] replacement
                string[] before = lines[:<region.start - 1].concat(replacement)
                string[] content = before.concat(lines[region.end:])
                nat remaining = len(conflict_regions(content))
                emit("RESOLVE {name} {number} {side} lines={len(content)} remaining={remaining}")
                .save(name, content)
        return

    void | error .dispatch(const string[] words, const string[] data)
        string command = words[0]
        string[] arguments = words[1:]
        if command == "FILE"
            return .load_file(arguments, data)
        if command == "COPY"
            return .copy(arguments)
        if command == "PRINT"
            return .print_file(arguments)
        if command == "FILES"
            return .list_files()
        if command == "DIFF"
            return .diff(arguments)
        if command == "WORDDIFF"
            return .token_diff(arguments, true)
        if command == "CHARDIFF"
            return .token_diff(arguments, false)
        if command == "STAT"
            return .stat(arguments)
        if command == "PATCH"
            return .patch(arguments, data)
        if command == "EDIT"
            return .edit(arguments, data)
        if command == "DIFF3"
            return .diff3(arguments)
        if command == "MERGE"
            return .merge(arguments)
        if command == "CONFLICTS"
            return .conflicts(arguments)
        if command == "RESOLVE"
            return .resolve(arguments)
        return .undo(arguments)

    void .execute(const string[] words, const string[] data)
        match .dispatch(words, data)
            void
                void
            error problem
                emit(problem.message)

Workspace workspace = Workspace()
nat command_count
scan(&command_count)
for _ < command_count
    string line
    scan(&line)
    string[] words = line.split(" ")
    string[] data = []
    if contains(["FILE", "PATCH", "EDIT"], words[0])
        nat count = nat.parse(words[2])
        for _ < count
            string data_line
            scan(&data_line)
            data = data.append(data_line)
    .workspace.execute(words, data)
