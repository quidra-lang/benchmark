string[] read_lines(string path)
    string content = file.read(path)
    string[] lines = content.split(NL)
    return lines[0:<int(len(lines)) - 1]

int decimal(string word)
    int result = int.parse(word)
    return result

int[] read_ecg()
    int[] result = []
    string[] lines = read_lines("input/ecg.csv")
    for 1 <= int index < int(len(lines))
        result = result.append(decimal(lines[index].split(",")[1]))
    return result

class Annotation(int sample, string label)
    int beat = -1

Annotation[] read_annotations()
    Annotation[] result = []
    string[] lines = read_lines("input/annotations.csv")
    for 1 <= int index < int(len(lines))
        string[] words = lines[index].split(",")
        result = result.append(Annotation(decimal(words[0]), words[1]))
    return result

int[] read_params()
    int[] result = []
    for string line = read_lines("input/params.txt")[]
        result = result.append(decimal(line.split(" ")[1]))
    return result

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
