string[] lines(string path)
    string contents = file.read(path)
    string[] result = contents.split(NL)
    return result[0:<int(len(result)) - 1]

real64 decimal(string value)
    real64 result = real64.parse(value)
    return result

int integer(string value)
    int result = int.parse(value)
    return result

class Table(string[] variables, string[] ids, string[][] rows)
class Params(string missing, string scaling, string components, real64 cumulative, int repetitions, int seed, real64 t2_limit, real64 spe_limit, int cycles, int top, int scree_width, int biplot_width, int biplot_height, int radius, int diagnostic_width, int diagnostic_height)
class Inputs(Table data, Table supplementary, Params params)

Table read_table(string path)
    string[] contents = lines(path)
    string[] header = contents[0].split(",")
    string[] ids = []
    string[][] rows = []
    for 1 <= int index < int(len(contents))
        string[] fields = contents[index].split(",")
        ids = ids.append(fields[0])
        rows = rows.append(fields[1:<int(len(fields))])
    return Table(header[1:<int(len(header))], ids, rows)

Inputs read_inputs()
    string[][] settings = [for string line = lines("input/params.txt")[] then line.split(" ")]
    Params params = Params(settings[0][1], settings[1][1], settings[2][1], decimal(settings[3][1]), integer(settings[4][1]), integer(settings[4][2]), decimal(settings[5][1]), decimal(settings[6][1]), integer(settings[7][1]), integer(settings[8][1]), integer(settings[9][1]), integer(settings[10][1]), integer(settings[10][2]), integer(settings[11][1]), integer(settings[12][1]), integer(settings[12][2]))
    return Inputs(read_table("input/data.csv"), read_table("input/supplementary.csv"), params)
