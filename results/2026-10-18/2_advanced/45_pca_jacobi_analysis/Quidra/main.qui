import dataset = "./dataset.qui"
import matrix = "./matrix.qui"
import eigen = "./eigen.qui"
import pca = "./pca.qui"
import plot = "./plot.qui"

string number(real64 value, int digits = 4)
    string result = if digits == 6 then "{value:frac=6}" else "{value:frac=4}"
    if result == "-0.0000" or result == "-0.000000"
        return result[1:<int(len(result))]
    return result

string reals(real64[] values, string separator = " ")
    string[] fields = [for real64 value = values[] then number(value)]
    return fields.join(separator)

real64 sum_values(real64[] values)
    real64 result = 0.0
    for real64 value = values[]
        result += value
    return result

int argmax(real64[] values)
    int result = 0
    for 1 <= int index < int(len(values))
        if values[index] > values[result]
            result = index
    return result

int[] top_indices(real64[] values, int count)
    int[] order = []
    for int index < int(len(values))
        int place = int(len(order))
        for int position < int(len(order))
            if values[index] > values[order[position]]
                place = position
                break
        order = order[0:<place].append(index).concat(order[place:<int(len(order))])
    int limit = if count < int(len(order)) then count else int(len(order))
    return order[0:<limit]

real64 congruence(real64[] first, real64[] second)
    return matrix.dot(first, second) / matrix.root(matrix.dot(first, first) * matrix.dot(second, second))

class Summary(int observed, int missing, real64 mean, real64 sd, real64 minimum, real64 maximum)
class Descriptive(Summary[] summaries, string[] incomplete)
class AnalysisData(string[] ids, real64[][] rows)
class Adequacy(real64[] msa, real64 determinant, real64 kmo, real64 bartlett, int degrees)
class Retention(real64 total, real64 average, real64[] ratios, real64[] cumulative, real64[] broken, real64[] standard_errors, bool[] separated, int[] criteria, int retained)
class Loadings(real64[][] values, real64[] communalities, real64[][] correlations)
class Rotation(real64[][] loadings, real64[] squares, real64[] criteria, int[] closest, real64[] congruences)
class Diagnostic(real64 t2, real64 spe, real64 quality, string flag, real64[] t2_contributions, real64[] spe_contributions)
class Nearest(int index, real64 distance)

Descriptive summarize(string[] ids, string[][] rows, int size)
    Summary[] summaries = []
    for int j < size
        real64[] values = []
        real64 total = 0.0
        for string[] row = rows[]
            if row[j] != "NA"
                real64 value = dataset.decimal(row[j])
                values = values.append(value)
                total += value
        real64 mean = total / matrix.as_real(int(len(values)))
        real64 squares = 0.0
        real64 minimum = values[0]
        real64 maximum = values[0]
        for real64 value = values[]
            squares += (value - mean) * (value - mean)
            if value < minimum
                minimum = value
            if value > maximum
                maximum = value
        summaries = summaries.append(Summary(int(len(values)), int(len(rows)) - int(len(values)), mean, matrix.root(squares / matrix.as_real(int(len(values)) - 1)), minimum, maximum))
    string[] incomplete = []
    for int index < int(len(rows))
        bool missing = false
        for string value = rows[index][]
            if value == "NA"
                missing = true
        if missing
            incomplete = incomplete.append(ids[index])
    return Descriptive(summaries, incomplete)

AnalysisData analysis_data(string[] ids, string[][] rows, Summary[] summaries, string strategy)
    string[] retained_ids = []
    real64[][] retained_rows = []
    for int index < int(len(rows))
        string[] row = rows[index]
        bool complete = true
        real64[] values = []
        for int j < int(len(summaries))
            if row[j] == "NA"
                complete = false
                values = values.append(summaries[j].mean)
            else
                values = values.append(dataset.decimal(row[j]))
        if strategy == "mean" or complete
            retained_ids = retained_ids.append(ids[index])
            retained_rows = retained_rows.append(values)
    return AnalysisData(retained_ids, retained_rows)

Adequacy sampling_adequacy(real64[][] correlation, int n)
    int size = int(len(correlation))
    matrix.Inverse solved = matrix.inverse_determinant(correlation)
    real64[][] inverse = solved.values
    real64 determinant = solved.determinant
    real64[] msa = []
    real64 rr_total = 0.0
    real64 pp_total = 0.0
    for int j < size
        real64 rr = 0.0
        real64 pp = 0.0
        for int k < size
            if k == j
                continue
            real64 partial = -inverse[j][k] / matrix.root(inverse[j][j] * inverse[k][k])
            rr += correlation[j][k] * correlation[j][k]
            pp += partial * partial
        msa = msa.append(rr / (rr + pp))
        rr_total += rr
        pp_total += pp
    real64 kmo = rr_total / (rr_total + pp_total)
    real64 bartlett = -(matrix.as_real(n - 1) - matrix.as_real(2 * size + 5) / 6.0) * matrix.logarithm(determinant)
    return Adequacy(msa, determinant, kmo, bartlett, size * (size - 1) / 2)

real64[] parallel_analysis(int n, int size, int repetitions, int seed)
    real64[] totals = matrix.zeros(size)
    int state = seed
    for _ < repetitions
        real64[][] rows = []
        for int i < n
            real64[] row = []
            for int j < size
                state = (48271 * state) % 2147483647
                row = row.append(matrix.as_real(state) / 2147483647.0)
            rows = rows.append(row)
        pca.Prepared prepared = pca.prepare(rows, "correlation")
        eigen.Result result = eigen.jacobi(prepared.values)
        real64 total = sum_values(result.values)
        for int k < size
            totals[k] += result.values[k] / total
    for int k < size
        totals[k] /= matrix.as_real(repetitions)
    return totals

Retention retention(real64[] values, real64[] parallel_values, int n, dataset.Params params)
    int size = int(len(values))
    real64 total = sum_values(values)
    real64 average = total / matrix.as_real(size)
    real64 cumulative = 0.0
    real64[] ratios = []
    real64[] cumulatives = []
    real64[] broken = []
    real64[] standard_errors = []
    bool[] separated = []
    int[] criteria = [0, size, size, size]
    bool broken_found = false
    bool parallel_found = false
    bool cumulative_found = false
    for int k < size
        real64 ratio = values[k] / total
        cumulative = if k == 0 then ratio else cumulative + ratio
        ratios = ratios.append(ratio)
        cumulatives = cumulatives.append(cumulative)
        real64 value = 0.0
        for k + 1 <= int index <= size
            value += 1.0 / matrix.as_real(index)
        broken = broken.append(value / matrix.as_real(size))
        real64 standard_error = values[k] * matrix.root(2.0 / matrix.as_real(n))
        standard_errors = standard_errors.append(standard_error)
        bool isolated = true
        int[] neighbors = [k - 1, k + 1]
        for int other = neighbors[]
            if other >= 0 and other < size and matrix.absolute(values[k] - values[other]) <= standard_error
                isolated = false
        separated = separated.append(isolated)
        if values[k] > average
            criteria[0] += 1
        if not broken_found and ratio <= broken[k]
            criteria[1] = k
            broken_found = true
        if not parallel_found and ratio <= parallel_values[k]
            criteria[2] = k
            parallel_found = true
        if not cumulative_found and cumulative >= params.cumulative
            criteria[3] = k + 1
            cumulative_found = true
    int retained = 1
    if params.components == "kaiser"
        retained = criteria[0]
    elif params.components == "broken_stick"
        retained = criteria[1]
    elif params.components == "parallel_values"
        retained = criteria[2]
    elif params.components == "cumulative"
        retained = criteria[3]
    else
        retained = dataset.integer(params.components)
    if retained < 1
        retained = 1
    return Retention(total, average, ratios, cumulatives, broken, standard_errors, separated, criteria, retained)

Loadings loading_analysis(real64[] values, real64[][] vectors, real64[][] analyzed, int count)
    real64[][] loadings = []
    real64[] communalities = []
    real64[][] correlations = []
    for int j < int(len(values))
        real64[] row = []
        real64[] correlation = []
        real64 communality = 0.0
        for int k < int(len(values))
            real64 value = vectors[k][j] * matrix.root(values[k])
            row = row.append(value)
            if k < count
                communality += value * value
            if k < 2
                correlation = correlation.append(value / matrix.root(analyzed[j][j]))
        loadings = loadings.append(row)
        correlations = correlations.append(correlation)
        communalities = communalities.append(communality / analyzed[j][j])
    return Loadings(loadings, communalities, correlations)

real64 varimax_criterion(real64[][] values, int count)
    real64 result = 0.0
    for int k < count
        real64 q4 = 0.0
        real64 q2 = 0.0
        for int j < int(len(values))
            real64 square = values[j][k] * values[j][k]
            q4 += square * square
            q2 += square
        real64 size = matrix.as_real(int(len(values)))
        result += q4 / size - (q2 / size) * (q2 / size)
    return result

Rotation varimax(real64[][] loadings, int count, int cycles)
    int size = int(len(loadings))
    real64[] lengths = []
    real64[][] normalized = []
    for int j < size
        real64 squared = 0.0
        for int k < count
            squared += loadings[j][k] * loadings[j][k]
        real64 length = matrix.root(squared)
        lengths = lengths.append(length)
        real64[] row = []
        for int k < count
            row = row.append(loadings[j][k] / length)
        normalized = normalized.append(row)
    real64[] criteria = [varimax_criterion(normalized, count)]
    for _ < cycles
        for int a < count - 1
            for a + 1 <= int b < count
                real64 sa = 0.0
                real64 sb = 0.0
                real64 sc = 0.0
                real64 sd = 0.0
                for int j < size
                    real64 first = normalized[j][a]
                    real64 second = normalized[j][b]
                    real64 phi = first * first - second * second
                    real64 psi = 2.0 * first * second
                    sa += phi
                    sb += psi
                    sc += phi * phi - psi * psi
                    sd += 2.0 * phi * psi
                real64 numerator = sd - 2.0 * sa * sb / matrix.as_real(size)
                real64 denominator = sc - (sa * sa - sb * sb) / matrix.as_real(size)
                real64 omega = matrix.root(numerator * numerator + denominator * denominator)
                if omega == 0.0
                    continue
                real64 cos4 = denominator / omega
                real64 sin4 = numerator / omega
                real64 cos2 = matrix.root((1.0 + cos4) / 2.0)
                real64 sin2 = if cos2 == 0.0 then 1.0 else sin4 / (2.0 * cos2)
                real64 cos1 = matrix.root((1.0 + cos2) / 2.0)
                real64 sin1 = sin2 / (2.0 * cos1)
                for int j < size
                    real64 first = normalized[j][a]
                    real64 second = normalized[j][b]
                    normalized[j][a] = cos1 * first + sin1 * second
                    normalized[j][b] = -sin1 * first + cos1 * second
        criteria = criteria.append(varimax_criterion(normalized, count))
    real64[][] columns = []
    real64[] squares = []
    for int k < count
        real64[] column = []
        for int j < size
            column = column.append(normalized[j][k] * lengths[j])
        column = matrix.orient(column)
        columns = columns.append(column)
        squares = squares.append(matrix.dot(column, column))
    int[] order = top_indices(squares, count)
    real64[][] rotated = matrix.empty_matrix(size, count)
    real64[] ss = []
    int[] closest = []
    real64[] congruences = []
    for int k < count
        int source = order[k]
        ss = ss.append(squares[source])
        for int j < size
            rotated[j][k] = columns[source][j]
        real64[] values = []
        for int component < count
            values = values.append(matrix.absolute(congruence(columns[source], matrix.column(loadings, component))))
        int selected = argmax(values)
        closest = closest.append(selected)
        congruences = congruences.append(values[selected])
    return Rotation(rotated, ss, criteria, closest, congruences)

Diagnostic[] diagnose(real64[][] standardized, real64[][] scores, real64[] values, real64[][] vectors, int count, real64 t2_limit, real64 spe_limit, bool quality_needed)
    Diagnostic[] result = []
    for int i < int(len(standardized))
        real64[] row = standardized[i]
        real64[] residual = pca.residual(row, scores[i], vectors, count)
        real64 t2 = pca.t2(scores[i], values, count)
        real64 spe = matrix.dot(residual, residual)
        real64 represented = 0.0
        for int k < count
            represented += scores[i][k] * scores[i][k]
        real64 quality = if quality_needed then represented / matrix.dot(row, row) else 0.0
        string flag = (if t2 > t2_limit then "T" else "") + (if spe > spe_limit then "Q" else "")
        if flag == ""
            flag = "-"
        real64[] t2_contributions = []
        real64[] spe_contributions = []
        for int j < int(len(row))
            real64 weight = 0.0
            for int k < count
                weight += (scores[i][k] / values[k]) * vectors[k][j]
            t2_contributions = t2_contributions.append(row[j] * weight)
            spe_contributions = spe_contributions.append(residual[j] * residual[j])
        result = result.append(Diagnostic(t2, spe, quality, flag, t2_contributions, spe_contributions))
    return result

Nearest[] supplementary_nearest(real64[][] scores, real64[][] reference, int count)
    Nearest[] result = []
    for real64[] row = scores[]
        int nearest = -1
        real64 minimum = 0.0
        for int index < int(len(reference))
            real64 distance = 0.0
            for int k < count
                distance += (row[k] - reference[index][k]) * (row[k] - reference[index][k])
            if nearest < 0 or distance < minimum
                nearest = index
                minimum = distance
        result = result.append(Nearest(nearest, matrix.root(minimum)))
    return result

class Analysis(dataset.Inputs data, Summary[] summaries, string[] incomplete, string[] ids, pca.Prepared prepared, eigen.Result eigen_result, eigen.Power[] powered, real64[] parallel_values, Retention retained, Loadings loading, Rotation rotation, real64[][] scores, Diagnostic[] diagnostics, real64[][] supplementary_scores, Diagnostic[] supplementary_diagnostics, Nearest[] nearest, Adequacy adequacy)

string[] eigen_report(Analysis analysis)
    dataset.Table data = analysis.data.data
    dataset.Params params = analysis.data.params
    pca.Prepared prepared = analysis.prepared
    eigen.Result result = analysis.eigen_result
    Retention retained = analysis.retained
    int count = retained.retained
    int size = int(len(data.variables))
    string[] lines = ["pca rows {len(data.rows)} used {len(analysis.ids)} variables {size} missing {params.missing} scaling {params.scaling}"]
    string incomplete = if len(analysis.incomplete) == 0 then "-" else analysis.incomplete.join(" ")
    lines = lines.concat(["incomplete {len(analysis.incomplete)} {incomplete}", "", "variable observed missing mean sd min max msa"])
    for int j < size
        Summary summary = analysis.summaries[j]
        lines = lines.append(data.variables[j] + " {summary.observed} {summary.missing} " + reals([summary.mean, summary.sd, summary.minimum, summary.maximum, analysis.adequacy.msa[j]]))
    Adequacy adequacy = analysis.adequacy
    lines = lines.concat(["adequacy kmo " + number(adequacy.kmo) + " determinant " + number(adequacy.determinant, 6) + " bartlett " + number(adequacy.bartlett) + " df {adequacy.degrees}", "", "matrix {params.scaling}"])
    for int j < size
        lines = lines.append(data.variables[j] + " " + reals(prepared.values[j]))
    int[][] pairs = []
    real64[] magnitudes = []
    for int j < size - 1
        for j + 1 <= int k < size
            pairs = pairs.append([j, k])
            magnitudes = magnitudes.append(matrix.absolute(prepared.correlation[j][k]))
    string[] strongest = []
    for int index = top_indices(magnitudes, params.top)[]
        int[] pair = pairs[index]
        strongest = strongest.append(data.variables[pair[0]] + ":" + data.variables[pair[1]] + ":" + number(prepared.correlation[pair[0]][pair[1]]))
    lines = lines.concat([
        "strongest " + strongest.join(" "),
        "",
        "jacobi sweeps {result.sweeps}",
        "eigenvalues total " + number(retained.total) + " average " + number(retained.average),
        "k eigenvalue ratio cumulative broken_stick parallel se separated",
    ])
    for int k < size
        real64[] values = [result.values[k], retained.ratios[k], retained.cumulative[k], retained.broken[k], analysis.parallel_values[k], retained.standard_errors[k]]
        lines = lines.append("{k + 1} " + reals(values) + " " + (if retained.separated[k] then "yes" else "no"))
    int[] criteria = retained.criteria
    lines = lines.concat([
        "retention kaiser {criteria[0]} broken_stick {criteria[1]} parallel {criteria[2]} cumulative {criteria[3]} target " + number(params.cumulative),
        "components {count} rule {params.components}",
        "",
        "eigenvectors",
    ])
    string[] header = ["variable"]
    for 1 <= int k <= size
        header = header.append("pc{k}")
    lines = lines.append(header.join(" "))
    for int j < size
        real64[] values = []
        for int k < size
            values = values.append(result.vectors[k][j])
        lines = lines.append(data.variables[j] + " " + reals(values))
    lines = lines.concat(["", "power_iteration iterations 1000", "k jacobi power agree_at match"])
    int matched = 0
    for int k < size
        eigen.Power powered = analysis.powered[k]
        if powered.matched
            matched += 1
        string agreement = if powered.agreement < 0 then "-" else "{powered.agreement}"
        lines = lines.append("{k + 1} " + number(result.values[k]) + " " + number(powered.value) + " {agreement} " + (if powered.matched then "yes" else "no"))
    lines = lines.concat(["cross_check {matched}/{size}", "", "scores", "component sd min min_id max max_id contributors"])
    for int k < count
        real64[] column = matrix.column(analysis.scores, k)
        real64 squared = 0.0
        int minimum = 0
        int maximum = 0
        real64[] contributions = []
        for int i < int(len(column))
            real64 value = column[i]
            squared += value * value
            if value < column[minimum]
                minimum = i
            if value > column[maximum]
                maximum = i
            contributions = contributions.append(value * value / (matrix.as_real(int(len(analysis.ids)) - 1) * result.values[k]))
        string[] fields = []
        for int i = top_indices(contributions, params.top)[]
            fields = fields.append(analysis.ids[i] + ":" + number(contributions[i]))
        lines = lines.append("pc{k + 1} " + number(matrix.root(squared / matrix.as_real(int(len(analysis.ids)) - 1))) + " " + number(column[minimum]) + " " + analysis.ids[minimum] + " " + number(column[maximum]) + " " + analysis.ids[maximum] + " " + fields.join(" "))
    lines = lines.concat(["", "varimax components {count} cycles {params.cycles}"])
    for int index < int(len(analysis.rotation.criteria))
        lines = lines.append("cycle {index} criterion " + number(analysis.rotation.criteria[index], 6))
    for int k < count
        lines = lines.append("rc{k + 1} ss " + number(analysis.rotation.squares[k]) + " ratio " + number(analysis.rotation.squares[k] / retained.total) + " closest pc{analysis.rotation.closest[k] + 1} congruence " + number(analysis.rotation.congruences[k]))
    lines = lines.concat(["", "sensitivity", "missing scaling rows sweeps eigenvalues cumulative congruence"])
    string[][] combinations = [["listwise", "covariance"], ["listwise", "correlation"], ["mean", "covariance"], ["mean", "correlation"]]
    for string[] combination = combinations[]
        AnalysisData alternative = analysis_data(data.ids, data.rows, analysis.summaries, combination[0])
        pca.Prepared prepared_variant = pca.prepare(alternative.rows, combination[1])
        eigen.Result variant = eigen.jacobi(prepared_variant.values)
        real64 total = sum_values(variant.values)
        real64 cumulative = 0.0
        real64[] values = []
        real64[] agreements = []
        for int k < count
            values = values.append(variant.values[k])
            real64 ratio = variant.values[k] / total
            cumulative = if k == 0 then ratio else cumulative + ratio
            agreements = agreements.append(matrix.absolute(matrix.dot(variant.vectors[k], result.vectors[k])))
        lines = lines.append(combination[0] + " " + combination[1] + " {len(alternative.ids)} {variant.sweeps} " + reals(values) + " " + number(cumulative) + " " + reals(agreements))
    return lines

string[] loadings_report(Analysis analysis)
    int count = analysis.retained.retained
    string[] header = ["variable"]
    for 1 <= int k <= count
        header = header.append("pc{k}")
    header = header.append("communality")
    for 1 <= int k <= count
        header = header.append("rc{k}")
    string[] lines = [header.join(",")]
    for int j < int(len(analysis.data.data.variables))
        string[] fields = [analysis.data.data.variables[j]]
        for int k < count
            fields = fields.append(number(analysis.loading.values[j][k]))
        fields = fields.append(number(analysis.loading.communalities[j]))
        for int k < count
            fields = fields.append(number(analysis.rotation.loadings[j][k]))
        lines = lines.append(fields.join(","))
    return lines

string[] scores_report(Analysis analysis)
    int count = analysis.retained.retained
    string[] header = ["id", "set"]
    for 1 <= int k <= count
        header = header.append("pc{k}")
    string[] lines = [header.join(",")]
    for int collection < 2
        string[] ids = if collection == 0 then analysis.ids else analysis.data.supplementary.ids
        real64[][] scores = if collection == 0 then analysis.scores else analysis.supplementary_scores
        string label = if collection == 0 then "data" else "supplementary"
        for int index < int(len(ids))
            string[] fields = [ids[index], label]
            for int k < count
                fields = fields.append(number(scores[index][k]))
            lines = lines.append(fields.join(","))
    return lines

string[] outliers_report(Analysis analysis)
    dataset.Params params = analysis.data.params
    int count = analysis.retained.retained
    string[] lines = ["diagnostics components {count} t2_limit " + number(params.t2_limit) + " spe_limit " + number(params.spe_limit), "id t2 spe quality flag"]
    int flagged_t = 0
    int flagged_q = 0
    int both = 0
    int any = 0
    real64[] t2_values = []
    real64[] spe_values = []
    for int index < int(len(analysis.diagnostics))
        Diagnostic row = analysis.diagnostics[index]
        lines = lines.append(analysis.ids[index] + " " + reals([row.t2, row.spe, row.quality]) + " {row.flag}")
        if row.flag.contains("T")
            flagged_t += 1
        if row.flag.contains("Q")
            flagged_q += 1
        if row.flag == "TQ"
            both += 1
        if row.flag != "-"
            any += 1
        t2_values = t2_values.append(row.t2)
        spe_values = spe_values.append(row.spe)
    lines = lines.append("flagged t2 {flagged_t} spe {flagged_q} both {both} any {any}")
    string[] modes = ["t2", "spe"]
    for string mode = modes[]
        lines = lines.concat(["", "top {mode}", "rank id {mode} variable contribution"])
        real64[] values = if mode == "t2" then t2_values else spe_values
        int[] order = top_indices(values, params.top)
        for int rank < int(len(order))
            int index = order[rank]
            Diagnostic row = analysis.diagnostics[index]
            real64[] contributions = if mode == "t2" then row.t2_contributions else row.spe_contributions
            int variable = argmax(contributions)
            lines = lines.append("{rank + 1} " + analysis.ids[index] + " " + number(values[index]) + " " + analysis.data.data.variables[variable] + " " + number(contributions[variable]))
    lines = lines.concat(["", "reconstruction", "k mean_spe max_spe max_id"])
    for 1 <= int k < int(len(analysis.data.data.variables))
        real64 total = 0.0
        real64 maximum = 0.0
        int maximum_index = -1
        for int i < int(len(analysis.prepared.standardized))
            real64[] row = analysis.prepared.standardized[i]
            real64[] residual = pca.residual(row, analysis.scores[i], analysis.eigen_result.vectors, k)
            real64 spe = matrix.dot(residual, residual)
            total += spe
            if maximum_index < 0 or spe > maximum
                maximum = spe
                maximum_index = i
        lines = lines.append("{k} " + number(total / matrix.as_real(int(len(analysis.ids)))) + " " + number(maximum) + " " + analysis.ids[maximum_index])
    string[] header = ["id"]
    for 1 <= int k <= count
        header = header.append("pc{k}")
    header = header.concat(["t2", "spe", "flag", "nearest", "distance"])
    lines = lines.concat(["", "supplementary", header.join(" ")])
    for int i < int(len(analysis.data.supplementary.ids))
        string[] fields = [analysis.data.supplementary.ids[i]]
        for int k < count
            fields = fields.append(number(analysis.supplementary_scores[i][k]))
        Diagnostic row = analysis.supplementary_diagnostics[i]
        Nearest nearest = analysis.nearest[i]
        fields = fields.concat([number(row.t2), number(row.spe), row.flag, analysis.ids[nearest.index], number(nearest.distance)])
        lines = lines.append(fields.join(" "))
    return lines

void axes(string[][] &grid, int row, int column)
    for int index < int(len(grid[0]))
        grid[row][index] = "-"
    for int index < int(len(grid))
        grid[index][column] = "|"
    grid[row][column] = "+"

void draw_points(string[][] &grid, plot.Cell[] cells)
    int[][] counts = []
    for int row < int(len(grid))
        int[] values = [for string value = grid[row][] then 0]
        counts = counts.append(values)
    for plot.Cell cell = cells[]
        counts[cell.row][cell.column] += 1
    for int row < int(len(grid))
        for int column < int(len(grid[row]))
            int count = counts[row][column]
            if count > 0
                grid[row][column] = if count == 1 then "." elif count <= 3 then "o" else "@"

bool inside_circle(int row, int column, int center_row, int center_column, int radius)
    return (column - center_column) * (column - center_column) + (2 * (row - center_row)) * (2 * (row - center_row)) <= radius * radius

string[] plots_report(Analysis analysis)
    dataset.Params params = analysis.data.params
    eigen.Result result = analysis.eigen_result
    Retention retained = analysis.retained
    int width = params.scree_width
    int kaiser = plot.floor_value(retained.average / result.values[0] * matrix.as_real(width) + 0.5)
    string[] lines = ["scree width {width} kaiser_column {kaiser}"]
    for int k < int(len(result.values))
        real64 value = result.values[k]
        int length = plot.floor_value(value / result.values[0] * matrix.as_real(width) + 0.5)
        int broken = plot.floor_value(retained.broken[k] * retained.total / result.values[0] * matrix.as_real(width) + 0.5)
        lines = lines.append("|" + plot.scree(width, length, kaiser, broken) + "| pc{k + 1} " + number(value))
    width = params.biplot_width
    int height = params.biplot_height
    real64 maximum_x = 0.0
    real64 maximum_y = 0.0
    for int collection < 2
        real64[][] scores = if collection == 0 then analysis.scores else analysis.supplementary_scores
        for real64[] row = scores[]
            if matrix.absolute(row[0]) > maximum_x
                maximum_x = matrix.absolute(row[0])
            if matrix.absolute(row[1]) > maximum_y
                maximum_y = matrix.absolute(row[1])
    real64 largest_x = 0.0
    real64 largest_y = 0.0
    for real64[] row = analysis.loading.values[]
        if matrix.absolute(row[0]) > largest_x
            largest_x = matrix.absolute(row[0])
        if matrix.absolute(row[1]) > largest_y
            largest_y = matrix.absolute(row[1])
    real64 first_ratio = maximum_x / largest_x
    real64 second_ratio = maximum_y / largest_y
    real64 arrow_scale = 0.9 * (if first_ratio < second_ratio then first_ratio else second_ratio)
    string[][] grid = plot.grid(width, height)
    plot.Cell origin = plot.cell(0.0, 0.0, maximum_x, maximum_y, width, height)
    axes(&grid, origin.row, origin.column)
    plot.Cell[] tips = []
    for real64[] row = analysis.loading.values[]
        plot.Cell tip = plot.cell(arrow_scale * row[0], arrow_scale * row[1], maximum_x, maximum_y, width, height)
        tips = tips.append(tip)
        for plot.Shaft cell = plot.shaft(origin.row, origin.column, tip.row, tip.column)[]
            grid[cell.row][cell.column] = cell.character
    plot.Cell[] cells = []
    for real64[] row = analysis.scores[]
        cells = cells.append(plot.cell(row[0], row[1], maximum_x, maximum_y, width, height))
    draw_points(&grid, cells)
    for int index < int(len(cells))
        plot.Cell cell = cells[index]
        if analysis.diagnostics[index].flag != "-"
            grid[cell.row][cell.column] = "X"
    for real64[] row = analysis.supplementary_scores[]
        plot.Cell cell = plot.cell(row[0], row[1], maximum_x, maximum_y, width, height)
        grid[cell.row][cell.column] = "*"
    string letters = "ABCDEFGHIJKL"
    for int j < int(len(tips))
        plot.Cell tip = tips[j]
        grid[tip.row][tip.column] = letters[j]
    lines = lines.concat([
        "",
        "biplot pc1 pc2 width {width} height {height}",
        "x " + number(-maximum_x) + " " + number(maximum_x) + " y " + number(-maximum_y) + " " + number(maximum_y) + " arrow_scale " + number(arrow_scale),
    ])
    lines = lines.concat(plot.frame(grid))
    for int j < int(len(analysis.data.data.variables))
        lines = lines.append(letters[j] + " " + analysis.data.data.variables[j] + " " + reals(analysis.loading.values[j][0:<2]))
    int radius = params.radius
    width = 2 * radius + 3
    height = radius + 3
    int center_row = radius / 2 + 1
    int center_column = radius + 1
    grid = plot.grid(width, height)
    axes(&grid, center_row, center_column)
    for int row < height
        for int column < width
            bool adjacent_outside = not inside_circle(row - 1, column, center_row, center_column, radius) or not inside_circle(row + 1, column, center_row, center_column, radius) or not inside_circle(row, column - 1, center_row, center_column, radius) or not inside_circle(row, column + 1, center_row, center_column, radius)
            if inside_circle(row, column, center_row, center_column, radius) and adjacent_outside
                grid[row][column] = "."
    for int j < int(len(analysis.loading.correlations))
        real64[] row = analysis.loading.correlations[j]
        int cell_row = center_row - plot.floor_value(row[1] * matrix.as_real(radius / 2) + 0.5)
        int column = center_column + plot.floor_value(row[0] * matrix.as_real(radius) + 0.5)
        grid[cell_row][column] = letters[j]
    lines = lines.concat(["", "circle radius {radius}"]).concat(plot.frame(grid))
    for int j < int(len(analysis.data.data.variables))
        real64[] row = analysis.loading.correlations[j]
        lines = lines.append(letters[j] + " " + analysis.data.data.variables[j] + " " + reals([row[0], row[1], row[0] * row[0] + row[1] * row[1]]))
    width = params.diagnostic_width
    height = params.diagnostic_height
    real64 maximum_t2 = 2.0 * params.t2_limit
    real64 maximum_spe = 2.0 * params.spe_limit
    grid = plot.grid(width, height)
    plot.Cell limit = plot.diagnostic_cell(params.t2_limit, params.spe_limit, maximum_t2, maximum_spe, width, height)
    axes(&grid, limit.row, limit.column)
    cells = []
    for Diagnostic row = analysis.diagnostics[]
        cells = cells.append(plot.diagnostic_cell(row.t2, row.spe, maximum_t2, maximum_spe, width, height))
    draw_points(&grid, cells)
    for Diagnostic row = analysis.supplementary_diagnostics[]
        plot.Cell cell = plot.diagnostic_cell(row.t2, row.spe, maximum_t2, maximum_spe, width, height)
        grid[cell.row][cell.column] = "*"
    lines = lines.concat(["", "diagnostic width {width} height {height} t2_max " + number(maximum_t2) + " spe_max " + number(maximum_spe)])
    return lines.concat(plot.frame(grid))

void save(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)

void run()
    dataset.Inputs input = dataset.read_inputs()
    dataset.Table data = input.data
    dataset.Params params = input.params
    Descriptive descriptive = summarize(data.ids, data.rows, int(len(data.variables)))
    AnalysisData retained_data = analysis_data(data.ids, data.rows, descriptive.summaries, params.missing)
    pca.Prepared prepared = pca.prepare(retained_data.rows, params.scaling)
    eigen.Result result = eigen.jacobi(prepared.values)
    eigen.Power[] powered = eigen.power(prepared.values, result)
    real64[] parallel_values = parallel_analysis(int(len(retained_data.rows)), int(len(data.variables)), params.repetitions, params.seed)
    Retention retained = retention(result.values, parallel_values, int(len(retained_data.rows)), params)
    Loadings loading = loading_analysis(result.values, result.vectors, prepared.values, retained.retained)
    Rotation rotation = varimax(loading.values, retained.retained, params.cycles)
    real64[][] scores = pca.scores(prepared.standardized, result.vectors)
    Diagnostic[] diagnosed = diagnose(prepared.standardized, scores, result.values, result.vectors, retained.retained, params.t2_limit, params.spe_limit, true)
    real64[][] supplementary = pca.supplementary(input.supplementary.rows, prepared.means, prepared.scales)
    real64[][] supplementary_scores = pca.scores(supplementary, result.vectors)
    Diagnostic[] supplementary_diagnostics = diagnose(supplementary, supplementary_scores, result.values, result.vectors, retained.retained, params.t2_limit, params.spe_limit, false)
    Nearest[] nearest = supplementary_nearest(supplementary_scores, scores, retained.retained)
    Adequacy adequacy = sampling_adequacy(prepared.correlation, int(len(retained_data.rows)))
    Analysis analysis = Analysis(input, descriptive.summaries, descriptive.incomplete, retained_data.ids, prepared, result, powered, parallel_values, retained, loading, rotation, scores, diagnosed, supplementary_scores, supplementary_diagnostics, nearest, adequacy)
    bool exists = file.is_directory("output")
    if not exists
        file.mkdir("output")
    save("eigen.txt", eigen_report(analysis))
    save("loadings.csv", loadings_report(analysis))
    save("scores.csv", scores_report(analysis))
    save("outliers.txt", outliers_report(analysis))
    save("plots.txt", plots_report(analysis))

run()
