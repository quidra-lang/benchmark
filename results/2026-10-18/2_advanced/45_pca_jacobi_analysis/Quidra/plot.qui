import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

int floor_value(real64 value)
    int result = math.floor(value)
    return result

string[][] grid(int width, int height)
    string[][] result = []
    for int row < height
        string[] cells = [for int column = (0:<width)[] then " "]
        result = result.append(cells)
    return result

string[] frame(string[][] cells_grid)
    string border = "+" + string.repeat("-", len(cells_grid[0])) + "+"
    string[] result = [border]
    for string[] row = cells_grid[]
        result = result.append("|" + row.join("") + "|")
    return result.append(border)

class Cell(int row, int column)
class Shaft(int row, int column, string character)

Cell cell(real64 x, real64 y, real64 maximum_x, real64 maximum_y, int width, int height)
    int column = floor_value((x + maximum_x) / (2.0 * maximum_x) * as_real(width))
    int row = floor_value((maximum_y - y) / (2.0 * maximum_y) * as_real(height))
    if column >= width
        column = width - 1
    if row >= height
        row = height - 1
    return Cell(row, column)

Cell diagnostic_cell(real64 t2, real64 spe, real64 maximum_x, real64 maximum_y, int width, int height)
    int column = floor_value(t2 / maximum_x * as_real(width))
    int vertical = floor_value(spe / maximum_y * as_real(height))
    int columns = width
    int rows = height
    if column >= columns
        column = columns - 1
    if vertical >= rows
        vertical = rows - 1
    return Cell(rows - 1 - vertical, column)

int absolute(int value)
    return if value < 0 then -value else value

int sign(int value)
    return if value < 0 then -1 elif value > 0 then 1 else 0

Shaft[] shaft(int origin_row, int origin_column, int tip_row, int tip_column)
    int dc = tip_column - origin_column
    int dr = tip_row - origin_row
    int steps = if absolute(dc) > absolute(dr) then absolute(dc) else absolute(dr)
    string character = if 2 * absolute(dr) <= absolute(dc) then "-" elif 2 * absolute(dc) <= absolute(dr) then "|" elif dc * dr < 0 then "/" else "\"
    Shaft[] result = []
    for 1 <= int step < steps
        int column = origin_column + sign(dc) * ((2 * step * absolute(dc) + steps) / (2 * steps))
        int row = origin_row + sign(dr) * ((2 * step * absolute(dr) + steps) / (2 * steps))
        result = result.append(Shaft(row, column, character))
    return result

string scree(int width, int length, int kaiser, int broken)
    string result = ""
    for 1 <= int position <= width
        result += if position == broken then "o" elif position == kaiser then ":" elif position <= length then "#" else " "
    return result
