public import matrix = "./matrix.qui"

class Result(real64[] values, real64[][] vectors, int sweeps)
class Power(real64 value, real64[] vector, int agreement, bool matched)

real64 off(real64[][] values)
    real64 result = 0.0
    for int p < int(len(values)) - 1
        for p + 1 <= int q < int(len(values))
            result += values[p][q] * values[p][q]
    return result

void rotate(real64[][] &a, real64[][] &vectors, int p, int q)
    real64 off_diagonal = a[p][q]
    if off_diagonal == 0.0
        return
    real64 theta = (a[q][q] - a[p][p]) / (2.0 * off_diagonal)
    real64 t = 1.0 / (matrix.absolute(theta) + matrix.root(theta * theta + 1.0))
    if theta < 0.0
        t = -t
    real64 c = 1.0 / matrix.root(t * t + 1.0)
    real64 s = t * c
    for int r < int(len(a))
        if r == p or r == q
            continue
        real64 rp = a[r][p]
        real64 rq = a[r][q]
        a[r][p] = c * rp - s * rq
        a[p][r] = a[r][p]
        a[r][q] = s * rp + c * rq
        a[q][r] = a[r][q]
    a[p][p] -= t * off_diagonal
    a[q][q] += t * off_diagonal
    a[p][q] = 0.0
    a[q][p] = 0.0
    for int r < int(len(vectors))
        real64 rp = vectors[r][p]
        real64 rq = vectors[r][q]
        vectors[r][p] = c * rp - s * rq
        vectors[r][q] = s * rp + c * rq

Result jacobi(real64[][] values)
    real64[][] a = matrix.copy(values)
    real64[][] vectors = matrix.identity(int(len(values)))
    real64 initial = off(a)
    int count = 0
    if initial > 0.0
        for 1 <= int sweep <= 100
            for int p < int(len(values)) - 1
                for p + 1 <= int q < int(len(values))
                    rotate(&a, &vectors, p, q)
            real64 remaining = off(a)
            if count == 0 and remaining < 1.0e-16 * initial
                count = sweep
            if remaining < 1.0e-22 * initial
                break
    int[] order = []
    for int index < int(len(values))
        int place = int(len(order))
        for int position < int(len(order))
            int previous = order[position]
            if a[index][index] > a[previous][previous]
                place = position
                break
        order = order[0:<place].append(index).concat(order[place:<int(len(order))])
    real64[] eigenvalues = []
    real64[][] eigenvectors = []
    for int index = order[]
        eigenvalues = eigenvalues.append(a[index][index])
        eigenvectors = eigenvectors.append(matrix.orient(matrix.normalize(matrix.column(vectors, index))))
    return Result(eigenvalues, eigenvectors, count)

Power[] power(real64[][] values, Result reference)
    real64[][] work = matrix.copy(values)
    Power[] result = []
    for int k < int(len(values))
        real64[] x = [for real64[] row = values[] then 1.0]
        int agreement = -1
        real64[] opposite = [for real64 value = reference.vectors[k][] then -value]
        for 1 <= int iteration <= 1000
            x = matrix.normalize(matrix.product(work, x))
            real64 first = matrix.maximum_difference(x, reference.vectors[k])
            real64 second = matrix.maximum_difference(x, opposite)
            real64 difference = if first < second then first else second
            if agreement < 0 and difference < 0.000001
                agreement = iteration
        real64[] product = matrix.product(work, x)
        real64 value = matrix.dot(x, product)
        real64[] vector = matrix.orient(matrix.normalize(x))
        bool matched = matrix.absolute(value - reference.values[k]) <= 1.0e-8 * reference.values[0] and matrix.maximum_difference(vector, reference.vectors[k]) <= 0.000001
        result = result.append(Power(value, vector, agreement, matched))
        work = matrix.deflate(work, value, vector)
    return result
