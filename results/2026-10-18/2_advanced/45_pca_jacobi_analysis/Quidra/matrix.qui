import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

real64 root(real64 value)
    real64 result = math.sqrt(value)
    return result

real64 logarithm(real64 value)
    real64 result = math.log(value)
    return result

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

real64[] zeros(int count)
    return [for int index = (0:<count)[] then 0.0]

real64[][] empty_matrix(int rows, int columns)
    return [for int index = (0:<rows)[] then zeros(columns)]

real64[][] copy(real64[][] values)
    return values

real64[][] identity(int size)
    real64[][] result = empty_matrix(size, size)
    for int index < size
        result[index][index] = 1.0
    return result

real64[] column(real64[][] values, int index)
    return [for real64[] row = values[] then row[index]]

real64 dot(real64[] first, real64[] second)
    real64 result = 0.0
    for int index < int(len(first))
        result += first[index] * second[index]
    return result

real64[] product(real64[][] values, real64[] vector)
    return [for real64[] row = values[] then dot(row, vector)]

real64 length(real64[] vector)
    return root(dot(vector, vector))

real64[] normalize(real64[] vector)
    real64 norm = length(vector)
    return [for real64 value = vector[] then value / norm]

real64[] orient(real64[] vector)
    int largest = 0
    for 1 <= int index < int(len(vector))
        if absolute(vector[index]) > absolute(vector[largest])
            largest = index
    return if vector[largest] < 0.0 then [for real64 value = vector[] then -value] else vector

real64 maximum_difference(real64[] first, real64[] second)
    real64 result = 0.0
    for int index < int(len(first))
        real64 difference = absolute(first[index] - second[index])
        if difference > result
            result = difference
    return result

real64[][] deflate(real64[][] values, real64 eigenvalue, real64[] vector)
    real64[][] result = copy(values)
    for int i < int(len(values))
        for int j < int(len(values))
            result[i][j] = values[i][j] - eigenvalue * vector[i] * vector[j]
    return result

class Inverse(real64[][] values, real64 determinant)

Inverse inverse_determinant(real64[][] values)
    int size = int(len(values))
    real64[][] work = []
    real64[][] unit = identity(size)
    for int index < size
        work = work.append(values[index].concat(unit[index]))
    real64 determinant = 1.0
    for int k < size
        real64 pivot = work[k][k]
        determinant *= pivot
        for int h < 2 * size
            work[k][h] /= pivot
        for int i < size
            if i == k
                continue
            real64 factor = work[i][k]
            for int h < 2 * size
                work[i][h] -= factor * work[k][h]
    real64[][] inverse = []
    for int i < size
        inverse = inverse.append(work[i][size:<2 * size])
    return Inverse(inverse, determinant)
