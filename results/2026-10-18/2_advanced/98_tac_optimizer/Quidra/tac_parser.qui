class Expression(string kind, string operation, string first, string second = "")
    string text()
        return if kind == "load" then operation + "[" + first + "]" else first + operation + second

    bool uses(string name)
        return first == name or second == name

class Instruction(string kind, string destination = "", string first = "", string second = "", string operation = "", string target = "", string array_name = "", string function_name = "", int count = 0)
    string[] operands()
        string[] result = []
        if first != ""
            result = result.append(first)
        if second != ""
            result = result.append(second)
        return result

    string[] used()
        string[] result = []
        for string operand = operands()[]
            if variable(operand)
                result = result.append(operand)
        return result

    Expression | none expression()
        if kind == "bin" or kind == "load"
            return Expression(kind, if kind == "bin" then operation else array_name, first, second)
        return none

    string text()
        if kind == "copy"
            return "{destination} = {first}"
        if kind == "bin"
            return "{destination} = {first} {operation} {second}"
        if kind == "load"
            return "{destination} = {array_name}[{first}]"
        if kind == "store"
            return "{array_name}[{first}] = {second}"
        if kind == "goto"
            return "goto {target}"
        if kind == "if"
            return "if {first} {operation} {second} goto {target}"
        if kind == "read"
            return "read {destination}"
        if kind == "return"
            return "return" + (if first == "" then "" else " " + first)
        if kind == "call"
            return (if destination == "" then "" else destination + " = ") + "call {function_name} {count}"
        return "{kind} {first}"

class Line(string label = "", Instruction instruction = Instruction("copy"))
class Function(string name, string[] parameters, Line[] code, int temporary = 0, int preheader = 0)
    Instruction[] instructions()
        Instruction[] result = []
        for Line line = code[]
            if line.label == ""
                result = result.append(line.instruction)
        return result

    string[] text()
        string[] result = ["func " + name + (if len(parameters) == 0 then "" else " " + parameters.join(" "))]
        for Line line = code[]
            result = result.append(if line.label != "" then line.label + ":" else "    " + line.instruction.text())
        return result.append("end")

class Array(string name, int size)
class Program(Array[] arrays, Function[] functions)
    string[] text()
        string[] result = []
        for Array declaration = arrays[]
            result = result.append("array {declaration.name} {declaration.size}")
        for Function definition = functions[]
            if len(result) > 0
                result = result.append("")
            result = result.concat(definition.text())
        return result

class Indexed(string name, string index)

bool variable(string operand)
    return operand != "" and operand[0] != "-" and not (operand[0] >= "0" and operand[0] <= "9")

string operand_text(string text)
    return if variable(text) then text else "{int.parse(text)}"

string[] words(string line)
    string[] result = []
    for string word = line.split(" ")[]
        if word != ""
            result = result.append(word)
    return result

Indexed indexed(string text)
    int opening = 0
    while text[opening] != "["
        opening += 1
    return Indexed(text[0:<opening], operand_text(text[opening + 1:<int(len(text)) - 1]))

Program parse(string text)
    Program result = Program([], [])
    for string line = text.split(NL)[]
        string[] fields = words(line)
        if len(fields) == 0 or fields[0].starts_with("#")
            continue
        if fields[0] == "array"
            result.arrays = result.arrays.append(Array(fields[1], int.parse(fields[2])))
            continue
        if fields[0] == "func"
            result.functions = result.functions.append(Function(fields[1], fields[2:<int(len(fields))], []))
            continue
        if fields[0] == "end"
            continue
        int last = int(len(result.functions)) - 1
        if len(fields) == 1 and fields[0].ends_with(":")
            result.functions[last].code = result.functions[last].code.append(Line(fields[0][0:<int(len(fields[0])) - 1]))
            continue
        Instruction entry = Instruction("copy")
        string first_word = fields[0]
        if first_word == "goto"
            entry = Instruction("goto", target = fields[1])
        elif first_word == "if"
            entry = Instruction("if", first = operand_text(fields[1]), second = operand_text(fields[3]), operation = fields[2], target = fields[5])
        elif first_word == "param" or first_word == "return" or first_word == "read" or first_word == "print"
            entry.kind = first_word
            if len(fields) > 1
                if first_word == "read"
                    entry.destination = fields[1]
                else
                    entry.first = operand_text(fields[1])
        elif first_word.contains("[")
            Indexed target = indexed(first_word)
            entry = Instruction("store", first = target.index, second = operand_text(fields[2]), array_name = target.name)
        else
            int start = if first_word == "call" then 0 else 2
            if start == 2
                entry.destination = first_word
            if fields[start] == "call"
                entry.kind = "call"
                entry.function_name = fields[start + 1]
                entry.count = int.parse(fields[start + 2])
            elif len(fields) == 5
                entry.kind = "bin"
                entry.first = operand_text(fields[2])
                entry.operation = fields[3]
                entry.second = operand_text(fields[4])
            elif fields[2].contains("[")
                Indexed source = indexed(fields[2])
                entry.kind = "load"
                entry.first = source.index
                entry.array_name = source.name
            else
                entry.first = operand_text(fields[2])
        result.functions[last].code = result.functions[last].code.append(Line(instruction = entry))
    return result

int operation(string operator_text, int first, int second)
    if operator_text == "+"
        return first + second
    if operator_text == "-"
        return first - second
    if operator_text == "*"
        return first * second
    if operator_text == "/"
        return first / second
    if operator_text == "%"
        return first % second
    bool result = if operator_text == "<" then first < second elif operator_text == "<=" then first <= second elif operator_text == ">" then first > second elif operator_text == ">=" then first >= second elif operator_text == "==" then first == second else first != second
    return if result then 1 else 0

map.Map<string, int> labels(const Function definition)
    map.Map<string, int> result = map.Map<string, int>()
    int index = 0
    for Line line = definition.code[]
        if line.label != ""
            .result.set(line.label, index)
        else
            index += 1
    return result
