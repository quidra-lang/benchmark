import predicates = "./predicates.qui"
import triangulation = "./triangulation.qui"
import voronoi = "./voronoi.qui"
import proximity = "./proximity.qui"
import plot = "./plot.qui"

real64 as_real(int value)
    real64 result = real64(value)
    return result

string real_text(real64 value)
    string result = "{value:frac=3}"
    return if result == "-0.000" then "0.000" else result

string words(int[] values)
    string[] fields = [for int value = values[] then "{value}"]
    return fields.join(" ")

string yes_no(bool value)
    return if value then "yes" else "no"

string optional_id(int value)
    return if value == 0 then "-" else "{value}"

string[] read_lines(string path)
    string content = file.read(path)
    string[] result = content.split(NL)
    return result[0:<int(len(result)) - 1]

bool integer_word(string value)
    int[] codes = value.codepoints()
    int start = if len(codes) > 0 and codes[0] == 45 then 1 else 0
    if int(len(codes)) == start
        return false
    for start <= int i < int(len(codes))
        if codes[i] < 48 or codes[i] > 57
            return false
    return true

int integer_value(string value)
    int[] codes = value.codepoints()
    int start = if codes[0] == 45 then 1 else 0
    int result = 0
    for start <= int i < int(len(codes))
        result = result * 10 + codes[i] - 48
    return if start == 1 then -result else result

class Input(int[][] points, int line_count, string[] rejected)
class Params(int plot_width, int plot_height, string[] plot_layers, string[] sections, int[] alpha, string[] queries)

Input read_points()
    string[] lines = read_lines("input/points.txt")
    int[][] points = []
    string[] rejected = []
    for int i < int(len(lines))
        string line = lines[i]
        if len(line) == 0 or line[0] == "#"
            continue
        string[] fields = line.split(" ")
        if len(fields) != 2 or not integer_word(fields[0]) or not integer_word(fields[1])
            rejected = rejected.append("reject {i + 1} format")
            continue
        int x = integer_value(fields[0])
        int y = integer_value(fields[1])
        if x < 0 or x > 1000 or y < 0 or y > 1000
            rejected = rejected.append("reject {i + 1} range")
            continue
        int duplicate = 0
        for int site < int(len(points))
            if points[site][0] == x and points[site][1] == y
                duplicate = site + 1
                break
        if duplicate > 0
            rejected = rejected.append("reject {i + 1} duplicate {duplicate}")
        else
            points = points.append([x, y])
    return Input(points, int(len(lines)), rejected)

Params read_params()
    int width = 61
    int height = 31
    string[] layers = ["edges", "hull", "sites"]
    string[] sections = ["summary"]
    int[] alpha = []
    string[] queries = []
    for string line = read_lines("input/params.txt")[]
        if len(line) == 0 or line[0] == "#"
            continue
        string[] fields = line.split(" ")
        string name = fields[0]
        string[] values = fields[1:<int(len(fields))]
        if name == "plot"
            width = integer_value(values[0])
            height = integer_value(values[1])
        elif name == "plot_layers"
            layers = values
        elif name == "sections"
            sections = values
        elif name == "alpha"
            alpha = [for string value = values[] then integer_value(value)]
        else
            queries = queries.append(line[6:<int(len(line))])
    return Params(width, height, layers, sections, alpha, queries)

real64 arctangent(real64 value)
    bool negative = value < 0.0
    real64 reduced = if negative then -value else value
    bool reciprocal = reduced > 1.0
    if reciprocal
        reduced = 1.0 / reduced
    real64 offset = 0.0
    if reduced > 0.4142135623730950488
        reduced = (reduced - 1.0) / (reduced + 1.0)
        offset = 0.7853981633974483096
    real64 term = reduced
    real64 total = 0.0
    for int i < 40
        total += term / as_real(2 * i + 1)
        term *= -reduced * reduced
    total += offset
    if reciprocal
        total = 1.5707963267948966192 - total
    return if negative then -total else total

real64 angle2(real64 vertical, real64 horizontal)
    if horizontal > 0.0
        return arctangent(vertical / horizontal)
    if horizontal < 0.0
        real64 result = arctangent(vertical / horizontal)
        return if vertical >= 0.0 then result + 3.141592653589793 else result - 3.141592653589793
    return if vertical > 0.0 then 1.5707963267948966192 elif vertical < 0.0 then -1.5707963267948966192 else 0.0

int[] circle_basis(int[][] points, int[] basis)
    if len(basis) == 3 and predicates.orient(points[basis[0] - 1], points[basis[1] - 1], points[basis[2] - 1]) < 0
        int temporary = basis[1]
        basis[1] = basis[2]
        basis[2] = temporary
    return basis

int circle_value(int[][] points, int[] basis, int[] point)
    if len(basis) == 1
        return -predicates.d2(points[basis[0] - 1], point)
    if len(basis) == 2
        return -predicates.dot(point, points[basis[0] - 1], points[basis[1] - 1])
    return predicates.incircle(points[basis[0] - 1], points[basis[1] - 1], points[basis[2] - 1], point)

int[] convex_hull(int[][] points, int[] sites)
    if len(sites) <= 2
        return sites.sorted()
    int[] ordered = []
    for int site = sites[]
        int place = int(len(ordered))
        for int k < int(len(ordered))
            int other = ordered[k]
            if points[site - 1][0] < points[other - 1][0] or points[site - 1][0] == points[other - 1][0] and points[site - 1][1] < points[other - 1][1]
                place = k
                break
        ordered = ordered[0:<place].append(site).concat(ordered[place:<int(len(ordered))])
    int[] lower = []
    for int site = ordered[]
        while len(lower) >= 2 and predicates.orient(points[lower[int(len(lower)) - 2] - 1], points[lower[int(len(lower)) - 1] - 1], points[site - 1]) <= 0
            lower = lower[0:<int(len(lower)) - 1]
        lower = lower.append(site)
    int[] upper = []
    for int site = ordered[::-1][]
        while len(upper) >= 2 and predicates.orient(points[upper[int(len(upper)) - 2] - 1], points[upper[int(len(upper)) - 1] - 1], points[site - 1]) <= 0
            upper = upper[0:<int(len(upper)) - 1]
        upper = upper.append(site)
    int[] hull = lower[0:<int(len(lower)) - 1].concat(upper[0:<int(len(upper)) - 1])
    int start = 0
    for 1 <= int i < int(len(hull))
        if hull[i] < hull[start]
            start = i
    return hull[start:<int(len(hull))].concat(hull[0:<start])

class Cell(int[] vertices, real64 clipped, bool bounded, real64 area, int[] incoming, int[] outgoing)
class AlphaResult(int alpha, int faces, int edges, int boundary, int dangling, int isolated, int components, int holes, int area2)

class Report self(int[][] points, int line_count, string[] rejected, Params params)
    int n = int(len(points))
    triangulation.Mesh mesh = triangulation.new_mesh(points)
    triangulation.Insertion[] insertions = []
    int[][] triangles = []
    int[][] directed = []
    int[][] edge_triangles = []
    int[][] edge_index = []
    int[][] edges = []
    int[] length2 = []
    int[] hull_next = array(len(points), fill = 0)
    int[] hull_prev = array(len(points), fill = 0)
    int[] hull = []
    int[][] hull_edges = []
    real64 hull_perimeter = 0.0
    int hull_area2 = 0
    int[][] neighbors = []
    int[] degree = []
    int[] area2 = []
    string[] kinds = []
    int[] kind_counts = [0, 0, 0]
    real64[] min_angles = []
    real64[] max_angles = []
    int[] angle_bins = array(6, fill = 0)
    real64 min_angle_total = 0.0
    int minimum_triangle = 0
    int maximum_triangle = 0
    int[][] centers = []
    real64[] radius2 = []
    string[] positions = []
    int[] position_counts = [0, 0, 0]
    string[] duals = []
    int[] empty_candidates = []
    int empty_vertex = 0
    Cell[] cells = []
    real64 cell_total = 0.0
    real64 clip_total = 0.0
    int largest_cell = 0
    int[] nearest_sites = []
    int[][] mutual_pairs = []
    int closest = 0
    int[][] components = []
    int[] component_number = array(len(points), fill = 0)
    int[][] component_pairs = []
    int[][] mst = []
    bool[] mst_set = []
    bool[] gabriel = []
    bool[] rng = []
    int gabriel_count = 0
    int rng_count = 0
    int[] gg_degree = array(len(points), fill = 0)
    int[] rng_degree = array(len(points), fill = 0)
    int[] mst_degree = array(len(points), fill = 0)
    real64 mst_length = 0.0
    int[] diameter = [1, 2]
    int diameter2 = 0
    real64 width_value = inf
    int[] width_edge = []
    int[] enclosing_center = []
    real64 enclosing_radius2 = 0.0
    int[] enclosing_sites = []
    int[][] layers = []
    int[] depth = array(len(points), fill = 0)
    real64[][] path_distances = [for int[] point = points[] then []]
    int[][] path_previous = [for int[] point = points[] then []]
    int pair_count = 0
    real64 maximum_stretch = 0.0
    int[] stretch_pair = []
    real64 stretch_length = 0.0
    real64 stretch_distance = 0.0
    real64 mean_stretch = 0.0
    AlphaResult[] alpha_results = []
    string[] answers = []
    string[] delaunay_plot = []
    string[] voronoi_plot = []

    void .build()
        for 4 <= int site <= n
            insertions = insertions.append(.mesh.insert(site))
        triangles = mesh.triangles()
        for 1 <= int u <= n
            directed = directed.append([for int v = (1:n)[] then mesh.remaining(u, v)])
            edge_triangles = edge_triangles.append(array(nat(n), fill = 0))
            edge_index = edge_index.append(array(nat(n), fill = 0))
        for int k < int(len(triangles))
            int[] triangle = triangles[k]
            for int side < 3
                edge_triangles[triangle[side] - 1][triangle[(side + 1) % 3] - 1] = k + 1
        for 1 <= int i <= n
            for i + 1 <= int j <= n
                if directed[i - 1][j - 1] > 0 or directed[j - 1][i - 1] > 0
                    int index = int(len(edges)) + 1
                    edges = edges.append([i, j])
                    length2 = length2.append(predicates.d2(points[i - 1], points[j - 1]))
                    edge_index[i - 1][j - 1] = index
                    edge_index[j - 1][i - 1] = index
        int start = n + 1
        for int[] edge = mesh.hull_edges()[]
            hull_next[edge[0] - 1] = edge[1]
            hull_prev[edge[1] - 1] = edge[0]
            if edge[0] < start
                start = edge[0]
        hull = [start]
        while hull_next[hull[int(len(hull)) - 1] - 1] != start
            hull = hull.append(hull_next[hull[int(len(hull)) - 1] - 1])
        for int i < int(len(hull))
            int u = hull[i]
            int v = hull[(i + 1) % int(len(hull))]
            hull_edges = hull_edges.append([u, v])
            hull_perimeter += proximity.root(predicates.d2(points[u - 1], points[v - 1]))
            hull_area2 += points[u - 1][0] * points[v - 1][1] - points[v - 1][0] * points[u - 1][1]
        int[][] adjacent = [for int[] point = points[] then []]
        for int[] edge = edges[]
            adjacent[edge[0] - 1] = adjacent[edge[0] - 1].append(edge[1])
            adjacent[edge[1] - 1] = adjacent[edge[1] - 1].append(edge[0])
        for 1 <= int site <= n
            int[] order = voronoi.neighbor_order(site, adjacent[site - 1], directed, hull_next)
            neighbors = neighbors.append(order)
            degree = degree.append(int(len(order)))

    void .analyze_triangles()
        for int k < int(len(triangles))
            int[] triangle = triangles[k]
            int[] a = points[triangle[0] - 1]
            int[] b = points[triangle[1] - 1]
            int[] c = points[triangle[2] - 1]
            int area = predicates.orient(a, b, c)
            int[] products = [predicates.dot(a, b, c), predicates.dot(b, c, a), predicates.dot(c, a, b)]
            int[] lengths = [predicates.d2(b, c), predicates.d2(c, a), predicates.d2(a, b)]
            int kind = 0
            if products[0] == 0 or products[1] == 0 or products[2] == 0
                kind = 1
            elif products[0] < 0 or products[1] < 0 or products[2] < 0
                kind = 2
            string[] names = ["acute", "right", "obtuse"]
            kinds = kinds.append(names[kind])
            kind_counts[kind] += 1
            int shortest = 0
            int longest = 0
            for 1 <= int i < 3
                if lengths[i] < lengths[shortest]
                    shortest = i
                if lengths[i] > lengths[longest]
                    longest = i
            real64 minimum = angle2(as_real(area), as_real(products[shortest])) * 180.0 / 3.141592653589793
            real64 maximum = angle2(as_real(area), as_real(products[longest])) * 180.0 / 3.141592653589793
            area2 = area2.append(area)
            min_angles = min_angles.append(minimum)
            max_angles = max_angles.append(maximum)
            int bin_index = 0
            while minimum >= as_real((bin_index + 1) * 10)
                bin_index += 1
            angle_bins[bin_index] += 1
            min_angle_total += minimum
            if minimum_triangle == 0 or minimum < min_angles[minimum_triangle - 1]
                minimum_triangle = k + 1
            if maximum_triangle == 0 or maximum > max_angles[maximum_triangle - 1]
                maximum_triangle = k + 1

    void .analyze_voronoi()
        for int k < int(len(triangles))
            int[] triangle = triangles[k]
            int[] a = points[triangle[0] - 1]
            int[] b = points[triangle[1] - 1]
            int[] c = points[triangle[2] - 1]
            int[] center = predicates.center(a, b, c)
            string position = voronoi.position(center, points, hull)
            centers = centers.append(center)
            radius2 = radius2.append(voronoi.radius2(a, b, c))
            positions = positions.append(position)
            int index = if position == "inside" then 0 elif position == "on" then 1 else 2
            position_counts[index] += 1
            if position == "inside"
                empty_candidates = empty_candidates.append(k + 1)
                if empty_vertex == 0 or radius2[k] > radius2[empty_vertex - 1]
                    empty_vertex = k + 1
        for int[] edge = edges[]
            int left = edge_triangles[edge[0] - 1][edge[1] - 1]
            int right = edge_triangles[edge[1] - 1][edge[0] - 1]
            if left > 0 and right > 0
                duals = duals.append("segment {left} {right}")
            else
                int u = if left > 0 then edge[0] else edge[1]
                int v = if left > 0 then edge[1] else edge[0]
                int number = if left > 0 then left else right
                duals = duals.append("ray {number} {words(voronoi.outward(points, u, v))}")
        for 1 <= int site <= n
            int[] vertices = []
            int[][] cell_centers = []
            for int other = neighbors[site - 1][]
                int number = edge_triangles[site - 1][other - 1]
                if number > 0
                    vertices = vertices.append(number)
                    cell_centers = cell_centers.append(centers[number - 1])
            real64 clipped = voronoi.clipped_area(points, site, neighbors[site - 1])
            bool bounded = hull_next[site - 1] == 0
            real64 area = 0.0
            int[] incoming = []
            int[] outgoing = []
            if bounded
                area = voronoi.bounded_area(points[site - 1], cell_centers)
                cell_total += area
                if largest_cell == 0 or area > cells[largest_cell - 1].area
                    largest_cell = site
            else
                incoming = voronoi.outward(points, site, hull_next[site - 1])
                outgoing = voronoi.outward(points, hull_prev[site - 1], site)
            clip_total += clipped
            cells = cells.append(Cell(vertices, clipped, bounded, area, incoming, outgoing))

    void .analyze_proximity()
        nearest_sites = proximity.nearest(points, neighbors)
        for 1 <= int site <= n
            int other = nearest_sites[site - 1]
            if site < other and nearest_sites[other - 1] == site
                mutual_pairs = mutual_pairs.append([site, other])
        closest = 1
        for 1 <= int i < int(len(edges))
            if length2[i] < length2[closest - 1]
                closest = i + 1
        components = proximity.components(nearest_sites)
        for int k < int(len(components))
            int[] pair = []
            for int site = components[k][]
                component_number[site - 1] = k + 1
                int other = nearest_sites[site - 1]
                if site < other and nearest_sites[other - 1] == site
                    pair = [site, other]
            component_pairs = component_pairs.append(pair)
        mst = proximity.kruskal(points, edges)
        mst_set = array(len(edges), fill = false)
        gabriel = array(len(edges), fill = false)
        rng = array(len(edges), fill = false)
        for int[] edge = mst[]
            int i = edge[0] - 1
            int j = edge[1] - 1
            mst_set[edge_index[i][j] - 1] = true
            mst_length += proximity.root(predicates.d2(points[i], points[j]))
            mst_degree[i] += 1
            mst_degree[j] += 1
        for int k < int(len(edges))
            int[] edge = edges[k]
            if proximity.gabriel(points, edge, directed)
                gabriel[k] = true
                gabriel_count += 1
                gg_degree[edge[0] - 1] += 1
                gg_degree[edge[1] - 1] += 1
            if proximity.relative(points, edge)
                rng[k] = true
                rng_count += 1
                rng_degree[edge[0] - 1] += 1
                rng_degree[edge[1] - 1] += 1

    void .enclosing_circle()
        int[] basis = []
        for int i < int(len(hull))
            int site = hull[i]
            if len(basis) == 0 or circle_value(points, basis, points[site - 1]) < 0
                basis = [site]
                for int j < i
                    int second = hull[j]
                    if circle_value(points, basis, points[second - 1]) < 0
                        basis = [site, second]
                        for int k < j
                            int third = hull[k]
                            if circle_value(points, basis, points[third - 1]) < 0
                                basis = circle_basis(points, [site, second, third])
        int[] boundary = []
        for 1 <= int site <= n
            if circle_value(points, basis, points[site - 1]) == 0
                boundary = boundary.append(site)
        int[] diameter_pair = []
        for int i < int(len(boundary)) - 1
            for i + 1 <= int j < int(len(boundary))
                int a = boundary[i]
                int b = boundary[j]
                bool valid = true
                for int other = boundary[]
                    if predicates.dot(points[other - 1], points[a - 1], points[b - 1]) != 0
                        valid = false
                if valid
                    diameter_pair = [a, b]
                    break
            if len(diameter_pair) > 0
                break
        if len(diameter_pair) > 0
            int[] a = points[diameter_pair[0] - 1]
            int[] b = points[diameter_pair[1] - 1]
            enclosing_center = [a[0] + b[0], a[1] + b[1], 2]
            enclosing_radius2 = as_real(predicates.d2(a, b)) / 4.0
        else
            int[] ordered = circle_basis(points, boundary)
            int[] a = points[ordered[0] - 1]
            int[] b = points[ordered[1] - 1]
            int[] c = points[ordered[2] - 1]
            enclosing_center = predicates.center(a, b, c)
            enclosing_radius2 = voronoi.radius2(a, b, c)
        enclosing_sites = boundary

    void .analyze_extent()
        diameter2 = predicates.d2(points[0], points[1])
        for 1 <= int i <= n
            for i + 1 <= int j <= n
                int value = predicates.d2(points[i - 1], points[j - 1])
                if value > diameter2
                    diameter = [i, j]
                    diameter2 = value
        for int[] edge = hull_edges[]
            int[] a = points[edge[0] - 1]
            int[] b = points[edge[1] - 1]
            int maximum = 0
            for int site = hull[]
                int value = predicates.orient(a, b, points[site - 1])
                if value > maximum
                    maximum = value
            real64 width = as_real(maximum) / proximity.root(predicates.d2(a, b))
            if width < width_value
                width_value = width
                width_edge = edge
        .self.enclosing_circle()

    void .analyze_layers()
        int[] remaining = (1:n)[]
        while len(remaining) > 0
            int[] layer = convex_hull(points, remaining)
            layers = layers.append(layer)
            bool[] removed = array(nat(n), fill = false)
            for int site = layer[]
                depth[site - 1] = int(len(layers))
                removed[site - 1] = true
            remaining = [for int site = remaining[] if not removed[site - 1] then site]

    proximity.Shortest .shortest_from(int site)
        if len(path_distances[site - 1]) == 0
            proximity.Shortest path = proximity.dijkstra(points, neighbors, site)
            path_distances[site - 1] = path.distances
            path_previous[site - 1] = path.previous
        return proximity.Shortest(path_distances[site - 1], path_previous[site - 1])

    void .analyze_spanner()
        pair_count = n * (n - 1) / 2
        real64 total = 0.0
        for 1 <= int i < n
            proximity.Shortest path = .self.shortest_from(i)
            for i + 1 <= int j <= n
                real64 length = path.distances[j - 1]
                real64 distance = proximity.root(predicates.d2(points[i - 1], points[j - 1]))
                real64 stretch = length / distance
                total += stretch
                if len(stretch_pair) == 0 or stretch > maximum_stretch
                    maximum_stretch = stretch
                    stretch_pair = [i, j]
                    stretch_length = length
                    stretch_distance = distance
        mean_stretch = total / as_real(pair_count)

    void .analyze_alpha()
        for int alpha = params.alpha[]
            int faces = 0
            int total_area = 0
            int[] incidence = array(len(edges), fill = 0)
            bool[] selected = array(len(edges), fill = false)
            for int k < int(len(triangles))
                if radius2[k] <= as_real(alpha)
                    faces += 1
                    total_area += area2[k]
                    int[] triangle = triangles[k]
                    for int side < 3
                        int index = edge_index[triangle[side] - 1][triangle[(side + 1) % 3] - 1] - 1
                        incidence[index] += 1
                        selected[index] = true
            for int k < int(len(edges))
                if gabriel[k] and length2[k] <= 4 * alpha
                    selected[k] = true
            proximity.DisjointSets sets = proximity.new_sets(n)
            bool[] incident = array(nat(n), fill = false)
            int selected_edges = 0
            int boundary = 0
            int dangling = 0
            int isolated = 0
            for int k < int(len(edges))
                if selected[k]
                    selected_edges += 1
                    if incidence[k] == 1
                        boundary += 1
                    if incidence[k] == 0
                        dangling += 1
                    int[] edge = edges[k]
                    .sets.join(edge[0], edge[1])
                    incident[edge[0] - 1] = true
                    incident[edge[1] - 1] = true
            for bool value = incident[]
                if not value
                    isolated += 1
            alpha_results = alpha_results.append(AlphaResult(alpha, faces, selected_edges, boundary, dangling, isolated, sets.count, sets.count - (n - selected_edges + faces), total_area))

    string locate(int[] query)
        int nearest = 1
        int best = predicates.d2(points[0], query)
        for 1 <= int site < n
            int distance = predicates.d2(points[site], query)
            if distance < best
                nearest = site + 1
                best = distance
        string location = "outside"
        if best == 0
            location = "vertex {nearest}"
        else
            for int[] edge = edges[]
                int[] a = points[edge[0] - 1]
                int[] b = points[edge[1] - 1]
                if predicates.orient(a, b, query) == 0 and predicates.dot(query, a, b) < 0
                    location = "edge {words(edge)}"
                    break
            if location == "outside"
                for int[] triangle = triangles[]
                    int[] a = points[triangle[0] - 1]
                    int[] b = points[triangle[1] - 1]
                    int[] c = points[triangle[2] - 1]
                    if predicates.orient(a, b, query) > 0 and predicates.orient(b, c, query) > 0 and predicates.orient(c, a, query) > 0
                        location = "triangle {words(triangle)}"
                        break
        return "{location} nearest {nearest} d2 {best}"

    string .answer(string query)
        string[] fields = query.split(" ")
        string name = fields[0]
        int[] values = [for string value = fields[1:<int(len(fields))][] then integer_value(value)]
        if name == "route" or name == "path" or name == "neighbors" or name == "edge"
            for int site = values[]
                if site < 1 or site > n
                    return "{query} error unknown_site"
            if name == "edge" and values[0] == values[1]
                return "{query} error same_site"
        string result = ""
        if name == "locate"
            result = locate(values)
        elif name == "walk"
            triangulation.Walk walk = mesh.visibility_walk(values, triangles, edge_triangles)
            string stopping = if len(walk.outside) > 0 then "outside {words(walk.outside)}" else "triangle {walk.path[int(len(walk.path)) - 1]}"
            result = "steps {int(len(walk.path)) - 1} {stopping} path {words(walk.path)}"
        elif name == "natural"
            int count = 0
            bool[] present = array(nat(n), fill = false)
            for int[] triangle = triangles[]
                if predicates.incircle(points[triangle[0] - 1], points[triangle[1] - 1], points[triangle[2] - 1], values) > 0
                    count += 1
                    for int site = triangle[]
                        present[site - 1] = true
            int[] sites = [for int site = (1:n)[] if present[site - 1] then site]
            string sequence = if len(sites) == 0 then "-" else words(sites)
            result = "triangles {count} sites {sequence}"
        elif name == "route"
            proximity.Route route = proximity.greedy_route(points, neighbors, values[0], values[1])
            result = "hops {int(len(route.path)) - 1} length {real_text(route.length)} path {words(route.path)}"
        elif name == "path"
            int first = values[0]
            int second = values[1]
            proximity.Shortest shortest = .self.shortest_from(first)
            int[] reverse = [second]
            while reverse[int(len(reverse)) - 1] != first
                reverse = reverse.append(shortest.previous[reverse[int(len(reverse)) - 1] - 1])
            int[] path = reverse[::-1]
            string stretch = if first == second then "-" else real_text(shortest.distances[second - 1] / proximity.root(predicates.d2(points[first - 1], points[second - 1])))
            result = "length {real_text(shortest.distances[second - 1])} stretch {stretch} hops {int(len(path)) - 1} sites {words(path)}"
        elif name == "neighbors"
            result = "degree {degree[values[0] - 1]} sites {words(neighbors[values[0] - 1])}"
        else
            int i = values[0]
            int j = values[1]
            int index = edge_index[i - 1][j - 1] - 1
            if index >= 0
                result = "delaunay len2 {length2[index]} gabriel {yes_no(gabriel[index])} rng {yes_no(rng[index])} mst {yes_no(mst_set[index])} dual {duals[index]}"
            else
                string[] crossings = []
                int[] a = points[i - 1]
                int[] b = points[j - 1]
                for int[] edge = edges[]
                    int[] p = points[edge[0] - 1]
                    int[] q = points[edge[1] - 1]
                    if predicates.orient(a, b, p) * predicates.orient(a, b, q) < 0 and predicates.orient(p, q, a) * predicates.orient(p, q, b) < 0
                        crossings = crossings.append("{edge[0]}-{edge[1]}")
                result = "missing crossings {len(crossings)}" + (if len(crossings) == 0 then "" else " " + crossings.join(" "))
        return "{query} {result}"

    void .draw()
        plot.Canvas canvas = plot.Canvas(params.plot_width, params.plot_height)
        for string layer = params.plot_layers[]
            if layer == "sites"
                for int[] point = points[]
                    .canvas.mark(point, "o")
            elif layer == "circle"
                if empty_vertex > 0
                    .canvas.mark(centers[empty_vertex - 1], "@")
            else
                int[][] selected = if layer == "edges" then edges elif layer == "mst" then mst else hull_edges
                string character = if layer == "edges" then "." elif layer == "mst" then "*" else "#"
                for int[] edge = selected[]
                    .canvas.line(points[edge[0] - 1], points[edge[1] - 1], character)
        delaunay_plot = canvas.framed()
        canvas = plot.Canvas(params.plot_width, params.plot_height)
        .canvas.draw_voronoi(points)
        voronoi_plot = canvas.framed()

    string[] section_input()
        string[] lines = ["lines {line_count}", "accepted {n}", "rejected {len(rejected)}"]
        return lines.concat(rejected)

    string[] section_summary()
        int flips = 0
        int outside = 0
        int maximum = -1
        for int i < int(len(insertions))
            triangulation.Insertion insertion = insertions[i]
            flips += insertion.flips
            if insertion.kind == "outside"
                outside += 1
            if maximum < 0 or insertion.flips > insertions[maximum].flips
                maximum = i
        string maximum_line = if maximum < 0 then "max_flips none" else "max_flips {maximum + 4} {insertions[maximum].flips}"
        return [
            "sites {n}",
            "triangles {len(triangles)}",
            "edges {len(edges)}",
            "hull_vertices {len(hull)}",
            "interior_sites {n - int(len(hull))}",
            "euler {n - int(len(edges)) + int(len(triangles))}",
            "flips {flips}",
            "outside_insertions {outside}",
            maximum_line,
            "acute {kind_counts[0]}",
            "right {kind_counts[1]}",
            "obtuse {kind_counts[2]}",
        ]

    string[] section_insertions()
        string[] lines = ["init {words(mesh.initial)}"]
        for int i < int(len(insertions))
            triangulation.Insertion insertion = insertions[i]
            string description = if insertion.kind == "inside" then "inside {words(insertion.containing)}" else "outside {insertion.visible}"
            lines = lines.append("insert {i + 4} {description} flips {insertion.flips} triangles {insertion.triangles} hull {insertion.hull}")
        return lines

    string[] section_triangles()
        string[] lines = []
        for int k < int(len(triangles))
            int[] triangle = triangles[k]
            int a = triangle[0] - 1
            int b = triangle[1] - 1
            int c = triangle[2] - 1
            string adjacent = "{optional_id(edge_triangles[c][b])} {optional_id(edge_triangles[a][c])} {optional_id(edge_triangles[b][a])}"
            lines = lines.append("tri {k + 1} {words(triangle)} area2 {area2[k]} {kinds[k]} adj {adjacent}")
        return lines

    string[] section_edges()
        string[] lines = []
        for int k < int(len(edges))
            int[] edge = edges[k]
            int left = edge_triangles[edge[0] - 1][edge[1] - 1]
            int right = edge_triangles[edge[1] - 1][edge[0] - 1]
            string kind = if left > 0 and right > 0 then "inner" else "hull"
            lines = lines.append("edge {words(edge)} {kind} len2 {length2[k]} left {optional_id(left)} right {optional_id(right)}")
        return lines

    string[] section_hull()
        return ["hull_vertices {len(hull)}", "order {words(hull)}", "perimeter {real_text(hull_perimeter)}", "area2 {hull_area2}"]

    string[] section_convex_layers()
        string[] lines = ["layers {len(layers)}"]
        for int k < int(len(layers))
            lines = lines.append("layer {k + 1} size {len(layers[k])} sites {words(layers[k])}")
        return lines

    string[] section_quality()
        string[] lines = [
            "min_angle {real_text(min_angles[minimum_triangle - 1])} tri {minimum_triangle}",
            "max_angle {real_text(max_angles[maximum_triangle - 1])} tri {maximum_triangle}",
            "mean_min_angle {real_text(min_angle_total / as_real(int(len(triangles))))}",
        ]
        for int i < 6
            lines = lines.append("bin {i * 10} {(i + 1) * 10} {angle_bins[i]}")
        return lines

    string[] section_vertices()
        string[] lines = ["inside {position_counts[0]}", "on {position_counts[1]}", "outside {position_counts[2]}"]
        for int k < int(len(centers))
            int[] center = centers[k]
            lines = lines.append("v {k + 1} {predicates.fraction(center[0], center[2])} {predicates.fraction(center[1], center[2])} r {real_text(voronoi.root(radius2[k]))} {positions[k]}")
        return lines

    string[] section_voronoi_edges()
        string[] lines = ["segments {int(len(edges)) - int(len(hull))}", "rays {len(hull)}"]
        for int k < int(len(edges))
            lines = lines.append("ve {words(edges[k])} {duals[k]}")
        return lines

    string[] section_cells()
        string[] lines = ["bounded {n - int(len(hull))}", "unbounded {len(hull)}", "total_area {real_text(cell_total)}", "clip_total {real_text(clip_total)}"]
        lines = lines.append(if largest_cell == 0 then "largest none" else "largest {largest_cell} area {real_text(cells[largest_cell - 1].area)}")
        for int i < int(len(cells))
            Cell cell = cells[i]
            if cell.bounded
                lines = lines.append("cell {i + 1} bounded {len(cell.vertices)} area {real_text(cell.area)} clip {real_text(cell.clipped)} vertices {words(cell.vertices)}")
            else
                lines = lines.append("cell {i + 1} unbounded {len(cell.vertices)} clip {real_text(cell.clipped)} from {words(cell.incoming)} vertices {words(cell.vertices)} to {words(cell.outgoing)}")
        return lines

    string[] section_nearest()
        string[] lines = ["mutual_pairs {len(mutual_pairs)}", "closest_pair {words(edges[closest - 1])} d2 {length2[closest - 1]}"]
        for 1 <= int site <= n
            int other = nearest_sites[site - 1]
            string mutual = if nearest_sites[other - 1] == site then "mutual" else "-"
            lines = lines.append("nn {site} {other} d2 {predicates.d2(points[site - 1], points[other - 1])} {mutual}")
        return lines

    string[] section_components()
        string[] lines = ["components {len(components)}"]
        for int k < int(len(components))
            lines = lines.append("component {k + 1} size {len(components[k])} pair {words(component_pairs[k])} sites {words(components[k])}")
        return lines

    string[] section_mst()
        int[] longest = mst[int(len(mst)) - 1]
        string[] lines = ["edges {n - 1}", "total_length {real_text(mst_length)}", "longest {words(longest)} len2 {predicates.d2(points[longest[0] - 1], points[longest[1] - 1])}"]
        for int[] edge = mst[]
            lines = lines.append("mst {words(edge)} len2 {predicates.d2(points[edge[0] - 1], points[edge[1] - 1])}")
        return lines

    string[] section_proximity()
        string[] lines = ["delaunay {len(edges)}", "gabriel {gabriel_count}", "rng {rng_count}", "mst {n - 1}", "nn {n - int(len(mutual_pairs))}"]
        for int k < int(len(edges))
            if rng[k] and not mst_set[k]
                lines = lines.append("rng_extra {words(edges[k])} len2 {length2[k]}")
        return lines

    string[] section_degrees()
        int[] sorted = degree.sorted()
        string[] lines = ["min {sorted[0]}", "max {sorted[int(len(sorted)) - 1]}"]
        int i = 0
        while i < int(len(sorted))
            int last = i + 1
            while last < int(len(sorted)) and sorted[last] == sorted[i]
                last += 1
            lines = lines.append("degree {sorted[i]} count {last - i}")
            i = last
        return lines

    string[] section_empty_circle()
        string[] lines = ["candidates {len(empty_candidates)}"]
        if empty_vertex == 0
            return lines.append("none")
        int[] center = centers[empty_vertex - 1]
        return lines.concat([
            "vertex {empty_vertex}",
            "center {predicates.fraction(center[0], center[2])} {predicates.fraction(center[1], center[2])}",
            "radius {real_text(voronoi.root(radius2[empty_vertex - 1]))}",
            "sites {words(triangles[empty_vertex - 1])}",
        ])

    string[] section_extent()
        return [
            "diameter {words(diameter)} d2 {diameter2}",
            "width {real_text(width_value)} edge {words(width_edge)}",
            "enclosing_center {predicates.fraction(enclosing_center[0], enclosing_center[2])} {predicates.fraction(enclosing_center[1], enclosing_center[2])}",
            "enclosing_radius {real_text(voronoi.root(enclosing_radius2))}",
            "enclosing_sites {words(enclosing_sites)}",
        ]

    string[] section_spanner()
        return [
            "pairs {pair_count}",
            "max_stretch {real_text(maximum_stretch)} pair {words(stretch_pair)} length {real_text(stretch_length)} distance {real_text(stretch_distance)}",
            "mean_stretch {real_text(mean_stretch)}",
        ]

    string[] section_alpha()
        string[] lines = []
        for AlphaResult value = alpha_results[]
            string line = "alpha {value.alpha} triangles {value.faces} edges {value.edges} boundary {value.boundary} dangling {value.dangling}"
            line += " isolated {value.isolated} components {value.components} holes {value.holes} area2 {value.area2}"
            lines = lines.append(line)
        return lines

    string[] section_sites()
        string[] lines = []
        for 1 <= int site <= n
            int i = site - 1
            string position = if hull_next[i] > 0 then "hull" else "inner"
            string line = "site {site} {words(points[i])} {position} dt {degree[i]} gg {gg_degree[i]} rng {rng_degree[i]} mst {mst_degree[i]}"
            line += " nn {nearest_sites[i]} comp {component_number[i]} depth {depth[i]}"
            lines = lines.append(line)
        return lines

    void .analyze_queries()
        for string query = params.queries[]
            answers = answers.append(.self.answer(query))

    string[] section_queries()
        return answers

    string[] section_delaunay_plot()
        return delaunay_plot

    string[] section_voronoi_plot()
        return voronoi_plot

    string[] section(string name)
        if name == "input"
            return section_input()
        if name == "summary"
            return section_summary()
        if name == "insertions"
            return section_insertions()
        if name == "triangles"
            return section_triangles()
        if name == "edges"
            return section_edges()
        if name == "hull"
            return section_hull()
        if name == "convex_layers"
            return section_convex_layers()
        if name == "quality"
            return section_quality()
        if name == "vertices"
            return section_vertices()
        if name == "voronoi_edges"
            return section_voronoi_edges()
        if name == "cells"
            return section_cells()
        if name == "nearest"
            return section_nearest()
        if name == "components"
            return section_components()
        if name == "mst"
            return section_mst()
        if name == "proximity"
            return section_proximity()
        if name == "degrees"
            return section_degrees()
        if name == "empty_circle"
            return section_empty_circle()
        if name == "extent"
            return section_extent()
        if name == "spanner"
            return section_spanner()
        if name == "alpha"
            return section_alpha()
        if name == "sites"
            return section_sites()
        if name == "queries"
            return section_queries()
        if name == "delaunay_plot"
            return section_delaunay_plot()
        return section_voronoi_plot()

    void .write()
        string[] filenames = ["triangulation.txt", "voronoi.txt", "derived.txt", "plot.txt"]
        string[][] owners = [
            ["input", "summary", "insertions", "triangles", "edges", "hull", "convex_layers", "quality"],
            ["vertices", "voronoi_edges", "cells"],
            ["nearest", "components", "mst", "proximity", "degrees", "empty_circle", "extent", "spanner", "alpha", "sites", "queries"],
            ["delaunay_plot", "voronoi_plot"],
        ]
        string[][] contents = [[], [], [], []]
        for string name = params.sections[]
            int owner = -1
            for int i < 4
                for string candidate = owners[i][]
                    if candidate == name
                        owner = i
            contents[owner] = contents[owner].append("[{name}]").concat(section(name))
        for int i < 4
            string content = if len(contents[i]) == 0 then "" else contents[i].join(NL) + NL
            file.write("output/" + filenames[i], content)

void run()
    Input input = read_points()
    Params params = read_params()
    Report report = Report(input.points, input.line_count, input.rejected, params)
    .report.build()
    .report.analyze_triangles()
    .report.analyze_voronoi()
    .report.analyze_proximity()
    .report.analyze_extent()
    .report.analyze_layers()
    .report.analyze_spanner()
    .report.analyze_alpha()
    .report.analyze_queries()
    .report.draw()
    .report.write()

run()
