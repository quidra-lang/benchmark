import predicates = "./predicates.qui"
import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

real64 root(real64 value)
    real64 result = math.sqrt(value)
    return result

real64 radius2(int[] a, int[] b, int[] c)
    real64 first = as_real(predicates.d2(a, b))
    real64 second = as_real(predicates.d2(b, c))
    real64 third = as_real(predicates.d2(c, a))
    real64 area = as_real(predicates.orient(a, b, c))
    return ((first * second) * third) / ((4.0 * area) * area)

string position(int[] center, int[][] points, int[] hull)
    bool on = false
    for int i < int(len(hull))
        int[] p = points[hull[i] - 1]
        int[] q = points[hull[(i + 1) % int(len(hull))] - 1]
        int sigma = (q[0] - p[0]) * (center[1] - p[1] * center[2]) - (q[1] - p[1]) * (center[0] - p[0] * center[2])
        if sigma < 0
            return "outside"
        if sigma == 0
            on = true
    return if on then "on" else "inside"

int[] neighbor_order(int site, int[] adjacent, int[][] directed, int[] following)
    int first = if following[site - 1] > 0 then following[site - 1] else adjacent.sorted()[0]
    int[] result = [first]
    while len(result) < len(adjacent)
        result = result.append(directed[site - 1][result[int(len(result)) - 1] - 1])
    return result

int[] outward(int[][] points, int u, int v)
    return predicates.direction(points[v - 1][1] - points[u - 1][1], points[u - 1][0] - points[v - 1][0])

real64 bounded_area(int[] site, int[][] centers)
    real64[][] relative = []
    for int[] center = centers[]
        relative = relative.append([as_real(center[0]) / as_real(center[2]) - as_real(site[0]), as_real(center[1]) / as_real(center[2]) - as_real(site[1])])
    real64 total = 0.0
    for int i < int(len(relative))
        real64[] p = relative[i]
        real64[] q = relative[(i + 1) % int(len(relative))]
        total += p[0] * q[1] - q[0] * p[1]
    return total / 2.0

real64 clipped_area(int[][] points, int site, int[] neighbors)
    real64[][] polygon = [[0.0, 0.0], [1000.0, 0.0], [1000.0, 1000.0], [0.0, 1000.0]]
    int xs = points[site - 1][0]
    int ys = points[site - 1][1]
    for int neighbor = neighbors[]
        int xt = points[neighbor - 1][0]
        int yt = points[neighbor - 1][1]
        real64 c1 = as_real(2 * (xt - xs))
        real64 c2 = as_real(2 * (yt - ys))
        real64 c3 = as_real(xt * xt + yt * yt - xs * xs - ys * ys)
        real64[][] clipped = []
        for int i < int(len(polygon))
            real64[] p = polygon[i]
            real64[] q = polygon[(i + 1) % int(len(polygon))]
            real64 fp = c1 * p[0] + c2 * p[1] - c3
            real64 fq = c1 * q[0] + c2 * q[1] - c3
            if fp <= 0.0
                clipped = clipped.append(p)
            if fp < 0.0 and fq > 0.0 or fq < 0.0 and fp > 0.0
                real64 fraction = fp / (fp - fq)
                clipped = clipped.append([p[0] + (q[0] - p[0]) * fraction, p[1] + (q[1] - p[1]) * fraction])
        polygon = clipped
    real64 total = 0.0
    for int i < int(len(polygon))
        real64[] p = polygon[i]
        real64[] q = polygon[(i + 1) % int(len(polygon))]
        total += p[0] * q[1] - q[0] * p[1]
    return total / 2.0
