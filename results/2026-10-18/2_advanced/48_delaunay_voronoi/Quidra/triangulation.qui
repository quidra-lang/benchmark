public import predicates = "./predicates.qui"

int[] canonical(int a, int b, int c)
    return if b < a and b < c then [b, c, a] elif c < a and c < b then [c, a, b] else [a, b, c]

void push_pending(set.Set<int> &pending, int[] &stack, int key)
    if not pending.has(key)
        .pending.add(key)
        stack = stack.append(key)

class Insertion(string kind, int[] containing, int visible, int flips, int triangles, int hull)
class Walk(int[] path, int[] outside)

class Mesh self(int[][] points, map.Map<int, int> directed, int[] initial)
    int edge_key(int a, int b)
        return (a - 1) * int(len(points)) + b - 1

    int remaining(int a, int b)
        match directed.get(edge_key(a, b))
            int value
                return value
            none
                return 0

    void .add_triangle(int a, int b, int c)
        .directed.set(edge_key(a, b), c)
        .directed.set(edge_key(b, c), a)
        .directed.set(edge_key(c, a), b)

    void .remove_triangle(int a, int b, int c)
        .directed.remove(edge_key(a, b))
        .directed.remove(edge_key(b, c))
        .directed.remove(edge_key(c, a))

    int[][] triangles()
        int[][] result = []
        for int key = directed.keys().sorted()[]
            int a = key / int(len(points)) + 1
            int b = key % int(len(points)) + 1
            int c = remaining(a, b)
            if a < b and a < c
                result = result.append([a, b, c])
        return result

    int[][] hull_edges()
        int[][] result = []
        for int key = directed.keys().sorted()[]
            int a = key / int(len(points)) + 1
            int b = key % int(len(points)) + 1
            if remaining(b, a) == 0
                result = result.append([a, b])
        return result

    Insertion .insert(int site)
        int[] containing = []
        for int[] triangle = triangles()[]
            int a = triangle[0]
            int b = triangle[1]
            int c = triangle[2]
            if predicates.orient(points[a - 1], points[b - 1], points[site - 1]) > 0 and predicates.orient(points[b - 1], points[c - 1], points[site - 1]) > 0 and predicates.orient(points[c - 1], points[a - 1], points[site - 1]) > 0
                containing = triangle
                break
        int[][] check = []
        int visible = 0
        if len(containing) > 0
            int a = containing[0]
            int b = containing[1]
            int c = containing[2]
            .self.remove_triangle(a, b, c)
            check = [[a, b], [b, c], [c, a]]
        else
            for int[] edge = hull_edges()[]
                if predicates.orient(points[edge[0] - 1], points[edge[1] - 1], points[site - 1]) < 0
                    check = check.append([edge[1], edge[0]])
            visible = int(len(check))
        set.Set<int> pending = set.Set<int>()
        int[] stack = []
        for int[] edge = check[]
            .self.add_triangle(edge[0], edge[1], site)
            push_pending(&pending, &stack, edge_key(edge[0], edge[1]))
        int flips = 0
        while len(stack) > 0
            int key = stack[int(len(stack)) - 1]
            stack = stack[0:<int(len(stack)) - 1]
            .pending.remove(key)
            int a = key / int(len(points)) + 1
            int b = key % int(len(points)) + 1
            int q = remaining(b, a)
            if remaining(a, b) == site and q > 0 and predicates.incircle(points[a - 1], points[b - 1], points[site - 1], points[q - 1]) > 0
                .self.remove_triangle(a, b, site)
                .self.remove_triangle(b, a, q)
                .self.add_triangle(a, q, site)
                .self.add_triangle(q, b, site)
                push_pending(&pending, &stack, edge_key(a, q))
                push_pending(&pending, &stack, edge_key(q, b))
                flips += 1
        return Insertion(if len(containing) > 0 then "inside" else "outside", containing, visible, flips, int(directed.size()) / 3, int(len(hull_edges())))

    Walk visibility_walk(int[] query, int[][] numbered, int[][] edge_triangles)
        int[] path = [1]
        while true
            int[] triangle = numbered[path[int(len(path)) - 1] - 1]
            int[][] edges = [[triangle[0], triangle[1]], [triangle[1], triangle[2]], [triangle[2], triangle[0]]]
            int[] crossing = []
            for int[] edge = edges[]
                if predicates.orient(points[edge[0] - 1], points[edge[1] - 1], query) < 0
                    crossing = edge
                    break
            if len(crossing) == 0
                return Walk(path, [])
            int following = edge_triangles[crossing[1] - 1][crossing[0] - 1]
            if following == 0
                return Walk(path, crossing.sorted())
            path = path.append(following)
        return Walk(path, [])

Mesh new_mesh(int[][] points)
    int[] initial = if predicates.orient(points[0], points[1], points[2]) > 0 then [1, 2, 3] else [1, 3, 2]
    map.Map<int, int> directed = map.Map<int, int>()
    Mesh result = Mesh(points, directed, initial)
    .result.add_triangle(initial[0], initial[1], initial[2])
    return result
