int absolute(int value)
    return if value < 0 then -value else value

class Canvas self(int width, int height)
    string[][] rows = [for int r = (0:<height)[] then array(nat(width), fill = " ")]

    int[] position(int[] point)
        int d = if len(point) == 3 then point[2] else 1
        int column = (2 * point[0] * (width - 1) + 1000 * d) / (2000 * d)
        int row = height - 1 - (2 * point[1] * (height - 1) + 1000 * d) / (2000 * d)
        return [column, row]

    void .mark(int[] point, string character)
        int[] cell = position(point)
        rows[cell[1]][cell[0]] = character

    void .line(int[] first, int[] second, string character)
        int[] start = position(first)
        int[] finish = position(second)
        int x = start[0]
        int y = start[1]
        int dx = absolute(finish[0] - x)
        int dy = -absolute(finish[1] - y)
        int sx = if x < finish[0] then 1 else -1
        int sy = if y < finish[1] then 1 else -1
        int error_value = dx + dy
        while true
            rows[y][x] = character
            if x == finish[0] and y == finish[1]
                return
            int twice = 2 * error_value
            if twice >= dy
                error_value += dy
                x += sx
            if twice <= dx
                error_value += dx
                y += sy

    void .draw_voronoi(int[][] points)
        int horizontal = width - 1
        int vertical = height - 1
        int[][] owners = []
        for int r < height
            int[] owner_row = []
            for int c < width
                int owner = 0
                int best = 0
                for int site < int(len(points))
                    int dx = (c * 1000 - points[site][0] * horizontal) * vertical
                    int dy = ((vertical - r) * 1000 - points[site][1] * vertical) * horizontal
                    int distance = dx * dx + dy * dy
                    if owner == 0 or distance < best
                        owner = site + 1
                        best = distance
                owner_row = owner_row.append(owner)
            owners = owners.append(owner_row)
        for int r < height
            for int c < width
                int owner = owners[r][c]
                if c < horizontal and owner != owners[r][c + 1] or r < vertical and owner != owners[r + 1][c]
                    rows[r][c] = "#"
        for int[] point = points[]
            .self.mark(point, "o")

    string[] framed()
        string border = "+" + string.repeat("-", nat(width)) + "+"
        string[] result = [border]
        for string[] row = rows[]
            result = result.append("|" + row.join("") + "|")
        return result.append(border)
