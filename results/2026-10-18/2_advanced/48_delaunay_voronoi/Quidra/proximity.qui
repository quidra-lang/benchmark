import predicates = "./predicates.qui"
import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

real64 root(int value)
    real64 result = math.sqrt(as_real(value))
    return result

class DisjointSets self(int[] parent, int[] sizes, int count)
    int .find(int site)
        while parent[site - 1] != site
            parent[site - 1] = parent[parent[site - 1] - 1]
            site = parent[site - 1]
        return site

    bool .join(int first, int second)
        first = .self.find(first)
        second = .self.find(second)
        if first == second
            return false
        if sizes[first - 1] < sizes[second - 1]
            int temporary = first
            first = second
            second = temporary
        parent[second - 1] = first
        sizes[first - 1] += sizes[second - 1]
        count -= 1
        return true

DisjointSets new_sets(int count)
    return DisjointSets((1:count)[], array(nat(count), fill = 1), count)

int[] nearest(int[][] points, int[][] neighbors)
    int[] result = []
    for int site < int(len(points))
        int best = neighbors[site][0]
        int distance = predicates.d2(points[site], points[best - 1])
        for int other = neighbors[site][]
            int value = predicates.d2(points[site], points[other - 1])
            if value < distance or value == distance and other < best
                best = other
                distance = value
        result = result.append(best)
    return result

int[][] components(int[] nearest_sites)
    DisjointSets sets = new_sets(int(len(nearest_sites)))
    for int i < int(len(nearest_sites))
        .sets.join(i + 1, nearest_sites[i])
    int[] roots = []
    int[][] groups = []
    for 1 <= int site <= int(len(nearest_sites))
        int representative = .sets.find(site)
        int index = -1
        for int k < int(len(roots))
            if roots[k] == representative
                index = k
                break
        if index < 0
            index = int(len(roots))
            roots = roots.append(representative)
            groups = groups.append([])
        groups[index] = groups[index].append(site)
    return groups

int[][] kruskal(int[][] points, int[][] edges)
    int[] ordered = []
    for int i < int(len(edges))
        int distance = predicates.d2(points[edges[i][0] - 1], points[edges[i][1] - 1])
        int place = int(len(ordered))
        for int k < int(len(ordered))
            int other = ordered[k]
            if distance < predicates.d2(points[edges[other][0] - 1], points[edges[other][1] - 1])
                place = k
                break
        ordered = ordered[0:<place].append(i).concat(ordered[place:<int(len(ordered))])
    DisjointSets sets = new_sets(int(len(points)))
    int[][] result = []
    for int index = ordered[]
        int[] edge = edges[index]
        if .sets.join(edge[0], edge[1])
            result = result.append(edge)
            if sets.count == 1
                break
    return result

bool gabriel(int[][] points, int[] edge, int[][] directed)
    int first = edge[0]
    int second = edge[1]
    int left = directed[first - 1][second - 1]
    int right = directed[second - 1][first - 1]
    return (left == 0 or predicates.dot(points[left - 1], points[first - 1], points[second - 1]) > 0) and (right == 0 or predicates.dot(points[right - 1], points[first - 1], points[second - 1]) > 0)

bool relative(int[][] points, int[] edge)
    int[] first = points[edge[0] - 1]
    int[] second = points[edge[1] - 1]
    int distance = predicates.d2(first, second)
    for int[] point = points[]
        if predicates.d2(first, point) < distance and predicates.d2(second, point) < distance
            return false
    return true

class Route(int[] path, real64 length)
class Shortest(real64[] distances, int[] previous)

Route greedy_route(int[][] points, int[][] neighbors, int start, int target)
    int[] path = [start]
    real64 length = 0.0
    int current = start
    while current != target
        int following = neighbors[current - 1][0]
        int best = predicates.d2(points[following - 1], points[target - 1])
        for int site = neighbors[current - 1][]
            int value = predicates.d2(points[site - 1], points[target - 1])
            if value < best or value == best and site < following
                following = site
                best = value
        length += root(predicates.d2(points[current - 1], points[following - 1]))
        path = path.append(following)
        current = following
    return Route(path, length)

Shortest dijkstra(int[][] points, int[][] neighbors, int start)
    real64[] distances = array(len(points), fill = inf)
    int[] previous = array(len(points), fill = 0)
    bool[] visited = array(len(points), fill = false)
    distances[start - 1] = 0.0
    for _ < int(len(points))
        int current = -1
        for int site < int(len(points))
            if not visited[site] and (current < 0 or distances[site] < distances[current])
                current = site
        if current < 0
            break
        visited[current] = true
        for int other = neighbors[current][]
            real64 candidate = distances[current] + root(predicates.d2(points[current], points[other - 1]))
            if candidate < distances[other - 1]
                distances[other - 1] = candidate
                previous[other - 1] = current + 1
    return Shortest(distances, previous)
