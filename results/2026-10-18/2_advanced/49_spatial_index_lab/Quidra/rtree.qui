int area(int[] box)
    return (box[2] - box[0]) * (box[3] - box[1])

int[] mbr(int[] first, int[] second)
    return [
        if first[0] < second[0] then first[0] else second[0],
        if first[1] < second[1] then first[1] else second[1],
        if first[2] > second[2] then first[2] else second[2],
        if first[3] > second[3] then first[3] else second[3],
    ]

int enlargement(int[] first, int[] second)
    return area(mbr(first, second)) - area(first)

bool contains(int[] outer, int[] inner)
    return outer[0] <= inner[0] and inner[2] <= outer[2] and outer[1] <= inner[1] and inner[3] <= outer[3]

bool intersects(int[] first, int[] second)
    return first[0] <= second[2] and second[0] <= first[2] and first[1] <= second[3] and second[1] <= first[3]

int overlap(int[] first, int[] second)
    int right = if first[2] < second[2] then first[2] else second[2]
    int left = if first[0] > second[0] then first[0] else second[0]
    int top = if first[1] > second[1] then first[1] else second[1]
    int bottom = if first[3] < second[3] then first[3] else second[3]
    int width = right - left
    int height = bottom - top
    return if width > 0 and height > 0 then width * height else 0

bool less(int[] first, int[] second)
    for int i < int(len(first))
        if first[i] != second[i]
            return first[i] < second[i]
    return false

int smaller(int first, int second)
    return if first < second then first else second

class Entry(int[] box, int id, int child)
class Node(int level, Entry[] entries, int parent)
class Found(int node, int entry)

int[] sorted_entries(Entry[] entries, int[] numbers, int axis, int[] indices)
    int[] result = []
    for int index = indices[]
        int[] box = entries[index].box
        int[] key = [box[axis] + box[axis + 2], box[1 - axis] + box[3 - axis], numbers[index]]
        int place = int(len(result))
        for int k < int(len(result))
            int other = result[k]
            int[] other_box = entries[other].box
            int[] other_key = [other_box[axis] + other_box[axis + 2], other_box[1 - axis] + other_box[3 - axis], numbers[other]]
            if less(key, other_key)
                place = k
                break
        result = result[0:<place].append(index).concat(result[place:<int(len(result))])
    return result

class Tree self(Node[] nodes, int root, int maximum, int minimum)
    int[] node_box(int index)
        Entry[] entries = nodes[index].entries
        int[] result = entries[0].box
        for 1 <= int i < int(len(entries))
            result = mbr(result, entries[i].box)
        return result

    int .new_node(int level, Entry[] entries, int parent = -1)
        int index = int(len(nodes))
        nodes = nodes.append(Node(level, entries, parent))
        if level > 0
            for Entry entry = entries[]
                nodes[entry.child].parent = index
        return index

    void .assign_entries(int index, Entry[] entries)
        nodes[index].entries = entries
        if nodes[index].level > 0
            for Entry entry = entries[]
                nodes[entry.child].parent = index

    int choose_subtree(int[] box, int level)
        int current = root
        while nodes[current].level > level
            Entry[] entries = nodes[current].entries
            int selected = 0
            for 1 <= int i < int(len(entries))
                int[] first = entries[i].box
                int[] second = entries[selected].box
                if less([enlargement(first, box), area(first)], [enlargement(second, box), area(second)])
                    selected = i
            current = entries[selected].child
        return current

    int .split(int current)
        Entry[] entries = nodes[current].entries
        int first_seed = 0
        int second_seed = 1
        int best = area(mbr(entries[0].box, entries[1].box)) - area(entries[0].box) - area(entries[1].box)
        for int i < int(len(entries)) - 1
            for i + 1 <= int j < int(len(entries))
                int waste = area(mbr(entries[i].box, entries[j].box)) - area(entries[i].box) - area(entries[j].box)
                if waste > best
                    first_seed = i
                    second_seed = j
                    best = waste
        Entry[] first = [entries[first_seed]]
        Entry[] second = [entries[second_seed]]
        Entry[] rest = []
        for int i < int(len(entries))
            if i != first_seed and i != second_seed
                rest = rest.append(entries[i])
        int[] box1 = entries[first_seed].box
        int[] box2 = entries[second_seed].box
        while len(rest) > 0
            if int(len(first)) + int(len(rest)) == minimum
                first = first.concat(rest)
                break
            if int(len(second)) + int(len(rest)) == minimum
                second = second.concat(rest)
                break
            int selected = 0
            int greatest = -1
            int selected_d1 = 0
            int selected_d2 = 0
            for int i < int(len(rest))
                int d1 = enlargement(box1, rest[i].box)
                int d2 = enlargement(box2, rest[i].box)
                int difference = if d1 >= d2 then d1 - d2 else d2 - d1
                if difference > greatest
                    selected = i
                    greatest = difference
                    selected_d1 = d1
                    selected_d2 = d2
            Entry entry = rest[selected]
            rest = rest[0:<selected].concat(rest[selected + 1:<int(len(rest))])
            if less([selected_d1, area(box1), int(len(first)), 0], [selected_d2, area(box2), int(len(second)), 1])
                first = first.append(entry)
                box1 = mbr(box1, entry.box)
            else
                second = second.append(entry)
                box2 = mbr(box2, entry.box)
        .self.assign_entries(current, first)
        return .self.new_node(nodes[current].level, second, nodes[current].parent)

    void .insert_entry(Entry entry, int level = 0)
        int current = choose_subtree(entry.box, level)
        nodes[current].entries = nodes[current].entries.append(entry)
        if level > 0
            nodes[entry.child].parent = current
        while true
            int sibling = -1
            if int(len(nodes[current].entries)) > maximum
                sibling = .self.split(current)
            int parent = nodes[current].parent
            if parent < 0
                if sibling >= 0
                    Entry[] entries = [Entry(node_box(current), 0, current), Entry(node_box(sibling), 0, sibling)]
                    root = .self.new_node(nodes[current].level + 1, entries)
                return
            for int i < int(len(nodes[parent].entries))
                if nodes[parent].entries[i].child == current
                    nodes[parent].entries[i].box = node_box(current)
                    break
            if sibling >= 0
                nodes[parent].entries = nodes[parent].entries.append(Entry(node_box(sibling), 0, sibling))
                nodes[sibling].parent = parent
            current = parent

    Found find_leaf(int id, int[] box)
        int[] pending = [root]
        while len(pending) > 0
            int current = pending[int(len(pending)) - 1]
            pending = pending[0:<int(len(pending)) - 1]
            Entry[] entries = nodes[current].entries
            if nodes[current].level == 0
                for int i < int(len(entries))
                    if entries[i].id == id
                        return Found(current, i)
            else
                for int reverse < int(len(entries))
                    Entry entry = entries[int(len(entries)) - reverse - 1]
                    if contains(entry.box, box)
                        pending = pending.append(entry.child)
        return Found(-1, -1)

    void .delete(int[] point)
        int[] box = [point[1], point[2], point[1], point[2]]
        Found found = find_leaf(point[0], box)
        int current = found.node
        int position = found.entry
        Entry[] entries = nodes[current].entries
        nodes[current].entries = entries[0:<position].concat(entries[position + 1:<int(len(entries))])
        int[] removed = []
        while current != root
            int parent = nodes[current].parent
            for int i < int(len(nodes[parent].entries))
                if nodes[parent].entries[i].child == current
                    if int(len(nodes[current].entries)) < minimum
                        Entry[] parent_entries = nodes[parent].entries
                        nodes[parent].entries = parent_entries[0:<i].concat(parent_entries[i + 1:<int(len(parent_entries))])
                        removed = removed.append(current)
                        nodes[current].parent = -1
                    else
                        nodes[parent].entries[i].box = node_box(current)
                    break
            current = parent
        for int discarded = removed[]
            Entry[] reinsertion = nodes[discarded].entries
            int level = nodes[discarded].level
            for Entry entry = reinsertion[]
                .self.insert_entry(entry, level)
        while nodes[root].level > 0 and len(nodes[root].entries) == 1
            root = nodes[root].entries[0].child
            nodes[root].parent = -1

    void .bulk_load(Entry[] entries)
        int[] numbers = [for Entry entry = entries[] then entry.id]
        int level = 0
        while true
            int count = int(len(entries))
            int pages = (count + maximum - 1) / maximum
            int slabs = 1
            while slabs * slabs < pages
                slabs += 1
            int[] ordered = sorted_entries(entries, numbers, 0, (0:<count)[])
            int slab_size = slabs * maximum
            int[] created = []
            for int start < count step slab_size
                int[] slab = ordered[start:<smaller(count, start + slab_size)]
                slab = sorted_entries(entries, numbers, 1, slab)
                for int offset < int(len(slab)) step maximum
                    int[] indices = slab[offset:<smaller(int(len(slab)), offset + maximum)]
                    Entry[] group = [for int i = indices[] then entries[i]]
                    created = created.append(.self.new_node(level, group))
            if len(created) == 1
                root = created[0]
                nodes[root].parent = -1
                return
            entries = []
            numbers = []
            for int i < int(len(created))
                entries = entries.append(Entry(node_box(created[i]), 0, created[i]))
                numbers = numbers.append(i)
            level += 1

Tree build(int[][] objects, int maximum, int minimum, bool bulk)
    Tree result = Tree([], -1, maximum, minimum)
    result.root = .result.new_node(0, [])
    Entry[] entries = [for int[] object = objects[] then Entry(object[1:<5], object[0], -1)]
    if bulk
        .result.bulk_load(entries)
    else
        for Entry entry = entries[]
            .result.insert_entry(entry)
    return result
