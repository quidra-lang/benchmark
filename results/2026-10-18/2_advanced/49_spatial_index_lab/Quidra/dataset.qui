int integer(string value)
    result := int.parse(value)
    return result

string[] lines(string path)
    content := string.from_utf8(file.read_bin(path))
    result := content.split(NL)
    return result[0:<int(len(result)) - 1]

int[][] csv(string path)
    content := lines(path)
    int[][] result := []
    for: 1 <= i < int(len(content))
        result = result.append([for value := content[i].split(",")[] then integer(value)])
    return result

class Params(int world, int bucket, int maximum, int minimum, int cell_size)
class Command(string name, int[] values)
class Data(int[][] points, int[][] rectangles, Params params, Command[] commands)

Data read_inputs()
    settings := [for line := lines("input/params.txt")[] then line.split(" ")]
    params := Params(integer(settings[0][1]), integer(settings[1][1]), integer(settings[2][1]), integer(settings[2][2]), integer(settings[3][1]))
    Command[] commands := []
    for line := lines("input/queries.txt")[]
        fields := line.split(" ")
        values := [for value := fields[1:<int(len(fields))][] then integer(value)]
        commands = commands.append(Command(fields[0], values))
    return Data(csv("input/points.csv"), csv("input/rects.csv"), params, commands)
