string fraction(int numerator, int denominator)
    int first = numerator
    int second = denominator
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return "{numerator / first}/{denominator / first}"

string ids(int[] values)
    string[] fields = [for int value = values[] then "{value}"]
    return if len(fields) == 0 then "-" else fields.join(" ")

string distances(int[][] values)
    string[] fields = [for int[] value = values[] then "{value[0]}:{value[1]}"]
    return if len(fields) == 0 then "-" else fields.join(" ")

void write_lines(string name, string[] rows)
    string content = if len(rows) == 0 then "" else rows.join(NL) + NL
    file.write("output/" + name, content)
