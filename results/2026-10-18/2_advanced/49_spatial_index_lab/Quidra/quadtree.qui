int[][] insert_sorted(int[][] points, int[] point)
    int place = int(len(points))
    for int i < int(len(points))
        if point[0] < points[i][0]
            place = i
            break
    return points[0:<place].append(point).concat(points[place:<int(len(points))])

class Node(int x, int y, int size, int[][] points, int[] children)

class Tree self(Node[] nodes, int capacity)
    int destination(int index, int[] point)
        int half = nodes[index].size / 2
        int east = if point[1] >= nodes[index].x + half then 1 else 0
        int south = if point[2] >= nodes[index].y + half then 2 else 0
        return east + south

    void .insert(int[] point)
        int current = 0
        while len(nodes[current].children) > 0
            current = nodes[current].children[destination(current, point)]
        nodes[current].points = insert_sorted(nodes[current].points, point)
        int[] pending = [current]
        while len(pending) > 0
            int index = pending[int(len(pending)) - 1]
            pending = pending[0:<int(len(pending)) - 1]
            if int(len(nodes[index].points)) <= capacity
                continue
            int x = nodes[index].x
            int y = nodes[index].y
            int half = nodes[index].size / 2
            int[][] previous = nodes[index].points
            int first = int(len(nodes))
            nodes = nodes.append(Node(x, y, half, [], []))
            nodes = nodes.append(Node(x + half, y, half, [], []))
            nodes = nodes.append(Node(x, y + half, half, [], []))
            nodes = nodes.append(Node(x + half, y + half, half, [], []))
            nodes[index].children = [first, first + 1, first + 2, first + 3]
            nodes[index].points = []
            for int[] value = previous[]
                int child = first + destination(index, value)
                nodes[child].points = nodes[child].points.append(value)
            for int reverse < 4
                int child = first + 3 - reverse
                if int(len(nodes[child].points)) > capacity
                    pending = pending.append(child)

    void .delete(int[] point)
        int current = 0
        int[] ancestors = []
        while len(nodes[current].children) > 0
            ancestors = ancestors.append(current)
            current = nodes[current].children[destination(current, point)]
        nodes[current].points = [for int[] value = nodes[current].points[] if value[0] != point[0] then value]
        for int reverse < int(len(ancestors))
            int index = ancestors[int(len(ancestors)) - reverse - 1]
            bool merge = true
            int count = 0
            for int child = nodes[index].children[]
                if len(nodes[child].children) > 0
                    merge = false
                    break
                count += int(len(nodes[child].points))
            if not merge or count > capacity
                break
            int[][] points = []
            for int child = nodes[index].children[]
                for int[] value = nodes[child].points[]
                    points = insert_sorted(points, value)
            nodes[index].points = points
            nodes[index].children = []

Tree build(int[][] points, int world, int capacity)
    Tree result = Tree([Node(0, 0, world, [], [])], capacity)
    for int[] point = points[]
        .result.insert(point)
    return result
