import evaluation = "./evaluation.qui"

real64[][] real_matrix(int rows, int columns, real64 value)
    return [for int row = (0:<rows)[] then [for int column = (0:<columns)[] then value]]

int[][] int_matrix(int rows, int columns)
    return [for int row = (0:<rows)[] then [for int column = (0:<columns)[] then 0]]

class Result(real64[][] users, int[][] user_common, real64[][] items, int[][] common, int[][] difference)
class Candidate(int index, real64 similarity, int rating)

Result build(int[][] values, int[][] user_ratings, int[][] item_ratings, real64[] user_means, int shrinkage)
    int user_count = int(len(user_ratings))
    int item_count = int(len(item_ratings))
    real64[][] users = real_matrix(user_count, user_count, 2.0)
    int[][] user_common = int_matrix(user_count, user_count)
    real64[][] items = real_matrix(item_count, item_count, 2.0)
    int[][] common = int_matrix(item_count, item_count)
    int[][] difference = int_matrix(item_count, item_count)
    for int u < user_count - 1
        for u + 1 <= int v < user_count
            int n = 0
            int sx = 0
            int sy = 0
            int sxx = 0
            int syy = 0
            int sxy = 0
            for int item = user_ratings[u][]
                int other = values[v][item]
                if other == 0
                    continue
                int value = values[u][item]
                n += 1
                sx += value
                sy += other
                sxx += value * value
                syy += other * other
                sxy += value * other
            if n < 2
                continue
            int numerator = n * sxy - sx * sy
            int dx = n * sxx - sx * sx
            int dy = n * syy - sy * sy
            if dx == 0 or dy == 0
                continue
            int scaled = numerator * n
            int a = scaled * scaled
            int b = dx * dy * (n + shrinkage) * (n + shrinkage)
            real64 sign = if numerator < 0 then -1.0 elif numerator > 0 then 1.0 else 0.0
            real64 similarity = sign * evaluation.root(evaluation.as_real(a) / evaluation.as_real(b))
            users[u][v] = similarity
            users[v][u] = similarity
            user_common[u][v] = n
            user_common[v][u] = n
    for int i < item_count - 1
        for i + 1 <= int j < item_count
            int n = 0
            int delta = 0
            real64 numerator = 0.0
            real64 ni = 0.0
            real64 nj = 0.0
            for int u = item_ratings[i][]
                int other = values[u][j]
                if other == 0
                    continue
                n += 1
                delta += values[u][i] - other
                real64 di = evaluation.as_real(values[u][i]) - user_means[u]
                real64 dj = evaluation.as_real(other) - user_means[u]
                numerator += di * dj
                ni += di * di
                nj += dj * dj
            if n >= 1
                common[i][j] = n
                common[j][i] = n
                difference[i][j] = delta
                difference[j][i] = -delta
            if n >= 2 and ni != 0.0 and nj != 0.0
                real64 similarity = numerator / evaluation.root(ni * nj) * evaluation.as_real(n) / evaluation.as_real(n + shrinkage)
                items[i][j] = similarity
                items[j][i] = similarity
    return Result(users, user_common, items, common, difference)

Candidate[] select(Candidate[] candidates, int count)
    Candidate[] ordered = []
    for Candidate item = candidates[]
        int place = int(len(ordered))
        for int index < int(len(ordered))
            Candidate other = ordered[index]
            if item.similarity > other.similarity or (item.similarity == other.similarity and item.index < other.index)
                place = index
                break
        ordered = ordered[0:<place].append(item).concat(ordered[place:<int(len(ordered))])
    int limit = if count < int(len(ordered)) then count else int(len(ordered))
    return ordered[0:<limit]
