string real_text(real64 value, bool defined = true)
    if not defined
        return "-"
    string result = "{value:frac=4}"
    return if result == "-0.0000" then "0.0000" else result

void save(string name, string[] lines)
    file.write writer1("output/" + name)
    .writer1(lines.join(NL) + NL)
