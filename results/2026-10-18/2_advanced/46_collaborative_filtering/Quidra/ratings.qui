string[] lines(string path)
    contents := string.from_utf8(file.read_bin(path))
    result := contents.split(NL)
    return result[0:<int(len(result)) - 1]

int integer(string value)
    result := int.parse(value)
    return result

real64 decimal(string value)
    result := real64.parse(value)
    return result

real64 as_real(int value)
    result := real64(value)
    return result

int find_id(int[] values, int value)
    for: index < int(len(values))
        if values[index] == value
            return index
    return -1

int[] unique_sorted(int[] values)
    int[] result := []
    for value := values.sorted()[]
        if len(result) == 0 or result[-1] != value
            result = result.append(value)
    return result

class Catalog(int[] ids, string[] titles, string[] genre_texts, string[][] genres)
class Params(int k, int shrinkage, real64 threshold, real64 item_reg, real64 user_reg, int factors, real64 learning_rate, real64 regularization, int epochs, real64 als_reg, int als_iterations, int seed, int top, int[] cutoffs, int[] neighbor_grid, int[] user_groups, int[] item_groups, int buckets, int list_size, int[] recommend_users, int[] similar_items)
class Data(int[] users, int[] items, int[][] training, int[][] testing, Catalog catalog, int[] item_catalog, int[][] values, int[][] user_ratings, int[][] item_ratings, int[] user_counts, int[] item_counts, real64[] user_means, real64[] item_means, real64 mean, Params params)

int[][] numeric_csv(string path)
    contents := lines(path)
    int[][] result := []
    for: 1 <= index < int(len(contents))
        fields := contents[index].split(",")
        result = result.append([for field := fields[] then integer(field)])
    return result

Params read_params()
    settings := [for line := lines("input/params.txt")[] then line.split(" ")]
    cutoffs := [for value := settings[12][1:<int(len(settings[12]))][] then integer(value)]
    neighbor_grid := [for value := settings[13][1:<int(len(settings[13]))][] then integer(value)]
    user_groups := [for value := settings[14][1:<int(len(settings[14]))][] then integer(value)]
    item_groups := [for value := settings[15][1:<int(len(settings[15]))][] then integer(value)]
    recommend_users := [for value := settings[18][1:<int(len(settings[18]))][] then integer(value)]
    similar_items := [for value := settings[19][1:<int(len(settings[19]))][] then integer(value)]
    return Params(integer(settings[0][1]), integer(settings[1][1]), decimal(settings[2][1]), decimal(settings[3][1]), decimal(settings[3][2]), integer(settings[4][1]), decimal(settings[5][1]), decimal(settings[6][1]), integer(settings[7][1]), decimal(settings[8][1]), integer(settings[9][1]), integer(settings[10][1]), integer(settings[11][1]), cutoffs, neighbor_grid, user_groups, item_groups, integer(settings[16][1]), integer(settings[17][1]), recommend_users, similar_items)

Data read_inputs()
    raw := numeric_csv("input/ratings.csv")
    users := unique_sorted([for row := raw[] then row[0]])
    items := unique_sorted([for row := raw[] then row[1]])
    int[][] values := []
    for: u < int(len(users))
        values = values.append([for i := items[] then 0])
    int[][] training := []
    total := 0
    for row := raw[]
        u := find_id(users, row[0])
        i := find_id(items, row[1])
        values[u][i] = row[2]
        training = training.append([u, i, row[2], row[3]])
        total += row[2]
    int[][] user_ratings := []
    int[][] item_ratings := []
    int[] user_counts := []
    int[] item_counts := []
    real64[] user_means := []
    real64[] item_means := []
    for: u < int(len(users))
        int[] rated := []
        sum := 0
        for: i < int(len(items))
            if values[u][i] > 0
                rated = rated.append(i)
                sum += values[u][i]
        user_ratings = user_ratings.append(rated)
        user_counts = user_counts.append(int(len(rated)))
        user_means = user_means.append(as_real(sum) / as_real(int(len(rated))))
    for: i < int(len(items))
        int[] rated := []
        sum := 0
        for: u < int(len(users))
            if values[u][i] > 0
                rated = rated.append(u)
                sum += values[u][i]
        item_ratings = item_ratings.append(rated)
        item_counts = item_counts.append(int(len(rated)))
        item_means = item_means.append(as_real(sum) / as_real(int(len(rated))))
    int[][] testing := []
    for row := numeric_csv("input/test.csv")[]
        testing = testing.append([find_id(users, row[0]), find_id(items, row[1]), row[2]])
    int[] catalog_ids := []
    string[] titles := []
    string[] genre_texts := []
    string[][] genres := []
    item_lines := lines("input/items.csv")
    for: 1 <= index < int(len(item_lines))
        fields := item_lines[index].split(",")
        catalog_ids = catalog_ids.append(integer(fields[0]))
        titles = titles.append(fields[1])
        genre_texts = genre_texts.append(fields[2])
        genres = genres.append(fields[2].split("|"))
    item_catalog := [for item := items[] then find_id(catalog_ids, item)]
    catalog := Catalog(catalog_ids, titles, genre_texts, genres)
    return Data(users, items, training, testing, catalog, item_catalog, values, user_ratings, item_ratings, user_counts, item_counts, user_means, item_means, as_real(total) / as_real(int(len(training))), read_params())
