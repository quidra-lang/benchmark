class Origin(string document, nat line)
    string text()
        return "{document}:{line}"

class Diagnostic(Origin origin, string code, string message)

class LogicalLine(nat number)
    string[] segments = []
    string code = ""
    string message = ""

    void .fail(string failure_code, string failure_message)
        if code == ""
            code = failure_code
            message = failure_message

string left_trim(string text)
    nat first = 0
    while first < len(text) and text[first] == " "
        first += 1
    return text[first:<len(text)]

string right_trim(string text)
    nat last = len(text)
    while last > 0 and text[last - 1] == " "
        last -= 1
    return text[0:<last]

string trim_spaces(string text)
    return right_trim(left_trim(text))

string[] read_lines(string path)
    string content = file.read(path)
    string[] physical = content.split(NL)
    return physical[0:<len(physical) - 1]

bool before(string left, string right)
    int[] left_codes = left.codepoints()
    int[] right_codes = right.codepoints()
    for nat index < len(left_codes)
        if index == len(right_codes)
            return false
        if left_codes[index] != right_codes[index]
            return left_codes[index] < right_codes[index]
    return len(left_codes) < len(right_codes)

T | error entry<T>(const map.Map<string, T> values, string key)
    match values.get(key)
        T found
            return found
        none
            return error("missing internal key: {key}")

LogicalLine[] logical_lines(string[] physical)
    LogicalLine[] result = []
    nat physical_index = 0
    while physical_index < len(physical)
        auto logical = LogicalLine(physical_index + 1)
        string source = physical[physical_index]
        physical_index += 1
        nat position = 0
        bool quoted = false
        string current = ""
        while position < len(source)
            string character = source[position]
            if character == "\" and position + 1 == len(source)
                source = left_trim(physical[physical_index])
                physical_index += 1
                position = 0
            elif quoted and character == "\"
                string follower = source[position + 1]
                if follower == "\" or follower == DQ
                    current += follower
                elif follower == "n"
                    current += NL
                elif follower == "t"
                    current += HT
                elif follower == "$"
                    // VT cannot occur in input or any other decoded escape.
                    current += VT
                else
                    .logical.fail("E_ESCAPE", "invalid escape sequence \" + follower)
                position += 2
            elif character == DQ
                logical.segments = logical.segments.append(current)
                current = ""
                quoted = not quoted
                position += 1
            elif not quoted and (character == ";" or character == "#")
                break
            else
                current += character
                position += 1
        if quoted
            .logical.fail("E_UNTERMINATED", "unterminated string")
        logical.segments = logical.segments.append(current)
        result = result.append(logical)
    return result
