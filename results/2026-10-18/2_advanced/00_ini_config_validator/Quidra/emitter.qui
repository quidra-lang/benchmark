import lexer = "./lexer.qui"
import ini = "./ini_parser.qui"
import interpolate = "./interpolate.qui"

class Output(interpolate.Definition definition, string kind, bool secret,
             string notation, int measure, bool truth, bool fixed, string limit)

class DiffEntry(string sign, string key, string before, string after)

class Diff(string first, string second)
    nat added = 0
    nat removed = 0
    nat changed = 0
    DiffEntry[] entries = []

string string_notation(string text)
    string result = DQ
    for nat index < len(text)
        string character = text[index]
        if character == "\"
            result += "\\"
        elif character == DQ
            result += "\" + DQ
        elif character == NL
            result += "\n"
        elif character == HT
            result += "\t"
        else
            result += character
    return result + DQ

string shown(Output output)
    return if output.secret then "********" else output.notation

string scalar_notation(string kind, string text, int number = 0, bool truth = false)
    if kind == "string"
        return string_notation(text)
    if kind == "bool"
        return if truth then "true" else "false"
    if kind == "int" or kind == "size" or kind == "duration"
        return number.string()
    return text

string list_notation(string[] items)
    return "[" + items.join(", ") + "]"

string[] normalized_block<P>(const P profile)
    string[] lines = ["profile " + profile.name]
    string previous = ""
    for auto key = ini.ordered_keys(profile.outputs.keys())[]
        string section = ini.section_of(key)
        if section != previous
            lines = lines.append("[" + section + "]")
            previous = section
        Output output = lexer.entry(profile.outputs, key)
        lines = lines.append(ini.key_name(key) + " = " + shown(output))
    return lines

string[] diagnostics_block<P>(const P profile)
    string[] lines = ["profile {profile.name} errors {profile.errors} warnings {profile.warnings}"]
    for auto diagnostic = profile.diagnostics[]
        lines = lines.append(diagnostic.origin.text() + " " + diagnostic.code + " " + diagnostic.message)
    return lines

string[] report_block<P>(const P profile)
    string[] lines = ["profile " + profile.name, "includes"]
    for (nat depth, string document) = profile.tree[]
        lines = lines.append(string.repeat(" ", 2 + 2 * depth) + document)
    lines = lines.append("overridden")
    if len(profile.overridden) == 0
        lines = lines.append("  (none)")
    for (string key, lexer.Origin[] history) = profile.overridden[]
        string[] origins = []
        for auto origin = history[]
            origins = origins.append(origin.text())
        lines = lines.append("  " + key + ": " + origins.join(" -> "))
    lines = lines.append("keys {profile.outputs.size()} documents {profile.document_keys} manifest {profile.manifest_keys} defaults {profile.default_keys}")
    lines = lines.append("dropped {profile.dropped}")
    lines = lines.append("errors {profile.errors} warnings {profile.warnings}")
    return lines

string[] diff_block(Diff difference)
    string[] lines = ["diff {difference.first} -> {difference.second}: {difference.added} added, {difference.removed} removed, {difference.changed} changed"]
    for auto change = difference.entries[]
        if change.sign == "+"
            lines = lines.append("+ {change.key} = {change.after}")
        elif change.sign == "-"
            lines = lines.append("- {change.key} = {change.before}")
        else
            lines = lines.append("~ {change.key}: {change.before} -> {change.after}")
    return lines

void write_outputs<P>(const P[] profiles, Diff[] differences)
    string[] normalized = []
    string[] diagnostics = []
    string[] reports = []
    string[] diffs = []
    for auto profile = profiles[]
        normalized = normalized.append(normalized_block(profile).join(NL))
        diagnostics = diagnostics.append(diagnostics_block(profile).join(NL))
        reports = reports.append(report_block(profile).join(NL))
    for auto difference = differences[]
        diffs = diffs.append(diff_block(difference).join(NL))
    bool exists = file.exists("output")
    if not exists
        file.mkdir("output")
    file.write("output/normalized.txt", normalized.join(NL + NL) + NL)
    file.write("output/diagnostics.txt", diagnostics.join(NL + NL) + NL)
    file.write("output/report.txt", reports.join(NL + NL) + NL)
    file.write("output/diff.txt", diffs.join(NL + NL) + NL)
