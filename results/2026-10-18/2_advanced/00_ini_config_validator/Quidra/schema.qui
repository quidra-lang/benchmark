import lexer = "./lexer.qui"
import ini = "./ini_parser.qui"

class Spec(nat line, string pattern, string kind)
    string[] section_parts = ini.section_of(pattern).split(".")
    string key = ini.key_name(pattern)
    bool wildcard = ini.section_of(pattern).contains("*")
    set.Set<string> flags
    map.Map<string, string> attributes

    bool has(string sought)
        return flags.has(sought) or attributes.has(sought)

    string attribute(string name, string fallback = "")
        match attributes.get(name)
            string value
                return value
            none
                return fallback

    bool matches(string section)
        string[] parts = section.split(".")
        if len(parts) != len(section_parts)
            return false
        for nat index < len(parts)
            if section_parts[index] != "*" and section_parts[index] != parts[index]
                return false
        return true

class Schema(Spec[] specs)
    Spec | none spec_for(string full_key)
        for auto exact = specs[]
            if not exact.wildcard and exact.pattern == full_key
                return exact
        string section = ini.section_of(full_key)
        string name = ini.key_name(full_key)
        for auto candidate = specs[]
            if candidate.wildcard and candidate.key == name and candidate.matches(section)
                return candidate
        return none

    string[] targets(Spec chosen, string[] sections)
        if not chosen.wildcard
            return [chosen.pattern]
        string[] result = []
        for auto section = sections.sorted()[]
            if not chosen.matches(section)
                continue
            string key = section + "." + chosen.key
            match spec_for(key)
                Spec actual
                    if actual.line == chosen.line
                        result = result.append(key)
                none
                    continue
        return result

Schema read_schema(string path)
    Spec[] specs = []
    string[] lines = lexer.read_lines(path)
    for string line = lines[nat index]
        if lexer.trim_spaces(line) == "" or line.starts_with("#")
            continue
        string[] words = line.split(" ")
        auto spec = Spec(index + 1, words[0], words[1])
        for 2 <= nat attribute_index < len(words)
            string word = words[attribute_index]
            match word.find("=")
                nat equals
                    .spec.attributes.set(word[0:<equals], word[equals + 1:<len(word)])
                none
                    .spec.flags.add(word)
        specs = specs.append(spec)
    return Schema(specs)
