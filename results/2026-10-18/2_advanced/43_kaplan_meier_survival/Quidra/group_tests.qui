import numeric = "./numerics.qui"
import estimators = "./estimators.qui"

string[] weights()
    return ["logrank", "gehan_wilcoxon", "tarone_ware"]

class Result(int[] groups, int[] events, real64[] observed, real64[] expected, real64[][] covariance)
    real64 statistic := 0.0
    degrees := 1
    real64 probability := 1.0

Result empty(int[] groups)
    size := int(groups.len())
    events := [for index := (0:<size)[] then 0]
    return Result(groups, events, numeric.zeros(size), numeric.zeros(size), numeric.matrix(size, size))

Result totals(int[][] subjects, int[] groups, string weight, int population_size)
    result := empty(groups)
    size := int(groups.len())
    for row := estimators.risk_sets(subjects)[]
        if row[2] == 0
            continue
        risks := [for index := (0:<size)[] then 0]
        deaths := risks
        n := 0
        d := 0
        for: h < size
            for subject := subjects[]
                if subject[1] == groups[h]
                    if subject[2] >= row[0]
                        risks[h] += 1
                    if subject[2] == row[0]
                        deaths[h] += subject[3]
            n += risks[h]
            d += deaths[h]
        real64 value := 1.0
        if weight == "gehan_wilcoxon"
            value = numeric.fraction(n, population_size)
        elif weight == "tarone_ware"
            value = numeric.root(numeric.fraction(n, population_size))
        for: h < size
            result.events[h] += deaths[h]
            result.observed[h] += value * numeric.as_real(deaths[h])
            result.expected[h] += value * numeric.fraction(d * risks[h], n)
            if n >= 2
                factor := value * value * numeric.fraction(d * (n - d), (n - 1) * n * n)
                for: other < size
                    multiple := if h == other then risks[h] * (n - risks[h]) else -(risks[h] * risks[other])
                    result.covariance[h][other] += factor * numeric.as_real(multiple)
    return result

Result finish(Result result)
    degrees := int(result.groups.len()) - 1
    real64[] difference := []
    real64[][] coefficients := []
    for: row < degrees
        difference = difference.append(result.observed[row] - result.expected[row])
        coefficients = coefficients.append(result.covariance[row][0:<degrees])
    solution := numeric.solve(coefficients, difference)
    real64 statistic := 0.0
    for: index < degrees
        statistic += difference[index] * solution[index]
    result.statistic = statistic
    result.degrees = degrees
    result.probability = numeric.p(statistic, degrees)
    return result

Result weighted_test(int[][] subjects, int[] groups, string weight, int population_size)
    return finish(totals(subjects, groups, weight, population_size))

Result combine(Result[] strata, int[] groups)
    result := empty(groups)
    for stratum := strata[]
        for: h < int(groups.len())
            result.events[h] += stratum.events[h]
            result.observed[h] += stratum.observed[h]
            result.expected[h] += stratum.expected[h]
            for: other < int(groups.len())
                result.covariance[h][other] += stratum.covariance[h][other]
    return finish(result)
