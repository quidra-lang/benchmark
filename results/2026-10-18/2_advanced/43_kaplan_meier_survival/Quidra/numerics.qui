import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

const real64 Z = 1.959963984540054

real64 root(real64 value)
    real64 result = math.sqrt(value)
    return result

real64 exponential(real64 value)
    real64 result = math.exp(value)
    return result

real64 logarithm(real64 value)
    real64 result = math.log(value)
    return result

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

real64 fraction(int numerator, int denominator)
    return as_real(numerator) / as_real(denominator)

real64[] zeros(int count)
    return [for int index = (0:<count)[] then 0.0]

real64[][] matrix(int rows, int columns)
    return [for int row = (0:<rows)[] then zeros(columns)]

real64[] solve(real64[][] coefficients, real64[] vector)
    real64[][] a = coefficients
    real64[] b = vector
    int size = int(len(b))
    for int k < size
        for k + 1 <= int i < size
            real64 factor = a[i][k] / a[k][k]
            for k <= int j < size
                a[i][j] -= factor * a[k][j]
            b[i] -= factor * b[k]
    real64[] solution = zeros(size)
    for int backwards < size
        int i = size - 1 - backwards
        real64 value = b[i]
        for i + 1 <= int j < size
            value -= a[i][j] * solution[j]
        solution[i] = value / a[i][i]
    return solution

real64[][] inverse(real64[][] coefficients)
    int size = int(len(coefficients))
    real64[][] result = matrix(size, size)
    for int column < size
        real64[] unit = zeros(size)
        unit[column] = 1.0
        real64[] solution = solve(coefficients, unit)
        for int row < size
            result[row][column] = solution[row]
    return result

real64 log_gamma(real64 a)
    real64[] coefficients = [76.18009172947146, -86.50532032941677, 24.01409824083091, -1.231739572450155, 0.001208650973866179, -0.000005395239384953]
    real64 xi = a + 5.5
    xi -= (a + 0.5) * logarithm(xi)
    real64 sigma = 1.000000000190015
    real64 y = a
    for real64 coefficient = coefficients[]
        y += 1.0
        sigma += coefficient / y
    return -xi + logarithm(2.5066282746310005 * sigma / a)

real64 gamma_q(real64 a, real64 x)
    if x == 0.0
        return 1.0
    real64 prefactor = exponential(-x + a * logarithm(x) - log_gamma(a))
    if x < a + 1.0
        real64 alpha = a
        real64 term = 1.0 / a
        real64 sigma = term
        for _ < 1000
            alpha += 1.0
            term *= x / alpha
            sigma += term
            if absolute(term) < absolute(sigma) * 1.0e-15
                break
        return 1.0 - sigma * prefactor
    real64 epsilon = 1.0e-300
    real64 b = x + 1.0 - a
    real64 c = 1.0 / epsilon
    real64 d = 1.0 / b
    real64 h = d
    for 1 <= int i <= 1000
        real64 an = -as_real(i) * (as_real(i) - a)
        b += 2.0
        d = an * d + b
        if absolute(d) < epsilon
            d = epsilon
        c = b + an / c
        if absolute(c) < epsilon
            c = epsilon
        d = 1.0 / d
        real64 delta = d * c
        h *= delta
        if absolute(delta - 1.0) < 1.0e-15
            break
    return prefactor * h

real64 p(real64 statistic, int degrees)
    return gamma_q(as_real(degrees) / 2.0, statistic / 2.0)
