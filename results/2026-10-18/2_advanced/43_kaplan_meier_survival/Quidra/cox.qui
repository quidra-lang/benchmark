import numeric = "./numerics.qui"

class EventSums(int moment, int events, real64 s0, real64[] s1)
class Evaluation(real64 loglik, real64[] score, real64[][] information, real64[] predictors, EventSums[] event_sums)
class Iteration(int number, real64 loglik, real64[] beta)
class Model(real64[] beta, Evaluation null_evaluation, Evaluation final_evaluation, Iteration[] iterations)

Evaluation evaluate(int[][] subjects, int[][] vectors, real64[] beta)
    int size = int(len(beta))
    real64[] predictors = []
    real64[] risks = []
    int[] order = []
    for int index < int(len(subjects))
        real64 value = 0.0
        for int c < size
            value += beta[c] * numeric.as_real(vectors[index][c])
        predictors = predictors.append(value)
        risks = risks.append(numeric.exponential(value))
        int place = int(len(order))
        for int position < int(len(order))
            int other = order[position]
            if subjects[index][2] > subjects[other][2] or (subjects[index][2] == subjects[other][2] and subjects[index][0] < subjects[other][0])
                place = position
                break
        order = order[0:<place].append(index).concat(order[place:<int(len(order))])
    real64 s0 = 0.0
    real64[] s1 = numeric.zeros(size)
    real64[][] s2 = numeric.matrix(size, size)
    real64 likelihood = 0.0
    real64[] score = numeric.zeros(size)
    real64[][] information = numeric.matrix(size, size)
    EventSums[] event_sums = []
    int position = 0
    while position < int(len(order))
        int moment = subjects[order[position]][2]
        int[] events = []
        while position < int(len(order))
            int index = order[position]
            if subjects[index][2] != moment
                break
            real64 risk = risks[index]
            int[] vector = vectors[index]
            s0 += risk
            for int c < size
                s1[c] += risk * numeric.as_real(vector[c])
                for int d < size
                    s2[c][d] += risk * numeric.as_real(vector[c]) * numeric.as_real(vector[d])
            if subjects[index][3] == 1
                events = events.append(index)
            position += 1
        int count = int(len(events))
        if count == 0
            continue
        real64 sum = 0.0
        for int index = events[]
            sum += predictors[index]
        likelihood += sum - numeric.as_real(count) * numeric.logarithm(s0)
        for int c < size
            int sum_x = 0
            for int index = events[]
                sum_x += vectors[index][c]
            score[c] += numeric.as_real(sum_x) - numeric.as_real(count) * s1[c] / s0
            for int d < size
                information[c][d] += numeric.as_real(count) * (s2[c][d] / s0 - (s1[c] / s0) * (s1[d] / s0))
        event_sums = event_sums.append(EventSums(moment, count, s0, s1))
    return Evaluation(likelihood, score, information, predictors, event_sums)

Model fit(int[][] subjects, int[][] vectors)
    real64[] beta = numeric.zeros(int(len(vectors[0])))
    Evaluation null_evaluation = evaluate(subjects, vectors, beta)
    Evaluation current = null_evaluation
    Iteration[] iterations = []
    for 1 <= int iteration <= 25
        real64[] change = numeric.solve(current.information, current.score)
        for int c < int(len(beta))
            beta[c] += change[c]
        iterations = iterations.append(Iteration(iteration, current.loglik, beta))
        current = evaluate(subjects, vectors, beta)
    return Model(beta, null_evaluation, current, iterations)
