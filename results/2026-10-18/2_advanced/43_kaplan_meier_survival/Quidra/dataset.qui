string[] read_lines(string path)
    string contents = file.read(path)
    string[] lines = contents.split(NL)
    return lines[0:<int(len(lines)) - 1]

int integer(string value)
    int result = int.parse(value)
    return result

int find_name(string[] names, string name)
    for int index < int(len(names))
        if names[index] == name
            return index
    return -1

class Params()
    string[] groups = []
    int[] report_times = []
    int tau = 1
    int width = 1
    int intervals = 1
    string strata = "sex"
    string[] subgroups = []
    int landmark = 1
    string[] covariates = []
    int residuals = 1
    int[] plot_size = []

Params read_params()
    Params params = Params()
    for string line = read_lines("input/params.txt")[]
        string[] fields = line.split(" ")
        string[] values = fields[1:<int(len(fields))]
        string key = fields[0]
        if key == "GROUPS"
            params.groups = values
        elif key == "REPORT_TIMES"
            params.report_times = [for string value = values[] then integer(value)]
        elif key == "TAU"
            params.tau = integer(values[0])
        elif key == "LIFE_TABLE"
            params.width = integer(values[0])
            params.intervals = integer(values[1])
        elif key == "STRATA"
            params.strata = values[0]
        elif key == "SUBGROUPS"
            params.subgroups = values
        elif key == "LANDMARK"
            params.landmark = integer(values[0])
        elif key == "COX"
            params.covariates = values
        elif key == "RESIDUALS"
            params.residuals = integer(values[0])
        elif key == "PLOT"
            params.plot_size = [for string value = values[] then integer(value)]
    return params

int[][] read_subjects(string[] groups)
    int[][] subjects = []
    string[] lines = read_lines("input/subjects.csv")
    for 1 <= int index < int(len(lines))
        string[] fields = lines[index].split(",")
        int[] row = [integer(fields[0]), find_name(groups, fields[1]), integer(fields[2]), integer(fields[3]), integer(fields[4]), if fields[5] == "M" then 1 else 0, integer(fields[6])]
        int place = int(len(subjects))
        for int position < int(len(subjects))
            if row[0] < subjects[position][0]
                place = position
                break
        subjects = subjects[0:<place].append(row).concat(subjects[place:<int(len(subjects))])
    return subjects
