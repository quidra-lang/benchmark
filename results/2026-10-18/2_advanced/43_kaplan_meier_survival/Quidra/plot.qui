import math
import numeric = "./numerics.qui"
import estimators = "./estimators.qui"

int floor_value(real64 value)
    int result = math.floor(value)
    return result

string[] curves(int[][][] collections, real64[][][] estimates, int width, int height, int time_limit)
    string[][] cells = []
    for int band < height
        string[] row = [for int column = (0:<width)[] then " "]
        cells = cells.append(row)
    for int group < int(len(collections))
        string letter = "ABCDEF"[group]
        int maximum = 0
        for int[] subject = collections[group][]
            if subject[2] > maximum
                maximum = subject[2]
        int previous = -1
        for int column < width
            int moment = column * (time_limit / width)
            if moment > maximum
                break
            real64[] row = estimators.row_at(estimates[group], moment)
            int band = floor_value(row[4] * numeric.as_real(height))
            if band >= height
                band = height - 1
            int last = band
            if previous - 1 > last
                last = previous - 1
            for band <= int vertical <= last
                string cell = cells[vertical][column]
                cells[vertical][column] = if cell == " " or cell == letter then letter else "*"
            previous = band
    string border = "   +" + string.repeat("-", nat(width)) + "+"
    string[] lines = [border]
    for int index < height
        int band = height - 1 - index
        string label = "{100 * band / height}"
        lines = lines.append(string.repeat(" ", nat(3 - int(len(label)))) + label + "|" + cells[band].join("") + "|")
    return lines.append(border)

string number(real64 value, int digits = 4)
    string result = if digits == 1 then "{value:frac=1}" else "{value:frac=4}"
    if result == "-0.0000" or result == "-0.0"
        return result[1:<int(len(result))]
    return result
