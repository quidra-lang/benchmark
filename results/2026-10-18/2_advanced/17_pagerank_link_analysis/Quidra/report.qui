import math

string fixed(real64 value, int places = 6)
    string text = if places == 4 then "{value:frac=4}" elif places == 10 then "{value:frac=10}" else "{value:frac=6}"
    if text == "-0.0000"
        return "0.0000"
    if text == "-0.000000"
        return "0.000000"
    if text == "-0.0000000000"
        return "0.0000000000"
    return text

int scaled(real64 value, int places = 6)
    real64 multiplier = if places == 4 then 10000.0 else 1000000.0
    int rounded = math.round(value * multiplier)
    return rounded

string fraction(int numerator, int denominator)
    int first = math.abs(numerator)
    int second = denominator
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    int reduced_numerator = numerator / first
    int reduced_denominator = denominator / first
    return "{reduced_numerator}/{reduced_denominator} {fixed(real64(reduced_numerator) / real64(reduced_denominator), 4)}"

string integers(int[] values)
    return [for int value = values[] then "{value}"].join(" ")

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
