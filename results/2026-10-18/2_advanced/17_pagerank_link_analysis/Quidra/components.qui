import math

class Frame(int node, int position)

int[][] strong_components(int[][] adjacency)
    int count = int(len(adjacency))
    int[] order = array(nat(count), fill = -1)
    int[] low = array(nat(count), fill = 0)
    bool[] on_stack = array(nat(count), fill = false)
    int[] stack = []
    int[][] groups = []
    int counter = 0
    for int root < count
        if order[root] != -1
            continue
        order[root] = counter
        low[root] = counter
        counter += 1
        stack = stack.append(root)
        on_stack[root] = true
        Frame[] work = [Frame(root, 0)]
        while len(work) > 0
            int last = int(len(work)) - 1
            int node = work[last].node
            int position = work[last].position
            if position < int(len(adjacency[node]))
                work[last].position += 1
                int child = adjacency[node][position]
                if order[child] == -1
                    order[child] = counter
                    low[child] = counter
                    counter += 1
                    stack = stack.append(child)
                    on_stack[child] = true
                    work = work.append(Frame(child, 0))
                elif on_stack[child]
                    low[node] = math.min(low[node], order[child])
                continue
            work = work[0:<last]
            if len(work) > 0
                int parent = work[len(work) - 1].node
                low[parent] = math.min(low[parent], low[node])
            if low[node] == order[node]
                int[] group = []
                while true
                    int member = stack[len(stack) - 1]
                    stack = stack[0:<len(stack) - 1]
                    on_stack[member] = false
                    group = group.append(member)
                    if member == node
                        break
                groups = groups.append(group)
    return groups

bool[] reachable(int[][] adjacency, int[] starts)
    bool[] seen = array(len(adjacency), fill = false)
    int[] stack = []
    for int node = starts[]
        if not seen[node]
            seen[node] = true
            stack = stack.append(node)
    while len(stack) > 0
        int node = stack[len(stack) - 1]
        stack = stack[0:<len(stack) - 1]
        for int neighbor = adjacency[node][]
            if not seen[neighbor]
                seen[neighbor] = true
                stack = stack.append(neighbor)
    return seen

int[] bfs_distances(int[][] adjacency, int[] starts)
    int[] distances = array(len(adjacency), fill = -1)
    int[] queue = []
    for int node = starts[]
        if distances[node] == -1
            distances[node] = 0
            queue = queue.append(node)
    int head = 0
    while head < int(len(queue))
        int node = queue[head]
        head += 1
        for int neighbor = adjacency[node][]
            if distances[neighbor] == -1
                distances[neighbor] = distances[node] + 1
                queue = queue.append(neighbor)
    return distances

int[] weak_components(int[][] neighbors)
    int[] labels = array(len(neighbors), fill = -1)
    int count = 0
    for int start < int(len(neighbors))
        if labels[start] != -1
            continue
        labels[start] = count
        int[] stack = [start]
        while len(stack) > 0
            int node = stack[len(stack) - 1]
            stack = stack[0:<len(stack) - 1]
            for int neighbor = neighbors[node][]
                if labels[neighbor] == -1
                    labels[neighbor] = count
                    stack = stack.append(neighbor)
        count += 1
    return labels
