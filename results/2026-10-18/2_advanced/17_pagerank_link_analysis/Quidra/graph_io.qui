string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

string[] parameter_fields(string line)
    string[] words = line.split(" ")
    return words[1:<len(words)]

class Page(int id, string host, string title)
    string[] words = title.split(" ")

class Record(int line, int source, int target)
class Link(int source, int target)
class Query(int number, string[] words, int[] seeds)

class Settings(local string[] lines)
    real64 damping = real64.parse(parameter_fields(lines[0])[0])
    int iterations = int.parse(parameter_fields(lines[1])[0])
    real64 tolerance = real64.parse(parameter_fields(lines[2])[0])
    real64[] sweep = [for string value = parameter_fields(lines[3])[] then real64.parse(value)]
    int[] trusted = [for string value = parameter_fields(lines[4])[] then int.parse(value)]
    int spam_top = int.parse(parameter_fields(lines[5])[0])
    real64 spam_threshold = real64.parse(parameter_fields(lines[6])[0])
    int hits_iterations = int.parse(parameter_fields(lines[7])[0])
    int top_k = int.parse(parameter_fields(lines[8])[0])
    int root_limit = int.parse(parameter_fields(lines[9])[0])
    int neighbor_limit = int.parse(parameter_fields(lines[10])[0])

class Input(Page[] pages, Record[] records, Query[] queries, Settings settings)

Input read_input()
    Page[] pages = []
    string[] page_lines = read_lines("input/pages.csv")
    for string line = page_lines[1:<len(page_lines)][]
        string[] fields = line.split(",")
        auto page = Page(int.parse(fields[0]), fields[1], fields[2])
        int position = int(len(pages))
        pages = pages.append(page)
        while position > 0 and pages[position - 1].id > page.id
            pages[position] = pages[position - 1]
            position -= 1
        pages[position] = page
    Record[] records = []
    string[] link_lines = read_lines("input/links.csv")
    for 1 <= int i < int(len(link_lines))
        string[] fields = link_lines[i].split(",")
        records = records.append(Record(i + 1, int.parse(fields[0]), int.parse(fields[1])))
    Query[] queries = []
    for string line = read_lines("input/queries.txt")[]
        string[] parts = line.split(" | ")
        int[] seeds = [for string value = parts[1].split(" ")[] then int.parse(value)]
        queries = queries.append(Query(int(len(queries)) + 1, parts[0].split(" "), seeds))
    return Input(pages, records, queries, Settings(read_lines("input/params.txt")))
