import math

class Edge(int source, int weight)
class Result(real64[] values, real64[] changes, int converged_at)

Result power_iteration(Edge[][] in_edges, int[] teleport, real64 damping, int iterations, real64 tolerance)
    count := int(len(in_edges))
    int[] out_weight := array(nat(count), fill = 0)
    for edges := in_edges[]
        for edge := edges[]
            out_weight[edge.source] += edge.weight
    bool[] selected := array(nat(count), fill = false)
    for node := teleport[]
        selected[node] = true
    size := int(len(teleport))
    real64[] values := [for included := selected[] then if included then 1.0 / real64(size) else 0.0]
    real64[] changes := []
    converged_at := 0
    for 1 <= int step <= iterations
        real64 dangling := math.sum([for node := (0:<count)[] if out_weight[node] == 0 then values[node]])
        real64 base := ((1.0 - damping) + damping * dangling) / real64(size)
        real64[] updated := []
        for int node < count
            real64 inflow := math.sum([for edge := in_edges[node][] then (values[edge.source] * real64(edge.weight)) / real64(out_weight[edge.source])])
            updated = updated.append(if selected[node] then damping * inflow + base else damping * inflow)
        real64 change := math.sum(math.abs(updated - values))
        changes = changes.append(change)
        values = updated
        if converged_at == 0 and change < tolerance
            converged_at = step
    return Result(values, changes, converged_at)
