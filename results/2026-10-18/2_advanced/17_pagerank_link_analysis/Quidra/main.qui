import math
import graph_io = "./graph_io.qui"
import components = "./components.qui"
import pagerank = "./pagerank.qui"
import hits = "./hits.qui"
import report = "./report.qui"

string[] region_names()
    return ["CORE", "IN", "OUT", "TUBE", "IN_TENDRIL", "OUT_TENDRIL", "OTHER"]

string[] quantity_names()
    return ["in_degree", "pagerank", "cheirank", "authority", "hub", "trustrank", "harmonic"]

int[] rank_order(real64[] values)
    int[] scaled_values = [for real64 value = values[] then report.scaled(value)]
    int[] order = []
    for int i < int(len(values))
        int position = int(len(order))
        order = order.append(i)
        while position > 0 and scaled_values[i] > scaled_values[order[position - 1]]
            order[position] = order[position - 1]
            position -= 1
        order[position] = i
    return order

int[] positions(int[] order)
    int[] ranks = array(len(order), fill = 0)
    for int i < int(len(order))
        ranks[order[i]] = i + 1
    return ranks

int[] take(int[] values, int limit)
    return values[0:<math.min(int(len(values)), limit)]

int[] top_list(real64[] values, int limit)
    int[] positive = [for int node = rank_order(values)[] if report.scaled(values[node]) > 0 then node]
    return take(positive, limit)

int[] ranked_counts(int[] counts, int limit)
    int[] positive = [for int node = rank_order(real64(counts))[] if counts[node] > 0 then node]
    return take(positive, limit)

string[] distribution(int[] values)
    int[] ordered = values.sorted()
    string[] lines = []
    int position = 0
    while position < int(len(ordered))
        int value = ordered[position]
        int count = 0
        while position < int(len(ordered)) and ordered[position] == value
            count += 1
            position += 1
        lines = lines.append("{value} {count}")
    return lines

string joined(string prefix, int[] values)
    return if len(values) == 0 then prefix else prefix + " " + report.integers(values)

string[] blocks(string[][] sections)
    string[] lines = []
    for string[] section = sections[]
        if len(lines) > 0
            lines = lines.append("")
        lines = lines.concat(section)
    return lines

string kendall(int[] first, int[] second)
    int result = 0
    int count = int(len(first))
    for int i < count
        for i + 1 <= int j < count
            int x = first[i] - first[j]
            int y = second[i] - second[j]
            if x != 0 and y != 0
                result += if (x > 0) == (y > 0) then 1 else -1
    return report.fraction(result, count * (count - 1) / 2)

class Graph(graph_io.Page[] pages, local graph_io.Link[] input_links)
    int n = int(len(pages))
    bool[][] present = array(nat(n), fill = array(nat(n), fill = false))
    for graph_io.Link edge = input_links[]
        present[edge.source][edge.target] = true
    graph_io.Link[] links = []
    local int[] empty_neighbors = []
    int[][] successors = array(nat(n), fill = empty_neighbors)
    int[][] predecessors = array(nat(n), fill = empty_neighbors)
    for int source < n
        for int target < n
            if present[source][target]
                links = links.append(graph_io.Link(source, target))
                successors[source] = successors[source].append(target)
                predecessors[target] = predecessors[target].append(source)

    bool intra(int source, int target)
        return pages[source].host == pages[target].host

    graph_io.Link[] inter_links()
        return [for graph_io.Link edge = links[] if not intra(edge.source, edge.target) then edge]

    pagerank.Edge[][] edges(bool reverse = false)
        int[][] neighbors = if reverse then successors else predecessors
        return [for int[] group = neighbors[] then [for int source = group[] then pagerank.Edge(source, 1)]]

    int[] dangling()
        return [for int node = (0:<n)[] if len(successors[node]) == 0 then node]

    int[] ids(int[] nodes)
        return [for int node = nodes[] then pages[node].id]

    string describe(int rank, int node, string value)
        return "{rank} {pages[node].id} {value} {pages[node].host} {pages[node].title}"

class Undirected(local Graph graph)
    local bool[][] adjacent = array(nat(graph.n), fill = array(nat(graph.n), fill = false))
    for graph_io.Link edge = graph.links[]
        adjacent[edge.source][edge.target] = true
        adjacent[edge.target][edge.source] = true
    int[][] neighbors = [for int node = (0:<graph.n)[] then [for int other = (0:<graph.n)[] if adjacent[node][other] then other]]
    int edge_count = math.sum([for int[] group = neighbors[] then int(len(group))]) / 2
    int closed = 0
    int possible = 0
    int eligible = 0
    local real64[] coefficients = []
    for int[] group = neighbors[]
        int degree = int(len(group))
        if degree < 2
            continue
        int triangles = 0
        for int i < degree
            for i + 1 <= int j < degree
                if adjacent[group[i]][group[j]]
                    triangles += 1
        int pairs = degree * (degree - 1) / 2
        closed += triangles
        possible += pairs
        eligible += 1
        coefficients = coefficients.append(real64(triangles) / real64(pairs))
    real64 average_clustering = math.sum(coefficients) / real64(eligible)
    int[] kcore = array(nat(graph.n), fill = 0)
    local int[] remaining = [for int[] group = neighbors[] then int(len(group))]
    local bool[] removed = array(nat(graph.n), fill = false)
    local int level = 0
    local int left = graph.n
    while left > 0
        int selected = -1
        for int node < graph.n
            if not removed[node] and remaining[node] <= level
                selected = node
                break
        if selected < 0
            level += 1
            continue
        removed[selected] = true
        kcore[selected] = level
        left -= 1
        for int neighbor = neighbors[selected][]
            if not removed[neighbor]
                remaining[neighbor] -= 1
    int degeneracy = math.max_all(kcore)
    local int[] weak_labels = components.weak_components(neighbors)
    int weak_count = math.max_all(weak_labels) + 1
    local int[] weak_sizes = array(nat(weak_count), fill = 0)
    for int label = weak_labels[]
        weak_sizes[label] += 1
    int weak_largest = math.max_all(weak_sizes)

class ComponentTable(local Graph graph)
    int[][] groups = components.strong_components(graph.successors)
    for int i < int(len(groups))
        groups[i] = groups[i].sorted()
    for 1 <= int i < int(len(groups))
        int[] current = groups[i]
        int position = i
        while position > 0 and current[0] < groups[position - 1][0]
            groups[position] = groups[position - 1]
            position -= 1
        groups[position] = current
    int[] labels = array(nat(graph.n), fill = 0)
    for int i < int(len(groups))
        for int node = groups[i][]
            labels[node] = i
    int[] incoming = array(len(groups), fill = 0)
    int[] outgoing = array(len(groups), fill = 0)
    local bool[][] condensed = array(len(groups), fill = array(len(groups), fill = false))
    int edge_count = 0
    for graph_io.Link edge = graph.links[]
        int first = labels[edge.source]
        int second = labels[edge.target]
        if first != second
            outgoing[first] += 1
            incoming[second] += 1
            if not condensed[first][second]
                condensed[first][second] = true
                edge_count += 1
    local int count = int(len(groups))
    local int[][] next_nodes = [for int node = (0:<count)[] then [for int target = (0:<count)[] if condensed[node][target] then target]]
    local int[] pending = array(nat(count), fill = 0)
    for int[] next_group = next_nodes[]
        for int target = next_group[]
            pending[target] += 1
    local int[] ready = [for int node = (0:<count)[] if pending[node] == 0 then node]
    local int[] lengths = array(nat(count), fill = 0)
    while len(ready) > 0
        int node = ready[len(ready) - 1]
        ready = ready[0:<len(ready) - 1]
        for int target = next_nodes[node][]
            lengths[target] = math.max(lengths[target], lengths[node] + 1)
            pending[target] -= 1
            if pending[target] == 0
                ready = ready.append(target)
    int depth = math.max_all(lengths)
    int core = 0
    for 1 <= int i < count
        if len(groups[i]) > len(groups[core])
            core = i
    int singletons = math.sum<int>([for int[] group = groups[] if len(group) == 1 then 1])

int[] bowtie(Graph graph, int[] core_pages)
    bool[] forward = components.reachable(graph.successors, core_pages)
    bool[] backward = components.reachable(graph.predecessors, core_pages)
    bool[] in_core = array(nat(graph.n), fill = false)
    for int node = core_pages[]
        in_core[node] = true
    int[] regions = array(nat(graph.n), fill = 6)
    for int node < graph.n
        if in_core[node]
            regions[node] = 0
        elif backward[node]
            regions[node] = 1
        elif forward[node]
            regions[node] = 2
    int[] in_pages = [for int node = (0:<graph.n)[] if regions[node] == 1 then node]
    int[] out_pages = [for int node = (0:<graph.n)[] if regions[node] == 2 then node]
    bool[] from_in = components.reachable(graph.successors, in_pages)
    bool[] to_out = components.reachable(graph.predecessors, out_pages)
    for int node < graph.n
        if regions[node] != 6
            continue
        if from_in[node] and to_out[node]
            regions[node] = 3
        elif from_in[node]
            regions[node] = 4
        elif to_out[node]
            regions[node] = 5
    return regions

class DistanceStats(local Graph graph)
    int pair_count = 0
    int distance_sum = 0
    int diameter = 0
    int diameter_source = -1
    int diameter_target = -1
    int[] histogram = array(nat(graph.n), fill = 0)
    real64[] harmonic = array(nat(graph.n), fill = 0.0)
    for int source < graph.n
        int[] distances = components.bfs_distances(graph.successors, [source])
        for int target < graph.n
            int steps = distances[target]
            if source == target or steps < 0
                continue
            pair_count += 1
            distance_sum += steps
            histogram[steps] += 1
            harmonic[target] += 1.0 / real64(steps)
            if steps > diameter
                diameter = steps
                diameter_source = source
                diameter_target = target
    int effective_diameter = diameter
    local int reached = 0
    for 1 <= int steps <= diameter
        reached += histogram[steps]
        if 10 * reached >= 9 * pair_count
            effective_diameter = steps
            break

class Scores(local Graph graph, local graph_io.Settings settings, local int[] trusted, real64[] harmonic)
    local int[] everyone = 0:<graph.n
    pagerank.Result pr_run = pagerank.power_iteration(graph.edges(), everyone, settings.damping, settings.iterations, settings.tolerance)
    pagerank.Result chei_run = pagerank.power_iteration(graph.edges(true), everyone, settings.damping, settings.iterations, settings.tolerance)
    pagerank.Result trust_run = pagerank.power_iteration(graph.edges(), trusted, settings.damping, settings.iterations, settings.tolerance)
    real64[] page_rank = pr_run.values
    real64[] cheirank = chei_run.values
    real64[] trustrank = trust_run.values
    int[] order = rank_order(page_rank)
    int[] ranks = positions(order)
    int[] chei_ranks = positions(rank_order(cheirank))
    real64[] trust_ratio = trustrank / page_rank
    int[] trust_distance = components.bfs_distances(graph.successors, trusted)
    local hits.Result all_hits = hits.iterate(graph.n, everyone, graph.inter_links(), settings.hits_iterations)
    real64[] authority = all_hits.authority
    real64[] hub = all_hits.hub

class Sweep(real64 damping, local Graph graph, local Scores scores, local graph_io.Settings settings)
    pagerank.Result result = pagerank.power_iteration(graph.edges(), 0:<graph.n, damping, settings.iterations, settings.tolerance)
    local int[] order = rank_order(result.values)
    local int[] ranks = positions(order)
    int overlap = 0
    int footrule = 0
    int shift = 0
    for int node < graph.n
        if ranks[node] <= settings.top_k and scores.ranks[node] <= settings.top_k
            overlap += 1
        footrule += math.abs(ranks[node] - scores.ranks[node])
        if math.abs(ranks[node] - scores.ranks[node]) > math.abs(ranks[shift] - scores.ranks[shift])
            shift = node
    int shift_rank = ranks[shift]
    int[] top = take(order, settings.top_k)
    string correlation = kendall([for real64 value = scores.page_rank[] then report.scaled(value)], [for real64 value = result.values[] then report.scaled(value)])

class Spam(local Graph graph, local Scores scores, local graph_io.Settings settings)
    int[] suspects = [for int node = take(scores.order, settings.spam_top)[] if real64(report.scaled(scores.trust_ratio[node], 4)) / 10000.0 < settings.spam_threshold then node]
    local set.Set<string> host_set
    for int node = suspects[]
        .host_set.add(graph.pages[node].host)
    string[] hosts = host_set.values().sorted()
    int removed = 0
    pagerank.Result | none demoted = none
    int[] ranks = []
    if len(suspects) > 0
        graph_io.Link[] kept = []
        for graph_io.Link edge = graph.links[]
            if graph.intra(edge.source, edge.target) and host_set.has(graph.pages[edge.source].host)
                removed += 1
            else
                kept = kept.append(edge)
        auto reduced_graph = Graph(graph.pages, kept)
        pagerank.Result result = pagerank.power_iteration(reduced_graph.edges(), 0:<graph.n, settings.damping, settings.iterations, settings.tolerance)
        demoted = result
        ranks = positions(rank_order(result.values))

real64[] salsa(int count, graph_io.Link[] links)
    int[] degree = array(nat(count), fill = 0)
    int[] empty_neighbors = []
    int[][] targets = array(nat(count), fill = empty_neighbors)
    int[][] neighbors = array(nat(count), fill = empty_neighbors)
    for graph_io.Link edge = links[]
        degree[edge.target] += 1
        targets[edge.source] = targets[edge.source].append(edge.target)
    for int[] group = targets[]
        for int i < int(len(group)) - 1
            neighbors[group[i]] = neighbors[group[i]].append(group[i + 1])
            neighbors[group[i + 1]] = neighbors[group[i + 1]].append(group[i])
    int[] labels = components.weak_components(neighbors)
    int[] sizes = array(nat(count), fill = 0)
    int[] mass = array(nat(count), fill = 0)
    int side = 0
    for int node < count
        if degree[node] > 0
            side += 1
            sizes[labels[node]] += 1
            mass[labels[node]] += degree[node]
    return [for int node = (0:<count)[] then if degree[node] == 0 then 0.0 else real64(sizes[labels[node]] * degree[node]) / real64(side * mass[labels[node]])]

class Subgraph(local Graph graph, local int[] base, local graph_io.Link[] links, local graph_io.Settings settings)
    local hits.Result hit_scores = hits.iterate(graph.n, base, links, settings.hits_iterations)
    real64[] authority = hit_scores.authority
    real64[] hub = hit_scores.hub
    real64[] salsa_authority = salsa(graph.n, links)
    real64[] salsa_hub = salsa(graph.n, [for graph_io.Link edge = links[] then graph_io.Link(edge.target, edge.source)])
    int[] authority_top = top_list(authority, settings.top_k)
    int[] hub_top = top_list(hub, settings.top_k)
    int[] salsa_authority_top = top_list(salsa_authority, settings.top_k)
    int[] salsa_hub_top = top_list(salsa_hub, settings.top_k)
    local bool[] authority_selected = array(nat(graph.n), fill = false)
    local bool[] hub_selected = array(nat(graph.n), fill = false)
    for int node = salsa_authority_top[]
        authority_selected[node] = true
    for int node = salsa_hub_top[]
        hub_selected[node] = true
    int authority_overlap = math.sum<int>([for int node = authority_top[] if authority_selected[node] then 1])
    int hub_overlap = math.sum<int>([for int node = hub_top[] if hub_selected[node] then 1])
    local set.Set<string> host_set
    for int node = authority_top[]
        .host_set.add(graph.pages[node].host)
    int authority_hosts = int(host_set.size())
    int cited = authority_top[0]
    int citing = hub_top[0]
    int[] cocitation = array(nat(graph.n), fill = 0)
    int[] coupling = array(nat(graph.n), fill = 0)
    for int source = graph.predecessors[cited][]
        for int target = graph.successors[source][]
            if target != cited
                cocitation[target] += 1
    for int target = graph.successors[citing][]
        for int source = graph.predecessors[target][]
            if source != citing
                coupling[source] += 1
    int[] related = ranked_counts(cocitation, settings.top_k)
    int[] similar = ranked_counts(coupling, settings.top_k)

bool title_matches(string[] title, string[] query)
    for string word = query[]
        bool excluded = word[0] == "-"
        string wanted = if excluded then word[1:<len(word)] else word
        bool found = false
        for string item = title[]
            if item == wanted
                found = true
                break
        if (excluded and found) or (not excluded and not found)
            return false
    return true

class QueryResult(graph_io.Query query, local Graph graph, local Scores scores, local graph_io.Settings settings, local int[] index_by_id)
    int[] matches = [for int node = scores.order[] if title_matches(graph.pages[node].words, query.words) then node]
    local int[] root = take(matches, settings.root_limit)
    int root_size = int(len(root))
    local bool[] included = array(nat(graph.n), fill = false)
    for int node = root[]
        included[node] = true
        for int neighbor = take(graph.successors[node], settings.neighbor_limit)[]
            included[neighbor] = true
        for int neighbor = take(graph.predecessors[node], settings.neighbor_limit)[]
            included[neighbor] = true
    local int[] base = [for int node = (0:<graph.n)[] if included[node] then node]
    int base_size = int(len(base))
    graph_io.Link[] links = []
    int dropped = 0
    for graph_io.Link edge = graph.links[]
        if included[edge.source] and included[edge.target]
            if graph.intra(edge.source, edge.target)
                dropped += 1
            else
                links = links.append(edge)
    local int[] seeds = ([for int id = query.seeds[] then index_by_id[id]]).sorted()
    pagerank.Result personalized = pagerank.power_iteration(graph.edges(), seeds, settings.damping, settings.iterations, settings.tolerance)
    int reach = math.sum<int>([for bool seen = components.reachable(graph.successors, seeds)[] if seen then 1])
    real64 seed_mass = math.sum(personalized.values[seeds])
    int[] personal_top = top_list(personalized.values, settings.top_k)
    int global_overlap = math.sum<int>([for int node = personal_top[] if scores.ranks[node] <= settings.top_k then 1])
    Subgraph | none subgraph = if len(links) == 0 then none else Subgraph(graph, base, links, settings)

int host_position(string[] names, string wanted)
    for int i < int(len(names))
        if names[i] == wanted
            return i
    return -1

class HostGraph(local Graph graph, local graph_io.Settings settings)
    local set.Set<string> host_set
    for graph_io.Page page = graph.pages[]
        .host_set.add(page.host)
    string[] names = host_set.values().sorted()
    local int count = int(len(names))
    local int[] empty_members = []
    int[][] members = array(nat(count), fill = empty_members)
    local int[] of_page = []
    for int node < graph.n
        int host = host_position(names, graph.pages[node].host)
        of_page = of_page.append(host)
        members[host] = members[host].append(node)
    int[][] weight = array(nat(count), fill = array(nat(count), fill = 0))
    int[] internal = array(nat(count), fill = 0)
    int[] outgoing = array(nat(count), fill = 0)
    int[] incoming = array(nat(count), fill = 0)
    for graph_io.Link edge = graph.links[]
        int first = of_page[edge.source]
        int second = of_page[edge.target]
        if first == second
            internal[first] += 1
        else
            weight[first][second] += 1
            outgoing[first] += 1
            incoming[second] += 1
    graph_io.Link[] edges = []
    local int[][] adjacency = array(nat(count), fill = empty_members)
    local pagerank.Edge[] empty_edges = []
    local pagerank.Edge[][] in_edges = array(nat(count), fill = empty_edges)
    int reciprocal = 0
    for int first < count
        for int second < count
            if weight[first][second] > 0
                edges = edges.append(graph_io.Link(first, second))
                adjacency[first] = adjacency[first].append(second)
                in_edges[second] = in_edges[second].append(pagerank.Edge(first, weight[first][second]))
                if weight[second][first] > 0
                    reciprocal += 1
    local int[][] strong_groups = components.strong_components(adjacency)
    int component_count = int(len(strong_groups))
    int largest = math.max_all([for int[] group = strong_groups[] then int(len(group))])
    pagerank.Result result = pagerank.power_iteration(in_edges, 0:<count, settings.damping, settings.iterations, settings.tolerance)
    int[] ranks = positions(rank_order(result.values))
    graph_io.Link[] heavy = []
    for graph_io.Link edge = edges[]
        int position = int(len(heavy))
        heavy = heavy.append(edge)
        while position > 0 and weight[edge.source][edge.target] > weight[heavy[position - 1].source][heavy[position - 1].target]
            heavy[position] = heavy[position - 1]
            position -= 1
        heavy[position] = edge
    heavy = heavy[0:<math.min(int(len(heavy)), settings.top_k)]

class Ignored(graph_io.Record record, string reason)

string[] convergence_block(string heading, pagerank.Result result)
    string[] lines = ["", heading]
    for 10 <= int step <= int(len(result.changes)) step 10
        lines = lines.append("iteration {step} l1 {report.fixed(result.changes[step - 1], 10)}")
    string converged = if result.converged_at == 0 then "none" else "{result.converged_at}"
    return lines.append("converged_at {converged}")

string[] optional_convergence(string heading, pagerank.Result | none result)
    match result
        none
            return []
        pagerank.Result present
            return convergence_block(heading, present)

class Analysis(graph_io.Input data)
    graph_io.Settings settings = data.settings
    int[] index_by_id = array(10000, fill = -1)
    for int i < int(len(data.pages))
        index_by_id[data.pages[i].id] = i
    Ignored[] ignored = []
    local graph_io.Link[] accepted_links = []
    local bool[][] accepted = array(len(data.pages), fill = array(len(data.pages), fill = false))
    for graph_io.Record record = data.records[]
        int source = index_by_id[record.source]
        int target = index_by_id[record.target]
        string reason = ""
        if source < 0 or target < 0
            reason = "unknown"
        elif source == target
            reason = "self"
        elif accepted[source][target]
            reason = "duplicate"
        else
            accepted[source][target] = true
            accepted_links = accepted_links.append(graph_io.Link(source, target))
        if reason != ""
            ignored = ignored.append(Ignored(record, reason))
    Graph graph = Graph(data.pages, accepted_links)
    Undirected undirected = Undirected(graph)
    ComponentTable component_table = ComponentTable(graph)
    int[] regions = bowtie(graph, component_table.groups[component_table.core])
    DistanceStats distances = DistanceStats(graph)
    local int[] trusted = ([for int id = settings.trusted[] then index_by_id[id]]).sorted()
    Scores scores = Scores(graph, settings, trusted, distances.harmonic)
    Sweep[] sweeps = [for real64 damping = settings.sweep[] then Sweep(damping, graph, scores, settings)]
    Spam spam = Spam(graph, scores, settings)
    QueryResult[] queries = [for graph_io.Query query = data.queries[] then QueryResult(query, graph, scores, settings, index_by_id)]
    HostGraph hosts = HostGraph(graph, settings)

    int representative(int[] nodes)
        int best = nodes[0]
        for int node = nodes[]
            if scores.ranks[node] < scores.ranks[best]
                best = node
        return best

    string[] rank_lines(int[] nodes, real64[] values)
        return [for int i = (0:<int(len(nodes)))[] then graph.describe(i + 1, nodes[i], report.fixed(values[nodes[i]]))]

    string[] graph_stats_file()
        int unknown = math.sum<int>([for Ignored item = ignored[] if item.reason == "unknown" then 1])
        int self_links = math.sum<int>([for Ignored item = ignored[] if item.reason == "self" then 1])
        int duplicates = math.sum<int>([for Ignored item = ignored[] if item.reason == "duplicate" then 1])
        int intra = math.sum<int>([for graph_io.Link edge = graph.links[] if graph.intra(edge.source, edge.target) then 1])
        int reciprocal = math.sum<int>([for graph_io.Link edge = graph.links[] if graph.present[edge.target][edge.source] then 1])
        int[] in_degree = [for int[] group = graph.predecessors[] then int(len(group))]
        int[] out_degree = [for int[] group = graph.successors[] then int(len(group))]
        int max_in = math.max_all(in_degree)
        int max_out = math.max_all(out_degree)
        string[] lines = ["pages {graph.n}", "hosts {len(hosts.names)}", "link_rows {len(data.records)}", "links {len(graph.links)}", "ignored_unknown {unknown}", "ignored_self {self_links}", "ignored_duplicate {duplicates}"]
        for Ignored item = ignored[]
            lines = lines.append("ignored line {item.record.line} {item.record.source},{item.record.target} {item.reason}")
        lines = lines.concat(["intra_host_links {intra}", "inter_host_links {int(len(graph.links)) - intra}", "mean_degree {report.fixed(real64(len(graph.links)) / real64(graph.n), 4)}", "reciprocity {report.fraction(reciprocal, int(len(graph.links)))}"])
        int[] dangling = graph.dangling()
        int[] no_in = [for int node = (0:<graph.n)[] if in_degree[node] == 0 then node]
        int[] max_in_pages = [for int node = (0:<graph.n)[] if in_degree[node] == max_in then node]
        int[] max_out_pages = [for int node = (0:<graph.n)[] if out_degree[node] == max_out then node]
        lines = lines.concat([joined("dangling {len(dangling)}", graph.ids(dangling)), joined("no_in_links {len(no_in)}", graph.ids(no_in)), joined("max_in_degree {max_in} pages", graph.ids(max_in_pages)), joined("max_out_degree {max_out} pages", graph.ids(max_out_pages))])
        lines = lines.concat(["", "in_degree_distribution"]).concat(distribution(in_degree))
        lines = lines.concat(["", "out_degree_distribution"]).concat(distribution(out_degree))
        int degeneracy_pages = math.sum<int>([for int value = undirected.kcore[] if value == undirected.degeneracy then 1])
        lines = lines.concat(["", "undirected_links {undirected.edge_count}", "transitivity {report.fraction(undirected.closed, undirected.possible)}", "average_clustering {report.fixed(undirected.average_clustering, 4)} pages {undirected.eligible}", "degeneracy {undirected.degeneracy} pages {degeneracy_pages}", "core_distribution"]).concat(distribution(undirected.kcore))
        lines = lines.concat(["", "strong_components {len(component_table.groups)} largest {len(component_table.groups[component_table.core])} singletons {component_table.singletons} condensation_links {component_table.edge_count}", "weak_components {undirected.weak_count} largest {undirected.weak_largest}", "condensation_depth {component_table.depth}"])
        for int i < int(len(component_table.groups))
            int[] group = component_table.groups[i]
            if len(group) < 2
                continue
            string suffix = if component_table.outgoing[i] == 0 then " sink" else ""
            real64 mass = math.sum(scores.page_rank[group])
            lines = lines.append("scc {i + 1} size {len(group)} min {graph.pages[group[0]].id} incoming {component_table.incoming[i]} outgoing {component_table.outgoing[i]} pagerank {report.fixed(mass)}{suffix}")
        string[] names = region_names()
        lines = lines.concat(["", "bowtie core_scc {component_table.core + 1}"])
        for int region < 7
            int[] members = [for int node = (0:<graph.n)[] if regions[node] == region then node]
            string text = "{names[region]} {len(members)} pagerank {report.fixed(math.sum(scores.page_rank[members]))}"
            if len(members) > 0
                text += " top {graph.pages[representative(members)].id}"
            if 1 <= len(members) <= 10
                text = joined(text + " pages", graph.ids(members))
            lines = lines.append(text)
        int[][] counts = array(7, fill = array(7, fill = 0))
        for graph_io.Link edge = graph.links[]
            counts[regions[edge.source]][regions[edge.target]] += 1
        lines = lines.append("region_links")
        for int first < 7
            for int second < 7
                if counts[first][second] > 0
                    lines = lines.append("{names[first]} {names[second]} {counts[first][second]}")
        lines = lines.concat(["", "distances", "reachable_pairs {distances.pair_count}", "average {report.fraction(distances.distance_sum, distances.pair_count)}", "diameter {distances.diameter} from {graph.pages[distances.diameter_source].id} to {graph.pages[distances.diameter_target].id}", "effective_diameter {distances.effective_diameter}"])
        for 1 <= int steps <= distances.diameter
            lines = lines.append("{steps} {distances.histogram[steps]}")
        return lines

    string[] pagerank_file()
        string[] names = region_names()
        string[] lines = ["id,in_degree,out_degree,scc,region,kcore,harmonic,pagerank,pagerank_rank,cheirank,cheirank_rank,authority,hub,trustrank,trust_ratio,trust_distance"]
        for int node < graph.n
            string[] fields = ["{graph.pages[node].id}", "{len(graph.predecessors[node])}", "{len(graph.successors[node])}", "{component_table.labels[node] + 1}", names[regions[node]], "{undirected.kcore[node]}", report.fixed(scores.harmonic[node]), report.fixed(scores.page_rank[node]), "{scores.ranks[node]}", report.fixed(scores.cheirank[node]), "{scores.chei_ranks[node]}", report.fixed(scores.authority[node]), report.fixed(scores.hub[node]), report.fixed(scores.trustrank[node]), report.fixed(scores.trust_ratio[node], 4), "{scores.trust_distance[node]}"]
            lines = lines.append(fields.join(","))
        return lines

    string[] score_block(string name, real64[] values)
        return ["{name} top {settings.top_k}"].concat(rank_lines(top_list(values, settings.top_k), values))

    string[] pagerank_block()
        int[] nodes = top_list(scores.page_rank, settings.top_k)
        string[] lines = score_block("pagerank", scores.page_rank)
        lines = lines.append("dangling_mass {report.fixed(math.sum(scores.page_rank[graph.dangling()]))}")
        real64[] contributions = [for int node = (0:<graph.n)[] then if len(graph.successors[node]) == 0 then 0.0 else (settings.damping * scores.page_rank[node]) / real64(len(graph.successors[node]))]
        int[] order = rank_order(contributions)
        for int node = nodes[]
            int[] contributors = take([for int source = order[] if graph.present[source][node] then source], 3)
            string[] parts = ["contributors", "{graph.pages[node].id}"]
            for int source = contributors[]
                parts = parts.concat(["{graph.pages[source].id}", report.fixed(contributions[source])])
            lines = lines.append(parts.join(" "))
        return lines

    string[] correlation_block()
        int[][] series = [[for int[] group = graph.predecessors[] then int(len(group))]]
        for real64[] values = [scores.page_rank, scores.cheirank, scores.authority, scores.hub, scores.trustrank, scores.harmonic][]
            series = series.append([for real64 value = values[] then report.scaled(value)])
        string[] names = quantity_names()
        string[] lines = ["correlation"]
        for int first < 7
            for first + 1 <= int second < 7
                lines = lines.append("{names[first]} {names[second]} {kendall(series[first], series[second])}")
        return lines

    string[] sweep_block()
        string[] lines = ["damping_sweep"]
        for Sweep sweep = sweeps[]
            lines = lines.append("damping {report.fixed(sweep.damping, 4)} overlap {sweep.overlap} footrule {sweep.footrule} kendall {sweep.correlation} largest_shift {graph.pages[sweep.shift].id} {scores.ranks[sweep.shift]} {sweep.shift_rank}")
            lines = lines.append(joined("top", graph.ids(sweep.top)))
        return lines

    string[] spam_block()
        string[] lines = ["spam top {settings.spam_top} threshold {report.fixed(settings.spam_threshold, 4)}"]
        for int node = spam.suspects[]
            lines = lines.append("suspect {graph.pages[node].id} rank {scores.ranks[node]} pagerank {report.fixed(scores.page_rank[node])} trustrank {report.fixed(scores.trustrank[node])} trust_ratio {report.fixed(scores.trust_ratio[node], 4)} trust_distance {scores.trust_distance[node]} kcore {undirected.kcore[node]} {graph.pages[node].host}")
        lines = lines.concat(["count {len(spam.suspects)}", "trust_by_distance"])
        set.Set<int> distance_set
        for int distance = scores.trust_distance[]
            if distance >= 0
                .distance_set.add(distance)
        int[] distance_values = distance_set.values().sorted()
        for int distance = scores.trust_distance[]
            if distance == -1
                distance_values = distance_values.append(-1)
                break
        for int distance = distance_values[]
            int[] members = [for int node = (0:<graph.n)[] if scores.trust_distance[node] == distance then node]
            string label = if distance == -1 then "unreachable" else "{distance}"
            lines = lines.append("{label} pages {len(members)} trustrank {report.fixed(math.sum(scores.trustrank[members]))} pagerank {report.fixed(math.sum(scores.page_rank[members]))}")
        return lines

    string[] demotion_block()
        match spam.demoted
            none
                return ["demotion none"]
            pagerank.Result result
                string[] lines = ["demotion hosts " + spam.hosts.join(" ") + " removed_links {spam.removed}"]
                int[] top = top_list(result.values, settings.top_k)
                for int i < int(len(top))
                    int node = top[i]
                    lines = lines.append(graph.describe(i + 1, node, "{report.fixed(result.values[node])} was {scores.ranks[node]}"))
                for int node = spam.suspects[]
                    lines = lines.append("suspect {graph.pages[node].id} before {scores.ranks[node]} after {spam.ranks[node]}")
                return lines

    string[] host_block()
        string[] lines = ["host_graph hosts {len(hosts.names)} links {len(hosts.edges)} reciprocal {hosts.reciprocal} strong_components {hosts.component_count} largest {hosts.largest}", "host_links top {settings.top_k}"]
        for graph_io.Link edge = hosts.heavy[]
            lines = lines.append("{hosts.names[edge.source]} {hosts.names[edge.target]} {hosts.weight[edge.source][edge.target]}")
        return lines

    string[] rankings_file()
        return blocks([pagerank_block(), score_block("cheirank", scores.cheirank), score_block("authority", scores.authority), score_block("hub", scores.hub), score_block("trustrank", scores.trustrank), score_block("harmonic", scores.harmonic), correlation_block(), sweep_block(), spam_block(), demotion_block(), host_block()])

    string[] convergence_file()
        string damping = report.fixed(settings.damping, 4)
        string[] lines = ["iterations {settings.iterations} tolerance {report.fixed(settings.tolerance, 10)}"]
        lines = lines.concat(convergence_block("pagerank damping {damping}", scores.pr_run))
        lines = lines.concat(convergence_block("cheirank damping {damping}", scores.chei_run))
        lines = lines.concat(convergence_block("trustrank damping {damping} seeds {len(settings.trusted)}", scores.trust_run))
        for Sweep sweep = sweeps[]
            lines = lines.concat(convergence_block("sweep damping {report.fixed(sweep.damping, 4)}", sweep.result))
        lines = lines.concat(optional_convergence("demoted damping {damping}", spam.demoted))
        for QueryResult query = queries[]
            lines = lines.concat(convergence_block("personalized query {query.query.number} damping {damping}", query.personalized))
        return lines.concat(convergence_block("host_pagerank damping {damping} hosts {len(hosts.names)}", hosts.result))

    string[] query_lines(QueryResult result)
        string[] lines = ["query {result.query.number} words " + result.query.words.join(" ") + " seeds " + report.integers(result.query.seeds), "matched {len(result.matches)} root {result.root_size} base {result.base_size} links {len(result.links)} dropped_intra_host {result.dropped}", "results"]
        lines = lines.concat(rank_lines(take(result.matches, settings.top_k), scores.page_rank))
        lines = lines.append("personalized reach {result.reach} seed_mass {report.fixed(result.seed_mass)}")
        lines = lines.concat(rank_lines(result.personal_top, result.personalized.values))
        lines = lines.append("overlap_with_global {result.global_overlap}")
        match result.subgraph
            none
                return lines.append("hits none")
            Subgraph sub
                lines = lines.append("hits authorities").concat(rank_lines(sub.authority_top, sub.authority))
                lines = lines.append("hits hubs").concat(rank_lines(sub.hub_top, sub.hub))
                lines = lines.append("salsa authorities").concat(rank_lines(sub.salsa_authority_top, sub.salsa_authority))
                lines = lines.append("salsa hubs").concat(rank_lines(sub.salsa_hub_top, sub.salsa_hub))
                lines = lines.append("hits_salsa_overlap authorities {sub.authority_overlap} hubs {sub.hub_overlap} authority_hosts {sub.authority_hosts}")
                lines = lines.append("related_to {graph.pages[sub.cited].id} citing {len(graph.predecessors[sub.cited])}")
                for int i < int(len(sub.related))
                    int node = sub.related[i]
                    lines = lines.append(graph.describe(i + 1, node, "{sub.cocitation[node]}"))
                lines = lines.append("coupled_to {graph.pages[sub.citing].id} cited {len(graph.successors[sub.citing])}")
                for int i < int(len(sub.similar))
                    int node = sub.similar[i]
                    lines = lines.append(graph.describe(i + 1, node, "{sub.coupling[node]}"))
                return lines

    string[] queries_file()
        return blocks([for QueryResult result = queries[] then query_lines(result)])

    string[] hosts_file()
        string[] lines = ["host,pages,core_pages,internal_links,internal_density,outgoing_links,incoming_links,dangling_pages,page_score_sum,top_page,score,rank"]
        for int i < int(len(hosts.names))
            int[] members = hosts.members[i]
            int size = int(len(members))
            int core = math.sum<int>([for int node = members[] if regions[node] == 0 then 1])
            int dangling = math.sum<int>([for int node = members[] if len(graph.successors[node]) == 0 then 1])
            real64 density = if size >= 2 then real64(hosts.internal[i]) / real64(size * (size - 1)) else 0.0
            string[] fields = [hosts.names[i], "{size}", "{core}", "{hosts.internal[i]}", report.fixed(density, 4), "{hosts.outgoing[i]}", "{hosts.incoming[i]}", "{dangling}", report.fixed(math.sum(scores.page_rank[members])), "{graph.pages[representative(members)].id}", report.fixed(hosts.result.values[i]), "{hosts.ranks[i]}"]
            lines = lines.append(fields.join(","))
        return lines

void run()
    auto study = Analysis(graph_io.read_input())
    file.mkdir("output")
    report.write_lines("graph_stats.txt", study.graph_stats_file())
    report.write_lines("pagerank.csv", study.pagerank_file())
    report.write_lines("rankings.txt", study.rankings_file())
    report.write_lines("convergence.txt", study.convergence_file())
    report.write_lines("queries.txt", study.queries_file())
    report.write_lines("hosts.csv", study.hosts_file())

if main
    run()
