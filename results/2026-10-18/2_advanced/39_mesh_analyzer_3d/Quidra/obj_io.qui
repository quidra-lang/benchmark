bool has_string(string[] values, string target)
    for value := values[]
        if value == target
            return true
    return false

string[] read_lines(string path)
    content := string.from_utf8(file.read_bin(path))
    lines := content.split(NL)
    return lines[0:<int(len(lines)) - 1]

bool integer_word(string word)
    digits := if word.starts_with("-") then word[1:<int(len(word))] else word
    if digits == ""
        return false
    for int index < int(len(digits))
        if not "0123456789".contains(digits[index])
            return false
    return true

int decimal(string word)
    negative := word.starts_with("-")
    int value := 0
    for (if negative then 1 else 0) <= int index < int(len(word))
        digit := int.parse(word[index])
        value = value * 10 + digit
    return if negative then -value else value

string listing(int[] values)
    fields := [for int value := values[] then "{value}"]
    return if len(fields) == 0 then "-" else fields.join(" ")

class Source()
    int lines := 0
    int[][] vertices := []
    int[][] polygons := []
    int[] polygon_lines := []
    string[] polygon_groups := []
    string[] errors := []
    int ignored := 0

Source read_obj()
    source := Source()
    group := "default"
    lines := read_lines("input/model.obj")
    source.lines = int(len(lines))
    ignored_keywords := ["vt", "vn", "s", "o", "usemtl", "mtllib"]
    for int index < int(len(lines))
        line := lines[index]
        if line == "" or line.starts_with("#")
            continue
        words := line.split(" ")
        keyword := words[0]
        args := words[1:<int(len(words))]
        reason := ""
        if keyword == "v"
            valid := len(args) == 3
            for word := args[]
                valid = valid and integer_word(word)
            if valid
                source.vertices = source.vertices.append([decimal(args[0]), decimal(args[1]), decimal(args[2])])
            else
                reason = "bad_vertex"
        elif keyword == "f"
            if len(args) < 3
                reason = "short_face"
            else
                int[] vertices := []
                for reference := args[]
                    part := reference.split("/")[0]
                    if not integer_word(part) or decimal(part) == 0
                        reason = "bad_index"
                        break
                    number := decimal(part)
                    if number < 0
                        number = int(len(source.vertices)) + 1 + number
                    if number < 1 or number > int(len(source.vertices))
                        reason = "out_of_range"
                        break
                    vertices = vertices.append(number)
                if reason == ""
                    source.polygons = source.polygons.append(vertices)
                    source.polygon_lines = source.polygon_lines.append(index + 1)
                    source.polygon_groups = source.polygon_groups.append(group)
        elif keyword == "g"
            group = if len(args) > 0 then args[0] else "default"
        elif has_string(ignored_keywords, keyword)
            source.ignored += 1
        else
            reason = "unknown_keyword"
        if reason != ""
            source.errors = source.errors.append("line {index + 1} {reason}")
    return source

string[] repaired(int[][] points, int[][] faces, string[] groups)
    result := ["# vertices {len(points)} faces {len(faces)}"]
    for point := points[]
        result = result.append("v " + listing(point))
    previous := ""
    for int index < int(len(faces))
        if groups[index] != previous
            result = result.append("g " + groups[index])
            previous = groups[index]
        result = result.append("f " + listing(faces[index][0:<3]))
    return result
