public import topology = "./topology.qui"

bool has_directed(int[] face, int first, int second)
    for int[] edge = topology.directed(face)[]
        if edge[0] == first and edge[1] == second
            return true
    return false

void flip(int[] &face)
    int saved = face[1]
    face[1] = face[2]
    face[2] = saved

int[] inconsistent(int[][] faces, int[][] edges, int[][] edge_faces)
    int[] result = []
    for int index < int(len(edges))
        int[] adjacent = edge_faces[index]
        if len(adjacent) == 2 and has_directed(faces[adjacent[0] - 1], edges[index][0], edges[index][1]) == has_directed(faces[adjacent[1] - 1], edges[index][0], edges[index][1])
            result = result.append(index)
    return result

void repair(int[][] &faces, int[][] edges, int[][] edge_faces)
    bool[] visited = array(len(faces), fill = false)
    for 1 <= int seed <= int(len(faces))
        if visited[seed - 1]
            continue
        visited[seed - 1] = true
        int[] queue = [seed]
        int head = 0
        while head < int(len(queue))
            int current = queue[head]
            head += 1
            int[][] pairs = topology.directed(faces[current - 1])
            for int[] pair = pairs[]
                int index = topology.edge_index(edges, pair[0], pair[1])
                int[] adjacent = edge_faces[index]
                if len(adjacent) != 2
                    continue
                int other = if adjacent[0] == current then adjacent[1] else adjacent[0]
                if not visited[other - 1]
                    if has_directed(faces[other - 1], pair[0], pair[1])
                        int[] changed = faces[other - 1]
                        flip(&changed)
                        faces[other - 1] = changed
                    visited[other - 1] = true
                    queue = queue.append(other)
