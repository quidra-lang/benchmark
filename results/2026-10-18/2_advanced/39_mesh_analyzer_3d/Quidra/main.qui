import io = "./obj_io.qui"
import measure = "./measure.qui"
import repair = "./repair.qui"
import orientation = "./orientation.qui"

bool has_int(int[] values, int target)
    for int value = values[]
        if value == target
            return true
    return false

bool has_string(string[] values, string target)
    for string value = values[]
        if value == target
            return true
    return false

string yes(bool value)
    return if value then "yes" else "no"

int[] numbers(int count)
    int[] result = []
    for 1 <= int index <= count
        result = result.append(index)
    return result

int[] unique_sorted(int[] values)
    int[] result = []
    for int value = values.sorted()[]
        if not has_int(result, value)
            result = result.append(value)
    return result

class Query(string kind, int[] args)
class Settings()
    int spacing = 1
    bool merge = true
    bool degenerate = true
    bool duplicates = true
    bool orient = true
    bool outward = true
    int fill_holes = 0
    bool keep_unused = true
    string[] sections = ["summary", "components"]
    Query[] queries = []

Settings read_parameters()
    Settings settings = Settings()
    for string line = io.read_lines("input/params.txt")[]
        if line == "" or line.starts_with("#")
            continue
        string[] words = line.split(" ")
        string name = words[0]
        if name == "query"
            int[] args = []
            for 2 <= int index < int(len(words))
                args = args.append(io.decimal(words[index]))
            settings.queries = settings.queries.append(Query(words[1], args))
        elif name == "sections"
            settings.sections = words[1:<int(len(words))]
        elif name == "snap"
            settings.spacing = io.decimal(words[1])
        elif name == "fill_holes"
            settings.fill_holes = io.decimal(words[1])
        else
            bool enabled = words[1] == "on"
            if name == "merge"
                settings.merge = enabled
            elif name == "degenerate"
                settings.degenerate = enabled
            elif name == "duplicates"
                settings.duplicates = enabled
            elif name == "orient"
                settings.orient = enabled
            elif name == "outward"
                settings.outward = enabled
            elif name == "keep_unused"
                settings.keep_unused = enabled
    return settings

bool polygon_nonplanar(int[] corners, int[][] points)
    int[] origin = points[corners[0] - 1]
    int[] total = [0, 0, 0]
    for 1 <= int index < int(len(corners)) - 1
        int[] direction = measure.cross(measure.subtract(points[corners[index] - 1], origin), measure.subtract(points[corners[index + 1] - 1], origin))
        for int axis < 3
            total[axis] += direction[axis]
    for int vertex = corners[]
        if measure.dot(measure.subtract(points[vertex - 1], origin), total) != 0
            return true
    return false

string edge_shape(int[] edge, int[] adjacent, int[][] faces, int[][] points)
    if len(adjacent) != 2
        return "-"
    int[] first = faces[adjacent[0] - 1]
    int[] second = faces[adjacent[1] - 1]
    if orientation.has_directed(first, edge[0], edge[1]) == orientation.has_directed(second, edge[0], edge[1])
        return "inconsistent"
    int third = 0
    for int vertex = second[0:<3][]
        if not has_int(edge, vertex)
            third = vertex
    int sign = measure.dot(measure.subtract(points[third - 1], points[first[0] - 1]), measure.normal(first, points))
    return if sign < 0 then "convex" elif sign > 0 then "concave" else "flat"

orientation.topology.Loop[] coherent_loops(int[][] faces, int[][] edges, int[][] edge_faces, int[][] boundary_edges)
    orientation.topology.Loop[] loops = orientation.topology.trace_loops(edges, boundary_edges)
    for int index < int(len(loops))
        orientation.topology.Loop loop = loops[index]
        if loop.kind == "closed"
            int forward = 0
            for int position < loop.length
                int first = loop.vertices[position]
                int second = loop.vertices[(position + 1) % loop.length]
                int edge = orientation.topology.edge_index(edges, first, second)
                if orientation.has_directed(faces[edge_faces[edge][0] - 1], first, second)
                    forward += 1
            loop.kind = if forward == 0 or forward == loop.length then "coherent" else "mixed"
            if forward == 0
                loop.vertices = loop.vertices[0:<1].concat(loop.vertices[1:<loop.length][::-1])
        loops[index] = loop
    return loops

class Component(int number, int[] faces, int[] vertices, int[] edges)
    int[] boundary = []
    int[] nonmanifold = []
    int[] bad_vertices = []
    bool closed = false
    bool manifold = false
    bool consistent = false
    bool solid = false
    bool orientable = false
    int loops = 0
    int euler = 0
    int genus = 0
    int crosscaps = 0
    int[] inside = []
    int volume6 = 0
    real64 surface_area = 0.0
    int[] normal_sum = [0, 0, 0]
    int[] bounds = []
    string[] center = []
    int[] shapes = [0, 0, 0, 0]
    int[] angles = [0, 0, 0]
    int edge_min = 0
    int edge_max = 0
    int valence_min = 0
    int valence_max = 0

class Data(io.Source[] sources, Settings[] parameters)
    int[][] snapped = []
    int[] snap_records = []
    int[] representative = []
    int[][] triangles = []
    int[][] removed = []
    string[] reasons = []
    int[][] points = []
    int[] renumber = []
    int[][] faces = []
    string[] face_groups = []
    int initial_faces = 0
    orientation.topology.Mesh[] meshes = []
    int inconsistent_before = 0
    int[] inconsistent_after = []
    orientation.topology.Loop[] loops_before = []
    int added = 0
    int outward_components = 0
    int flipped_faces = 0
    bool[] nonplanar = []
    string[] groups = []
    Component[] components = []

Data analyze(io.Source source, Settings settings)
    Data data = Data([source], [settings])
    repair.Snapped snapped = repair.snap(source.vertices, settings.spacing)
    data.snapped = snapped.points
    data.snap_records = snapped.changed
    data.representative = repair.representatives(data.snapped, settings.merge)
    data.triangles = repair.split_polygons(source.polygons, source.polygon_lines)
    repair.Cleaned cleaned = repair.clean(data.triangles, data.snapped, data.representative, settings.degenerate, settings.duplicates)
    data.removed = cleaned.removed
    data.reasons = cleaned.reasons
    bool[] present = array(len(source.vertices), fill = false)
    if settings.keep_unused
        for int index < int(len(data.representative))
            present[index] = data.representative[index] == index + 1
    else
        for int[] face = cleaned.faces[]
            for int vertex = face[0:<3][]
                present[vertex - 1] = true
    data.renumber = array(len(source.vertices), fill = 0)
    for int index < int(len(present))
        if present[index]
            data.points = data.points.append(data.snapped[index])
            data.renumber[index] = int(len(data.points))
    int[][] initial = []
    for int[] original_face = cleaned.faces[]
        int[] face = original_face
        for int axis < 3
            face[axis] = data.renumber[face[axis] - 1]
        data.faces = data.faces.append(face)
        data.face_groups = data.face_groups.append(source.polygon_groups[face[4] - 1])
        initial = initial.append(face)
    data.initial_faces = int(len(data.faces))
    orientation.topology.Mesh before = orientation.topology.analyze(data.faces, int(len(data.points)))
    data.inconsistent_before = int(len(orientation.inconsistent(data.faces, before.edges, before.edge_faces)))
    int[][] current_faces = data.faces
    if settings.orient
        orientation.repair(&current_faces, before.edges, before.edge_faces)
    data.faces = current_faces
    data.inconsistent_after = orientation.inconsistent(data.faces, before.edges, before.edge_faces)
    orientation.topology.Loop[] loops = coherent_loops(data.faces, before.edges, before.edge_faces, before.component_boundary)
    bool[] permitted = array(len(before.component_faces), fill = true)
    for int number < int(len(permitted))
        if len(before.component_nonmanifold[number]) > 0
            permitted[number] = false
    for int edge = data.inconsistent_after[]
        permitted[before.face_components[before.edge_faces[edge][0] - 1] - 1] = false
    for int index < int(len(loops))
        orientation.topology.Loop loop = loops[index]
        if loop.kind == "coherent" and loop.length >= 3 and loop.length <= settings.fill_holes and int(len(unique_sorted(loop.vertices))) == loop.length and permitted[loop.component - 1]
            int[][] added_faces = repair.filling(loop.vertices)
            data.faces = data.faces.concat(added_faces)
            for _ < int(len(added_faces))
                data.face_groups = data.face_groups.append("fill")
            data.added += int(len(added_faces))
            loop.filled = true
            loops[index] = loop
    data.loops_before = loops
    orientation.topology.Mesh mesh = orientation.topology.analyze(data.faces, int(len(data.points)))
    data.meshes = [before, mesh]
    int[] inconsistent = orientation.inconsistent(data.faces, mesh.edges, mesh.edge_faces)
    for int number < int(len(mesh.component_faces))
        Component component = Component(number + 1, mesh.component_faces[number], mesh.component_vertices[number], mesh.component_edges[number])
        component.boundary = mesh.component_boundary[number]
        component.nonmanifold = mesh.component_nonmanifold[number]
        component.bad_vertices = mesh.component_bad_vertices[number]
        component.closed = len(component.boundary) == 0
        component.manifold = len(component.nonmanifold) == 0 and len(component.bad_vertices) == 0
        component.consistent = true
        for int edge = component.edges[]
            if has_int(inconsistent, edge)
                component.consistent = false
        component.solid = component.closed and component.manifold and component.consistent
        data.components = data.components.append(component)
    for int number < int(len(data.components))
        Component component = data.components[number]
        if component.solid
            for Component other = data.components[]
                if not other.solid or other.number == component.number
                    continue
                int sample = -1
                for int vertex = component.vertices[]
                    if not has_int(other.vertices, vertex)
                        sample = vertex
                        break
                if sample > 0 and measure.winding(other.faces, data.faces, data.points, data.points[sample - 1]) != 0
                    component.inside = component.inside.append(other.number)
        data.components[number] = component
    current_faces = data.faces
    if settings.outward
        for Component component = data.components[]
            if component.solid
                int signed = measure.volume6(component.faces, current_faces, data.points)
                bool even = len(component.inside) % 2 == 0
                if signed != 0 and ((even and signed < 0) or (not even and signed > 0))
                    for int id = component.faces[]
                        int[] face = current_faces[id - 1]
                        orientation.flip(&face)
                        current_faces[id - 1] = face
                    data.outward_components += 1
    data.faces = current_faces
    for int id < data.initial_faces
        if data.faces[id] != initial[id]
            data.flipped_faces += 1
    int[][] copied = data.faces
    orientation.repair(&copied, mesh.edges, mesh.edge_faces)
    int[] not_orientable = orientation.inconsistent(copied, mesh.edges, mesh.edge_faces)
    int[] loop_counts = array(len(data.components), fill = 0)
    for orientation.topology.Loop loop = coherent_loops(data.faces, mesh.edges, mesh.edge_faces, mesh.component_boundary)[]
        loop_counts[loop.component - 1] += 1
    data.nonplanar = array(len(source.polygons), fill = false)
    for int index < int(len(source.polygons))
        data.nonplanar[index] = polygon_nonplanar(source.polygons[index], data.snapped)
        if not has_string(data.groups, source.polygon_groups[index])
            data.groups = data.groups.append(source.polygon_groups[index])
    if data.added > 0
        data.groups = data.groups.append("fill")
    string[] shape_names = ["convex", "concave", "flat", "inconsistent"]
    string[] angle_names = ["acute", "right", "obtuse"]
    for int number < int(len(data.components))
        Component component = data.components[number]
        component.orientable = true
        for int edge = component.edges[]
            if has_int(not_orientable, edge)
                component.orientable = false
        component.loops = loop_counts[number]
        component.euler = int(len(component.vertices)) - int(len(component.edges)) + int(len(component.faces))
        component.genus = repair.floor_div(2 - component.euler - component.loops, 2)
        component.crosscaps = 2 - component.euler - component.loops
        component.volume6 = measure.volume6(component.faces, data.faces, data.points)
        component.surface_area = measure.area(component.faces, data.faces, data.points)
        component.bounds = measure.bbox(component.vertices, data.points)
        if component.solid and component.volume6 != 0
            component.center = measure.centroid(component.faces, data.faces, data.points, component.volume6)
        for int id = component.faces[]
            int[] direction = measure.normal(data.faces[id - 1], data.points)
            for int axis < 3
                component.normal_sum[axis] += direction[axis]
            string kind = measure.angle(data.faces[id - 1], data.points)
            for int index < 3
                if angle_names[index] == kind
                    component.angles[index] += 1
        int[] degree = array(len(data.points), fill = 0)
        bool first_edge = true
        for int edge = component.edges[]
            string shape = edge_shape(mesh.edges[edge], mesh.edge_faces[edge], data.faces, data.points)
            for int index < 4
                if shape_names[index] == shape
                    component.shapes[index] += 1
            degree[mesh.edges[edge][0] - 1] += 1
            degree[mesh.edges[edge][1] - 1] += 1
            int length = measure.length2(mesh.edges[edge], data.points)
            if first_edge or length < component.edge_min
                component.edge_min = length
            if first_edge or length > component.edge_max
                component.edge_max = length
            first_edge = false
        bool first_vertex = true
        for int vertex = component.vertices[]
            int value = degree[vertex - 1]
            if first_vertex or value < component.valence_min
                component.valence_min = value
            if first_vertex or value > component.valence_max
                component.valence_max = value
            first_vertex = false
        data.components[number] = component
    return data

string[] boundaries(Data data)
    orientation.topology.Mesh mesh = data.meshes[0]
    string[] result = ["loops {len(data.loops_before)}"]
    for orientation.topology.Loop loop = data.loops_before[]
        string state = if loop.filled then "filled" else "kept"
        result = result.append("loop {loop.number} component {loop.component} length {loop.length} {loop.kind} {state} vertices " + io.listing(loop.vertices))
    int[] bad_edges = []
    for int edge < int(len(mesh.edges))
        if len(mesh.edge_faces[edge]) >= 3
            bad_edges = bad_edges.append(edge)
    result = result.append("nonmanifold_edges {len(bad_edges)}")
    for int edge = bad_edges[]
        result = result.append("edge " + io.listing(mesh.edges[edge]) + " faces " + io.listing(mesh.edge_faces[edge]))
    result = result.append("nonmanifold_vertices {len(mesh.nonmanifold_vertices)}")
    for int vertex = mesh.nonmanifold_vertices[]
        int[] component_numbers = []
        for int[] fan = mesh.fans[vertex - 1][]
            component_numbers = component_numbers.append(mesh.face_components[fan[0] - 1])
        result = result.append("vertex {vertex} fans {len(mesh.fans[vertex - 1])} components " + io.listing(unique_sorted(component_numbers)))
    result = result.append("inconsistent_edges {len(data.inconsistent_after)}")
    for int edge = data.inconsistent_after[]
        result = result.append("edge " + io.listing(mesh.edges[edge]) + " faces " + io.listing(mesh.edge_faces[edge]))
    return result

string[] summary(Data data)
    io.Source source = data.sources[0]
    int[] sizes = []
    for int[] polygon = source.polygons[]
        sizes = sizes.append(int(len(polygon)))
    int nonplanar_count = 0
    for bool warped = data.nonplanar[]
        if warped
            nonplanar_count += 1
    int merged = 0
    for int index < int(len(data.representative))
        if data.representative[index] != index + 1
            merged += 1
    int[] removals = [0, 0, 0]
    string[] removal_names = ["repeated", "zero_area", "duplicate"]
    for string reason = data.reasons[]
        for int index < 3
            if removal_names[index] == reason
                removals[index] += 1
    int solids = 0
    int volume = 0
    for Component component = data.components[]
        if component.solid
            solids += 1
            volume += component.volume6
    int filled = 0
    for orientation.topology.Loop loop = data.loops_before[]
        if loop.filled
            filled += 1
    string[] result = [
        "[summary]",
        "lines {source.lines}",
        "vertices {len(source.vertices)}",
        "polygons {len(source.polygons)}",
        "errors {len(source.errors)}",
        "ignored {source.ignored}",
        "nonplanar_polygons {nonplanar_count}",
    ]
    for int size = unique_sorted(sizes)[]
        int count = 0
        for int value = sizes[]
            if value == size
                count += 1
        result = result.append("polygon_size {size} {count}")
    result = result.concat([
        "triangles {len(data.triangles)}",
        "snapped {len(data.snap_records)}",
        "merged {merged}",
        "removed_repeated {removals[0]}",
        "removed_zero_area {removals[1]}",
        "removed_duplicate {removals[2]}",
        "faces {data.initial_faces}",
        "inconsistent_before {data.inconsistent_before}",
        "flipped_faces {data.flipped_faces}",
        "outward_components {data.outward_components}",
        "boundary_loops {len(data.loops_before)}",
        "holes_filled {filled}",
        "fill_faces {data.added}",
        "final_vertices {len(data.points)}",
        "final_faces {len(data.faces)}",
        "components {len(data.components)}",
        "solids {solids}",
        "total_area " + measure.real_text(measure.area(numbers(int(len(data.faces))), data.faces, data.points)),
        "total_volume " + measure.fraction(volume, 6),
    ])
    return result

string[] cleanup(Data data)
    io.Source source = data.sources[0]
    string[] result = ["[cleanup]", "snapped {len(data.snap_records)}"]
    for int number = data.snap_records[]
        result = result.append("snap {number} " + io.listing(source.vertices[number - 1]) + " to " + io.listing(data.snapped[number - 1]))
    int merged = 0
    for int index < int(len(data.representative))
        if data.representative[index] != index + 1
            merged += 1
    result = result.append("merged {merged}")
    for int original < int(len(data.representative))
        if data.representative[original] != original + 1
            continue
        int[] members = []
        for int index < int(len(data.representative))
            if data.representative[index] == original + 1
                members = members.append(index + 1)
        if len(members) > 1
            string number = if data.renumber[original] == 0 then "-" else "{data.renumber[original]}"
            result = result.append("merge {number} " + io.listing(members))
    result = result.append("removed {len(data.removed)}")
    for int index < int(len(data.removed))
        int[] face = data.removed[index]
        result = result.append("remove {face[3]} polygon {face[4]} line {face[5]} " + data.reasons[index])
    return result

string[] components_report(Data data)
    string[] result = []
    for Component component = data.components[]
        string[] groups = []
        for string group = data.groups[]
            bool present = false
            for int id = component.faces[]
                if data.face_groups[id - 1] == group
                    present = true
            if present
                groups = groups.append(group)
        result = result.concat([
            "[component {component.number}]",
            "groups " + groups.join(" "),
            "faces {len(component.faces)}",
            "vertices {len(component.vertices)}",
            "edges {len(component.edges)}",
            "boundary_edges {len(component.boundary)}",
            "nonmanifold_edges {len(component.nonmanifold)}",
            "nonmanifold_vertices {len(component.bad_vertices)}",
            "boundary_loops {component.loops}",
            "closed " + yes(component.closed),
            "manifold " + yes(component.manifold),
            "orientable " + yes(component.orientable),
            "consistent " + yes(component.consistent),
            "solid " + yes(component.solid),
            "euler {component.euler}",
        ])
        result = result.append(if not component.manifold then "genus -" elif component.orientable then "genus {component.genus}" else "crosscaps {component.crosscaps}")
        result = result.concat([
            "volume " + (if component.solid then measure.fraction(component.volume6, 6) else "-"),
            "area " + measure.real_text(component.surface_area),
            "normal_sum " + io.listing(component.normal_sum),
            "bbox " + io.listing(component.bounds),
            "inside " + io.listing(component.inside),
            "centroid " + (if len(component.center) == 0 then "-" else component.center.join(" ")),
            "convex {component.shapes[0]}",
            "concave {component.shapes[1]}",
            "flat {component.shapes[2]}",
            "acute {component.angles[0]}",
            "right {component.angles[1]}",
            "obtuse {component.angles[2]}",
            "edge_len2 {component.edge_min} {component.edge_max}",
            "valence {component.valence_min} {component.valence_max}",
        ])
    return result

string[] groups_report(Data data)
    io.Source source = data.sources[0]
    orientation.topology.Mesh mesh = data.meshes[1]
    string[] result = []
    for string group = data.groups[]
        int polygons = 0
        int triangles = 0
        int warped = 0
        int[] ids = []
        int[] parts = []
        for int index < int(len(source.polygons))
            if source.polygon_groups[index] == group
                polygons += 1
                if data.nonplanar[index]
                    warped += 1
        for int[] triangle = data.triangles[]
            if source.polygon_groups[triangle[4] - 1] == group
                triangles += 1
        for int index < int(len(data.faces))
            if data.face_groups[index] == group
                ids = ids.append(index + 1)
                parts = parts.append(mesh.face_components[index])
        result = result.concat([
            "[group {group}]",
            "polygons {polygons}",
            "triangles {triangles}",
            "nonplanar {warped}",
            "faces {len(ids)}",
            "area " + measure.real_text(measure.area(ids, data.faces, data.points)),
            "components " + io.listing(unique_sorted(parts)),
        ])
    return result

string[] contacts(Data data)
    string[] result = ["[contacts]"]
    for int first_index < int(len(data.components))
        Component first = data.components[first_index]
        for first_index + 1 <= int second_index < int(len(data.components))
            Component second = data.components[second_index]
            bool intersects = true
            for int axis < 3
                if first.bounds[axis] > second.bounds[axis + 3] or second.bounds[axis] > first.bounds[axis + 3]
                    intersects = false
            if not intersects
                continue
            int shared = 0
            int gap = -1
            for int vertex = first.vertices[]
                if has_int(second.vertices, vertex)
                    shared += 1
                for int other = second.vertices[]
                    if vertex != other
                        int[] delta = measure.subtract(data.points[vertex - 1], data.points[other - 1])
                        int distance = measure.dot(delta, delta)
                        if gap < 0 or distance < gap
                            gap = distance
            result = result.append("contact {first.number} {second.number} shared {shared} gap2 {gap}")
    return result

string[] edges_report(Data data)
    orientation.topology.Mesh mesh = data.meshes[1]
    int[] counts = [0, 0, 0]
    int[] shapes = [0, 0, 0, 0]
    string[] shape_names = ["convex", "concave", "flat", "inconsistent"]
    int maximum = 0
    int shortest = 0
    int longest = 0
    int low = 0
    int high = 0
    for int edge < int(len(mesh.edges))
        int count = int(len(mesh.edge_faces[edge]))
        counts[if count < 3 then count - 1 else 2] += 1
        if count > maximum
            maximum = count
        string shape = edge_shape(mesh.edges[edge], mesh.edge_faces[edge], data.faces, data.points)
        for int index < 4
            if shape_names[index] == shape
                shapes[index] += 1
        int length = measure.length2(mesh.edges[edge], data.points)
        if edge == 0 or length < low
            shortest = edge
            low = length
        if edge == 0 or length > high
            longest = edge
            high = length
    return [
        "[edges]",
        "edges {len(mesh.edges)}",
        "boundary {counts[0]}",
        "manifold {counts[1]}",
        "nonmanifold {counts[2]}",
        "max_faces {maximum}",
        "convex {shapes[0]}",
        "concave {shapes[1]}",
        "flat {shapes[2]}",
        "inconsistent {shapes[3]}",
        "shortest " + io.listing(mesh.edges[shortest]) + " len2 {low}",
        "longest " + io.listing(mesh.edges[longest]) + " len2 {high}",
    ]

string[] valence(Data data)
    orientation.topology.Mesh mesh = data.meshes[1]
    int[] degree = array(len(data.points), fill = 0)
    for int[] edge = mesh.edges[]
        degree[edge[0] - 1] += 1
        degree[edge[1] - 1] += 1
    int[] used = [for int value = degree[] if value > 0 then value]
    int[] ordered = used.sorted()
    int total = 0
    for int value = used[]
        total += value
    string[] result = ["[valence]", "used {len(used)}", "isolated {len(data.points) - len(used)}", "min {ordered[0]}", "max {ordered[len(ordered) - 1]}", "mean " + measure.fraction(total, int(len(used)))]
    for int value = unique_sorted(used)[]
        int count = 0
        for int other = used[]
            if value == other
                count += 1
        result = result.append("degree {value} {count}")
    return result

string query_vertex(int number, Data data)
    if number < 1 or number > int(len(data.points))
        return "vertex {number} invalid"
    orientation.topology.Mesh mesh = data.meshes[1]
    int count = 0
    int degree = 0
    bool boundary = false
    int[] parts = []
    for int index < int(len(data.faces))
        if has_int(data.faces[index][0:<3], number)
            count += 1
            parts = parts.append(mesh.face_components[index])
    for int index < int(len(mesh.edges))
        if has_int(mesh.edges[index], number)
            degree += 1
            boundary = boundary or len(mesh.edge_faces[index]) == 1
    return "vertex {number} at " + io.listing(data.points[number - 1]) + " faces {count} valence {degree} fans {len(mesh.fans[number - 1])} boundary " + yes(boundary) + " components " + io.listing(unique_sorted(parts))

string query_face(int number, Data data)
    if number < 1 or number > int(len(data.faces))
        return "face {number} invalid"
    orientation.topology.Mesh mesh = data.meshes[1]
    int[] face = data.faces[number - 1]
    string[] neighbors = []
    for int[] pair = orientation.topology.directed(face)[]
        int edge = orientation.topology.edge_index(mesh.edges, pair[0], pair[1])
        int[] adjacent = mesh.edge_faces[edge]
        neighbors = neighbors.append(if len(adjacent) == 1 then "-" elif len(adjacent) >= 3 then "*" elif adjacent[0] == number then "{adjacent[1]}" else "{adjacent[0]}")
    string polygon = if face[4] == 0 then "-" else "{face[4]}"
    string line = if face[5] == 0 then "-" else "{face[5]}"
    return "face {number} vertices " + io.listing(face[0:<3]) + " group " + data.face_groups[number - 1] + " polygon {polygon} line {line} component {mesh.face_components[number - 1]} normal " + io.listing(measure.normal(face, data.points)) + " area " + measure.real_text(measure.area([number], data.faces, data.points)) + " neighbors " + neighbors.join(" ")

string query_edge(int first, int second, Data data)
    int[] pair = [first, second]
    pair = pair.sorted()
    orientation.topology.Mesh mesh = data.meshes[1]
    int edge = orientation.topology.edge_index(mesh.edges, first, second)
    string prefix = "edge " + io.listing(pair)
    if edge < 0
        return prefix + " none"
    int count = int(len(mesh.edge_faces[edge]))
    string kind = if count == 1 then "boundary" elif count == 2 then "manifold" else "nonmanifold"
    return prefix + " faces " + io.listing(mesh.edge_faces[edge]) + " kind {kind} shape " + edge_shape(pair, mesh.edge_faces[edge], data.faces, data.points) + " len2 " + "{measure.length2(pair, data.points)}"

string query_point(int[] point, Data data)
    int[] inside = []
    int total = 0
    for Component component = data.components[]
        if component.solid
            int winding = measure.winding(component.faces, data.faces, data.points, point)
            if winding != 0
                inside = inside.append(component.number)
                total += winding
    return "point " + io.listing(point) + " inside " + io.listing(inside) + " winding {total}"

string query_path(int start, int target, Data data)
    string prefix = "path {start} {target}"
    int count = int(len(data.points))
    if start < 1 or start > count or target < 1 or target > count
        return prefix + " invalid"
    orientation.topology.Mesh mesh = data.meshes[1]
    int[][] neighbors = array(nat(count), fill = [])
    for int[] edge = mesh.edges[]
        neighbors[edge[0] - 1] = neighbors[edge[0] - 1].append(edge[1])
        neighbors[edge[1] - 1] = neighbors[edge[1] - 1].append(edge[0])
    int[] parent = array(nat(count), fill = -1)
    parent[start - 1] = 0
    int[] queue = [start]
    int head = 0
    while head < int(len(queue))
        int current = queue[head]
        head += 1
        for int other = neighbors[current - 1].sorted()[]
            if parent[other - 1] < 0
                parent[other - 1] = current
                queue = queue.append(other)
    if parent[target - 1] < 0
        return prefix + " none"
    int[] path = []
    int current = target
    while current != 0
        path = path.append(current)
        current = parent[current - 1]
    return prefix + " hops {len(path) - 1} vertices " + io.listing(path[::-1])

string query_view(int[] direction, Data data)
    orientation.topology.Mesh mesh = data.meshes[1]
    int[] scores = []
    int front = 0
    int back = 0
    int side = 0
    int silhouette = 0
    for int[] face = data.faces[]
        int score = measure.dot(measure.normal(face, data.points), direction)
        scores = scores.append(score)
        if score > 0
            front += 1
        elif score < 0
            back += 1
        else
            side += 1
    for int[] adjacent = mesh.edge_faces[]
        if len(adjacent) == 2 and ((scores[adjacent[0] - 1] > 0 and scores[adjacent[1] - 1] < 0) or (scores[adjacent[0] - 1] < 0 and scores[adjacent[1] - 1] > 0))
            silhouette += 1
    return "view " + io.listing(direction) + " front {front} back {back} side {side} silhouette {silhouette}"

string[] queries(Data data)
    Settings settings = data.parameters[0]
    string[] result = ["[queries]"]
    for Query query = settings.queries[]
        int[] args = query.args
        string answer = if query.kind == "vertex" then query_vertex(args[0], data) elif query.kind == "face" then query_face(args[0], data) elif query.kind == "edge" then query_edge(args[0], args[1], data) elif query.kind == "point" then query_point(args, data) elif query.kind == "path" then query_path(args[0], args[1], data) else query_view(args, data)
        result = result.append(answer)
    return result

string[] components_csv(Data data)
    string[] result = ["component,faces,vertices,closed,euler,genus,volume6,area"]
    for Component component = data.components[]
        string[] fields = [
            "{component.number}",
            "{len(component.faces)}",
            "{len(component.vertices)}",
            yes(component.closed),
            "{component.euler}",
            if component.manifold and component.orientable then "{component.genus}" else "-",
            if component.solid then "{component.volume6}" else "-",
            measure.real_text(component.surface_area),
        ]
        result = result.append(fields.join(","))
    return result

void save(string name, string[] lines)
    string content = if len(lines) == 0 then "" else lines.join(NL) + NL
    file.write("output/" + name, content)

io.Source source = io.read_obj()
Settings settings = read_parameters()
Data data = analyze(source, settings)
string[] lines = []
for string section = settings.sections[]
    if section == "summary"
        lines = lines.concat(summary(data))
    elif section == "warnings"
        lines = lines.append("[warnings]").concat(source.errors)
    elif section == "cleanup"
        lines = lines.concat(cleanup(data))
    elif section == "components"
        lines = lines.concat(components_report(data))
    elif section == "groups"
        lines = lines.concat(groups_report(data))
    elif section == "contacts"
        lines = lines.concat(contacts(data))
    elif section == "edges"
        lines = lines.concat(edges_report(data))
    elif section == "valence"
        lines = lines.concat(valence(data))
    else
        lines = lines.concat(queries(data))
bool output_exists = file.is_directory("output")
if not output_exists
    file.mkdir("output")
save("report.txt", lines)
save("components.csv", components_csv(data))
save("boundaries.txt", boundaries(data))
save("repaired.obj", io.repaired(data.points, data.faces, data.face_groups))
