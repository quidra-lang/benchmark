int floor_div(int numerator, int denominator)
    return if numerator >= 0 then numerator / denominator else -((-numerator + denominator - 1) / denominator)

int absolute(int value)
    return if value < 0 then -value else value

int maximum(int[] values)
    int best = values[0]
    for int value = values[]
        if value > best
            best = value
    return best

int total(int[] values)
    int result = 0
    for int value = values[]
        result += value
    return result

string[] read_lines(string path)
    string content = file.read(path)
    string[] lines = content.split(NL)
    return lines[0:<int(len(lines)) - 1]

class World(int rows, int cols, string kinds, int[] wind, int[] rewards)
    int[] states = []
    int[] terminals = []
    int[] state_index = array(len(kinds), fill = -1)
    int[] terminal_index = array(len(kinds), fill = -1)
    int start = -1
    for int cell < int(len(kinds))
        local string kind = kinds[cell]
        if kind == "G" or kind == "P"
            terminal_index[cell] = int(len(terminals))
            terminals = terminals.append(cell)
        elif kind != "#"
            state_index[cell] = int(len(states))
            states = states.append(cell)
            if kind == "S"
                start = cell
    int start_state = state_index[start]

    bool terminal(int cell)
        return terminal_index[cell] >= 0

    string ending(int cell)
        return if kinds[cell] == "G" then "goal" else "pit"

    int move(int cell, int direction)
        int[] offsets = [-cols, 1, cols, -1]
        int target = cell + offsets[direction]
        if kinds[target] == "#"
            target = cell
        if terminal(target)
            return target
        for _ < wind[cell % cols]
            int above = target - cols
            if kinds[above] == "#"
                break
            target = above
            if terminal(target)
                break
        return target

World read_world(string path)
    string[] lines = read_lines(path)
    int rows = int.parse(lines[0].split(" ")[1])
    int cols = int.parse(lines[1].split(" ")[1])
    string kinds = lines[2:<2 + rows].join("")
    string digits = lines[2 + rows].split(" ")[1]
    int[] wind = []
    for int index < int(len(digits))
        wind = wind.append(int.parse(digits[index]))
    int[] rewards = [for string value = lines[3 + rows].split(" ")[1:][] then int.parse(value)]
    return World(rows, cols, kinds, wind, rewards)

class Generator(int value)
    int .draw()
        value = 48271 * value % 2147483647
        return value

class Transition(int cell, int numerator)
class Step(int cell, int reward)

class Environment(World world, int step_reward, int slip_total, int floor_slip, int ice_slip)
    int[][] moves = []
    Transition[][][] transitions = []
    for int state < int(len(world.states))
        local int[] row = []
        for int direction < 4
            row = row.append(world.move(world.states[state], direction))
        moves = moves.append(row)
        local Transition[][] actions = []
        local int p = if world.kinds[world.states[state]] == "~" then ice_slip else floor_slip
        for int action < 4
            local int[] directions = [action, (action + 1) % 4, (action + 3) % 4]
            local int[] weights = [slip_total - 2 * p, p, p]
            local Transition[] outcomes = []
            for int index < 3
                if weights[index] > 0
                    outcomes = outcomes.append(Transition(row[directions[index]], weights[index]))
            actions = actions.append(outcomes)
        transitions = transitions.append(actions)

    int reward(int cell)
        int index = world.terminal_index[cell]
        return if index < 0 then step_reward else world.rewards[index]

    Step step(Generator &generator, int state, int action)
        int draw = .generator.draw() % slip_total
        int p = if world.kinds[world.states[state]] == "~" then ice_slip else floor_slip
        int direction = if draw < slip_total - 2 * p then action elif draw < slip_total - p then (action + 1) % 4 else (action + 3) % 4
        int cell = moves[state][direction]
        return Step(cell, reward(cell))
