import report = "./report.qui"

int floor_div(int numerator, int denominator)
    return report.mc.td.dp.env.floor_div(numerator, denominator)

int absolute(int value)
    return report.mc.td.dp.env.absolute(value)

int maximum(int[] values)
    return report.mc.td.dp.env.maximum(values)

int total(int[] values)
    return report.mc.td.dp.env.total(values)

int first_max(int[] values)
    return report.mc.td.dp.first_max(values)

int[] zeros(int count)
    return array(nat(count), fill = 0)

int[][] matrix(int count)
    return array(nat(count), fill = array(4, fill = 0))

int agreements(int[] first, int[] second)
    int count = 0
    for int index < int(len(first))
        if first[index] == second[index]
            count += 1
    return count

class Pair(int first, int second)

Pair[] pairs_of(int[] numbers)
    Pair[] pairs = []
    for int index < int(len(numbers)) step 2
        pairs = pairs.append(Pair(numbers[index], numbers[index + 1]))
    return pairs

class Settings(local int[][] rows)
    int gamma = rows[0][0]
    int step_reward = rows[1][0]
    int slip_total = rows[2][0]
    int floor_slip = rows[2][1]
    int ice_slip = rows[2][2]
    int theta = rows[3][0]
    int[] gamma_sweep = rows[4]
    Pair[] slip_sweep = pairs_of(rows[5])
    int episodes = rows[6][0]
    int step_limit = rows[7][0]
    int block_size = rows[8][0]
    Pair[] alpha = pairs_of(rows[9])
    Pair[] epsilon = pairs_of(rows[10])
    int planning_steps = rows[11][0]
    int seed = rows[12][0]
    int rollouts = rows[13][0]
    int rollout_seed = rows[14][0]

Settings read_settings()
    int[][] rows = []
    for string line = report.mc.td.dp.env.read_lines("input/params.txt")[]
        rows = rows.append([for string value = line.split(" ")[1:][] then int.parse(value)])
    return Settings(rows)

int schedule_value(Pair[] schedule, int episode)
    int value = schedule[0].second
    for Pair entry = schedule[]
        if entry.first <= episode
            value = entry.second
    return value

class Counts(int goal = 0, int pit = 0, int timeout = 0)
    void .add(string ending)
        if ending == "goal"
            goal += 1
        elif ending == "pit"
            pit += 1
        else
            timeout += 1

class Episode(int start)
    int sum = 0
    int steps = 0
    string ending = "timeout"
    int[] cells = [start]

class Block(int agree, int mean_error, int coverage, int sum, int steps, Counts counts)

class Learner(string method, int states)
    int[][] q = matrix(states)
    int[][] visits = matrix(states)
    report.mc.td.Model dyna = report.mc.td.Model(states)
    report.mc.Averages averages = report.mc.Averages(states)
    Episode[] episodes = []
    Block[] blocks = []
    int[] policy = []
    int[] state_visits = []
    int[] block_totals = []

    void .learn(report.mc.td.dp.env.Environment world_model, Settings settings, int[] optimal_values, int[] optimal_policy)
        report.mc.td.dp.env.Generator generator = report.mc.td.dp.env.Generator(settings.seed)
        for 1 <= int number <= settings.episodes
            int alpha = schedule_value(settings.alpha, number)
            int epsilon = schedule_value(settings.epsilon, number)
            Episode episode = Episode(world_model.world.start)
            int state = world_model.world.start_state
            report.mc.Visit[] history = []
            int action = if method == "sarsa" then report.mc.td.choose(&generator, q[state], epsilon) else 0
            while episode.steps < settings.step_limit
                if method != "sarsa"
                    action = report.mc.td.choose(&generator, q[state], epsilon)
                report.mc.td.dp.env.Step outcome = world_model.step(&generator, state, action)
                int next_state = world_model.world.state_index[outcome.cell]
                visits[state][action] += 1
                episode.sum += outcome.reward
                episode.steps += 1
                episode.cells = episode.cells.append(outcome.cell)
                if method == "mc"
                    history = history.append(report.mc.Visit(state, action, outcome.reward))
                else
                    int value = 0
                    int next_action = action
                    if next_state >= 0
                        if method == "sarsa"
                            next_action = report.mc.td.choose(&generator, q[next_state], epsilon)
                            value = q[next_state][next_action]
                        elif method == "expected_sarsa"
                            value = report.mc.td.expected(q[next_state], epsilon)
                        else
                            value = maximum(q[next_state])
                    int backup = report.mc.td.target(outcome.reward, next_state < 0, value, settings.gamma)
                    report.mc.td.update(&q, state, action, backup, alpha)
                    if method == "sarsa"
                        action = next_action
                    if method == "dyna_q"
                        .dyna.record(state, action, outcome.reward, next_state)
                        dyna.plan(&generator, &q, settings.gamma, alpha, settings.planning_steps)
                if next_state < 0
                    episode.ending = world_model.world.ending(outcome.cell)
                    break
                state = next_state
            if method == "mc"
                .averages.update(&q, history, settings.gamma)
            episodes = episodes.append(episode)
            if number % settings.block_size == 0
                int agree = 0
                int mean_error = 0
                int coverage = 0
                for int index < states
                    if first_max(q[index]) == optimal_policy[index]
                        agree += 1
                    mean_error += absolute(maximum(q[index]) - optimal_values[index])
                    if total(visits[index]) > 0
                        coverage += 1
                int sum = 0
                int steps = 0
                Counts counts = Counts()
                for number - settings.block_size <= int index < number
                    sum += episodes[index].sum
                    steps += episodes[index].steps
                    .counts.add(episodes[index].ending)
                blocks = blocks.append(Block(agree, floor_div(mean_error, states), coverage, sum, steps, counts))
                block_totals = block_totals.append(sum)
        policy = [for int[] row = q[] then first_max(row)]
        state_visits = [for int[] row = visits[] then total(row)]

class Path(string ending, int[] cells)

Path nominal_path(report.mc.td.dp.env.Environment world_model, int[] policy, int origin, int limit)
    int[] cells = [origin]
    bool[] seen = array(len(world_model.world.kinds), fill = false)
    seen[origin] = true
    while int(len(cells)) - 1 < limit
        int state = world_model.world.state_index[cells[len(cells) - 1]]
        int target = world_model.moves[state][policy[state]]
        bool repeated = seen[target]
        cells = cells.append(target)
        seen[target] = true
        if world_model.world.terminal(target)
            return Path(world_model.world.ending(target), cells)
        if repeated
            return Path("loop", cells)
    return Path("limit", cells)

int[] distances(report.mc.td.dp.env.Environment world_model)
    int[] result = array(len(world_model.world.kinds), fill = -1)
    int[] frontier = [world_model.world.start]
    result[world_model.world.start] = 0
    int level = 0
    while len(frontier) > 0
        level += 1
        int[] following = []
        for int cell = frontier[]
            int state = world_model.world.state_index[cell]
            for report.mc.td.dp.env.Transition[] transitions = world_model.transitions[state][]
                for report.mc.td.dp.env.Transition entry = transitions[]
                    if result[entry.cell] < 0
                        result[entry.cell] = level
                        if not world_model.world.terminal(entry.cell)
                            following = following.append(entry.cell)
        frontier = following
    return result

int[] absorption(report.mc.td.dp.env.Environment world_model, int[] policy, int limit)
    int count = int(len(policy))
    int[] goal = zeros(count)
    int[] pit = zeros(count)
    int[] expected = zeros(count)
    for _ < limit
        int[] next_goal = []
        int[] next_pit = []
        int[] next_expected = []
        for int state < count
            int g = 0
            int p = 0
            int e = 0
            for report.mc.td.dp.env.Transition entry = world_model.transitions[state][policy[state]][]
                int target = world_model.world.state_index[entry.cell]
                if target >= 0
                    g += entry.numerator * goal[target]
                    p += entry.numerator * pit[target]
                    e += entry.numerator * expected[target]
                elif world_model.world.kinds[entry.cell] == "G"
                    g += entry.numerator * 100000000
                else
                    p += entry.numerator * 100000000
            next_goal = next_goal.append(floor_div(g, world_model.slip_total))
            next_pit = next_pit.append(floor_div(p, world_model.slip_total))
            next_expected = next_expected.append(100000000 + floor_div(e, world_model.slip_total))
        goal = next_goal
        pit = next_pit
        expected = next_expected
    int start = world_model.world.start_state
    return [goal[start], pit[start], 100000000 - goal[start] - pit[start], expected[start]]

class Behaviour(int value, int sweeps)

Behaviour behaviour(report.mc.td.dp.env.Environment world_model, int[] policy, int epsilon, int gamma, int theta)
    int[] values = zeros(int(len(policy)))
    int sweeps = 0
    int delta = theta + 1
    while delta > theta
        sweeps += 1
        delta = 0
        for int state < int(len(policy))
            int[] backups = report.mc.td.dp.actions(world_model, values, gamma, state)
            int sum = 0
            for int action < 4
                int weight = epsilon + (if action == policy[state] then 4 * (1000 - epsilon) else 0)
                sum += weight * backups[action]
            int value = floor_div(sum, 4000)
            int difference = absolute(value - values[state])
            if difference > delta
                delta = difference
            values[state] = value
    return Behaviour(values[world_model.world.start_state], sweeps)

class Rollouts(int terminals)
    int[] returns = []
    int[] discounted = []
    int[] steps = []
    string[] endings = []
    int[] terminal_counts = zeros(terminals)

Rollouts perform_rollouts(report.mc.td.dp.env.Environment world_model, int[] policy, Settings settings)
    report.mc.td.dp.env.Generator generator = report.mc.td.dp.env.Generator(settings.rollout_seed)
    Rollouts result = Rollouts(int(len(world_model.world.terminals)))
    for _ < settings.rollouts
        int state = world_model.world.start_state
        int[] rewards = []
        string ending = "timeout"
        while int(len(rewards)) < settings.step_limit
            report.mc.td.dp.env.Step outcome = world_model.step(&generator, state, policy[state])
            rewards = rewards.append(outcome.reward)
            state = world_model.world.state_index[outcome.cell]
            if state < 0
                ending = world_model.world.ending(outcome.cell)
                result.terminal_counts[world_model.world.terminal_index[outcome.cell]] += 1
                break
        result.returns = result.returns.append(total(rewards))
        result.discounted = result.discounted.append(report.mc.discounted(rewards, settings.gamma))
        result.steps = result.steps.append(int(len(rewards)))
        result.endings = result.endings.append(ending)
    return result

class PolicyEvaluation(int[] values, int sweeps, int agree, int optimal, int gap, int gap_state, int changed, int improved_start, int improved_agree, int[] absorption_values, Rollouts rollouts)

PolicyEvaluation evaluate_policy(report.mc.td.dp.env.Environment world_model, Settings settings, int[] policy, int[] optimal_values, int[] optimal_policy, int[][] optimal_actions)
    report.mc.td.dp.Evaluation evaluation = report.mc.td.dp.evaluate(world_model, policy, zeros(int(len(policy))), settings.gamma, settings.theta)
    int[] gaps = []
    int optimal = 0
    for int state < int(len(policy))
        gaps = gaps.append(optimal_values[state] - evaluation.values[state])
        for int action = optimal_actions[state][]
            if action == policy[state]
                optimal += 1
    int gap_state = first_max(gaps)
    int[] improved = report.mc.td.dp.greedy_policy(world_model, evaluation.values, settings.gamma)
    report.mc.td.dp.Evaluation second = report.mc.td.dp.evaluate(world_model, improved, zeros(int(len(policy))), settings.gamma, settings.theta)
    int start = world_model.world.start_state
    return PolicyEvaluation(evaluation.values, evaluation.sweeps, agreements(policy, optimal_policy), optimal, gaps[gap_state], gap_state, int(len(policy)) - agreements(improved, policy), second.values[start], agreements(improved, optimal_policy), absorption(world_model, policy, settings.step_limit), perform_rollouts(world_model, policy, settings))

string state_text(report.mc.td.dp.env.World world, int state)
    return report.cell(world, world.states[state])

string sensitivity(report.mc.td.dp.env.Environment world_model, int gamma, int theta, int limit, int[] optimal_policy)
    report.mc.td.dp.Iteration iteration = report.mc.td.dp.value_iteration(world_model, gamma, theta)
    int[] policy = report.mc.td.dp.greedy_policy(world_model, iteration.values, gamma)
    Path path = nominal_path(world_model, policy, world_model.world.start, limit)
    int differences = int(len(policy)) - agreements(policy, optimal_policy)
    return "iterations {len(iteration.changes)} value_start " + report.fixed(iteration.values[world_model.world.start_state]) + " path {path.ending} steps {int(len(path.cells)) - 1} last " + report.cell(world_model.world, path.cells[len(path.cells) - 1]) + " differences {differences}"

Counts ending_counts(string[] endings)
    Counts counts = Counts()
    for string ending = endings[]
        .counts.add(ending)
    return counts

string[] methods()
    return ["mc", "sarsa", "q_learning", "expected_sarsa", "dyna_q"]

report.mc.td.dp.env.World world = report.mc.td.dp.env.read_world("input/world.txt")
Settings settings = read_settings()
report.mc.td.dp.env.Environment world_model = report.mc.td.dp.env.Environment(world, settings.step_reward, settings.slip_total, settings.floor_slip, settings.ice_slip)
int states = int(len(world.states))
int start = world.start_state
report.mc.td.dp.Iteration iteration = report.mc.td.dp.value_iteration(world_model, settings.gamma, settings.theta)
int[] optimal_values = iteration.values
int[][] optimal_q = []
int[] optimal_policy = []
int[][] optimal_actions = []
for int state < states
    int[] row = report.mc.td.dp.actions(world_model, optimal_values, settings.gamma, state)
    optimal_q = optimal_q.append(row)
    optimal_policy = optimal_policy.append(first_max(row))
    int best = maximum(row)
    int[] actions = []
    for int action < 4
        if row[action] == best
            actions = actions.append(action)
    optimal_actions = optimal_actions.append(actions)
report.mc.td.dp.Evaluation in_place = report.mc.td.dp.in_place(world_model, settings.gamma, settings.theta)
report.mc.td.dp.PolicyIteration policy_iteration = report.mc.td.dp.policy_iteration(world_model, settings.gamma, settings.theta)
Learner[] learners = []
int[][] policies = [optimal_policy, policy_iteration.policy]
string[] policy_names = ["value_iteration", "policy_iteration"].concat(methods())
for string method = methods()[]
    Learner learner = Learner(method, states)
    .learner.learn(world_model, settings, optimal_values, optimal_policy)
    learners = learners.append(learner)
    policies = policies.append(learner.policy)
PolicyEvaluation[] evaluations = [for int[] policy = policies[] then evaluate_policy(world_model, settings, policy, optimal_values, optimal_policy, optimal_actions)]
int[] distance = distances(world_model)
int reachable = int(len([for int cell = world.states[] if distance[cell] >= 0 then cell]))
int walls = 0
int floors = 0
int ice = 0
int goals = 0
int pits = 0
for int cell < int(len(world.kinds))
    string kind = world.kinds[cell]
    if kind == "#"
        walls += 1
    elif kind == "." or kind == "S"
        floors += 1
    elif kind == "~"
        ice += 1
    elif kind == "G"
        goals += 1
    else
        pits += 1
string[] world_lines = ["world rows {world.rows} cols {world.cols} states {states} walls {walls} floor {floors} ice {ice} goals {goals} pits {pits}", "start " + report.cell(world, world.start) + " reachable {reachable}"]
for int index < int(len(world.terminals))
    int cell = world.terminals[index]
    string steps = if distance[cell] < 0 then "-" else "{distance[cell]}"
    world_lines = world_lines.append("terminal " + report.cell(world, cell) + " " + world.ending(cell) + " reward {world.rewards[index]} distance {steps}")
string[] iteration_lines = ["value_iteration gamma {settings.gamma} theta " + report.fixed(settings.theta) + " iterations {len(iteration.changes)}"]
for int index < int(len(iteration.changes))
    iteration_lines = iteration_lines.append("iteration {index + 1} max_change " + report.fixed(iteration.changes[index]))
string[] tied = []
string letters = "NESW"
for int state < states
    int[] actions = optimal_actions[state]
    if len(actions) > 1
        string text = [for int action = actions[] then letters[action]].join("")
        tied = tied.append("tie " + state_text(world, state) + " " + text)
int mirror_pairs = 0
int equal_values = 0
int mirrored_actions = 0
int[] mirror = [0, 3, 2, 1]
for int state < states
    int cell = world.states[state]
    int column = cell % world.cols
    int other_column = world.cols - 1 - column
    int other = world.state_index[cell / world.cols * world.cols + other_column]
    if column < other_column and other >= 0
        mirror_pairs += 1
        if optimal_values[state] == optimal_values[other]
            equal_values += 1
        if optimal_policy[other] == mirror[optimal_policy[state]]
            mirrored_actions += 1
string[] ties_lines = ["ties {len(tied)}"].concat(tied).append("symmetry pairs {mirror_pairs} equal_values {equal_values} mirrored_actions {mirrored_actions}")
string[] round_lines = ["policy_iteration rounds {len(policy_iteration.rounds)}"]
int total_sweeps = 0
for int index < int(len(policy_iteration.rounds))
    report.mc.td.dp.Round round = policy_iteration.rounds[index]
    total_sweeps += round.sweeps
    round_lines = round_lines.append("round {index + 1} sweeps {round.sweeps} changed {round.changes} value_start " + report.fixed(round.value))
int[] differences = []
for int state < states
    differences = differences.append(absolute(policy_iteration.values[state] - optimal_values[state]))
int worst = first_max(differences)
string[] comparison_lines = ["comparison policy_differences {states - agreements(policy_iteration.policy, optimal_policy)} max_value_difference " + report.fixed(differences[worst]) + " at " + state_text(world, worst), "backups value_iteration {int(len(iteration.changes)) * states * 4} in_place_iterations {in_place.sweeps} in_place {in_place.sweeps * states * 4} policy_iteration {total_sweeps * states + int(len(policy_iteration.rounds)) * states * 4}"]
string[] gamma_lines = ["gamma_sweep"]
for int gamma = settings.gamma_sweep[]
    gamma_lines = gamma_lines.append("gamma {gamma} " + sensitivity(world_model, gamma, settings.theta, settings.step_limit, optimal_policy))
string[] slip_lines = ["slip_sweep"]
for Pair slip = settings.slip_sweep[]
    report.mc.td.dp.env.Environment varied = report.mc.td.dp.env.Environment(world, settings.step_reward, settings.slip_total, slip.first, slip.second)
    slip_lines = slip_lines.append("slip {slip.first} {slip.second} " + sensitivity(varied, settings.gamma, settings.theta, settings.step_limit, optimal_policy))
string[][] value_parts = [world_lines, iteration_lines, ["optimal_values"].concat(report.values(world, optimal_values)), ["optimal_action_counts"].concat(report.grid(world, [for int[] actions = optimal_actions[] then "{len(actions)}"], "")), ties_lines, round_lines, ["policy_iteration_values"].concat(report.values(world, policy_iteration.values)), comparison_lines, gamma_lines, slip_lines]
string[][] policy_parts = []
for int index < int(len(policies))
    int[] policy = policies[index]
    Path path = nominal_path(world_model, policy, world.start, settings.step_limit)
    string[] lines = [policy_names[index]].concat(report.policy(world, policy))
    lines = lines.append("path {path.ending} steps {int(len(path.cells)) - 1} " + report.cells(world, path.cells))
    int[] action_counts = zeros(4)
    int risk = 0
    for int state < states
        action_counts[policy[state]] += 1
        for report.mc.td.dp.env.Transition entry = world_model.transitions[state][policy[state]][]
            if world.kinds[entry.cell] == "P"
                risk += 1
                break
    lines = lines.concat(["actions N {action_counts[0]} E {action_counts[1]} S {action_counts[2]} W {action_counts[3]} risk {risk}", "basins"])
    string alphabet = "abcdefghijklmnopqrstuvwxyz"
    string[] symbols = []
    for int cell = world.states[]
        Path basin = nominal_path(world_model, policy, cell, settings.step_limit)
        string symbol = "*"
        if basin.ending == "goal" or basin.ending == "pit"
            symbol = alphabet[world.terminal_index[basin.cells[len(basin.cells) - 1]]]
        symbols = symbols.append(symbol)
    lines = lines.concat(report.grid(world, symbols, ""))
    if index >= 2
        string[] digits = [for int value = learners[index - 2].state_visits[] then if value == 0 then "0" else "{len("{value}")}"]
        lines = lines.append("visits").concat(report.grid(world, digits, ""))
    policy_parts = policy_parts.append(lines)
string[] q_output = ["method,row,col,action,value,visits"].concat(report.q_rows(world, "value_iteration", optimal_q, [], true))
string[] curve_output = ["method,block,mean_return,mean_steps,goals,pits,timeouts,agree,value_error,coverage"]
for Learner learner = learners[]
    q_output = q_output.concat(report.q_rows(world, learner.method, learner.q, learner.visits))
    for int index < int(len(learner.blocks))
        Block block = learner.blocks[index]
        string[] fields = [learner.method, "{index + 1}", report.average(block.sum, settings.block_size), report.average(block.steps, settings.block_size), "{block.counts.goal}", "{block.counts.pit}", "{block.counts.timeout}", "{block.agree}", report.fixed(block.mean_error), "{block.coverage}"]
        curve_output = curve_output.append(fields.join(","))
string[][] evaluation_parts = [["summary states {states} start " + report.cell(world, world.start) + " rollouts {settings.rollouts} step_limit {settings.step_limit}"]]
string[] policy_value_lines = ["policies", "policy agree optimal_actions value_start sweeps max_gap at"]
string[] improvement_lines = ["improvement", "policy changed value_start agree"]
string[] absorption_lines = ["absorption", "policy p_goal p_pit p_timeout expected_steps"]
string[] rollout_lines = ["rollouts", "policy mean_return mean_discounted mean_steps goals pits timeouts min median max"]
string[] terminal_lines = ["terminals", "policy " + report.cells(world, world.terminals)]
string[] agreement_lines = ["agreement", "policy " + policy_names.join(" ")]
for int index < int(len(evaluations))
    PolicyEvaluation evaluation = evaluations[index]
    string name = policy_names[index]
    policy_value_lines = policy_value_lines.append("{name} {evaluation.agree} {evaluation.optimal} " + report.fixed(evaluation.values[start]) + " {evaluation.sweeps} " + report.fixed(evaluation.gap) + " " + state_text(world, evaluation.gap_state))
    improvement_lines = improvement_lines.append("{name} {evaluation.changed} " + report.fixed(evaluation.improved_start) + " {evaluation.improved_agree}")
    string[] absorption_fields = [name].concat([for int value = evaluation.absorption_values[] then report.fixed(floor_div(value, 10000))])
    absorption_lines = absorption_lines.append(absorption_fields.join(" "))
    Rollouts draws = evaluation.rollouts
    int[] returns = draws.returns.sorted()
    Counts endings = ending_counts(draws.endings)
    rollout_lines = rollout_lines.append(name + " " + report.average(total(draws.returns), settings.rollouts) + " " + report.fixed(floor_div(total(draws.discounted), settings.rollouts)) + " " + report.average(total(draws.steps), settings.rollouts) + " {endings.goal} {endings.pit} {endings.timeout} {returns[0]} {returns[(settings.rollouts + 1) / 2 - 1]} {returns[len(returns) - 1]}")
    terminal_lines = terminal_lines.append(name + " " + [for int count = draws.terminal_counts[] then "{count}"].join(" "))
    string[] agreement_fields = [name]
    for int[] other = policies[]
        agreement_fields = agreement_fields.append("{agreements(policies[index], other)}")
    agreement_lines = agreement_lines.append(agreement_fields.join(" "))
evaluation_parts = evaluation_parts.concat([policy_value_lines, improvement_lines, absorption_lines])
string[] behaviour_lines = ["behaviour", "method epsilon value_start sweeps"]
string[] q_error_lines = ["q_errors", "method mean_abs max_abs at unvisited tied"]
string[] q_action_lines = ["q_action_errors", "method N E S W"]
int final_epsilon = schedule_value(settings.epsilon, settings.episodes)
for Learner learner = learners[]
    Behaviour evaluation = behaviour(world_model, learner.policy, final_epsilon, settings.gamma, settings.theta)
    behaviour_lines = behaviour_lines.append("{learner.method} {final_epsilon} " + report.fixed(evaluation.value) + " {evaluation.sweeps}")
    int[] errors = []
    int unvisited = 0
    int ties = 0
    for int state < states
        int best = maximum(learner.q[state])
        errors = errors.append(absolute(best - optimal_values[state]))
        if learner.state_visits[state] == 0
            unvisited += 1
        int equal = int(len([for int value = learner.q[state][] if value == best then value]))
        if equal > 1
            ties += 1
    int worst_state = first_max(errors)
    q_error_lines = q_error_lines.append(learner.method + " " + report.fixed(floor_div(total(errors), states)) + " " + report.fixed(errors[worst_state]) + " " + state_text(world, worst_state) + " {unvisited} {ties}")
    string[] fields = [learner.method]
    for int action < 4
        int sum = 0
        int count = 0
        for int state < states
            if learner.visits[state][action] > 0
                sum += absolute(learner.q[state][action] - optimal_q[state][action])
                count += 1
        fields = fields.append(if count == 0 then "-" else report.fixed(floor_div(sum, count)))
    q_action_lines = q_action_lines.append(fields.join(" "))
evaluation_parts = evaluation_parts.concat([behaviour_lines, q_error_lines, q_action_lines, rollout_lines, terminal_lines, agreement_lines])
string[] training_lines = ["training", "method steps goals pits timeouts best_block best_mean last_mean reach"]
string[] visited_lines = ["visited"]
string[] last_lines = ["last_episodes"]
string[] phase_lines = ["phases"]
int optimal_total = total(evaluations[0].rollouts.returns)
int[] phase_starts = []
for Pair[] schedule = [settings.alpha, settings.epsilon][]
    for Pair entry = schedule[]
        bool known = false
        for int value = phase_starts[]
            if entry.first == value
                known = true
        if not known
            phase_starts = phase_starts.append(entry.first)
phase_starts = phase_starts.sorted()
for Learner learner = learners[]
    int steps = total([for Episode episode = learner.episodes[] then episode.steps])
    Counts endings = ending_counts([for Episode episode = learner.episodes[] then episode.ending])
    int best = first_max(learner.block_totals)
    string reach = "-"
    for int index < int(len(learner.block_totals))
        if 10 * settings.rollouts * learner.block_totals[index] >= 9 * settings.block_size * optimal_total
            reach = "{index + 1}"
            break
    training_lines = training_lines.append("{learner.method} {steps} {endings.goal} {endings.pit} {endings.timeout} {best + 1} " + report.average(learner.block_totals[best], settings.block_size) + " " + report.average(learner.block_totals[len(learner.block_totals) - 1], settings.block_size) + " " + reach)
    int[] order = []
    for int state < states
        int position = int(len(order))
        order = order.append(state)
        while position > 0 and learner.state_visits[state] > learner.state_visits[order[position - 1]]
            order[position] = order[position - 1]
            position -= 1
        order[position] = state
    string[] most_visited = [learner.method]
    for int index < 3
        int state = order[index]
        most_visited = most_visited.append(state_text(world, state) + ":{learner.state_visits[state]}")
    visited_lines = visited_lines.append(most_visited.join(" "))
    Episode last_episode = learner.episodes[len(learner.episodes) - 1]
    last_lines = last_lines.append("{learner.method} return {last_episode.sum} steps {last_episode.steps} end {last_episode.ending} " + report.cells(world, last_episode.cells))
    for int index < int(len(phase_starts))
        int first = phase_starts[index]
        int last = if index + 1 < int(len(phase_starts)) then phase_starts[index + 1] - 1 else settings.episodes
        int sum = 0
        int phase_steps = 0
        int phase_goals = 0
        for first - 1 <= int number < last
            sum += learner.episodes[number].sum
            phase_steps += learner.episodes[number].steps
            if learner.episodes[number].ending == "goal"
                phase_goals += 1
        phase_lines = phase_lines.append("{learner.method} {first}-{last} alpha {schedule_value(settings.alpha, first)} epsilon {schedule_value(settings.epsilon, first)} mean_return " + report.average(sum, last - first + 1) + " mean_steps " + report.average(phase_steps, last - first + 1) + " goals {phase_goals}")
evaluation_parts = evaluation_parts.concat([training_lines, visited_lines, last_lines, phase_lines])
bool output_exists = file.is_directory("output")
if not output_exists
    file.mkdir("output")
report.write_lines("values.txt", report.join_parts(value_parts))
report.write_lines("policies.txt", report.join_parts(policy_parts))
report.write_lines("q_tables.csv", q_output)
report.write_lines("learning_curves.csv", curve_output)
report.write_lines("evaluation.txt", report.join_parts(evaluation_parts))
