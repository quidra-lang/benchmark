int integer(string text)
    int result = int.parse(text)
    return result

real64 number(string text)
    real64 result = real64.parse(text)
    return result

string[] lines(string path)
    string content = file.read(path)
    string[] result = content.split(NL)
    return result[0:<int(len(result)) - 1]

int[] integers(string[] values)
    return [for string value = values[] then integer(value)]

real64[] numbers(string[] values)
    return [for string value = values[] then number(value)]

class Params(local string[][] rows)
    int sta_window = integer(rows[0][1])
    int lta_window = integer(rows[1][1])
    int[] trigger_on = integers(rows[2][1:<int(len(rows[2]))])
    int[] trigger_off = integers(rows[3][1:<int(len(rows[3]))])
    int min_duration = integer(rows[4][1])
    int noise_level = integer(rows[5][1])
    int amplitude_window = integer(rows[6][1])
    int clip_level = integer(rows[7][1])
    int association_window = integer(rows[8][1])
    int min_stations = integer(rows[9][1])
    real64 velocity = number(rows[10][1])
    int[] grid_x = integers(rows[11][1:<int(len(rows[11]))])
    int[] grid_y = integers(rows[12][1:<int(len(rows[12]))])
    int[] grid_z = integers(rows[13][1:<int(len(rows[13]))])
    real64 residual_limit = number(rows[14][1])
    real64[] quality_a = numbers(rows[15][1:<int(len(rows[15]))])
    real64[] quality_b = numbers(rows[16][1:<int(len(rows[16]))])
    real64[] cluster = numbers(rows[17][1:<int(len(rows[17]))])
    real64[] local_magnitude = numbers(rows[18][1:<int(len(rows[18]))])
    real64[] duration_magnitude = numbers(rows[19][1:<int(len(rows[19]))])
    int[] map_area = integers(rows[20][1:<int(len(rows[20]))])
    int[] map_size = integers(rows[21][1:<int(len(rows[21]))])
    int[] section = integers(rows[22][1:<int(len(rows[22]))])
    int[] timeline = integers(rows[23][1:<int(len(rows[23]))])

class Station(string code, int x, int y, int elevation, int start, int[] samples)
class Input(Station[] stations, Params params)

Input read_inputs()
    string[] station_rows = lines("input/stations.csv")
    string[] waveforms = lines("input/waveforms.txt")
    Station[] stations = []
    int cursor = 0
    for 1 <= int row < int(len(station_rows))
        string[] fields = station_rows[row].split(",")
        string[] header = waveforms[cursor].split(" ")
        int start = integer(header[2])
        int count = integer(header[3])
        int[] samples = []
        cursor += 1
        while int(len(samples)) < count
            samples = samples.concat(integers(waveforms[cursor].split(" ")))
            cursor += 1
        stations = stations.append(Station(fields[0], integer(fields[1]), integer(fields[2]), integer(fields[3]), start, samples))
    string[][] settings = [for string line = lines("input/params.txt")[] then line.split(" ")]
    return Input(stations, Params(settings))
