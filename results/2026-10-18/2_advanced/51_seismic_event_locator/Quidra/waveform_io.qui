int integer(string text)
    result := int.parse(text)
    return result

real64 number(string text)
    result := real64.parse(text)
    return result

string[] lines(string path)
    content := string.from_utf8(file.read_bin(path))
    result := content.split(NL)
    return result[0:<int(len(result)) - 1]

int[] integers(string[] values)
    return [for value := values[] then integer(value)]

real64[] numbers(string[] values)
    return [for value := values[] then number(value)]

class Params(local string[][] rows)
    sta_window := integer(rows[0][1])
    lta_window := integer(rows[1][1])
    trigger_on := integers(rows[2][1:<int(len(rows[2]))])
    trigger_off := integers(rows[3][1:<int(len(rows[3]))])
    min_duration := integer(rows[4][1])
    noise_level := integer(rows[5][1])
    amplitude_window := integer(rows[6][1])
    clip_level := integer(rows[7][1])
    association_window := integer(rows[8][1])
    min_stations := integer(rows[9][1])
    velocity := number(rows[10][1])
    grid_x := integers(rows[11][1:<int(len(rows[11]))])
    grid_y := integers(rows[12][1:<int(len(rows[12]))])
    grid_z := integers(rows[13][1:<int(len(rows[13]))])
    residual_limit := number(rows[14][1])
    quality_a := numbers(rows[15][1:<int(len(rows[15]))])
    quality_b := numbers(rows[16][1:<int(len(rows[16]))])
    cluster := numbers(rows[17][1:<int(len(rows[17]))])
    local_magnitude := numbers(rows[18][1:<int(len(rows[18]))])
    duration_magnitude := numbers(rows[19][1:<int(len(rows[19]))])
    map_area := integers(rows[20][1:<int(len(rows[20]))])
    map_size := integers(rows[21][1:<int(len(rows[21]))])
    section := integers(rows[22][1:<int(len(rows[22]))])
    timeline := integers(rows[23][1:<int(len(rows[23]))])

class Station(string code, int x, int y, int elevation, int start, int[] samples)
class Input(Station[] stations, Params params)

Input read_inputs()
    station_rows := lines("input/stations.csv")
    waveforms := lines("input/waveforms.txt")
    Station[] stations := []
    int cursor := 0
    for 1 <= int row < int(len(station_rows))
        fields := station_rows[row].split(",")
        header := waveforms[cursor].split(" ")
        start := integer(header[2])
        count := integer(header[3])
        int[] samples := []
        cursor += 1
        while int(len(samples)) < count
            samples = samples.concat(integers(waveforms[cursor].split(" ")))
            cursor += 1
        stations = stations.append(Station(fields[0], integer(fields[1]), integer(fields[2]), integer(fields[3]), start, samples))
    settings := [for string line := lines("input/params.txt")[] then line.split(" ")]
    return Input(stations, Params(settings))
