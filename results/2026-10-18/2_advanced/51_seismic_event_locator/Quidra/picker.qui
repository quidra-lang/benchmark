int absolute(int value)
    return if value < 0 then -value else value

int floor_divide(int numerator, int denominator)
    return if numerator >= 0 then numerator / denominator else -((-numerator + denominator - 1) / denominator)

real64 as_real(int value)
    result := real64(value)
    return result

class Pick(int station, int sample, int duration, real64 ratio, int amplitude, bool clipped)
class Statistics(int mean, int noise_twice, int peak, int clipped_samples, int triggers, int short_triggers, int picks)
class Detection(Statistics statistics, Pick[] picks)

void finish(int ending, int beginning, real64 peak_ratio, int station, int start, int[] samples, int[] centered, int[] energy, int sw, int minimum, int noise, int amplitude_window, int clip_level, Pick[] &picks, int &triggers, int &short_triggers)
    triggers += 1
    duration := ending - beginning
    if duration < minimum
        short_triggers += 1
        return
    position := beginning
    while position - 1 >= beginning - sw + 1 and energy[position - 1] >= noise
        position -= 1
    amplitude := 0
    clipped := false
    last := if position + amplitude_window < int(samples.len()) then position + amplitude_window else int(samples.len())
    for: position <= j < last
        value := absolute(centered[j])
        if value > amplitude
            amplitude = value
        if absolute(samples[j]) >= clip_level
            clipped = true
    picks = picks.append(Pick(station, start + position, duration, peak_ratio, amplitude, clipped))

Detection detect(int[] samples, int start, int station, int sw, int lw, int[] trigger_on, int[] trigger_off, int minimum, int noise, int amplitude_window, int clip_level)
    count := int(samples.len())
    total := 0
    for value := samples[]
        total += value
    mean := floor_divide(total, count)
    int[] centered := []
    int[] energy := []
    prefix := [0]
    int[] absolute_values := []
    peak := 0
    clipped_samples := 0
    for value := samples[]
        difference := value - mean
        centered = centered.append(difference)
        energy = energy.append(difference * difference)
        prefix = prefix.append(prefix[-1] + difference * difference)
        size := absolute(difference)
        absolute_values = absolute_values.append(size)
        if size > peak
            peak = size
        if absolute(value) >= clip_level
            clipped_samples += 1
    Pick[] picks := []
    on := false
    beginning := 0
    real64 peak_ratio := 0.0
    triggers := 0
    short_triggers := 0
    for: sw + lw - 1 <= i < count
        sta := prefix[i + 1] - prefix[i - sw + 1]
        lta := prefix[i - sw + 1] - prefix[i - sw - lw + 1]
        if not on
            if sta * lw * trigger_on[1] >= trigger_on[0] * lta * sw
                on = true
                beginning = i
                peak_ratio = as_real(sta * lw) / as_real(lta * sw)
        elif sta * lw * trigger_off[1] < trigger_off[0] * lta * sw
            finish(i, beginning, peak_ratio, station, start, samples, centered, energy, sw, minimum, noise, amplitude_window, clip_level, &picks, &triggers, &short_triggers)
            on = false
        else
            ratio := as_real(sta * lw) / as_real(lta * sw)
            if ratio > peak_ratio
                peak_ratio = ratio
    if on
        finish(count, beginning, peak_ratio, station, start, samples, centered, energy, sw, minimum, noise, amplitude_window, clip_level, &picks, &triggers, &short_triggers)
    ordered := absolute_values.sorted()
    middle := count / 2
    noise_twice := if count % 2 == 1 then 2 * ordered[middle] else ordered[middle - 1] + ordered[middle]
    statistics := Statistics(mean, noise_twice, peak, clipped_samples, triggers, short_triggers, int(picks.len()))
    return Detection(statistics, picks)
