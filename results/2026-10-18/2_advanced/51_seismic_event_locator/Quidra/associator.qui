class Candidate(int number, int first, int[] picks)

Candidate[] associate(int[][] picks, int station_count, int window, int minimum)
    bool[] assigned = [for int i < int(len(picks)) then false]
    Candidate[] candidates = []
    for int index < int(len(picks))
        if assigned[index]
            continue
        bool[] stations = [for int i < station_count then false]
        int[] selected = []
        for index <= int current < int(len(picks))
            int[] pick = picks[current]
            if pick[0] > picks[index][0] + window
                break
            if not assigned[current] and not stations[pick[1]]
                selected = selected.append(current)
                stations[pick[1]] = true
        if int(len(selected)) >= minimum
            for int current = selected[]
                assigned[current] = true
            candidates = candidates.append(Candidate(int(len(candidates)) + 1, index, selected))
    return candidates
