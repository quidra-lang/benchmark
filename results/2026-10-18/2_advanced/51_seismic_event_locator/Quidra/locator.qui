import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

real64 root(real64 value)
    real64 result = math.sqrt(value)
    return result

int floor_real(real64 value)
    int result = math.floor(value)
    return result

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

real64 arctangent(real64 value)
    bool negative = value < 0.0
    real64 reduced = if negative then -value else value
    bool reciprocal = reduced > 1.0
    if reciprocal
        reduced = 1.0 / reduced
    real64 offset = 0.0
    if reduced > 0.4142135623730950488
        reduced = (reduced - 1.0) / (reduced + 1.0)
        offset = 0.7853981633974483096
    real64 term = reduced
    real64 total = 0.0
    for int i < 40
        total += term / as_real(2 * i + 1)
        term *= -reduced * reduced
    total += offset
    if reciprocal
        total = 1.5707963267948966192 - total
    return if negative then -total else total

real64 atan2(real64 vertical, real64 horizontal)
    if horizontal > 0.0
        return arctangent(vertical / horizontal)
    if horizontal < 0.0
        real64 result = arctangent(vertical / horizontal)
        return if vertical >= 0.0 then result + 3.141592653589793 else result - 3.141592653589793
    return if vertical > 0.0 then 1.5707963267948966192 elif vertical < 0.0 then -1.5707963267948966192 else 0.0

real64 distance(real64[] solution, real64[] station)
    real64 dx = solution[0] - station[0]
    real64 dy = solution[1] - station[1]
    real64 dz = solution[2] + station[2]
    return root((dx * dx + dy * dy) + dz * dz)

real64[] residuals(real64[] solution, real64[][] observations, real64 velocity)
    return [for real64[] observation = observations[] then observation[3] - solution[3] - distance(solution, observation) / velocity]

real64 rms(real64[] solution, real64[][] observations, real64 velocity)
    real64 total = 0.0
    for real64 value = residuals(solution, observations, velocity)[]
        total += value * value
    return root(total / as_real(int(len(observations))))

class Grid(real64[] solution, real64 rms_value, real64[] profile)
class Result(real64[] solution, real64[][] trace, real64[] residual_values, real64 rms_value)
class Run(Grid grid, Result result)
class Normal(real64[][] matrix, real64[] right)

Grid grid_search(real64[][] observations, real64 velocity, int[][] ranges)
    real64[] best = []
    real64 minimum = inf
    int[] gx = ranges[0]
    int[] gy = ranges[1]
    int[] gz = ranges[2]
    real64[] profile = [for int i < (gz[1] - gz[0]) / gz[2] + 1 then inf]
    for gx[0] <= int x < gx[1] + 1 step gx[2]
        for gy[0] <= int y < gy[1] + 1 step gy[2]
            for gz[0] <= int z < gz[1] + 1 step gz[2]
                real64[] solution = [as_real(x), as_real(y), as_real(z), 0.0]
                real64[] deltas = []
                real64 total = 0.0
                for real64[] observation = observations[]
                    real64 value = observation[3] - distance(solution, observation) / velocity
                    deltas = deltas.append(value)
                    total += value
                real64 origin = total / as_real(int(len(observations)))
                real64 error_value = 0.0
                for real64 value = deltas[]
                    real64 difference = value - origin
                    error_value += difference * difference
                if error_value < minimum
                    solution[3] = origin
                    best = solution
                    minimum = error_value
                int index = (z - gz[0]) / gz[2]
                if error_value < profile[index]
                    profile[index] = error_value
    real64 size = as_real(int(len(observations)))
    return Grid(best, root(minimum / size), [for real64 value = profile[] then root(value / size)])

real64[][] cholesky(real64[][] matrix)
    real64[][] lower = [for int row < 4 then [0.0, 0.0, 0.0, 0.0]]
    for int row < 4
        for int column < row + 1
            real64 total = 0.0
            for int index < column
                total += lower[row][index] * lower[column][index]
            real64 difference = matrix[row][column] - total
            lower[row][column] = if row == column then root(difference) else difference / lower[column][column]
    return lower

real64[] solve(real64[][] lower, real64[] right)
    real64[] forward = [0.0, 0.0, 0.0, 0.0]
    real64[] result = [0.0, 0.0, 0.0, 0.0]
    for int row < 4
        real64 total = 0.0
        for int column < row
            total += lower[row][column] * forward[column]
        forward[row] = (right[row] - total) / lower[row][row]
    for int reverse < 4
        int row = 3 - reverse
        real64 total = 0.0
        for row + 1 <= int column < 4
            total += lower[column][row] * result[column]
        result[row] = (forward[row] - total) / lower[row][row]
    return result

Normal normals(real64[] solution, real64[][] observations, real64 velocity)
    real64[][] matrix = [for int row < 4 then [0.0, 0.0, 0.0, 0.0]]
    real64[] right = [0.0, 0.0, 0.0, 0.0]
    for real64[] observation = observations[]
        real64 radius = distance(solution, observation)
        real64 residual = observation[3] - solution[3] - radius / velocity
        real64 denominator = velocity * radius
        real64[] derivatives = [(solution[0] - observation[0]) / denominator, (solution[1] - observation[1]) / denominator, (solution[2] + observation[2]) / denominator, 1.0]
        for int row < 4
            right[row] += derivatives[row] * residual
            for int column < 4
                matrix[row][column] += derivatives[row] * derivatives[column]
    return Normal(matrix, right)

Result geiger(real64[] initial, real64[][] observations, real64 velocity)
    real64[] solution = initial
    real64[][] trace = []
    for int iteration < 8
        Normal normal = normals(solution, observations, velocity)
        real64[] change = solve(cholesky(normal.matrix), normal.right)
        for int axis < 4
            solution[axis] += change[axis]
        if solution[2] < 0.0
            solution[2] = 0.0
        trace = trace.append(solution.append(rms(solution, observations, velocity)))
    return Result(solution, trace, residuals(solution, observations, velocity), rms(solution, observations, velocity))

Run run_location(real64[][] observations, real64 velocity, int[][] ranges)
    Grid grid = grid_search(observations, velocity, ranges)
    return Run(grid, geiger(grid.solution, observations, velocity))

class Ellipse(real64 smaj, real64 smin, real64 az, real64 erz, real64 ert)

Ellipse ellipse(real64[] solution, real64[][] observations, real64 velocity)
    Normal normal = normals(solution, observations, velocity)
    real64[][] lower = cholesky(normal.matrix)
    real64[][] inverse = []
    for int column < 4
        real64[] unit = [0.0, 0.0, 0.0, 0.0]
        unit[column] = 1.0
        inverse = inverse.append(solve(lower, unit))
    real64 total = 0.0
    for real64 value = residuals(solution, observations, velocity)[]
        total += value * value
    real64 variance = total / as_real(int(len(observations)) - 4)
    real64[][] covariance = [for int row < 4 then [for int column < 4 then variance * inverse[column][row]]]
    real64 xx = covariance[0][0]
    real64 yy = covariance[1][1]
    real64 xy = covariance[0][1]
    real64 midpoint = (xx + yy) / 2.0
    real64 difference = (xx - yy) / 2.0
    real64 radius = root(difference * difference + xy * xy)
    real64 theta = atan2(2.0 * xy, xx - yy) / 2.0 * 180.0 / 3.141592653589793
    real64 azimuth = 90.0 - theta
    if azimuth >= 180.0
        azimuth -= 180.0
    elif azimuth < 0.0
        azimuth += 180.0
    return Ellipse(root(midpoint + radius), root(midpoint - radius), azimuth, root(covariance[2][2]), root(covariance[3][3]))
