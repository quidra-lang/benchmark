import math

real64 as_real(int value)
    result := real64(value)
    return result

real64 log10(real64 value)
    logarithm := math.log(value)
    return logarithm / 2.302585092994046

real64 median(real64[] values)
    ordered := values.sorted()
    middle := int(len(ordered)) / 2
    return if int(len(ordered)) % 2 == 1 then ordered[middle] else (ordered[middle - 1] + ordered[middle]) / 2.0

class PickMagnitude(real64 r, real64 ml, real64 md, bool has_ml)

PickMagnitude per_pick(int amplitude, int duration, bool clipped, real64 radius, real64[] local_coefficients, real64[] duration_coefficients)
    md := duration_coefficients[0] + duration_coefficients[1] * log10(as_real(duration) / 100.0) + duration_coefficients[2] * radius
    real64 ml := 0.0
    if not clipped
        ml = log10(as_real(amplitude)) + local_coefficients[0] * log10(radius / 100.0) + local_coefficients[1] * (radius - 100.0) + local_coefficients[2]
    return PickMagnitude(radius, ml, md, not clipped)

int class_number(real64 value)
    absolute := if value < 0.0 then -value else value
    rounded := math.floor(absolute * 100.0 + 0.5)
    hundredths := int(rounded)
    if value < 0.0
        hundredths = -hundredths
    numerator := hundredths + 5
    return if numerator >= 0 then numerator / 10 else -((-numerator + 9) / 10)

string class_text(int value)
    absolute := if value < 0 then -value else value
    sign := if value < 0 then "-" else ""
    return "{sign}{absolute / 10}.{absolute % 10}"

class Frequencies(int[] counts, int low, int high, int completeness, int count, real64 b, real64 sigma, real64 a)

Frequencies frequency(real64[] values)
    classes := [for value := values[] then class_number(value)]
    low := classes[0]
    high := classes[0]
    for value := classes[]
        if value < low
            low = value
        if value > high
            high = value
    int[] counts := [for i := (0:<int(high - low + 1))[] then 0]
    for value := classes[]
        counts[value - low] += 1
    completeness := low
    int greatest := -1
    for int i < int(len(counts))
        if counts[i] > greatest
            completeness = low + i
            greatest = counts[i]
    int total := 0
    int count := 0
    for value := classes[]
        if value >= completeness
            total += value
            count += 1
    mc := as_real(completeness) / 10.0
    mean := as_real(total) / (10.0 * as_real(count))
    b := 0.4342944819032518 / (mean - (mc - 0.05))
    root := math.sqrt(as_real(count))
    return Frequencies(counts, low, high, completeness, count, b, b / root, log10(as_real(count)) + b * mc)
