const string hex_digits = "0123456789abcdef"

int integer(string text)
    int value = int.parse(text)
    return value

string[] lines(string path)
    string text = file.read(path)
    string[] rows = text.split(NL)
    return rows[0:<int(len(rows)) - 1]

int[] integers(string row)
    return [for string value = row.split(" ")[] then integer(value)]

class Image(int width, int height, int[][] pixels)
class Params(int[] qualities, string sampling, int restart_interval, string huffman_mode, int target_bytes, int generations, int[] truncate)
class Tables(int[][] transform, int[][] basic_quantization, int[][] counts, int[][] symbols)

Image read_ppm(string path)
    string[] rows = lines(path)
    int[] dimensions = integers(rows[1])
    int[][] pixels = []
    for string row = rows[3:<int(len(rows))][]
        int[] values = integers(row)
        for int x < dimensions[0]
            pixels = pixels.append(values[3 * x:<3 * x + 3])
    return Image(dimensions[0], dimensions[1], pixels)

Params read_params()
    string[][] rows = [for string row = lines("input/params.txt")[] then row.split(" ")]
    return Params([for string value = rows[0][1:<int(len(rows[0]))][] then integer(value)], rows[1][1], integer(rows[2][1]), rows[3][1], integer(rows[4][1]), integer(rows[5][1]), [for string value = rows[6][1:<int(len(rows[6]))][] then integer(value)])

Tables read_tables()
    string[] rows = lines("input/tables.txt")
    int[][] transform = [for 1 <= int i <= 8 then integers(rows[i])]
    int[][] basic = []
    for int start = [10, 19][]
        int[] values = []
        for start <= int i < start + 8
            values = values.concat(integers(rows[i]))
        basic = basic.append(values)
    int[][] counts = [for 28 <= int i <= 37 step 3 then integers(rows[i])]
    int[][] symbols = [for 29 <= int i <= 38 step 3 then integers(rows[i])]
    return Tables(transform, basic, counts, symbols)

int hex_value(string character)
    for int i < 16
        if character == hex_digits[i]
            return i
    return 0

string hex_byte(int value)
    return hex_digits[value / 16] + hex_digits[value % 16]

int[] read_hex(string path)
    string text = lines(path).join("")
    return [for 0 <= int i < int(len(text)) step 2 then 16 * hex_value(text[i]) + hex_value(text[i + 1])]

void write_lines(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)

void write_ppm(string name, int width, int height, int[][] pixels)
    string[] rows = ["P3", "{width} {height}", "255"]
    for int y < height
        string[] values = []
        for int x < width
            values = values.concat([for int value = pixels[y * width + x][] then value.string()])
        rows = rows.append(values.join(" "))
    write_lines(name, rows)

void write_hex(string name, int[] bytes)
    string[] rows = []
    for 0 <= int start < int(len(bytes)) step 32
        int end = if start + 32 < int(len(bytes)) then start + 32 else int(len(bytes))
        rows = rows.append([for start <= int i < end then hex_byte(bytes[i])].join(""))
    write_lines(name, rows)
