class Writer()
    int[] bytes = []
    int buffer = 0
    int pending = 0
    int padding_bits = 0
    int stuffed_bytes = 0

    void .write(int value, int width)
        int shift = width - 1
        while shift >= 0
            buffer = 2 * buffer + (value / (2 ^ shift)) % 2
            pending += 1
            if pending == 8
                bytes = bytes.append(buffer)
                if buffer == 255
                    bytes = bytes.append(0)
                    stuffed_bytes += 1
                buffer = 0
                pending = 0
            shift -= 1

    void .pad()
        if pending != 0
            int width = 8 - pending
            padding_bits += width
            .write(2 ^ width - 1, width)

    void .restart(int number)
        .pad()
        bytes = bytes.concat([255, 208 + number % 8])

class Reader(int[] bytes, int position)
    int buffer = 0
    int remaining = 0
    string fault = ""

    int .bit()
        if fault != ""
            return -1
        if remaining == 0
            int value = bytes[position]
            if value == 255
                if bytes[position + 1] != 0
                    fault = "marker"
                    return -1
                position += 2
            else
                position += 1
            buffer = value
            remaining = 8
        remaining -= 1
        return (buffer / (2 ^ remaining)) % 2

    int .read(int width)
        int value = 0
        for int i < width
            int next = .bit()
            if fault != ""
                return -1
            value = 2 * value + next
        return value

    void .discard()
        buffer = 0
        remaining = 0

int find_resync(int[] bytes, int position)
    for position <= int offset < int(len(bytes)) - 1
        int next = bytes[offset + 1]
        if bytes[offset] == 255 and ((next >= 208 and next <= 215) or next == 217)
            return offset
    return int(len(bytes)) - 2
