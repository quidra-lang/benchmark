int floor_div(int numerator, int denominator)
    int quotient = numerator / denominator
    if numerator < 0 and numerator % denominator != 0
        quotient -= 1
    return quotient

int clamp(int value)
    return if value < 0 then 0 elif value > 255 then 255 else value

const int[] positions = [0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21, 28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63]

int rounded_shift(int value, int shift)
    return floor_div(value + 2 ^ (shift - 1), 2 ^ shift)

int[] forward(int[] block, int[][] transform)
    int[][] intermediate = [for int u < 8 then [for int x < 8 then 0]]
    for int u < 8
        for int x < 8
            int sum = 0
            for int y < 8
                sum += transform[u][y] * (block[8 * y + x] - 128)
            intermediate[u][x] = rounded_shift(sum, 11)
    int[] result = []
    for int u < 8
        for int v < 8
            int sum = 0
            for int x < 8
                sum += intermediate[u][x] * transform[v][x]
            result = result.append(rounded_shift(sum, 15))
    return result

int[] inverse(int[] coefficients, int[][] transform)
    int[][] intermediate = [for int y < 8 then [for int v < 8 then 0]]
    for int y < 8
        for int v < 8
            int sum = 0
            for int u < 8
                sum += transform[u][y] * coefficients[8 * u + v]
            intermediate[y][v] = rounded_shift(sum, 11)
    int[] result = []
    for int y < 8
        for int x < 8
            int sum = 0
            for int v < 8
                sum += intermediate[y][v] * transform[v][x]
            result = result.append(clamp(rounded_shift(sum, 15) + 128))
    return result

int[][] quantization_tables(int[][] basic, int quality)
    int scale = if quality < 50 then 5000 / quality else 200 - 2 * quality
    int[][] result = []
    for int[] table = basic[]
        int[] values = []
        for int value = table[]
            int quantized = (value * scale + 50) / 100
            values = values.append(if quantized < 1 then 1 elif quantized > 255 then 255 else quantized)
        result = result.append(values)
    return result

int[] quantize(int[] values, int[] table)
    int[] result = []
    for int i < 64
        int magnitude = if values[i] < 0 then -values[i] else values[i]
        int rounded = (magnitude + table[i] / 2) / table[i]
        result = result.append(if values[i] < 0 then -rounded else rounded)
    return result

int[] zigzag(int[] values)
    return [for int position = positions[] then values[position]]

int[] dequantize(int[] sequence, int[] table, int keep = 64)
    int[] result = [for int i < 64 then 0]
    for int i < keep
        int position = positions[i]
        result[position] = sequence[i] * table[position]
    return result
