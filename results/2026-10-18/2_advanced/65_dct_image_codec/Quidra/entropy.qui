int category(int value)
    int magnitude = if value < 0 then -value else value
    int size = 0
    while magnitude > 0
        magnitude /= 2
        size += 1
    return size

int[] extra_bits(int value)
    int size = category(value)
    return [if value < 0 then value + 2 ^ size - 1 else value, size]

int amplitude(int bits, int size)
    if size == 0
        return 0
    return if bits >= 2 ^ (size - 1) then bits else bits - 2 ^ size + 1

class Table(int[] counts, int[] symbols)
    int[] lengths = [for int i < 256 then 0]
    int[] codes = [for int i < 256 then 0]
    int code = 0
    int offset = 0
    for 1 <= int length <= 16
        for int i < counts[length - 1]
            local int symbol = symbols[offset]
            lengths[symbol] = length
            codes[symbol] = code
            code += 1
            offset += 1
        code *= 2

Table optimized_table(int[] frequencies)
    int[] weights = frequencies.append(1)
    int[] sizes = [for int i < 257 then 0]
    int[] others = [for int i < 257 then -1]
    while true
        int first = -1
        int second = -1
        for int symbol <= 256
            if weights[symbol] <= 0
                continue
            if first < 0 or weights[symbol] <= weights[first]
                second = first
                first = symbol
            elif second < 0 or weights[symbol] <= weights[second]
                second = symbol
        if second < 0
            break
        weights[first] += weights[second]
        weights[second] = 0
        sizes[first] += 1
        while others[first] != -1
            first = others[first]
            sizes[first] += 1
        others[first] = second
        sizes[second] += 1
        while others[second] != -1
            second = others[second]
            sizes[second] += 1
    int[] counts = [for int i < 257 then 0]
    int longest = 0
    for int size = sizes[]
        if size > 0
            counts[size] += 1
            if size > longest
                longest = size
    int length = longest
    while length > 16
        while counts[length] > 0
            int shorter = length - 2
            while counts[shorter] == 0
                shorter -= 1
            counts[length] -= 2
            counts[length - 1] += 1
            counts[shorter + 1] += 2
            counts[shorter] -= 1
        length -= 1
    length = 16
    while counts[length] == 0
        length -= 1
    counts[length] -= 1
    int[] keys = [for int symbol < 256 if sizes[symbol] > 0 then sizes[symbol] * 256 + symbol]
    int[] symbols = [for int key = keys.sorted()[] then key % 256]
    return Table(counts[1:<17], symbols)
