import molecule = "./molecule.qui"

bool[] edge_set(const molecule.Molecule graph, const int[] ring)
    bool[] result = array(len(graph.bonds), fill = false)
    for int index < int(len(ring))
        int edge = molecule.required_bond(graph, ring[index], ring[(index + 1) % int(len(ring))])
        result[edge] = true
    return result

int[] path(int atom_index, const int[] parents)
    int[] result = [atom_index]
    int current = atom_index
    while parents[current] >= 0
        current = parents[current]
        result = result.append(current)
    return result

class Candidate(int[] atoms, bool[] edges)

void detect(molecule.Molecule &graph)
    int atom_count = int(len(graph.atoms))
    Candidate[] candidates = []
    bool[][] seen = []
    for int root < atom_count
        int[] parents = array(nat(atom_count), fill = -1)
        bool[] visited = array(nat(atom_count), fill = false)
        int[] queue = [root]
        visited[root] = true
        int head = 0
        while head < int(len(queue))
            int current_atom = queue[head]
            head += 1
            for molecule.Neighbor neighbor = graph.neighbors[current_atom][]
                if not visited[neighbor.atom]
                    visited[neighbor.atom] = true
                    parents[neighbor.atom] = current_atom
                    queue = queue.append(neighbor.atom)
        for molecule.Bond bond = graph.bonds[]
            if parents[bond.first] == bond.second or parents[bond.second] == bond.first
                continue
            int[] first_path = path(bond.first, parents)
            int[] second_path = path(bond.second, parents)
            bool shared = false
            for int member = first_path[]
                if member != root and molecule.has(second_path, member)
                    shared = true
                    break
            if shared
                continue
            int[] ring = first_path[::-1].concat(second_path[0:<int(len(second_path)) - 1])
            bool[] edges = edge_set(graph, ring)
            if not molecule.has(seen, edges)
                seen = seen.append(edges)
                candidates = candidates.append(Candidate(ring, edges))
    for int position < int(len(candidates))
        int current = position
        while current > 0 and len(candidates[current].atoms) < len(candidates[current - 1].atoms)
            Candidate saved = candidates[current]
            candidates[current] = candidates[current - 1]
            candidates[current - 1] = saved
            current -= 1
    bool[][] basis = array(len(graph.bonds), fill = [])
    int[][] selected = []
    for Candidate candidate = candidates[]
        bool[] vector = candidate.edges
        while true
            int pivot = int(len(vector)) - 1
            while pivot >= 0
                if vector[pivot]
                    break
                pivot -= 1
            if pivot < 0
                break
            if len(basis[pivot]) == 0
                basis[pivot] = vector
                selected = selected.append(candidate.atoms)
                break
            for int edge < int(len(vector))
                vector[edge] = vector[edge] != basis[pivot][edge]
    graph.rings = []
    for int[] source = selected[]
        int[] sorted_atoms = source.sorted()
        int first_position = 0
        for int index < int(len(source))
            if source[index] == sorted_atoms[0]
                first_position = index
                break
        int[] rotated = []
        for int offset < int(len(source))
            rotated = rotated.append(source[(first_position + offset) % int(len(source))])
        if rotated[1] > rotated[int(len(rotated)) - 1]
            int[] backwards = rotated[1:<int(len(rotated))][::-1]
            rotated = [rotated[0]].concat(backwards)
        graph.rings = graph.rings.append(rotated)
    for int position < int(len(graph.rings))
        int current = position
        while current > 0
            int[] first_ring = graph.rings[current]
            int[] second_ring = graph.rings[current - 1]
            bool precedes = len(first_ring) < len(second_ring) or (len(first_ring) == len(second_ring) and molecule.compare(first_ring, second_ring) < 0)
            if not precedes
                break
            graph.rings[current] = second_ring
            graph.rings[current - 1] = first_ring
            current -= 1
    for int[] ring = graph.rings[]
        bool[] ring_edges = edge_set(graph, ring)
        for int edge < int(len(ring_edges))
            if ring_edges[edge]
                graph.bonds[edge].ring = true

bool matching(const molecule.Molecule graph, const bool[] system, int[] &paired)
    int first = -1
    for int atom_index < int(len(system))
        if system[atom_index] and paired[atom_index] < 0
            first = atom_index
            break
    if first < 0
        return true
    for molecule.Neighbor neighbor = graph.neighbors[first][]
        int second = neighbor.atom
        if system[second] and paired[second] < 0 and graph.bonds[neighbor.edge].kind == 4
            paired[first] = second
            paired[second] = first
            if matching(graph, system, &paired)
                return true
            paired[first] = -1
            paired[second] = -1
    return false

molecule.Problem | none kekulize(molecule.Molecule &graph, const map.Map<string, molecule.Element> elements)
    bool[] remaining = array(len(graph.atoms), fill = false)
    for int atom_index < int(len(graph.atoms))
        remaining[atom_index] = graph.needs_pi(atom_index, elements, true)
    int[] paired = array(len(graph.atoms), fill = -1)
    for int start < int(len(graph.atoms))
        if not remaining[start]
            continue
        bool[] system = array(len(graph.atoms), fill = false)
        int[] pending = [start]
        remaining[start] = false
        while len(pending) > 0
            int last = int(len(pending)) - 1
            int current_atom = pending[last]
            pending = pending[0:<last]
            system[current_atom] = true
            for molecule.Neighbor neighbor = graph.neighbors[current_atom][]
                if graph.bonds[neighbor.edge].kind == 4 and remaining[neighbor.atom]
                    remaining[neighbor.atom] = false
                    pending = pending.append(neighbor.atom)
        if not matching(graph, system, &paired)
            return molecule.Problem("kekulization failed", graph.atoms[start].column)
    for int edge < int(len(graph.bonds))
        molecule.Bond original = graph.bonds[edge]
        graph.bonds[edge].multiplicity = if original.kind == 4 then (if paired[original.first] == original.second then 2 else 1) else original.kind
    return none
