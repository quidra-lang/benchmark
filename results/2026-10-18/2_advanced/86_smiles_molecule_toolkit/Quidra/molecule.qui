class Element(int number, int mass, int[] valences)
class Atom(string element, bool aromatic = false, int mass = 0, int charge = 0, int hydrogens = 0, bool bracket = false, int column = 1)
class Bond(int first, int second, int kind, int multiplicity = 0, bool ring = false)
class Neighbor(int atom, int edge)
class Problem(string reason, int column)

bool has<T>(const T[] values, T sought)
    for T value = values[]
        if value == sought
            return true
    return false

int compare(const int[] first, const int[] second)
    int count = if len(first) < len(second) then int(len(first)) else int(len(second))
    for int position < count
        if first[position] < second[position]
            return -1
        if first[position] > second[position]
            return 1
    return if len(first) < len(second) then -1 elif len(first) > len(second) then 1 else 0

int absolute(int value)
    return if value < 0 then -value else value

Element | error lookup(const map.Map<string, Element> table, string symbol)
    match table.get(symbol)
        Element found
            return found
        none
            return error("unknown element")

map.Map<string, Element> read_elements()
    map.Map<string, Element> table = map.Map<string, Element>()
    string text = file.read("input/elements.txt")
    string[] lines = text.split(NL)
    for string line = lines[]
        if line == "" or line.starts_with("#")
            continue
        string[] words = line.split(" ")
        int[] valences = []
        string[] numbers = words[3].split(",")
        for string number = numbers[]
            int parsed = int.parse(number)
            valences = valences.append(parsed)
        int atomic_number = int.parse(words[1])
        int mass = int.parse(words[2])
        .table.set(words[0], Element(atomic_number, mass, valences))
    return table

class Molecule()
    Atom[] atoms = []
    Bond[] bonds = []
    Neighbor[][] neighbors = []
    int[][] rings = []

    int | none bond(int first_atom, int second_atom)
        for Neighbor neighbor = neighbors[first_atom][]
            if neighbor.atom == second_atom
                return neighbor.edge
        return none

    int base(int atom_index)
        int total = 0
        for Neighbor neighbor = neighbors[atom_index][]
            int bond_kind = bonds[neighbor.edge].kind
            total += if bond_kind == 4 then 1 else bond_kind
        return total

    int multiplicity(int atom_index)
        int total = 0
        for Neighbor neighbor = neighbors[atom_index][]
            total += bonds[neighbor.edge].multiplicity
        return total

    bool needs_pi(int atom_index, const map.Map<string, Element> elements, bool include_hydrogens)
        Atom current = atoms[atom_index]
        Element info = lookup(elements, current.element)
        int supplied = if include_hydrogens then current.hydrogens else 0
        return current.aromatic and info.valences[0] + current.charge >= base(atom_index) + supplied + 1

    int | none organic_hydrogens(int atom_index, const map.Map<string, Element> elements)
        int total = multiplicity(atom_index)
        Element info = lookup(elements, atoms[atom_index].element)
        for int valence = info.valences[]
            if valence >= total
                return valence - total
        return none

void rebuild(Molecule &graph)
    Bond[] ordered = graph.bonds
    for int position < int(len(ordered))
        int current = position
        while current > 0
            Bond left = ordered[current]
            Bond right = ordered[current - 1]
            if not (left.first < right.first or (left.first == right.first and left.second < right.second))
                break
            ordered[current] = right
            ordered[current - 1] = left
            current -= 1
    graph.bonds = ordered
    graph.neighbors = array(len(graph.atoms), fill = [])
    for int edge < int(len(graph.bonds))
        Bond current_bond = graph.bonds[edge]
        graph.neighbors[current_bond.first] = graph.neighbors[current_bond.first].append(Neighbor(current_bond.second, edge))
        graph.neighbors[current_bond.second] = graph.neighbors[current_bond.second].append(Neighbor(current_bond.first, edge))
    for int atom_index < int(len(graph.atoms))
        Neighbor[] adjacency = graph.neighbors[atom_index]
        for int position < int(len(adjacency))
            int current = position
            while current > 0 and adjacency[current].atom < adjacency[current - 1].atom
                Neighbor saved = adjacency[current]
                adjacency[current] = adjacency[current - 1]
                adjacency[current - 1] = saved
                current -= 1
        graph.neighbors[atom_index] = adjacency

int | error required_bond(const Molecule graph, int first_atom, int second_atom)
    match graph.bond(first_atom, second_atom)
        int found
            return found
        none
            return error("missing ring bond")

bool has_bond(const Molecule graph, int first_atom, int second_atom)
    match graph.bond(first_atom, second_atom)
        int found
            return true
        none
            return false
