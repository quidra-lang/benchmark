import molecule = "./molecule.qui"

int distinct_count(const int[] values)
    int[] ordered = values.sorted()
    int result = 0
    for int index < int(len(ordered))
        if index == 0 or ordered[index] != ordered[index - 1]
            result += 1
    return result

int[] dense(const int[][] values)
    int[][] unique_values = []
    for int[] value = values[]
        if not molecule.has(unique_values, value)
            unique_values = unique_values.append(value)
    for int position < int(len(unique_values))
        int current = position
        while current > 0 and molecule.compare(unique_values[current], unique_values[current - 1]) < 0
            int[] saved = unique_values[current]
            unique_values[current] = unique_values[current - 1]
            unique_values[current - 1] = saved
            current -= 1
    int[] result = []
    for int[] value = values[]
        for int index < int(len(unique_values))
            if unique_values[index] == value
                result = result.append(index + 1)
                break
    return result

int[] refine(const molecule.Molecule graph, const int[] initial)
    int[] current_ranks = initial
    while true
        int classes = distinct_count(current_ranks)
        int[][] values = []
        for int atom_index < int(len(graph.atoms))
            int[][] pairs = []
            for molecule.Neighbor neighbor = graph.neighbors[atom_index][]
                pairs = pairs.append([current_ranks[neighbor.atom], graph.bonds[neighbor.edge].kind])
            for int position < int(len(pairs))
                int current = position
                while current > 0 and molecule.compare(pairs[current], pairs[current - 1]) < 0
                    int[] saved = pairs[current]
                    pairs[current] = pairs[current - 1]
                    pairs[current - 1] = saved
                    current -= 1
            int[] combined = [current_ranks[atom_index]]
            for int[] pair = pairs[]
                combined = combined.concat(pair)
            values = values.append(combined)
        current_ranks = dense(values)
        if distinct_count(current_ranks) == classes
            return current_ranks

class Ranks(int[] values, int classes)

Ranks rank_atoms(const molecule.Molecule graph, const map.Map<string, molecule.Element> elements)
    int[][] invariants = []
    for int atom_index < int(len(graph.atoms))
        molecule.Atom atom = graph.atoms[atom_index]
        molecule.Element info = molecule.lookup(elements, atom.element)
        invariants = invariants.append([int(len(graph.neighbors[atom_index])), info.number, atom.mass, atom.charge, atom.hydrogens, if atom.aromatic then 1 else 0])
    int[] current_ranks = refine(graph, dense(invariants))
    int classes = distinct_count(current_ranks)
    int count = int(len(graph.atoms))
    while distinct_count(current_ranks) < count
        int[] occurrences = array(nat(count + 1), fill = 0)
        for int rank = current_ranks[]
            occurrences[rank] += 1
        int tied = 1
        while occurrences[tied] < 2
            tied += 1
        int selected = 0
        while current_ranks[selected] != tied
            selected += 1
        int[][] split = []
        for int atom_index < count
            split = split.append([current_ranks[atom_index] * 2 - (if atom_index == selected then 1 else 0)])
        current_ranks = refine(graph, dense(split))
    return Ranks(current_ranks, classes)

string lower_symbol(string element)
    string uppercase = "BCNOPS"
    string lowercase = "bcnops"
    for int index < 6
        if element == uppercase[index]
            return lowercase[index]
    return element

string atom_text(const molecule.Molecule graph, int atom_index, const map.Map<string, molecule.Element> elements)
    molecule.Atom atom = graph.atoms[atom_index]
    string symbol = if atom.aromatic then lower_symbol(atom.element) else atom.element
    bool allowed = molecule.has(["B", "C", "N", "O", "P", "S", "F", "Cl", "Br", "I"], atom.element)
    if atom.aromatic
        allowed = allowed and molecule.has(["B", "C", "N", "O", "P", "S"], atom.element)
    bool implicit_matches = false
    match graph.organic_hydrogens(atom_index, elements)
        int hydrogens
            implicit_matches = hydrogens == atom.hydrogens
        none
            implicit_matches = false
    bool same_pi = not atom.aromatic or graph.needs_pi(atom_index, elements, true) == graph.needs_pi(atom_index, elements, false)
    if allowed and atom.mass == 0 and atom.charge == 0 and same_pi and implicit_matches
        return symbol
    string result = "["
    if atom.mass != 0
        result += atom.mass.string()
    result += symbol
    if atom.hydrogens > 0
        result += "H"
        if atom.hydrogens > 1
            result += atom.hydrogens.string()
    if atom.charge != 0
        result += if atom.charge > 0 then "+" else "-"
        int magnitude = molecule.absolute(atom.charge)
        if magnitude > 1
            result += magnitude.string()
    return result + "]"

string bond_text(const molecule.Molecule graph, int edge)
    molecule.Bond bond = graph.bonds[edge]
    bool aromatic = graph.atoms[bond.first].aromatic and graph.atoms[bond.second].aromatic and bond.ring
    if bond.kind == 1
        return if aromatic then "-" else ""
    if bond.kind == 2
        return "="
    if bond.kind == 3
        return "#"
    return if aromatic then "" else ":"

molecule.Neighbor[] ordered_neighbors(const molecule.Molecule graph, int atom_index, const int[] keys)
    molecule.Neighbor[] result = graph.neighbors[atom_index]
    for int position < int(len(result))
        int current = position
        while current > 0 and keys[result[current].atom] < keys[result[current - 1].atom]
            molecule.Neighbor saved = result[current]
            result[current] = result[current - 1]
            result[current - 1] = saved
            current -= 1
    return result

class Traversal(int[] visited, int[] edge_kinds, molecule.Neighbor[][] children)
    int serial = 0

void visit(const molecule.Molecule graph, const int[] current_ranks, int atom_index, int incoming, Traversal &state)
    state.serial += 1
    state.visited[atom_index] = state.serial
    molecule.Neighbor[] neighbors = ordered_neighbors(graph, atom_index, current_ranks)
    for molecule.Neighbor neighbor = neighbors[]
        if neighbor.edge == incoming or state.edge_kinds[neighbor.edge] == 2
            continue
        if state.visited[neighbor.atom] == 0
            state.edge_kinds[neighbor.edge] = 1
            state.children[atom_index] = state.children[atom_index].append(neighbor)
            visit(graph, current_ranks, neighbor.atom, neighbor.edge, &state)
        else
            state.edge_kinds[neighbor.edge] = 2

class Writing(int[] assigned)
    string text = ""

void write_node(const molecule.Molecule graph, const map.Map<string, molecule.Element> elements, const Traversal traversal, int atom_index, Writing &state)
    state.text += atom_text(graph, atom_index, elements)
    molecule.Neighbor[] neighbors = ordered_neighbors(graph, atom_index, traversal.visited)
    for molecule.Neighbor neighbor = neighbors[]
        if traversal.edge_kinds[neighbor.edge] != 2
            continue
        int number = state.assigned[neighbor.edge]
        if number > 0
            state.assigned[neighbor.edge] = 0
        else
            number = 1
            while molecule.has(state.assigned, number)
                number += 1
            state.assigned[neighbor.edge] = number
            state.text += bond_text(graph, neighbor.edge)
        if number >= 10
            state.text += "%"
        state.text += number.string()
    molecule.Neighbor[] children = traversal.children[atom_index]
    for int index < int(len(children))
        bool branch = index + 1 < int(len(children))
        if branch
            state.text += "("
        state.text += bond_text(graph, children[index].edge)
        write_node(graph, elements, traversal, children[index].atom, &state)
        if branch
            state.text += ")"

class Canonical(string text, int classes)

Canonical smiles(const molecule.Molecule graph, const map.Map<string, molecule.Element> elements)
    Ranks ranked = rank_atoms(graph, elements)
    int start = 0
    while ranked.values[start] != 1
        start += 1
    Traversal traversal = Traversal(array(len(graph.atoms), fill = 0), array(len(graph.bonds), fill = 0), array(len(graph.atoms), fill = []))
    visit(graph, ranked.values, start, -1, &traversal)
    Writing state = Writing(array(len(graph.bonds), fill = 0))
    write_node(graph, elements, traversal, start, &state)
    return Canonical(state.text, ranked.classes)
