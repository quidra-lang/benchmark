class Entry(int term, string command, int request)

class Node(int number, local int count)
    int term := 0
    int voted_for := 0
    Entry[] log := []
    up := true
    role := "FOLLOWER"
    int commit := 0
    int applied := 0
    map<string, int> store
    int known_leader := 0
    bool[] votes := array(nat(count + 1), fill = false)
    int election_deadline := -1
    int election_record := -1
    int[] next_index := array(nat(count + 1), fill = 0)
    int[] matched := array(nat(count + 1), fill = 0)
    int heartbeat_deadline := -1
    int quorum_deadline := -1
    bool[] heard := array(nat(count + 1), fill = false)
    int transfer_target := 0
    transfer_sent := false
    int transfer_deadline := -1
    int elections := 0
    int leader_terms := 0
    int votes_granted := 0
    int leader_ticks := 0
    int ae_ok := 0
    int ae_fail := 0
    int appended := 0
    int truncated := 0
    int applies := 0

int last_index(Node node)
    return int(len(node.log))

int term_at(Node node, int index)
    return if index == 0 then 0 else node.log[index - 1].term

bool accepts_log(Node node, int candidate_index, int candidate_term)
    int latest_term := term_at(node, last_index(node))
    return candidate_term > latest_term or (candidate_term == latest_term and candidate_index >= last_index(node))

void cancel_transfer(Node &node)
    node.transfer_target = 0
    node.transfer_sent = false
    node.transfer_deadline = -1

void crash(Node &node)
    node.up = false
    node.role = "FOLLOWER"
    node.commit = 0
    node.applied = 0
    node.store = map<string, int>()
    node.known_leader = 0
    node.votes = array(len(node.votes), fill = false)
    node.election_deadline = -1
    node.election_record = -1
    node.next_index = array(len(node.next_index), fill = 0)
    node.matched = array(len(node.matched), fill = 0)
    node.heartbeat_deadline = -1
    node.quorum_deadline = -1
    node.heard = array(len(node.heard), fill = false)
    cancel_transfer(&node)

int value_or_zero(map<string, int> store, string key)
    match store.get(key)
        int value
            return value
        none
            return 0

string value_text(map<string, int> store, string key)
    match store.get(key)
        int value
            return "{value}"
        none
            return "missing"

string apply_command(map<string, int> &store, string command)
    string[] fields := command.split(" ")
    if fields[0] == "NOOP"
        return "-"
    string key := fields[1]
    if fields[0] == "SET"
        .store.set(key, int.parse(fields[2]))
        return "ok"
    if fields[0] == "ADD"
        int value := value_or_zero(store, key) + int.parse(fields[2])
        .store.set(key, value)
        return "{value}"
    if fields[0] == "DEL"
        bool removed := .store.remove(key)
        return if removed then "deleted" else "missing"
    return value_text(store, key)

int members(bool[] flags)
    int result := 0
    for flag := flags[]
        if flag
            result += 1
    return result

string node_set(bool[] flags)
    string[] parts := []
    for 1 <= int i < int(len(flags))
        if flags[i]
            parts = parts.append("n{i}")
    return if len(parts) == 0 then "-" else parts.join(",")
