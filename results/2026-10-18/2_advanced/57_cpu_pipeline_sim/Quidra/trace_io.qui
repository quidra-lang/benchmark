int integer(string text)
    int result = int.parse(text)
    return result

string[] lines(string path)
    string content = file.read(path)
    string[] rows = content.split(NL)
    return rows[0:<int(len(rows)) - 1]

int hexadecimal(string text)
    if len(text) != 8
        return -1
    int result = 0
    string digits = "0123456789abcdef"
    for int position < int(len(text))
        string character = text[position]
        int digit = -1
        for int i < 16
            if digits[i] == character
                digit = i
        if digit < 0
            return -1
        result = 16 * result + digit
    return result

int register(string text)
    if len(text) < 2 or text[0] != "r" or len(text) > 3
        return -1
    string digits = text[1:<int(len(text))]
    if len(digits) > 1 and digits[0] == "0"
        return -1
    int result = 0
    for int position < int(len(digits))
        string character = digits[position]
        int digit = -1
        for int i < 10
            if i.string() == character
                digit = i
        if digit < 0
            return -1
        result = 10 * result + digit
    return if result <= 31 then result else -1

class Predictor(string name, string scheme, int[] parameters)
class Variant(string name, bool forwarding, string stage, int latency)
class Config(int btb, int ras, Predictor[] predictors, Variant[] variants, string[] primary, int[] window, int top, int interval)

Config read_config()
    int btb = 0
    int ras = 0
    int top = 0
    int interval = 0
    Predictor[] predictors = []
    Variant[] variants = []
    string[] primary = []
    int[] window = []
    for string row = lines("input/config.txt")[]
        string[] fields = row.split(" ")
        string key = fields[0]
        if key == "BTB"
            btb = integer(fields[1])
        elif key == "RAS"
            ras = integer(fields[1])
        elif key == "TOP"
            top = integer(fields[1])
        elif key == "INTERVAL"
            interval = integer(fields[1])
        elif key == "PRIMARY"
            primary = fields[1:<3]
        elif key == "WINDOW"
            window = [integer(fields[1]), integer(fields[2])]
        elif key == "PREDICTOR"
            int[] parameters = [for string text = fields[3:<int(len(fields))][] then integer(text)]
            predictors = predictors.append(Predictor(fields[1], fields[2], parameters))
        else
            variants = variants.append(Variant(fields[1], fields[2] == "ON", fields[3], integer(fields[4])))
    return Config(btb, ras, predictors, variants, primary, window, top, interval)
