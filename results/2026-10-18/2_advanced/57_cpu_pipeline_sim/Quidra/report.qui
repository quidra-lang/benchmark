string padded(int value, int width, string fill)
    text := value.string()
    return string.repeat(fill, nat(width - int(len(text)))) + text

string decimal(int p, int q)
    scaled := (2 * p * 10000 + q) / (2 * q)
    return (scaled / 10000).string() + "." + padded(scaled % 10000, 4, "0")

string percentage(int p, int q)
    if q == 0
        return "-"
    scaled := (2 * p * 10000 + q) / (2 * q)
    return (scaled / 100).string() + "." + padded(scaled % 100, 2, "0")

string fraction(int p, int q)
    a := p
    b := q
    while b != 0
        remainder := a % b
        a = b
        b = remainder
    return (p / a).string() + "/" + (q / a).string()

string hexadecimal(int value)
    result := ""
    digits := "0123456789abcdef"
    for: i < 8
        result = digits[value % 16] + result
        value /= 16
    return result

string register(int value)
    return if value < 0 then "-" else "r" + value.string()

string heading(int first, int last)
    return "cycle" + string.repeat(" ", 18) + [for cycle := (int(first):<(int(last) + 1))[] then (cycle % 10).string()].join("")

string row(int number, int pc, string kind, string characters, string annotation)
    identifier := if number < 0 then "     -" else padded(number, 6, " ")
    return identifier + " " + hexadecimal(pc) + " " + kind + string.repeat(" ", nat(6 - int(len(kind)))) + " " + characters + annotation

string[] join(string[][] parts)
    string[] result := []
    for: i < int(len(parts))
        if i > 0
            result = result.append("")
        result = result.concat(parts[i])
    return result

void write(string name, string[] rows)
    writer1 := file.write("output/" + name)
    .writer1(rows.join(NL) + NL)
