int bounded(int value, bool taken)
    if taken
        return if value < 3 then value + 1 else 3
    return if value > 0 then value - 1 else 0

int xor(int first, int second)
    int result = 0
    int bit = 1
    while first > 0 or second > 0
        if first % 2 != second % 2
            result += bit
        first /= 2
        second /= 2
        bit *= 2
    return result

class BTB(int size)
    int[][] entries = [for int i < size then [-1, -1]]

    int lookup(int pc)
        int[] entry = entries[(pc / 4) % size]
        return if entry[0] == pc then entry[1] else -1

    void .insert(int pc, int target)
        entries[(pc / 4) % size] = [pc, target]

class RAS(int depth)
    int[] stack = []

    void .push(int address)
        if depth > 0
            if int(len(stack)) == depth
                stack = stack[1:<int(len(stack))]
            stack = stack.append(address)

    int .pop()
        if len(stack) == 0
            return -1
        int result = stack[int(len(stack)) - 1]
        stack = stack[0:<int(len(stack)) - 1]
        return result

class Direction(string scheme, int[] parameters)
    int history = 0
    int[] table = [for int i < (if len(parameters) > 0 then parameters[0] else 0) then (if scheme == "ONEBIT" then 0 else 1)]
    int[] local_table = [for int i < (if scheme == "TOURNAMENT" then parameters[0] else 0) then 1]
    int[] global_table = [for int i < (if scheme == "TOURNAMENT" then parameters[1] else 0) then 1]
    int[] chooser = [for int i < (if scheme == "TOURNAMENT" then parameters[3] else 0) then 1]

    bool predict(int pc, int target)
        int index = pc / 4
        if scheme == "STATIC_NT" or scheme == "PERFECT"
            return false
        if scheme == "BTFN"
            return target < pc
        if scheme == "ONEBIT"
            return table[index % int(len(table))] == 1
        if scheme == "TWOBIT"
            return table[index % int(len(table))] >= 2
        if scheme == "GSHARE"
            return table[xor(index, history) % int(len(table))] >= 2
        if chooser[index % int(len(chooser))] >= 2
            return global_table[xor(index, history) % int(len(global_table))] >= 2
        return local_table[index % int(len(local_table))] >= 2

    void .update(int pc, bool taken)
        if scheme == "STATIC_NT" or scheme == "BTFN" or scheme == "PERFECT"
            return
        int index = pc / 4
        if scheme == "TOURNAMENT"
            int li = index % int(len(local_table))
            int gi = xor(index, history) % int(len(global_table))
            int ci = index % int(len(chooser))
            bool lp = local_table[li] >= 2
            bool gp = global_table[gi] >= 2
            if lp != gp
                chooser[ci] = bounded(chooser[ci], gp == taken)
            local_table[li] = bounded(local_table[li], taken)
            global_table[gi] = bounded(global_table[gi], taken)
            history = (2 * history + (if taken then 1 else 0)) % (2 ^ parameters[2])
        else
            if scheme == "GSHARE"
                index = xor(index, history)
            index %= int(len(table))
            table[index] = if scheme == "ONEBIT" then (if taken then 1 else 0) else bounded(table[index], taken)
            if scheme == "GSHARE"
                history = (2 * history + (if taken then 1 else 0)) % (2 ^ parameters[1])

    int storage()
        if scheme == "ONEBIT"
            return parameters[0]
        if scheme == "TWOBIT"
            return 2 * parameters[0]
        if scheme == "GSHARE"
            return 2 * parameters[0] + parameters[1]
        if scheme == "TOURNAMENT"
            return 2 * (parameters[0] + parameters[1] + parameters[3]) + parameters[2]
        return 0
