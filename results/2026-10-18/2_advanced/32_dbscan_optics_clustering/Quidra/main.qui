import math
import data = "./dataset.qui"
import grid = "./grid_index.qui"
import dbscan = "./dbscan.qui"
import optics = "./optics.qui"
import report = "./report.qui"

string joined(int[] values)
    return [for int value = values[] then "{value}"].join(" ")

string label_char(int label)
    if label < 0
        return "."
    string letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    return if label < 52 then letters[label] else "#"

string value_text(int value)
    return if value == optics.infinity then "-" else "{value}"

string root(int value)
    return if value == optics.infinity then "-" else report.root(value)

string optional(int value)
    return if value < 0 then "-" else "{value}"

string check(bool value)
    return if value then "ok" else "mismatch"

string condition(bool value)
    return if value then "ok" else "fail"

int integer_root(int value)
    int low = 0
    int high = value + 1
    while high - low > 1
        int mid = (low + high) / 2
        if mid <= value / mid
            low = mid
        else
            high = mid
    return low

int suggested(int value)
    int radius = integer_root(value)
    if radius * radius < value
        radius += 1
    return math.max(radius, 1)

int[] unique_sorted(int[] values)
    int[] ordered = values.sorted()
    int[] result = []
    for int value = ordered[]
        if len(result) == 0 or value != result[len(result) - 1]
            result = result.append(value)
    return result

class Curve(int[] source)
    int[] order = []
    for int point < int(len(source))
        local int position = int(len(order))
        order = order.append(point)
        while position > 0 and source[point] > source[order[position - 1]]
            order[position] = order[position - 1]
            position -= 1
        order[position] = point
    int[] values = [for int index = order[] then source[index]]
    int knee = 0
    int cross = -1
    for int index < int(len(values))
        local int current = math.abs((int(len(values)) - 1) * (values[index] - values[0]) - (values[len(values) - 1] - values[0]) * index)
        if current > cross
            cross = current
            knee = index
    int eps = suggested(values[knee])

class GridSummary(data.Point[] points, int radius)
    local grid.Grid index = grid.Grid(points, radius)
    int[][] neighborhoods = []
    int candidates = 0
    int cells = int(len(index.cells))
    grid.Cell busiest = index.busiest()
    int[] sizes = [for grid.Cell cell = index.cells[] then int(len(cell.members))].sorted()
    int[] occupancy_sizes = unique_sorted(sizes)
    int[] occupancy_counts = []
    for int size = occupancy_sizes[]
        occupancy_counts = occupancy_counts.append(int(len([for int value = sizes[] if value == size then value])))
    local int[] brute = grid.brute_counts(points, radius)
    local int total = 0
    local int brute_total = 0
    bool consistent = true
    for int point < int(len(points))
        local grid.Neighborhood row = index.neighborhood(point)
        neighborhoods = neighborhoods.append(row.members)
        candidates += row.candidates
        total += int(len(row.members))
        brute_total += brute[point]
        if int(len(row.members)) != brute[point]
            consistent = false
    int pairs = (total - int(len(points))) / 2
    int brute_pairs = (brute_total - int(len(points))) / 2

    string[] lines()
        string[] occupancy = []
        for int position < int(len(occupancy_sizes))
            occupancy = occupancy.append("{occupancy_sizes[position]}:{occupancy_counts[position]}")
        return ["eps {radius} cells {cells} busiest {busiest.x} {busiest.y} {len(busiest.members)} candidates {candidates} pairs {pairs} brute_pairs {brute_pairs} " + check(consistent), "  occupancy " + occupancy.join(" ")]

class Setting(string name, string kind, int radius, int[] labels, bool[] core)
    int count = math.max_all(labels) + 1
    int[][] members = []
    for int label < count
        local int[] group = []
        for int point < int(len(labels))
            if labels[point] == label
                group = group.append(point)
        members = members.append(group)
    int noise = int(len([for int label = labels[] if label < 0 then label]))
    int core_count = 0
    for int point < int(len(labels))
        if labels[point] >= 0 and core[point]
            core_count += 1
    int border = int(len(labels)) - noise - core_count

Setting db_setting(string name, int radius, int[][] neighborhoods, int minimum)
    dbscan.Result result = dbscan.cluster(neighborhoods, minimum)
    return Setting(name, "dbscan", radius, result.labels, result.core)

dbscan.Result extract(optics.Ordering ordering, int[] core, int radius)
    int limit = radius * radius
    int[] labels = array(len(core), fill = -1)
    int number = -1
    for int point = ordering.points[]
        if ordering.reach[point] > limit
            if core[point] <= limit
                number += 1
                labels[point] = number
        else
            labels[point] = number
    return dbscan.Result(labels, [for int value = core[] then value <= limit])

class DownArea(int start, int finish, int high = 0)
class SteepArea(string kind, int start, int finish)
class XiCluster(int start, int finish)
    int size = finish - start + 1
    int label = -1
    int parent = -1
    int left = optics.infinity
    int right = optics.infinity
    int valley = optics.infinity

class Xi(int[] reach, data.Params params)
    int count = int(len(reach)) - 1
    int alpha = (params.v - params.u) * (params.v - params.u)
    int beta = params.v * params.v
    bool[] steep_up = []
    bool[] steep_down = []
    bool[] up = []
    bool[] down = []
    for int position < count
        local int current = reach[position]
        local int following = reach[position + 1]
        local bool defined = current != optics.infinity or following != optics.infinity
        steep_up = steep_up.append(defined and xle(current, following))
        steep_down = steep_down.append(defined and xle(following, current))
        up = up.append(current < following)
        down = down.append(current > following)
    SteepArea[] areas = []
    XiCluster[] clusters = []
    local DownArea[] down_areas = []
    local int index = 0
    local int mib = 0
    for int start < count
        if start < index or not (steep_up[start] or steep_down[start])
            continue
        for index <= int position <= start
            mib = math.max(mib, reach[position])
        local DownArea[] retained = []
        if mib != optics.infinity
            for DownArea area = down_areas[]
                if xle(mib, reach[area.start])
                    area.high = math.max(area.high, mib)
                    retained = retained.append(area)
        down_areas = retained
        if steep_down[start]
            local int finish = region_end(start, steep_down, up)
            areas = areas.append(SteepArea("down", start, finish))
            down_areas = down_areas.append(DownArea(start, finish))
            index = finish + 1
            mib = reach[index]
        else
            local int finish = region_end(start, steep_up, down)
            areas = areas.append(SteepArea("up", start, finish))
            index = finish + 1
            mib = reach[index]
            local XiCluster[] candidates = []
            for DownArea area = down_areas[]
                local int first = area.start
                local int last = finish
                if not xle(area.high, reach[last + 1])
                    continue
                local int top = reach[area.start]
                if xle(reach[last + 1], top)
                    while first < area.finish and reach[first + 1] > reach[last + 1]
                        first += 1
                elif xle(top, reach[last + 1])
                    while last > start and reach[last - 1] > top
                        last -= 1
                if last - first + 1 >= params.min_size and first <= area.finish and last >= start
                    candidates = candidates.append(XiCluster(first, last))
            clusters = clusters.concat(candidates[::-1])
    int[] labels = array(nat(count), fill = -1)
    local int next_label = 0
    for int number < int(len(clusters))
        local XiCluster &cluster = &clusters[number]
        local bool clear = true
        for cluster.start <= int position <= cluster.finish
            if labels[position] >= 0
                clear = false
        if clear
            cluster.label = next_label
            for cluster.start <= int position <= cluster.finish
                labels[position] = next_label
            next_label += 1
        cluster.left = reach[cluster.start]
        cluster.right = reach[cluster.finish + 1]
        for cluster.start + 1 <= int position <= cluster.finish
            cluster.valley = math.min(cluster.valley, reach[position])
    for int number < int(len(clusters))
        local XiCluster &cluster = &clusters[number]
        for int other < int(len(clusters))
            local XiCluster candidate = clusters[other]
            if other != number and candidate.start <= cluster.start and candidate.finish >= cluster.finish and (candidate.size > cluster.size or candidate.size == cluster.size and other > number)
                if cluster.parent < 0 or candidate.size < clusters[cluster.parent].size
                    cluster.parent = other

    bool xle(int first, int second)
        if second == optics.infinity
            return true
        if first == optics.infinity
            return false
        return beta * first <= alpha * second

    int region_end(int start, bool[] steep, bool[] reverse)
        int finish = start
        int flat = 0
        for start <= int position < count
            if steep[position]
                finish = position
                flat = 0
            elif reverse[position]
                break
            else
                flat += 1
                if flat > params.min_pts
                    break
        return finish

int turn(data.Point origin, data.Point first, data.Point second)
    return (first.x - origin.x) * (second.y - origin.y) - (first.y - origin.y) * (second.x - origin.x)

int[] hull_half(data.Point[] points, int[] ordered)
    int[] result = []
    for int point = ordered[]
        while len(result) >= 2 and turn(points[result[len(result) - 2]], points[result[len(result) - 1]], points[point]) <= 0
            result = result[0:<int(len(result)) - 1]
        result = result.append(point)
    return result

int[] convex_hull(data.Point[] points, int[] members)
    int[] ordered = []
    for int point = members[]
        int position = int(len(ordered))
        ordered = ordered.append(point)
        while position > 0 and (points[point].x < points[ordered[position - 1]].x or points[point].x == points[ordered[position - 1]].x and points[point].y < points[ordered[position - 1]].y)
            ordered[position] = ordered[position - 1]
            position -= 1
        ordered[position] = point
    if len(ordered) <= 2
        return ordered
    int[] lower = hull_half(points, ordered)
    int[] upper = hull_half(points, ordered[::-1])
    return lower[0:<int(len(lower)) - 1].concat(upper[0:<int(len(upper)) - 1])

string[] cluster_lines(data.Point[] points, Setting setting, int label)
    int[] members = setting.members[label]
    int size = int(len(members))
    int core_count = int(len([for int point = members[] if setting.core[point] then point]))
    int sx = math.sum([for int point = members[] then points[point].x])
    int sy = math.sum([for int point = members[] then points[point].y])
    int medoid = -1
    int best = 0
    for int point = members[]
        int dx = size * points[point].x - sx
        int dy = size * points[point].y - sy
        int value = dx * dx + dy * dy
        if medoid < 0 or value < best
            medoid = point
            best = value
    int xmin = math.min_all([for int point = members[] then points[point].x])
    int xmax = math.max_all([for int point = members[] then points[point].x])
    int ymin = math.min_all([for int point = members[] then points[point].y])
    int ymax = math.max_all([for int point = members[] then points[point].y])
    int area = (xmax - xmin + 1) * (ymax - ymin + 1)
    int[] hull = convex_hull(points, members)
    int doubled = 0
    int diameter = 0
    for int position < int(len(hull))
        data.Point first = points[hull[position]]
        data.Point second = points[hull[(position + 1) % int(len(hull))]]
        doubled += first.x * second.y - second.x * first.y
        for int other = hull[]
            diameter = math.max(diameter, grid.distance(first, points[other]))
    doubled = math.abs(doubled)
    string area_text = "{doubled / 2}." + (if doubled % 2 == 0 then "0" else "5")
    return ["cluster {label} " + label_char(label) + " size {size} core {core_count} border {size - core_count} centroid " + report.fraction(sx, size) + " " + report.fraction(sy, size) + " medoid {points[medoid].id}", "  bbox {xmin} {ymin} {xmax} {ymax} area {area} density " + report.fraction(size, area), "  hull {len(hull)} hull_area {area_text} diameter_sq {diameter} diameter " + root(diameter)]

int pair_count(int count)
    return count * (count - 1) / 2

int pair_sum(int[] labels)
    int result = 0
    for int label = unique_sorted(labels)[]
        result += pair_count(int(len([for int value = labels[] if value == label then value])))
    return result

string adjusted_rand(Setting first, Setting second)
    int same = 0
    for int a = unique_sorted(first.labels)[]
        for int b = unique_sorted(second.labels)[]
            int count = 0
            for int point < int(len(first.labels))
                if first.labels[point] == a and second.labels[point] == b
                    count += 1
            same += pair_count(count)
    int a_pairs = pair_sum(first.labels)
    int b_pairs = pair_sum(second.labels)
    int total = pair_count(int(len(first.labels)))
    int numerator = 2 * (total * same - a_pairs * b_pairs)
    int denominator = total * (a_pairs + b_pairs) - 2 * a_pairs * b_pairs
    return if denominator == 0 then report.ari(1, 1) else report.ari(numerator, denominator)

class Outlier(int point, int nearest, int distance)
class Plot(string[] rows, int knee_column)
class Analysis(data.Point[] points, data.Params params)
    int count = int(len(points))
    int k = params.min_pts - 1
    local int[][] neighbor_rows = []
    for int point < count
        local int[] values = []
        for int other < count
            if point != other
                values = values.append(grid.distance(points[point], points[other]))
        neighbor_rows = neighbor_rows.append(values.sorted())
    Curve[] curves = []
    for int rank < 2 * params.min_pts
        curves = curves.append(Curve([for int[] row = neighbor_rows[] then row[rank]]))
    Curve curve = curves[k - 1]
    int[] kdist = [for int[] row = neighbor_rows[] then row[k - 1]]
    int[] radii = unique_sorted(params.eps.concat([curve.eps, params.max_eps]))
    GridSummary[] grids = [for int radius = radii[] then GridSummary(points, radius)]
    Setting[] settings = []
    for int radius = params.eps[]
        settings = settings.append(db_setting("db{radius}", radius, neighborhoods(radius), params.min_pts))
    Setting knee = db_setting("knee{curve.eps}", curve.eps, neighborhoods(curve.eps), params.min_pts)
    settings = settings.append(knee)
    int[] core = optics.core_distances(points, neighborhoods(params.max_eps), params.min_pts)
    optics.Ordering ordering = optics.order(points, neighborhoods(params.max_eps), core)
    for int radius = params.extract[]
        local dbscan.Result result = extract(ordering, core, radius)
        settings = settings.append(Setting("op{radius}", "extract", radius, result.labels, result.core))
    int[] positions = [for int point = ordering.points[] then ordering.reach[point]].append(optics.infinity)
    Xi xi = Xi(positions, params)
    local int[] xi_labels = array(nat(count), fill = -1)
    for int position < count
        xi_labels[ordering.points[position]] = xi.labels[position]
    Setting xi_setting = Setting("xi", "xi", params.max_eps, xi_labels, [for int value = core[] then value != optics.infinity])
    settings = settings.append(xi_setting)
    local int xmin = math.min_all([for data.Point point = points[] then point.x])
    local int xmax = math.max_all([for data.Point point = points[] then point.x])
    local int ymin = math.min_all([for data.Point point = points[] then point.y])
    local int ymax = math.max_all([for data.Point point = points[] then point.y])
    int[] map_columns = [for data.Point point = points[] then (point.x - xmin) * params.width / (xmax - xmin + 1)]
    int[] map_rows = [for data.Point point = points[] then (ymax - point.y) * params.height / (ymax - ymin + 1)]

    int[][] neighborhoods(int radius)
        for GridSummary summary = grids[]
            if summary.radius == radius
                return summary.neighborhoods
        return []

    Setting[] db_settings()
        return [for Setting setting = settings[] if setting.kind == "dbscan" then setting]

    Setting[] extraction_settings()
        return [for Setting setting = settings[] if setting.kind == "extract" then setting]

    string[] labels_lines()
        string[] names = [for Setting setting = settings[] then setting.name]
        string[] lines = ["id," + names.join(",")]
        for int point < count
            string[] fields = ["{points[point].id}"].concat([for Setting setting = settings[] then "{setting.labels[point]}"])
            lines = lines.append(fields.join(","))
        return lines

    string[] optics_lines()
        string[] lines = ["order,id,core_sq,reach_sq,reach,predecessor"]
        for int position < count
            int point = ordering.points[position]
            int predecessor = ordering.predecessor[point]
            string prior = if predecessor < 0 then "-" else "{points[predecessor].id}"
            lines = lines.append("{position + 1},{points[point].id}," + value_text(core[point]) + "," + value_text(ordering.reach[point]) + "," + root(ordering.reach[point]) + "," + prior)
        return lines

    string[] kdist_lines()
        string[] lines = ["k_distance k {k} points {count}", "rank id kdist_sq kdist"]
        for int rank < count
            lines = lines.append("{rank + 1} {points[curve.order[rank]].id} {curve.values[rank]} " + root(curve.values[rank]))
        lines = lines.concat(["", "knee rank {curve.knee + 1} id {points[curve.order[curve.knee]].id} kdist_sq {curve.values[curve.knee]} kdist " + root(curve.values[curve.knee]) + " cross {curve.cross}", "suggested_eps {curve.eps}", "", "knee_table"])
        for int rank < int(len(curves))
            Curve row = curves[rank]
            lines = lines.append("k {rank + 1} rank {row.knee + 1} id {points[row.order[row.knee]].id} kdist_sq {row.values[row.knee]} eps {row.eps}")
        lines = lines.concat(["", "core_check"])
        for Setting setting = db_settings()[]
            int kd_count = int(len([for int value = kdist[] if value <= setting.radius * setting.radius then value]))
            int grid_count = int(len([for bool value = setting.core[] if value then value]))
            lines = lines.append("eps {setting.radius} core {kd_count} non_core {count - kd_count} grid_core {grid_count} " + check(kd_count == grid_count))
        int defined = 0
        bool consistent = true
        for int point < count
            if core[point] != optics.infinity
                defined += 1
                if core[point] != kdist[point]
                    consistent = false
        return lines.append("optics max_eps {params.max_eps} core {defined} " + check(consistent))

    string[] grid_lines()
        string[] lines = ["grid"]
        for GridSummary summary = grids[]
            lines = lines.concat(summary.lines())
        return lines

    string[] check_lines(Setting setting)
        bool linked = true
        bool supported = true
        bool separated = true
        int isolated = 0
        string[] ambiguous = []
        int[][] neighbors = neighborhoods(setting.radius)
        for int point < count
            int label = setting.labels[point]
            int[] core_labels = unique_sorted([for int other = neighbors[point][] if setting.core[other] then setting.labels[other]])
            if setting.core[point]
                for int other = core_labels[]
                    if other != label
                        linked = false
            elif label >= 0
                bool found = false
                int[] others = []
                for int other = core_labels[]
                    if other == label
                        found = true
                    else
                        others = others.append(other)
                if not found
                    supported = false
                if len(others) > 0
                    ambiguous = ambiguous.append("  {points[point].id} cluster {label} also " + joined(others))
            else
                if len(core_labels) > 0
                    separated = false
                if len(neighbors[point]) == 1
                    isolated += 1
        return ["check " + condition(linked) + " " + condition(supported) + " " + condition(separated), "isolated {isolated}", "ambiguous {len(ambiguous)}"].concat(ambiguous)

    string[] setting_lines(Setting setting)
        string[] lines = ["setting {setting.name} eps {setting.radius} clusters {setting.count} noise {setting.noise} core {setting.core_count} border {setting.border}"]
        for int label < setting.count
            lines = lines.concat(cluster_lines(points, setting, label))
        if setting.kind == "dbscan"
            lines = lines.concat(check_lines(setting))
        return lines

    string[] hierarchy_lines()
        Setting[] values = db_settings()
        int[] order = []
        for int index < int(len(values))
            int position = int(len(order))
            order = order.append(index)
            while position > 0 and values[index].radius < values[order[position - 1]].radius
                order[position] = order[position - 1]
                position -= 1
            order[position] = index
        string[] lines = ["hierarchy"]
        for int pair < int(len(order)) - 1
            Setting smaller = values[order[pair]]
            Setting larger = values[order[pair + 1]]
            int[][] sources = []
            for _ < larger.count
                sources = sources.append([])
            for int label < smaller.count
                for int point = smaller.members[label][]
                    if smaller.core[point]
                        int destination = larger.labels[point]
                        sources[destination] = sources[destination].append(label)
                        break
            lines = lines.append("{smaller.name} -> {larger.name}")
            for int label < larger.count
                string clusters = if len(sources[label]) == 0 then "-" else joined(sources[label])
                lines = lines.append("  {label} <- " + clusters)
        return lines

    string[] comparison_lines()
        string[] lines = ["optics_vs_dbscan"]
        for Setting extracted = extraction_settings()[]
            int reference = -1
            for int index < int(len(settings))
                if settings[index].kind == "dbscan" and settings[index].radius == extracted.radius
                    reference = index
                    break
            if reference < 0
                continue
            Setting original = settings[reference]
            int[] mapping = array(nat(extracted.count), fill = -1)
            int[] reverse = array(nat(original.count), fill = -1)
            bool same = true
            int border_as_noise = 0
            for int point < count
                int first = extracted.labels[point]
                int second = original.labels[point]
                if extracted.core[point]
                    if mapping[first] >= 0 and mapping[first] != second or reverse[second] >= 0 and reverse[second] != first
                        same = false
                    mapping[first] = second
                    reverse[second] = first
                if first < 0 and second >= 0
                    border_as_noise += 1
            string moved = "-"
            if same
                int changed = 0
                for int point < count
                    if extracted.labels[point] >= 0 and mapping[extracted.labels[point]] != original.labels[point]
                        changed += 1
                moved = "{changed}"
            string partition = if same then "same" else "different"
            lines = lines.append("{extracted.name} {original.name} core_partition {partition} border_as_noise {border_as_noise} moved {moved}")
        return lines

    string[] optics_summary()
        int[] components = []
        for int point = ordering.points[]
            if ordering.reach[point] == optics.infinity
                components = components.append(0)
            components[len(components) - 1] += 1
        int defined = int(len([for int value = core[] if value != optics.infinity then value]))
        int singletons = int(len([for int value = components[] if value == 1 then value]))
        int largest = math.max_all(components)
        return ["optics max_eps {params.max_eps} core {defined} components {len(components)} singletons {singletons} largest {largest}"]

    string[] sweep_lines()
        string[] lines = ["sweep max_eps {params.max_eps}", "eps clusters noise largest"]
        int[] counts = []
        for 1 <= int radius <= params.max_eps
            dbscan.Result result = extract(ordering, core, radius)
            Setting setting = Setting("", "", radius, result.labels, result.core)
            int largest = 0
            for int[] members = setting.members[]
                largest = math.max(largest, int(len(members)))
            counts = counts.append(setting.count)
            lines = lines.append("{radius} {setting.count} {setting.noise} {largest}")
        int first = 0
        int best_start = -1
        int best_end = -1
        for int radius < params.max_eps
            if radius < params.max_eps - 1 and counts[radius + 1] == counts[first]
                continue
            if counts[first] >= 2 and (best_start < 0 or radius - first > best_end - best_start)
                best_start = first
                best_end = radius
            first = radius + 1
        return lines.append(if best_start < 0 then "stable -" else "stable clusters {counts[best_start]} eps {best_start + 1} {best_end + 1} length {best_end - best_start + 1}")

    string[] xi_lines()
        string[] lines = ["xi {params.xi_text} min_size {params.min_size} steep_areas {len(xi.areas)}"]
        for SteepArea area = xi.areas[]
            lines = lines.append("{area.kind} {area.start + 1} {area.finish + 1}")
        lines = lines.append("xi_clusters {len(xi.clusters)}")
        for int number < int(len(xi.clusters))
            XiCluster cluster = xi.clusters[number]
            lines = lines.append("{number} start {cluster.start + 1} end {cluster.finish + 1} size {cluster.size} label " + optional(cluster.label) + " parent " + optional(cluster.parent) + " walls " + root(cluster.left) + " " + root(cluster.right) + " valley " + root(cluster.valley))
        return lines

    string[] outlier_lines()
        Outlier[] values = []
        for int point < count
            if knee.labels[point] >= 0
                continue
            int nearest = -1
            int best = optics.infinity
            for int other < count
                if knee.core[other]
                    int distance = grid.distance(points[point], points[other])
                    if distance < best
                        best = distance
                        nearest = other
            Outlier value = Outlier(point, nearest, best)
            int position = int(len(values))
            values = values.append(value)
            while position > 0 and value.distance > values[position - 1].distance
                values[position] = values[position - 1]
                position -= 1
            values[position] = value
        string[] lines = ["outliers {knee.name} count {len(values)}"]
        for Outlier value = values[]
            lines = lines.append("{points[value.point].id} nearest_core {points[value.nearest].id} cluster {knee.labels[value.nearest]} dist_sq {value.distance} dist " + root(value.distance))
        return lines

    string[] gap_lines()
        string[] lines = ["gaps {knee.name}"]
        for int first < knee.count
            for first + 1 <= int second < knee.count
                int best = optics.infinity
                int a = -1
                int b = -1
                for int point = knee.members[first][]
                    for int other = knee.members[second][]
                        int distance = grid.distance(points[point], points[other])
                        if distance < best
                            best = distance
                            a = point
                            b = other
                lines = lines.append("{first} {second} dist_sq {best} dist " + root(best) + " between {points[a].id} {points[b].id}")
        return lines

    string[] contingency_lines()
        int[][] table = []
        for _ < knee.count + 1
            table = table.append(array(nat(xi_setting.count + 1), fill = 0))
        for int point < count
            table[knee.labels[point] + 1][xi_setting.labels[point] + 1] += 1
        string[] lines = ["contingency {knee.name} xi", "columns " + joined(-1:<xi_setting.count)]
        for -1 <= int row < knee.count
            lines = lines.append("{row} " + joined(table[row + 1]))
        for int column < xi_setting.count
            int shared = -1
            int matched = 0
            for int row < knee.count
                if table[row + 1][column + 1] > shared
                    shared = table[row + 1][column + 1]
                    matched = row
            int union = int(len(knee.members[matched])) + int(len(xi_setting.members[column])) - shared
            lines = lines.append("match {column} {matched} shared {shared} jaccard " + report.fraction(shared, union))
        return lines

    string[] ari_lines()
        string[] lines = ["ari"]
        for int first < int(len(settings))
            for first + 1 <= int second < int(len(settings))
                lines = lines.append("{settings[first].name} {settings[second].name} " + adjusted_rand(settings[first], settings[second]))
        return lines

    string[] clusters_lines()
        string[][] parts = [["points {count} min_pts {params.min_pts}", "settings " + [for Setting setting = settings[] then setting.name].join(" ")], grid_lines()]
        for Setting setting = settings[]
            parts = parts.append(setting_lines(setting))
        parts = parts.concat([hierarchy_lines(), comparison_lines(), optics_summary(), sweep_lines(), xi_lines(), outlier_lines(), gap_lines(), contingency_lines(), ari_lines()])
        string[] lines = []
        for int position < int(len(parts))
            if position > 0
                lines = lines.append("")
            lines = lines.concat(parts[position])
        return lines

    int[] cell_members(int column, int row)
        int[] members = []
        for int point < count
            if map_columns[point] == column and map_rows[point] == row
                members = members.append(point)
        return members

    string[] cluster_map(Setting setting)
        string[] rows = []
        for int row < params.height
            string[] characters = []
            for int column < params.width
                int[] members = cell_members(column, row)
                int[] labels = unique_sorted([for int point = members[] if setting.labels[point] >= 0 then setting.labels[point]])
                string character = if len(members) == 0 then " " elif len(labels) == 0 then "." elif len(labels) == 1 then label_char(labels[0]) else "*"
                characters = characters.append(character)
            rows = rows.append(characters.join(""))
        return rows

    string[] kind_map()
        string[] rows = []
        for int row < params.height
            string[] characters = []
            for int column < params.width
                string character = " "
                for int point = cell_members(column, row)[]
                    if knee.core[point]
                        character = "#"
                    elif character != "#" and knee.labels[point] >= 0
                        character = "+"
                    elif character == " "
                        character = "."
                characters = characters.append(character)
            rows = rows.append(characters.join(""))
        return rows

    Plot kdist_plot()
        int[] heights = []
        int knee_column = 0
        for int column < params.k_width
            int first = column * count / params.k_width
            int last = (column + 1) * count / params.k_width
            heights = heights.append(integer_root(params.k_height * params.k_height * curve.values[first] / curve.values[0]))
            if first <= curve.knee < last
                knee_column = column
        string[] rows = []
        for int row < params.k_height
            string[] characters = []
            for int column < params.k_width
                characters = characters.append(if params.k_height - row <= heights[column] then "#" elif column == knee_column then ":" else " ")
            rows = rows.append(characters.join(""))
        return Plot(rows, knee_column)

    string[] reachability_lines()
        int top = math.max_all([for int value = positions[] if value != optics.infinity then value])
        Setting[] columns = extraction_settings().append(xi_setting)
        string[] names = [for Setting setting = columns[] then setting.name]
        string[] lines = ["reachability width {params.plot_width} max_reach " + root(top) + " columns " + names.join(" ")]
        for int position < count
            int point = ordering.points[position]
            int reach = ordering.reach[point]
            string bar = if reach == optics.infinity then string.repeat("-", nat(params.plot_width)) else string.repeat("#", nat(integer_root(params.plot_width * params.plot_width * reach / top)))
            string characters = [for Setting setting = columns[] then label_char(setting.labels[point])].join("")
            lines = lines.append(pad_left("{position + 1}", 4) + " " + pad_left("{points[point].id}", 5) + " " + pad_left(root(reach), 7) + " " + characters + " |" + bar)
        return lines

    string[] maps_lines()
        string[] lines = []
        for Setting setting = settings[]
            lines = lines.append("map {setting.name} clusters {setting.count} noise {setting.noise}")
            lines = lines.concat(report.framed(cluster_map(setting), params.width))
            string[] legend = []
            for int label < setting.count
                legend = legend.append(label_char(label) + "={len(setting.members[label])}")
            lines = lines.concat(["legend " + (if len(legend) == 0 then "-" else legend.join(" ")), ""])
        lines = lines.append("kinds {knee.name}")
        lines = lines.concat(report.framed(kind_map(), params.width)).append("")
        Plot plot = kdist_plot()
        lines = lines.append("kdist_plot k {k} max " + root(curve.values[0]) + " knee_column {plot.knee_column + 1}")
        lines = lines.concat(report.framed(plot.rows, params.k_width)).append("")
        return lines.concat(reachability_lines())

string pad_left(string value, int width)
    return string.repeat(" ", nat(math.max(0, width - int(len(value))))) + value

data.Point[] points = data.read_points()
data.Params params = data.read_params()
Analysis analysis = Analysis(points, params)
if not file.is_directory("output")
    file.mkdir("output")
report.write_lines("labels.csv", analysis.labels_lines())
report.write_lines("optics_order.csv", analysis.optics_lines())
report.write_lines("kdist.txt", analysis.kdist_lines())
report.write_lines("clusters.txt", analysis.clusters_lines())
report.write_lines("maps.txt", analysis.maps_lines())
