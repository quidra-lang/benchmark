import data = "./dataset.qui"

int distance(data.Point first, data.Point second)
    int dx = first.x - second.x
    int dy = first.y - second.y
    return dx * dx + dy * dy

class Cell(int x, int y, int[] members)
class Neighborhood(int[] members, int candidates)

string cell_key(int x, int y)
    return "{x},{y}"

int lookup(map.Map<string, int> positions, string key)
    match positions.get(key)
        int value
            return value
        none
            return -1

class Grid(data.Point[] points, int radius)
    Cell[] cells = []
    map.Map<string, int> positions = map.Map<string, int>()
    for int index < int(len(points))
        local data.Point point = points[index]
        local int x = point.x / radius
        local int y = point.y / radius
        local string key = cell_key(x, y)
        local int position = lookup(positions, key)
        if position < 0
            position = int(len(cells))
            .positions.set(key, position)
            cells = cells.append(Cell(x, y, []))
        cells[position].members = cells[position].members.append(index)

    Neighborhood neighborhood(int index)
        data.Point point = points[index]
        int x = point.x / radius
        int y = point.y / radius
        int[] members = []
        int candidates = 0
        for y - 1 <= int gy <= y + 1
            for x - 1 <= int gx <= x + 1
                int position = lookup(positions, cell_key(gx, gy))
                if position >= 0
                    for int other = cells[position].members[]
                        candidates += 1
                        if distance(point, points[other]) <= radius * radius
                            members = members.append(other)
        return Neighborhood(members, candidates)

    Cell busiest()
        Cell best = cells[0]
        for Cell cell = cells[]
            if len(cell.members) > len(best.members) or len(cell.members) == len(best.members) and (cell.y < best.y or cell.y == best.y and cell.x < best.x)
                best = cell
        return best

int[] brute_counts(data.Point[] points, int radius)
    int[] counts = []
    for data.Point point = points[]
        int count = 0
        for data.Point other = points[]
            if distance(point, other) <= radius * radius
                count += 1
        counts = counts.append(count)
    return counts
