import math

real64 square_root(real64 value)
    real64 result = math.sqrt(value)
    return result

real64 as_real(int value)
    real64 converted = real64(value)
    return converted

string fraction(int numerator, int denominator)
    int a = math.abs(numerator)
    int b = denominator
    while b != 0
        int remainder = a % b
        a = b
        b = remainder
    return "{numerator / a}/{denominator / a}"

string root(int value)
    real64 result = square_root(as_real(int(value)))
    return "{result:frac=3}"

string ari(int numerator, int denominator)
    real64 value = as_real(int(numerator)) / as_real(int(denominator))
    string formatted = "{value:frac=4}"
    if formatted == "-0.0000"
        formatted = "0.0000"
    return fraction(numerator, denominator) + " " + formatted

string[] framed(string[] rows, int width)
    string border = "+" + string.repeat("-", nat(width)) + "+"
    return [border].concat([for string row = rows[] then "|" + row + "|"]).append(border)

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
