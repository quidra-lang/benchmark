
class Point(int id, int x, int y)

class Params(local string[][] rows)
    int[] eps = [for string value = rows[0][1:][] then int.parse(value)]
    int min_pts = int.parse(rows[1][1])
    int max_eps = int.parse(rows[2][1])
    int[] extract = [for string value = rows[3][1:][] then int.parse(value)]
    string xi_text = rows[4][1]
    local string[] ratio = xi_text.split("/")
    int u = int.parse(ratio[0])
    int v = int.parse(ratio[1])
    int min_size = int.parse(rows[5][1])
    int width = int.parse(rows[6][1])
    int height = int.parse(rows[6][2])
    int k_width = int.parse(rows[7][1])
    int k_height = int.parse(rows[7][2])
    int plot_width = int.parse(rows[8][1])

string[] lines(string path)
    string[] values = file.read(path).split(NL)
    return values[0:<int(len(values)) - 1]

Point[] read_points()
    Point[] points = []
    for string line = lines("input/points.csv")[1:][]
        int[] row = [for string field = line.split(",")[] then int.parse(field)]
        points = points.append(Point(row[0], row[1], row[2]))
    int[] ids = [for Point point = points[] then point.id].sorted()
    Point[] result = []
    for int id = ids[]
        for Point point = points[]
            if point.id == id
                result = result.append(point)
                break
    return result

Params read_params()
    return Params([for string line = lines("input/params.txt")[] then line.split(" ")])
