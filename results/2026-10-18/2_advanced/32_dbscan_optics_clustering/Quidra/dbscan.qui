class Result(int[] labels, bool[] core)

Result cluster(int[][] neighborhoods, int minimum)
    bool[] core = [for int[] row = neighborhoods[] then int(len(row)) >= minimum]
    int[] labels = array(len(neighborhoods), fill = -2)
    int number = 0
    for int index < int(len(neighborhoods))
        if labels[index] != -2
            continue
        if not core[index]
            labels[index] = -1
            continue
        labels[index] = number
        int[] queue = neighborhoods[index]
        int head = 0
        while head < int(len(queue))
            int other = queue[head]
            head += 1
            if labels[other] == -1
                labels[other] = number
            elif labels[other] == -2
                labels[other] = number
                if core[other]
                    queue = queue.concat(neighborhoods[other])
        number += 1
    return Result(labels, core)
