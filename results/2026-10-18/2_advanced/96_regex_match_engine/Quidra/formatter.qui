class Instruction(string kind, int argument = 0, int second = 0, string mode = "", bool[] members = [], bool negated = false)

string text_character(int code)
    if code == 9
        return HT
    if code == 10
        return NL
    const string printable = " !{DQ}#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{{|}}~"
    return printable[code - 32]

string character(int code)
    if 33 <= code <= 126 and code != 92 and code != 93 and code != 94 and code != 45
        return text_character(code)
    string digits = "0123456789ABCDEF"
    return "\x" + digits[code / 16] + digits[code % 16]

string set_text(const bool[] members, bool negated = false)
    string result = if negated then "[^" else "["
    int cursor = 0
    while cursor < 128
        if not members[cursor]
            cursor += 1
            continue
        int finish = cursor
        while finish + 1 < 128 and members[finish + 1]
            finish += 1
        result += character(cursor)
        if finish > cursor
            if finish - cursor >= 2
                result += "-"
            result += character(finish)
        cursor = finish + 1
    return result + "]"

string instruction_text(const Instruction entry)
    if entry.kind == "CHAR"
        return "CHAR " + character(entry.argument)
    if entry.kind == "CLASS"
        return "CLASS " + set_text(entry.members, entry.negated)
    if entry.kind == "SPLIT"
        return "SPLIT {entry.argument}, {entry.second}"
    if entry.kind == "JMP" or entry.kind == "SAVE" or entry.kind == "BACKREF"
        return "{entry.kind} {entry.argument}"
    if entry.kind == "ASSERT"
        return "ASSERT {entry.mode}"
    if entry.kind == "LOOK"
        return "LOOK {entry.mode} {entry.argument}"
    return entry.kind

string quote(const int[] codes)
    string result = DQ
    for int code = codes[]
        if code == 92
            result += "\\"
        elif code == 34
            result += "\" + DQ
        elif code == 10
            result += "\n"
        elif code == 9
            result += "\t"
        else
            result += text_character(code)
    return result + DQ
