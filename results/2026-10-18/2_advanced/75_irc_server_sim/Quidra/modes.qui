import protocol = "./protocol.qui"

class Item(string sign, string character, bool present := false, string argument := "")

Item[] channel_items(string mode, string[] arguments)
    Item[] items := []
    sign := "+"
    int position := 0
    for int index < int(len(mode))
        string character := mode[index]
        if character == "+" or character == "-"
            sign = character
            continue
        present := false
        argument := ""
        if "ovbk".contains(character) or (character == "l" and sign == "+")
            if position < int(len(arguments))
                argument = arguments[position]
                present = true
                position += 1
        if character == "k" and sign == "-"
            present = true
            argument = "*"
        elif character == "l" and sign == "+"
            if not present or not protocol.digits(argument) or len(argument) > 4 or int.parse(argument) < 1
                present = false
        items = items.append(Item(sign, character, present, argument))
    return items

string change_string(Item[] changes)
    result := ""
    previous := ""
    string[] arguments := []
    for Item change := changes[]
        if change.sign != previous
            result += change.sign
            previous = change.sign
        result += change.character
        if change.present
            arguments = arguments.append(change.argument)
    return result + (if len(arguments) == 0 then "" else " " + arguments.join(" "))
