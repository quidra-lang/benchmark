import protocol = "./protocol.qui"

bool matches(string mask, string text)
    string pattern := protocol.fold(mask)
    string value := protocol.fold(text)
    int position := 0
    int cursor := 0
    int star := -1
    int restart := 0
    while position < int(len(value))
        if cursor < int(len(pattern)) and pattern[cursor] == "*"
            star = cursor
            cursor += 1
            restart = position
        elif cursor < int(len(pattern)) and (pattern[cursor] == "?" or pattern[cursor] == value[position])
            cursor += 1
            position += 1
        elif star >= 0
            restart += 1
            position = restart
            cursor = star + 1
        else
            return false
    while cursor < int(len(pattern)) and pattern[cursor] == "*"
        cursor += 1
    return cursor == int(len(pattern))

string normalize(string argument)
    if argument.contains("!") and argument.contains("@")
        return argument
    if argument.contains("@")
        return "*!" + argument
    if argument.contains("!")
        return argument + "@*"
    if argument.contains(".")
        return "*!*@" + argument
    return argument + "!*@*"
