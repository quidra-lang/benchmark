import protocol = "./protocol.qui"

bool matches(string mask, string text)
    pattern := protocol.fold(mask)
    value := protocol.fold(text)
    position := 0
    cursor := 0
    star := -1
    restart := 0
    while position < int(value.len())
        if cursor < int(pattern.len()) and pattern[cursor] == "*"
            star = cursor
            cursor += 1
            restart = position
        elif cursor < int(pattern.len()) and (pattern[cursor] == "?" or pattern[cursor] == value[position])
            cursor += 1
            position += 1
        elif star >= 0
            restart += 1
            position = restart
            cursor = star + 1
        else
            return false
    while cursor < int(pattern.len()) and pattern[cursor] == "*"
        cursor += 1
    return cursor == int(pattern.len())

string normalize(string argument)
    if argument.contains("!") and argument.contains("@")
        return argument
    if argument.contains("@")
        return "*!" + argument
    if argument.contains("!")
        return argument + "@*"
    if argument.contains(".")
        return "*!*@" + argument
    return argument + "!*@*"
