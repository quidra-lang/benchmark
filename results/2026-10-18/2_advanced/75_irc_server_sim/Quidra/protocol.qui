class Message(string command, string[] parameters)

string letters()
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

string fold(string value)
    string result := ""
    string lower := value.lower_ascii()
    for int i < int(len(lower))
        string c := lower[i]
        result += if c == "[" then "{{" elif c == "]" then "}}" elif c == "\" then "|" elif c == "^" then "~" else c
    return result

bool digits(string value)
    if len(value) == 0
        return false
    for int i < int(len(value))
        if not "0123456789".contains(value[i])
            return false
    return true

bool valid_nickname(string value)
    string first := letters() + "[]\`_^{{|}}"
    string rest := first + "0123456789-"
    if len(value) == 0 or not first.contains(value[0])
        return false
    for 1 <= int i < int(len(value))
        if not rest.contains(value[i])
            return false
    return true

bool valid_channel(string value, int maximum)
    return len(value) >= 2 and int(len(value)) <= maximum and value.starts_with("#") and not value.contains(":")

Message parse(string raw)
    int position := 0
    if raw.starts_with(":")
        while position < int(len(raw)) and raw[position] != " "
            position += 1
    while position < int(len(raw)) and raw[position] == " "
        position += 1
    int first := position
    while position < int(len(raw)) and raw[position] != " "
        position += 1
    string command := raw[first:<position].upper_ascii()
    string[] parameters := []
    while position < int(len(raw))
        while position < int(len(raw)) and raw[position] == " "
            position += 1
        if position == int(len(raw))
            break
        if raw[position] == ":"
            parameters = parameters.append(raw[position + 1:])
            break
        if len(parameters) == 14
            parameters = parameters.append(raw[position:])
            break
        first = position
        while position < int(len(raw)) and raw[position] != " "
            position += 1
        parameters = parameters.append(raw[first:<position])
    return Message(command, parameters)
