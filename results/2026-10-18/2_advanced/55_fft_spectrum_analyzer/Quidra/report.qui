import math

string decimal(real64 value)
    real64 absolute = if value < 0.0 then -value else value
    int rounded = math.floor(absolute * 10000.0 + 0.5)
    string sign = if value < 0.0 and rounded != 0 then "-" else ""
    string tail = (rounded % 10000).string()
    return sign + (rounded / 10000).string() + "." + string.repeat("0", nat(4 - int(len(tail)))) + tail

void write_lines(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)

void csv(string name, string header, string[][] rows)
    write_lines(name, [header].concat([for string[] row = rows[] then row.join(",")]))

string[] shades(real64[][] grid, int sample_rate, int length, int band_db, real64 maximum)
    const string levels = " .:-=+*#%@"
    string[] rows = []
    int k = length / 2
    while k >= 0
        string pixels = ""
        for real64[] frame = grid[]
            real64 logarithm = math.log(frame[k] / maximum)
            real64 d = 20.0 * logarithm / 2.302585092994046
            int loss = math.floor(-d / real64(band_db))
            int level = if 9 - loss < 0 then 0 else 9 - loss
            pixels += levels[level]
        string frequency = decimal(real64(k * sample_rate) / real64(length))
        int padding = if int(len(frequency)) < 9 then 9 - int(len(frequency)) else 0
        rows = rows.append(string.repeat(" ", nat(padding)) + frequency + " |" + pixels + "|")
        k -= 1
    return rows
