import math

const real64 pi = 3.141592653589793

com64 conjugate(com64 value)
    return com64(value.real) - com64(value.imag) * com64(1.0i)

real64 magnitude(com64 value)
    real64 result = math.sqrt(value.real * value.real + value.imag * value.imag)
    return result

com64 rot(real64 angle)
    real64 cosine = math.cos(angle)
    real64 sine = math.sin(angle)
    return com64(cosine) - com64(sine) * com64(1.0i)

int pow2(int value)
    int result = 1
    while result < value
        result *= 2
    return result

com64[] zeros(int count)
    return [for int j < count then com64(0.0)]

com64[] complex_values(real64[] source, int length = 0)
    int count = if length == 0 then int(len(source)) else length
    com64[] result = zeros(count)
    for int j < int(len(source))
        result[j] = com64(source[j])
    return result

com64[] radix2(com64[] source, bool inverse = false)
    int count = int(len(source))
    com64[] values = source
    int bits = 0
    int power = count
    while power > 1
        bits += 1
        power /= 2
    for 1 <= int index < count
        int reversed = 0
        int rest = index
        for int bit < bits
            reversed = reversed * 2 + rest % 2
            rest /= 2
        if index < reversed
            com64 temporary = values[index]
            values[index] = values[reversed]
            values[reversed] = temporary
    com64[] twiddle = []
    for int k < count / 2
        com64 factor = rot(2.0 * pi * real64(k) / real64(count))
        twiddle = twiddle.append(if inverse then conjugate(factor) else factor)
    int size = 2
    while size <= count
        int stride = count / size
        int half = size / 2
        for int start < count step size
            for int j < half
                com64 t = twiddle[j * stride] * values[start + j + half]
                com64 u = values[start + j]
                values[start + j] = u + t
                values[start + j + half] = u - t
        size *= 2
    if inverse
        for auto &value = &values[]
            value /= com64(real64(count))
    return values

com64[] bluestein(com64[] values)
    int count = int(len(values))
    int size = pow2(2 * count - 1)
    com64[] chirp = [for int k < count then rot(pi * real64((k * k) % (2 * count)) / real64(count))]
    com64[] a = zeros(size)
    com64[] b = zeros(size)
    for int k < count
        a[k] = values[k] * chirp[k]
        b[k] = conjugate(chirp[k])
        if k > 0
            b[size - k] = b[k]
    com64[] af = radix2(a)
    com64[] bf = radix2(b)
    com64[] product = [for int k < size then af[k] * bf[k]]
    com64[] convolved = radix2(product, true)
    return [for int k < count then chirp[k] * convolved[k]]

com64[] dft(com64[] values)
    return if pow2(int(len(values))) == int(len(values)) then radix2(values) else bluestein(values)

com64[] idft(com64[] values)
    int count = int(len(values))
    if pow2(count) == count
        return radix2(values, true)
    com64[] conjugates = [for com64 value = values[] then conjugate(value)]
    return [for com64 value = bluestein(conjugates)[] then conjugate(value) / com64(real64(count))]

com64[] packed_real(real64[] values)
    int count = int(len(values))
    int half = count / 2
    com64[] z = [for int j < half then com64(values[2 * j]) + com64(values[2 * j + 1]) * com64(1.0i)]
    com64[] transformed = radix2(z)
    com64[] result = []
    for int k <= half
        int opposite = (half - k) % half
        if opposite < 0
            opposite += half
        com64 a = transformed[k % half]
        com64 b = conjugate(transformed[opposite])
        com64 even = (a + b) / com64(2.0)
        com64 odd = (a - b) / com64(2.0i)
        result = result.append(even + rot(2.0 * pi * real64(k) / real64(count)) * odd)
    return result

real64[] convolution(real64[] first, real64[] second)
    int count = int(len(first)) + int(len(second)) - 1
    int size = pow2(count)
    com64[] af = radix2(complex_values(first, size))
    com64[] bf = radix2(complex_values(second, size))
    com64[] product = [for int k < size then af[k] * bf[k]]
    com64[] inverse = radix2(product, true)
    return [for int j < count then inverse[j].real]

com64[] chirp_z(real64[] values, int sample_rate, int low, int high, int points)
    int count = int(len(values))
    real64 step = real64(high - low) / real64(points - 1)
    real64 fs = real64(sample_rate)
    int size = pow2(count + points - 1)
    com64[] a = zeros(size)
    com64[] b = zeros(size)
    for int n < count
        a[n] = com64(values[n]) * rot(2.0 * pi * real64(low) * real64(n) / fs) * rot(pi * step * real64(n) * real64(n) / fs)
    for -(count - 1) <= int offset < points
        int index = if offset < 0 then offset + size else offset
        b[index] = conjugate(rot(pi * step * real64(offset) * real64(offset) / fs))
    com64[] af = radix2(a)
    com64[] bf = radix2(b)
    com64[] product = [for int k < size then af[k] * bf[k]]
    com64[] g = radix2(product, true)
    return [for int j < points then rot(pi * step * real64(j) * real64(j) / fs) * g[j]]
