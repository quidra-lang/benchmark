import math
import fft = "./fft.qui"
import windows = "./windows.qui"

real64 median(real64[] values)
    real64[] ordered = values.sorted()
    int middle = int(len(ordered)) / 2
    return if int(len(ordered)) % 2 == 1 then ordered[middle] else (ordered[middle - 1] + ordered[middle]) / 2.0

bool local_maximum(real64[] values, int index)
    return 0 < index < int(len(values)) - 1 and values[index] > values[index - 1] and values[index] > values[index + 1]

real64[] interpolate(real64[] values, int index, bool logarithmic = true)
    if not local_maximum(values, index)
        return [real64(index), values[index]]
    real64 a = values[index - 1]
    real64 b = values[index]
    real64 c = values[index + 1]
    if logarithmic
        a = math.log(a)
        b = math.log(b)
        c = math.log(c)
    real64 delta = (a - c) / (2.0 * (a - 2.0 * b + c))
    real64 fitted = b - (a - c) * delta / 4.0
    if logarithmic
        fitted = math.exp(fitted)
    return [real64(index) + delta, fitted]

(real64[], com64[], real64[]) amplitude(real64[] signal, string name, int length)
    real64[] weights = windows.window(name, length)
    real64[] weighted = []
    real64 s1 = 0.0
    for int j < length
        weighted = weighted.append(signal[j] * weights[j])
        s1 += weights[j]
    com64[] transformed = fft.dft(fft.complex_values(weighted))
    real64[] amplitudes = []
    for int k <= length / 2
        real64 factor = if k == 0 or 2 * k == length then 1.0 else 2.0
        amplitudes = amplitudes.append(factor * fft.magnitude(transformed[k]) / s1)
    return (weighted, transformed, amplitudes)

(com64[], real64) packed_and_error(real64[] samples)
    com64[] packed = fft.packed_real(samples)
    com64[] reference = fft.radix2(fft.complex_values(samples))
    real64 error_value = 0.0
    for int k < int(len(packed))
        real64 difference = fft.magnitude(packed[k] - reference[k])
        if difference > error_value
            error_value = difference
    return (packed, error_value)

class Welch(int segments, real64[] psd, real64[] coherence, com64[] transfer, real64 packing_error)

Welch welch(real64[] first, real64[] second, int sample_rate, int length, string name)
    real64[] weights = windows.window(name, length)
    real64 energy = 0.0
    for real64 value = weights[]
        energy += value * value
    int segments = (int(len(first)) - length) / (length / 2) + 1
    int count = length / 2 + 1
    real64[] pxx = [for int k < count then 0.0]
    real64[] pyy = pxx
    com64[] pxy = fft.zeros(count)
    real64 packing_error = 0.0
    for int block < segments
        int start = block * (length / 2)
        real64[] a = [for int j < length then first[start + j] * weights[j]]
        real64[] b = [for int j < length then second[start + j] * weights[j]]
        (com64[] af, real64 ae) = packed_and_error(a)
        (com64[] bf, real64 be) = packed_and_error(b)
        if ae > packing_error
            packing_error = ae
        if be > packing_error
            packing_error = be
        for int k < count
            real64 ax = fft.magnitude(af[k])
            real64 ay = fft.magnitude(bf[k])
            pxx[k] += ax * ax
            pyy[k] += ay * ay
            pxy[k] += fft.conjugate(af[k]) * bf[k]
    real64[] psd = []
    real64[] coherence = []
    com64[] transfer = []
    for int k < count
        real64 factor = if k == 0 or k == length / 2 then 1.0 else 2.0
        real64 magnitude = fft.magnitude(pxy[k])
        psd = psd.append(factor * pxx[k] / (real64(segments) * real64(sample_rate) * energy))
        coherence = coherence.append(magnitude * magnitude / (pxx[k] * pyy[k]))
        transfer = transfer.append(pxy[k] / com64(pxx[k]))
    return Welch(segments, psd, coherence, transfer, packing_error)

(real64[][], real64) spectrogram(real64[] signal, int length, int hop, string name)
    real64[] weights = windows.window(name, length)
    int frames = (int(len(signal)) - length) / hop + 1
    real64[][] grid = []
    real64 maximum_error = 0.0
    for int frame < frames
        real64[] samples = [for int j < length then signal[frame * hop + j] * weights[j]]
        (com64[] transformed, real64 error_value) = packed_and_error(samples)
        grid = grid.append([for com64 value = transformed[] then fft.magnitude(value)])
        if error_value > maximum_error
            maximum_error = error_value
    return (grid, maximum_error)
