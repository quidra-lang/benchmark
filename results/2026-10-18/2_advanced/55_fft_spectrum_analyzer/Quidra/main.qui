import math
import signal_io = "./signal_io.qui"
import fft = "./fft.qui"
import windows = "./windows.qui"
import spectral = "./spectral.qui"
import report = "./report.qui"

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

int min_int(int first, int second)
    return if first < second then first else second

int max_int(int first, int second)
    return if first > second then first else second

real64 total(real64[] values)
    real64 result := 0.0
    for value := values[]
        result += value
    return result

real64 energy(real64[] values)
    real64 result := 0.0
    for value := values[]
        result += value * value
    return result

real64 rms(real64[] values)
    result := math.sqrt(energy(values) / real64(len(values)))
    return result

real64 db(real64 value, real64 factor := 20.0)
    logarithm := math.log(value)
    return factor * logarithm / 2.302585092994046

real64 arctangent(real64 value)
    invert := value > 1.0
    z := if invert then 1.0 / value else value
    reduce := z > 0.41421356237309503
    if reduce
        z = (z - 1.0) / (z + 1.0)
    squared := z * z
    power := z
    real64 result := 0.0
    for: j < 40
        result += power / real64(2 * j + 1)
        power *= -squared
    if reduce
        result += fft.pi / 4.0
    return if invert then fft.pi / 2.0 - result else result

real64 argument(com64 value)
    if value.real == 0.0 and value.imag == 0.0
        return 0.0
    if value.real == 0.0
        return if value.imag >= 0.0 then fft.pi / 2.0 else -fft.pi / 2.0
    ratio := value.imag / value.real
    result := arctangent(absolute(ratio))
    if ratio < 0.0
        result = -result
    if value.real < 0.0
        result += if value.imag >= 0.0 then fft.pi else -fft.pi
    return result

real64 phase(com64 value)
    return argument(value) * 180.0 / fft.pi

int maximum_index(real64[] values, int first, int last)
    best := first
    for: first + 1 <= j <= last
        if values[j] > values[best]
            best = j
    return best

int[] strongest(real64[] values, int limit)
    indices := [for j := (1:<int(int(len(values)) - 1))[] if spectral.local_maximum(values, j) then j]
    count := int(len(indices))
    span := 1
    while span < count
        int[] merged := []
        for: start < count step 2 * span
            middle := min_int(count, start + span)
            finish := min_int(count, start + 2 * span)
            first := start
            second := middle
            while first < middle or second < finish
                take_first := second >= finish
                if first < middle and second < finish
                    a := indices[first]
                    b := indices[second]
                    take_first = values[a] > values[b] or (values[a] == values[b] and a < b)
                if take_first
                    merged = merged.append(indices[first])
                    first += 1
                else
                    merged = merged.append(indices[second])
                    second += 1
        indices = merged
        span *= 2
    int[] result := []
    for: j < min_int(limit, count)
        result = result.append(indices[j])
    return result

(real64[], real64[]) detrend(real64[] samples, int sample_rate)
    count := int(len(samples))
    average := total(samples) / real64(count)
    center := real64(count - 1) / 2.0
    real64 numerator := 0.0
    real64 denominator := 0.0
    low := samples[0]
    high := samples[0]
    for: i < count
        offset := real64(i) - center
        numerator += offset * (samples[i] - average)
        denominator += offset * offset
        if samples[i] < low
            low = samples[i]
        if samples[i] > high
            high = samples[i]
    slope := numerator / denominator
    real64[] residual := []
    real64 peak := 0.0
    real64 third := 0.0
    real64 fourth := 0.0
    for: i < count
        value := samples[i] - average - slope * (real64(i) - center)
        residual = residual.append(value)
        if absolute(value) > peak
            peak = absolute(value)
        third += value ^ 3.0
        fourth += value ^ 4.0
    level := rms(residual)
    return (residual, [average, slope * real64(sample_rate), level, low, high, peak / level, (third / real64(count)) / (level ^ 3.0), (fourth / real64(count)) / (level ^ 4.0)])

real64 bandwidth(real64[] values, int index)
    real64 root_two := math.sqrt(real64(2.0))
    cutoff := values[index] / root_two
    real64 left := 0.0
    right := real64(int(len(values)) - 1)
    for: index + 1 <= j < int(len(values))
        if values[j] <= cutoff
            right = real64(j - 1) + (values[j - 1] - cutoff) / (values[j - 1] - values[j])
            break
    j := index - 1
    while j >= 0
        if values[j] <= cutoff
            left = real64(j + 1) - (values[j + 1] - cutoff) / (values[j + 1] - values[j])
            break
        j -= 1
    return right - left

class Peak(int bin_index, real64 position, real64 amplitude, real64 frequency, real64 refined, real64 level_db, real64 phase_angle, real64 band_width, real64 snr, real64 coherence_value, string label)

(Peak[], real64, real64) analyze_peaks(real64[] amplitudes, com64[] transformed, signal_io.Params params, int sample_rate, spectral.Welch welch)
    length := params.main_length
    fs := real64(sample_rate)
    largest := amplitudes[maximum_index(amplitudes, 0, int(len(amplitudes)) - 1)]
    floor_value := spectral.median(amplitudes[1:<int(len(amplitudes)) - 1])
    Peak[] peaks := []
    for k := strongest(amplitudes, int(len(amplitudes)))[]
        if db(amplitudes[k] / largest) < params.peak_threshold or int(len(peaks)) >= params.peak_count
            continue
        fitted := spectral.interpolate(amplitudes, k)
        coherence_bin := (2 * k * params.welch_length + length) / (2 * length)
        peaks = peaks.append(Peak(k, fitted[0], fitted[1], real64(k) * fs / real64(length), fitted[0] * fs / real64(length), db(amplitudes[k] / largest), phase(transformed[k]), bandwidth(amplitudes, k) * fs / real64(length), db(amplitudes[k] / floor_value), welch.coherence[coherence_bin], "other"))
    for &peak := &peaks[]
        for: 1 <= h <= 10
            if absolute(peak.position - real64(h) * params.fundamental * real64(length) / fs) <= real64(params.search_width)
                peak.label = "h{h}"
                break
        if peak.label == "other"
            multiple := math.floor(peak.refined / real64(params.notch_frequency) + 0.5)
            if multiple >= 1 and absolute(peak.refined - real64(multiple * params.notch_frequency)) <= real64(params.notch_width)
                peak.label = "mains"
        if peak.label == "other"
            for: pivot < int(len(peaks))
                middle := peaks[pivot]
                if middle.bin_index == peak.bin_index or amplitudes[middle.bin_index] <= amplitudes[peak.bin_index]
                    continue
                for other := peaks[]
                    if other.bin_index != peak.bin_index and other.bin_index != middle.bin_index and amplitudes[middle.bin_index] > amplitudes[other.bin_index] and absolute(peak.position + other.position - 2.0 * middle.position) <= 1.0
                        peak.label = "sideband{pivot + 1}"
                        break
                if peak.label != "other"
                    break
    return (peaks, largest, floor_value)

class FilterResult(real64[] bandpassed, real64[] notched, real64[] envelope, real64[] smoothed)
    kept := 0
    removed := 0
    real64 band_rms := 0.0
    real64 notch_rms := 0.0
    real64 band_ratio := 0.0
    real64 dc_gain := 0.0
    real64 fir_gain := 0.0
    real64 fir_rms := 0.0
    real64 fir_error := 0.0
    real64 envelope_mean := 0.0
    envelope_bin := 0
    real64 envelope_frequency := 0.0
    real64 envelope_amplitude := 0.0
    real64 envelope_depth := 0.0
    real64 instantaneous_mean := 0.0
    real64 instantaneous_std := 0.0

FilterResult analyze_filters(real64[] first, real64[] second, signal_io.Params params, int sample_rate)
    count := int(len(first))
    fs := real64(sample_rate)
    transformed := fft.dft(fft.complex_values(first))
    band := fft.zeros(count)
    notch := fft.zeros(count)
    analytic_spectrum := fft.zeros(count)
    kept := 0
    removed := 0
    for: k < count
        frequency := min_int(k, count - k) * sample_rate
        if params.band_low * count <= frequency <= params.band_high * count
            band[k] = transformed[k]
            kept += 1
        multiple := (2 * frequency + params.notch_frequency * count) / (2 * params.notch_frequency * count)
        difference := frequency - multiple * params.notch_frequency * count
        if multiple >= 1 and (if difference < 0 then -difference else difference) <= params.notch_width * count
            removed += 1
        else
            notch[k] = transformed[k]
        if 1 <= k <= (count - 1) / 2 and params.envelope_low * count <= k * sample_rate <= params.envelope_high * count
            analytic_spectrum[k] = com64(2.0) * transformed[k]
    bp := fft.idft(band)
    nt := fft.idft(notch)
    analytic := fft.idft(analytic_spectrum)
    bandpassed := [for value := bp[] then value.real]
    notched := [for value := nt[] then value.real]
    envelope := [for value := analytic[] then fft.magnitude(value)]
    envelope_mean := total(envelope) / real64(count)
    centered := [for value := envelope[] then value - envelope_mean]
    envelope_transform := fft.dft(fft.complex_values(centered))
    modulation := [for value := envelope_transform[] then 2.0 * fft.magnitude(value) / real64(count)]
    envelope_bin := maximum_index(modulation, 1, ((params.envelope_high - params.envelope_low) * count) / (2 * sample_rate))
    fitted := spectral.interpolate(modulation, envelope_bin)
    real64[] instantaneous := []
    for: 1 <= i < count
        delta := argument(analytic[i]) - argument(analytic[i - 1])
        if delta <= -fft.pi
            delta += 2.0 * fft.pi
        if delta > fft.pi
            delta -= 2.0 * fft.pi
        instantaneous = instantaneous.append(delta * fs / (2.0 * fft.pi))
    frequency_mean := total(instantaneous) / real64(len(instantaneous))
    real64 variance := 0.0
    for value := instantaneous[]
        variance += (value - frequency_mean) ^ 2.0
    smoothed := fft.convolution(second, params.fir)
    gain := com64(0.0)
    for: j < int(len(params.fir))
        gain += com64(params.fir[j]) * fft.rot(2.0 * fft.pi * params.fundamental * real64(j) / fs)
    real64 fir_error := 0.0
    for: i < count + int(len(params.fir)) - 1
        real64 direct := 0.0
        for: max_int(0, i - int(len(params.fir)) + 1) <= j <= min_int(count - 1, i)
            direct += second[j] * params.fir[i - j]
        difference := absolute(smoothed[i] - direct)
        if difference > fir_error
            fir_error = difference
    result := FilterResult(bandpassed, notched, envelope, smoothed)
    result.kept = kept
    result.removed = removed
    result.band_rms = rms(bandpassed)
    result.notch_rms = rms(notched)
    result.band_ratio = energy(bandpassed) / energy(first)
    result.dc_gain = total(params.fir)
    result.fir_gain = db(fft.magnitude(gain))
    result.fir_rms = rms(smoothed[0:<count])
    result.fir_error = fir_error
    result.envelope_mean = envelope_mean
    result.envelope_bin = envelope_bin
    result.envelope_frequency = fitted[0] * fs / real64(count)
    result.envelope_amplitude = fitted[1]
    result.envelope_depth = fitted[1] / envelope_mean
    result.instantaneous_mean = frequency_mean
    result.instantaneous_std = math.sqrt(variance / real64(len(instantaneous)))
    return result

int wrapped(int index, int size)
    return if index < 0 then index + size else index % size

(int, real64) choose_lag(real64[] values, int limit)
    size := int(len(values))
    best := -limit
    for: -limit <= lag <= limit
        value := values[wrapped(lag, size)]
        previous := values[wrapped(best, size)]
        magnitude := if lag < 0 then -lag else lag
        previous_magnitude := if best < 0 then -best else best
        if value > previous or (value == previous and (magnitude < previous_magnitude or (magnitude == previous_magnitude and lag < best)))
            best = lag
    neighborhood := [values[wrapped(best - 1, size)], values[wrapped(best, size)], values[wrapped(best + 1, size)]]
    fitted := spectral.interpolate(neighborhood, 1, false)
    return (best, real64(best) + fitted[0] - 1.0)

class Correlation(int lag, real64 refined, real64 delay, real64 coefficient, int phat_lag, real64 phat_refined, real64 phat_delay)

Correlation analyze_correlation(real64[] first, real64[] second, int limit, int sample_rate)
    size := fft.pow2(2 * int(len(first)) - 1)
    fx := fft.radix2(fft.complex_values(first, size))
    fy := fft.radix2(fft.complex_values(second, size))
    cross := [for k := (0:<int(size))[] then fft.conjugate(fx[k]) * fy[k]]
    phased := [for value := cross[] then value / com64(fft.magnitude(value))]
    raw := [for value := fft.radix2(cross, true)[] then value.real]
    phat := [for value := fft.radix2(phased, true)[] then value.real]
    (lag, refined) := choose_lag(raw, limit)
    (phat_lag, phat_refined) := choose_lag(phat, limit)
    scale := math.sqrt(energy(first) * energy(second))
    return Correlation(lag, refined, 1000.0 * refined / real64(sample_rate), raw[wrapped(lag, size)] / scale, phat_lag, phat_refined, 1000.0 * phat_refined / real64(sample_rate))

class Pitch(int lag_min, int lag_max, int hps_bin, real64 hps_frequency, int acf_lag, real64 period, real64 frequency, real64 strength, int crossings, real64 crossing_frequency)

Pitch analyze_pitch(real64[] amplitudes, real64[] bandpassed, signal_io.Params params, int sample_rate)
    length := params.main_length
    half := length / 2
    hps_bin := -1
    real64 hps_value := -inf
    for: 1 <= k <= half
        if not (params.pitch_low * length <= k * sample_rate <= params.pitch_high * length and 5 * k <= half)
            continue
        real64 value := 0.0
        for: 1 <= r <= 5
            logarithm := math.log(amplitudes[r * k])
            value += logarithm
        if value > hps_value
            hps_value = value
            hps_bin = k
    size := fft.pow2(2 * int(len(bandpassed)) - 1)
    transformed := fft.radix2(fft.complex_values(bandpassed, size))
    com64[] power := []
    for value := transformed[]
        magnitude := fft.magnitude(value)
        power = power.append(com64(magnitude * magnitude))
    acf := [for value := fft.radix2(power, true)[] then value.real]
    lag_min := (sample_rate + params.pitch_high - 1) / params.pitch_high
    lag_max := sample_rate / params.pitch_low
    lag := maximum_index(acf, lag_min, lag_max)
    fitted := spectral.interpolate(acf, lag, false)
    crossings := 0
    for: 1 <= i < int(len(bandpassed))
        if bandpassed[i - 1] < 0.0 <= bandpassed[i]
            crossings += 1
    return Pitch(lag_min, lag_max, hps_bin, real64(hps_bin * sample_rate) / real64(length), lag, fitted[0], real64(sample_rate) / fitted[0], fitted[1] / acf[0], crossings, real64(crossings * sample_rate) / real64(len(bandpassed)))

int target_index(real64[] values, int length, real64 center, int width)
    best := -1
    for: 1 <= k < length / 2
        if absolute(real64(k) - center) <= real64(width) and (best < 0 or values[k] > values[best])
            best = k
    return best

class Harmonic(int bin_index, real64 position, real64 amplitude, real64 refined, real64 level_db)

string yes_no(bool value)
    return if value then "yes" else "no"

void run()
    data := signal_io.read_inputs()
    signal_io.Params params := data.params
    sample_rate := data.sample_rate
    fs := real64(sample_rate)
    count := int(len(data.first))
    length := params.main_length
    half := length / 2
    (first, first_stats) := detrend(data.first, sample_rate)
    (second, second_stats) := detrend(data.second, sample_rate)
    (weighted, transformed, amplitudes) := spectral.amplitude(first, params.main_window, length)
    figures := windows.figures(windows.window(params.main_window, length), sample_rate)
    welch := spectral.welch(first, second, sample_rate, params.welch_length, params.welch_window)
    (peaks, largest, floor_value) := analyze_peaks(amplitudes, transformed, params, sample_rate, welch)
    Harmonic[] harmonics := []
    real64 harmonic_energy := 0.0
    for: 1 <= h <= 10
        center := real64(h) * params.fundamental * real64(length) / fs
        index := target_index(amplitudes, length, center, params.search_width)
        fitted := spectral.interpolate(amplitudes, index)
        harmonics = harmonics.append(Harmonic(index, fitted[0], fitted[1], fitted[0] * fs / real64(length), 0.0))
        if h > 1
            harmonic_energy += fitted[1] * fitted[1]
    primary := harmonics[0].amplitude
    for &harmonic := &harmonics[]
        harmonic.level_db = db(harmonic.amplitude / primary)
    root_harmonic := math.sqrt(harmonic_energy)
    thd := root_harmonic / primary
    real64[] power := [for k := (0:<(int(half) + 1))[] then 0.0]
    real64 sum_power := 0.0
    real64 first_power := 0.0
    real64 weighted_frequency := 0.0
    real64 log_power := 0.0
    for: 1 <= k < half
        real64 value := amplitudes[k] * amplitudes[k] / 2.0
        power[k] = value
        sum_power += value
        distance := k - harmonics[0].bin_index
        if (if distance < 0 then -distance else distance) <= params.search_width
            first_power += value
        weighted_frequency += (real64(k) * fs / real64(length)) * value
        logarithm := math.log(value)
        log_power += logarithm
    total_power := sum_power / figures[3]
    p1 := first_power / figures[3]
    thdn := math.sqrt((total_power - p1) / p1)
    centroid := weighted_frequency / sum_power
    real64 spread_sum := 0.0
    real64 cumulative := 0.0
    real64 rolloff := -1.0
    for: 1 <= k < half
        spread_sum += ((real64(k) * fs / real64(length) - centroid) ^ 2.0) * power[k]
        cumulative += power[k]
        if rolloff < 0.0 and cumulative >= 0.85 * sum_power
            rolloff = real64(k) * fs / real64(length)
    spread := math.sqrt(spread_sum / sum_power)
    geometric_mean := math.exp(log_power / real64(half - 1))
    flatness := db(geometric_mean / (sum_power / real64(half - 1)), 10.0)
    (grid, frame_error) := spectral.spectrogram(first, params.frame_length, params.hop, params.frame_window)
    real64 gmax := 0.0
    for row := grid[]
        for value := row[]
            if value > gmax
                gmax = value
    int[] dominant := []
    real64[] flux := [0.0]
    for: t < int(len(grid))
        dominant = dominant.append(maximum_index(grid[t], 1, params.frame_length / 2 - 1))
        if t > 0
            real64 value := 0.0
            for: k < int(len(grid[t]))
                real64 difference := grid[t][k] - grid[t - 1][k]
                value += if difference > 0.0 then difference else 0.0
            flux = flux.append(value)
    onset_threshold := params.onset_factor * spectral.median(flux[1:<int(len(flux))])
    int[] onsets := []
    for: 1 <= t < int(len(grid))
        if flux[t] > onset_threshold and flux[t] > flux[t - 1] and (t == int(len(grid)) - 1 or flux[t] > flux[t + 1])
            onsets = onsets.append(t)
    real64[] kurtosis := []
    for: k <= params.frame_length / 2
        real64 second_moment := 0.0
        real64 fourth_moment := 0.0
        for row := grid[]
            second_moment += row[k] ^ 2.0
            fourth_moment += row[k] ^ 4.0
        kurtosis = kurtosis.append(real64(len(grid)) * fourth_moment / (second_moment * second_moment) - 2.0)
    top_kurtosis := maximum_index(kurtosis, 1, params.frame_length / 2 - 1)
    filters := analyze_filters(first, second, params, sample_rate)
    pitch := analyze_pitch(amplitudes, filters.bandpassed, params, sample_rate)
    correlation := analyze_correlation(first, second, params.max_lag, sample_rate)
    zoom_step := real64(params.zoom_high - params.zoom_low) / real64(params.zoom_count - 1)
    zoom_transform := fft.chirp_z(weighted, sample_rate, params.zoom_low, params.zoom_high, params.zoom_count)
    zoom := [for value := zoom_transform[] then 2.0 * fft.magnitude(value) / figures[0]]
    real64 inverse_error := 0.0
    time_energy := energy(weighted)
    real64 frequency_energy := 0.0
    inverse := fft.idft(transformed)
    for: j < length
        difference := fft.magnitude(inverse[j] - com64(weighted[j]))
        if difference > inverse_error
            inverse_error = difference
    for value := transformed[]
        magnitude := fft.magnitude(value)
        frequency_energy += magnitude * magnitude
    parseval_error := absolute(time_energy - frequency_energy / real64(length)) / time_energy
    real64 spot_error := 0.0
    for peak := peaks[]
        direct := com64(0.0)
        for: n < length
            direct += com64(weighted[n]) * fft.rot(2.0 * fft.pi * real64((peak.bin_index * n) % length) / real64(length))
        difference := fft.magnitude(direct - transformed[peak.bin_index])
        if difference > spot_error
            spot_error = difference
    spectrum_rows := [for k := (0:<(int(half) + 1))[] then [report.decimal(real64(k) * fs / real64(length)), report.decimal(amplitudes[k])]]
    psd_rows := [for k := (0:<int(len(welch.psd)))[] then [report.decimal(real64(k) * fs / real64(params.welch_length)), report.decimal(db(welch.psd[k], 10.0))]]
    filtered_rows := [for j := (0:<int(count))[] then [j.string(), report.decimal(filters.bandpassed[j]), report.decimal(filters.notched[j]), report.decimal(filters.smoothed[j]), report.decimal(filters.envelope[j])]]
    report.csv("spectrum.csv", "frequency,amplitude", spectrum_rows)
    report.csv("welch_psd.csv", "frequency,psd_db", psd_rows)
    report.csv("filtered.csv", "index,bandpass,notched,smoothed,envelope", filtered_rows)
    peak_lines := ["length={length} window={params.main_window} resolution=" + report.decimal(fs / real64(length)) + " threshold_db=" + report.decimal(params.peak_threshold), "max_amplitude=" + report.decimal(largest) + " noise_floor=" + report.decimal(floor_value) + " noise_floor_db=" + report.decimal(db(floor_value)), "peaks={len(peaks)}"]
    for: rank < int(len(peaks))
        Peak peak := peaks[rank]
        peak_lines = peak_lines.append("{rank + 1} bin={peak.bin_index} frequency=" + report.decimal(peak.frequency) + " refined=" + report.decimal(peak.refined) + " amplitude=" + report.decimal(peak.amplitude) + " level_db=" + report.decimal(peak.level_db) + " phase=" + report.decimal(peak.phase_angle) + " bandwidth=" + report.decimal(peak.band_width) + " snr_db=" + report.decimal(peak.snr) + " coherence=" + report.decimal(peak.coherence_value) + " label={peak.label}")
    report.write_lines("peaks.txt", peak_lines)
    spectrogram_lines := ["frames={len(grid)} bins={params.frame_length / 2 + 1} frame_length={params.frame_length} hop={params.hop} window={params.frame_window} band_db={params.band_db} max_db=" + report.decimal(db(gmax))]
    spectrogram_lines = spectrogram_lines.concat(report.shades(grid, sample_rate, params.frame_length, params.band_db, gmax)).append("track")
    for: t < int(len(dominant))
        index := dominant[t]
        spectrogram_lines = spectrogram_lines.append("frame={t} time=" + report.decimal(real64(t * params.hop) / fs) + " frequency=" + report.decimal(real64(index) * fs / real64(params.frame_length)) + " level_db=" + report.decimal(db(grid[t][index] / gmax)))
    spectrogram_lines = spectrogram_lines.append("onsets={len(onsets)} threshold=" + report.decimal(onset_threshold))
    for t := onsets[]
        spectrogram_lines = spectrogram_lines.append("frame={t} time=" + report.decimal(real64(t * params.hop) / fs) + " flux=" + report.decimal(flux[t]))
    spectrogram_lines = spectrogram_lines.append("kurtosis bin={top_kurtosis} frequency=" + report.decimal(real64(top_kurtosis) * fs / real64(params.frame_length)) + " value=" + report.decimal(kurtosis[top_kurtosis]))
    report.write_lines("spectrogram.txt", spectrogram_lines)
    rows := ["[signal]", "sample_rate={sample_rate} samples={count} duration=" + report.decimal(real64(count) / fs)]
    stat_names := ["mean", "slope", "rms", "min", "max", "crest", "skewness", "kurtosis"]
    for: channel < 2
        real64[] stats := if channel == 0 then first_stats else second_stats
        line := "channel={channel + 1}"
        for: j < int(len(stat_names))
            line += " {stat_names[j]}=" + report.decimal(stats[j])
        rows = rows.append(line)
    real64[][] history := []
    loudest := 0
    for: block < count / params.block_length
        start := block * params.block_length
        stop := (block + 1) * params.block_length
        real64[] left := first[start:<stop]
        real64[] right := second[start:<stop]
        real64 peak := 0.0
        for value := left[]
            if absolute(value) > peak
                peak = absolute(value)
        history = history.append([rms(left), rms(right), peak])
        if history[block][0] > history[loudest][0]
            loudest = block
    rows = rows.concat(["[levels]", "block_length={params.block_length} blocks={len(history)} loudest={loudest}"])
    for: j < int(len(history))
        rows = rows.append("block={j} time=" + report.decimal(real64(j * params.block_length) / fs) + " rms1=" + report.decimal(history[j][0]) + " rms2=" + report.decimal(history[j][1]) + " peak1=" + report.decimal(history[j][2]))
    rows = rows.append("[windows]")
    for name := windows.names()[]
        calibration := windows.figures(windows.window(name, length), sample_rate)
        (windowed, transform, aw) := spectral.amplitude(first, name, length)
        index := target_index(aw, length, params.fundamental * real64(length) / fs, params.search_width)
        fitted := spectral.interpolate(aw, index)
        floor_db := db(spectral.median(aw[1:<int(len(aw)) - 1]))
        rows = rows.append("name={name} coherent_gain=" + report.decimal(calibration[2]) + " enbw_bins=" + report.decimal(calibration[3]) + " enbw_hz=" + report.decimal(calibration[4]) + " scalloping_db=" + report.decimal(calibration[5]) + " fundamental_bin={index} bin_amplitude=" + report.decimal(aw[index]) + " refined_amplitude=" + report.decimal(fitted[1]) + " floor_db=" + report.decimal(floor_db))
    power_two := fft.pow2(length) == length
    method := if power_two then "radix2" else "bluestein"
    transform_size := if power_two then length else fft.pow2(2 * length - 1)
    rows = rows.concat(["[main]", "length={length} window={params.main_window} method={method} transform_size={transform_size} resolution=" + report.decimal(fs / real64(length)), "total_power=" + report.decimal(total_power) + " centroid=" + report.decimal(centroid) + " spread=" + report.decimal(spread) + " rolloff=" + report.decimal(rolloff) + " flatness_db=" + report.decimal(flatness), "[bands]"])
    for: j < int(len(params.bands)) - 1
        int low := params.bands[j]
        int high := params.bands[j + 1]
        real64 value := 0.0
        for: 1 <= k < half
            if low * length <= k * sample_rate < high * length
                value += power[k]
        value /= figures[3]
        rows = rows.append("range={low}-{high} power=" + report.decimal(value) + " percent=" + report.decimal(100.0 * value / total_power))
    rows = rows.append("[third_octave]")
    for: params.third_low <= band <= params.third_high
        center := 1000.0 * (2.0 ^ (real64(band) / 3.0))
        low := 1000.0 * (2.0 ^ (real64(2 * band - 1) / 6.0))
        high := 1000.0 * (2.0 ^ (real64(2 * band + 1) / 6.0))
        real64 value := 0.0
        bins := 0
        for: 1 <= k < half
            frequency := real64(k) * fs / real64(length)
            if low <= frequency < high
                value += power[k]
                bins += 1
        rows = rows.append("band={band} center=" + report.decimal(center) + " lower=" + report.decimal(low) + " upper=" + report.decimal(high) + " bins={bins} level_db=" + report.decimal(db(value / figures[3], 10.0)))
    rows = rows.concat(["[harmonics]", "fundamental=" + report.decimal(params.fundamental) + " search={params.search_width}"])
    for: h < 10
        harmonic := harmonics[h]
        rows = rows.append("h={h + 1} target=" + report.decimal(real64(h + 1) * params.fundamental) + " bin={harmonic.bin_index} refined=" + report.decimal(harmonic.refined) + " amplitude=" + report.decimal(harmonic.amplitude) + " level_db=" + report.decimal(harmonic.level_db))
    rows = rows.concat(["thd_percent=" + report.decimal(100.0 * thd) + " thd_db=" + report.decimal(db(thd)), "thdn_percent=" + report.decimal(100.0 * thdn) + " thdn_db=" + report.decimal(db(thdn)), "[pitch]", "range={params.pitch_low}-{params.pitch_high} lags={pitch.lag_min}-{pitch.lag_max}", "hps bin={pitch.hps_bin} order=5 frequency=" + report.decimal(pitch.hps_frequency), "autocorrelation lag={pitch.acf_lag} period=" + report.decimal(pitch.period) + " frequency=" + report.decimal(pitch.frequency) + " strength=" + report.decimal(pitch.strength), "zero_crossing count={pitch.crossings} frequency=" + report.decimal(pitch.crossing_frequency), "[zoom]", "band={params.zoom_low}-{params.zoom_high} points={params.zoom_count} step=" + report.decimal(zoom_step)])
    zoom_peaks := strongest(zoom, 3)
    for: rank < int(len(zoom_peaks))
        fitted := spectral.interpolate(zoom, zoom_peaks[rank])
        rows = rows.append("peak={rank + 1} frequency=" + report.decimal(real64(params.zoom_low) + fitted[0] * zoom_step) + " amplitude=" + report.decimal(fitted[1]))
    integrated := total(welch.psd) * fs / real64(params.welch_length)
    variance := energy(first) / real64(count)
    rows = rows.concat(["[welch]", "segment_length={params.welch_length} segments={welch.segments} window={params.welch_window} resolution=" + report.decimal(fs / real64(params.welch_length)), "integrated_power=" + report.decimal(integrated) + " variance=" + report.decimal(variance) + " ratio=" + report.decimal(integrated / variance)])
    welch_peaks := strongest(welch.psd, 5)
    for: rank < int(len(welch_peaks))
        index := welch_peaks[rank]
        rows = rows.append("peak={rank + 1} frequency=" + report.decimal(real64(index) * fs / real64(params.welch_length)) + " psd_db=" + report.decimal(db(welch.psd[index], 10.0)) + " coherence=" + report.decimal(welch.coherence[index]) + " gain=" + report.decimal(fft.magnitude(welch.transfer[index])) + " phase=" + report.decimal(phase(welch.transfer[index])))
    rows = rows.concat(["[filter]", "bandpass={params.band_low}-{params.band_high} bins_kept={filters.kept} rms=" + report.decimal(filters.band_rms) + " energy_ratio=" + report.decimal(filters.band_ratio), "notch={params.notch_frequency} width={params.notch_width} bins_removed={filters.removed} rms=" + report.decimal(filters.notch_rms), "fir_taps={len(params.fir)} dc_gain=" + report.decimal(filters.dc_gain) + " gain_at_fundamental_db=" + report.decimal(filters.fir_gain) + " rms=" + report.decimal(filters.fir_rms), "[envelope]", "band={params.envelope_low}-{params.envelope_high} mean=" + report.decimal(filters.envelope_mean) + " bin={filters.envelope_bin} frequency=" + report.decimal(filters.envelope_frequency) + " amplitude=" + report.decimal(filters.envelope_amplitude) + " depth=" + report.decimal(filters.envelope_depth), "instantaneous_frequency mean=" + report.decimal(filters.instantaneous_mean) + " std=" + report.decimal(filters.instantaneous_std), "[correlation]", "max_lag={params.max_lag} lag={correlation.lag} refined_lag=" + report.decimal(correlation.refined) + " delay_ms=" + report.decimal(correlation.delay) + " coefficient=" + report.decimal(correlation.coefficient), "phat_lag={correlation.phat_lag} refined_lag=" + report.decimal(correlation.phat_refined) + " delay_ms=" + report.decimal(correlation.phat_delay), "[checks]"])
    check_names := ["inverse_roundtrip", "parseval", "real_packing", "fir_fft_vs_direct", "dft_spot_check"]
    real64[] errors := [inverse_error, parseval_error, (if welch.packing_error > frame_error then welch.packing_error else frame_error), filters.fir_error, spot_error]
    for: j < int(len(check_names))
        status := if errors[j] <= 0.000001 then "ok" else "failed"
        line := "{check_names[j]}={status}"
        if j == 2
            line += " transforms={2 * welch.segments + int(len(grid))}"
        elif j == 4
            line += " bins={len(peaks)}"
        rows = rows.append(line)
    ratio := harmonics[1].amplitude / primary
    loose := 0
    for: 2 <= h < 10
        if harmonics[h].level_db >= -30.0
            loose += 1
    has_electrical := false
    real64 electrical_level := 0.0
    for peak := peaks[]
        if peak.label == "mains"
            has_electrical = true
            electrical_level = peak.level_db
            break
    symptoms := [ratio >= 0.5, loose >= 3, filters.envelope_depth >= 0.2, has_electrical and electrical_level >= -20.0, len(onsets) > 0]
    findings := 0
    for symptom := symptoms[]
        if symptom
            findings += 1
    electrical_text := if has_electrical then report.decimal(electrical_level) else "none"
    status := if findings == 0 then "normal" elif findings == 1 then "warning" else "alarm"
    rows = rows.concat(["[diagnosis]", "misalignment=" + yes_no(symptoms[0]) + " ratio=" + report.decimal(ratio), "looseness=" + yes_no(symptoms[1]) + " harmonics={loose}", "bearing=" + yes_no(symptoms[2]) + " depth=" + report.decimal(filters.envelope_depth), "electrical=" + yes_no(symptoms[3]) + " level_db={electrical_text}", "transient=" + yes_no(symptoms[4]) + " onsets={len(onsets)}", "status={status} findings={findings}"])
    report.write_lines("report.txt", rows)

run()
