int integer(string text)
    int result = int.parse(text)
    return result

real64 number(string text)
    real64 result = real64.parse(text)
    return result

string[] lines(string path)
    string content = file.read(path)
    string[] rows = content.split(NL)
    return rows[0:<int(len(rows)) - 1]

class Params(local string[][] rows)
    int main_length = integer(rows[0][1])
    string main_window = rows[1][1]
    real64 peak_threshold = number(rows[2][1])
    int peak_count = integer(rows[3][1])
    real64 fundamental = number(rows[4][1])
    int search_width = integer(rows[4][2])
    int welch_length = integer(rows[5][1])
    string welch_window = rows[5][2]
    int frame_length = integer(rows[6][1])
    int hop = integer(rows[6][2])
    int band_db = integer(rows[6][3])
    string frame_window = rows[6][4]
    real64 onset_factor = number(rows[7][1])
    int pitch_low = integer(rows[8][1])
    int pitch_high = integer(rows[8][2])
    int band_low = integer(rows[9][1])
    int band_high = integer(rows[9][2])
    int notch_frequency = integer(rows[10][1])
    int notch_width = integer(rows[10][2])
    int envelope_low = integer(rows[11][1])
    int envelope_high = integer(rows[11][2])
    int zoom_low = integer(rows[12][1])
    int zoom_high = integer(rows[12][2])
    int zoom_count = integer(rows[12][3])
    real64[] fir = [for string text = rows[13][1:<int(len(rows[13]))][] then number(text)]
    int max_lag = integer(rows[14][1])
    int[] bands = [for string text = rows[15][1:<int(len(rows[15]))][] then integer(text)]
    int third_low = integer(rows[16][1])
    int third_high = integer(rows[16][2])
    int block_length = integer(rows[17][1])

class Input(int sample_rate, real64[] first, real64[] second, Params params)

Input read_inputs()
    string[] rows = lines("input/signal.csv")
    string[] header = rows[0].split(",")
    real64[] first = []
    real64[] second = []
    for string row = rows[1:<int(len(rows))][]
        string[] fields = row.split(",")
        first = first.append(number(fields[0]))
        second = second.append(number(fields[1]))
    string[][] parameters = [for string row = lines("input/params.txt")[] then row.split(" ")]
    return Input(integer(header[0]), first, second, Params(parameters))
