int integer(string text)
    result := int(text)
    return result

real64 number(string text)
    result := real64(text)
    return result

string[] lines(string path)
    content := string.from_utf8(file.read_bin(path))
    rows := content.split(NL)
    return rows[0:<int(rows.len()) - 1]

class Params(local string[][] rows)
    main_length := integer(rows[0][1])
    main_window := rows[1][1]
    peak_threshold := number(rows[2][1])
    peak_count := integer(rows[3][1])
    fundamental := number(rows[4][1])
    search_width := integer(rows[4][2])
    welch_length := integer(rows[5][1])
    welch_window := rows[5][2]
    frame_length := integer(rows[6][1])
    hop := integer(rows[6][2])
    band_db := integer(rows[6][3])
    frame_window := rows[6][4]
    onset_factor := number(rows[7][1])
    pitch_low := integer(rows[8][1])
    pitch_high := integer(rows[8][2])
    band_low := integer(rows[9][1])
    band_high := integer(rows[9][2])
    notch_frequency := integer(rows[10][1])
    notch_width := integer(rows[10][2])
    envelope_low := integer(rows[11][1])
    envelope_high := integer(rows[11][2])
    zoom_low := integer(rows[12][1])
    zoom_high := integer(rows[12][2])
    zoom_count := integer(rows[12][3])
    fir := [for text := rows[13][1:<int(rows[13].len())][] then number(text)]
    max_lag := integer(rows[14][1])
    bands := [for text := rows[15][1:<int(rows[15].len())][] then integer(text)]
    third_low := integer(rows[16][1])
    third_high := integer(rows[16][2])
    block_length := integer(rows[17][1])

class Input(int sample_rate, real64[] first, real64[] second, Params params)

Input read_inputs()
    rows := lines("input/signal.csv")
    header := rows[0].split(",")
    real64[] first := []
    real64[] second := []
    for row := rows[1:<int(rows.len())][]
        fields := row.split(",")
        first = first.append(number(fields[0]))
        second = second.append(number(fields[1]))
    parameters := [for row := lines("input/params.txt")[] then row.split(" ")]
    return Input(integer(header[0]), first, second, Params(parameters))
