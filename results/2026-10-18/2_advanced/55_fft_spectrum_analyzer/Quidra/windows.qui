import math
import fft = "./fft.qui"

string[] names()
    return ["rectangular", "hann", "hamming", "blackman", "flattop"]

real64[] coefficients(string name)
    if name == "rectangular"
        return [1.0]
    if name == "hann"
        return [0.5, 0.5]
    if name == "hamming"
        return [0.54, 0.46]
    if name == "blackman"
        return [0.42, 0.5, 0.08]
    return [0.21557895, 0.41663158, 0.277263158, 0.083578947, 0.006947368]

real64[] window(string name, int length)
    real64[] weights = coefficients(name)
    real64[] result = []
    for int n < length
        real64 total = 0.0
        for int j < int(len(weights))
            real64 cosine = math.cos(2.0 * fft.pi * real64(j) * real64(n) / real64(length))
            real64 sign = if j % 2 == 0 then 1.0 else -1.0
            total += sign * weights[j] * cosine
        result = result.append(total)
    return result

real64[] figures(real64[] values, int sample_rate)
    real64 s1 = 0.0
    real64 s2 = 0.0
    com64 scalloping = com64(0.0)
    for int n < int(len(values))
        real64 value = values[n]
        s1 += value
        s2 += value * value
        scalloping += com64(value) * fft.rot(fft.pi * real64(n) / real64(len(values)))
    real64 enbw = real64(len(values)) * s2 / (s1 * s1)
    real64 logarithm = math.log(fft.magnitude(scalloping) / s1)
    return [s1, s2, s1 / real64(len(values)), enbw, enbw * real64(sample_rate) / real64(len(values)), -20.0 * logarithm / 2.302585092994046]
