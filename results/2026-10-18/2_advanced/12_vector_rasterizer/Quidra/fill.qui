import math
import canvas = "./canvas.qui"

class Edge(canvas.Point start, canvas.Point end)

int[] crossing_at(map.Map<int, int[]> values, int key)
    match values.get(key)
        int[] found
            return found
        none
            return [0, 0]

set.Set<int> polygons(canvas.Point[][] sequences, string rule, canvas.Rectangle clip, int width)
    Edge[] edges = []
    for canvas.Point[] vertices = sequences[]
        for nat index < len(vertices)
            canvas.Point start = vertices[index]
            canvas.Point end = vertices[(index + 1) % len(vertices)]
            if start.y != end.y
                edges = edges.append(Edge(start, end))
    set.Set<int> pixels
    for clip.y0 <= int y <= clip.y1
        map.Map<int, int[]> crossings
        for Edge edge = edges[]
            canvas.Point a = edge.start
            canvas.Point b = edge.end
            if math.min(a.y, b.y) <= y < math.max(a.y, b.y)
                int denominator = b.y - a.y
                int numerator = 2 * a.x * denominator + (2 * y + 1 - 2 * a.y) * (b.x - a.x)
                if denominator < 0
                    denominator = -denominator
                    numerator = -numerator
                int first = canvas.floor_divide(numerator - denominator, 2 * denominator) + 1
                int[] previous = crossing_at(crossings, first)
                .crossings.set(first, [previous[0] + 1, previous[1] + (if b.y > a.y then 1 else -1)])
        int[] positions = crossings.keys().sorted()
        int index = 0
        int count = 0
        int winding = 0
        for clip.x0 <= int x <= clip.x1
            while index < int(len(positions)) and positions[index] <= x
                int[] crossing = crossing_at(crossings, positions[index])
                count += crossing[0]
                winding += crossing[1]
                index += 1
            bool painted = if rule == "evenodd" then count % 2 == 1 else winding != 0
            if painted
                .pixels.add(y * width + x)
    return pixels

set.Set<int> shape(canvas.Point center, canvas.Point[] points, canvas.Rectangle clip, int width)
    map.Map<int, int> extents
    for canvas.Point point = points[]
        int previous = 0
        match extents.get(point.y)
            int found
                previous = found
            none
                previous = 0
        .extents.set(point.y, math.max(previous, math.abs(point.x)))
    set.Set<int> pixels
    for int dy = extents.keys()[]
        int y = center.y + dy
        if clip.y0 <= y <= clip.y1
            match extents.get(dy)
                int extent
                    for math.max(clip.x0, center.x - extent) <= int x <= math.min(clip.x1, center.x + extent)
                        .pixels.add(y * width + x)
                none
                    continue
    return pixels

set.Set<int> flood(canvas.Layer layer, canvas.Point seed, canvas.Rectangle clip)
    int first = seed.y * layer.width + seed.x
    set.Set<int> pixels
    .pixels.add(first)
    int[] pending = [first]
    while len(pending) > 0
        int pixel = pending[len(pending) - 1]
        pending = pending[0:<len(pending) - 1]
        int x = pixel % layer.width
        int y = pixel / layer.width
        canvas.Point[] adjacent = [canvas.Point(x + 1, y), canvas.Point(x - 1, y), canvas.Point(x, y + 1), canvas.Point(x, y - 1)]
        for canvas.Point point = adjacent[]
            if not clip.contains(point)
                continue
            int next = point.y * layer.width + point.x
            if not pixels.has(next) and layer.same_value(first, next)
                .pixels.add(next)
                pending = pending.append(next)
    return pixels
