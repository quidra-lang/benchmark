import math
import canvas = "./canvas.qui"

canvas.Point[] bresenham(canvas.Point first, canvas.Point last)
    int x = first.x
    int y = first.y
    int dx = math.abs(last.x - x)
    int dy = -math.abs(last.y - y)
    int sx = if x < last.x then 1 else -1
    int sy = if y < last.y then 1 else -1
    int error_value = dx + dy
    canvas.Point[] result = []
    while true
        result = result.append(canvas.Point(x, y))
        if x == last.x and y == last.y
            return result
        int doubled = 2 * error_value
        if doubled >= dy
            error_value += dy
            x += sx
        if doubled <= dx
            error_value += dx
            y += sy

canvas.Point[] expand_square(canvas.Point point, int width)
    int low = -((width - 1) / 2)
    canvas.Point[] result = []
    for low <= int row < low + width
        for low <= int column < low + width
            result = result.append(canvas.Point(point.x + column, point.y + row))
    return result

void add_point(set.Set<(int, int)> &points, int x, int y)
    .points.add((x, y))

canvas.Point[] point_values(set.Set<(int, int)> points)
    canvas.Point[] result = []
    for (int x, int y) = points.values()[]
        result = result.append(canvas.Point(x, y))
    return result

canvas.Point[] circle_points(int radius)
    set.Set<(int, int)> points
    int a = radius
    int b = 0
    int error_value = 1 - radius
    while a >= b
        int[][] positions = [[a, b], [b, a], [-b, a], [-a, b], [-a, -b], [-b, -a], [b, -a], [a, -b]]
        for int[] position = positions[]
            add_point(&points, position[0], position[1])
        b += 1
        if error_value < 0
            error_value += 2 * b + 1
        else
            a -= 1
            error_value += 2 * (b - a) + 1
    return point_values(points)

void add_quadrants(set.Set<(int, int)> &points, int x, int y)
    add_point(&points, x, y)
    add_point(&points, -x, y)
    add_point(&points, x, -y)
    add_point(&points, -x, -y)

canvas.Point[] ellipse_points(int rx, int ry)
    int rx2 = rx * rx
    int ry2 = ry * ry
    int x = 0
    int y = ry
    set.Set<(int, int)> points
    add_point(&points, 0, ry)
    add_point(&points, 0, -ry)
    while ry2 * x < rx2 * y
        int decision = 4 * ry2 * (x + 1) * (x + 1) + rx2 * (2 * y - 1) * (2 * y - 1) - 4 * rx2 * ry2
        x += 1
        if decision >= 0
            y -= 1
        add_quadrants(&points, x, y)
    while y > 0
        int decision = ry2 * (2 * x + 1) * (2 * x + 1) + 4 * rx2 * (y - 1) * (y - 1) - 4 * rx2 * ry2
        y -= 1
        if decision <= 0
            x += 1
        add_quadrants(&points, x, y)
    return point_values(points)

canvas.Point[] bezier_points(canvas.Point[] controls, int segments)
    int degree = int(len(controls)) - 1
    int scale = if degree == 2 then segments * segments else segments * segments * segments
    canvas.Point[] result = []
    for int index <= segments
        int rest = segments - index
        int[] weights = if degree == 2 then [rest * rest, 2 * index * rest, index * index] else [rest * rest * rest, 3 * index * rest * rest, 3 * index * index * rest, index * index * index]
        int x = 0
        int y = 0
        for nat position < len(controls)
            x += weights[position] * controls[position].x
            y += weights[position] * controls[position].y
        result = result.append(canvas.Point(canvas.round_ratio(x, scale), canvas.round_ratio(y, scale)))
    return result
