class Line(string text)
    int[] footnotes = []
    int[] indexes = []
    int anchor = -1
    bool chapter_start = false
    int generated_block = -1
    int generated_line = -1

class LayoutBlock(string kind, Line[] lines, bool list, bool page_break)
class Boundary(int end, int next_start, bool forced)
class Page(Line[] content, int[] footnotes, int height, bool ends_by_force)
    bool blank = false
    bool chapter_start = false
    int serial = 0
    int body_number = 0
    string display = ""
    string header = ""
    string footer = ""
    string[] body = []

Page[] choose_pages(LayoutBlock[] blocks, int[] footnote_heights, int height, int orphan, int widow)
    Line[] lines = []
    Boundary[] boundaries = []
    for int index < int(len(blocks))
        LayoutBlock block = blocks[index]
        int start = int(len(lines))
        lines = lines.concat(block.lines)
        int count = int(len(block.lines))
        if block.kind == "flow"
            for 1 <= int kept < count
                if kept >= orphan and count - kept >= widow
                    boundaries = boundaries.append(Boundary(start + kept, start + kept, false))
        if index + 1 == int(len(blocks))
            boundaries = boundaries.append(Boundary(int(len(lines)), int(len(lines)), true))
        else
            LayoutBlock following = blocks[index + 1]
            int end = int(len(lines))
            if not (block.list and following.list)
                lines = lines.append(Line(""))
            if following.page_break or block.kind != "heading"
                boundaries = boundaries.append(Boundary(end, int(len(lines)), following.page_break))
    Page[] pages = []
    int start = 0
    int first_boundary = 0
    while start < int(len(lines))
        bool[] notes = array(len(footnote_heights), fill = false)
        int note_height = 0
        int scanned = start
        int chosen = -1
        int used = 0
        int[] chosen_notes = []
        for first_boundary <= int index < int(len(boundaries))
            Boundary boundary = boundaries[index]
            while scanned < boundary.end
                for int number = lines[scanned].footnotes[]
                    if not notes[number]
                        notes[number] = true
                        note_height += footnote_heights[number]
                scanned += 1
            int[] page_notes = []
            for int number < int(len(notes))
                if notes[number]
                    page_notes = page_notes.append(number)
            int current_height = boundary.end - start + note_height + (if len(page_notes) > 0 then 1 else 0)
            if current_height > height
                break
            chosen = index
            used = current_height
            chosen_notes = page_notes
            if boundary.forced
                break
        Boundary boundary = boundaries[chosen]
        pages = pages.append(Page(lines[start:<boundary.end], chosen_notes, used, boundary.forced))
        start = boundary.next_start
        first_boundary = chosen + 1
    return pages
