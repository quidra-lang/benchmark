class Line(string text)
    int[] footnotes := []
    int[] indexes := []
    anchor := -1
    chapter_start := false
    generated_block := -1
    generated_line := -1

class LayoutBlock(string kind, Line[] lines, bool list, bool page_break)
class Boundary(int end, int next_start, bool forced)
class Page(Line[] content, int[] footnotes, int height, bool ends_by_force)
    blank := false
    chapter_start := false
    serial := 0
    body_number := 0
    display := ""
    header := ""
    footer := ""
    string[] body := []

Page[] choose_pages(LayoutBlock[] blocks, int[] footnote_heights, int height, int orphan, int widow)
    Line[] lines := []
    Boundary[] boundaries := []
    for: index < int(blocks.len())
        block := blocks[index]
        start := int(lines.len())
        lines = lines.concat(block.lines)
        count := int(block.lines.len())
        if block.kind == "flow"
            for: 1 <= kept < count
                if kept >= orphan and count - kept >= widow
                    boundaries = boundaries.append(Boundary(start + kept, start + kept, false))
        if index + 1 == int(blocks.len())
            boundaries = boundaries.append(Boundary(int(lines.len()), int(lines.len()), true))
        else
            following := blocks[index + 1]
            end := int(lines.len())
            if not (block.list and following.list)
                lines = lines.append(Line(""))
            if following.page_break or block.kind != "heading"
                boundaries = boundaries.append(Boundary(end, int(lines.len()), following.page_break))
    Page[] pages := []
    start := 0
    first_boundary := 0
    while start < int(lines.len())
        notes := array(footnote_heights.len(), fill = false)
        note_height := 0
        scanned := start
        chosen := -1
        used := 0
        int[] chosen_notes := []
        for: first_boundary <= index < int(boundaries.len())
            boundary := boundaries[index]
            while scanned < boundary.end
                for number := lines[scanned].footnotes[]
                    if not notes[number]
                        notes[number] = true
                        note_height += footnote_heights[number]
                scanned += 1
            int[] page_notes := []
            for: number < int(notes.len())
                if notes[number]
                    page_notes = page_notes.append(number)
            current_height := boundary.end - start + note_height + (if page_notes.len() > 0 then 1 else 0)
            if current_height > height
                break
            chosen = index
            used = current_height
            chosen_notes = page_notes
            if boundary.forced
                break
        boundary := boundaries[chosen]
        pages = pages.append(Page(lines[start:<boundary.end], chosen_notes, used, boundary.forced))
        start = boundary.next_start
        first_boundary = chosen + 1
    return pages
