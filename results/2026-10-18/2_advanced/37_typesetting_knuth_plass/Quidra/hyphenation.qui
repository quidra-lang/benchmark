bool is_letter(string character)
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".contains(character)

string lower(string text)
    string upper_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower_letters = "abcdefghijklmnopqrstuvwxyz"
    string result = ""
    for int index < int(len(text))
        string character = text[index]
        for int letter < 26
            if character == upper_letters[letter]
                character = lower_letters[letter]
                break
        result += character
    return result

string upper(string text)
    string upper_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower_letters = "abcdefghijklmnopqrstuvwxyz"
    string result = ""
    for int index < int(len(text))
        string character = text[index]
        for int letter < 26
            if character == lower_letters[letter]
                character = upper_letters[letter]
                break
        result += character
    return result

class Point(int position, bool append_hyphen)

class Dictionary(int left_min, int right_min)
    string[] words = []
    int[][] points = []

    void .register(string spelling)
        string[] parts = spelling.split("-")
        int position = 0
        int[] splits = []
        for int index < int(len(parts)) - 1
            position += int(len(parts[index]))
            splits = splits.append(position)
        string word = parts.join("")
        int selected = -1
        for int index < int(len(words))
            if words[index] == word
                selected = index
        if selected < 0
            words = words.append(word)
            points = points.append(splits)
        else
            points[selected] = splits

    Point[] split_points(string word)
        int first = 0
        int last = int(len(word))
        while first < last and not is_letter(word[first])
            first += 1
        while last > first and not is_letter(word[last - 1])
            last -= 1
        string core = word[first:<last]
        bool letters = len(core) > 0
        for int index < int(len(core))
            letters = letters and is_letter(core[index])
        bool[] found = array(len(word) + 1, fill = false)
        bool[] appended = array(len(word) + 1, fill = false)
        if letters
            string lowered = lower(core)
            for int index < int(len(words))
                if words[index] == lowered
                    for int position = points[index][]
                        if position >= left_min and int(len(core)) - position >= right_min
                            found[first + position] = true
                            appended[first + position] = true
        for 1 <= int index < int(len(word)) - 1
            if word[index] == "-" and is_letter(word[index - 1]) and is_letter(word[index + 1])
                found[index + 1] = true
                appended[index + 1] = false
        Point[] result = []
        for 1 <= int index < int(len(word))
            if found[index]
                result = result.append(Point(index, appended[index]))
        return result
