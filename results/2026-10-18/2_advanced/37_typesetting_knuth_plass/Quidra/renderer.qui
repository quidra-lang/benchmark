public import page = "./page_builder.qui"

string replace(string text, string pattern, string replacement)
    result := ""
    position := 0
    width := int(len(pattern))
    while position < int(len(text))
        if position + width <= int(len(text)) and text[position:<position + width] == pattern
            result += replacement
            position += width
        else
            result += text[position]
            position += 1
    return result

string trim_right(string text)
    end := int(len(text))
    while end > 0 and text[end - 1] == " "
        end -= 1
    return text[0:<end]

string display_line(string[] pieces, int slack, string alignment, bool last)
    displayed := [for piece := pieces[] then replace(piece, "~", " ")]
    text := displayed.join(" ")
    if slack <= 0
        return text
    gaps := int(len(displayed)) - 1
    if alignment == "justify" and not last and gaps > 0
        text = displayed[0]
        for: 1 <= index < int(len(displayed))
            spaces := slack / gaps + 1 + (if index - 1 < slack % gaps then 1 else 0)
            text += string.repeat(" ", nat(spaces)) + displayed[index]
        return text
    if alignment == "right"
        return string.repeat(" ", nat(slack)) + text
    if alignment == "center"
        return string.repeat(" ", nat(slack / 2)) + text
    return text

string[] format_table(string[][] rows, string columns, string caption, string number)
    widths := array(len(columns), fill = 0)
    for row := rows[]
        for: index < int(len(columns))
            if int(len(row[index])) > widths[index]
                widths[index] = int(len(row[index]))
    string[] lines := []
    if caption != ""
        lines = lines.append("Table {number}. {caption}")
    for: row_index < int(len(rows))
        string[] cells := []
        for: index < int(len(columns))
            text := rows[row_index][index]
            missing := widths[index] - int(len(text))
            cell := ""
            if columns[index] == "l"
                cell = text + string.repeat(" ", nat(missing))
            elif columns[index] == "r"
                cell = string.repeat(" ", nat(missing)) + text
            else
                cell = string.repeat(" ", nat(missing / 2)) + text + string.repeat(" ", nat(missing - missing / 2))
            cells = cells.append(cell)
        lines = lines.append(trim_right(cells.join(" | ")))
        if row_index == 0
            rule := [for width := widths[] then string.repeat("-", nat(width))]
            lines = lines.append(rule.join("-+-"))
    return lines

string running_head(string[] fields, string[] values, int width, int serial)
    string[] expanded := []
    names := ["page", "pages", "chapter", "section"]
    for field := fields[]
        text := field
        for: index < 4
            text = replace(text, "{{" + names[index] + "}}", values[index])
        expanded = expanded.append(text)
    if serial % 2 == 0
        saved := expanded[0]
        expanded[0] = expanded[2]
        expanded[2] = saved
    line := array(nat(width), fill = " ")
    starts := [0, (width - int(len(expanded[1]))) / 2, width - int(len(expanded[2]))]
    for: index < 3
        for: position < int(len(expanded[index]))
            line[starts[index] + position] = expanded[index][position]
    return trim_right(line.join(""))

string[] pages_lines(page.Page[] pages)
    string[] lines := []
    for sheet := pages[]
        lines = lines.concat(["--- page {sheet.serial} ---", sheet.header, ""]).concat(sheet.body).concat(["", sheet.footer])
    return lines
