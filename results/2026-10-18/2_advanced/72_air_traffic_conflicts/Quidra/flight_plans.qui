int integer(string text)
    int result = int.parse(text)
    return result

string[] lines(string name)
    return [for string line = file.read("input/" + name).split(NL)[] if line != "" then line]

class Aircraft(string name, int climb, int descent, int minimum)
class Waypoint(int x, int y, int level)
class Plan(string callsign, int type_index, int departure, int level, int initial_speed, int speed, Waypoint[] waypoints, int delay, int offset, string[] history)
class Sector(string name, int x1, int y1, int x2, int y2, int lower, int upper, int capacity)
class Settings(int dh, int dv, int lookahead, int max_delay, int level_min, int level_max, int sample_start, int sample_end, int[] radar, int[] snapshots, int leader, int alert)
class Input(Plan[] plans, Aircraft[] aircraft_types, Sector[] sectors, Settings settings)

int[] level_list(Plan plan)
    int[] result = [plan.level + plan.offset]
    for Waypoint point = plan.waypoints[]
        if point.level >= 0
            result = result.append(point.level + plan.offset)
    return result

Input read_inputs()
    Aircraft[] aircraft_types = []
    string[] type_names = []
    for string line = lines("aircraft.txt")[]
        string[] fields = line.split(" ")
        aircraft_types = aircraft_types.append(Aircraft(fields[0], integer(fields[1]), integer(fields[2]), integer(fields[3])))
        type_names = type_names.append(fields[0])
    Sector[] sectors = []
    for string line = lines("sectors.txt")[]
        string[] fields = line.split(" ")
        sectors = sectors.append(Sector(fields[0], integer(fields[1]), integer(fields[2]), integer(fields[3]), integer(fields[4]), integer(fields[5]), integer(fields[6]), integer(fields[7])))
    string[] raw = lines("flights.csv")
    Plan[] unordered = []
    string[] callsigns = []
    for string line = raw[1:<int(len(raw))][]
        string[] fields = line.split(",")
        int type_index = -1
        for int i < int(len(type_names))
            if type_names[i] == fields[1]
                type_index = i
        Waypoint[] waypoints = []
        for string item = fields[5].split(" ")[]
            string[] coordinates = item.split(":")
            int level = if len(coordinates) == 3 then integer(coordinates[2]) else -1
            waypoints = waypoints.append(Waypoint(integer(coordinates[0]), integer(coordinates[1]), level))
        int speed = integer(fields[4])
        unordered = unordered.append(Plan(fields[0], type_index, integer(fields[2]), integer(fields[3]), speed, speed, waypoints, 0, 0, []))
        callsigns = callsigns.append(fields[0])
    Plan[] plans = []
    for string callsign = callsigns.sorted()[]
        for Plan plan = unordered[]
            if plan.callsign == callsign
                plans = plans.append(plan)
    int[][] values = [for string line = lines("params.txt")[] then [for string field = line.split(" ")[1:<int(len(line.split(" ")))][] then integer(field)]]
    Settings settings = Settings(values[0][0], values[0][1], values[1][0], values[2][0], values[3][0], values[3][1], values[4][0], values[4][1], values[5], values[6], values[7][0], values[8][0])
    return Input(plans, aircraft_types, sectors, settings)
