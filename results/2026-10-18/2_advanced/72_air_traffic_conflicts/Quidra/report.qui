import math

string number(real64 value, int digits)
    int scale := 10 ^ digits
    real64 magnitude := if value < 0.0 then -value else value
    int units := math.floor(magnitude * real64(scale) + 0.5)
    string sign := if value < 0.0 and units != 0 then "-" else ""
    string tail := (units % scale).string()
    return sign + (units / scale).string() + "." + string.repeat("0", nat(digits - int(len(tail)))) + tail

string signed_integer(int value)
    return (if value > 0 then "+" else "") + value.string()

string[] frame(string[] rows, int columns)
    string border := "+" + string.repeat("-", nat(columns)) + "+"
    return [border].concat([for string row := rows[] then "|" + row + "|"]).append(border)

void write_lines(string name, string[] lines)
    writer1 := file.write("output/" + name)
    .writer1(lines.join(NL) + NL)
