import math

string number(real64 value, int digits)
    scale := 10 ^ digits
    magnitude := if value < 0.0 then -value else value
    units := math.floor(magnitude * real64(scale) + 0.5)
    sign := if value < 0.0 and units != 0 then "-" else ""
    tail := string(units % scale)
    return sign + string(units / scale) + "." + "0" * nat(digits - int(tail.len())) + tail

string signed_integer(int value)
    return (if value > 0 then "+" else "") + string(value)

string[] frame(string[] rows, int columns)
    string border := "+" + "-" * nat(columns) + "+"
    return [border].concat([for row := rows[] then "|" + row + "|"]).append(border)

void write_lines(string name, string[] lines)
    writer1 := file.write("output/" + name)
    .writer1(lines.join(NL) + NL)
