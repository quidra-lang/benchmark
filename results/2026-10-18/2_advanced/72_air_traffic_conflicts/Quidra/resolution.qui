import flight_plans = "./flight_plans.qui"

class Manoeuvre(string name, int amount)
class Proposal(flight_plans.Plan plan, bool feasible)

Manoeuvre[] manoeuvres(int max_delay)
    Manoeuvre[] result = [Manoeuvre("level_up", 10), Manoeuvre("level_down", -10), Manoeuvre("speed_down", 0)]
    for 60 <= int delay <= max_delay step 60
        result = result.append(Manoeuvre("delay_{delay}", delay))
    return result

Proposal propose(flight_plans.Plan plan, Manoeuvre manoeuvre, flight_plans.Aircraft aircraft, flight_plans.Settings settings)
    flight_plans.Plan changed = plan
    if manoeuvre.name == "level_up" or manoeuvre.name == "level_down"
        changed.offset += manoeuvre.amount
        for int level = flight_plans.level_list(changed)[]
            if level < settings.level_min or level > settings.level_max
                return Proposal(changed, false)
    elif manoeuvre.name == "speed_down"
        changed.speed = changed.speed * 9 / 10
        if changed.speed < aircraft.minimum
            return Proposal(changed, false)
    else
        changed.delay += manoeuvre.amount
    return Proposal(changed, true)

int[] priority_order(int first, int second, flight_plans.Plan[] plans)
    int a = plans[first].departure + plans[first].delay
    int b = plans[second].departure + plans[second].delay
    return if a > b or (a == b and first > second) then [first, second] else [second, first]
