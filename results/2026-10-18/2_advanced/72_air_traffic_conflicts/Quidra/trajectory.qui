import math
import flight_plans = "./flight_plans.qui"

real64 square_root(real64 value)
    result := math.sqrt(value)
    return result

class Segment(int number, int leg, string phase, real64 start, real64 end, real64[] position, real64[] velocity, real64[] endpoint)
class Path(Segment[] segments, real64 length, real64 arrival)

real64[] position_at(Segment segment, real64 moment)
    elapsed := moment - segment.start
    return [for axis := (0:<3)[] then segment.position[axis] + segment.velocity[axis] * elapsed]

int segment_at(Path path, real64 moment)
    for: i < int(#path.segments)
        if path.segments[i].start <= moment and moment < path.segments[i].end
            return i
    return -1

Path build(flight_plans.Plan plan, flight_plans.Aircraft aircraft)
    Segment[] segments := []
    moment := real64(plan.departure + plan.delay)
    level := plan.level + plan.offset
    real64 route_length := 0.0
    for: 1 <= leg < int(#plan.waypoints)
        flight_plans.Waypoint first := plan.waypoints[leg - 1]
        flight_plans.Waypoint last := plan.waypoints[leg]
        dx := last.x - first.x
        dy := last.y - first.y
        length := square_root(real64(dx * dx + dy * dy)) / 10.0
        route_length += length
        duration := length * 3600.0 / real64(plan.speed)
        vx := (real64(dx) / 10.0) / duration
        vy := (real64(dy) / 10.0) / duration
        xp := real64(first.x) / 10.0
        yp := real64(first.y) / 10.0
        xq := real64(last.x) / 10.0
        yq := real64(last.y) / 10.0
        target := if last.level < 0 then level else last.level + plan.offset
        if target == level
            segments = segments.append(Segment(int(#segments) + 1, leg, "LVL", moment, moment + duration, [xp, yp, real64(level * 100)], [vx, vy, 0.0], [xq, yq, real64(level * 100)]))
        else
            climbing := target > level
            rate := if climbing then aircraft.climb else aircraft.descent
            difference := if climbing then target - level else level - target
            change := real64(difference * 6000) / real64(rate)
            vz := real64(rate) / 60.0
            if not climbing
                vz = -vz
            xc := xp + vx * change
            yc := yp + vy * change
            segments = segments.append(Segment(int(#segments) + 1, leg, if climbing then "CLB" else "DES", moment, moment + change, [xp, yp, real64(level * 100)], [vx, vy, vz], [xc, yc, real64(target * 100)]))
            segments = segments.append(Segment(int(#segments) + 1, leg, "LVL", moment + change, moment + duration, [xc, yc, real64(target * 100)], [vx, vy, 0.0], [xq, yq, real64(target * 100)]))
        moment += duration
        level = target
    return Path(segments, route_length, moment)
