import math
import flight_plans = "./flight_plans.qui"

real64 square_root(real64 value)
    real64 result = math.sqrt(value)
    return result

class Segment(int number, int leg, string phase, real64 start, real64 end, real64[] position, real64[] velocity, real64[] endpoint)
class Path(Segment[] segments, real64 length, real64 arrival)

real64[] position_at(Segment segment, real64 moment)
    real64 elapsed = moment - segment.start
    return [for int axis < 3 then segment.position[axis] + segment.velocity[axis] * elapsed]

int segment_at(Path path, real64 moment)
    for int i < int(len(path.segments))
        if path.segments[i].start <= moment and moment < path.segments[i].end
            return i
    return -1

Path build(flight_plans.Plan plan, flight_plans.Aircraft aircraft)
    Segment[] segments = []
    real64 moment = real64(plan.departure + plan.delay)
    int level = plan.level + plan.offset
    real64 route_length = 0.0
    for 1 <= int leg < int(len(plan.waypoints))
        flight_plans.Waypoint first = plan.waypoints[leg - 1]
        flight_plans.Waypoint last = plan.waypoints[leg]
        int dx = last.x - first.x
        int dy = last.y - first.y
        real64 length = square_root(real64(dx * dx + dy * dy)) / 10.0
        route_length += length
        real64 duration = length * 3600.0 / real64(plan.speed)
        real64 vx = (real64(dx) / 10.0) / duration
        real64 vy = (real64(dy) / 10.0) / duration
        real64 xp = real64(first.x) / 10.0
        real64 yp = real64(first.y) / 10.0
        real64 xq = real64(last.x) / 10.0
        real64 yq = real64(last.y) / 10.0
        int target = if last.level < 0 then level else last.level + plan.offset
        if target == level
            segments = segments.append(Segment(int(len(segments)) + 1, leg, "LVL", moment, moment + duration, [xp, yp, real64(level * 100)], [vx, vy, 0.0], [xq, yq, real64(level * 100)]))
        else
            bool climbing = target > level
            int rate = if climbing then aircraft.climb else aircraft.descent
            int difference = if climbing then target - level else level - target
            real64 change = real64(difference * 6000) / real64(rate)
            real64 vz = real64(rate) / 60.0
            if not climbing
                vz = -vz
            real64 xc = xp + vx * change
            real64 yc = yp + vy * change
            segments = segments.append(Segment(int(len(segments)) + 1, leg, if climbing then "CLB" else "DES", moment, moment + change, [xp, yp, real64(level * 100)], [vx, vy, vz], [xc, yc, real64(target * 100)]))
            segments = segments.append(Segment(int(len(segments)) + 1, leg, "LVL", moment + change, moment + duration, [xc, yc, real64(target * 100)], [vx, vy, 0.0], [xq, yq, real64(target * 100)]))
        moment += duration
        level = target
    return Path(segments, route_length, moment)
