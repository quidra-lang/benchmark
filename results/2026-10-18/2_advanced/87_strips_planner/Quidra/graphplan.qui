import pddl = "./pddl_parser.qui"
import grounding = "./grounding.qui"
import search = "./search.qui"

class Pair(int first, int second)
class Element(int action, int[] pre, int[] add, int[] del)
class Level(Element[] elements, Pair[] mutexes)
class Extraction(Level[] levels = [], set.Set<string> memo = set.Set<string>(), int searched = 0, int hits = 0, int tried = 0)
class GraphResult(search.Result result, int[][] layers, string[] records, int hits)

Pair pair(int first, int second)
    return if first < second then Pair(first, second) else Pair(second, first)

bool compatible(const int[] facts, const Pair[] mutexes)
    for int first = facts[]
        for int second = facts[]
            if first != second and pddl.has(mutexes, pair(first, second))
                return false
    return true

int[][] | none extract(Extraction &context, int level_number, const int[] goals);

int[][] | none assign(Extraction &context, int level_number, const int[] goals, int position, const int[] chosen)
    Level level = context.levels[level_number - 1]
    int current = position
    while current < int(len(goals))
        bool covered = false
        for int index = chosen[]
            if pddl.has(level.elements[index].add, goals[current])
                covered = true
        if not covered
            break
        current += 1
    if current == int(len(goals))
        int[] previous = []
        int[] layer_actions = []
        for int index = chosen[]
            previous = pddl.unique(previous.concat(level.elements[index].pre))
            if level.elements[index].action >= 0
                layer_actions = layer_actions.append(level.elements[index].action)
        match extract(&context, level_number - 1, previous.sorted())
            int[][] plan
                return plan.append(layer_actions.sorted())
            none
                return none
    int goal = goals[current]
    int[] achievers = []
    for int index < int(len(level.elements))
        Element entry = level.elements[index]
        if entry.action < 0 and pddl.has(entry.add, goal)
            achievers = achievers.append(index)
    for int index < int(len(level.elements))
        Element entry = level.elements[index]
        if entry.action >= 0 and pddl.has(entry.add, goal)
            achievers = achievers.append(index)
    for int index = achievers[]
        bool eligible = true
        for int other = chosen[]
            if index != other and pddl.has(level.mutexes, pair(index, other))
                eligible = false
        if eligible
            context.tried += 1
            match assign(&context, level_number, goals, current + 1, chosen.append(index))
                int[][] plan
                    return plan
                none
                    continue
    return none

int[][] | none extract(Extraction &context, int level_number, const int[] goals)
    if level_number == 0
        return []
    string key = "{level_number}:{search.state_key(goals)}"
    if context.memo.has(key)
        context.hits += 1
        return none
    context.searched += 1
    match assign(&context, level_number, goals, 0, [])
        int[][] plan
            return plan
        none
            .context.memo.add(key)
            return none

GraphResult run(const grounding.Action[] actions, const int[] initial, const int[] goals, int limit)
    Extraction context = Extraction()
    int[] facts = initial
    Pair[] mutexes = []
    int previous_facts = -1
    int previous_mutexes = -1
    string[] records = []
    int[][] answer = []
    string status = "level limit"
    for int level_number < limit + 1
        records = records.append("fact level {level_number}: facts={len(facts)} mutexes={len(mutexes)}")
        bool attempted = pddl.contains_all(facts, goals) and compatible(goals, mutexes)
        if attempted
            int before_searched = context.searched
            int before_hits = context.hits
            bool success = false
            match extract(&context, level_number, goals.sorted())
                int[][] plan
                    answer = plan
                    success = true
                none
                    success = false
            string result_word = if success then "success" else "fail"
            records = records.append("extract level {level_number}: {result_word} searched={context.searched - before_searched} memo_hits={context.hits - before_hits}")
            if success
                status = "solved"
                break
        elif previous_facts == int(len(facts)) and previous_mutexes == int(len(mutexes))
            status = "unreachable"
            break
        if level_number == limit
            break
        previous_facts = int(len(facts))
        previous_mutexes = int(len(mutexes))
        Element[] elements = []
        for int index < int(len(actions))
            grounding.Action action = actions[index]
            if pddl.contains_all(facts, action.pre) and compatible(action.pre, mutexes)
                elements = elements.append(Element(index, action.pre, action.add, action.del))
        int real_count = int(len(elements))
        int[] ordered_facts = facts.sorted()
        for int fact = ordered_facts[]
            elements = elements.append(Element(-1, [fact], [fact], []))
        Pair[] action_mutexes = []
        for int first < int(len(elements))
            for first + 1 <= int second < int(len(elements))
                Element left = elements[first]
                Element right = elements[second]
                bool conflict = pddl.overlaps(left.del, right.pre.concat(right.add)) or pddl.overlaps(right.del, left.pre.concat(left.add))
                for int left_pre = left.pre[]
                    for int right_pre = right.pre[]
                        if left_pre != right_pre and pddl.has(mutexes, pair(left_pre, right_pre))
                            conflict = true
                if conflict
                    action_mutexes = action_mutexes.append(pair(first, second))
        records = records.append("action level {level_number}: actions={real_count} noops={len(facts)} mutexes={len(action_mutexes)}")
        int[] next = []
        for Element entry = elements[]
            next = pddl.unique(next.concat(entry.add))
        next = next.sorted()
        Pair[] next_mutexes = []
        for int first < int(len(next))
            for first + 1 <= int second < int(len(next))
                bool impossible = true
                for int left < int(len(elements))
                    if not pddl.has(elements[left].add, next[first])
                        continue
                    for int right < int(len(elements))
                        if pddl.has(elements[right].add, next[second]) and (left == right or not pddl.has(action_mutexes, pair(left, right)))
                            impossible = false
                if impossible
                    next_mutexes = next_mutexes.append(pair(next[first], next[second]))
        context.levels = context.levels.append(Level(elements, action_mutexes))
        facts = next
        mutexes = next_mutexes
    int[] flat = []
    for int[] layer = answer[]
        flat = flat.concat(layer)
    return GraphResult(search.Result(status, flat, context.searched, context.tried), answer, records, context.hits)
