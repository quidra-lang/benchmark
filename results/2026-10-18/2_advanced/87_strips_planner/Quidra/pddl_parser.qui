class Expression(string word, int[] children = [])
class Syntax(Expression[] nodes = [], int[] roots = [])
class Atom(string predicate, string[] terms = [])
    string text()
        string[] words = [predicate]
        words = words.concat(terms)
        return "({words.join(" ")})"

class Literal(Atom atom, bool negative = false)
    string text()
        return if negative then "(not {atom.text()})" else atom.text()

class Typed(string name, string type)
class Predicate(string name, string[] types)
class Schema(string name, Typed[] parameters = [], Literal[] pre = [], Literal[] effects = [], int cost = 1)
class Domain(string name, string[] type_order = ["object"], map.Map<string, string> parents = map.Map<string, string>(), Predicate[] predicates = [], Schema[] actions = [], string[] diagnostics = [])
class Problem(string name, Typed[] objects = [], Atom[] initial = [], Atom[] goals = [], string[] diagnostics = [])

bool has<T>(const T[] items, T sought)
    for T item = items[]
        if item == sought
            return true
    return false

T[] unique<T>(const T[] items)
    T[] result = []
    for T item = items[]
        if not has(result, item)
            result = result.append(item)
    return result

T[] subtract<T>(const T[] first, const T[] second)
    T[] result = []
    for T item = first[]
        if not has(second, item)
            result = result.append(item)
    return result

T[] intersect<T>(const T[] first, const T[] second)
    T[] result = []
    for T item = first[]
        if has(second, item)
            result = result.append(item)
    return result

bool contains_all<T>(const T[] items, const T[] required)
    for T item = required[]
        if not has(items, item)
            return false
    return true

bool overlaps<T>(const T[] first, const T[] second)
    for T item = first[]
        if has(second, item)
            return true
    return false

int compare(const int[] first, const int[] second)
    int count = if len(first) < len(second) then int(len(first)) else int(len(second))
    for int position < count
        if first[position] != second[position]
            return if first[position] < second[position] then -1 else 1
    return if len(first) < len(second) then -1 elif len(first) > len(second) then 1 else 0

string | error required(const map.Map<string, string> values, string key)
    match values.get(key)
        string found
            return found
        none
            return error("missing binding {key}")

Atom replace(const Atom original, const map.Map<string, string> values)
    string[] terms = []
    for string term = original.terms[]
        string value = required(values, term)
        terms = terms.append(value)
    return Atom(original.predicate, terms)

Literal substitute(const Literal original, const map.Map<string, string> values)
    return Literal(replace(original.atom, values), original.negative)

int read_expression(const string[] tokens, int &position, Syntax &syntax)
    string token = tokens[position]
    position += 1
    int[] children = []
    if token == "("
        while tokens[position] != ")"
            int child = read_expression(tokens, &position, &syntax)
            children = children.append(child)
        position += 1
        token = ""
    int index = int(len(syntax.nodes))
    syntax.nodes = syntax.nodes.append(Expression(token, children))
    return index

Syntax expressions(string path)
    string text = file.read(path)
    string[] tokens = []
    string[] lines = text.split(NL)
    for string line = lines[]
        string word = ""
        for int position < int(len(line))
            string character = line[position]
            if character == ";"
                break
            if character == " " or character == "(" or character == ")"
                if word != ""
                    tokens = tokens.append(word)
                    word = ""
                if character != " "
                    tokens = tokens.append(character)
            else
                word += character
        if word != ""
            tokens = tokens.append(word)
    Syntax syntax = Syntax()
    int position = 0
    while position < int(len(tokens))
        int root = read_expression(tokens, &position, &syntax)
        syntax.roots = syntax.roots.append(root)
    return syntax

Typed[] typed(const Syntax syntax, const int[] nodes)
    Typed[] result = []
    string[] pending = []
    int position = 0
    while position < int(len(nodes))
        string word = syntax.nodes[nodes[position]].word
        if word == "-"
            position += 1
            string type = syntax.nodes[nodes[position]].word
            for string name = pending[]
                result = result.append(Typed(name, type))
            pending = []
        else
            pending = pending.append(word)
        position += 1
    for string name = pending[]
        result = result.append(Typed(name, "object"))
    return result

int[] conjunction(const Syntax syntax, int node)
    int[] children = syntax.nodes[node].children
    if syntax.nodes[children[0]].word == "and"
        return children[1:<int(len(children))]
    return [node]

Atom atom(const Syntax syntax, int node)
    int[] children = syntax.nodes[node].children
    string[] terms = []
    for 1 <= int position < int(len(children))
        terms = terms.append(syntax.nodes[children[position]].word)
    return Atom(syntax.nodes[children[0]].word, terms)

Literal literal(const Syntax syntax, int node)
    int[] children = syntax.nodes[node].children
    if syntax.nodes[children[0]].word == "not"
        return Literal(atom(syntax, children[1]), true)
    return Literal(atom(syntax, node))

Domain read_domain()
    Syntax syntax = expressions("input/domain.txt")
    int[] root = syntax.nodes[syntax.roots[0]].children
    Domain domain = Domain(syntax.nodes[syntax.nodes[root[1]].children[1]].word)
    for 2 <= int index < int(len(root))
        int[] section = syntax.nodes[root[index]].children
        string heading = syntax.nodes[section[0]].word
        if heading == ":types"
            for 1 <= int position < int(len(section))
                string word = syntax.nodes[section[position]].word
                if word != "-" and not has(domain.type_order, word)
                    domain.type_order = domain.type_order.append(word)
                    if word != "object"
                        .domain.parents.set(word, "object")
            Typed[] declared = typed(syntax, section[1:<int(len(section))])
            for Typed entry = declared[]
                .domain.parents.set(entry.name, entry.type)
        elif heading == ":predicates"
            for 1 <= int position < int(len(section))
                int[] declaration = syntax.nodes[section[position]].children
                Typed[] arguments = typed(syntax, declaration[1:<int(len(declaration))])
                string[] types = []
                for Typed entry = arguments[]
                    types = types.append(entry.type)
                domain.predicates = domain.predicates.append(Predicate(syntax.nodes[declaration[0]].word, types))
        elif heading == ":action"
            Schema action = Schema(syntax.nodes[section[1]].word)
            int position = 2
            while position < int(len(section))
                string keyword = syntax.nodes[section[position]].word
                int value = section[position + 1]
                if keyword == ":parameters"
                    action.parameters = typed(syntax, syntax.nodes[value].children)
                elif keyword == ":precondition"
                    int[] conditions = conjunction(syntax, value)
                    for int condition = conditions[]
                        action.pre = action.pre.append(literal(syntax, condition))
                else
                    int[] effects = conjunction(syntax, value)
                    for int effect = effects[]
                        int[] children = syntax.nodes[effect].children
                        if syntax.nodes[children[0]].word == "increase"
                            action.cost = int.parse(syntax.nodes[children[2]].word)
                        else
                            action.effects = action.effects.append(literal(syntax, effect))
                position += 2
            domain.actions = domain.actions.append(action)
    return domain

Problem[] read_problems()
    Syntax syntax = expressions("input/problems.txt")
    Problem[] problems = []
    for int node = syntax.roots[]
        int[] root = syntax.nodes[node].children
        Problem problem = Problem(syntax.nodes[syntax.nodes[root[1]].children[1]].word)
        for 2 <= int position < int(len(root))
            int[] section = syntax.nodes[root[position]].children
            string heading = syntax.nodes[section[0]].word
            if heading == ":objects"
                problem.objects = typed(syntax, section[1:<int(len(section))])
            elif heading == ":init"
                for 1 <= int item < int(len(section))
                    problem.initial = problem.initial.append(atom(syntax, section[item]))
            elif heading == ":goal"
                int[] goals = conjunction(syntax, section[1])
                for int goal = goals[]
                    problem.goals = problem.goals.append(atom(syntax, goal))
        problems = problems.append(problem)
    return problems
