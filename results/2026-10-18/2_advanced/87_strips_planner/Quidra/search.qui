import pddl = "./pddl_parser.qui"
import grounding = "./grounding.qui"
import heuristics = "./heuristics.qui"

class Result(string status, int[] plan = [], int expanded = 0, int generated = 0)
class Node(int[] state, int cost, int depth, int parent = -1, int action = -1)
class Key(int score, int estimate, int serial)
class Local(int[] state, int[] path)

bool applicable(const grounding.Action action, const int[] state)
    return pddl.contains_all(state, action.pre) and not pddl.overlaps(state, action.neg)

int[] apply(const grounding.Action action, const int[] state)
    return pddl.unique(pddl.subtract(state, action.del).concat(action.add)).sorted()

string state_key(const int[] state)
    string[] words = []
    int[] ordered = state.sorted()
    for int fact = ordered[]
        words = words.append(fact.string())
    return words.join(",")

bool less(const Key first, const Key second)
    return first.score < second.score or (first.score == second.score and (first.estimate < second.estimate or (first.estimate == second.estimate and first.serial < second.serial)))

void push(Key[] &heap, const Key entry)
    heap = heap.append(entry)
    int position = int(len(heap)) - 1
    while position > 0
        int parent = (position - 1) / 2
        if not less(heap[position], heap[parent])
            break
        Key saved = heap[parent]
        heap[parent] = heap[position]
        heap[position] = saved
        position = parent

Key pop(Key[] &heap)
    Key result = heap[0]
    int count = int(len(heap)) - 1
    Key last = heap[count]
    heap = heap[0:<count]
    if count == 0
        return result
    heap[0] = last
    int position = 0
    while position * 2 + 1 < count
        int child = position * 2 + 1
        if child + 1 < count and less(heap[child + 1], heap[child])
            child += 1
        if not less(heap[child], heap[position])
            break
        Key saved = heap[position]
        heap[position] = heap[child]
        heap[child] = saved
        position = child
    return result

Key priority(string algorithm, int cost, int depth, int estimate, int serial, int weight)
    int score = if algorithm == "bfs" then depth elif algorithm == "ucs" then cost elif algorithm == "gbfs" then estimate elif algorithm == "astar" then cost + estimate else cost + weight * estimate
    return Key(score, estimate, serial)

Result ehc(const grounding.Grounding graph, const int[] start, string heuristic, int budget)
    Result result = Result("stuck")
    int[] current = start
    int current_h = heuristics.value(graph, current, heuristic)
    if current_h >= heuristics.INFINITY
        result.status = "dead end"
        return result
    while true
        if pddl.contains_all(current, graph.goals)
            result.status = "solved"
            return result
        Local[] queue = [Local(current, [])]
        set.Set<string> visited = set.Set<string>()
        .visited.add(state_key(current))
        int position = 0
        bool improved = false
        while position < int(len(queue)) and not improved
            Local entry = queue[position]
            position += 1
            if result.expanded == budget
                result.status = "budget"
                return result
            result.expanded += 1
            heuristics.Relaxed relaxed_plan = heuristics.relaxed(graph, entry.state)
            for int action = relaxed_plan.helpful[]
                result.generated += 1
                int[] next = apply(graph.actions[action], entry.state)
                string key = state_key(next)
                if visited.has(key)
                    continue
                .visited.add(key)
                int estimate = heuristics.value(graph, next, heuristic)
                if estimate >= heuristics.INFINITY
                    continue
                int[] path = entry.path.append(action)
                if estimate < current_h
                    current = next
                    current_h = estimate
                    result.plan = result.plan.concat(path)
                    improved = true
                    break
                queue = queue.append(Local(next, path))
        if not improved
            return result

Result run(const grounding.Grounding graph, const int[] start, string algorithm, string heuristic, int budget, int weight)
    if algorithm == "ehc"
        return ehc(graph, start, heuristic, budget)
    Result result = Result("exhausted")
    int initial_h = heuristics.value(graph, start, heuristic)
    if initial_h >= heuristics.INFINITY
        result.status = "dead end"
        return result
    Node[] nodes = [Node(start, 0, 0)]
    Key[] frontier = [priority(algorithm, 0, 0, initial_h, 0, weight)]
    map.Map<string, int> table = map.Map<string, int>()
    .table.set(state_key(start), 0)
    bool reopening = algorithm == "ucs" or algorithm == "astar" or algorithm == "wastar"
    while len(frontier) > 0
        Key selected = pop(&frontier)
        Node node = nodes[selected.serial]
        if reopening
            match table.get(state_key(node.state))
                int old
                    if node.cost > old
                        continue
                none
                    continue
        if pddl.contains_all(node.state, graph.goals)
            result.status = "solved"
            int current = selected.serial
            int[] reversed = []
            while nodes[current].parent >= 0
                reversed = reversed.append(nodes[current].action)
                current = nodes[current].parent
            result.plan = reversed[::-1]
            return result
        if result.expanded == budget
            result.status = "budget"
            return result
        result.expanded += 1
        for int action < int(len(graph.actions))
            if not applicable(graph.actions[action], node.state)
                continue
            result.generated += 1
            int[] next = apply(graph.actions[action], node.state)
            int next_cost = node.cost + graph.actions[action].cost
            string key = state_key(next)
            bool discard = false
            match table.get(key)
                int old
                    discard = not reopening or old <= next_cost
                none
                    discard = false
            if discard
                continue
            .table.set(key, next_cost)
            int estimate = heuristics.value(graph, next, heuristic)
            if estimate >= heuristics.INFINITY
                continue
            int serial = int(len(nodes))
            nodes = nodes.append(Node(next, next_cost, node.depth + 1, selected.serial, action))
            push(&frontier, priority(algorithm, next_cost, node.depth + 1, estimate, serial, weight))
    return result
