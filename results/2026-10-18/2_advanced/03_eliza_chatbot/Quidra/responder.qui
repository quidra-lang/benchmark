import loader = "./script_loader.qui"

string[] binding(string[][] bindings, int number)
    return if 1 <= number <= int(len(bindings)) then bindings[number - 1] else []

string build_reply(string template, string[][] bindings, loader.Script script)
    string text = ""
    int position = 0
    while position < int(len(template))
        if position + 3 <= int(len(template)) and loader.is_reference(template[position:<position + 3])
            text += script.substitute(binding(bindings, int.parse(template[position + 1])), true).join(" ")
            position += 3
        else
            text += template[position]
            position += 1
    string[] words = []
    for string word = text.split(" ")[]
        if word != ""
            words = words.append(word)
    text = words.join(" ")
    if len(text) > 0
        for 0 <= int index < 26
            if text[0] == "abcdefghijklmnopqrstuvwxyz"[index]
                text = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"[index] + text[1:<len(text)]
                break
    return text

string[] restated_words(string[] arguments, string[][] bindings)
    string[] result = []
    for string argument = arguments[]
        if loader.is_reference(argument)
            result = result.concat(binding(bindings, int.parse(argument[1])))
        else
            result = result.append(argument)
    return result

string[] eliza_lines(string text)
    string[] words = []
    for string word = text.split(" ")[]
        if word != ""
            words = words.append(word)
    string[] result = []
    string line = "ELIZA:"
    for string word = words[]
        if len(result) == 0 and line == "ELIZA:"
            line += " " + word
        elif len(line) + 1 + len(word) <= 72
            line += " " + word
        else
            result = result.append(line)
            line = "       " + word
    return result.append(line)
