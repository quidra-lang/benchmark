import loader = "./script_loader.qui"

bool is_wildcard(string element)
    return element == "*" or element == "#" or element.starts_with("@")

bool fits(string element, string word, loader.Script script)
    if element == "#"
        return true
    if element.starts_with("@")
        return loader.has_word(script.group_words(element[1:<len(element)]), word)
    return element == word

class MatchResult(bool found, string[][] bindings = [])

MatchResult match_from(string[] pattern, string[] words, loader.Script script, int position, int start, string[][] bindings)
    if position == int(len(pattern))
        return MatchResult(start == int(len(words)), bindings)
    string element = pattern[position]
    if element == "*"
        for start <= int finish <= int(len(words))
            MatchResult result = match_from(pattern, words, script, position + 1, finish, bindings.append(words[start:<finish]))
            if result.found
                return result
    elif start < int(len(words)) and fits(element, words[start], script)
        string[][] next = if is_wildcard(element) then bindings.append([words[start]]) else bindings
        return match_from(pattern, words, script, position + 1, start + 1, next)
    return MatchResult(false)

MatchResult match_pattern(string[] pattern, string[] words, loader.Script script)
    return match_from(pattern, words, script, 0, 0, [])

bool element_covers(string earlier, string later, loader.Script script)
    if earlier == "#"
        return later != "*"
    if earlier.starts_with("@")
        string[] members = script.group_words(earlier[1:<len(earlier)])
        if later.starts_with("@")
            for string word = script.group_words(later[1:<len(later)])[]
                if not loader.has_word(members, word)
                    return false
            return true
        return loader.has_word(members, later)
    return earlier == later

bool covers_from(string[] earlier, string[] later, loader.Script script, int position, int start)
    if position == int(len(earlier))
        return start == int(len(later))
    if earlier[position] == "*"
        for start <= int finish <= int(len(later))
            if covers_from(earlier, later, script, position + 1, finish)
                return true
        return false
    return start < int(len(later)) and element_covers(earlier[position], later[start], script) and covers_from(earlier, later, script, position + 1, start + 1)

bool pattern_covers(string[] earlier, string[] later, loader.Script script)
    return covers_from(earlier, later, script, 0, 0)
