string[] symbol(int[][] cells)
    return [for int[] row := cells[] then [for int value := row[] then (if value == 1 then "#" else ".")].join("")]

string[] pbm(int[][] cells, int quiet, int scale)
    int size := int(len(cells))
    int width := (size + 2 * quiet) * scale
    string[] lines := ["P1", "{width} {width}"]
    for int py < width
        string row := ""
        int y := py / scale - quiet
        for int px < width
            int x := px / scale - quiet
            bool dark := x >= 0 and y >= 0 and x < size and y < size and cells[y][x] == 1
            row += if dark then "1" else "0"
        lines = lines.append(row)
    return lines
