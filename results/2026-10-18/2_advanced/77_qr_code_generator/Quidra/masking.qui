import math

class Penalty(int n1, int n2, int n3, int n4)

int total(Penalty penalty)
    return penalty.n1 + penalty.n2 + penalty.n3 + penalty.n4

bool condition(int mask, int x, int y)
    if mask == 0
        return (x + y) % 2 == 0
    if mask == 1
        return y % 2 == 0
    if mask == 2
        return x % 3 == 0
    if mask == 3
        return (x + y) % 3 == 0
    if mask == 4
        return (y / 2 + x / 3) % 2 == 0
    if mask == 5
        return (x * y) % 2 + (x * y) % 3 == 0
    if mask == 6
        return ((x * y) % 2 + (x * y) % 3) % 2 == 0
    return ((x + y) % 2 + (x * y) % 3) % 2 == 0

int[][] apply(int[][] cells, int[][] areas, int mask)
    result := cells
    for int y < int(len(cells))
        for int x < int(len(cells))
            if areas[y][x] == 0 and condition(mask, x, y)
                result[y][x] = 1 - result[y][x]
    return result

Penalty penalty(int[][] cells)
    size := int(len(cells))
    n1 := 0
    n2 := 0
    n3 := 0
    dark := 0
    for int y < size
        for int x < size
            dark += cells[y][x]
            if x + 1 < size and y + 1 < size and cells[y][x] == cells[y + 1][x] and cells[y][x] == cells[y][x + 1] and cells[y][x] == cells[y + 1][x + 1]
                n2 += 3
    for vertical := [false, true][]
        for int line < size
            bits := ""
            previous := -1
            run := 0
            for int position < size
                int value := if vertical then cells[position][line] else cells[line][position]
                bits += if value == 0 then "0" else "1"
                if value == previous
                    run += 1
                else
                    if run >= 5
                        n1 += run - 2
                    run = 1
                    previous = value
            if run >= 5
                n1 += run - 2
            for int start <= size - 11
                string window := bits[start:<start + 11]
                if window == "10111010000" or window == "00001011101"
                    n3 += 40
    int n4 := 10 * (math.abs(20 * dark - 10 * size * size) / (size * size))
    return Penalty(n1, n2, n3, n4)
