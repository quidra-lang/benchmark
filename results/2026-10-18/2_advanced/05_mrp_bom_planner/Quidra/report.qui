string money(int cents)
    string fraction = (cents % 100).string()
    if len(fraction) == 1
        fraction = "0" + fraction
    return "{cents / 100}.{fraction}"

int percent(int part, int whole)
    return (200 * part + whole) / (2 * whole)

string table_row(string label, int[] values, int width)
    string result = label
    while len(result) < 10
        result += " "
    for int value = values[]
        string cell = value.string()
        while int(len(cell)) < width
            cell = " " + cell
        result += cell
    return result

void write_report(string name, string[] lines)
    if not file.is_directory("output")
        file.mkdir("output")
    file.write("output/" + name, if len(lines) == 0 then "" else lines.join(NL) + NL)
