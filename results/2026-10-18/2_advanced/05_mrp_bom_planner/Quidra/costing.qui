import items = "./items.qui"
import bom = "./bom.qui"

class StandardCost(int material, int labor)
    int total = material + labor

int component_cost(bom.BomRow row, int cost)
    return (row.qty_per * (100 + row.scrap) * cost + 50) / 100

StandardCost[] standard_costs(items.Item[] inventory, bom.Bom graph, int[] planning_order)
    StandardCost[] result = array(len(inventory), fill = StandardCost(0, 0))
    int cursor = int(len(planning_order)) - 1
    while cursor >= 0
        int index = planning_order[cursor]
        int material = inventory[index].material
        int labor = inventory[index].labor
        for bom.BomRow row = graph.children(inventory[index].id)[]
            StandardCost child = result[items.index_of(inventory, row.child)]
            material += component_cost(row, child.material)
            labor += component_cost(row, child.labor)
        result[index] = StandardCost(material, labor)
        cursor -= 1
    return result

string[] abc_classes(int[] values)
    int[] order = []
    int total = 0
    for nat index < len(values)
        order = order.append(int(index))
        total += values[index]
    for 1 <= int offset < int(len(order))
        int current = order[offset]
        int cursor = offset
        while cursor > 0 and values[order[cursor - 1]] < values[current]
            order[cursor] = order[cursor - 1]
            cursor -= 1
        order[cursor] = current
    string[] result = array(len(values), fill = "C")
    int before = 0
    for int index = order[]
        if values[index] > 0
            if 100 * before < 80 * total
                result[index] = "A"
            elif 100 * before < 95 * total
                result[index] = "B"
        before += values[index]
    return result
