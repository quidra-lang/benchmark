class Item(string id, int lead_time, string rule, int first, int second, int safety_stock, int on_hand, int material, int labor, string description)
    string lot_label()
        if rule == "MIN"
            return "MIN {first}/{second}"
        return if rule == "LFL" then "LFL" else "{rule} {first}"

int index_of(Item[] inventory, string id)
    for nat index < len(inventory)
        if inventory[index].id == id
            return int(index)
    return -1

string[] ids(Item[] inventory)
    string[] result = []
    for Item item = inventory[]
        result = result.append(item.id)
    return result.sorted()

class InputRow(int line, string[] fields)

InputRow[] read_rows(string name)
    string text = file.read("input/" + name)
    string[] lines = text.split(NL)
    InputRow[] result = []
    for 1 <= int index < int(len(lines)) - 1
        result = result.append(InputRow(index + 1, lines[index].split(",")))
    return result

Item[] read_items(string[] &errors)
    Item[] accepted = []
    for InputRow row = read_rows("items.csv")[]
        string[] fields = row.fields
        string id = fields[0]
        string rule = fields[2]
        string parameter = fields[3]
        string failure = ""
        int[] values = []
        if index_of(accepted, id) >= 0
            failure = "duplicate item {id}"
        elif rule != "LFL" and rule != "FOQ" and rule != "POQ" and rule != "MIN"
            failure = "unknown lot rule {rule}"
        else
            for string part = parameter.split("/")[]
                values = values.append(int.parse(part))
            bool valid = false
            if rule == "MIN"
                valid = len(values) == 2 and values[0] >= 1 and values[1] >= 1
            elif rule == "LFL"
                valid = len(values) == 1 and values[0] == 0
            else
                valid = len(values) == 1 and values[0] >= 1
            if not valid
                failure = "bad lot parameter {parameter} for {rule}"
        if failure != ""
            errors = errors.append("items.csv line {row.line}: {failure}")
        else
            accepted = accepted.append(Item(id, int.parse(fields[1]), rule, values[0], if len(values) == 2 then values[1] else 0, int.parse(fields[4]), int.parse(fields[5]), int.parse(fields[6]), int.parse(fields[7]), fields[8]))
    Item[] result = []
    for string id = ids(accepted)[]
        result = result.append(accepted[index_of(accepted, id)])
    return result
