string ratio(int numerator, int denominator)
    if denominator == 0
        return "-"
    int rounded = (20000 * numerator + denominator) / (2 * denominator)
    string fraction = (rounded % 10000).string()
    return (rounded / 10000).string() + "." + string.repeat("0", nat(4 - int(len(fraction)))) + fraction

string[] header(string[] names, int[] lengths)
    string[] lines = [["@HD", "VN:1.6", "SO:unsorted"].join(HT)]
    for int i < int(len(names))
        lines = lines.append(["@SQ", "SN:" + names[i], "LN:{lengths[i]}"].join(HT))
    return lines.append(["@PG", "ID:fm_index_aligner", "PN:fm_index_aligner", "VN:1.0"].join(HT))

string unmapped(string name, string bases, string quality, string reason)
    return [name, "4", "*", "0", "0", "*", "*", "0", "0", bases, quality, "YM:Z:" + reason].join(HT)

string mapped(string name, int flag, string reference, int position, int mapq, string cigar, string bases, string quality, int nm, string md, int score, int x0, int x1, string method, string alternatives)
    string[] fields = [name, flag.string(), reference, (position + 1).string(), mapq.string(), cigar, "*", "0", "0", bases, quality, "NM:i:{nm}", "MD:Z:" + md, "AS:i:{score}", "X0:i:{x0}", "X1:i:{x1}", "YM:Z:" + method]
    if alternatives != ""
        fields = fields.append("XA:Z:" + alternatives)
    return fields.join(HT)

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + (if len(lines) == 0 then "" else NL))
