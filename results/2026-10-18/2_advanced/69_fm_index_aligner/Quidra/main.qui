import sequence_io = "./sequence_io.qui"
import suffix_array = "./suffix_array.qui"
import fm_index = "./fm_index.qui"
import search = "./search.qui"
import sam_writer = "./sam_writer.qui"

const int unreachable = -1000000

int minimum(int first, int second)
    return if first < second then first else second

int maximum(int first, int second)
    return if first > second then first else second

int total(int[] values)
    int result = 0
    for int value = values[]
        result += value
    return result

bool includes(string text, string character)
    for int i < int(len(text))
        if text[i] == character
            return true
    return false

int count_character(string text, string character)
    int count = 0
    for int i < int(len(text))
        if text[i] == character
            count += 1
    return count

string integer_key(int[] values)
    return [for int value = values[] then value.string()].join(",")

class ReferenceText(sequence_io.Reference[] references)
    int[] offsets = []
    int offset = 0
    for sequence_io.Reference reference = references[]
        offsets = offsets.append(offset)
        offset += int(len(reference.bases)) + 1
    string text = [for sequence_io.Reference reference = references[] then reference.bases].join("#") + "$"
    string reverse = text[0:<int(len(text)) - 1][::-1] + "$"

    int[] position(int absolute_position)
        for int r < int(len(references))
            if offsets[r] <= absolute_position and absolute_position < offsets[r] + int(len(references[r].bases))
                return [r, absolute_position - offsets[r]]
        return [-1, -1]

    string label(int absolute_position)
        int[] located = position(absolute_position)
        return if located[0] < 0 then "*" else references[located[0]].name + ":{located[1] + 1}"

int[][] operation_runs(string operations)
    int[][] runs = []
    string alphabet = "MID"
    for int i < int(len(operations))
        int operation = 0
        for int j < 3
            if operations[i] == alphabet[j]
                operation = j
        int last = int(len(runs)) - 1
        if last >= 0 and runs[last][0] == operation
            runs[last][1] += 1
        else
            runs = runs.append([operation, 1])
    return runs

class Alignment(int reference, int position, int strand, string operations, int score, string oriented, int[][] pairs, string cigar, int nm, string md)

Alignment describe(int reference, int position, int strand, string operations, int score, string core, int trimmed, sequence_io.Reference[] references)
    string oriented = if strand == 0 then core else sequence_io.reverse_complement(core)
    string sequence = references[reference].bases
    string[] cigar_parts = []
    string[] md_parts = []
    int[][] pairs = []
    int i = 0
    int j = position
    int matches = 0
    int nm = 0
    string alphabet = "MID"
    for int[] run = operation_runs(operations)[]
        int operation = run[0]
        int count = run[1]
        cigar_parts = cigar_parts.append(count.string() + alphabet[operation])
        if operation == 1
            i += count
            nm += count
        elif operation == 2
            md_parts = md_parts.append(matches.string() + "^" + sequence[j:<j + count])
            matches = 0
            j += count
            nm += count
        else
            for int k < count
                pairs = pairs.append([i, j])
                if oriented[i] == sequence[j]
                    matches += 1
                else
                    md_parts = md_parts.append(matches.string() + sequence[j])
                    matches = 0
                    nm += 1
                i += 1
                j += 1
    md_parts = md_parts.append(matches.string())
    if trimmed > 0
        if strand == 0
            cigar_parts = cigar_parts.append("{trimmed}S")
        else
            cigar_parts = ["{trimmed}S"].concat(cigar_parts)
    return Alignment(reference, position, strand, operations, score, oriented, pairs, cigar_parts.join(""), nm, md_parts.join(""))

int band_value(int[][] grid, int[] starts, int row, int column)
    if row < 0 or row >= int(len(grid))
        return unreachable
    int index = column - starts[row]
    return if index < 0 or index >= int(len(grid[row])) then unreachable else grid[row][index]

class Banded(bool exists, int score, int position, string operations)

Banded banded_alignment(string oriented, string sequence, int center, int width, int[] scores)
    int length = int(len(oriented))
    int reference_length = int(len(sequence))
    int[] starts = [for int i <= length then maximum(0, i + center - width)]
    int[] ends = [for int i <= length then minimum(reference_length, i + center + width)]
    int[][] h = [for int i <= length then [for int k < maximum(0, ends[i] - starts[i] + 1) then unreachable]]
    int[][] e = h
    int[][] f = h
    for int k < int(len(h[0]))
        h[0][k] = 0
    for 1 <= int i <= length
        if starts[i] > ends[i]
            continue
        for starts[i] <= int j <= ends[i]
            int index = j - starts[i]
            int previous_h = band_value(h, starts, i - 1, j)
            int previous_f = band_value(f, starts, i - 1, j)
            int insertion = unreachable
            if previous_h > unreachable
                insertion = previous_h - scores[2] - scores[3]
            if previous_f > unreachable
                insertion = maximum(insertion, previous_f - scores[3])
            f[i][index] = insertion
            int deletion = unreachable
            int diagonal = unreachable
            if j >= 1
                previous_h = band_value(h, starts, i, j - 1)
                int previous_e = band_value(e, starts, i, j - 1)
                if previous_h > unreachable
                    deletion = previous_h - scores[2] - scores[3]
                if previous_e > unreachable
                    deletion = maximum(deletion, previous_e - scores[3])
                int previous = band_value(h, starts, i - 1, j - 1)
                if previous > unreachable
                    diagonal = previous + (if oriented[i - 1] == sequence[j - 1] then scores[0] else -scores[1])
            e[i][index] = deletion
            h[i][index] = maximum(diagonal, maximum(deletion, insertion))
    int endpoint = -1
    int best = unreachable
    if starts[length] <= ends[length]
        for starts[length] <= int j <= ends[length]
            int value = band_value(h, starts, length, j)
            if value > best
                best = value
                endpoint = j
    if endpoint < 0
        return Banded(false, 0, 0, "")
    int i = length
    int j = endpoint
    int state = 0
    string backward = ""
    while true
        if state == 0
            if i == 0
                break
            int previous = if j >= 1 then band_value(h, starts, i - 1, j - 1) else unreachable
            if previous > unreachable
                int delta = if oriented[i - 1] == sequence[j - 1] then scores[0] else -scores[1]
                if band_value(h, starts, i, j) == previous + delta
                    backward += "M"
                    i -= 1
                    j -= 1
                    continue
            state = if band_value(f, starts, i, j) > unreachable and band_value(h, starts, i, j) == band_value(f, starts, i, j) then 1 else 2
        elif state == 1
            backward += "I"
            int previous = band_value(f, starts, i - 1, j)
            state = if previous > unreachable and band_value(f, starts, i, j) == previous - scores[3] then 1 else 0
            i -= 1
        else
            backward += "D"
            int previous = band_value(e, starts, i, j - 1)
            state = if previous > unreachable and band_value(e, starts, i, j) == previous - scores[3] then 2 else 0
            j -= 1
    return Banded(true, best, j, backward[::-1])

bool position_before(Alignment first, Alignment second)
    if first.reference != second.reference
        return first.reference < second.reference
    if first.position != second.position
        return first.position < second.position
    return first.strand < second.strand

Alignment[] rank_alignments(Alignment[] values)
    Alignment[] result = []
    for Alignment value = values[]
        int position = int(len(result))
        for int i < int(len(result))
            if value.score > result[i].score or (value.score == result[i].score and position_before(value, result[i]))
                position = i
                break
        result = result[0:<position].concat([value]).concat(result[position:<int(len(result))])
    return result

class Result(sequence_io.Read read, string core, int[] qualities, int length, int trimmed, bool mapped, string reason, string method, int score, int mapq, int x0, int x1, Alignment[] alignments, int[] targets)

class Mapper(ReferenceText reference_text, fm_index.Index forward, fm_index.Index reverse, sequence_io.Params params)
    int[] search_counts = [0, 0, 0, 0]
    int[] seed_counts = [0, 0, 0, 0, 0, 0, 0]

    Alignment[] hit_alignments(int[][] hits, Result result)
        int size = int(len(reference_text.references))
        int base = forward.size + 1
        int[] keys = [for int i < int(len(hits)) then (((hits[i][0] * size + hits[i][1]) * base + hits[i][2]) * 2 + hits[i][3]) * int(len(hits)) + i]
        int[] order = [for int key = keys.sorted()[] then key % int(len(hits))]
        int best = hits[order[0]][0]
        Alignment[] alignments = []
        for int index = order[]
            int[] hit = hits[index]
            if hit[0] <= best + 1
                int score = (result.length - hit[0]) * params.scores[0] - hit[0] * params.scores[1]
                alignments = alignments.append(describe(hit[1], hit[2], hit[3], string.repeat("M", nat(result.length)), score, result.core, result.trimmed, reference_text.references))
        return alignments

    int[][] .make_candidates(string[] oriented)
        set.Set<string> seen = set.Set<string>()
        int[][] candidates = []
        for int strand < 2
            string sequence = oriented[strand]
            for 0 <= int offset <= int(len(sequence)) - params.seed_length step params.seed_step
                seed_counts[1] += 1
                string seed = sequence[offset:<offset + params.seed_length]
                if includes(seed, "N")
                    seed_counts[2] += 1
                    continue
                int[] interval = forward.backward_search(seed)
                if interval[1] - interval[0] > params.seed_hits
                    seed_counts[3] += 1
                elif interval[0] >= interval[1]
                    seed_counts[4] += 1
                else
                    for interval[0] <= int row < interval[1]
                        int[] located = reference_text.position(forward.locate(row)[0])
                        int[] candidate = [strand, located[0], located[1] - offset]
                        string key = integer_key(candidate)
                        if not seen.has(key)
                            .seen.add(key)
                            candidates = candidates.append(candidate)
        seed_counts[5] += int(len(candidates))
        int base = forward.size + 201
        int size = int(len(reference_text.references))
        int count = int(len(candidates))
        int[] keys = [for int i < count then ((candidates[i][0] * size + candidates[i][1]) * base + candidates[i][2] + 100) * count + i]
        return [for int key = keys.sorted()[] then candidates[key % count]]

    Result .map_read(sequence_io.Read read)
        int[] qualities = [for int code = read.quality.codepoints()[] then code - 33]
        int length = int(len(read.bases))
        while length > 0 and qualities[length - 1] < params.trim_quality
            length -= 1
        int trimmed = int(len(read.bases)) - length
        string core = read.bases[0:<length]
        Result result = Result(read, core, qualities, length, trimmed, false, "SHORT", "", 0, 0, 0, 0, [], [])
        if length < params.min_length
            return result
        string[] oriented = [core, sequence_io.reverse_complement(core)]
        int[] plus_exact = forward.backward_search(oriented[0])
        int[] minus_exact = forward.backward_search(oriented[1])
        int allowed = if plus_exact[0] < plus_exact[1] or minus_exact[0] < minus_exact[1] then 1 else params.mismatches
        int[][] hits = []
        for int strand < 2
            search.Result found = search.backtrack(oriented[strand], allowed, forward, reverse)
            search_counts[0] += 1
            search_counts[1] += found.nodes
            search_counts[2] += int(len(found.leaves))
            search_counts[3] += found.positions
            for int[] leaf = found.leaves[]
                for leaf[0] <= int row < leaf[1]
                    int[] located = reference_text.position(forward.locate(row)[0])
                    hits = hits.append([leaf[2], located[0], located[1], strand])
        if len(hits) != 0
            result.alignments = hit_alignments(hits, result)
            result.mapped = true
            int best = length
            for int[] hit = hits[]
                if hit[0] < best
                    best = hit[0]
            result.x0 = int(len([for int[] hit = hits[] if hit[0] == best then hit]))
            result.x1 = int(len([for int[] hit = hits[] if hit[0] == best + 1 then hit]))
            result.method = if best == 0 then "EXACT" else "MISMATCH"
            result.score = (length - best) * params.scores[0] - best * params.scores[1]
            result.mapq = if result.x0 >= 2 then 0 elif result.x1 == 0 then 60 - 12 * best else maximum(30 - 12 * best - 3 * result.x1, 1)
            for int r < int(len(reference_text.references))
                if len([for int[] hit = hits[] if hit[0] == best and hit[1] == r then hit]) != 0
                    result.targets = result.targets.append(r)
            return result
        result.reason = "NOHIT"
        if length < params.seed_length
            return result
        seed_counts[0] += 1
        int[][] candidates = .make_candidates(oriented)
        Alignment[] accepted = []
        for int[] candidate = candidates[]
            int strand = candidate[0]
            int r = candidate[1]
            Banded aligned = banded_alignment(oriented[strand], reference_text.references[r].bases, candidate[2], params.band, params.scores)
            if not aligned.exists or 100 * aligned.score < params.min_percent * params.scores[0] * length
                continue
            Alignment item = describe(r, aligned.position, strand, aligned.operations, aligned.score, core, trimmed, reference_text.references)
            int previous = -1
            for int i < int(len(accepted))
                if accepted[i].reference == r and accepted[i].position == item.position and accepted[i].strand == strand
                    previous = i
                    break
            if previous < 0
                accepted = accepted.append(item)
            elif item.score > accepted[previous].score
                accepted[previous] = item
        seed_counts[6] += int(len(accepted))
        if len(accepted) == 0
            return result
        result.alignments = rank_alignments(accepted)
        result.mapped = true
        result.method = "SEED"
        result.score = result.alignments[0].score
        result.x0 = int(len([for Alignment item = accepted[] if item.score == result.score then item]))
        result.x1 = int(len(accepted)) - result.x0
        int second = 0
        for Alignment item = accepted[]
            if item.score < result.score and item.score > second
                second = item.score
        result.mapq = if result.x0 >= 2 then 0 else 60 * (result.score - second) / result.score
        for int r < int(len(reference_text.references))
            if len([for Alignment item = accepted[] if item.score == result.score and item.reference == r then item]) != 0
                result.targets = result.targets.append(r)
        return result

string bwt_run_text(string bwt)
    int count = 0
    for int i < int(len(bwt))
        if i == 0 or bwt[i] != bwt[i - 1]
            count += 1
    return "bwt runs {count} head " + bwt[0:<minimum(60, int(len(bwt)))]

string symbol_values(int[] values)
    return [for int i < 6 then suffix_array.symbols[i] + " {values[i]}"].join(" ")

string sam_record(Result result, sequence_io.Reference[] references, int maximum_alternatives)
    sequence_io.Read read = result.read
    if not result.mapped
        return sam_writer.unmapped(read.name, read.bases, read.quality, result.reason)
    Alignment primary = result.alignments[0]
    bool reverse = primary.strand == 1
    string bases = if reverse then sequence_io.reverse_complement(read.bases) else read.bases
    string quality = if reverse then read.quality[::-1] else read.quality
    string alternatives = ""
    int others = int(len(result.alignments)) - 1
    if others >= 1 and others <= maximum_alternatives
        for 1 <= int i < int(len(result.alignments))
            Alignment item = result.alignments[i]
            string strand = if item.strand == 0 then "+" else "-"
            alternatives += references[item.reference].name + ",{strand}{item.position + 1},{item.cigar},{item.nm};"
    return sam_writer.mapped(read.name, if reverse then 16 else 0, references[primary.reference].name, primary.position, result.mapq, primary.cigar, bases, quality, primary.nm, primary.md, result.score, result.x0, result.x1, result.method, alternatives)

class Study(sequence_io.Input data)
    sequence_io.Params params = data.params
    sequence_io.Reference[] references = data.references
    ReferenceText reference_text = ReferenceText(references)
    string text = reference_text.text
    int size = int(len(text))
    suffix_array.Built forward_sa = suffix_array.build(text)
    suffix_array.Built reverse_sa = suffix_array.build(reference_text.reverse)
    fm_index.Index forward = fm_index.Index(text, forward_sa.suffixes, params.occ_interval, params.sample_interval, true)
    fm_index.Index reverse = fm_index.Index(reference_text.reverse, reverse_sa.suffixes, params.occ_interval, params.sample_interval, false)
    Mapper mapper = Mapper(reference_text, forward, reverse, params)
    Result[] results = []
    for sequence_io.Read read = data.reads[]
        results = results.append(.mapper.map_read(read))
    int[][] depths = [for sequence_io.Reference reference = references[] then [for int p < int(len(reference.bases)) then 0]]
    int[][] mapq0_starts = depths
    int[][][][] pileup = [for sequence_io.Reference reference = references[] then [for int p < int(len(reference.bases)) then [for int strand < 2 then [for int base < 4 then 0]]]]
    for Result result = results[]
        if not result.mapped
            continue
        local Alignment primary = result.alignments[0]
        if result.mapq == 0
            mapq0_starts[primary.reference][primary.position] += 1
        if result.mapq < params.coverage_mapq
            continue
        for int[] pair = primary.pairs[]
            depths[primary.reference][pair[1]] += 1
            local int base = suffix_array.symbol_index(primary.oriented[pair[0]]) - 2
            local int cycle = if primary.strand == 0 then pair[0] + 1 else result.length - pair[0]
            if base >= 0 and result.qualities[cycle - 1] >= params.variants[1]
                pileup[primary.reference][pair[1]][primary.strand][base] += 1

    string[] index_lines()
        string[] lines = ["text length {size} sequences {len(references)}"]
        for int r < int(len(references))
            sequence_io.Reference reference = references[r]
            int gc = count_character(reference.bases, "G") + count_character(reference.bases, "C")
            lines = lines.append("sequence {reference.name} length {len(reference.bases)} offset {reference_text.offsets[r]} gc " + sam_writer.ratio(gc, int(len(reference.bases))) + " masked {reference.masked}")
        lines = lines.concat(["symbols " + symbol_values(forward.totals), "", "forward_index", "suffix_array rounds {int(len(forward_sa.classes)) - 1}"])
        for int t < int(len(forward_sa.classes))
            lines = lines.append("round {t} prefix_length {2 ^ t} classes {forward_sa.classes[t]}")
        suffix_array.Check checked = suffix_array.adjacent_check(text, forward_sa.suffixes)
        lines = lines.append("sa_check pairs {size - 1} ordered {checked.ordered} lcp_sum {checked.lcp_sum} mean_lcp " + sam_writer.ratio(checked.lcp_sum, size - 1) + " max_lcp {checked.maximum}")
        string first = reference_text.label(forward_sa.suffixes[checked.longest_row - 1])
        string second = reference_text.label(forward_sa.suffixes[checked.longest_row])
        lines = lines.append("longest_repeat {checked.maximum} {first} {second}")
        map.Map<string, int> kmers = map.Map<string, int>()
        int occurrences = 0
        for int position = forward_sa.suffixes[]
            if position + params.seed_length > size
                continue
            string kmer = text[position:<position + params.seed_length]
            if includes(kmer, "#") or includes(kmer, "$")
                continue
            int old = 0
            match kmers.get(kmer)
                int found
                    old = found
                none
                    old = 0
            .kmers.set(kmer, old + 1)
            occurrences += 1
        int unique = 0
        int max_occurrence = 0
        for int count = kmers.values()[]
            if count == 1
                unique += 1
            if count > max_occurrence
                max_occurrence = count
        lines = lines.append("kmers length {params.seed_length} occurrences {occurrences} distinct {kmers.size()} unique {unique} max_occurrence {max_occurrence} unique_fraction " + sam_writer.ratio(unique, occurrences))
        int sample_count = int(len([for int sample = forward.samples[] if sample >= 0 then sample]))
        lines = lines.concat([bwt_run_text(forward.bwt), "c_array " + symbol_values(forward.cumulative), "occ interval {params.occ_interval} checkpoints {len(forward.checkpoints)}", "sa_sample interval {params.sample_interval} samples {sample_count}"])
        int correct = 0
        int total_steps = 0
        int max_steps = 0
        for int row < size
            int[] located = forward.locate(row)
            if located[0] == forward_sa.suffixes[row]
                correct += 1
            total_steps += located[1]
            if located[1] > max_steps
                max_steps = located[1]
        lines = lines.append("locate rows {size} correct {correct} total_steps {total_steps} max_steps {max_steps} mean_steps " + sam_writer.ratio(total_steps, size))
        lines = lines.concat(["inverse_bwt identical " + (if forward.inverse() == text then "yes" else "no"), "", "reverse_index", "suffix_array rounds {int(len(reverse_sa.classes)) - 1}"])
        suffix_array.Check reverse_check = suffix_array.adjacent_check(reference_text.reverse, reverse_sa.suffixes)
        lines = lines.concat(["sa_check pairs {size - 1} ordered {reverse_check.ordered}", bwt_run_text(reverse.bwt), "inverse_bwt identical " + (if reverse.inverse() == reference_text.reverse then "yes" else "no"), "", "direct_sort"])
        int direct_count = 0
        for sequence_io.Reference reference = references[]
            if int(len(reference.bases)) <= params.direct_limit
                suffix_array.Built doubled = suffix_array.build(reference.bases + "$")
                bool identical = doubled.suffixes == suffix_array.direct_sort(reference.bases + "$")
                lines = lines.append("{reference.name} length {int(len(reference.bases)) + 1} rounds {int(len(doubled.classes)) - 1} identical " + (if identical then "yes" else "no"))
                direct_count += 1
        if direct_count == 0
            lines = lines.append("none")
        int occ_bytes = 24 * int(len(forward.checkpoints))
        int sample_bytes = 4 * sample_count
        int bitmap_bytes = (size + 7) / 8
        int index_bytes = size + occ_bytes + sample_bytes + bitmap_bytes
        return lines.concat(["", "index_size bwt_bytes {size} occ_bytes {occ_bytes} sample_bytes {sample_bytes} bitmap_bytes {bitmap_bytes} total_bytes {index_bytes} full_bytes {5 * size} ratio " + sam_writer.ratio(index_bytes, 5 * size)])

    string[] sam_lines()
        string[] names = [for sequence_io.Reference reference = references[] then reference.name]
        int[] lengths = [for sequence_io.Reference reference = references[] then int(len(reference.bases))]
        string[] lines = sam_writer.header(names, lengths)
        for Result result = results[]
            lines = lines.append(sam_record(result, references, params.max_alternatives))
        return lines

    string[] coverage_lines()
        string[] lines = ["window {params.coverage_window} min_mapq {params.coverage_mapq}"]
        for int r < int(len(references))
            sequence_io.Reference reference = references[r]
            int length = int(len(reference.bases))
            int[] values = depths[r]
            int covered = int(len([for int value = values[] if value > 0 then value]))
            int depth_sum = total(values)
            int max_depth = values.sorted()[length - 1]
            lines = lines.append("reference {reference.name} length {length} covered {covered} breadth " + sam_writer.ratio(covered, length) + " mean_depth " + sam_writer.ratio(depth_sum, length) + " max_depth {max_depth}")
            string[] histogram = []
            for int depth <= max_depth
                int count = int(len([for int value = values[] if value == depth then value]))
                histogram = histogram.append("{depth}:{count}")
            lines = lines.append("depth_histogram " + histogram.join(" "))
            for 0 <= int first < length step params.coverage_window
                int last = minimum(first + params.coverage_window, length)
                int count = last - first
                int[] window = values[first:<last]
                string fragment = reference.bases[first:<last]
                int gc = count_character(fragment, "G") + count_character(fragment, "C")
                int sum = total(window)
                int maximum_depth = window.sorted()[count - 1]
                int zero = int(len([for int value = window[] if value == 0 then value]))
                int mapq0 = total(mapq0_starts[r][first:<last])
                lines = lines.append("{reference.name} {first + 1} {last} gc " + sam_writer.ratio(gc, count) + " sum {sum} mean " + sam_writer.ratio(sum, count) + " max {maximum_depth} zero {zero} mapq0 {mapq0} |" + string.repeat("#", nat(10 * sum / count)))
        return lines

    string[] variant_lines()
        int[] settings = params.variants
        string[] lines = ["min_depth {settings[0]} min_base_quality {settings[1]} min_alt_percent {settings[2]} hom_percent {settings[3]}"]
        int callable = 0
        int variants = 0
        int heterozygous = 0
        int homozygous = 0
        for int r < int(len(references))
            sequence_io.Reference reference = references[r]
            for int position < int(len(reference.bases))
                int[] counts = [for int base < 4 then pileup[r][position][0][base] + pileup[r][position][1][base]]
                int depth = total(counts)
                if depth < settings[0]
                    continue
                callable += 1
                int reference_base = suffix_array.symbol_index(reference.bases[position]) - 2
                int alternative = if reference_base == 0 then 1 else 0
                for int base < 4
                    if base != reference_base and counts[base] > counts[alternative]
                        alternative = base
                int alt_count = counts[alternative]
                if alt_count < 2 or 100 * alt_count < settings[2] * depth
                    continue
                variants += 1
                bool homo = 100 * alt_count >= settings[3] * depth
                if homo
                    homozygous += 1
                else
                    heterozygous += 1
                string genotype = if homo then "1/1" else "0/1"
                string counts_text = [for int count = counts[] then count.string()].join(" ")
                lines = lines.append("{reference.name} {position + 1} {reference.bases[position]}>" + suffix_array.bases[alternative] + " depth {depth} alt {alt_count} fraction " + sam_writer.ratio(alt_count, depth) + " genotype {genotype} strands {pileup[r][position][0][alternative]} {pileup[r][position][1][alternative]} counts {counts_text}")
        return lines.append("callable {callable} variants {variants} heterozygous {heterozygous} homozygous {homozygous}")

    int[] distinct_values(int[] values)
        int[] result = []
        for int value = values.sorted()[]
            if len(result) == 0 or value != result[int(len(result)) - 1]
                result = result.append(value)
        return result

    string[] summary_lines()
        int read_count = int(len(results))
        int[] mapped = [for int i < read_count if results[i].mapped then i]
        int[] unique = [for int i = mapped[] if results[i].x0 == 1 then i]
        int[] multi = [for int i = mapped[] if results[i].x0 >= 2 then i]
        int short = int(len([for Result result = results[] if not result.mapped and result.reason == "SHORT" then result]))
        int trimmed_reads = int(len([for Result result = results[] if result.trimmed > 0 then result]))
        int trimmed_bases = total([for Result result = results[] then result.trimmed])
        string[] lines = ["reads total {read_count} trimmed {trimmed_reads} trimmed_bases {trimmed_bases} short {short}",
            "mapped {len(mapped)} rate " + sam_writer.ratio(int(len(mapped)), read_count) + " unique {len(unique)} multi {len(multi)} unmapped {read_count - int(len(mapped))}",
            "unmapped short {short} nohit {read_count - int(len(mapped)) - short}"]
        string[] method_names = ["EXACT", "MISMATCH", "SEED"]
        int[] method_counts = [for string method = method_names[] then int(len([for int i = mapped[] if results[i].method == method then i]))]
        int forward_count = int(len([for int i = mapped[] if results[i].alignments[0].strand == 0 then i]))
        lines = lines.concat(["method exact {method_counts[0]} mismatch {method_counts[1]} seed {method_counts[2]}", "strand forward {forward_count} reverse {int(len(mapped)) - forward_count}"])
        for int r < int(len(references))
            int[] indices = [for int i = mapped[] if results[i].alignments[0].reference == r then i]
            int unique_count = int(len([for int i = indices[] if results[i].x0 == 1 then i]))
            int plus_count = int(len([for int i = indices[] if results[i].alignments[0].strand == 0 then i]))
            lines = lines.append("reference {references[r].name} mapped {len(indices)} unique {unique_count} forward {plus_count} reverse {int(len(indices)) - plus_count}")
        int[] lengths = [for Result result = results[] then result.length]
        int[] ordered_lengths = lengths.sorted()
        int first_bin = ordered_lengths[0] / 10 * 10
        int last_bin = ordered_lengths[read_count - 1] / 10 * 10
        lines = lines.append("length_bins")
        for first_bin <= int lower <= last_bin step 10
            int[] indices = [for int i < read_count if lower <= lengths[i] and lengths[i] <= lower + 9 then i]
            int mapped_count = int(len([for int i = indices[] if results[i].mapped then i]))
            int unique_count = int(len([for int i = indices[] if results[i].mapped and results[i].x0 == 1 then i]))
            lines = lines.append("{lower}-{lower + 9} reads {len(indices)} mapped {mapped_count} unique {unique_count}")
        int[] n_reads = [for int i < read_count if includes(results[i].read.bases, "N") then i]
        int n_bases = total([for int i = n_reads[] then count_character(results[i].read.bases, "N")])
        int mapped_n = int(len([for int i = n_reads[] if results[i].mapped then i]))
        lines = lines.concat(["n_reads {len(n_reads)} n_bases {n_bases} mapped {mapped_n}", "multi_targets"])
        map.Map<string, int> target_counts = map.Map<string, int>()
        for int i = multi[]
            string name_set = [for int r = results[i].targets[] then references[r].name].join("+")
            int old = 0
            match target_counts.get(name_set)
                int found
                    old = found
                none
                    old = 0
            .target_counts.set(name_set, old + 1)
        if target_counts.size() == 0
            lines = lines.append("none")
        else
            for string key = target_counts.keys().sorted()[]
                match target_counts.get(key)
                    int count
                        lines = lines.append("{key} {count}")
                    none
                        continue
        lines = lines.append("mapq_histogram")
        int[] mapqs = distinct_values([for int i = mapped[] then results[i].mapq]).sorted(descending = true)
        for int mapq = mapqs[]
            int count = int(len([for int i = mapped[] if results[i].mapq == mapq then i]))
            lines = lines.append("{mapq} {count}")
        lines = lines.append("nm_histogram")
        int[] nm_values = distinct_values([for int i = mapped[] then results[i].alignments[0].nm])
        for int nm = nm_values[]
            int count = int(len([for int i = mapped[] if results[i].alignments[0].nm == nm then i]))
            lines = lines.append("{nm} {count}")
        int max_length = [for Result result = results[] then int(len(result.read.bases))].sorted()[read_count - 1]
        int aligned = 0
        int mismatches = 0
        int[][] substitutions = [for int base < 4 then [for int other < 5 then 0]]
        int[] cycle_aligned = [for int cycle < max_length then 0]
        int[] cycle_mismatches = cycle_aligned
        int[] quality_counts = [0, 0]
        int[] quality_sums = [0, 0]
        int[] quality_aligned = [0, 0, 0, 0, 0]
        int[] quality_mismatches = quality_aligned
        int insertion_events = 0
        int inserted_bases = 0
        int deletion_events = 0
        int deleted_bases = 0
        for int index = unique[]
            Result result = results[index]
            Alignment primary = result.alignments[0]
            string reference = references[primary.reference].bases
            for int[] pair = primary.pairs[]
                int i = pair[0]
                int j = pair[1]
                int cycle = if primary.strand == 0 then i + 1 else result.length - i
                int quality = result.qualities[cycle - 1]
                int reference_base = suffix_array.symbol_index(reference[j]) - 2
                int oriented_base = suffix_array.symbol_index(primary.oriented[i]) - 2
                if oriented_base < 0
                    oriented_base = 4
                bool mismatch = primary.oriented[i] != reference[j]
                int error_index = if mismatch then 1 else 0
                int quality_bin = minimum(quality / 10, 4)
                aligned += 1
                substitutions[reference_base][oriented_base] += 1
                cycle_aligned[cycle - 1] += 1
                quality_counts[error_index] += 1
                quality_sums[error_index] += quality
                quality_aligned[quality_bin] += 1
                if mismatch
                    mismatches += 1
                    cycle_mismatches[cycle - 1] += 1
                    quality_mismatches[quality_bin] += 1
            for int[] run = operation_runs(primary.operations)[]
                if run[0] == 1
                    insertion_events += 1
                    inserted_bases += run[1]
                elif run[0] == 2
                    deletion_events += 1
                    deleted_bases += run[1]
        lines = lines.concat(["error_profile aligned_bases {aligned} mismatches {mismatches} rate " + sam_writer.ratio(mismatches, aligned), "substitutions", "ref A C G T N"])
        for int base < 4
            lines = lines.append(suffix_array.bases[base] + " " + [for int count = substitutions[base][] then count.string()].join(" "))
        lines = lines.append("mismatch_by_cycle")
        for int cycle < max_length
            lines = lines.append("cycle {cycle + 1} aligned {cycle_aligned[cycle]} mismatches {cycle_mismatches[cycle]} rate " + sam_writer.ratio(cycle_mismatches[cycle], cycle_aligned[cycle]))
        lines = lines.append("quality matched {quality_counts[0]} mean " + sam_writer.ratio(quality_sums[0], quality_counts[0]) + " mismatched {quality_counts[1]} mean " + sam_writer.ratio(quality_sums[1], quality_counts[1]))
        lines = lines.append("quality_bins")
        string[] bins = ["0-9", "10-19", "20-29", "30-39", "40-"]
        for int bin < 5
            lines = lines.append("{bins[bin]} aligned {quality_aligned[bin]} mismatches {quality_mismatches[bin]} rate " + sam_writer.ratio(quality_mismatches[bin], quality_aligned[bin]))
        int[] cigar = [0, 0, 0, 0]
        for int index = mapped[]
            Result result = results[index]
            for int[] run = operation_runs(result.alignments[0].operations)[]
                cigar[run[0]] += run[1]
            cigar[3] += result.trimmed
        int[] searches = mapper.search_counts
        int[] seeds = mapper.seed_counts
        return lines.concat(["cigar M {cigar[0]} I {cigar[1]} D {cigar[2]} S {cigar[3]}",
            "indels insertions {insertion_events} {inserted_bases} deletions {deletion_events} {deleted_bases}",
            "search dfs_calls {searches[0]} dfs_nodes {searches[1]} dfs_leaves {searches[2]} dfs_positions {searches[3]}",
            "seeds reads {seeds[0]} seeds {seeds[1]} with_n {seeds[2]} repetitive {seeds[3]} without_hit {seeds[4]} candidates {seeds[5]} passing {seeds[6]}"])

void run_program()
    Study study = Study(sequence_io.read_inputs())
    sam_writer.write_lines("alignments.sam", study.sam_lines())
    sam_writer.write_lines("coverage.txt", study.coverage_lines())
    sam_writer.write_lines("variants.txt", study.variant_lines())
    sam_writer.write_lines("index_stats.txt", study.index_lines())
    sam_writer.write_lines("summary.txt", study.summary_lines())

run_program()
