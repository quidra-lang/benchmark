int integer(string text)
    int value = int.parse(text)
    return value

string[] lines(string path)
    string text = file.read(path)
    string[] rows = text.split(NL)
    return rows[0:<int(len(rows)) - 1]

string uppercase(string text)
    string result = ""
    string lower = "acgt"
    string upper = "ACGT"
    for int i < int(len(text))
        string character = text[i]
        for int j < 4
            if character == lower[j]
                character = upper[j]
                break
        result += character
    return result

string reverse_complement(string text)
    string bases = "ACGTN"
    string complements = "TGCAN"
    string result = ""
    int i = int(len(text)) - 1
    while i >= 0
        for int j < 5
            if text[i] == bases[j]
                result += complements[j]
                break
        i -= 1
    return result

class Reference(string name, string bases, int masked)
class Read(string name, string bases, string quality)
class Params(int mismatches, int min_length, int trim_quality, int seed_length, int seed_step, int seed_hits, int band, int[] scores, int min_percent, int max_alternatives, int occ_interval, int sample_interval, int direct_limit, int coverage_window, int coverage_mapq, int[] variants)
class Input(Reference[] references, Read[] reads, Params params)

Input read_inputs()
    Reference[] references = []
    for string row = lines("input/reference.fasta")[]
        if row[0] == ">"
            references = references.append(Reference(row[1:<int(len(row))].split(" ")[0], "", 0))
        else
            int index = int(len(references)) - 1
            references[index].bases += uppercase(row)
            for int i < int(len(row))
                if row[i] == "a" or row[i] == "c" or row[i] == "g" or row[i] == "t"
                    references[index].masked += 1
    Read[] reads = []
    string[] rows = lines("input/reads.fastq")
    for 0 <= int i < int(len(rows)) step 4
        reads = reads.append(Read(rows[i][1:<int(len(rows[i]))], rows[i + 1], rows[i + 3]))
    int[][] settings = []
    for string row = lines("input/params.txt")[]
        string[] fields = row.split(" ")
        settings = settings.append([for string value = fields[1:<int(len(fields))][] then integer(value)])
    Params params = Params(settings[0][0], settings[1][0], settings[2][0], settings[3][0], settings[4][0], settings[5][0], settings[6][0], settings[7], settings[8][0], settings[9][0], settings[10][0], settings[11][0], settings[12][0], settings[13][0], settings[14][0], settings[15])
    return Input(references, reads, params)
