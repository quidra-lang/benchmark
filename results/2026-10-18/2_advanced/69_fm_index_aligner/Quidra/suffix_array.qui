const string symbols = "$#ACGT"
const string bases = "ACGT"

int symbol_index(string character)
    for int i < 6
        if character == symbols[i]
            return i
    return -1

int[] counting_sort(int[] positions, int[] keys, int key_count)
    int[] counts = [for int i < key_count then 0]
    for int position = positions[]
        counts[keys[position]] += 1
    int offset = 0
    for int key < key_count
        int count = counts[key]
        counts[key] = offset
        offset += count
    int[] result = [for int i < int(len(positions)) then 0]
    for int position = positions[]
        int key = keys[position]
        result[counts[key]] = position
        counts[key] += 1
    return result

class Built(int[] suffixes, int[] classes)

Built build(string text)
    int size = int(len(text))
    int[] positions = [for int i < size then i]
    int[] codes = [for int i < size then symbol_index(text[i])]
    int[] order = counting_sort(positions, codes, 6)
    int[] ranks = [for int i < size then 0]
    int count = 0
    int previous = -1
    for int position = order[]
        if codes[position] != previous
            count += 1
            previous = codes[position]
        ranks[position] = count - 1
    int[] classes = [count]
    int width = 1
    while count < size
        int[] second = [for int i < size then (if i + width < size then ranks[i + width] + 1 else 0)]
        order = counting_sort(positions, second, count + 1)
        order = counting_sort(order, ranks, count)
        int[] updated = [for int i < size then 0]
        count = 0
        int previous_first = -1
        int previous_second = -1
        for int position = order[]
            if ranks[position] != previous_first or second[position] != previous_second
                count += 1
                previous_first = ranks[position]
                previous_second = second[position]
            updated[position] = count - 1
        ranks = updated
        classes = classes.append(count)
        width *= 2
    return Built(order, classes)

bool suffix_before(string text, int first, int second)
    int common = 0
    while text[first + common] == text[second + common]
        common += 1
    return symbol_index(text[first + common]) < symbol_index(text[second + common])

int[] merge_order(string text, int[] positions)
    int size = int(len(positions))
    if size < 2
        return positions
    int middle = size / 2
    int[] left = merge_order(text, positions[0:<middle])
    int[] right = merge_order(text, positions[middle:<size])
    int[] result = []
    int a = 0
    int b = 0
    while a < int(len(left)) and b < int(len(right))
        if suffix_before(text, left[a], right[b])
            result = result.append(left[a])
            a += 1
        else
            result = result.append(right[b])
            b += 1
    return result.concat(left[a:<int(len(left))]).concat(right[b:<int(len(right))])

int[] direct_sort(string text)
    return merge_order(text, [for int i < int(len(text)) then i])

class Check(int ordered, int lcp_sum, int maximum, int longest_row)

Check adjacent_check(string text, int[] suffixes)
    int ordered = 0
    int lcp_sum = 0
    int maximum = -1
    int longest_row = 1
    for 1 <= int row < int(len(suffixes))
        int left = suffixes[row - 1]
        int right = suffixes[row]
        int common = 0
        while text[left + common] == text[right + common]
            common += 1
        if symbol_index(text[left + common]) < symbol_index(text[right + common])
            ordered += 1
        lcp_sum += common
        if common > maximum
            maximum = common
            longest_row = row
    return Check(ordered, lcp_sum, maximum, longest_row)
