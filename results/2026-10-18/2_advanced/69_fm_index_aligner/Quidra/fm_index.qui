import suffix_array = "./suffix_array.qui"

class Index(string text, int[] suffixes, int occ_interval, int sample_interval, bool sampled)
    int size = int(len(text))
    string bwt = [for int position = suffixes[] then text[if position == 0 then size - 1 else position - 1]].join("")
    int[] totals = [for int symbol < 6 then 0]
    for int i < size
        totals[suffix_array.symbol_index(text[i])] += 1
    int[] cumulative = [for int symbol < 6 then 0]
    for 1 <= int symbol < 6
        cumulative[symbol] = cumulative[symbol - 1] + totals[symbol - 1]
    int[][] checkpoints = []
    int[] running = [for int symbol < 6 then 0]
    for int i <= size
        if i % occ_interval == 0
            checkpoints = checkpoints.append(running)
        if i < size
            running[suffix_array.symbol_index(bwt[i])] += 1
    int[] samples = [for int row < size then (if sampled and suffixes[row] % sample_interval == 0 then suffixes[row] else -1)]

    int occurrence(int symbol, int end)
        int checkpoint = end / occ_interval
        int result = checkpoints[checkpoint][symbol]
        for checkpoint * occ_interval <= int i < end
            if suffix_array.symbol_index(bwt[i]) == symbol
                result += 1
        return result

    int lf(int row)
        int symbol = suffix_array.symbol_index(bwt[row])
        return cumulative[symbol] + occurrence(symbol, row)

    int[] extend(int lower, int upper, string base)
        int symbol = suffix_array.symbol_index(base)
        if symbol < 2
            return [0, 0]
        return [cumulative[symbol] + occurrence(symbol, lower), cumulative[symbol] + occurrence(symbol, upper)]

    int[] locate(int row)
        int current = row
        int steps = 0
        while samples[current] < 0
            current = lf(current)
            steps += 1
        return [samples[current] + steps, steps]

    string inverse()
        string[] reconstructed = [for int i < size then "$"]
        int row = 0
        int position = size - 2
        while position >= 0
            reconstructed[position] = bwt[row]
            row = lf(row)
            position -= 1
        return reconstructed.join("")

    int[] backward_search(string query)
        int[] interval = [0, size]
        int i = int(len(query)) - 1
        while i >= 0
            interval = extend(interval[0], interval[1], query[i])
            if interval[0] >= interval[1]
                return interval
            i -= 1
        return interval
