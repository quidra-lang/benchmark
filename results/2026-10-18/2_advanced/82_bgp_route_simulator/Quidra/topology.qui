int address_value(string text)
    int result = 0
    for string octet = text.split(".")[]
        result = result * 256 + int.parse(octet)
    return result

string address_text(int address)
    int remaining = address
    string[] pieces = []
    for 3 >= int power >= 0
        int divisor = 256 ^ power
        pieces = pieces.append((remaining / divisor).string())
        remaining %= divisor
    return pieces.join(".")

int prefix_key(string text)
    string[] pieces = text.split("/")
    return address_value(pieces[0]) * 33 + int.parse(pieces[1])

string prefix_text(int prefix)
    return address_text(prefix / 33) + "/{prefix % 33}"

bool contains_address(int prefix, int address)
    int divisor = 2 ^ (32 - prefix % 33)
    return address / divisor == (prefix / 33) / divisor

class Link(string name, int first, int second, string relationship, int delay, int mrai)
    bool up = true
    int down_count = 0

class Initial(int owner, int prefix, string origin, string[] communities)
class Network(int[] ases, map.Map<int, int> router_ids, Link[] links, map.Map<string, int> by_name, Initial[] initial)

string[] input_lines(string filename)
    string text = file.read("input/" + filename)
    string[] rows = text.split(NL)
    return rows[0:<int(len(rows)) - 1]

Network read_topology()
    map.Map<int, int> router_ids = map.Map<int, int>()
    Link[] links = []
    map.Map<string, int> by_name = map.Map<string, int>()
    Initial[] initial = []
    for string row = input_lines("topology.txt")[]
        string[] fields = row.split(" ")
        if fields[0] == "AS"
            .router_ids.set(int.parse(fields[1]), address_value(fields[2]))
        elif fields[0] == "LINK"
            .by_name.set(fields[1], int(len(links)))
            links = links.append(Link(fields[1], int.parse(fields[2]), int.parse(fields[3]), fields[4], int.parse(fields[5]), int.parse(fields[6])))
        else
            initial = initial.append(Initial(int.parse(fields[1]), prefix_key(fields[2]), fields[3], fields[4:]))
    return Network(router_ids.keys().sorted(), router_ids, links, by_name, initial)

int other_end(Link link, int owner)
    return if owner == link.first then link.second else link.first

string neighbor_role(Link link, int owner)
    if link.relationship == "P2P"
        return "peer"
    return if owner == link.first then "customer" else "provider"

string direction_symbol(Link link, int owner)
    string role = neighbor_role(link, owner)
    return if role == "customer" then "D" elif role == "peer" then "P" else "U"

int connecting_link(Network network, int first, int second)
    for int i < int(len(network.links))
        Link link = network.links[i]
        if (link.first == first and link.second == second) or (link.first == second and link.second == first)
            return i
    return -1

int router_id(Network network, int owner)
    match network.router_ids.get(owner)
        int result
            return result
        none
            return -1

int as_index(Network network, int owner)
    for int i < int(len(network.ases))
        if network.ases[i] == owner
            return i
    return -1

int link_index(Network network, string name)
    match network.by_name.get(name)
        int result
            return result
        none
            return -1
