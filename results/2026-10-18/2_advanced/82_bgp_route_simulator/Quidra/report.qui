import topology = "./topology.qui"
import policy = "./policy.qui"
import decision = "./decision.qui"

string path_text(int[] path)
    return [for int owner = path[] then owner.string()].join(",")

string attribute_text(decision.Attribute attribute)
    return "path " + path_text(attribute.path) + " origin {attribute.origin} med {attribute.med} comm " + policy.communities_text(attribute.communities)

string route_text(decision.Route route, topology.Network network)
    if not route.present
        return "NONE"
    decision.Attribute attribute = route.attributes
    string communities = policy.communities_text(attribute.communities)
    if route.local_route
        return "LOCAL origin {attribute.origin} comm {communities}"
    return "next {attribute.path[0]} path " + path_text(attribute.path) + " link {network.links[route.link].name} lp {route.local_pref} med {attribute.med} origin {attribute.origin} comm {communities}"

void write_lines(string filename, string[] lines)
    string text = if len(lines) == 0 then "" else lines.join(NL) + NL
    file.write("output/" + filename, text)
