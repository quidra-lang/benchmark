import topology = "./topology.qui"

class Attribute(bool present, int[] path, string origin, int med, int[] communities)
class Route(bool present, bool local_route, Attribute attributes, int local_pref, int link)
class Choice(Route route, string reason)

Attribute absent_attribute()
    return Attribute(false, [], "", 0, [])

Route absent_route()
    return Route(false, false, absent_attribute(), 0, -1)

Route originated_route(string origin, int[] communities)
    return Route(true, true, Attribute(true, [], origin, 0, communities), 0, -1)

Attribute table_attribute(map.Map<int, Attribute> table, int prefix)
    match table.get(prefix)
        Attribute result
            return result
        none
            return absent_attribute()

Route table_route(map.Map<int, Route> table, int prefix)
    match table.get(prefix)
        Route result
            return result
        none
            return absent_route()

int origin_rank(string origin)
    return if origin == "IGP" then 0 elif origin == "EGP" then 1 else 2

int stage_key(Route route, int stage, topology.Network network)
    if stage == 0
        return -route.local_pref
    if stage == 1
        return int(len(route.attributes.path))
    if stage == 2
        return origin_rank(route.attributes.origin)
    if stage == 4
        return topology.router_id(network, route.attributes.path[0])
    return route.link

Choice best_route(Route[] candidates, topology.Network network)
    Route[] remaining = candidates
    if len(remaining) == 1
        return Choice(remaining[0], "ONLY")
    string[] stages = ["LOCALPREF", "ASPATH", "ORIGIN", "MED", "ROUTERID", "LINK"]
    for int stage < 6
        Route[] kept = []
        if stage == 3
            for Route route = remaining[]
                bool dominated = false
                for Route other = remaining[]
                    if other.attributes.path[0] == route.attributes.path[0] and other.attributes.med < route.attributes.med
                        dominated = true
                if not dominated
                    kept = kept.append(route)
        else
            int minimum = stage_key(remaining[0], stage, network)
            for Route route = remaining[]
                int candidate = stage_key(route, stage, network)
                if candidate < minimum
                    minimum = candidate
            for Route route = remaining[]
                if stage_key(route, stage, network) == minimum
                    kept = kept.append(route)
        remaining = kept
        if len(remaining) == 1
            return Choice(remaining[0], stages[stage])
    return Choice(remaining[0], "LINK")
