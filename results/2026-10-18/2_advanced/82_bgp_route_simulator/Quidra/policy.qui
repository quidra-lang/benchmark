import topology = "./topology.qui"

const int no_export = 65535 * 65536 + 65281

int community_value(string text)
    if text == "NO_EXPORT"
        return no_export
    string[] pieces = text.split(":")
    return int.parse(pieces[0]) * 65536 + int.parse(pieces[1])

int[] parse_communities(string[] values)
    set.Set<int> unique = set.Set<int>()
    for string text = values[]
        .unique.add(community_value(text))
    return unique.values().sorted()

string community_text(int community)
    return if community == no_export then "NO_EXPORT" else "{community / 65536}:{community % 65536}"

string communities_text(int[] communities)
    return if len(communities) == 0 then "-" else [for int community = communities.sorted()[] then community_text(community)].join(",")

class Condition(string kind, string text, int first = 0, int last = 0)
class Action(string kind, int amount = 0)
class ListEntry(string name, bool permit, int prefix, int low, int high)
class Rule(string name, bool active, int owner, string direction, string target, Condition[] conditions, Action[] actions)
    int hits = 0

class Policies(ListEntry[] entries, Rule[] rules)

Policies read_policies()
    ListEntry[] entries = []
    Rule[] rules = []
    for string row = topology.input_lines("policies.txt")[]
        string[] fields = row.split(" ")
        if fields[0] == "PLIST"
            int prefix = topology.prefix_key(fields[3])
            int low = prefix % 33
            int high = low
            int i = 4
            while i < int(len(fields))
                if fields[i] == "GE"
                    low = int.parse(fields[i + 1])
                    high = 32
                else
                    high = int.parse(fields[i + 1])
                i += 2
            entries = entries.append(ListEntry(fields[1], fields[2] == "PERMIT", prefix, low, high))
            continue
        Condition[] conditions = []
        int i = 6
        while fields[i] != "THEN"
            string kind = fields[i]
            string text = fields[i + 1]
            int first = 0
            int last = 0
            if kind == "CONTAINS" or kind == "ORIGINAS"
                first = int.parse(text)
            elif kind == "LENGTH"
                string[] bounds = text.split("-")
                first = int.parse(bounds[0])
                last = int.parse(bounds[1])
            elif kind == "COMMUNITY"
                first = community_value(text)
            conditions = conditions.append(Condition(kind, text, first, last))
            i += 2
        i += 1
        Action[] actions = []
        while i < int(len(fields))
            string kind = fields[i]
            i += 1
            int amount = 0
            if kind != "DENY" and kind != "ALLOW"
                amount = if kind == "ADD" or kind == "REMOVE" then community_value(fields[i]) else int.parse(fields[i])
                i += 1
            actions = actions.append(Action(kind, amount))
        rules = rules.append(Rule(fields[1], fields[2] == "ON", int.parse(fields[3]), fields[4], fields[5], conditions, actions))
    return Policies(entries, rules)

bool contains_number(int[] values, int wanted)
    for int item = values[]
        if item == wanted
            return true
    return false

bool prefix_permitted(Policies policies, string name, int prefix)
    for ListEntry entry = policies.entries[]
        if entry.name == name and entry.low <= prefix % 33 and prefix % 33 <= entry.high and topology.contains_address(entry.prefix, prefix / 33)
            return entry.permit
    return false

bool rule_matches(Policies policies, Rule rule, int owner, topology.Link link, int prefix, int[] path, int[] communities)
    if not rule.active or rule.owner != owner
        return false
    if rule.target != "*" and rule.target != topology.other_end(link, owner).string() and rule.target != link.name
        return false
    for Condition condition = rule.conditions[]
        if condition.kind == "PREFIX" and not prefix_permitted(policies, condition.text, prefix)
            return false
        if condition.kind == "CONTAINS" and not contains_number(path, condition.first)
            return false
        if condition.kind == "ORIGINAS"
            int origin_as = if len(path) == 0 then owner else path[int(len(path)) - 1]
            if origin_as != condition.first
                return false
        if condition.kind == "LENGTH" and (int(len(path)) < condition.first or int(len(path)) > condition.last)
            return false
        if condition.kind == "COMMUNITY" and not contains_number(communities, condition.first)
            return false
    return true

int applied_rule(Policies policies, string direction, int owner, topology.Link link, int prefix, int[] path, int[] communities)
    for int i < int(len(policies.rules))
        Rule rule = policies.rules[i]
        if rule.direction == direction and rule_matches(policies, rule, owner, link, prefix, path, communities)
            return i
    return -1

bool has_action(Rule rule, string kind)
    for Action action = rule.actions[]
        if action.kind == kind
            return true
    return false

int action_value(Rule rule, string kind, int fallback)
    for Action action = rule.actions[]
        if action.kind == kind
            return action.amount
    return fallback

int[] edit_communities(int[] communities, Rule rule)
    set.Set<int> edited = set.Set<int>()
    for int item = communities[]
        .edited.add(item)
    for Action action = rule.actions[]
        if action.kind == "ADD"
            .edited.add(action.amount)
        elif action.kind == "REMOVE"
            .edited.remove(action.amount)
    return edited.values().sorted()

int rule_index(Policies policies, string name)
    for int i < int(len(policies.rules))
        if policies.rules[i].name == name
            return i
    return -1
