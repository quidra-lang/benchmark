import topology = "./topology.qui"
import decision = "./decision.qui"

class Message(int serial, int sender, int receiver, int link, int prefix, decision.Attribute content, int arrival)
class Queue()
    Message[] heap = []
    int serial = 0

bool message_before(Message first, Message second)
    if first.arrival != second.arrival
        return first.arrival < second.arrival
    if first.receiver != second.receiver
        return first.receiver < second.receiver
    if first.sender != second.sender
        return first.sender < second.sender
    return first.serial < second.serial

void insert_message(Queue &queue, Message message)
    queue.heap = queue.heap.append(message)
    int position = int(len(queue.heap)) - 1
    while position > 0
        int parent = (position - 1) / 2
        if not message_before(queue.heap[position], queue.heap[parent])
            break
        Message temporary = queue.heap[parent]
        queue.heap[parent] = queue.heap[position]
        queue.heap[position] = temporary
        position = parent

Message take_message(Queue &queue)
    Message result = queue.heap[0]
    int last = int(len(queue.heap)) - 1
    Message replacement = queue.heap[last]
    queue.heap = queue.heap[0:<last]
    if last > 0
        queue.heap[0] = replacement
        int position = 0
        while position * 2 + 1 < last
            int child = position * 2 + 1
            if child + 1 < last and message_before(queue.heap[child + 1], queue.heap[child])
                child += 1
            if not message_before(queue.heap[child], queue.heap[position])
                break
            Message temporary = queue.heap[position]
            queue.heap[position] = queue.heap[child]
            queue.heap[child] = temporary
            position = child
    return result

Message send_message(Queue &queue, int tick, int sender, int receiver, int link, int prefix, decision.Attribute content, int delay)
    queue.serial += 1
    Message message = Message(queue.serial, sender, receiver, link, prefix, content, tick + delay)
    insert_message(&queue, message)
    return message

Message[] ordered_messages(Queue original)
    Queue copied = original
    Message[] result = []
    while len(copied.heap) > 0
        result = result.append(take_message(&copied))
    return result

Message[] remove_link(Queue &queue, int link)
    Message[] ordered = ordered_messages(queue)
    queue.heap = []
    Message[] removed = []
    for Message message = ordered[]
        if message.link == link
            removed = removed.append(message)
        else
            insert_message(&queue, message)
    return removed

class Event(int tick, string text, string kind, string[] fields)
class Trace(int source, string address, int value)
class Parameters(int[] defaults, int stepcap, Trace[] traces)

Event[] read_events()
    Event[] result = [Event(0, "INITIAL", "INITIAL", ["INITIAL"])]
    for string row = topology.input_lines("events.txt")[]
        string[] fields = row.split(" ")
        string[] words = fields[1:]
        string kind = if words[0] == "LINK" or words[0] == "POLICY" then words[0] + "_" + words[1] else words[0]
        result = result.append(Event(int.parse(fields[0]), words.join(" "), kind, words))
    return result

Parameters read_parameters()
    string[] rows = topology.input_lines("params.txt")
    string[] defaults = rows[0].split(" ")
    int[] preferences = [int.parse(defaults[1]), int.parse(defaults[2]), int.parse(defaults[3])]
    int cap = int.parse(rows[1].split(" ")[1])
    Trace[] traces = []
    for 2 <= int i < int(len(rows))
        string[] fields = rows[i].split(" ")
        traces = traces.append(Trace(int.parse(fields[1]), fields[2], topology.address_value(fields[2])))
    return Parameters(preferences, cap, traces)
