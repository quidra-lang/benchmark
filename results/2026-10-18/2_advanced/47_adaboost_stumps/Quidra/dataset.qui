string[] lines(string path)
    string content = file.read(path)
    string[] result = content.split(NL)
    return result[0:<int(len(result)) - 1]

int integer(string value)
    int result = int.parse(value)
    return result

real64 decimal(string value)
    real64 result = real64.parse(value)
    return result

class Rows(string[] ids, real64[][] features, int[] labels)
class Table(string[] names, Rows training, Rows testing)
class Params(int rounds, string[] variants, int bins, real64 smoothing, real64 convergence, real64 clip, int folds, real64[] margins, int classes, int samme_rounds, int permutation_repeats, int permutation_seed, int noise_seed, int[] noise, int[] sizes, real64[] shrinkage, int bootstrap_count, int bootstrap_seed)
class Data(string[] names, Rows training, Rows testing, string[] multi_names, Rows multi_training, Rows multi_testing, Params params)

Table read_table(string path, bool multiclass)
    string[] content = lines(path)
    string[] header = content[0].split(",")
    int count = int(len(header)) - (if multiclass then 3 else 2)
    string[] names = header[1:<count + 1]
    string[] train_ids = []
    real64[][] train_features = []
    int[] train_labels = []
    string[] test_ids = []
    real64[][] test_features = []
    int[] test_labels = []
    for 1 <= int i < int(len(content))
        string[] fields = content[i].split(",")
        real64[] values = [for string value = fields[1:<count + 1][] then decimal(value)]
        int label = integer(fields[count + 1])
        if multiclass and fields[count + 2] == "test"
            test_ids = test_ids.append(fields[0])
            test_features = test_features.append(values)
            test_labels = test_labels.append(label)
        else
            train_ids = train_ids.append(fields[0])
            train_features = train_features.append(values)
            train_labels = train_labels.append(label)
    return Table(names, Rows(train_ids, train_features, train_labels), Rows(test_ids, test_features, test_labels))

Params read_params()
    string[][] settings = [for string line = lines("input/params.txt")[] then line.split(" ")]
    real64[] margins = [for string value = settings[7][1:<int(len(settings[7]))][] then decimal(value)]
    int[] noise = [for string value = settings[11][2:<int(len(settings[11]))][] then integer(value)]
    int[] sizes = [for string value = settings[12][1:<int(len(settings[12]))][] then integer(value)]
    real64[] shrinkage = [for string value = settings[13][1:<int(len(settings[13]))][] then decimal(value)]
    return Params(integer(settings[0][1]), settings[1][1:<int(len(settings[1]))], integer(settings[2][1]), decimal(settings[3][1]), decimal(settings[4][1]), decimal(settings[5][1]), integer(settings[6][1]), margins, integer(settings[8][1]), integer(settings[9][1]), integer(settings[10][1]), integer(settings[10][2]), integer(settings[11][1]), noise, sizes, shrinkage, integer(settings[14][1]), integer(settings[14][2]))

Data read_inputs()
    Table training = read_table("input/train.csv", false)
    Table testing = read_table("input/test.csv", false)
    Table multi = read_table("input/multiclass.csv", true)
    return Data(training.names, training.training, testing.training, multi.names, multi.training, multi.testing, read_params())
