import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

int as_int(real64 value)
    int result = int(value)
    return result

int floor_int(real64 value)
    int integral = math.floor(value)
    return integral

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

string real_text(real64 value, int digits = 4)
    string result = if digits == 6 then "{value:frac=6}" else "{value:frac=4}"
    if result == "-0.0000" or result == "-0.000000"
        return result[1:<int(len(result))]
    return result

string ratio(int first, int second)
    return if second == 0 then "-" else real_text(as_real(first) / as_real(second))

int sign(real64 value)
    return if value > 0.0 then 1 else -1

int[] auc(int[] labels, real64[] scores)
    int positives = 0
    int negatives = 0
    int wins = 0
    int ties = 0
    for int i < int(len(labels))
        if labels[i] == 1
            positives += 1
            for int j < int(len(labels))
                if labels[j] == -1
                    if scores[i] > scores[j]
                        wins += 1
                    elif scores[i] == scores[j]
                        ties += 1
        else
            negatives += 1
    return [2 * wins + ties, 2 * positives * negatives]

int[][] confusion(int[] actual, int[] predicted, int classes)
    int[][] result = [for int c = (0:<classes)[] then array(nat(classes), fill = 0)]
    for int i < int(len(actual))
        result[actual[i] - 1][predicted[i] - 1] += 1
    return result

int count_margin(real64[] values, real64 threshold)
    int result = 0
    for real64 value = values[]
        if value <= threshold
            result += 1
    return result

void save(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)
