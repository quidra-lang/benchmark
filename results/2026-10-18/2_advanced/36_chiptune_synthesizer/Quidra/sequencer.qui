int samples_per_tick(int rate, int tempo)
    return rate * 5 / (tempo * 2)

int next_row(string[] names, int[] values, int position, int row)
    jump := -1
    pattern_break := -1
    for: index < int(names.len())
        if names[index] == "F" and values[index] == 0
            return -1
        if names[index] == "B"
            jump = values[index]
        elif names[index] == "D"
            pattern_break = values[index]
    if jump < 0 and pattern_break < 0
        return if row < 63 then position * 64 + row + 1 else (position + 1) * 64
    target_position := if jump < 0 then position + 1 else jump
    target_row := if pattern_break < 0 or pattern_break >= 64 then 0 else pattern_break
    return target_position * 64 + target_row

bool[] reachable(int[] following)
    reached := array(following.len(), fill = false)
    current := 0
    while current >= 0 and current < int(following.len()) and not reached[current]
        reached[current] = true
        current = following[current]
    return reached
