int samples_per_tick(int rate, int tempo)
    return rate * 5 / (tempo * 2)

int next_row(string[] names, int[] values, int position, int row)
    int jump = -1
    int pattern_break = -1
    for int index < int(len(names))
        if names[index] == "F" and values[index] == 0
            return -1
        if names[index] == "B"
            jump = values[index]
        elif names[index] == "D"
            pattern_break = values[index]
    if jump < 0 and pattern_break < 0
        return if row < 63 then position * 64 + row + 1 else (position + 1) * 64
    int target_position = if jump < 0 then position + 1 else jump
    int target_row = if pattern_break < 0 or pattern_break >= 64 then 0 else pattern_break
    return target_position * 64 + target_row

bool[] reachable(int[] following)
    bool[] reached = array(len(following), fill = false)
    int current = 0
    while current >= 0 and current < int(len(following)) and not reached[current]
        reached[current] = true
        current = following[current]
    return reached
