import instruments = "./instruments.qui"

int tick(string[] waves, int[][] tables, int[] modes, int[] &phases, int[] &registers, int[] increments, int[] amplitudes, bool[] sounding, int count, int gain, int[] muted, int[] &samples, int[][] &lanes)
    int clipped = 0
    for _ < count
        int total = 0
        for int channel < int(len(waves))
            int value = 0
            if sounding[channel]
                int level = instruments.wave(waves[channel], tables[channel], modes[channel], phases[channel], registers[channel])
                value = (2 * level - 15) * amplitudes[channel]
                phases[channel] += increments[channel]
                if phases[channel] >= 65536
                    phases[channel] -= 65536
                    if waves[channel] == "NOISE"
                        registers[channel] = instruments.clock(registers[channel], modes[channel])
            lanes[channel] = lanes[channel].append(value)
            if muted[channel] == 0
                total += value
        int sample = 128 + instruments.floor_div(gain * total, 4096)
        if sample < 0 or sample > 255
            clipped += 1
            sample = instruments.clamp(sample, 0, 255)
        samples = samples.append(sample)
    return clipped

void fade(int[] &samples, int fade_length)
    int count = int(len(samples))
    int length = if fade_length < count then fade_length else count
    for count - length <= int index < count
        samples[index] = 128 + instruments.floor_div((samples[index] - 128) * (count - 1 - index), length)
