string[] read_lines(string path)
    string content = file.read(path)
    string[] lines = content.split(NL)
    return lines[0:<int(len(lines)) - 1]

int hex_value(string text)
    string digits = "0123456789ABCDEF"
    int value = 0
    for int index < int(len(text))
        int digit = 0
        while digits[digit] != text[index]
            digit += 1
        value = 16 * value + digit
    return value

string[] pitch_names()
    return ["C-", "C#", "D-", "D#", "E-", "F-", "F#", "G-", "G#", "A-", "A#", "B-"]

int note_number(string name)
    string[] pitches = pitch_names()
    int pitch = 0
    while pitches[pitch] != name[0:<2]
        pitch += 1
    int octave = int.parse(name[2])
    return 12 * octave + pitch

string note_name(int number)
    string[] pitches = pitch_names()
    return pitches[number % 12] + "{number / 12}"

class Effect(string text)
    string name = if text == "..." then "" elif text[0] == "E" then text[0:<2] else text[0]
    int value = if text == "..." then 0 elif text[0] == "E" then hex_value(text[2]) else hex_value(text[1:])
    int high = value / 16
    int low = value % 16

class Cell(string text = "... .. . ...")
    int note = if text[0:<3] == "..." then -1 elif text[0:<3] == "OFF" then -2 else note_number(text[0:<3])
    int instrument = if text[4:<6] == ".." then -1 else hex_value(text[4:<6])
    int volume = if text[7] == "." then -1 else hex_value(text[7])
    Effect effect = Effect(text[9:])
    bool has_note = note != -1
    bool empty = text == "... .. . ..."

class Instrument(int number, string name)
    string wave = ""
    int mode = 0
    int[] table = []
    int attack = 0
    int decay = 0
    int sustain = 0
    int release = 0
    int[] vibrato = []
    int[] arpeggio = []
    int sweep = 0

class Pattern(int number)
    Cell[][] rows = array(64, fill = array(4, fill = Cell()))

class Song(string title, int rate, int speed, int tempo, int gain)
    Instrument[] instruments = []
    Pattern[] patterns = []
    int[] instrument_index = array(256, fill = -1)
    int[] pattern_index = array(256, fill = -1)
    int[] order = []

    Cell[] cells(int position, int row)
        return patterns[pattern_index[order[position]]].rows[row]

Song read_song(string path)
    string[] lines = [for string line = read_lines(path)[] if line != "" and not line.starts_with("#") then line]
    int rate = int.parse(lines[1][5:])
    int speed = int.parse(lines[2][6:])
    int tempo = int.parse(lines[3][6:])
    int gain = int.parse(lines[4][5:])
    Song song = Song(lines[0][6:], rate, speed, tempo, gain)
    int index = 5
    while index < int(len(lines))
        string[] header = lines[index].split(" ")
        index += 1
        if header[0] == "ORDER"
            song.order = [for string value = header[1:][] then hex_value(value)]
        elif header[0] == "INSTRUMENT"
            Instrument instrument = Instrument(hex_value(header[1]), header[2])
            while lines[index] != "END"
                string[] row = lines[index].split(" ")
                if row[0] == "WAVE"
                    instrument.wave = row[1]
                    if row[1] == "PULSE"
                        string[] duties = ["12", "25", "50", "75"]
                        while duties[instrument.mode] != row[2]
                            instrument.mode += 1
                    elif row[1] == "NOISE"
                        instrument.mode = if row[2] == "SHORT" then 1 else 0
                    elif row[1] == "TABLE"
                        for int offset < 32
                            instrument.table = instrument.table.append(hex_value(row[2][offset]))
                elif row[0] == "ENVELOPE"
                    instrument.attack = int.parse(row[1])
                    instrument.decay = int.parse(row[2])
                    instrument.sustain = int.parse(row[3])
                    instrument.release = int.parse(row[4])
                elif row[0] == "VIBRATO"
                    instrument.vibrato = [for string value = row[1:][] then int.parse(value)]
                elif row[0] == "ARPEGGIO"
                    instrument.arpeggio = [for string value = row[1:][] then int.parse(value)]
                else
                    instrument.sweep = int.parse(row[1])
                index += 1
            index += 1
            song.instrument_index[instrument.number] = int(len(song.instruments))
            song.instruments = song.instruments.append(instrument)
        else
            Pattern pattern = Pattern(hex_value(header[1]))
            while lines[index] != "END"
                int row = hex_value(lines[index][0:<2])
                pattern.rows[row] = [for string text = lines[index][3:].split(" | ")[] then Cell(text)]
                index += 1
            index += 1
            song.pattern_index[pattern.number] = int(len(song.patterns))
            song.patterns = song.patterns.append(pattern)
    return song

class Params(local string[][] rows)
    int max_samples = int.parse(rows[0][1])
    int loops = int.parse(rows[1][1])
    int fade = int.parse(rows[2][1])
    int[] muted = [for string value = rows[3][1:][] then int.parse(value)]
    int window_start = int.parse(rows[4][1])
    int window_length = int.parse(rows[4][2])
    int window_width = int.parse(rows[4][3])
    int window_height = int.parse(rows[4][4])
    int window_scope = int.parse(rows[4][5])
    int roll_start = int.parse(rows[5][1])
    int roll_rows = int.parse(rows[5][2])
    int preview_note = note_number(rows[6][1])
    int preview_ticks = int.parse(rows[6][2])
    int preview_release = int.parse(rows[6][3])
    bool[] traces = array(4096, fill = false)
    for int index = (7:<int(len(rows)))[]
        traces[64 * hex_value(rows[index][1]) + hex_value(rows[index][2])] = true

Params read_params(string path)
    return Params([for string line = read_lines(path)[] then line.split(" ")])
