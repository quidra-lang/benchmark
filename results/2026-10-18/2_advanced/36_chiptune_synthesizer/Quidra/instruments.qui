int floor_div(int numerator, int denominator)
    return if numerator >= 0 then numerator / denominator else -((-numerator + denominator - 1) / denominator)

int clamp(int value, int low, int high)
    return if value < low then low elif value > high then high else value

int absolute(int value)
    return if value < 0 then -value else value

int power_two(int exponent)
    int value = 1
    for _ < exponent
        value *= 2
    return value

int[] note_table()
    return [26163, 27718, 29366, 31113, 32963, 34923, 36999, 39200, 41530, 44000, 46616, 49388]

int frequency(int note)
    int[] table = note_table()
    int octave = note / 12
    return if octave >= 4 then table[note % 12] * power_two(octave - 4) else table[note % 12] / power_two(4 - octave)

int transpose(int base_frequency, int semitones)
    int[] table = note_table()
    return base_frequency * table[semitones % 12] / table[0] * power_two(semitones / 12)

int oscillation(int position, int depth, int divisor)
    int[] sine = [0, 24, 49, 74, 97, 120, 141, 161, 180, 197, 212, 224, 235, 244, 250, 253, 255, 253, 250, 244, 235, 224, 212, 197, 180, 161, 141, 120, 97, 74, 49, 24]
    int value = sine[position % 32] * depth / divisor
    return if position < 32 then value else -value

int envelope(int attack, int decay, int sustain, int release, int age, bool released, int release_age, int release_level)
    if released
        int elapsed = age - release_age
        return if elapsed < release then release_level * (release - 1 - elapsed) / release else 0
    if age < attack
        return 15 * (age + 1) / attack
    if age < attack + decay
        return 15 - (15 - sustain) * (age - attack + 1) / decay
    return sustain

int wave(string waveform, int[] table, int mode, int phase, int register)
    if waveform == "PULSE"
        int[] duties = [1, 2, 4, 6]
        return if phase / 8192 < duties[mode] then 15 else 0
    if waveform == "TRIANGLE"
        int step = phase / 2048
        return if step < 16 then 15 - step else step - 16
    if waveform == "SAW"
        return phase / 4096
    if waveform == "TABLE"
        return table[phase / 2048]
    return if register % 2 == 0 then 15 else 0

int clock(int register, int mode)
    int divisor = if mode == 0 then 2 else 64
    int feedback = (register % 2 + register / divisor % 2) % 2
    return register / 2 + feedback * 16384
