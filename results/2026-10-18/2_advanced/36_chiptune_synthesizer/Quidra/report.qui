string hexadecimal(int value, int width = 2)
    string digits = "0123456789ABCDEF"
    string text = ""
    int remaining = value
    while remaining > 0 or int(len(text)) < width
        text = digits[remaining % 16] + text
        remaining /= 16
    return text

string[] hex_lines(int[] samples)
    string[] lines = []
    for int start < int(len(samples)) step 32
        string text = ""
        int finish = if start + 32 < int(len(samples)) then start + 32 else int(len(samples))
        for start <= int index < finish
            text += hexadecimal(samples[index])
        lines = lines.append(text)
    return lines

string adler(int[] values)
    int a = 1
    int b = 0
    for int value = values[]
        a = (a + value) % 65521
        b = (b + a) % 65521
    return hexadecimal(b * 65536 + a, 8)

int isqrt(int value)
    int low = 0
    int high = 1
    while high * high <= value
        high *= 2
    while low + 1 < high
        int middle = (low + high) / 2
        if middle * middle <= value
            low = middle
        else
            high = middle
    return low

int peak(int[] values, int center)
    int result = 0
    for int value = values[]
        int magnitude = if value < center then center - value else value - center
        if magnitude > result
            result = magnitude
    return result

int rms(int[] values, int center)
    int sum = 0
    for int value = values[]
        sum += (value - center) * (value - center)
    return isqrt(sum / int(len(values)))

int crossings(int[] samples)
    int count = 0
    for 1 <= int index < int(len(samples))
        if (samples[index - 1] < 128) != (samples[index] < 128)
            count += 1
    return count
