string hexadecimal(int value, width := 2)
    if width <= 0 and value <= 0
        return ""
    nat checked := nat(value)
    hex := checked.B16
    return if hex.len() < width then "0" * (width - hex.len()) + hex else hex

string[] hex_lines(int[] samples)
    string[] lines := []
    for: start < int(samples.len()) step 32
        text := ""
        finish := if start + 32 < int(samples.len()) then start + 32 else int(samples.len())
        for: start <= index < finish
            text += hexadecimal(samples[index])
        lines = lines.append(text)
    return lines

string adler(int[] values)
    a := 1
    b := 0
    for value := values[]
        a = (a + value) % 65521
        b = (b + a) % 65521
    return hexadecimal(b * 65536 + a, 8)

int isqrt(int value)
    low := 0
    high := 1
    while high * high <= value
        high *= 2
    while low + 1 < high
        middle := (low + high) / 2
        if middle * middle <= value
            low = middle
        else
            high = middle
    return low

int peak(int[] values, int center)
    result := 0
    for value := values[]
        magnitude := if value < center then center - value else value - center
        if magnitude > result
            result = magnitude
    return result

int rms(int[] values, int center)
    sum := 0
    for value := values[]
        sum += (value - center) * (value - center)
    return isqrt(sum / int(values.len()))

int crossings(int[] samples)
    count := 0
    for: 1 <= index < int(samples.len())
        if (samples[index - 1] < 128) != (samples[index] < 128)
            count += 1
    return count
