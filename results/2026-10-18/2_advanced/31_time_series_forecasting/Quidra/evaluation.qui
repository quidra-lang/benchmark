import math
import decomposition = "./decomposition.qui"

real64 seasonal_scale(real64[] values, int season)
    real64 total = 0.0
    for season <= int time < int(len(values))
        total += math.abs(values[time] - values[time - season])
    return total / real64(int(len(values)) - season)

class Accuracy(real64 me, real64 mae, real64 rmse, real64 mape, real64 smape, real64 mase)
    real64 fva = 0.0
    real64 cv_rmse = 0.0
    int cover80 = 0
    int cover95 = 0
    real64 winkler80 = 0.0
    real64 winkler95 = 0.0
    int rank = 0

Accuracy accuracy(real64[] actual, real64[] predicted, real64 scale)
    real64 total = 0.0
    real64 absolute = 0.0
    real64 squared = 0.0
    real64 percentage = 0.0
    real64 symmetric = 0.0
    for int index < int(len(actual))
        real64 residual = actual[index] - predicted[index]
        total += residual
        absolute += math.abs(residual)
        squared += residual * residual
        percentage += math.abs(residual) / actual[index]
        symmetric += 2.0 * math.abs(residual) / (math.abs(actual[index]) + math.abs(predicted[index]))
    real64 count = real64(len(actual))
    real64 mae = absolute / count
    return Accuracy(total / count, mae, math.sqrt(squared / count), 100.0 * percentage / count, 100.0 * symmetric / count, mae / scale)

real64 winkler(real64 actual, real64 low, real64 high, real64 multiplier)
    if actual < low
        return high - low + multiplier * (low - actual)
    if actual > high
        return high - low + multiplier * (actual - high)
    return high - low

int[] ranking(Accuracy[] metrics)
    int[] result = []
    for int index < int(len(metrics))
        int position = int(len(result))
        result = result.append(index)
        while position > 0 and metrics[index].rmse < metrics[result[position - 1]].rmse
            result[position] = result[position - 1]
            position -= 1
        result[position] = index
    return result
