import math

public import smoothing = "./smoothing.qui"

real64 exponential(real64 value)
    real64 result = math.exp(value)
    return result

real64 as_real(int value)
    real64 converted = real64(value)
    return converted

class Difference(string kind, real64[] values, int offset)

Difference difference(real64[] values, int season, string kind)
    int offset = if kind == "none" then 0 elif kind == "first" then 1 elif kind == "seasonal" then season else season + 1
    real64[] result = []
    for offset <= int moment < int(len(values))
        real64 value = values[moment]
        if kind == "first"
            value -= values[moment - 1]
        elif kind == "seasonal"
            value -= values[moment - season]
        elif kind == "both"
            value = (values[moment] - values[moment - 1]) - (values[moment - season] - values[moment - season - 1])
        result = result.append(value)
    return Difference(kind, result, offset)

class Correlation(real64 mean, real64 variance, real64[] values)

Correlation autocorrelation(real64[] values, int max_lag)
    real64 mean = smoothing.decomposition.mean(values)
    real64[] centered = [for real64 value = values[] then value - mean]
    real64 variance = smoothing.decomposition.total([for real64 value = centered[] then value * value]) / as_real(int(len(values)))
    real64[] correlations = [1.0]
    for 1 <= int lag <= max_lag
        real64 numerator = 0.0
        for int index < int(len(values)) - lag
            numerator += centered[index] * centered[index + lag]
        correlations = correlations.append(numerator / as_real(int(len(values))) / variance)
    return Correlation(mean, variance, correlations)

class Levinson(real64[][] coefficients, real64[] partial, real64[] variances)

Levinson durbin_levinson(real64[] correlations)
    real64[][] coefficients = [[]]
    real64[] partial = [0.0]
    real64[] variances = [1.0]
    for 1 <= int order < int(len(correlations))
        real64[] previous = coefficients[len(coefficients) - 1]
        real64 correction = 0.0
        for 1 <= int index < order
            correction += previous[index - 1] * correlations[order - index]
        real64 theta = (correlations[order] - correction) / variances[len(variances) - 1]
        real64[] current = [for int index = (1:<order)[] then previous[index - 1] - theta * previous[order - index - 1]].append(theta)
        coefficients = coefficients.append(current)
        partial = partial.append(theta)
        variances = variances.append(variances[len(variances) - 1] * (1.0 - theta * theta))
    return Levinson(coefficients, partial, variances)

real64[] residuals(real64[] values, real64 mean, real64[] coefficients)
    int order = int(len(coefficients))
    real64[] errors = []
    for order <= int index < int(len(values))
        real64 total = 0.0
        for 1 <= int lag <= order
            total += coefficients[lag - 1] * (values[index - lag] - mean)
        errors = errors.append(values[index] - mean - total)
    return errors

real64[] forecast(real64[] values, real64[] differenced, int offset, string kind, real64 mean, real64[] coefficients, int origin, int steps, int season)
    real64[] transformed = differenced[0:<origin - offset]
    real64[] extended = values[0:<origin]
    real64[] result = []
    for _ < steps
        real64 total = 0.0
        for 1 <= int lag <= int(len(coefficients))
            total += coefficients[lag - 1] * (transformed[int(len(transformed)) - lag] - mean)
        real64 predicted = mean + total
        transformed = transformed.append(predicted)
        int size = int(len(extended))
        if kind == "first"
            predicted += extended[size - 1]
        elif kind == "seasonal"
            predicted += extended[size - season]
        elif kind == "both"
            predicted = predicted + extended[size - 1] + extended[size - season] - extended[size - season - 1]
        extended = extended.append(predicted)
        result = result.append(predicted)
    return result

class LjungBox(int lag, real64 q, real64 probability)

LjungBox[] ljung_box(real64[] errors, int[] lags)
    int count = int(len(errors))
    Correlation correlation = autocorrelation(errors, math.max_all(lags))
    LjungBox[] result = []
    for int lag = lags[]
        real64 total = 0.0
        for 1 <= int index <= lag
            total += correlation.values[index] * correlation.values[index] / as_real(int(count - index))
        real64 q = as_real(int(count)) * as_real(int(count + 2)) * total
        real64 x = q / 2.0
        real64 term = 1.0
        real64 sum = 1.0
        for 1 <= int index < lag / 2
            term = term * x / as_real(int(index))
            sum += term
        result = result.append(LjungBox(lag, q, exponential(-x) * sum))
    return result
