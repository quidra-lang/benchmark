import math

real64 total(real64[] values)
    real64 sum = 0.0
    for real64 value = values[]
        sum += value
    return sum

real64 mean(real64[] values)
    return total(values) / real64(len(values))

real64 sample_variance(real64[] values)
    real64 average = mean(values)
    return total([for real64 value = values[] then (value - average) * (value - average)]) / real64(int(len(values)) - 1)

class Components(real64[] trend, real64[] additive, real64[] multiplicative, real64[] residual_add, real64[] residual_mult, int[] defined)

Components decompose(real64[] values, int season)
    int count = int(len(values))
    int half = season / 2
    int[] defined = half:<count - half
    real64[] trend = array(nat(count), fill = 0.0)
    for int time = defined[]
        real64 value = 0.5 * values[time - half]
        for time - half + 1 <= int index < time + half
            value += values[index]
        value += 0.5 * values[time + half]
        trend[time] = value / real64(season)
    real64[] additive = []
    real64[] multiplicative = []
    for int position < season
        int[] times = [for int time = defined[] if time % season == position then time]
        additive = additive.append(mean([for int time = times[] then values[time] - trend[time]]))
        multiplicative = multiplicative.append(mean([for int time = times[] then values[time] / trend[time]]))
    real64 average_add = total(additive) / real64(season)
    real64 average_mult = total(multiplicative) / real64(season)
    additive = [for real64 value = additive[] then value - average_add]
    multiplicative = [for real64 value = multiplicative[] then value / average_mult]
    real64[] residual_add = array(nat(count), fill = 0.0)
    real64[] residual_mult = array(nat(count), fill = 0.0)
    for int time = defined[]
        int position = time % season
        residual_add[time] = values[time] - trend[time] - additive[position]
        residual_mult[time] = values[time] / (trend[time] * multiplicative[position])
    return Components(trend, additive, multiplicative, residual_add, residual_mult, defined)

class Regression(real64 intercept, real64 slope)

Regression least_squares_line(real64[] values)
    real64 center = real64(int(len(values)) + 1) / 2.0
    real64 average = mean(values)
    real64 numerator = 0.0
    real64 denominator = 0.0
    for int time < int(len(values))
        real64 position = real64(time + 1) - center
        numerator += position * (values[time] - average)
        denominator += position * position
    real64 slope = numerator / denominator
    return Regression(average - slope * center, slope)
