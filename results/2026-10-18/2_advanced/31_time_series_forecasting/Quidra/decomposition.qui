import math

real64 as_real(int value)
    real64 converted = real64(value)
    return converted

real64 total(real64[] values)
    real64 sum = 0.0
    for real64 value = values[]
        sum += value
    return sum

real64 mean(real64[] values)
    return total(values) / as_real(int(len(values)))

real64 sample_variance(real64[] values)
    real64 average = mean(values)
    return total([for real64 value = values[] then (value - average) * (value - average)]) / as_real(int(int(len(values)) - 1))

class Components(real64[] trend, real64[] additive, real64[] multiplicative, real64[] residual_add, real64[] residual_mult, int[] defined)

Components decompose(real64[] values, int season)
    int count = int(len(values))
    int half = season / 2
    int[] defined = half:<count - half
    real64[] trend = array(nat(count), fill = 0.0)
    for int moment = defined[]
        real64 value = 0.5 * values[moment - half]
        for moment - half + 1 <= int index < moment + half
            value += values[index]
        value += 0.5 * values[moment + half]
        trend[moment] = value / as_real(int(season))
    real64[] additive = []
    real64[] multiplicative = []
    for int position < season
        int[] times = [for int moment = defined[] if moment % season == position then moment]
        additive = additive.append(mean([for int moment = times[] then values[moment] - trend[moment]]))
        multiplicative = multiplicative.append(mean([for int moment = times[] then values[moment] / trend[moment]]))
    real64 average_add = total(additive) / as_real(int(season))
    real64 average_mult = total(multiplicative) / as_real(int(season))
    additive = [for real64 value = additive[] then value - average_add]
    multiplicative = [for real64 value = multiplicative[] then value / average_mult]
    real64[] residual_add = array(nat(count), fill = 0.0)
    real64[] residual_mult = array(nat(count), fill = 0.0)
    for int moment = defined[]
        int position = moment % season
        residual_add[moment] = values[moment] - trend[moment] - additive[position]
        residual_mult[moment] = values[moment] / (trend[moment] * multiplicative[position])
    return Components(trend, additive, multiplicative, residual_add, residual_mult, defined)

class Regression(real64 intercept, real64 slope)

Regression least_squares_line(real64[] values)
    real64 center = as_real(int(int(len(values)) + 1)) / 2.0
    real64 average = mean(values)
    real64 numerator = 0.0
    real64 denominator = 0.0
    for int moment < int(len(values))
        real64 position = as_real(int(moment + 1)) - center
        numerator += position * (values[moment] - average)
        denominator += position * position
    real64 slope = numerator / denominator
    return Regression(average - slope * center, slope)
