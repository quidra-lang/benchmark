class Series(string name)
    string[] periods = []
    int[] raw = []

class Event(string series, string period, string kind)
class Inventory(string series, int on_hand, int lead_time, int review, real64 service)
class Settings(local string[][] rows)
    int season = int.parse(rows[0][1])
    int holdout = int.parse(rows[1][1])
    int horizon = int.parse(rows[2][1])
    int cv_start = int.parse(rows[3][1])
    int combo = int.parse(rows[4][1])
    real64[] alpha = [for string value = rows[5][1:][] then real64.parse(value)]
    real64[] beta = [for string value = rows[6][1:][] then real64.parse(value)]
    real64[] gamma = [for string value = rows[7][1:][] then real64.parse(value)]
    real64[] phi = [for string value = rows[8][1:][] then real64.parse(value)]
    int max_ar = int.parse(rows[9][1])
    int max_lag = int.parse(rows[10][1])
    int[] ljung_box = [for string value = rows[11][1:][] then int.parse(value)]
    real64 outlier = real64.parse(rows[12][1])
    real64[] interval = [for string value = rows[13][1:][] then real64.parse(value)]

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

class Inputs(Series[] series, Event[] events, Inventory[] inventory, Settings settings)

Inputs read_inputs()
    Series[] series = []
    for string line = read_lines("input/series.csv")[1:][]
        string[] fields = line.split(",")
        int last = int(len(series)) - 1
        if last < 0 or series[last].name != fields[0]
            series = series.append(Series(fields[0]))
            last += 1
        series[last].periods = series[last].periods.append(fields[1])
        series[last].raw = series[last].raw.append(if fields[2] == "NA" then -1 else int.parse(fields[2]))
    Event[] events = []
    for string line = read_lines("input/events.csv")[1:][]
        string[] fields = line.split(",")
        events = events.append(Event(fields[0], fields[1], fields[2]))
    Inventory[] inventory = []
    for string line = read_lines("input/inventory.csv")[1:][]
        string[] fields = line.split(",")
        inventory = inventory.append(Inventory(fields[0], int.parse(fields[1]), int.parse(fields[2]), int.parse(fields[3]), real64.parse(fields[4])))
    return Inputs(series, events, inventory, Settings([for string line = read_lines("input/params.txt")[] then line.split(" ")]))

string next_month(string period)
    string[] fields = period.split("-")
    int year = int.parse(fields[0])
    int month = int.parse(fields[1])
    year += month / 12
    month = month % 12 + 1
    return "{year:int=4,zero}-{month:int=2,zero}"

string real_text(real64 value)
    string text = "{value:frac=4}"
    return if text == "-0.0000" then "0.0000" else text

string maybe_real(real64 value, bool defined)
    return if defined then real_text(value) else "NA"

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
