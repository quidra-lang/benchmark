import terms = "./terms.qui"
import unify = "./unify.qui"

class Numeric(value := 0, fault := -1)
class CheckedList(int[] elements := [], fault := -1)
class Result(bool success, fault := -1)

bool deterministic(string name, int arity)
    key := "{name}/{arity}"
    for item := ["true/0", "fail/0", "false/0", "=/2", "\=/2", "==/2", "\==/2", "var/1", "nonvar/1", "atom/1", "number/1", "integer/1", "atomic/1", "compound/1", "callable/1", "is_list/1", "is/2", "=:=/2", "=\=/2", "</2", ">/2", "=</2", ">=/2", "functor/3", "arg/3", "=../2", "copy_term/2", "atom_length/2", "atom_chars/2", "write/1", "writeq/1", "nl/0"][]
        if key == item
            return true
    return false

Numeric require_integer(terms.Store &store, int term)
    index := terms.dereference(store, term)
    if store.nodes[index].kind == "variable"
        return Numeric(fault = terms.atom(&store, "instantiation_error"))
    if store.nodes[index].kind != "integer"
        return Numeric(fault = terms.type_error(&store, "integer", index))
    return Numeric(store.nodes[index].value)

int require_atom(terms.Store &store, int term)
    kind := terms.kind(store, term)
    if kind == "variable"
        return terms.atom(&store, "instantiation_error")
    if kind != "atom"
        return terms.type_error(&store, "atom", term)
    return -1

CheckedList require_list(terms.Store &store, int term)
    parts := terms.list_parts(store, term)
    if terms.kind(store, parts.tail) == "variable"
        return CheckedList(fault = terms.atom(&store, "instantiation_error"))
    if not terms.is_atom(store, parts.tail, "[]")
        return CheckedList(fault = terms.type_error(&store, "list", term))
    return CheckedList(parts.elements)

Numeric checked(terms.Store &store, int value)
    if value < -2147483648 or value > 2147483647
        return Numeric(fault = terms.named_error(&store, "evaluation_error", "int_overflow"))
    return Numeric(value)

Numeric evaluate(terms.Store &store, int term);

Numeric evaluate(terms.Store &store, int term)
    index := terms.dereference(store, term)
    terms.Node expression := store.nodes[index]
    if expression.kind == "variable"
        return Numeric(fault = terms.atom(&store, "instantiation_error"))
    if expression.kind == "integer"
        return Numeric(expression.value)
    arity := terms.arity(store, index)
    supported := (arity == 1 and (expression.name == "-" or expression.name == "abs")) or (arity == 2 and (expression.name == "+" or expression.name == "-" or expression.name == "*" or expression.name == "//" or expression.name == "mod" or expression.name == "rem" or expression.name == "min" or expression.name == "max"))
    if not supported
        indicator := terms.term_indicator(&store, index)
        return Numeric(fault = terms.type_error(&store, "evaluable", indicator))
    first := evaluate(&store, expression.args[0])
    if first.fault >= 0
        return first
    if arity == 1
        result := if expression.name == "-" then -first.value elif first.value < 0 then -first.value else first.value
        return checked(&store, result)
    second := evaluate(&store, expression.args[1])
    if second.fault >= 0
        return second
    a := first.value
    b := second.value
    name := expression.name
    if (name == "//" or name == "mod" or name == "rem") and b == 0
        return Numeric(fault = terms.named_error(&store, "evaluation_error", "zero_divisor"))
    result := 0
    if name == "+"
        result = a + b
    elif name == "-"
        result = a - b
    elif name == "*"
        result = a * b
    elif name == "//"
        result = a / b
    elif name == "mod" or name == "rem"
        result = a - b * (a / b)
        if name == "mod" and result != 0 and (result < 0) != (b < 0)
            result += b
    elif name == "min"
        result = if a < b then a else b
    else
        result = if a > b then a else b
    return checked(&store, result)

Result execute(terms.Store &store, unify.Trail &trail, int goal)
    index := terms.dereference(store, goal)
    terms.Node node := store.nodes[index]
    name := node.name
    args := [for argument := node.args[] then terms.dereference(store, argument)]
    if name == "true"
        return Result(true)
    if name == "fail" or name == "false"
        return Result(false)
    if name == "="
        return Result(unify.unify(&store, &trail, args[0], args[1]))
    if name == "\="
        mark := int(len(trail.bindings))
        result := unify.unify(&store, &trail, args[0], args[1])
        unify.undo(&store, &trail, mark)
        return Result(not result)
    if name == "==" or name == "\=="
        result := unify.identical(store, args[0], args[1])
        return Result(if name == "==" then result else not result)
    if name == "var"
        return Result(terms.kind(store, args[0]) == "variable")
    if name == "nonvar"
        return Result(terms.kind(store, args[0]) != "variable")
    if name == "atom"
        return Result(terms.kind(store, args[0]) == "atom")
    if name == "number" or name == "integer"
        return Result(terms.kind(store, args[0]) == "integer")
    if name == "atomic"
        return Result(terms.kind(store, args[0]) == "atom" or terms.kind(store, args[0]) == "integer")
    if name == "compound"
        return Result(terms.kind(store, args[0]) == "compound")
    if name == "callable"
        return Result(terms.kind(store, args[0]) == "atom" or terms.kind(store, args[0]) == "compound")
    if name == "is_list"
        return Result(terms.is_atom(store, terms.list_parts(store, args[0]).tail, "[]"))
    if name == "is"
        number := evaluate(&store, args[1])
        if number.fault >= 0
            return Result(false, number.fault)
        value := terms.integer(&store, number.value)
        return Result(unify.unify(&store, &trail, args[0], value))
    if name == "=:=" or name == "=\=" or name == "<" or name == ">" or name == "=<" or name == ">="
        first := evaluate(&store, args[0])
        if first.fault >= 0
            return Result(false, first.fault)
        second := evaluate(&store, args[1])
        if second.fault >= 0
            return Result(false, second.fault)
        a := first.value
        b := second.value
        return Result(if name == "=:=" then a == b elif name == "=\=" then a != b elif name == "<" then a < b elif name == ">" then a > b elif name == "=<" then a <= b else a >= b)
    if name == "functor"
        terms.Node term := store.nodes[args[0]]
        terms.Node functor := store.nodes[args[1]]
        terms.Node count := store.nodes[args[2]]
        if term.kind != "variable"
            first := if term.kind == "compound" then terms.atom(&store, term.name) else args[0]
            number := terms.integer(&store, if term.kind == "compound" then int(len(term.args)) else 0)
            return Result(unify.unify(&store, &trail, args[1], first) and unify.unify(&store, &trail, args[2], number))
        if functor.kind == "variable" or count.kind == "variable"
            return Result(false, terms.atom(&store, "instantiation_error"))
        if functor.kind == "compound"
            return Result(false, terms.type_error(&store, "atomic", args[1]))
        if count.kind != "integer"
            return Result(false, terms.type_error(&store, "integer", args[2]))
        if count.value < 0
            return Result(false, terms.domain_error(&store, "not_less_than_zero", args[2]))
        if count.value > 255
            return Result(false, terms.named_error(&store, "representation_error", "max_arity"))
        if count.value == 0
            return Result(unify.unify(&store, &trail, args[0], args[1]))
        if functor.kind == "integer"
            return Result(false, terms.type_error(&store, "atom", args[1]))
        int[] parameters := []
        for: position < count.value
            parameters = parameters.append(terms.variable(&store))
        value := terms.compound(&store, functor.name, parameters)
        return Result(unify.unify(&store, &trail, args[0], value))
    if name == "arg"
        terms.Node number := store.nodes[args[0]]
        terms.Node term := store.nodes[args[1]]
        if number.kind == "variable" or term.kind == "variable"
            return Result(false, terms.atom(&store, "instantiation_error"))
        if number.kind != "integer"
            return Result(false, terms.type_error(&store, "integer", args[0]))
        if term.kind != "compound"
            return Result(false, terms.type_error(&store, "compound", args[1]))
        if number.value < 1 or number.value > int(len(term.args))
            return Result(false)
        return Result(unify.unify(&store, &trail, term.args[number.value - 1], args[2]))
    if name == "=.."
        terms.Node term := store.nodes[args[0]]
        if term.kind == "compound"
            head := terms.atom(&store, term.name)
            sequence := terms.make_list(&store, [head].concat(term.args))
            return Result(unify.unify(&store, &trail, sequence, args[1]))
        if term.kind != "variable"
            sequence := terms.make_list(&store, [args[0]])
            return Result(unify.unify(&store, &trail, sequence, args[1]))
        sequence := require_list(&store, args[1])
        if sequence.fault >= 0
            return Result(false, sequence.fault)
        if len(sequence.elements) == 0
            empty := terms.atom(&store, "[]")
            return Result(false, terms.domain_error(&store, "non_empty_list", empty))
        first := terms.dereference(store, sequence.elements[0])
        terms.Node head := store.nodes[first]
        if head.kind == "variable"
            return Result(false, terms.atom(&store, "instantiation_error"))
        if len(sequence.elements) == 1
            if head.kind == "compound"
                return Result(false, terms.type_error(&store, "atomic", first))
            return Result(unify.unify(&store, &trail, args[0], first))
        if head.kind != "atom"
            return Result(false, terms.type_error(&store, "atom", first))
        if len(sequence.elements) > 256
            return Result(false, terms.named_error(&store, "representation_error", "max_arity"))
        value := terms.compound(&store, head.name, sequence.elements[1:<int(len(sequence.elements))])
        return Result(unify.unify(&store, &trail, args[0], value))
    if name == "copy_term"
        copy := terms.copy_term(&store, args[0])
        return Result(unify.unify(&store, &trail, copy, args[1]))
    if name == "atom_length"
        fault := require_atom(&store, args[0])
        if fault >= 0
            return Result(false, fault)
        if terms.kind(store, args[1]) != "variable" and terms.kind(store, args[1]) != "integer"
            return Result(false, terms.type_error(&store, "integer", args[1]))
        count := terms.integer(&store, int(len(store.nodes[args[0]].name)))
        return Result(unify.unify(&store, &trail, count, args[1]))
    if name == "atom_chars"
        if terms.kind(store, args[0]) != "variable"
            fault := require_atom(&store, args[0])
            if fault >= 0
                return Result(false, fault)
            string atom_text := store.nodes[args[0]].name
            int[] elements := []
            for: position < int(len(atom_text))
                elements = elements.append(terms.atom(&store, atom_text[position]))
            sequence := terms.make_list(&store, elements)
            return Result(unify.unify(&store, &trail, args[1], sequence))
        sequence := require_list(&store, args[1])
        if sequence.fault >= 0
            return Result(false, sequence.fault)
        collected_text := ""
        for element := sequence.elements[]
            character_index := terms.dereference(store, element)
            terms.Node character := store.nodes[character_index]
            if character.kind == "variable"
                return Result(false, terms.atom(&store, "instantiation_error"))
            if character.kind != "atom" or len(character.name) != 1
                return Result(false, terms.type_error(&store, "character", character_index))
            collected_text += character.name
        value := terms.atom(&store, collected_text)
        return Result(unify.unify(&store, &trail, args[0], value))
    return Result(false)
