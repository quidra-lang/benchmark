import terms = "./terms.qui"

class Trail()
    int[] bindings := []

void undo(terms.Store &store, Trail &trail, int mark)
    while int(len(trail.bindings)) > mark
        variable := trail.bindings[int(len(trail.bindings)) - 1]
        store.nodes[variable].binding = -1
        trail.bindings = trail.bindings[0:<int(len(trail.bindings)) - 1]

bool unify(terms.Store &store, Trail &trail, int first, int second)
    int[][] pending := [[first, second]]
    while len(pending) > 0
        pair := pending[int(len(pending)) - 1]
        pending = pending[0:<int(len(pending)) - 1]
        left := terms.dereference(store, pair[0])
        right := terms.dereference(store, pair[1])
        if left == right
            continue
        terms.Node a := store.nodes[left]
        terms.Node b := store.nodes[right]
        if a.kind == "variable"
            store.nodes[left].binding = right
            trail.bindings = trail.bindings.append(left)
        elif b.kind == "variable"
            store.nodes[right].binding = left
            trail.bindings = trail.bindings.append(right)
        elif a.kind != b.kind
            return false
        elif a.kind == "integer"
            if a.value != b.value
                return false
        elif a.kind == "atom"
            if a.name != b.name
                return false
        else
            if a.name != b.name or len(a.args) != len(b.args)
                return false
            index := int(len(a.args)) - 1
            while index >= 0
                pending = pending.append([a.args[index], b.args[index]])
                index -= 1
    return true

bool identical(const terms.Store store, int first, int second)
    int[][] pending := [[first, second]]
    while len(pending) > 0
        pair := pending[int(len(pending)) - 1]
        pending = pending[0:<int(len(pending)) - 1]
        left := terms.dereference(store, pair[0])
        right := terms.dereference(store, pair[1])
        if left == right
            continue
        terms.Node a := store.nodes[left]
        terms.Node b := store.nodes[right]
        if a.kind == "variable" or b.kind == "variable" or a.kind != b.kind
            return false
        if a.kind == "integer"
            if a.value != b.value
                return false
        elif a.kind == "atom"
            if a.name != b.name
                return false
        else
            if a.name != b.name or len(a.args) != len(b.args)
                return false
            index := int(len(a.args)) - 1
            while index >= 0
                pending = pending.append([a.args[index], b.args[index]])
                index -= 1
    return true
