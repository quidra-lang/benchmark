class Row(string id, real64[] values, string label, real64 target, bool target_present)

string[] read_lines(string path)
    string text = file.read(path)
    string[] result = []
    for string line = text.split(NL)[]
        if line != ""
            result = result.append(line)
    return result

int[] integers(string[] values)
    int[] result = []
    for string value = values[]
        result = result.append(int.parse(value))
    return result

real64[] reals(string[] values)
    real64[] result = []
    for string value = values[]
        result = result.append(real64.parse(value))
    return result

class Settings(local string[][] fields)
    string[] scalings = fields[0][1:<len(fields[0])]
    int[] ks = integers(fields[1][1:<len(fields[1])])
    string[] metrics = fields[2][1:<len(fields[2])]
    string[] weightings = fields[3][1:<len(fields[3])]
    int folds = int.parse(fields[4][1])
    int edit_k = int.parse(fields[5][1])
    int[] curve = integers(fields[6][1:<len(fields[6])])
    real64[] bins = reals(fields[7][1:<len(fields[7])])
    int top = int.parse(fields[8][1])

Settings read_settings()
    string[][] fields = []
    for string line = read_lines("input/params.txt")[]
        fields = fields.append(line.split(" "))
    return Settings(fields)

class Rows(string[] features, Row[] entries)

Rows read_rows(string name)
    string[] lines = read_lines("input/" + name)
    string[] header = lines[0].split(",")
    Row[] result = []
    for 1 <= int index < int(len(lines))
        string[] fields = lines[index].split(",")
        int count = int(len(fields))
        bool present = fields[count - 1] != ""
        real64 target = if present then real64.parse(fields[count - 1]) else 0.0
        result = result.append(Row(fields[0], reals(fields[1:<count - 2]), fields[count - 2], target, present))
    return Rows(header[1:<len(header) - 2], result)

class Dataset(string[] features, Row[] train, Row[] test, Settings settings)

Dataset read_dataset()
    Rows training = read_rows("train.csv")
    Rows testing = read_rows("test.csv")
    return Dataset(training.features, training.entries, testing.entries, read_settings())

int lookup(map.Map<string, int> values, string key)
    match values.get(key)
        int value
            return value
        none
            return -1

int row_index(Row[] rows, string id)
    for nat index < len(rows)
        if rows[index].id == id
            return int(index)
    return -1

Row[] id_order(Row[] rows)
    string[] ids = []
    for Row row = rows[]
        ids = ids.append(row.id)
    Row[] result = []
    for string id = ids.sorted()[]
        result = result.append(rows[row_index(rows, id)])
    return result
