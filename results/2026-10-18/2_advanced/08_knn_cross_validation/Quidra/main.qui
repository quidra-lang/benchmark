import math
import dataset = "./dataset.qui"
import scale = "./scaling.qui"
import neighbors = "./neighbors.qui"
import validation = "./validation.qui"
import report = "./report.qui"

int[] consecutive(int first, int last)
    int[] result = []
    for first <= int value < last
        result = result.append(value)
    return result

dataset.Row[] take_rows(dataset.Row[] rows, int[] indices)
    dataset.Row[] result = []
    for int index = indices[]
        result = result.append(rows[index])
    return result

string[] labels_of(dataset.Row[] rows)
    string[] values = []
    for dataset.Row row = rows[]
        values = values.append(row.label)
    string[] result = []
    for string value = values.sorted()[]
        if len(result) == 0 or value != result[len(result) - 1]
            result = result.append(value)
    return result

class CrossValidation(validation.Model model, local dataset.Row[] rows, validation.Prediction[] predictions)
    bool[] hits = []
    int correct = 0
    local real64[] errors = []
    for nat index < len(rows)
        bool hit = predictions[index].label == rows[index].label
        hits = hits.append(hit)
        if hit
            correct += 1
        errors = errors.append(predictions[index].estimate - rows[index].target)
    real64 rmse_value = validation.rmse(errors)

class ModelSpace(string method, string metric)

validation.Prediction | error prediction_value(map.Map<string, validation.Prediction> values, string key)
    match values.get(key)
        validation.Prediction found
            return found
        none
            return error("missing prediction {key}")

CrossValidation[] cross_validate(validation.Model[] models, dataset.Row[] rows, int fold_count, int[] features)
    map.Map<string, validation.Prediction>[] predictions = []
    ModelSpace[] spaces = []
    for validation.Model model = models[]
        map.Map<string, validation.Prediction> pending
        predictions = predictions.append(pending)
        bool known = false
        for ModelSpace space = spaces[]
            known = known or (space.method == model.scaling and space.metric == model.metric)
        if not known
            spaces = spaces.append(ModelSpace(model.scaling, model.metric))
    for int[] fold = validation.stratified_folds(rows, fold_count)[]
        dataset.Row[] training = validation.fold_training(rows, fold)
        dataset.Row[] queries = take_rows(rows, fold)
        for ModelSpace space = spaces[]
            neighbors.Neighbor[][] orders = validation.neighbor_orders(training, queries, space.method, space.metric, features)
            for nat number < len(models)
                validation.Model model = models[number]
                if model.scaling == space.method and model.metric == space.metric
                    for nat position < len(fold)
                        validation.Prediction predicted = validation.prediction_from_order(orders[position], model.k, model.weighting)
                        .predictions[number].set(rows[fold[position]].id, predicted)
    CrossValidation[] result = []
    for nat number < len(models)
        validation.Prediction[] ordered = []
        for dataset.Row row = rows[]
            ordered = ordered.append(prediction_value(predictions[number], row.id))
        result = result.append(CrossValidation(models[number], rows, ordered))
    return result

CrossValidation best_classifier(CrossValidation[] results)
    int best = 0
    for 1 <= int index < int(len(results))
        if results[index].correct > results[best].correct
            best = index
    return results[best]

CrossValidation best_regressor(CrossValidation[] results)
    int best = 0
    for 1 <= int index < int(len(results))
        if report.four_decimal(results[index].rmse_value) < report.four_decimal(results[best].rmse_value)
            best = index
    return results[best]

int correct_count(validation.Prediction[] predictions, dataset.Row[] rows)
    int result = 0
    for nat index < len(rows)
        if predictions[index].label == rows[index].label
            result += 1
    return result

real64[] residuals(validation.Prediction[] predictions, dataset.Row[] rows)
    real64[] result = []
    for nat index < len(rows)
        result = result.append(predictions[index].estimate - rows[index].target)
    return result

string label_counts(dataset.Row[] rows, string[] labels)
    string[] result = []
    for string label = labels[]
        int count = 0
        for dataset.Row row = rows[]
            if row.label == label
                count += 1
        result = result.append("{label} {count}")
    return result.join(" ")

string[] evaluation_lines(dataset.Row[] rows, validation.Prediction[] predictions, string[] labels)
    int[][] matrix = []
    for nat index < len(labels)
        matrix = matrix.append(array(len(labels), fill = 0))
    for nat index < len(rows)
        for nat actual < len(labels)
            if rows[index].label == labels[actual]
                for nat predicted < len(labels)
                    if predictions[index].label == labels[predicted]
                        matrix[actual][predicted] += 1
    string[] lines = ["true\predicted " + labels.join(" ")]
    for nat index < len(labels)
        string[] counts = []
        for int count = matrix[index][]
            counts = counts.append(count.string())
        lines = lines.append(labels[index] + " " + counts.join(" "))
    real64[] totals = [0.0, 0.0, 0.0]
    int[] valued = [0, 0, 0]
    for nat index < len(labels)
        int hits = matrix[index][index]
        int predicted = 0
        int actual = 0
        for nat other < len(labels)
            predicted += matrix[other][index]
            actual += matrix[index][other]
        int[] numerators = [hits, hits, 2 * hits]
        int[] denominators = [predicted, actual, predicted + actual]
        for int metric < 3
            if denominators[metric] > 0
                totals[metric] += real64(numerators[metric]) / real64(denominators[metric])
                valued[metric] += 1
        lines = lines.append("class {labels[index]} precision {report.fraction(hits, predicted)} recall {report.fraction(hits, actual)} f1 {report.fraction(2 * hits, predicted + actual)} support {actual}")
    string[] averages = []
    for int metric < 3
        averages = averages.append(if valued[metric] == 0 then "-" else report.fixed(totals[metric] / real64(valued[metric])))
    return lines.append("macro precision {averages[0]} recall {averages[1]} f1 {averages[2]}")

string[] reliability_lines(dataset.Row[] rows, validation.Prediction[] predictions, real64[] bounds)
    real64[] lower = [0.0]
    lower = lower.concat(bounds)
    int[] counts = array(len(lower), fill = 0)
    int[] hits = counts
    real64[] shares = array(len(lower), fill = 0.0)
    for nat index < len(rows)
        int bin = 0
        for real64 bound = bounds[]
            if bound <= predictions[index].share
                bin += 1
        counts[bin] += 1
        if predictions[index].label == rows[index].label
            hits[bin] += 1
        shares[bin] += predictions[index].share
    string[] lines = []
    for nat index < len(lower)
        string line = "bin {report.fixed(lower[index], 2)} rows {counts[index]}"
        if counts[index] > 0
            line += " correct {report.ratio(hits[index], counts[index])} share {report.fixed(shares[index] / real64(counts[index]))}"
        lines = lines.append(line)
    return lines

validation.Model[] build_grid(dataset.Settings settings)
    validation.Model[] result = []
    for int k = settings.ks[]
        for string metric = settings.metrics[]
            for string weighting = settings.weightings[]
                for string method = settings.scalings[]
                    result = result.append(validation.Model(k, metric, weighting, method))
    return result

real64[] real_values(map.Map<string, real64[]> values, string key)
    match values.get(key)
        real64[] found
            return found
        none
            return []

class ClassifierSpace(validation.Model model, dataset.Row[] training, local dataset.Row[] testing)
    local int[] features = consecutive(0, int(len(training[0].values)))
    local scale.Scaling parameters = scale.compute(training, model.scaling)
    local real64[][] vectors = []
    map.Map<string, int> positions
    for nat index < len(training)
        vectors = vectors.append(parameters.transform(training[index].values, features))
        .positions.set(training[index].id, int(index))
    map.Map<string, real64[]> gaps
    for dataset.Row query = training.concat(testing)[]
        real64[] vector = parameters.transform(query.values, features)
        real64[] distances = []
        for real64[] reference = vectors[]
            distances = distances.append(neighbors.distance(vector, reference, model.metric))
        .gaps.set(query.id, distances)

    neighbors.Neighbor[] order(dataset.Row query, dataset.Row[] rows)
        real64[] distances = real_values(gaps, query.id)
        neighbors.Neighbor[] result = []
        for dataset.Row row = rows[]
            result = result.append(neighbors.Neighbor(distances[dataset.lookup(positions, row.id)], row))
        return neighbors.sorted_neighbors(result)

    neighbors.Vote voting(dataset.Row query, dataset.Row[] rows, int k)
        neighbors.Neighbor[] ordered = order(query, rows)
        return neighbors.vote(ordered[0:<math.min(k, int(len(ordered)))], model.weighting)

    string nearest_label(dataset.Row query, dataset.Row[] rows)
        return order(query, rows)[0].row.label

class Removal(dataset.Row row, neighbors.Vote ballot)

class Editing(dataset.Row[] rows, Removal[][] passes)

Editing wilson_editing(ClassifierSpace space, dataset.Row[] rows, int edit_k)
    dataset.Row[] current = rows
    Removal[][] passes = []
    while true
        Removal[] removed = []
        for dataset.Row row = current[]
            dataset.Row[] others = []
            for dataset.Row other = current[]
                if other.id != row.id
                    others = others.append(other)
            neighbors.Vote ballot = space.voting(row, others, edit_k)
            if ballot.label != row.label
                removed = removed.append(Removal(row, ballot))
        passes = passes.append(removed)
        if len(removed) == 0
            return Editing(current, passes)
        dataset.Row[] retained = []
        for dataset.Row row = current[]
            bool found = false
            for Removal removal = removed[]
                found = found or removal.row.id == row.id
            if not found
                retained = retained.append(row)
        current = retained

class Condensing(dataset.Row[] rows, int scans)

Condensing hart_condensing(ClassifierSpace space, dataset.Row[] rows)
    dataset.Row[] stored = [rows[0]]
    int scans = 0
    while true
        scans += 1
        bool added = false
        for dataset.Row row = rows[]
            if dataset.row_index(stored, row.id) < 0 and space.nearest_label(row, stored) != row.label
                stored = stored.append(row)
                added = true
        if not added
            return Condensing(dataset.id_order(stored), scans)

class Experiment(dataset.Dataset data)
    string[] feature_names = data.features
    int[] features = consecutive(0, int(len(feature_names)))
    dataset.Row[] train = data.train
    dataset.Row[] test = data.test
    dataset.Settings settings = data.settings
    string[] labels = labels_of(train)
    dataset.Row[] labelled = []
    dataset.Row[] targeted = []
    for nat index < len(test)
        if test[index].label != ""
            labelled = labelled.append(test[index])
        if test[index].target_present
            targeted = targeted.append(test[index])
    validation.Model[] grid = build_grid(settings)
    int[][] folds = validation.stratified_folds(train, settings.folds)
    CrossValidation[] results = cross_validate(grid, train, settings.folds, features)
    CrossValidation classifier = best_classifier(results)
    CrossValidation regressor = best_regressor(results)
    validation.Prediction[] test_predictions = validation.predict_rows(classifier.model, train, test, features)
    local validation.Prediction[] regression = validation.predict_rows(regressor.model, train, test, features)
    real64[] test_estimates = []
    validation.Prediction[] labelled_predictions = []
    for nat index < len(test)
        test_estimates = test_estimates.append(regression[index].estimate)
        if test[index].label != ""
            labelled_predictions = labelled_predictions.append(test_predictions[index])

    string names(int[] selected)
        string[] result = []
        for int feature = selected[]
            result = result.append(feature_names[feature])
        return result.join(" ")

    string train_ratio(int count)
        return report.ratio(count, int(len(train)))

    string classifier_summary(CrossValidation result)
        return "{result.model.notation()} correct {train_ratio(result.correct)} rmse {report.fixed(result.rmse_value)}"

    string regressor_summary(CrossValidation result)
        return "{result.model.notation()} rmse {report.fixed(result.rmse_value)} correct {train_ratio(result.correct)}"

    string[] grid_table()
        string[] lines = ["k,metric,weighting,scaling,correct,accuracy,rmse"]
        for CrossValidation result = results[]
            validation.Model model = result.model
            lines = lines.append("{model.k},{model.metric},{model.weighting},{model.scaling},{result.correct},{report.fixed(real64(result.correct) / real64(len(train)))},{report.fixed(result.rmse_value)}")
        return lines

    string[] prediction_table()
        string[] lines = ["id,label,vote_share,estimate"]
        for nat index < len(test)
            validation.Prediction predicted = test_predictions[index]
            lines = lines.append("{test[index].id},{predicted.label},{report.fixed(predicted.share)},{report.fixed(test_estimates[index])}")
        return lines

    string[] data_part()
        return ["data train {len(train)} test {len(test)} labelled {len(labelled)} targets {len(targeted)} features {len(features)} classes {len(labels)}", "classes " + label_counts(train, labels)]

    string[] scaling_part(string method)
        scale.Scaling parameters = scale.compute(train, method)
        string[] lines = ["scaling {method}"]
        for nat index < len(feature_names)
            lines = lines.append("{feature_names[index]} center {report.fixed(parameters.centers[index], 6)} scale {report.fixed(parameters.scales[index], 6)}")
        return lines

    string[] folds_part()
        string[] lines = ["folds {settings.folds}"]
        for nat index < len(folds)
            lines = lines.append("fold {index + 1} size {len(folds[index])} {label_counts(take_rows(train, folds[index]), labels)}")
        return lines

    string[] selection_part()
        return ["grid {len(grid)}", "best_classifier " + classifier_summary(classifier), "best_regressor " + regressor_summary(regressor)]

    string[] top_part(bool accuracy)
        int[] order = consecutive(0, int(len(results)))
        for 1 <= int index < int(len(order))
            int chosen = order[index]
            int cursor = index
            while cursor > 0
                CrossValidation previous = results[order[cursor - 1]]
                CrossValidation entry = results[chosen]
                bool earlier = if accuracy then entry.correct > previous.correct else report.four_decimal(entry.rmse_value) < report.four_decimal(previous.rmse_value)
                if not earlier
                    break
                order[cursor] = order[cursor - 1]
                cursor -= 1
            order[cursor] = chosen
        string kind = if accuracy then "accuracy" else "rmse"
        string[] lines = ["top {settings.top} by {kind}"]
        for int rank < math.min(settings.top, int(len(order)))
            CrossValidation result = results[order[rank]]
            string details = if accuracy then classifier_summary(result) else regressor_summary(result)
            lines = lines.append("{rank + 1} {details}")
        return lines

    string[][] best_per_item_parts()
        string[][] parts = []
        string[] items = ["k", "metric", "weighting", "scaling"]
        string[] k_values = []
        for int value = settings.ks[]
            k_values = k_values.append(value.string())
        string[][] values = [k_values, settings.metrics, settings.weightings, settings.scalings]
        for int position < 4
            string item = items[position]
            string[] lines = ["best per {item}"]
            for string value = values[position][]
                CrossValidation[] chosen = []
                for CrossValidation result = results[]
                    validation.Model model = result.model
                    string entry = if position == 0 then model.k.string() elif position == 1 then model.metric elif position == 2 then model.weighting else model.scaling
                    if entry == value
                        chosen = chosen.append(result)
                CrossValidation first = best_classifier(chosen)
                CrossValidation second = best_regressor(chosen)
                lines = lines.append("{item}={value} classifier {first.model.notation()} accuracy {report.fixed(real64(first.correct) / real64(len(train)))} regressor {second.model.notation()} rmse {report.fixed(second.rmse_value)}")
            parts = parts.append(lines)
        return parts

    string[] classifier_folds_part()
        string[] lines = ["classifier folds"]
        for nat index < len(folds)
            int count = 0
            for int row = folds[index][]
                if classifier.hits[row]
                    count += 1
            lines = lines.append("fold {index + 1} correct {report.ratio(count, int(len(folds[index])))}")
        return lines

    string[] regressor_folds_part()
        string[] lines = ["regressor folds"]
        for nat index < len(folds)
            real64[] errors = []
            for int row = folds[index][]
                errors = errors.append(regressor.predictions[row].estimate - train[row].target)
            lines = lines.append("fold {index + 1} size {len(folds[index])} rmse {report.fixed(validation.rmse(errors))}")
        return lines

    string[] mcnemar_part()
        string[] lines = ["mcnemar"]
        for string metric = settings.metrics[]
            CrossValidation[] selected = []
            for CrossValidation result = results[]
                if result.model.metric == metric
                    selected = selected.append(result)
            CrossValidation comparison = best_classifier(selected)
            int only_selected = 0
            int only_comparison = 0
            for nat index < len(train)
                if classifier.hits[index] and not comparison.hits[index]
                    only_selected += 1
                elif comparison.hits[index] and not classifier.hits[index]
                    only_comparison += 1
            int difference = math.max(0, math.abs(only_selected - only_comparison) - 1)
            int numerator = difference * difference
            int denominator = only_selected + only_comparison
            string statistic = if denominator == 0 then "0/1 0.0000" else report.fraction(numerator, denominator)
            string significant = if 1000 * numerator > 3841 * denominator then "yes" else "no"
            lines = lines.append("{comparison.model.notation()} b {only_selected} c {only_comparison} statistic {statistic} significant {significant}")
        return lines

    string[][] leave_one_out_parts()
        validation.Model model = classifier.model
        validation.Prediction[][] by_k = []
        for nat index < len(settings.ks)
            by_k = by_k.append([])
        real64[] estimates = []
        for nat index < len(train)
            dataset.Row row = train[index]
            dataset.Row[] others = validation.fold_training(train, [int(index)])
            neighbors.Neighbor[][] orders = validation.neighbor_orders(others, [row], model.scaling, model.metric, features)
            for nat choice < len(settings.ks)
                by_k[choice] = by_k[choice].append(validation.prediction_from_order(orders[0], settings.ks[choice], model.weighting))
            validation.Prediction[] predicted = validation.predict_rows(regressor.model, others, [row], features)
            estimates = estimates.append(predicted[0].estimate)
        int model_index = 0
        for nat index < len(settings.ks)
            if settings.ks[index] == model.k
                model_index = int(index)
        validation.Prediction[] predictions = by_k[model_index]
        dataset.Row[] errors = []
        for nat index < len(train)
            if predictions[index].label != train[index].label
                errors = errors.append(train[index])
        string[] class_errors = []
        for string label = labels[]
            int count = 0
            for dataset.Row row = errors[]
                if row.label == label
                    count += 1
            class_errors = class_errors.append("{label} {count}")
        string counts = class_errors.join(" ")
        string[] first = ["leave_one_out classifier {model.notation()}", "errors {train_ratio(int(len(errors)))}", "class_errors {counts}"]
        for dataset.Row row = dataset.id_order(errors)[]
            validation.Prediction predicted = predictions[dataset.row_index(train, row.id)]
            first = first.append("{row.id} true {row.label} predicted {predicted.label} share {report.fixed(predicted.share)}")
        real64[] differences = []
        for nat index < len(train)
            differences = differences.append(estimates[index] - train[index].target)
        string[] second = ["leave_one_out regressor {regressor.model.notation()}", "rmse {report.fixed(validation.rmse(differences))} mae {report.fixed(validation.mae(differences))}", "largest {settings.top} residuals"]
        int[] order = consecutive(0, int(len(train)))
        for 1 <= int index < int(len(order))
            int chosen = order[index]
            int cursor = index
            while cursor > 0
                int previous = order[cursor - 1]
                real64 left = report.four_decimal(math.abs(differences[chosen]))
                real64 right = report.four_decimal(math.abs(differences[previous]))
                if left < right or (left == right and train[chosen].id >= train[previous].id)
                    break
                order[cursor] = previous
                cursor -= 1
            order[cursor] = chosen
        for int rank < math.min(settings.top, int(len(order)))
            int index = order[rank]
            second = second.append("{train[index].id} target {report.fixed(train[index].target)} estimate {report.fixed(estimates[index])} residual {report.fixed(differences[index])}")
        string[] third = ["leave_one_out by k metric={model.metric} weighting={model.weighting} scaling={model.scaling}"]
        for nat index < len(settings.ks)
            validation.Prediction[] predicted = by_k[index]
            third = third.append("k={settings.ks[index]} correct {train_ratio(correct_count(predicted, train))} rmse {report.fixed(validation.rmse(residuals(predicted, train)))}")
        return [first, second, third]

    string[] nested_part()
        string[] lines = ["nested_cross_validation folds {settings.folds}"]
        real64[] estimates = array(len(train), fill = 0.0)
        int total_correct = 0
        for nat number < len(folds)
            int[] fold = folds[number]
            dataset.Row[] training = validation.fold_training(train, fold)
            dataset.Row[] queries = take_rows(train, fold)
            CrossValidation[] inner_results = cross_validate(grid, training, settings.folds, features)
            CrossValidation first = best_classifier(inner_results)
            CrossValidation second = best_regressor(inner_results)
            validation.Prediction[] predicted_labels = validation.predict_rows(first.model, training, queries, features)
            int correct = correct_count(predicted_labels, queries)
            total_correct += correct
            validation.Prediction[] predicted_values = validation.predict_rows(second.model, training, queries, features)
            for nat index < len(fold)
                estimates[fold[index]] = predicted_values[index].estimate
            lines = lines.append("fold {number + 1} classifier {first.model.notation()} inner {report.fixed(real64(first.correct) / real64(len(training)))} outer {report.ratio(correct, int(len(fold)))}")
            lines = lines.append("fold {number + 1} regressor {second.model.notation()} inner {report.fixed(second.rmse_value)} outer {report.fixed(validation.rmse(residuals(predicted_values, queries)))}")
        real64[] errors = []
        for nat index < len(train)
            errors = errors.append(estimates[index] - train[index].target)
        return lines.append("nested accuracy {train_ratio(total_correct)} rmse {report.fixed(validation.rmse(errors))}")

    string[] feature_selection_part()
        validation.Model model = classifier.model
        int[] current = features
        int[] selected = current
        int selected_correct = classifier.correct
        string[] lines = ["feature_selection {model.notation()}", "start features {names(current)} correct {train_ratio(classifier.correct)}"]
        int step = 0
        while len(current) >= 3
            step += 1
            int[] candidate_counts = []
            int chosen = 0
            for nat index < len(current)
                int[] remaining = []
                for int feature = current[]
                    if feature != current[index]
                        remaining = remaining.append(feature)
                CrossValidation[] candidate = cross_validate([model], train, settings.folds, remaining)
                candidate_counts = candidate_counts.append(candidate[0].correct)
                if candidate[0].correct > candidate_counts[chosen]
                    chosen = int(index)
            string[] details = []
            for nat index < len(current)
                details = details.append("{feature_names[current[index]]} {candidate_counts[index]}")
            int removed = current[chosen]
            int correct = candidate_counts[chosen]
            current = current[0:<chosen].concat(current[chosen + 1:<len(current)])
            string listing = details.join(" ")
            lines = lines.append("step {step} remove {feature_names[removed]} correct {train_ratio(correct)} candidates {listing}")
            if correct >= selected_correct
                selected = current
                selected_correct = correct
        validation.Prediction[] predicted = validation.predict_rows(model, train, labelled, selected)
        lines = lines.append("selected features {names(selected)} correct {train_ratio(selected_correct)}")
        return lines.append("selected test {report.ratio(correct_count(predicted, labelled), int(len(labelled)))}")

    string[] test_classification_part()
        int correct = correct_count(labelled_predictions, labelled)
        string[] lines = ["test classification {classifier.model.notation()}", "labelled {len(labelled)} correct {report.ratio(correct, int(len(labelled)))}"]
        return lines.concat(evaluation_lines(labelled, labelled_predictions, labels))

    string[] uncertain_part()
        real64[] margins = []
        for validation.Prediction predicted = test_predictions[]
            margins = margins.append(predicted.share - predicted.runner_share)
        int[] order = consecutive(0, int(len(test)))
        for 1 <= int index < int(len(order))
            int chosen = order[index]
            int cursor = index
            while cursor > 0 and report.four_decimal(margins[chosen]) < report.four_decimal(margins[order[cursor - 1]])
                order[cursor] = order[cursor - 1]
                cursor -= 1
            order[cursor] = chosen
        string[] lines = ["uncertain {settings.top} test rows"]
        for int rank < math.min(settings.top, int(len(order)))
            int index = order[rank]
            dataset.Row row = test[index]
            validation.Prediction predicted = test_predictions[index]
            string runner = if predicted.runner == "" then "-" else predicted.runner
            string truth = if row.label == "" then "-" else row.label
            lines = lines.append("{row.id} predicted {predicted.label} share {report.fixed(predicted.share)} runner_up {runner} share {report.fixed(predicted.runner_share)} margin {report.fixed(margins[index])} true {truth}")
        return lines

    string[] test_regression_part()
        real64[] errors = []
        real64[] targets = []
        for nat index < len(test)
            if test[index].target_present
                errors = errors.append(test_estimates[index] - test[index].target)
                targets = targets.append(test[index].target)
        string[] lines = ["test regression {regressor.model.notation()}", "targets {len(errors)} rmse {report.fixed(validation.rmse(errors))} mae {report.fixed(validation.mae(errors))} r2 {report.fixed(validation.r_squared(errors, targets))}"]
        for string label = labels[]
            real64[] selected = []
            for nat index < len(test)
                if test[index].target_present and test[index].label == label
                    selected = selected.append(test_estimates[index] - test[index].target)
            string value = if len(selected) == 0 then "-" else report.fixed(validation.rmse(selected))
            lines = lines.append("class {label} targets {len(selected)} rmse {value}")
        return lines

    string[] misclassified_part()
        string[] lines = ["misclassified test rows"]
        int count = 0
        for nat index < len(labelled)
            dataset.Row row = labelled[index]
            validation.Prediction predicted = labelled_predictions[index]
            if predicted.label != row.label
                count += 1
                lines = lines.append("{row.id} true {row.label} predicted {predicted.label} share {report.fixed(predicted.share)}")
                for neighbors.Neighbor neighbor = predicted.nearest[]
                    lines = lines.append("  {neighbor.row.id} {neighbor.row.label} {report.fixed(neighbor.gap)}")
        return lines.append("count {count}")

    string[] metrics_report()
        string[][] parts = [data_part()]
        for string method = settings.scalings[]
            parts = parts.append(scaling_part(method))
        parts = parts.concat([folds_part(), selection_part(), top_part(true), top_part(false)])
        parts = parts.concat(best_per_item_parts())
        parts = parts.append(classifier_folds_part())
        parts = parts.append(regressor_folds_part())
        parts = parts.append(["cross_validation classes"].concat(evaluation_lines(train, classifier.predictions, labels)))
        parts = parts.append(["cross_validation reliability"].concat(reliability_lines(train, classifier.predictions, settings.bins)))
        parts = parts.append(mcnemar_part())
        parts = parts.concat(leave_one_out_parts())
        parts = parts.concat([nested_part(), feature_selection_part(), test_classification_part()])
        parts = parts.append(["test reliability"].concat(reliability_lines(labelled, labelled_predictions, settings.bins)))
        parts = parts.concat([uncertain_part(), test_regression_part(), misclassified_part()])
        return report.join_parts(parts)

    string[] learning_curve_table()
        string[] lines = ["n,train_size,correct,accuracy,rmse"]
        for int limit = settings.curve[]
            int[] taken = array(len(labels), fill = 0)
            dataset.Row[] rows = []
            for dataset.Row row = train[]
                for nat index < len(labels)
                    if row.label == labels[index] and taken[index] < limit
                        taken[index] += 1
                        rows = rows.append(row)
            validation.Prediction[] predicted_labels = validation.predict_rows(classifier.model, rows, labelled, features)
            int correct = correct_count(predicted_labels, labelled)
            validation.Prediction[] predicted_values = validation.predict_rows(regressor.model, rows, targeted, features)
            lines = lines.append("{limit},{len(rows)},{correct},{report.fixed(real64(correct) / real64(len(labelled)))},{report.fixed(validation.rmse(residuals(predicted_values, targeted)))}")
        return lines

    string[] prototype_line(ClassifierSpace space, string name, dataset.Row[] rows)
        int knn_correct = 0
        int nearest_correct = 0
        for dataset.Row row = labelled[]
            if space.voting(row, rows, classifier.model.k).label == row.label
                knn_correct += 1
            if space.nearest_label(row, rows) == row.label
                nearest_correct += 1
        return ["set {name} size {len(rows)} {label_counts(rows, labels)} knn {report.ratio(knn_correct, int(len(labelled)))} 1nn {report.ratio(nearest_correct, int(len(labelled)))}"]

    string[] id_lines(dataset.Row[] rows)
        string[] lines = []
        for int start < int(len(rows)) step 10
            string[] ids = []
            for start <= int index < math.min(start + 10, int(len(rows)))
                ids = ids.append(rows[index].id)
            lines = lines.append(ids.join(" "))
        return lines

    string[] borders_part(ClassifierSpace space, dataset.Row[] ordered)
        string[] lines = ["borders"]
        int total = 0
        for string label = labels[]
            int count = 0
            int members = 0
            real64 same_total = 0.0
            real64 other_total = 0.0
            for dataset.Row row = ordered[]
                if row.label != label
                    continue
                members += 1
                dataset.Row[] others = []
                for dataset.Row other = ordered[]
                    if other.id != row.id
                        others = others.append(other)
                neighbors.Neighbor[] order = space.order(row, others)
                if order[0].row.label != label
                    count += 1
                bool same_found = false
                bool other_found = false
                for neighbors.Neighbor neighbor = order[]
                    if neighbor.row.label == label and not same_found
                        same_total += neighbor.gap
                        same_found = true
                    if neighbor.row.label != label and not other_found
                        other_total += neighbor.gap
                        other_found = true
            total += count
            lines = lines.append("class {label} size {members} border {count} same {report.fixed(same_total / real64(members))} other {report.fixed(other_total / real64(members))}")
        return lines.append("border total {train_ratio(total)}")

    string[] hubs_part()
        int[] occurrences = array(len(train), fill = 0)
        for validation.Prediction predicted = test_predictions[]
            for neighbors.Neighbor neighbor = predicted.nearest[]
                occurrences[dataset.row_index(train, neighbor.row.id)] += 1
        dataset.Row[] ordered = dataset.id_order(train)
        int[] order = []
        int anti_hubs = 0
        for dataset.Row row = ordered[]
            int index = dataset.row_index(train, row.id)
            order = order.append(index)
            if occurrences[index] == 0
                anti_hubs += 1
        for 1 <= int position < int(len(order))
            int chosen = order[position]
            int cursor = position
            while cursor > 0 and occurrences[chosen] > occurrences[order[cursor - 1]]
                order[cursor] = order[cursor - 1]
                cursor -= 1
            order[cursor] = chosen
        string[] lines = ["hubs k={classifier.model.k} queries {len(test)}"]
        for int rank < math.min(settings.top, int(len(order)))
            int index = order[rank]
            lines = lines.append("{train[index].id} {train[index].label} {occurrences[index]}")
        return lines.append("anti_hubs {anti_hubs}")

    string[] prototypes_report()
        ClassifierSpace space = ClassifierSpace(classifier.model, train, test)
        dataset.Row[] ordered = dataset.id_order(train)
        Editing editing = wilson_editing(space, ordered, settings.edit_k)
        Condensing original = hart_condensing(space, ordered)
        Condensing edited = hart_condensing(space, editing.rows)
        string[] editing_lines = ["editing k={settings.edit_k}"]
        for nat index < len(editing.passes)
            Removal[] removed = editing.passes[index]
            editing_lines = editing_lines.append("pass {index + 1} removed {len(removed)}")
            for Removal removal = removed[]
                editing_lines = editing_lines.append("  {removal.row.id} true {removal.row.label} predicted {removal.ballot.label} share {report.fixed(removal.ballot.share)}")
        editing_lines = editing_lines.append("edited size {len(editing.rows)} removed {int(len(train)) - int(len(editing.rows))}")
        string[] condensing = ["condensing original scans {original.scans} size {len(original.rows)}", "condensing edited scans {edited.scans} size {len(edited.rows)}"]
        string[] sets = prototype_line(space, "original", ordered).concat(prototype_line(space, "edited", editing.rows)).concat(prototype_line(space, "condensed", original.rows)).concat(prototype_line(space, "edited_condensed", edited.rows))
        string[][] parts = [["space {classifier.model.notation()}"], editing_lines, condensing, sets, ["prototypes condensed"].concat(id_lines(original.rows)), ["prototypes edited_condensed"].concat(id_lines(edited.rows)), borders_part(space, ordered), hubs_part()]
        return report.join_parts(parts)

    void write_reports()
        report.write_lines("cv_grid.csv", grid_table())
        report.write_lines("predictions.csv", prediction_table())
        report.write_lines("metrics.txt", metrics_report())
        report.write_lines("learning_curve.csv", learning_curve_table())
        report.write_lines("prototypes.txt", prototypes_report())

if main
    dataset.Dataset data = dataset.read_dataset()
    Experiment experiment = Experiment(data)
    experiment.write_reports()
