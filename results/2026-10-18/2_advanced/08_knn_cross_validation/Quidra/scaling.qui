import math
import dataset = "./dataset.qui"

class Scaling(real64[] centers, real64[] scales)
    real64[] transform(real64[] values, int[] features)
        real64[] result = []
        for int feature = features[]
            real64 value = if scales[feature] > 0.0 then (values[feature] - centers[feature]) / scales[feature] else 0.0
            result = result.append(value)
        return result

Scaling compute(dataset.Row[] rows, string method)
    real64[] centers = []
    real64[] scales = []
    for nat feature < len(rows[0].values)
        real64 low = rows[0].values[feature]
        real64 high = low
        real64 total = 0.0
        for dataset.Row row = rows[]
            real64 value = row.values[feature]
            low = math.min(low, value)
            high = math.max(high, value)
            total += value
        if method == "minmax"
            centers = centers.append(low)
            scales = scales.append(high - low)
        else
            real64 center = total / real64(len(rows))
            real64 squares = 0.0
            for dataset.Row row = rows[]
                real64 difference = row.values[feature] - center
                squares += difference * difference
            centers = centers.append(center)
            scales = scales.append(if len(rows) == 1 then 0.0 else math.sqrt(squares / real64(int(len(rows)) - 1)))
    return Scaling(centers, scales)
