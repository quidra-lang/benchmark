#program spin
// a loop that never reaches its exit condition
void main() {
    int i = 0;
    int laps = 0;
    while (i != 10) {
        i = i + 3;
        laps = laps + 1;
        if (laps % 5000 == 0) {
            print(laps, i);
        }
    }
    print(laps);
}
