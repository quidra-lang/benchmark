#program arith
// integer arithmetic, precedence and short-circuit evaluation
int calls;

bool check(int v) {
    calls = calls + 1;
    print(v);
    return v > 0;
}

void main() {
    int a = 17;
    int b = -5;
    print(a / b, a % b, -a / b, -a % b);
    print(a / 5, a % 5, -a / 5, -a % 5);
    print(2 + 3 * 4 - 6 / 2, (2 + 3) * (4 - 6) / 2, 100 / 7 % 4);
    print(60 * 60 * 24, -(3 - 10), 7 - -2, 2147483647 + 0);
    int x = a * 1 + 0;
    bool p = check(1) || check(2);
    bool q = check(-1) && check(3);
    if (p && !q) {
        print(calls, x);
    }
    if (!(a < b) && a != 0) {
        print(1);
    } else {
        print(0);
    }
    if (true || calls > 100) {
        print(calls * 10);
    }
}
#program primes
// sieve of Eratosthenes, twin primes and the largest prime gap
int composite[1000];

void sieve(int n) {
    for (int i = 2; i * i <= n; i = i + 1) {
        if (composite[i] == 1) {
            continue;
        }
        for (int j = i * i; j <= n; j = j + i) {
            composite[j] = 1;
        }
    }
}

bool is_prime(int k) {
    return k >= 2 && composite[k] == 0;
}

void main() {
    int n = read();
    sieve(n);
    int count = 0;
    int sum = 0;
    int twins = 0;
    int prev = 0;
    int best_gap = 0;
    int best_start = 0;
    for (int k = 2; k <= n; k = k + 1) {
        if (!is_prime(k)) {
            continue;
        }
        count = count + 1;
        sum = sum + k;
        if (prev > 0) {
            if (k - prev == 2) {
                twins = twins + 1;
            }
            if (k - prev > best_gap) {
                best_gap = k - prev;
                best_start = prev;
            }
        }
        prev = k;
    }
    print(count, sum, twins);
    print(best_gap, best_start, prev);
}
#program sort
// quicksort followed by binary search queries
int data[64];
int size;

void swap(int i, int j) {
    int t = data[i];
    data[i] = data[j];
    data[j] = t;
}

int partition(int lo, int hi) {
    int pivot = data[hi];
    int store = lo;
    for (int i = lo; i < hi; i = i + 1) {
        if (data[i] < pivot) {
            swap(i, store);
            store = store + 1;
        }
    }
    swap(store, hi);
    return store;
}

void quicksort(int lo, int hi) {
    if (lo >= hi) {
        return;
    }
    int p = partition(lo, hi);
    quicksort(lo, p - 1);
    quicksort(p + 1, hi);
}

int search(int key) {
    int lo = 0;
    int hi = size - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (data[mid] == key) {
            return mid;
        }
        if (data[mid] < key) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

void main() {
    size = read();
    for (int i = 0; i < size; i = i + 1) {
        data[i] = read();
    }
    quicksort(0, size - 1);
    for (int i = 0; i + 4 < size; i = i + 5) {
        print(data[i], data[i + 1], data[i + 2], data[i + 3], data[i + 4]);
    }
    int queries = read();
    int found;
    while (queries > 0) {
        int key = read();
        print(key, search(key));
        queries = queries - 1;
    }
}
#program recursion
// fibonacci, gcd, ackermann, modular power, mutual recursion and hanoi
int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

int gcd(int a, int b) {
    if (b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

int ackermann(int m, int n) {
    if (m == 0) {
        return n + 1;
    }
    if (n == 0) {
        return ackermann(m - 1, 1);
    }
    return ackermann(m - 1, ackermann(m, n - 1));
}

int power(int base, int exp, int mod) {
    if (exp == 0) {
        return 1 % mod;
    }
    int half = power(base, exp / 2, mod);
    int square = half * half % mod;
    if (exp % 2 == 1) {
        return square * base % mod;
    }
    return square;
}

bool is_even(int n) {
    if (n == 0) {
        return true;
    }
    return is_odd(n - 1);
}

bool is_odd(int n) {
    if (n == 0) {
        return false;
    }
    return is_even(n - 1);
}

int hanoi(int n, int from, int to, int via) {
    if (n == 0) {
        return 0;
        print(from, to);
    }
    return hanoi(n - 1, from, via, to) + 1 + hanoi(n - 1, via, to, from);
}

void main() {
    print(fib(12), gcd(1071, 462), gcd(270, 192));
    print(ackermann(2, 3), power(7, 13, 1000), power(3, 200, 10007));
    int evens = 0;
    for (int k = 0; k < 10; k = k + 1) {
        if (is_even(k * 3)) {
            evens = evens + 1;
        }
    }
    print(evens, hanoi(6, 1, 3, 2));
}
#program collatz
// collatz sequences for the numbers read before the terminating zero
int longest;
int longest_start;

int steps(int n) {
    int count = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    return count;
}

int peak(int n) {
    int best = n;
    while (n > 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        if (n > best) {
            best = n;
        }
    }
    return best;
}

void main() {
    int total = 0;
    while (true) {
        int n = read();
        if (n == 0) {
            break;
        }
        int s = steps(n);
        if (s > longest) {
            longest = s;
            longest_start = n;
        }
        total = total + s;
        print(n, s, peak(n));
    }
    if (false) {
        print(-1, total);
    }
    print(longest_start, longest, total);
}
#program matrix
// 4x4 integer matrices: product, trace and Bareiss determinant
int a[16];
int b[16];
int c[16];
int work[16];

void load(int which) {
    for (int i = 0; i < 16; i = i + 1) {
        int v = read();
        if (which == 0) {
            a[i] = v;
        } else {
            b[i] = v;
        }
    }
}

void multiply() {
    for (int i = 0; i < 4; i = i + 1) {
        for (int j = 0; j < 4; j = j + 1) {
            int sum = 0;
            for (int k = 0; k < 4; k = k + 1) {
                sum = sum + a[i * 4 + k] * b[k * 4 + j];
            }
            c[i * 4 + j] = sum;
        }
    }
}

int determinant() {
    for (int i = 0; i < 16; i = i + 1) {
        work[i] = c[i];
    }
    int sign = 1;
    int prev = 1;
    for (int k = 0; k < 3; k = k + 1) {
        if (work[k * 4 + k] == 0) {
            int pivot = -1;
            for (int r = k + 1; r < 4; r = r + 1) {
                if (work[r * 4 + k] != 0 && pivot < 0) {
                    pivot = r;
                }
            }
            if (pivot < 0) {
                return 0;
            }
            for (int j = 0; j < 4; j = j + 1) {
                int t = work[k * 4 + j];
                work[k * 4 + j] = work[pivot * 4 + j];
                work[pivot * 4 + j] = t;
            }
            sign = -sign;
        }
        for (int i = k + 1; i < 4; i = i + 1) {
            for (int j = k + 1; j < 4; j = j + 1) {
                int cross = work[i * 4 + j] * work[k * 4 + k] - work[i * 4 + k] * work[k * 4 + j];
                work[i * 4 + j] = cross / prev;
            }
        }
        prev = work[k * 4 + k];
    }
    return sign * work[15];
}

void dump(int which) {
    for (int i = 0; i < 16; i = i + 4) {
        print(which, work[i], work[i + 1], work[i + 2], work[i + 3]);
    }
}

void main() {
    load(0);
    load(1);
    multiply();
    for (int i = 0; i < 4; i = i + 1) {
        print(c[i * 4], c[i * 4 + 1], c[i * 4 + 2], c[i * 4 + 3]);
    }
    int trace = 0;
    for (int i = 0; i < 4; i = i + 1) {
        trace = trace + c[i * 5];
    }
    print(trace, determinant());
}
#program bank
// single-server queue simulation with a ring buffer
int queue[8];
int capacity = 2 * 4;
int head;
int tail;
int length;
int max_length;
int arrival[40];
int service[40];

void push(int v) {
    queue[tail] = v;
    tail = (tail + 1) % capacity;
    length = length + 1;
    if (length > max_length) {
        max_length = length;
    }
}

int pop() {
    int v = queue[head];
    head = (head + 1) % capacity;
    length = length - 1;
    return v;
}

void finish(int id, int start, int end, int clock) {
    print(id, arrival[id], start, end);
}

void main() {
    int n = read();
    for (int i = 0; i < n; i = i + 1) {
        arrival[i] = read();
        service[i] = read();
    }
    int next = 0;
    int current = -1;
    int start = 0;
    int remaining = 0;
    int total_wait = 0;
    int longest_wait = 0;
    int served = 0;
    int idle = 0;
    int t = 0;
    while (served < n) {
        while (next < n && arrival[next] == t) {
            push(next);
            next = next + 1;
        }
        if (remaining == 0 && length > 0) {
            current = pop();
            start = t;
            int wait = t - arrival[current];
            total_wait = total_wait + wait;
            if (wait > longest_wait) {
                longest_wait = wait;
            }
            remaining = service[current];
        }
        if (remaining > 0) {
            remaining = remaining - 1;
            if (remaining == 0) {
                served = served + 1;
                finish(current, start, t + 1, t);
            }
        } else {
            idle = idle + 1;
        }
        t = t + 1;
    }
    print(t, served, idle, max_length);
    print(total_wait, total_wait / n, longest_wait);
}
#program digits
// digit reversal, digit sums, octal form and binary weight
bool show_octal = 3 > 2;

int reverse(int n) {
    int r = 0;
    while (n > 0) {
        r = r * 10 + n % 10;
        n = n / 10;
    }
    return r;
}

int digit_sum(int n) {
    int s = 0;
    while (n > 0) {
        s = s + n % 10;
        n = n / 10;
    }
    return s;
}

int octal(int n) {
    int result = 0;
    int place = 1;
    while (n > 0) {
        result = result + n % 8 * place;
        place = place * 10;
        n = n / 8;
    }
    return result;
}

int weight(int n) {
    int w = 0;
    while (n != 0) {
        w = w + n % 2;
        n = n / 2;
    }
    return w;
}

void main() {
    int count = read();
    int palindromes = 0;
    for (int i = 0; i < count; i = i + 1) {
        int n = read();
        int r = reverse(n);
        if (r == n) {
            palindromes = palindromes + 1;
        }
        if (show_octal) {
            print(n, r, digit_sum(n), octal(n), weight(n));
        } else {
            print(n, r, digit_sum(n), weight(n));
        }
    }
    print(palindromes);
}
#program averages
// averages of groups; an empty group divides by zero
int values[50];

int average(int from, int count) {
    int sum = 0;
    for (int i = 0; i < count; i = i + 1) {
        sum = sum + values[from + i];
    }
    return sum / count;
}

void report(int group, int from, int count) {
    print(group, count, average(from, count));
}

void main() {
    int groups = read();
    int from = 0;
    for (int g = 1; g <= groups; g = g + 1) {
        int count = read();
        for (int i = 0; i < count; i = i + 1) {
            values[from + i] = read();
        }
        report(g, from, count);
        from = from + count;
    }
}
#program histogram
// histogram of scores in buckets of ten; a score of 100 is out of range
int buckets[10];

void main() {
    int n = read();
    for (int i = 1; i <= n; i = i + 1) {
        int score = read();
        if (score >= 90) {
            print(i, score);
        }
        buckets[score / 10] = buckets[score / 10] + 1;
    }
    for (int b = 0; b < 10; b = b + 1) {
        print(b * 10, buckets[b]);
    }
}
#program factorial
// factorials until the 32-bit range overflows
int factorial(int n) {
    int result = 1;
    for (int i = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

void main() {
    for (int n = 1; n <= 15; n = n + 1) {
        print(n, factorial(n));
    }
}
#program deep
// recursion that is too deep for the call stack
int sum_to(int n) {
    if (n == 0) {
        return 0;
    }
    return n + sum_to(n - 1);
}

void main() {
    print(sum_to(50));
    print(sum_to(150));
}
