import lexer = "./lexer.qui"
import codegen = "./codegen.qui"

class Frame(int[] locals, int return_address)
class Result(string[] output, int[] counts, int[] calls, int[][] edges, int executed, int max_stack, int max_depth, int | none error_pc, string | none message, int[] callers)

int pop(int[] &stack)
    int value = stack[int(len(stack)) - 1]
    stack = stack[0:<int(len(stack)) - 1]
    return value

Result run(const codegen.Flat code, int area, const int[] input)
    int[] globals = array(nat(area), fill = 0)
    int[] stack = []
    Frame[] frames = []
    int[] counts = array(len(code.instructions), fill = 0)
    int[] calls = array(len(code.starts), fill = 0)
    int[][] edges = array(len(code.starts), fill = array(len(code.starts), fill = 0))
    string[] output = []
    int pc = 0
    int read_position = 0
    int executed = 0
    int max_stack = 0
    int max_depth = 0
    string | none message = none
    int | none error_pc = none
    while true
        if executed == 100000
            message = "instruction limit exceeded"
            error_pc = pc
            break
        codegen.Instruction instruction = code.instructions[pc]
        string op = instruction.op
        int[] operands = instruction.operands
        counts[pc] += 1
        executed += 1
        int next = pc + 1
        int frame_index = int(len(frames)) - 1
        if op == "PUSH"
            stack = stack.append(operands[0])
        elif op == "POP"
            int ignored = pop(&stack)
        elif op == "LOADG"
            stack = stack.append(globals[operands[0]])
        elif op == "STOREG"
            globals[operands[0]] = pop(&stack)
        elif op == "LOADL"
            stack = stack.append(frames[frame_index].locals[operands[0]])
        elif op == "STOREL"
            frames[frame_index].locals[operands[0]] = pop(&stack)
        elif op == "LOADA" or op == "STOREA"
            int value = if op == "STOREA" then pop(&stack) else 0
            int index = pop(&stack)
            if index < 0 or index >= operands[1]
                message = "index {index} out of bounds for array of size {operands[1]}"
            elif op == "LOADA"
                stack = stack.append(globals[operands[0] + index])
            else
                globals[operands[0] + index] = value
        elif lexer.has(["ADD", "SUB", "MUL", "DIV", "MOD"], op)
            int second = pop(&stack)
            int first = pop(&stack)
            if (op == "DIV" or op == "MOD") and second == 0
                message = "division by zero"
            else
                int value = if op == "ADD" then first + second elif op == "SUB" then first - second elif op == "MUL" then first * second elif op == "DIV" then first / second else first - second * (first / second)
                if value < -2147483648 or value > 2147483647
                    message = "integer overflow"
                else
                    stack = stack.append(value)
        elif op == "NEG"
            int value = -pop(&stack)
            if value < -2147483648 or value > 2147483647
                message = "integer overflow"
            else
                stack = stack.append(value)
        elif op == "NOT"
            int value = pop(&stack)
            stack = stack.append(if value == 0 then 1 else 0)
        elif lexer.has(["LT", "LE", "GT", "GE", "EQ", "NE"], op)
            int second = pop(&stack)
            int first = pop(&stack)
            bool value = if op == "LT" then first < second elif op == "LE" then first <= second elif op == "GT" then first > second elif op == "GE" then first >= second elif op == "EQ" then first == second else first != second
            stack = stack.append(if value then 1 else 0)
        elif op == "JUMP"
            next = operands[0]
        elif op == "JUMPF" or op == "JUMPT"
            int value = pop(&stack)
            if (op == "JUMPF" and value == 0) or (op == "JUMPT" and value != 0)
                next = operands[0]
        elif op == "CALL"
            if len(frames) == 100
                message = "call depth limit exceeded"
            else
                int count = operands[1]
                int start = int(len(stack)) - count
                int[] arguments = stack[start:<int(len(stack))]
                stack = stack[0:<start]
                frames = frames.append(Frame(arguments, pc + 1))
                next = operands[0]
                int unit = 0
                while code.starts[unit] != next
                    unit += 1
                calls[unit] += 1
                edges[code.owners[pc]][unit] += 1
        elif op == "ENTER"
            while int(len(frames[frame_index].locals)) < operands[0]
                frames[frame_index].locals = frames[frame_index].locals.append(0)
        elif op == "RET" or op == "RETV"
            next = frames[frame_index].return_address
            frames = frames[0:<frame_index]
        elif op == "READ"
            if read_position == int(len(input))
                message = "read past end of input"
            else
                stack = stack.append(input[read_position])
                read_position += 1
        elif op == "PRINT"
            int count = operands[0]
            int start = int(len(stack)) - count
            string[] values = []
            for start <= int index < int(len(stack))
                values = values.append(stack[index].string())
            stack = stack[0:<start]
            output = output.append(values.join(" "))
        elif op == "HALT"
            max_stack = lexer.maximum(max_stack, int(len(stack)))
            max_depth = lexer.maximum(max_depth, int(len(frames)))
            break
        bool failed = false
        match message
            string reason
                failed = true
            none
                failed = false
        if failed
            error_pc = pc
            break
        max_stack = lexer.maximum(max_stack, int(len(stack)))
        max_depth = lexer.maximum(max_depth, int(len(frames)))
        pc = next
    int[] callers = []
    int index = int(len(frames)) - 1
    while index >= 1
        callers = callers.append(frames[index].return_address - 1)
        index -= 1
    return Result(output, counts, calls, edges, executed, max_stack, max_depth, error_pc, message, callers)
