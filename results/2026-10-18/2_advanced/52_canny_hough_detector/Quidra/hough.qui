int smaller(int first, int second)
    return if first < second then first else second

int larger(int first, int second)
    return if first > second then first else second

int floor_divide(int numerator, int denominator)
    return if numerator >= 0 then numerator / denominator else -((-numerator + denominator - 1) / denominator)

int rho(int[] point, int angle, int[][] trig, int step)
    int[] row = trig[angle]
    return floor_divide(point[0] * row[0] + point[1] * row[1], 16384 * step)

int[][] circle_points(int radius)
    int[][] result = []
    set.Set<int> seen = set.Set<int>()
    int a = radius
    int b = 0
    int error_value = 1 - radius
    while a >= b
        int[][] points = [[a, b], [b, a], [-b, a], [-a, b], [-a, -b], [-b, -a], [b, -a], [a, -b]]
        for int[] point = points[]
            int key = (point[1] + radius) * (2 * radius + 1) + point[0] + radius
            if not seen.has(key)
                .seen.add(key)
                result = result.append(point)
        b += 1
        if error_value < 0
            error_value += 2 * b + 1
        else
            a -= 1
            error_value += 2 * (b - a) + 1
    return result

class CircleVotes(int[][] cells, int[][][] outlines, int low, int high)
class CirclePeak(int radius, int x, int y, int votes, int point_count)
class CirclePeaks(int candidate_count, CirclePeak[] peaks)

CircleVotes circle_votes(int[][] edges, int width, int height, int low, int high)
    int[][] cells = []
    int[][][] outlines = []
    for low <= int radius < high + 1
        int[] votes = [for int i < width * height then 0]
        int[][] offsets = circle_points(radius)
        outlines = outlines.append(offsets)
        for int[] point = edges[]
            for int[] offset = offsets[]
                int x = point[0] + offset[0]
                int y = point[1] + offset[1]
                if 0 <= x < width and 0 <= y < height
                    votes[y * width + x] += 1
        cells = cells.append(votes)
    return CircleVotes(cells, outlines, low, high)

CirclePeaks circle_peaks(CircleVotes data, int width, int height, int minimum)
    int candidate_count = 0
    CirclePeak[] peaks = []
    for int index < int(len(data.cells))
        int radius = data.low + index
        int denominator = int(len(data.outlines[index]))
        for int y < height
            for int x < width
                int votes = data.cells[index][y * width + x]
                if 100 * votes < minimum * denominator
                    continue
                candidate_count += 1
                bool peak = true
                for larger(0, index - 2) <= int other_index < smaller(int(len(data.cells)), index + 3)
                    if not peak
                        break
                    for larger(0, y - 2) <= int yy < smaller(height, y + 3)
                        if not peak
                            break
                        for larger(0, x - 2) <= int xx < smaller(width, x + 3)
                            if other_index == index and yy == y and xx == x
                                continue
                            int other = data.cells[other_index][yy * width + xx]
                            int left = votes * int(len(data.outlines[other_index]))
                            int right = other * denominator
                            bool earlier = other_index < index or (other_index == index and (yy < y or (yy == y and xx < x)))
                            if left < right or (left == right and earlier)
                                peak = false
                                break
                if peak
                    peaks = peaks.append(CirclePeak(radius, x, y, votes, denominator))
    return CirclePeaks(candidate_count, peaks)

int[][] line_votes(int[][] edges, int[][] trig, int step, int low, int high)
    int[][] votes = [for int angle < 180 then [for int i < high - low + 1 then 0]]
    for int[] point = edges[]
        for int angle < 180
            int radial = rho(point, angle, trig, step)
            votes[angle][radial - low] += 1
    return votes

int vote_at(int[][] votes, int angle, int radial, int low)
    int column = radial - low
    if angle < 0 or angle >= 180 or column < 0 or column >= int(len(votes[0]))
        return 0
    return votes[angle][column]

int[][] line_peaks(int[][] votes, int low, int threshold)
    int[][] peaks = []
    for int angle < 180
        for int column < int(len(votes[angle]))
            int count = votes[angle][column]
            if count < threshold
                continue
            int radial = low + column
            bool peak = true
            for angle - 2 <= int other_angle < angle + 3
                if not peak
                    break
                for radial - 2 <= int other_radial < radial + 3
                    if other_angle == angle and other_radial == radial
                        continue
                    int other = vote_at(votes, other_angle, other_radial, low)
                    bool earlier = other_angle < angle or (other_angle == angle and other_radial < radial)
                    if other > count or (other == count and earlier)
                        peak = false
                        break
            if peak
                peaks = peaks.append([angle, radial, count])
    return peaks
