import filters = "./filters.qui"

class Detection(int[][] response, int[][] candidates)

Detection detect(int[][] gx, int[][] gy, int window, int threshold)
    int height = int(len(gx))
    int width = int(len(gx[0]))
    int half = window / 2
    int[][] response = []
    for int y < height
        int[] row = []
        for int x < width
            int xx = 0
            int yy = 0
            int xy = 0
            for -half <= int dy < half + 1
                for -half <= int dx < half + 1
                    int horizontal = filters.clamped(gx, x + dx, y + dy)
                    int vertical = filters.clamped(gy, x + dx, y + dy)
                    xx += horizontal * horizontal
                    yy += vertical * vertical
                    xy += horizontal * vertical
            row = row.append(xx * yy - xy * xy - (xx + yy) * (xx + yy) / 25)
        response = response.append(row)
    int[][] candidates = []
    int maximum = 0
    for int y < height
        for int x < width
            int value = response[y][x]
            if value < threshold
                continue
            bool peak = true
            for -1 <= int dy < 2
                for -1 <= int dx < 2
                    int nx = x + dx
                    int ny = y + dy
                    if (dx == 0 and dy == 0) or nx < 0 or nx >= width or ny < 0 or ny >= height
                        continue
                    int other = response[ny][nx]
                    if other > value or (other == value and (ny < y or (ny == y and nx < x)))
                        peak = false
            if peak
                candidates = candidates.append([x, y, value])
                if value > maximum
                    maximum = value
    int base = int(len(candidates)) + 1
    int[] keys = []
    for int i < int(len(candidates))
        int[] row = candidates[i]
        int order = ((maximum - row[2]) * height + row[1]) * width + row[0]
        keys = keys.append(order * base + i)
    int[][] ordered = [for int key = keys.sorted()[] then candidates[key % base]]
    return Detection(response, ordered)
