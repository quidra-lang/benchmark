int integer(string text)
    int result = int.parse(text)
    return result

int[] integers(string text)
    return [for string value = text.split(" ")[] then integer(value)]

string[] lines(string path)
    string content = file.read(path)
    string[] result = content.split(NL)
    return result[0:<int(len(result)) - 1]

class Params(local string[][] rows)
    int gauss_size = integer(rows[0][1])
    int[] gauss_kernel = [for string value = rows[1][1:<int(len(rows[1]))][] then integer(value)]
    int gauss_divisor = integer(rows[2][1])
    int canny_low = integer(rows[3][1])
    int canny_high = integer(rows[4][1])
    int circle_min_radius = integer(rows[5][1])
    int circle_max_radius = integer(rows[6][1])
    int circle_min_percent = integer(rows[7][1])
    int circle_max_count = integer(rows[8][1])
    int hough_rho_step = integer(rows[9][1])
    int hough_threshold = integer(rows[10][1])
    int hough_max_lines = integer(rows[11][1])
    int segment_tolerance = integer(rows[12][1])
    int segment_max_gap = integer(rows[13][1])
    int segment_min_length = integer(rows[14][1])
    int junction_distance = integer(rows[15][1])
    int junction_min_angle = integer(rows[16][1])
    int angle_tolerance = integer(rows[17][1])
    int square_tolerance = integer(rows[18][1])
    int contrast_margin = integer(rows[19][1])
    int harris_window = integer(rows[20][1])
    int harris_threshold = integer(rows[21][1])
    int harris_max_count = integer(rows[22][1])
    int corner_match_distance = integer(rows[23][1])
    int overlay_divisor = integer(rows[24][1])

class Input(int[][] image, int[][] trig, Params params)

Input read_inputs()
    string[] rows = lines("input/image.pgm")
    int[][] image = [for string row = rows[3:<int(len(rows))][] then integers(row)]
    int[][] trig = []
    for string row = lines("input/trig.txt")[]
        int[] values = integers(row)
        trig = trig.append(values[1:<3])
    string[][] settings = [for string row = lines("input/params.txt")[] then row.split(" ")]
    return Input(image, trig, Params(settings))

void write_lines(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)

void write_pgm(string name, int[][] image)
    string[] rows = ["P2", "{len(image[0])} {len(image)}", "255"]
    for int[] row = image[]
        string[] values = [for int value = row[] then "{value}"]
        rows = rows.append(values.join(" "))
    write_lines(name, rows)
