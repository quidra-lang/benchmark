import filters = "./filters.qui"

int[][] neighbors(int width, int height, int x, int y)
    int[][] result = []
    for -1 <= int dy < 2
        for -1 <= int dx < 2
            int nx = x + dx
            int ny = y + dy
            if (dx != 0 or dy != 0) and 0 <= nx < width and 0 <= ny < height
                result = result.append([nx, ny])
    return result

int[][] directions(int[][] gx, int[][] gy)
    int[][] result = []
    for int y < int(len(gx))
        int[] row = []
        for int x < int(len(gx[0]))
            int horizontal = gx[y][x]
            int vertical = gy[y][x]
            int ax = filters.absolute(horizontal)
            int ay = filters.absolute(vertical)
            int direction = if 29 * ay <= 12 * ax then 0 elif 29 * ay >= 70 * ax then 90 elif horizontal * vertical < 0 then 45 else 135
            row = row.append(direction)
        result = result.append(row)
    return result

int[][] suppress(int[][] magnitude, int[][] direction)
    int height = int(len(magnitude))
    int width = int(len(magnitude[0]))
    int[][] result = [for int y < height then [for int x < width then 0]]
    for 1 <= int y < height - 1
        for 1 <= int x < width - 1
            int angle = direction[y][x]
            int dx = if angle == 0 or angle == 135 then -1 elif angle == 45 then 1 else 0
            int dy = if angle == 0 then 0 else -1
            int value = magnitude[y][x]
            if value > magnitude[y + dy][x + dx] and value >= magnitude[y - dy][x - dx]
                result[y][x] = value
    return result

class Hysteresis(bool[][] edges, bool[][] strong, bool[][] weak)

Hysteresis hysteresis(int[][] nonmax, int low, int high)
    int height = int(len(nonmax))
    int width = int(len(nonmax[0]))
    bool[][] edges = [for int y < height then [for int x < width then false]]
    bool[][] strong = edges
    bool[][] weak = edges
    int[][] queue = []
    for int y < height
        for int x < width
            int value = nonmax[y][x]
            if value >= high
                strong[y][x] = true
                edges[y][x] = true
                queue = queue.append([x, y])
            elif value >= low
                weak[y][x] = true
    int cursor = 0
    while cursor < int(len(queue))
        int[] point = queue[cursor]
        cursor += 1
        for int[] next = neighbors(width, height, point[0], point[1])[]
            int x = next[0]
            int y = next[1]
            if not edges[y][x] and (strong[y][x] or weak[y][x])
                edges[y][x] = true
                queue = queue.append(next)
    return Hysteresis(edges, strong, weak)

int[][][] components(bool[][] edges)
    int height = int(len(edges))
    int width = int(len(edges[0]))
    bool[][] visited = [for int y < height then [for int x < width then false]]
    int[][][] result = []
    for int y < height
        for int x < width
            if not edges[y][x] or visited[y][x]
                continue
            int[][] queue = [[x, y]]
            visited[y][x] = true
            int cursor = 0
            while cursor < int(len(queue))
                int[] point = queue[cursor]
                cursor += 1
                for int[] next = neighbors(width, height, point[0], point[1])[]
                    int nx = next[0]
                    int ny = next[1]
                    if edges[ny][nx] and not visited[ny][nx]
                        visited[ny][nx] = true
                        queue = queue.append(next)
            result = result.append(queue)
    return result
