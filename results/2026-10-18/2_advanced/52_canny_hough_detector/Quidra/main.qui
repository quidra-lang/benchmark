import pgm_io = "./pgm_io.qui"
import filters = "./filters.qui"
import canny = "./canny.qui"
import hough = "./hough.qui"
import corners = "./corners.qui"

int min_value(int first, int second)
    return if first < second then first else second

int max_value(int first, int second)
    return if first > second then first else second

int cross(int[] first, int[] second)
    return first[0] * second[1] - first[1] * second[0]

int dot(int[] first, int[] second)
    return first[0] * second[0] + first[1] * second[1]

int[] difference(int[] first, int[] second)
    return [first[0] - second[0], first[1] - second[1]]

int chebyshev(int[] first, int[] second)
    return max_value(filters.absolute(first[0] - second[0]), filters.absolute(first[1] - second[1]))

int angle_difference(int first, int second)
    int gap = filters.absolute(first - second)
    return min_value(gap, 180 - gap)

int nearest(int numerator, int denominator)
    if denominator < 0
        numerator = -numerator
        denominator = -denominator
    return hough.floor_divide(2 * numerator + denominator, 2 * denominator)

bool has_int(int[] values, int target)
    for int value = values[]
        if value == target
            return true
    return false

string words(int[] values)
    string[] fields = [for int value = values[] then "{value}"]
    return fields.join(" ")

bool inside_image(int[] point, int width, int height)
    return 0 <= point[0] < width and 0 <= point[1] < height

int[][] bresenham(int[] first, int[] last)
    int x = first[0]
    int y = first[1]
    int dx = filters.absolute(last[0] - x)
    int dy = -filters.absolute(last[1] - y)
    int sx = if x < last[0] then 1 else -1
    int sy = if y < last[1] then 1 else -1
    int error_value = dx + dy
    int[][] result = []
    while true
        result = result.append([x, y])
        if x == last[0] and y == last[1]
            break
        int doubled = 2 * error_value
        if doubled >= dy
            error_value += dy
            x += sx
        if doubled <= dx
            error_value += dx
            y += sy
    return result

bool circle_before(hough.CirclePeak first, hough.CirclePeak second)
    int left = first.votes * second.point_count
    int right = second.votes * first.point_count
    if left != right
        return left > right
    if first.radius != second.radius
        return first.radius < second.radius
    if first.y != second.y
        return first.y < second.y
    return first.x < second.x

hough.CirclePeak[] sorted_circle_peaks(hough.CirclePeak[] values)
    int count = int(len(values))
    int span = 1
    while span < count
        hough.CirclePeak[] merged = []
        for int start < count step 2 * span
            int middle = min_value(count, start + span)
            int finish = min_value(count, start + 2 * span)
            int first = start
            int second = middle
            while first < middle or second < finish
                if second >= finish or (first < middle and not circle_before(values[second], values[first]))
                    merged = merged.append(values[first])
                    first += 1
                else
                    merged = merged.append(values[second])
                    second += 1
        values = merged
        span *= 2
    return values

bool offset_before(int[] first, int[] second)
    int half_first = if first[1] > 0 or (first[1] == 0 and first[0] > 0) then 0 else 1
    int half_second = if second[1] > 0 or (second[1] == 0 and second[0] > 0) then 0 else 1
    if half_first != half_second
        return half_first < half_second
    int turn = cross(first, second)
    if turn != 0
        return turn > 0
    return first[0] < second[0] or (first[0] == second[0] and first[1] < second[1])

int[][] ordered_outline(int[][] points)
    int[][] result = []
    for int[] point = points[]
        int place = int(len(result))
        for int i < int(len(result))
            if offset_before(point, result[i])
                place = i
                break
        result = result[0:<place].append(point).concat(result[place:<int(len(result))])
    return result

class Circle(int[] center, int radius, int votes, int point_count, int[][] outline, int gap, int arcs)
class Segment(int[] first, int[] last, int theta, int length, int pixel_count, int[][] points, int line = -1)
class Line(int theta, int rho, int votes, int[] segments)
class Junction(int first, int second, int[] point, int end_first, int end_second)
class Corner(int[] point, int response, int match_kind = 0, int match_shape = -1, int match_part = -1)

class Polygon(int[] segments, int[][] vertices)
    int[] angles = []
    int[] lengths = []
    int[] supports = []
    int[] vertex_corners = [for int i < int(len(vertices)) then -1]
    int sigma = 0
    string kind = ""

class Shape(int kind, int index, int[][] points, int[][] vertices, int[] center, int radius, int sigma)
    int pixel_count = 0
    int mean = 0
    int contrast = 0
    int enclosing = -1

class Component(int[][] pixels, int[] box, int ends, int strength, int direction)
    int shape = -1
    int explained = 0

int[] circle_gaps(Circle circle, bool[][] edges, int width, int height)
    bool[] hits = []
    int hit_count = 0
    for int[] offset = ordered_outline(circle.outline)[]
        int[] point = [circle.center[0] + offset[0], circle.center[1] + offset[1]]
        bool hit = inside_image(point, width, height) and edges[point[1]][point[0]]
        hits = hits.append(hit)
        if hit
            hit_count += 1
    int count = int(len(hits))
    if hit_count == count
        return [0, 1]
    if hit_count == 0
        return [count, 0]
    int arcs = 0
    for int i < count
        if hits[i] and not hits[(i + count - 1) % count]
            arcs += 1
    int gap = 0
    int gap_run = 0
    for int i < 2 * count
        if hits[i % count]
            gap_run = 0
        else
            gap_run += 1
            if gap_run > gap
                gap = gap_run
    return [min_value(gap, count), arcs]

bool circumference(Circle circle, int[] point)
    int[] delta = difference(point, circle.center)
    int squared = dot(delta, delta)
    return (circle.radius - 1) * (circle.radius - 1) <= squared <= (circle.radius + 1) * (circle.radius + 1)

int[] end_choice(Segment segment, int[] point)
    int first_distance = chebyshev(segment.first, point)
    int last_distance = chebyshev(segment.last, point)
    return if first_distance <= last_distance then [0, first_distance] else [1, last_distance]

int end_for(Junction junction, int segment)
    return if junction.first == segment then junction.end_first else junction.end_second

bool inside_shape(Shape shape, int[] point)
    if shape.kind == 1
        int[] delta = difference(point, shape.center)
        return dot(delta, delta) <= shape.radius * shape.radius
    for int i < int(len(shape.vertices))
        int[] vertex = shape.vertices[i]
        int[] next = shape.vertices[(i + 1) % int(len(shape.vertices))]
        int turn = cross(difference(next, vertex), difference(point, vertex))
        if turn != 0 and (turn > 0) != (shape.sigma > 0)
            return false
    return true

string shape_text(Shape[] shapes, int index)
    if index < 0
        return "none"
    Shape shape = shapes[index]
    string kind = if shape.kind == 0 then "polygon" else "circle"
    return "{kind} {shape.index + 1}"

string[] polygon_kinds()
    return ["equilateral_triangle", "right_triangle", "triangle", "square", "rectangle", "parallelogram", "trapezoid", "quadrilateral"]

class Lab self(pgm_io.Input data)
    int[][] image = data.image
    int[][] trig = data.trig
    pgm_io.Params settings = data.params
    int height = int(len(data.image))
    int width = int(len(data.image[0]))
    filters.Gradient gradient = filters.gradient(filters.smoothing(data.image, data.params.gauss_size, data.params.gauss_kernel, data.params.gauss_divisor))
    int[][] directions = canny.directions(gradient.gx, gradient.gy)
    int[][] nonmax = canny.suppress(gradient.magnitude, directions)
    canny.Hysteresis thresholded = canny.hysteresis(nonmax, data.params.canny_low, data.params.canny_high)
    bool[][] edges = thresholded.edges
    int[][] edge_points = []
    Component[] components = []
    Circle[] circles = []
    bool[][] circle_edge = [for int y < int(len(data.image)) then [for int x < int(len(data.image[0])) then false]]
    int[][] line_edge = []
    int[][] line_votes = []
    Line[] lines = []
    Segment[] segments = []
    bool[][] claimed = [for int y < int(len(data.image)) then [for int x < int(len(data.image[0])) then false]]
    Junction[] junctions = []
    map.Map<int, int> link_index = map.Map<int, int>()
    int[][] graph = []
    Polygon[] polygons = []
    Shape[] shapes = []
    Corner[] detected_corners = []
    int circle_candidate_count = 0
    int circle_peak_count = 0
    int line_peak_count = 0
    int corner_candidate_count = 0
    int vertices_with_corner = 0
    int rho_low = 0
    int rho_high = 0
    int maximum_votes = 0

    void .prepare_components()
        for int y < height
            for int x < width
                if edges[y][x]
                    edge_points = edge_points.append([x, y])
        for int[][] pixels = canny.components(edges)[]
            int low_x = width
            int low_y = height
            int high_x = -1
            int high_y = -1
            int ends = 0
            int strength = 0
            int[] counts = [0, 0, 0, 0]
            for int[] point = pixels[]
                int x = point[0]
                int y = point[1]
                low_x = min_value(low_x, x)
                low_y = min_value(low_y, y)
                high_x = max_value(high_x, x)
                high_y = max_value(high_y, y)
                int adjacent = 0
                for int[] next = canny.neighbors(width, height, x, y)[]
                    if edges[next[1]][next[0]]
                        adjacent += 1
                if adjacent == 1
                    ends += 1
                strength += gradient.magnitude[y][x]
                counts[directions[y][x] / 45] += 1
            int direction = 0
            for 1 <= int i < 4
                if counts[i] > counts[direction]
                    direction = i
            components = components.append(Component(pixels, [low_x, low_y, high_x, high_y], ends, strength / int(len(pixels)), direction * 45))

    void .detect_circles()
        hough.CircleVotes votes = hough.circle_votes(edge_points, width, height, settings.circle_min_radius, settings.circle_max_radius)
        hough.CirclePeaks result = hough.circle_peaks(votes, width, height, settings.circle_min_percent)
        hough.CirclePeak[] peaks = sorted_circle_peaks(result.peaks)
        circle_candidate_count = result.candidate_count
        circle_peak_count = int(len(peaks))
        for int i < min_value(settings.circle_max_count, int(len(peaks)))
            hough.CirclePeak peak = peaks[i]
            int[][] outline = votes.outlines[peak.radius - settings.circle_min_radius]
            Circle circle = Circle([peak.x, peak.y], peak.radius, peak.votes, peak.point_count, outline, 0, 0)
            int[] gaps = circle_gaps(circle, edges, width, height)
            circle.gap = gaps[0]
            circle.arcs = gaps[1]
            circles = circles.append(circle)
        for int[] point = edge_points[]
            bool on_circle = false
            for Circle circle = circles[]
                if circumference(circle, point)
                    on_circle = true
                    break
            if on_circle
                circle_edge[point[1]][point[0]] = true
            else
                line_edge = line_edge.append(point)

    void .detect_lines()
        int[][] image_corners = [[0, 0], [width - 1, 0], [0, height - 1], [width - 1, height - 1]]
        for int angle < 180
            for int[] point = image_corners[]
                int value = hough.rho(point, angle, trig, settings.hough_rho_step)
                rho_low = min_value(rho_low, value)
                rho_high = max_value(rho_high, value)
        line_votes = hough.line_votes(line_edge, trig, settings.hough_rho_step, rho_low, rho_high)
        for int[] row = line_votes[]
            for int value = row[]
                maximum_votes = max_value(maximum_votes, value)
        int[][] peaks = hough.line_peaks(line_votes, rho_low, settings.hough_threshold)
        line_peak_count = int(len(peaks))
        int base = int(len(peaks)) + 1
        int rho_count = rho_high - rho_low + 1
        int[] keys = []
        for int i < int(len(peaks))
            int[] peak = peaks[i]
            int order = ((width * height - peak[2]) * 180 + peak[0]) * rho_count + peak[1] - rho_low
            keys = keys.append(order * base + i)
        int[][] ordered_peaks = [for int key = keys.sorted()[] then peaks[key % base]]
        for int[] peak = ordered_peaks[]
            if int(len(lines)) >= settings.hough_max_lines
                break
            int angle = peak[0]
            int[] row = trig[angle]
            int[][] available = []
            int low_u = 0
            for int[] point = line_edge[]
                if not claimed[point[1]][point[0]] and filters.absolute(hough.rho(point, angle, trig, settings.hough_rho_step) - peak[1]) <= settings.segment_tolerance
                    int u = point[1] * row[0] - point[0] * row[1]
                    available = available.append(point.append(u))
                    low_u = min_value(low_u, u)
            base = int(len(available)) + 1
            keys = []
            for int i < int(len(available))
                int[] point = available[i]
                int order = ((point[2] - low_u) * width + point[0]) * height + point[1]
                keys = keys.append(order * base + i)
            int[][] ordered = [for int key = keys.sorted()[] then available[key % base]]
            int[][][] groups = []
            int[][] current = []
            for int i < int(len(ordered))
                if i > 0 and ordered[i][2] - ordered[i - 1][2] > settings.segment_max_gap * 16384
                    groups = groups.append(current)
                    current = []
                current = current.append(ordered[i][0:<2])
            if len(current) > 0
                groups = groups.append(current)
            Segment[] pending = []
            for int[][] group = groups[]
                int[] first = group[0]
                int[] last = group[int(len(group)) - 1]
                int length = chebyshev(first, last) + 1
                if length >= settings.segment_min_length
                    pending = pending.append(Segment(first, last, angle, length, int(len(group)), group))
            if len(pending) == 0
                continue
            int line = int(len(lines))
            int[] identifiers = []
            for Segment segment = pending[]
                segment.line = line
                identifiers = identifiers.append(int(len(segments)))
                segments = segments.append(segment)
                for int[] point = segment.points[]
                    claimed[point[1]][point[0]] = true
            lines = lines.append(Line(angle, peak[1], peak[2], identifiers))

    int link(int first, int second)
        match link_index.get(first * int(len(segments)) + second)
            int index
                return index
            none
                return -1

    void .make_junctions()
        graph = [for int i < int(len(segments)) then []]
        junctions = []
        link_index = map.Map<int, int>()
        for int first < int(len(segments)) - 1
            for first + 1 <= int second < int(len(segments))
                Segment a = segments[first]
                Segment b = segments[second]
                if angle_difference(a.theta, b.theta) < settings.junction_min_angle
                    continue
                int[] da = difference(a.last, a.first)
                int[] db = difference(b.last, b.first)
                int denominator = cross(da, db)
                if denominator == 0
                    continue
                int lambda = cross(difference(b.first, a.first), db)
                int[] point = [nearest(a.first[0] * denominator + lambda * da[0], denominator), nearest(a.first[1] * denominator + lambda * da[1], denominator)]
                int[] end_a = end_choice(a, point)
                int[] end_b = end_choice(b, point)
                if end_a[1] > settings.junction_distance or end_b[1] > settings.junction_distance
                    continue
                int index = int(len(junctions))
                junctions = junctions.append(Junction(first, second, point, end_a[0], end_b[0]))
                .link_index.set(first * int(len(segments)) + second, index)
                .link_index.set(second * int(len(segments)) + first, index)
                graph[first] = graph[first].append(second)
                graph[second] = graph[second].append(first)
        for int i < int(len(graph))
            graph[i] = graph[i].sorted()

    void .extend_polygon(int[] sequence, int count)
        int first = sequence[0]
        int last = sequence[int(len(sequence)) - 1]
        if int(len(sequence)) == count
            if sequence[1] >= last or self.link(last, first) < 0
                return
            int[][] vertices = []
            for int i < count
                int current = sequence[i]
                int previous = sequence[(i + count - 1) % count]
                int following = sequence[(i + 1) % count]
                Junction entry = junctions[self.link(previous, current)]
                Junction exit = junctions[self.link(current, following)]
                if end_for(entry, current) == end_for(exit, current)
                    return
                vertices = vertices.append(entry.point)
            bool positive = true
            bool negative = true
            for int i < count
                int[] point = vertices[i]
                int[] next = vertices[(i + 1) % count]
                int[] after = vertices[(i + 2) % count]
                int turn = cross(difference(next, point), difference(after, next))
                positive = positive and turn > 0
                negative = negative and turn < 0
            if positive or negative
                polygons = polygons.append(Polygon(sequence, vertices))
            return
        for int candidate = graph[last][]
            if candidate > first and not has_int(sequence, candidate)
                .self.extend_polygon(sequence.append(candidate), count)

    bool near_edge(int[] point)
        for -1 <= int dy < 2
            for -1 <= int dx < 2
                int[] neighbor = [point[0] + dx, point[1] + dy]
                if inside_image(neighbor, width, height) and edges[neighbor[1]][neighbor[0]]
                    return true
        return false

    void .polygon_properties()
        for int index < int(len(polygons))
            Polygon polygon = polygons[index]
            int count = int(len(polygon.segments))
            int[] theta = [for int segment = polygon.segments[] then segments[segment].theta]
            bool all_sixty = true
            bool any_right = false
            bool all_right = true
            for int i < count
                int[] previous = polygon.vertices[(i + count - 1) % count]
                int[] point = polygon.vertices[i]
                int[] following = polygon.vertices[(i + 1) % count]
                int phi = angle_difference(theta[(i + count - 1) % count], theta[i])
                if dot(difference(previous, point), difference(following, point)) < 0
                    phi = 180 - phi
                polygon.angles = polygon.angles.append(phi)
                int[] side = difference(following, point)
                polygon.lengths = polygon.lengths.append(dot(side, side))
                int[][] raster = bresenham(point, following)
                int support = 0
                for int[] pixel = raster[]
                    if self.near_edge(pixel)
                        support += 1
                polygon.supports = polygon.supports.append(100 * support / int(len(raster)))
                polygon.sigma += cross(point, following)
                all_sixty = all_sixty and filters.absolute(phi - 60) <= settings.angle_tolerance
                any_right = any_right or filters.absolute(phi - 90) <= settings.angle_tolerance
                all_right = all_right and filters.absolute(phi - 90) <= settings.angle_tolerance
            if count == 3
                polygon.kind = if all_sixty then "equilateral_triangle" elif any_right then "right_triangle" else "triangle"
            else
                bool first_parallel = angle_difference(theta[0], theta[2]) <= settings.angle_tolerance
                bool second_parallel = angle_difference(theta[1], theta[3]) <= settings.angle_tolerance
                if not first_parallel and not second_parallel
                    polygon.kind = "quadrilateral"
                elif first_parallel != second_parallel
                    polygon.kind = "trapezoid"
                elif not all_right
                    polygon.kind = "parallelogram"
                else
                    int low = polygon.lengths[0]
                    int high = polygon.lengths[0]
                    for int length = polygon.lengths[]
                        low = min_value(low, length)
                        high = max_value(high, length)
                    polygon.kind = if 100 * (high - low) <= settings.square_tolerance * high then "square" else "rectangle"
            polygons[index] = polygon

    void .detect_polygons()
        for int count = [3, 4][]
            for int first < int(len(segments))
                .self.extend_polygon([first], count)
        .self.polygon_properties()

    void .measure_shapes()
        for int index < int(len(polygons))
            Polygon polygon = polygons[index]
            shapes = shapes.append(Shape(0, index, polygon.vertices, polygon.vertices, [], 0, polygon.sigma))
        for int index < int(len(circles))
            Circle circle = circles[index]
            int x = circle.center[0]
            int y = circle.center[1]
            int radius = circle.radius
            int[][] points = [[x + radius, y], [x, y + radius], [x - radius, y], [x, y - radius]]
            shapes = shapes.append(Shape(1, index, points, [], circle.center, radius, 0))
        for int index < int(len(shapes))
            Shape shape = shapes[index]
            int low_x = shape.points[0][0]
            int high_x = low_x
            int low_y = shape.points[0][1]
            int high_y = low_y
            for int[] point = shape.points[]
                low_x = min_value(low_x, point[0])
                high_x = max_value(high_x, point[0])
                low_y = min_value(low_y, point[1])
                high_y = max_value(high_y, point[1])
            low_x = max_value(0, low_x - settings.contrast_margin)
            low_y = max_value(0, low_y - settings.contrast_margin)
            high_x = min_value(width - 1, high_x + settings.contrast_margin)
            high_y = min_value(height - 1, high_y + settings.contrast_margin)
            int inside_count = 0
            int outside_count = 0
            int inside_sum = 0
            int outside_sum = 0
            for low_y <= int y < high_y + 1
                for low_x <= int x < high_x + 1
                    int value = image[y][x]
                    if inside_shape(shape, [x, y])
                        inside_count += 1
                        inside_sum += value
                    else
                        outside_count += 1
                        outside_sum += value
            shape.pixel_count = inside_count
            shape.mean = if inside_count == 0 then 0 else inside_sum / inside_count
            shape.contrast = shape.mean - (if outside_count == 0 then 0 else outside_sum / outside_count)
            shapes[index] = shape
        for int child < int(len(shapes))
            int enclosing = -1
            for int parent < int(len(shapes))
                if parent == child or shapes[parent].pixel_count <= shapes[child].pixel_count
                    continue
                bool all_inside = true
                for int[] point = shapes[child].points[]
                    if not inside_shape(shapes[parent], point)
                        all_inside = false
                        break
                if all_inside and (enclosing < 0 or shapes[parent].pixel_count < shapes[enclosing].pixel_count)
                    enclosing = parent
            shapes[child].enclosing = enclosing

    void .match_corners()
        corners.Detection detection = corners.detect(gradient.gx, gradient.gy, settings.harris_window, settings.harris_threshold)
        corner_candidate_count = int(len(detection.candidates))
        for int i < min_value(settings.harris_max_count, int(len(detection.candidates)))
            int[] row = detection.candidates[i]
            Corner corner = Corner(row[0:<2], row[2])
            int best = -1
            for int p < int(len(polygons))
                for int vertex < int(len(polygons[p].vertices))
                    int distance = chebyshev(corner.point, polygons[p].vertices[vertex])
                    if distance <= settings.corner_match_distance and (best < 0 or distance < best)
                        best = distance
                        corner.match_kind = 1
                        corner.match_shape = p
                        corner.match_part = vertex
            if best < 0
                for int segment < int(len(segments))
                    int[][] endpoints = [segments[segment].first, segments[segment].last]
                    for int ending < 2
                        int distance = chebyshev(corner.point, endpoints[ending])
                        if distance <= settings.corner_match_distance and (best < 0 or distance < best)
                            best = distance
                            corner.match_kind = 2
                            corner.match_shape = segment
                            corner.match_part = ending
            detected_corners = detected_corners.append(corner)
        for int p < int(len(polygons))
            for int vertex < int(len(polygons[p].vertices))
                int best = -1
                for int c < int(len(detected_corners))
                    int distance = chebyshev(polygons[p].vertices[vertex], detected_corners[c].point)
                    if distance <= settings.corner_match_distance and (best < 0 or distance < best)
                        best = distance
                        polygons[p].vertex_corners[vertex] = c
                if best >= 0
                    vertices_with_corner += 1

    void .match_components()
        for int index < int(len(shapes))
            Shape shape = shapes[index]
            bool[] explained = [for int i < width * height then false]
            if shape.kind == 1
                Circle circle = circles[shape.index]
                for int[] point = edge_points[]
                    if circumference(circle, point)
                        explained[point[1] * width + point[0]] = true
            else
                for int i < int(len(shape.vertices))
                    int[] first = shape.vertices[i]
                    int[] last = shape.vertices[(i + 1) % int(len(shape.vertices))]
                    for int[] point = bresenham(first, last)[]
                        for -1 <= int dy < 2
                            for -1 <= int dx < 2
                                int[] neighbor = [point[0] + dx, point[1] + dy]
                                if inside_image(neighbor, width, height) and edges[neighbor[1]][neighbor[0]]
                                    explained[neighbor[1] * width + neighbor[0]] = true
            for int c < int(len(components))
                int count = 0
                for int[] point = components[c].pixels[]
                    if explained[point[1] * width + point[0]]
                        count += 1
                if count > components[c].explained
                    components[c].shape = index
                    components[c].explained = count

    void mark_pixel(int[][] &canvas, int[] point)
        if inside_image(point, width, height)
            canvas[point[1]][point[0]] = 255

    int[][] overlay_image()
        int[][] overlay = [for int[] row = image[] then [for int value = row[] then value / settings.overlay_divisor]]
        for Segment segment = segments[]
            for int[] point = bresenham(segment.first, segment.last)[]
                self.mark_pixel(&overlay, point)
        for Circle circle = circles[]
            for int[] offset = circle.outline[]
                self.mark_pixel(&overlay, [circle.center[0] + offset[0], circle.center[1] + offset[1]])
        for Corner corner = detected_corners[]
            for -2 <= int offset < 3
                self.mark_pixel(&overlay, [corner.point[0] + offset, corner.point[1]])
                self.mark_pixel(&overlay, [corner.point[0], corner.point[1] + offset])
        return overlay

    int[][] vote_image()
        int[][] result = []
        for rho_low <= int radial < rho_high + 1
            int[] row = []
            for int angle < 180
                int value = if maximum_votes == 0 then 0 else 255 * line_votes[angle][radial - rho_low] / maximum_votes
                row = row.append(value)
            result = result.append(row)
        return result

    string[] lines_listing()
        string[] result = ["lines {len(lines)}"]
        for int i < int(len(lines))
            Line line = lines[i]
            result = result.append("line {i + 1} theta {line.theta} rho {line.rho} votes {line.votes} segments {len(line.segments)}")
            for int index = line.segments[]
                Segment segment = segments[index]
                result = result.append("segment {index + 1} start {words(segment.first)} end {words(segment.last)} length {segment.length} pixels {segment.pixel_count}")
        return result

    string[] circles_listing()
        string[] result = ["circles {len(circles)}"]
        for int i < int(len(circles))
            Circle circle = circles[i]
            Shape shape = shapes[int(len(polygons)) + i]
            result = result.append("circle {i + 1} center {words(circle.center)} radius {circle.radius} votes {circle.votes} points {circle.point_count} gap {circle.gap} arcs {circle.arcs} pixels {shape.pixel_count} mean {shape.mean} contrast {shape.contrast} inside {shape_text(shapes, shape.enclosing)}")
        return result

    string[] polygons_listing()
        string[] result = ["polygons {len(polygons)}"]
        for int p < int(len(polygons))
            Polygon polygon = polygons[p]
            Shape shape = shapes[p]
            int amount = filters.absolute(polygon.sigma)
            string area = "{amount / 2}." + (if amount % 2 == 0 then "0" else "5")
            int[] identifiers = [for int segment = polygon.segments[] then segment + 1]
            result = result.append("polygon {p + 1} {polygon.kind} segments {words(identifiers)} area {area} pixels {shape.pixel_count} mean {shape.mean} contrast {shape.contrast} inside {shape_text(shapes, shape.enclosing)}")
            for int i < int(len(polygon.vertices))
                int corner = polygon.vertex_corners[i]
                string corner_text = if corner < 0 then "none" else "{corner + 1}"
                result = result.append("vertex {i + 1} {words(polygon.vertices[i])} angle {polygon.angles[i]} corner {corner_text}")
            for int i < int(len(polygon.segments))
                result = result.append("side {i + 1} segment {polygon.segments[i] + 1} length2 {polygon.lengths[i]} support {polygon.supports[i]}")
        return result

    string[] corners_listing()
        string[] result = ["corners {len(detected_corners)}"]
        for int i < int(len(detected_corners))
            Corner corner = detected_corners[i]
            string match_text = "none"
            if corner.match_kind == 1
                match_text = "polygon {corner.match_shape + 1} vertex {corner.match_part + 1}"
            elif corner.match_kind == 2
                string ending = if corner.match_part == 0 then "start" else "end"
                match_text = "segment {corner.match_shape + 1} {ending}"
            result = result.append("corner {i + 1} {words(corner.point)} response {corner.response} match {match_text}")
        return result

    string[] components_listing()
        string[] result = ["components {len(components)}"]
        for int i < int(len(components))
            Component component = components[i]
            result = result.append("component {i + 1} pixels {len(component.pixels)} box {words(component.box)} ends {component.ends} strength {component.strength} direction {component.direction} shape {shape_text(shapes, component.shape)} explained {component.explained}")
        return result

    string[] report_lines()
        int gradient_nonzero = 0
        int gradient_maximum = 0
        int nms_kept = 0
        int strong_count = 0
        int weak_count = 0
        int weak_kept = 0
        int circle_edge_count = 0
        int claimed_count = 0
        int[] direction_counts = [0, 0, 0, 0]
        for int y < height
            for int x < width
                int value = gradient.magnitude[y][x]
                if value > 0
                    gradient_nonzero += 1
                gradient_maximum = max_value(gradient_maximum, value)
                if nonmax[y][x] > 0
                    nms_kept += 1
                if thresholded.strong[y][x]
                    strong_count += 1
                if thresholded.weak[y][x]
                    weak_count += 1
                    if edges[y][x]
                        weak_kept += 1
                if edges[y][x]
                    direction_counts[directions[y][x] / 45] += 1
                if circle_edge[y][x]
                    circle_edge_count += 1
                if claimed[y][x]
                    claimed_count += 1
        string[] kinds = polygon_kinds()
        int[] kind_counts = [for int i < int(len(kinds)) then 0]
        for Polygon polygon = polygons[]
            for int i < int(len(kinds))
                if polygon.kind == kinds[i]
                    kind_counts[i] += 1
        int[] matches = [0, 0, 0]
        for Corner corner = detected_corners[]
            matches[corner.match_kind] += 1
        string[] result = [
            "image {width} {height}",
            "gradient_nonzero {gradient_nonzero}",
            "gradient_max {gradient_maximum}",
            "nms_kept {nms_kept}",
            "strong {strong_count}",
            "weak {weak_count}",
            "edges {len(edge_points)}",
            "weak_kept {weak_kept}",
            "weak_dropped {weak_count - weak_kept}",
            "edge_components {len(components)}",
        ]
        for int i < 4
            result = result.append("direction_{45 * i} {direction_counts[i]}")
        result = result.concat([
            "circle_candidates {circle_candidate_count}",
            "circle_peaks {circle_peak_count}",
            "circles {len(circles)}",
            "circle_edge_pixels {circle_edge_count}",
            "line_edge_pixels {len(line_edge)}",
            "hough_max_votes {maximum_votes}",
            "hough_peaks {line_peak_count}",
            "lines {len(lines)}",
            "segments {len(segments)}",
            "claimed_pixels {claimed_count}",
            "junctions {len(junctions)}",
            "polygons {len(polygons)}",
        ])
        for int i < int(len(kinds))
            result = result.append("{kinds[i]} {kind_counts[i]}")
        return result.concat([
            "corner_candidates {corner_candidate_count}",
            "corners {len(detected_corners)}",
            "corners_on_vertices {matches[1]}",
            "corners_on_segments {matches[2]}",
            "corners_unmatched {matches[0]}",
            "vertices_with_corner {vertices_with_corner}",
        ])

    void write_reports()
        int[][] edge_image = [for bool[] row = edges[] then [for bool value = row[] then (if value then 255 else 0)]]
        pgm_io.write_pgm("edges.pgm", edge_image)
        pgm_io.write_pgm("hough.pgm", self.vote_image())
        pgm_io.write_pgm("overlay.pgm", self.overlay_image())
        pgm_io.write_lines("lines.txt", self.lines_listing())
        pgm_io.write_lines("circles.txt", self.circles_listing())
        pgm_io.write_lines("polygons.txt", self.polygons_listing())
        pgm_io.write_lines("corners.txt", self.corners_listing())
        pgm_io.write_lines("components.txt", self.components_listing())
        pgm_io.write_lines("report.txt", self.report_lines())

void run()
    pgm_io.Input data = pgm_io.read_inputs()
    Lab lab = Lab(data)
    .lab.prepare_components()
    .lab.detect_circles()
    .lab.detect_lines()
    .lab.make_junctions()
    .lab.detect_polygons()
    .lab.measure_shapes()
    .lab.match_corners()
    .lab.match_components()
    lab.write_reports()

run()
