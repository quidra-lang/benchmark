bool has<T>(const T[] items, T sought)
    for T item = items[]
        if item == sought
            return true
    return false

int[] unique(const int[] items)
    int[] result = []
    for int item = items[]
        if not has(result, item)
            result = result.append(item)
    return result

int compare(const int[] first, const int[] second)
    int count = if len(first) < len(second) then int(len(first)) else int(len(second))
    for int position < count
        if first[position] != second[position]
            return if first[position] < second[position] then -1 else 1
    return if len(first) < len(second) then -1 elif len(first) > len(second) then 1 else 0

int minimum(int first, int second)
    return if first < second then first else second

int maximum(int first, int second)
    return if first > second then first else second

int absolute(int value)
    return if value < 0 then -value else value

string[] setting_names()
    return ["layering", "width", "promotion", "heuristic", "sweeps", "node_sep", "dummy_sep", "layer_gap", "direction", "sifting", "reduce", "restarts", "seed"]

class Settings(string[] values = ["longest", "4", "off", "barycenter", "12", "2", "1", "3", "TB", "off", "off", "0", "1"])
    string text(string key)
        string[] names = setting_names()
        for int position < int(len(names))
            if names[position] == key
                return values[position]
        return ""

    int integer(string key)
        int result = int.parse(text(key))
        return result

    bool on(string key)
        return text(key) == "on"

bool change_setting(Settings &settings, string key, string value)
    string[] names = setting_names()
    int index = -1
    for int position < int(len(names))
        if names[position] == key
            index = position
    if index < 0
        return false
    string[] choices = []
    if key == "layering"
        choices = ["longest", "coffman"]
    elif key == "promotion" or key == "sifting" or key == "reduce"
        choices = ["on", "off"]
    elif key == "heuristic"
        choices = ["barycenter", "median"]
    elif key == "direction"
        choices = ["TB", "BT", "LR", "RL"]
    if len(choices) > 0
        if not has(choices, value)
            return false
        settings.values[index] = value
        return true
    if len(value) < 1 or len(value) > 10
        return false
    for int position < int(len(value))
        if value[position] < "0" or value[position] > "9"
            return false
    int number = int.parse(value)
    int low = if key == "sweeps" or key == "restarts" then 0 elif key == "layer_gap" then 2 else 1
    int high = if key == "width" then 40 elif key == "sweeps" then 50 elif key == "seed" then 2147483646 else 9
    if number < low or number > high
        return false
    settings.values[index] = number.string()
    return true

class Node(int id, string label)
class Edge(int first, int second)
class Problem(string kind, int line)
class Graph(string name, Settings settings, Node[] nodes = [], Edge[] edges = [], Edge | none path = none, int loops = 0, int duplicates = 0, Problem | none problem = none)

int | none node_index(const Node[] nodes, int id)
    for int position < int(len(nodes))
        if nodes[position].id == id
            return position
    return none

int | error required_index(const Node[] nodes, int id)
    match node_index(nodes, id)
        int found
            return found
        none
            return error("missing node")

bool known(const Node[] nodes, int id)
    match node_index(nodes, id)
        int found
            return true
        none
            return false

Graph[] read_graphs()
    Settings defaults = Settings()
    string params = file.read("input/params.txt")
    string[] settings_lines = params.split(NL)
    for string line = settings_lines[]
        if line != "" and not line.starts_with("#")
            string[] words = line.split(" ")
            bool accepted = change_setting(&defaults, words[0], words[1])
    string source = file.read("input/graphs.txt")
    string[] lines = source.split(NL)
    Graph[] result = []
    Graph current = Graph("", defaults)
    for int line_index < int(len(lines))
        string line = lines[line_index]
        if line == "" or line.starts_with("#")
            continue
        string[] words = line.split(" ")
        if words[0] == "GRAPH"
            current = Graph(words[1], defaults)
            continue
        if words[0] == "END"
            match current.problem
                Problem ignored
                    current.problem = ignored
                none
                    if len(current.nodes) == 0
                        current.problem = Problem("no_nodes", line_index + 1)
            for int position < int(len(current.nodes))
                int cursor = position
                while cursor > 0 and current.nodes[cursor].id < current.nodes[cursor - 1].id
                    Node saved = current.nodes[cursor]
                    current.nodes[cursor] = current.nodes[cursor - 1]
                    current.nodes[cursor - 1] = saved
                    cursor -= 1
            match current.problem
                Problem ignored
                    current.problem = ignored
                none
                    for int position < int(len(current.edges))
                        Edge original = current.edges[position]
                        int first = required_index(current.nodes, original.first)
                        int second = required_index(current.nodes, original.second)
                        current.edges[position] = Edge(first, second)
                    match current.path
                        Edge endpoints
                            int first = required_index(current.nodes, endpoints.first)
                            int second = required_index(current.nodes, endpoints.second)
                            current.path = Edge(first, second)
                        none
                            current.path = none
            result = result.append(current)
            continue
        bool skip = false
        match current.problem
            Problem ignored
                skip = true
            none
                skip = false
        if skip
            continue
        string | none reason = none
        if words[0] == "OPTION"
            if not change_setting(&current.settings, words[1], words[2])
                reason = "bad_option"
        elif words[0] == "NODE"
            int id = int.parse(words[1])
            if known(current.nodes, id)
                reason = "duplicate_node"
            elif len(current.nodes) == 40
                reason = "too_many_nodes"
            else
                current.nodes = current.nodes.append(Node(id, words[2]))
        else
            int first = int.parse(words[1])
            int second = int.parse(words[2])
            Edge edge = Edge(first, second)
            if not known(current.nodes, first) or not known(current.nodes, second)
                reason = "unknown_node"
            elif words[0] == "PATH"
                current.path = edge
            elif first == second
                current.loops += 1
            elif has(current.edges, edge)
                current.duplicates += 1
            else
                current.edges = current.edges.append(edge)
        match reason
            string kind
                current.problem = Problem(kind, line_index + 1)
            none
                current.problem = none
    return result
