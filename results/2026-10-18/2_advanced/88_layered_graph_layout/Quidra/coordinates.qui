import io = "./graph_io.qui"
import crossing = "./crossing.qui"

class Pair(int first, int second)
class Coordinates(int[] x, int[][] aligned, int[] blocks, int[] widths, int smallest, int conflicts, int[] left, int[] right)

Pair pair(int first, int second)
    return if first < second then Pair(first, second) else Pair(second, first)

int floor_half(int value)
    return if value < 0 and value % 2 != 0 then value / 2 - 1 else value / 2

int separation(int first, int second, const int[] left, const int[] right, int nodes, int node_sep, int dummy_sep)
    return right[first] + left[second] + 1 + (if first < nodes and second < nodes then node_sep else dummy_sep)

Coordinates assign(int nodes, const int[][] order, const int[] layer, const int[][] upper, const int[][] lower, const int[] width, bool vertical, int node_sep, int dummy_sep)
    int vertices = int(len(layer))
    int[] places = crossing.positions(order, vertices)
    int[] left = array(nat(vertices), fill = 0)
    int[] right = array(nat(vertices), fill = 0)
    for int vertex < vertices
        if vertical
            left[vertex] = (width[vertex] - 1) / 2
            right[vertex] = width[vertex] - 1 - left[vertex]
    Pair[] marked = []
    for int gap < int(len(order)) - 1
        int[] first_row = order[gap]
        int[] second_row = order[gap + 1]
        int boundary = 0
        int start = 0
        for int position < int(len(second_row))
            int vertex = second_row[position]
            bool inner = vertex >= nodes and upper[vertex][0] >= nodes
            if inner or position + 1 == int(len(second_row))
                int finish = if inner then places[upper[vertex][0]] else int(len(first_row)) - 1
                for start <= int cursor < position + 1
                    int lower_vertex = second_row[cursor]
                    for int upper_vertex = upper[lower_vertex][]
                        if places[upper_vertex] < boundary or places[upper_vertex] > finish
                            Pair entry = pair(upper_vertex, lower_vertex)
                            if not io.has(marked, entry)
                                marked = marked.append(entry)
                start = position + 1
                boundary = finish
    int[][] layouts = []
    int[] blocks = []
    int[] widths = []
    int[] lows = []
    int[] highs = []
    for int variant < 4
        bool down = variant >= 2
        bool right_scan = variant % 2 == 1
        int[] rank = places
        if right_scan
            for int vertex < vertices
                rank[vertex] = int(len(order[layer[vertex]])) - 1 - places[vertex]
        int[] root = []
        for int vertex < vertices
            root = root.append(vertex)
        int[] align = root
        int[] layer_order = []
        for int row < int(len(order))
            layer_order = layer_order.append(row)
        if down
            layer_order = layer_order[::-1]
        for 1 <= int row_index < int(len(layer_order))
            int row_number = layer_order[row_index]
            int[] scan = order[row_number]
            if right_scan
                scan = scan[::-1]
            int previous_rank = -1
            for int vertex = scan[]
                int[] reference = if down then lower[vertex] else upper[vertex]
                for int position < int(len(reference))
                    int cursor = position
                    while cursor > 0 and rank[reference[cursor]] < rank[reference[cursor - 1]]
                        int saved = reference[cursor]
                        reference[cursor] = reference[cursor - 1]
                        reference[cursor - 1] = saved
                        cursor -= 1
                if len(reference) == 0
                    continue
                int[] medians = [(int(len(reference)) - 1) / 2, int(len(reference)) / 2]
                for int median = medians[]
                    int neighbor = reference[median]
                    if align[vertex] == vertex and not io.has(marked, pair(neighbor, vertex)) and previous_rank < rank[neighbor]
                        align[neighbor] = vertex
                        root[vertex] = root[neighbor]
                        align[vertex] = root[vertex]
                        previous_rank = rank[neighbor]
        int[] roots = io.unique(root).sorted()
        blocks = blocks.append(int(len(roots)))
        int[][] constraints = array(nat(vertices), fill = array(nat(vertices), fill = -1))
        for int[] row = order[]
            int[] scan = if right_scan then row[::-1] else row
            for 1 <= int position < int(len(scan))
                int first = scan[position - 1]
                int second = scan[position]
                int delta = if right_scan then separation(second, first, left, right, nodes, node_sep, dummy_sep) else separation(first, second, left, right, nodes, node_sep, dummy_sep)
                constraints[root[first]][root[second]] = io.maximum(constraints[root[first]][root[second]], delta)
        int[] degree = array(nat(vertices), fill = 0)
        for int first = roots[]
            for int second = roots[]
                if constraints[first][second] >= 0
                    degree[second] += 1
        int[] topology = []
        bool[] processed = array(nat(vertices), fill = false)
        while len(topology) < len(roots)
            int chosen = -1
            for int vertex = roots[]
                if not processed[vertex] and degree[vertex] == 0
                    chosen = vertex
                    break
            processed[chosen] = true
            topology = topology.append(chosen)
            for int successor = roots[]
                if constraints[chosen][successor] >= 0
                    degree[successor] -= 1
        int[] first_y = array(nat(vertices), fill = 0)
        for int vertex = topology[]
            for int predecessor = roots[]
                int delta = constraints[predecessor][vertex]
                if delta >= 0
                    first_y[vertex] = io.maximum(first_y[vertex], first_y[predecessor] + delta)
        int[] second_y = first_y
        int[] backwards = topology[::-1]
        for int vertex = backwards[]
            int | none smallest = none
            for int successor = roots[]
                int delta = constraints[vertex][successor]
                if delta < 0
                    continue
                int candidate = second_y[successor] - delta
                match smallest
                    int old
                        smallest = io.minimum(old, candidate)
                    none
                        smallest = candidate
            match smallest
                int found
                    second_y[vertex] = io.maximum(first_y[vertex], found)
                none
                    second_y[vertex] = first_y[vertex]
        int[] layout = []
        int lo = 0
        int hi = 0
        for int vertex < vertices
            int value = if right_scan then -second_y[root[vertex]] else second_y[root[vertex]]
            layout = layout.append(value)
            lo = if vertex == 0 then value - left[vertex] else io.minimum(lo, value - left[vertex])
            hi = if vertex == 0 then value + right[vertex] else io.maximum(hi, value + right[vertex])
        layouts = layouts.append(layout)
        lows = lows.append(lo)
        highs = highs.append(hi)
        widths = widths.append(hi - lo + 1)
    int smallest = 0
    for 1 <= int variant < 4
        if widths[variant] < widths[smallest]
            smallest = variant
    for int variant < 4
        int delta = if variant % 2 == 0 then lows[smallest] - lows[variant] else highs[smallest] - highs[variant]
        for int vertex < vertices
            layouts[variant][vertex] += delta
    int[] x = []
    int low = 0
    for int vertex < vertices
        int[] values = [layouts[0][vertex], layouts[1][vertex], layouts[2][vertex], layouts[3][vertex]]
        values = values.sorted()
        int value = floor_half(values[1] + values[2])
        x = x.append(value)
        low = if vertex == 0 then value - left[vertex] else io.minimum(low, value - left[vertex])
    for int vertex < vertices
        x[vertex] -= low
    return Coordinates(x, layouts, blocks, widths, smallest, int(len(marked)), left, right)
