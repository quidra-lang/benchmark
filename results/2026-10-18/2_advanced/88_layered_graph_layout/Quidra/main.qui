import io = "./graph_io.qui"
import layering = "./acyclic_layering.qui"
import crossing = "./crossing.qui"
import coordinates = "./coordinates.qui"
import canvas = "./canvas.qui"

class Model(int[] layer, int[] width, int[][] chains, crossing.Segment[][] gaps, int[][] upper, int[][] lower, int[][] initial)
class Analysis(int sources, int sinks, int isolated, int components, int[][] scc)
class Reduction(int[][] order, string[] records, string[] csv, int initial, int swept, int run, int sweep)
class Key(int vertex, int numerator, int denominator)
class Bus(int low, int high, int side, int vertex, int x, int[] members)
class Geometry(int[] tracks, int[] gaps, int[][] offsets, int[] thickness, int[] starts, int main_length, int secondary_length)
class Drawing(canvas.Canvas picture, canvas.Cell[][] routes, int[] lengths, int[] bends)
class Processed(string[] layout, string[] stats, string[] csv, string[] drawings, int[] totals)

bool[][] reachability(int count, const io.Edge[] edges)
    bool[][] result = array(nat(count), fill = array(nat(count), fill = false))
    for int vertex < count
        result[vertex][vertex] = true
    for io.Edge edge = edges[]
        result[edge.first][edge.second] = true
    for int middle < count
        for int first < count
            for int second < count
                result[first][second] = result[first][second] or (result[first][middle] and result[middle][second])
    return result

Analysis analyze(const io.Graph graph)
    int count = int(len(graph.nodes))
    int[] incoming = array(nat(count), fill = 0)
    int[] outgoing = incoming
    for io.Edge edge = graph.edges[]
        outgoing[edge.first] += 1
        incoming[edge.second] += 1
    int sources = 0
    int sinks = 0
    int isolated = 0
    for int vertex < count
        if incoming[vertex] == 0 and outgoing[vertex] > 0
            sources += 1
        if outgoing[vertex] == 0 and incoming[vertex] > 0
            sinks += 1
        if incoming[vertex] == 0 and outgoing[vertex] == 0
            isolated += 1
    bool[] visited = array(nat(count), fill = false)
    int components = 0
    for int vertex < count
        if visited[vertex]
            continue
        components += 1
        int[] stack = [vertex]
        while len(stack) > 0
            int current = stack[int(len(stack)) - 1]
            stack = stack[0:<int(len(stack)) - 1]
            if visited[current]
                continue
            visited[current] = true
            for io.Edge edge = graph.edges[]
                if edge.first == current
                    stack = stack.append(edge.second)
                if edge.second == current
                    stack = stack.append(edge.first)
    bool[][] connected = reachability(count, graph.edges)
    bool[] assigned = array(nat(count), fill = false)
    int[][] scc = []
    for int vertex < count
        if assigned[vertex]
            continue
        int[] group = []
        for int other < count
            if not assigned[other] and connected[vertex][other] and connected[other][vertex]
                assigned[other] = true
                group = group.append(other)
        if len(group) > 1
            scc = scc.append(group)
    return Analysis(sources, sinks, isolated, components, scc)

void visit(int vertex, const int[] layer, const int[][] lower, bool[] &visited, int[][] &order)
    if visited[vertex]
        return
    visited[vertex] = true
    order[layer[vertex]] = order[layer[vertex]].append(vertex)
    for int successor = lower[vertex][]
        visit(successor, layer, lower, &visited, &order)

Model build_model(const io.Graph graph, const int[] heights, const io.Edge[] dag, const bool[] removed)
    int nodes = int(len(graph.nodes))
    int highest = heights[0]
    for int value = heights[]
        highest = io.maximum(highest, value)
    int[] raw = []
    for int value = heights[]
        raw = raw.append(highest - value)
    int[] used = io.unique(raw)
    for int edge_index < int(len(dag))
        if not removed[edge_index]
            io.Edge edge = dag[edge_index]
            for raw[edge.first] + 1 <= int level < raw[edge.second]
                used = io.unique(used.append(level))
    used = used.sorted()
    int[] layer = []
    for int value = raw[]
        for int position < int(len(used))
            if used[position] == value
                layer = layer.append(position)
                break
    int[] width = []
    for io.Node node = graph.nodes[]
        width = width.append(int(len(node.label)) + 2)
    int[][] chains = array(len(graph.edges), fill = [])
    for int edge_index < int(len(dag))
        if removed[edge_index]
            continue
        io.Edge edge = dag[edge_index]
        int[] chain = [edge.first]
        for layer[edge.first] + 1 <= int level < layer[edge.second]
            chain = chain.append(int(len(layer)))
            layer = layer.append(level)
            width = width.append(1)
        chains[edge_index] = chain.append(edge.second)
    crossing.Segment[][] gaps = array(nat(int(len(used)) - 1), fill = [])
    int[][] upper = array(len(layer), fill = [])
    int[][] lower = upper
    for int edge_index < int(len(chains))
        int[] chain = chains[edge_index]
        for 1 <= int position < int(len(chain))
            int first = chain[position - 1]
            int second = chain[position]
            gaps[layer[first]] = gaps[layer[first]].append(crossing.Segment(first, second, edge_index))
            upper[second] = upper[second].append(first)
            lower[first] = lower[first].append(second)
    int[][] initial = array(len(used), fill = [])
    bool[] visited = array(len(layer), fill = false)
    for int vertex < nodes
        visit(vertex, layer, lower, &visited, &initial)
    return Model(layer, width, chains, gaps, upper, lower, initial)

Key reorder_key(int vertex, const int[][] reference, const int[] places, bool median)
    int[] values = []
    for int neighbor = reference[vertex][]
        values = values.append(places[neighbor])
    values = values.sorted()
    if median
        return Key(vertex, values[(int(len(values)) - 1) / 2] + values[int(len(values)) / 2], 1)
    int total = 0
    for int value = values[]
        total += value
    return Key(vertex, total, int(len(values)))

int[] insert_vertex(const int[] source, int position, int vertex)
    int[] result = []
    for int cursor < int(len(source)) + 1
        if cursor == position
            result = result.append(vertex)
        if cursor < int(len(source))
            result = result.append(source[cursor])
    return result

Reduction reduce_crossings(const io.Graph graph, const Model model)
    int vertices = int(len(model.layer))
    int random_state = graph.settings.integer("seed")
    string[] records = []
    string[] csv = []
    int[][] adopted = model.initial
    int best_count = 2147483647
    int best_run = 0
    int best_sweep = 0
    int initial = 0
    for int run < graph.settings.integer("restarts") + 1
        int[][] order = model.initial
        if run > 0
            for int row < int(len(order))
                int cursor = int(len(order[row])) - 1
                while cursor > 0
                    random_state = 48271 * random_state % 2147483647
                    int selected = random_state % (cursor + 1)
                    int saved = order[row][cursor]
                    order[row][cursor] = order[row][selected]
                    order[row][selected] = saved
                    cursor -= 1
        int current_count = crossing.total(model.gaps, order, vertices)
        if run == 0
            initial = current_count
        int run_count = current_count
        int run_sweep = 0
        int[][] run_order = order
        int[][][] history = [order]
        int[] counts = [current_count]
        records = records.append("sweep {run} 0 initial crossings {current_count}")
        csv = csv.append("{graph.name},{run},0,{current_count}")
        for 1 <= int sweep < graph.settings.integer("sweeps") + 1
            int last = sweep - 1
            if counts[last] == 0 or (last >= 2 and history[last] == history[last - 2])
                break
            int[] old = crossing.positions(order, vertices)
            bool down = sweep % 2 == 1
            int[] row_order = []
            if down
                for 1 <= int row < int(len(order))
                    row_order = row_order.append(row)
            else
                int row = int(len(order)) - 2
                while row >= 0
                    row_order = row_order.append(row)
                    row -= 1
            int[][] reference = if down then model.upper else model.lower
            for int row = row_order[]
                int[] places = crossing.positions(order, vertices)
                Key[] moving = []
                for int vertex = order[row][]
                    if len(reference[vertex]) > 0
                        moving = moving.append(reorder_key(vertex, reference, places, graph.settings.text("heuristic") == "median"))
                for int position < int(len(moving))
                    int cursor = position
                    while cursor > 0
                        Key left = moving[cursor]
                        Key right = moving[cursor - 1]
                        if left.numerator * right.denominator >= right.numerator * left.denominator
                            break
                        moving[cursor] = right
                        moving[cursor - 1] = left
                        cursor -= 1
                int next = 0
                for int position < int(len(order[row]))
                    if len(reference[order[row][position]]) > 0
                        order[row][position] = moving[next].vertex
                        next += 1
            int[] places = crossing.positions(order, vertices)
            int moved = 0
            for int vertex < vertices
                if places[vertex] != old[vertex]
                    moved += 1
            int swaps = 0
            while true
                bool changed = false
                for int row < int(len(order))
                    for int position < int(len(order[row])) - 1
                        int first = order[row][position]
                        int second = order[row][position + 1]
                        if crossing.adjacent(first, second, model.upper, model.lower, places) > crossing.adjacent(second, first, model.upper, model.lower, places)
                            order[row][position] = second
                            order[row][position + 1] = first
                            places[first] = position + 1
                            places[second] = position
                            swaps += 1
                            changed = true
                if not changed
                    break
            current_count = crossing.total(model.gaps, order, vertices)
            history = history.append(order)
            counts = counts.append(current_count)
            string direction = if down then "down" else "up"
            records = records.append("sweep {run} {sweep} {direction} moved {moved} swaps {swaps} crossings {current_count}")
            csv = csv.append("{graph.name},{run},{sweep},{current_count}")
            if current_count < run_count
                run_count = current_count
                run_sweep = sweep
                run_order = order
        if run_count < best_count
            best_count = run_count
            best_run = run
            best_sweep = run_sweep
            adopted = run_order
    records = records.append("best run {best_run} sweep {best_sweep} crossings {best_count}")
    if graph.settings.on("sifting")
        int round = 0
        while true
            round += 1
            int moves = 0
            for int vertex < vertices
                int row = model.layer[vertex]
                int old = 0
                int[] base = []
                for int position < int(len(adopted[row]))
                    if adopted[row][position] == vertex
                        old = position
                    else
                        base = base.append(adopted[row][position])
                int[] costs = []
                int minimum_cost = 2147483647
                for int position < int(len(base)) + 1
                    adopted[row] = insert_vertex(base, position, vertex)
                    int value = crossing.total(model.gaps, adopted, vertices)
                    costs = costs.append(value)
                    minimum_cost = io.minimum(minimum_cost, value)
                int chosen = old
                if costs[old] != minimum_cost
                    for int position < int(len(costs))
                        if costs[position] == minimum_cost
                            chosen = position
                            break
                adopted[row] = insert_vertex(base, chosen, vertex)
                if chosen != old
                    moves += 1
            records = records.append("sift {round} moves {moves} crossings {crossing.total(model.gaps, adopted, vertices)}")
            if moves == 0
                break
    return Reduction(adopted, records, csv, initial, best_count, best_run, best_sweep)

Geometry geometry(const io.Graph graph, const Model model, const int[][] order, const coordinates.Coordinates placement)
    int[] tracks = []
    int[] gaps = []
    int[][] offsets = []
    for crossing.Segment[] segments = model.gaps[]
        int[] bent_counts = array(len(model.layer), fill = 0)
        for crossing.Segment segment = segments[]
            if placement.x[segment.upper] != placement.x[segment.lower]
                bent_counts[segment.upper] += 1
        Bus[] buses = []
        for int segment_index < int(len(segments))
            crossing.Segment segment = segments[segment_index]
            int first_x = placement.x[segment.upper]
            int second_x = placement.x[segment.lower]
            if first_x == second_x
                continue
            int side = if bent_counts[segment.upper] >= 2 then 0 else 1
            int vertex = if side == 0 then segment.upper else segment.lower
            int low = io.minimum(first_x, second_x)
            int high = io.maximum(first_x, second_x)
            int bus_index = -1
            for int position < int(len(buses))
                if buses[position].side == side and buses[position].vertex == vertex
                    bus_index = position
                    break
            if bus_index < 0
                buses = buses.append(Bus(low, high, side, vertex, placement.x[vertex], [segment_index]))
            else
                buses[bus_index].low = io.minimum(buses[bus_index].low, low)
                buses[bus_index].high = io.maximum(buses[bus_index].high, high)
                buses[bus_index].members = buses[bus_index].members.append(segment_index)
        for int position < int(len(buses))
            int cursor = position
            while cursor > 0
                Bus first = buses[cursor]
                Bus second = buses[cursor - 1]
                if io.compare([first.low, first.high, first.side, first.x], [second.low, second.high, second.side, second.x]) >= 0
                    break
                buses[cursor] = second
                buses[cursor - 1] = first
                cursor -= 1
        int[] ends = []
        int[] assignments = array(len(segments), fill = -1)
        for Bus bus = buses[]
            int track = -1
            for int position < int(len(ends))
                if ends[position] + 1 < bus.low
                    track = position
                    break
            if track < 0
                track = int(len(ends))
                ends = ends.append(bus.high)
            else
                ends[track] = bus.high
            for int member = bus.members[]
                assignments[member] = track + 1
        int gap = io.maximum(graph.settings.integer("layer_gap"), int(len(ends)) + 2)
        for int position < int(len(assignments))
            if assignments[position] >= 0
                assignments[position] += (gap - 2 - int(len(ends))) / 2
        tracks = tracks.append(int(len(ends)))
        gaps = gaps.append(gap)
        offsets = offsets.append(assignments)
    string direction = graph.settings.text("direction")
    bool vertical = direction == "TB" or direction == "BT"
    int[] thickness = []
    for int[] row = order[]
        int value = 1
        if not vertical
            for int vertex = row[]
                value = io.maximum(value, model.width[vertex])
        thickness = thickness.append(value)
    int[] starts = array(len(order), fill = 0)
    for 1 <= int row < int(len(order))
        starts[row] = starts[row - 1] + thickness[row - 1] + gaps[row - 1]
    int main_length = starts[int(len(starts)) - 1] + thickness[int(len(thickness)) - 1]
    int secondary_length = 0
    for int vertex < int(len(model.layer))
        secondary_length = io.maximum(secondary_length, placement.x[vertex] + placement.right[vertex] + 1)
    return Geometry(tracks, gaps, offsets, thickness, starts, main_length, secondary_length)

int[] | none shortest_path(const io.Graph graph, const bool[] removed)
    match graph.path
        io.Edge endpoints
            int[] parent = array(len(graph.nodes), fill = -1)
            bool[] visited = array(len(graph.nodes), fill = false)
            visited[endpoints.first] = true
            int[] queue = [endpoints.first]
            int position = 0
            while position < int(len(queue))
                int vertex = queue[position]
                position += 1
                int[] neighbors = []
                for int edge_index < int(len(graph.edges))
                    if not removed[edge_index] and graph.edges[edge_index].first == vertex
                        neighbors = neighbors.append(graph.edges[edge_index].second)
                neighbors = neighbors.sorted()
                for int neighbor = neighbors[]
                    if not visited[neighbor]
                        visited[neighbor] = true
                        parent[neighbor] = vertex
                        queue = queue.append(neighbor)
            if not visited[endpoints.second]
                return none
            int current = endpoints.second
            int[] path = [current]
            while current != endpoints.first
                current = parent[current]
                path = path.append(current)
            return path[::-1]
        none
            return none

Drawing draw(const io.Graph graph, const Model model, const coordinates.Coordinates placement, const Geometry shape, const bool[] reversed, const bool[] removed, const int[] | none path)
    string direction = graph.settings.text("direction")
    bool vertical = direction == "TB" or direction == "BT"
    canvas.Canvas picture = canvas.Canvas(shape.main_length, shape.secondary_length, direction)
    for int vertex < int(len(model.layer))
        int row = model.layer[vertex]
        if vertex >= int(len(graph.nodes))
            for int position < shape.thickness[row]
                canvas.line(&picture, shape.starts[row] + position, placement.x[vertex], true)
        elif not vertical and len(model.lower[vertex]) > 0
            for model.width[vertex] <= int position < shape.thickness[row]
                canvas.line(&picture, shape.starts[row] + position, placement.x[vertex], true)
    for int gap_index < int(len(model.gaps))
        int start = shape.starts[gap_index] + shape.thickness[gap_index]
        int gap = shape.gaps[gap_index]
        crossing.Segment[] segments = model.gaps[gap_index]
        for int segment_index < int(len(segments))
            crossing.Segment segment = segments[segment_index]
            int first_x = placement.x[segment.upper]
            int second_x = placement.x[segment.lower]
            int offset = shape.offsets[gap_index][segment_index]
            if offset >= 0
                for int position < offset
                    canvas.line(&picture, start + position, first_x, true)
                canvas.corner(&picture, start + offset, first_x)
                canvas.corner(&picture, start + offset, second_x)
                for io.minimum(first_x, second_x) + 1 <= int secondary < io.maximum(first_x, second_x)
                    canvas.line(&picture, start + offset, secondary, false)
                for offset + 1 <= int position < gap
                    canvas.line(&picture, start + position, second_x, true)
            else
                for int position < gap
                    canvas.line(&picture, start + position, first_x, true)
    canvas.Cell[][] routes = array(len(graph.edges), fill = [])
    int[] lengths = array(len(graph.edges), fill = 0)
    int[] bends = lengths
    for int edge_index < int(len(model.chains))
        if removed[edge_index]
            continue
        int[] chain = model.chains[edge_index]
        int first = chain[0]
        int second = chain[int(len(chain)) - 1]
        int upper_main = shape.starts[model.layer[first]] + (if vertical then 1 else model.width[first])
        int lower_main = shape.starts[model.layer[second]] - 1
        canvas.Cell[] points = [canvas.map_cell(picture, upper_main, placement.x[first])]
        for 1 <= int position < int(len(chain))
            int upper_vertex = chain[position - 1]
            int lower_vertex = chain[position]
            int gap_index = model.layer[upper_vertex]
            int offset = -1
            for int segment_index < int(len(model.gaps[gap_index]))
                crossing.Segment segment = model.gaps[gap_index][segment_index]
                if segment.upper == upper_vertex and segment.lower == lower_vertex
                    offset = shape.offsets[gap_index][segment_index]
                    break
            if offset >= 0
                int main_coordinate = shape.starts[gap_index] + shape.thickness[gap_index] + offset
                points = points.append(canvas.map_cell(picture, main_coordinate, placement.x[upper_vertex]))
                points = points.append(canvas.map_cell(picture, main_coordinate, placement.x[lower_vertex]))
                bends[edge_index] += 2
        points = points.append(canvas.map_cell(picture, lower_main, placement.x[second]))
        if reversed[edge_index]
            points = points[::-1]
            canvas.arrow(&picture, upper_main, placement.x[first], true)
        else
            canvas.arrow(&picture, lower_main, placement.x[second], false)
        int length = 1
        for 1 <= int position < int(len(points))
            length += io.absolute(points[position].row - points[position - 1].row) + io.absolute(points[position].column - points[position - 1].column)
        lengths[edge_index] = length
        routes[edge_index] = points
    int[] on_path = []
    match path
        int[] found
            on_path = found
            for 1 <= int position < int(len(found))
                int edge_index = 0
                while graph.edges[edge_index] != io.Edge(found[position - 1], found[position])
                    edge_index += 1
                canvas.Cell[] points = routes[edge_index]
                for 1 <= int point_index < int(len(points))
                    canvas.Cell first = points[point_index - 1]
                    canvas.Cell second = points[point_index]
                    if first.row == second.row
                        for io.minimum(first.column, second.column) <= int column < io.maximum(first.column, second.column) + 1
                            canvas.highlight(&picture, first.row, column)
                    else
                        for io.minimum(first.row, second.row) <= int row < io.maximum(first.row, second.row) + 1
                            canvas.highlight(&picture, row, first.column)
        none
            on_path = []
    for int vertex < int(len(graph.nodes))
        int row = model.layer[vertex]
        bool highlighted = io.has(on_path, vertex)
        string text = (if highlighted then "{{" else "[") + graph.nodes[vertex].label + (if highlighted then "}}" else "]")
        canvas.Cell cell = if vertical then canvas.map_cell(picture, shape.starts[row], placement.x[vertex] - placement.left[vertex]) elif direction == "LR" then canvas.Cell(placement.x[vertex], shape.starts[row]) else canvas.Cell(placement.x[vertex], shape.main_length - shape.starts[row] - model.width[vertex])
        canvas.label(&picture, cell.row, cell.column, text)
    return Drawing(picture, routes, lengths, bends)

string node_name(const io.Graph graph, int vertex)
    return if vertex < int(len(graph.nodes)) then graph.nodes[vertex].id.string() else "d{vertex - int(len(graph.nodes)) + 1}"

string edge_name(const io.Graph graph, int edge_index)
    io.Edge edge = graph.edges[edge_index]
    return "{node_name(graph, edge.first)}->{node_name(graph, edge.second)}"

string[] node_names(const io.Graph graph, const int[] vertices)
    string[] result = []
    for int vertex = vertices[]
        result = result.append(node_name(graph, vertex))
    return result

Processed process_graph(const io.Graph graph)
    int nodes = int(len(graph.nodes))
    Analysis analysis = analyze(graph)
    int[] sequence = layering.sequence(nodes, graph.edges)
    int[] places = array(nat(nodes), fill = 0)
    for int position < int(len(sequence))
        places[sequence[position]] = position
    bool[] reversed = []
    io.Edge[] dag = []
    for io.Edge edge = graph.edges[]
        bool reverse = places[edge.first] > places[edge.second]
        reversed = reversed.append(reverse)
        dag = dag.append(if reverse then io.Edge(edge.second, edge.first) else edge)
    bool[][] reachable = reachability(nodes, dag)
    bool[] removed = array(len(dag), fill = false)
    io.Edge[] drawn = []
    for int edge_index < int(len(dag))
        io.Edge edge = dag[edge_index]
        if graph.settings.on("reduce") and not reversed[edge_index]
            for io.Edge other = dag[]
                if other.first == edge.first and other.second != edge.second and reachable[other.second][edge.second]
                    removed[edge_index] = true
        if not removed[edge_index]
            drawn = drawn.append(edge)
    layering.Layering levels = layering.assign(nodes, drawn, graph.settings.text("layering") == "coffman", graph.settings.integer("width"), graph.settings.on("promotion"))
    Model model = build_model(graph, levels.heights, dag, removed)
    Reduction reduced = reduce_crossings(graph, model)
    string direction = graph.settings.text("direction")
    coordinates.Coordinates placement = coordinates.assign(nodes, reduced.order, model.layer, model.upper, model.lower, model.width, direction == "TB" or direction == "BT", graph.settings.integer("node_sep"), graph.settings.integer("dummy_sep"))
    Geometry shape = geometry(graph, model, reduced.order, placement)
    int[] | none path = shortest_path(graph, removed)
    Drawing drawing = draw(graph, model, placement, shape, reversed, removed, path)
    int vertices = int(len(model.layer))
    int[] positions = crossing.positions(reduced.order, vertices)
    int[] counts = []
    int final_count = 0
    int brute = 0
    int[] edge_crossings = array(len(graph.edges), fill = 0)
    for int gap_index < int(len(model.gaps))
        crossing.Segment[] segments = model.gaps[gap_index]
        int value = crossing.count(segments, positions, int(len(reduced.order[gap_index + 1])))
        counts = counts.append(value)
        final_count += value
        brute += crossing.brute(segments, positions)
        for int first < int(len(segments))
            for first + 1 <= int second < int(len(segments))
                if crossing.crosses(segments[first], segments[second], positions)
                    edge_crossings[segments[first].edge] += 1
                    edge_crossings[segments[second].edge] += 1
    string[] settings_words = []
    string[] names = io.setting_names()
    for int position < int(len(names))
        settings_words = settings_words.append("{names[position]}={graph.settings.values[position]}")
    string[] sequence_names = node_names(graph, sequence)
    string[] layout = ["graph {graph.name}", "settings {settings_words.join(" ")}", "acyclic {sequence_names.join(" ")}"]
    if graph.settings.text("layering") == "coffman"
        string[] labels = []
        for int vertex < nodes
            labels = labels.append("{node_name(graph, vertex)}:{levels.labels[vertex]}")
        layout = layout.append("labels {labels.join(" ")}")
    for layering.Promotion entry = levels.promotions[]
        layout = layout.append("promote {entry.round} {node_name(graph, entry.vertex)} {entry.diff}")
    layout = layout.concat(reduced.records)
    for int row < int(len(reduced.order))
        int start = shape.starts[row]
        int finish = start + shape.thickness[row] - 1
        bool backwards = direction == "BT" or direction == "RL"
        int band_low = if backwards then shape.main_length - 1 - finish else start
        int band_high = if backwards then shape.main_length - 1 - start else finish
        int[] ordered = reduced.order[row]
        int low = placement.x[ordered[0]] - placement.left[ordered[0]]
        int high = placement.x[ordered[0]] + placement.right[ordered[0]]
        string[] labels = []
        for int vertex = ordered[]
            low = io.minimum(low, placement.x[vertex] - placement.left[vertex])
            high = io.maximum(high, placement.x[vertex] + placement.right[vertex])
            labels = labels.append("{node_name(graph, vertex)}@{placement.x[vertex]}")
        layout = layout.append("layer {row} band {band_low} {band_high} extent {low} {high} : {labels.join(" ")}")
    for int gap_index < int(len(model.gaps))
        layout = layout.append("between {gap_index} {gap_index + 1} segments {len(model.gaps[gap_index])} crossings {counts[gap_index]} tracks {shape.tracks[gap_index]} gap {shape.gaps[gap_index]}")
    string[] variants = ["ul", "ur", "dl", "dr"]
    string[] variants_text = []
    for int variant < 4
        variants_text = variants_text.append("{variants[variant]}={placement.blocks[variant]}/{placement.widths[variant]}")
    layout = layout.append("bk conflicts {placement.conflicts} {variants_text.join(" ")} smallest {variants[placement.smallest]}")
    for int[] row = reduced.order[]
        for int vertex = row[]
            layout = layout.append("vertex {node_name(graph, vertex)} layer {model.layer[vertex]} pos {positions[vertex]} ul {placement.aligned[0][vertex]} ur {placement.aligned[1][vertex]} dl {placement.aligned[2][vertex]} dr {placement.aligned[3][vertex]} x {placement.x[vertex]}")
    for int edge_index < int(len(graph.edges))
        io.Edge edge = graph.edges[edge_index]
        string prefix = "edge {node_name(graph, edge.first)} {node_name(graph, edge.second)}"
        if removed[edge_index]
            layout = layout.append("{prefix} transitive")
        else
            int[] chain = if reversed[edge_index] then model.chains[edge_index][::-1] else model.chains[edge_index]
            string[] path_words = []
            for int vertex = chain[]
                path_words = path_words.append(placement.x[vertex].string())
            string[] route_words = []
            for canvas.Cell cell = drawing.routes[edge_index][]
                route_words = route_words.append("{cell.row},{cell.column}")
            string reversal = if reversed[edge_index] then " reversed" else ""
            layout = layout.append("{prefix}{reversal} span {int(len(chain)) - 1} crossings {edge_crossings[edge_index]} bends {drawing.bends[edge_index]} path {path_words.join(" ")} route {route_words.join(" ")}")
    layout = layout.append("end")
    string[] stats = ["graph {graph.name}", "nodes {nodes} edges {len(graph.edges)} self_loops {graph.loops} duplicates {graph.duplicates}", "sources {analysis.sources} sinks {analysis.sinks} isolated {analysis.isolated} components {analysis.components}"]
    for int[] component = analysis.scc[]
        string[] labels = node_names(graph, component)
        stats = stats.append("scc {labels.join(" ")}")
    for int kind < 2
        bool[] flags = if kind == 0 then reversed else removed
        string label = if kind == 0 then "reversed" else "transitive"
        string[] labels = []
        for int edge_index < int(len(graph.edges))
            if flags[edge_index]
                labels = labels.append(edge_name(graph, edge_index))
        string suffix = if len(labels) == 0 then "" else " {labels.join(" ")}"
        stats = stats.append("{label} {len(labels)}{suffix}")
    int max_nodes = 0
    int max_vertices = 0
    for int[] row = reduced.order[]
        int node_count = 0
        for int vertex = row[]
            if vertex < nodes
                node_count += 1
        max_nodes = io.maximum(max_nodes, node_count)
        max_vertices = io.maximum(max_vertices, int(len(row)))
    stats = stats.append("layers {len(reduced.order)} max_nodes {max_nodes} max_vertices {max_vertices}")
    if graph.settings.on("promotion")
        stats = stats.append("promotion rounds {levels.rounds} accepted {len(levels.promotions)} dummies_before {levels.before}")
    else
        stats = stats.append("promotion off")
    int[] spans = array(len(reduced.order), fill = 0)
    int span_total = 0
    int span_max = 0
    int long_edges = 0
    int vertical_edges = 0
    for int[] chain = model.chains[]
        if len(chain) == 0
            continue
        int span = int(len(chain)) - 1
        spans[span] += 1
        span_total += span
        span_max = io.maximum(span_max, span)
        if span >= 2
            long_edges += 1
            bool equal = true
            for 1 <= int position < int(len(chain)) - 1
                if placement.x[chain[position]] != placement.x[chain[1]]
                    equal = false
            if equal
                vertical_edges += 1
    stats = stats.append("dummies {vertices - nodes} span_total {span_total} span_max {span_max}")
    string[] span_words = []
    for int span < int(len(spans))
        if spans[span] > 0
            span_words = span_words.append("{span}:{spans[span]}")
    stats = stats.append("spans " + (if len(span_words) == 0 then "none" else span_words.join(" ")))
    stats = stats.append("long_edges {long_edges} vertical {vertical_edges}")
    stats = stats.append("crossings initial {reduced.initial} swept {reduced.swept} best_run {reduced.run} best_sweep {reduced.sweep} final {final_count} brute {brute}")
    int segment_count = 0
    int straight = 0
    int offset = 0
    for crossing.Segment[] gap = model.gaps[]
        for crossing.Segment segment = gap[]
            segment_count += 1
            int distance = io.absolute(placement.x[segment.upper] - placement.x[segment.lower])
            offset += distance
            if distance == 0
                straight += 1
    stats = stats.append("segments {segment_count} straight {straight} bent {segment_count - straight} offset {offset}")
    int route_length = 0
    int bends = 0
    int longest = -1
    for int edge_index < int(len(graph.edges))
        route_length += drawing.lengths[edge_index]
        bends += drawing.bends[edge_index]
        if not removed[edge_index] and (longest < 0 or drawing.lengths[edge_index] > drawing.lengths[longest])
            longest = edge_index
    string longest_text = if longest < 0 then "" else " longest {edge_name(graph, longest)} {drawing.lengths[longest]}"
    stats = stats.append("routes length {route_length} bends {bends}{longest_text}")
    stats = stats.append("canvas width {drawing.picture.columns} height {drawing.picture.rows} crossing_cells {canvas.crossings(drawing.picture)}")
    match graph.path
        io.Edge endpoints
            match path
                int[] found
                    string[] labels = node_names(graph, found)
                    stats = stats.append("path {node_name(graph, endpoints.first)} {node_name(graph, endpoints.second)} hops {int(len(found)) - 1} : {labels.join(" ")}")
                none
                    stats = stats.append("path {node_name(graph, endpoints.first)} {node_name(graph, endpoints.second)} none")
        none
            stats = stats
    stats = stats.append("end")
    string[] drawings = ["graph {graph.name} {drawing.picture.columns}x{drawing.picture.rows}"]
    drawings = drawings.concat(canvas.report(drawing.picture))
    return Processed(layout, stats, reduced.csv, drawings, [nodes, int(len(graph.edges)), vertices - nodes, reduced.initial, final_count])

void write_output(string name, const string[] lines)
    bool exists = file.is_directory("output")
    if not exists
        file.mkdir("output")
    string text = if len(lines) == 0 then "" else lines.join(NL) + NL
    file.write("output/{name}", text)

void run_program()
    io.Graph[] graphs = io.read_graphs()
    string[] layout = []
    string[] stats = []
    string[] drawings = []
    string[] csv = ["graph,run,sweep,crossings"]
    int[] totals = [0, 0, 0, 0, 0]
    int errors = 0
    for io.Graph graph = graphs[]
        if len(drawings) > 0
            drawings = drawings.append("")
        match graph.problem
            io.Problem problem
                errors += 1
                string[] block = ["graph {graph.name}", "error {problem.kind} line {problem.line}", "end"]
                layout = layout.concat(block)
                stats = stats.concat(block)
                drawings = drawings.append("graph {graph.name} error {problem.kind}")
            none
                Processed output = process_graph(graph)
                layout = layout.concat(output.layout)
                stats = stats.concat(output.stats)
                csv = csv.concat(output.csv)
                drawings = drawings.concat(output.drawings)
                for int position < 5
                    totals[position] += output.totals[position]
    stats = stats.append("summary graphs {len(graphs)} laid_out {int(len(graphs)) - errors} errors {errors} nodes {totals[0]} edges {totals[1]} dummies {totals[2]} crossings_initial {totals[3]} crossings_final {totals[4]}")
    write_output("layout.txt", layout)
    write_output("stats.txt", stats)
    write_output("crossings.csv", csv)
    write_output("drawings.txt", drawings)

if main
    run_program()
