import line = "./line_solver.qui"
import clues = "./clues.qui"
import propagation = "./propagation.qui"
import search = "./search.qui"
import render = "./render.qui"

string[][] read_blocks(string path)
    string text = file.read(path)
    string[][] result = []
    string[] current = []
    bool inside = false
    for string row = text.split(NL)[]
        if not inside
            if row != "" and row[0] != "#"
                current = [row]
                inside = true
        elif row == "END"
            result = result.append(current)
            current = []
            inside = false
        else
            current = current.append(row)
    return result

bool valid_name(string name)
    if len(name) < 1 or len(name) > 20
        return false
    for int point = name.codepoints()[]
        if not (97 <= point <= 122 or 48 <= point <= 57 or point == 95)
            return false
    return true

string number_list(int[] numbers)
    if len(numbers) == 0
        return "-"
    string[] values = []
    for int number = numbers[]
        values = values.append(number.string())
    return values.join(",")

string cell_text(int row, int column)
    return "{row + 1},{column + 1}"

int[][] state_grid(string[] texts)
    int[][] result = []
    for string text = texts[]
        int[] row = []
        for nat index < len(text)
            row = row.append(render.char_state(text[index]))
        result = result.append(row)
    return result

int[][] grid_columns(int[][] grid)
    int[][] result = []
    for nat column < len(grid[0])
        result = result.append(propagation.line_cells(grid, false, int(column)))
    return result

search.Cell[] differing_cells(int[][] first, int[][] second)
    search.Cell[] result = []
    for nat row < len(first)
        for nat column < len(first[row])
            if first[row][column] != second[row][column]
                result = result.append(search.Cell(int(row), int(column)))
    return result

class Given(int row, int column, int state)

class RawGiven(int row, int column, string value)

class CheckedClues(int[][] values, string problem)

CheckedClues check_clues(string[] texts, string kind, int length)
    int[][] result = []
    for nat index < len(texts)
        match clues.parse_clue(texts[index])
            int[] clue
                if not clues.fits(clue, length)
                    return CheckedClues([], "{kind} {index + 1} too long")
                result = result.append(clue)
            none
                return CheckedClues([], "bad clue {kind} {index + 1}")
    return CheckedClues(result, "")

class Puzzle(local string[] texts)
    string name = texts[0][7:<len(texts[0])]
    local string[] dimensions = texts[1].split(" ")
    int width = int.parse(dimensions[1])
    int height = int.parse(dimensions[2])
    local int columns_at = 3
    while texts[columns_at] != "COLUMNS"
        columns_at += 1
    string[] row_lines = texts[3:<columns_at]
    string[] column_lines = []
    RawGiven[] given_lines = []
    local int position = columns_at + 1
    while position < int(len(texts)) and clues.is_clue_line(texts[position])
        column_lines = column_lines.append(texts[position])
        position += 1
    while position < int(len(texts)) and texts[position].starts_with("GIVEN ")
        string[] parts = texts[position].split(" ")
        given_lines = given_lines.append(RawGiven(int.parse(parts[1]), int.parse(parts[2]), parts[3]))
        position += 1
    bool answer_present = position < int(len(texts))
    string[] answer_lines = if answer_present then texts[position + 1:<len(texts)] else []
    int[][] row_clues = []
    int[][] column_clues = []
    Given[] givens = []
    int[][] answer = []

    string .validate(map.Map<string, int> earlier)
        if not valid_name(name)
            return "bad name"
        if earlier.has(name)
            return "duplicate name"
        if width < 1 or width > 30 or height < 1 or height > 30
            return "bad size"
        if int(len(row_lines)) != height
            return "row count {len(row_lines)} expected {height}"
        if int(len(column_lines)) != width
            return "column count {len(column_lines)} expected {width}"
        CheckedClues rows = check_clues(row_lines, "row", width)
        if rows.problem != ""
            return rows.problem
        row_clues = rows.values
        CheckedClues columns = check_clues(column_lines, "column", height)
        if columns.problem != ""
            return columns.problem
        column_clues = columns.values
        int row_total = 0
        int column_total = 0
        for int[] clue = row_clues[]
            row_total += clues.total(clue)
        for int[] clue = column_clues[]
            column_total += clues.total(clue)
        if row_total != column_total
            return "total mismatch rows={row_total} columns={column_total}"
        map.Map<string, int> taken
        for nat index < len(given_lines)
            RawGiven given = given_lines[index]
            if given.row < 1 or given.row > height or given.column < 1 or given.column > width or (given.value != "#" and given.value != ".")
                return "bad given {index + 1}"
            string key = "{given.row},{given.column}"
            if taken.has(key)
                return "duplicate given {index + 1}"
            .taken.set(key, 1)
            givens = givens.append(Given(given.row - 1, given.column - 1, render.char_state(given.value)))
        if answer_present
            if int(len(answer_lines)) != height
                return "bad answer"
            for string text = answer_lines[]
                if int(len(text)) != width
                    return "bad answer"
                for nat index < len(text)
                    if text[index] != "#" and text[index] != "." and text[index] != "?"
                        return "bad answer"
            answer = state_grid(answer_lines)
        return ""

class Picture(local string[] texts)
    string name = texts[0][8:<len(texts[0])]
    string[] rows = texts[1:<len(texts)]

    string validate(map.Map<string, int> earlier)
        if not valid_name(name)
            return "bad name"
        if earlier.has(name)
            return "duplicate name"
        if len(rows) < 1 or len(rows) > 30
            return "bad height"
        for nat index < len(rows)
            string text = rows[index]
            if len(text) < 1 or len(text) > 30 or len(text) != len(rows[0])
                return "bad row {index + 1}"
            for nat position < len(text)
                if text[position] != "#" and text[position] != "."
                    return "bad row {index + 1}"
        return ""

class Logical(int[][] grid, propagation.Result details, string result)

Logical logical_solve(int[][] row_clues, int[][] column_clues, Given[] givens, bool precise)
    int[][] grid = []
    for nat row < len(row_clues)
        grid = grid.append(array(len(column_clues), fill = line.UNKNOWN))
    for Given given = givens[]
        grid[given.row][given.column] = given.state
    propagation.Result details = propagation.propagate(&grid, row_clues, column_clues, precise, array(len(row_clues), fill = true), array(len(column_clues), fill = true))
    string result = if details.contradiction then "contradiction at=" + details.conflict.label() elif propagation.determined_count(grid) == int(len(row_clues) * len(column_clues)) then "solved" else "stuck"
    return Logical(grid, details, result)

class Analysis(int[][] row_clues, int[][] column_clues, local Given[] givens)
    Logical simple = logical_solve(row_clues, column_clues, givens, false)
    Logical logic = logical_solve(row_clues, column_clues, givens, true)
    search.Search search_result = search.Search(row_clues, column_clues)
    bool searched = false
    int[][][] solutions = []
    string difficulty = "-"
    string status = "contradiction"
    if not logic.details.contradiction
        if logic.result == "solved"
            status = "unique"
            solutions = [logic.grid]
            difficulty = if simple.result == "solved" then "easy" else "medium"
        else
            searched = true
            .search_result.run(logic.grid, 1)
            solutions = search_result.solutions
            status = if len(solutions) == 0 then "none" elif len(solutions) == 1 then "unique" else "multiple"
            if status == "unique"
                difficulty = "hard"
    int line_solves = int(len(logic.details.steps)) + search_result.line_solves
    int guesses = int(len(search_result.guesses))
    int max_depth = search_result.max_depth

string clue_statistics(int[][] row_clues, int[][] column_clues)
    int row_blocks = 0
    int column_blocks = 0
    int filled = 0
    int max_block = 0
    int fixed_lines = 0
    for nat side < 2
        int[][] collection = if side == 0 then row_clues else column_clues
        int length = if side == 0 then int(len(column_clues)) else int(len(row_clues))
        for int[] clue = collection[]
            if side == 0
                row_blocks += int(len(clue))
                filled += clues.total(clue)
            else
                column_blocks += int(len(clue))
            if len(clue) == 0 or clues.total(clue) + int(len(clue)) - 1 == length
                fixed_lines += 1
            for int block = clue[]
                if block > max_block
                    max_block = block
    return "row_blocks={row_blocks} column_blocks={column_blocks} filled={filled} max_block={max_block} fixed_lines={fixed_lines}"

string step_statistics(propagation.Result details)
    int productive = 0
    int idle = 0
    int best = 0
    string at = "-"
    for propagation.Step step = details.steps[]
        if step.contradiction
            continue
        if step.gain > 0
            productive += 1
        else
            idle += 1
        if step.gain > best
            best = step.gain
            at = step.label()
    return "productive={productive} idle={idle} best={best} at={at}"

string features_text(int[][] grid)
    int height = int(len(grid))
    int width = int(len(grid[0]))
    bool[][] seen = []
    for int row < height
        seen = seen.append(array(nat(width), fill = false))
    int filled = 0
    int components = 0
    int largest = 0
    int min_row = height
    int min_column = width
    int max_row = -1
    int max_column = -1
    bool lr = true
    bool ud = true
    bool rot180 = true
    int[][] offsets = [[-1, 0], [1, 0], [0, -1], [0, 1]]
    for int row < height
        for int column < width
            lr = lr and grid[row][column] == grid[row][width - 1 - column]
            ud = ud and grid[row][column] == grid[height - 1 - row][column]
            rot180 = rot180 and grid[row][column] == grid[height - 1 - row][width - 1 - column]
            if grid[row][column] != line.FILLED
                continue
            filled += 1
            if row < min_row
                min_row = row
            if row > max_row
                max_row = row
            if column < min_column
                min_column = column
            if column > max_column
                max_column = column
            if seen[row][column]
                continue
            seen[row][column] = true
            search.Cell[] stack = [search.Cell(row, column)]
            int size = 0
            while len(stack) > 0
                search.Cell current = stack[len(stack) - 1]
                stack = stack[0:<len(stack) - 1]
                size += 1
                for int[] offset = offsets[]
                    int next_row = current.row + offset[0]
                    int next_column = current.column + offset[1]
                    if next_row < 0 or next_row >= height or next_column < 0 or next_column >= width
                        continue
                    if grid[next_row][next_column] == line.FILLED and not seen[next_row][next_column]
                        seen[next_row][next_column] = true
                        stack = stack.append(search.Cell(next_row, next_column))
            components += 1
            if size > largest
                largest = size
    string bbox = if filled == 0 then "-" else "{min_row + 1},{min_column + 1},{max_row + 1},{max_column + 1}"
    string[] symmetries = []
    if lr
        symmetries = symmetries.append("lr")
    if ud
        symmetries = symmetries.append("ud")
    if rot180
        symmetries = symmetries.append("rot180")
    string symmetry = if len(symmetries) == 0 then "none" else symmetries.join(",")
    return "filled={filled} components={components} largest={largest} bbox={bbox} symmetry={symmetry}"

string unknown_summary(int[][] collection)
    string[] parts = []
    for nat index < len(collection)
        int count = 0
        for int state = collection[index][]
            if state == line.UNKNOWN
                count += 1
        if count > 0
            parts = parts.append("{index + 1}:{count}")
    return parts.join(" ")

string[] search_lines(search.Search result)
    string[] lines = ["search guesses={len(result.guesses)} max_depth={result.max_depth} backtracks={result.backtracks} solutions={len(result.solutions)} line_solves={result.line_solves}"]
    for search.Guess guess = result.guesses[]
        lines = lines.append("guess {guess.number} depth={guess.depth} cell={cell_text(guess.row, guess.column)} value={render.state_char(guess.value)} solves={guess.solves} known={guess.known} result={guess.result}")
    return lines

string[] display_lines(Analysis analyzed)
    string[] names = []
    int[][][] grids = []
    if analyzed.status == "contradiction"
        names = ["partial"]
        grids = [analyzed.logic.grid]
    else
        if analyzed.simple.result == "stuck"
            names = names.append("simple")
            grids = grids.append(analyzed.simple.grid)
        if analyzed.logic.result == "stuck"
            names = names.append("logic")
            grids = grids.append(analyzed.logic.grid)
        if analyzed.status == "multiple"
            names = names.concat(["first", "second"])
            grids = grids.concat(analyzed.solutions)
    return if len(names) == 0 then [] else render.grid_display(names, grids)

string evaluate_givens(Puzzle puzzle, Analysis analyzed)
    if len(puzzle.givens) == 0 or analyzed.status == "multiple"
        return ""
    string label = if analyzed.status == "unique" then "redundant" else "blame"
    int[] numbers = []
    for nat index < len(puzzle.givens)
        Given[] others = puzzle.givens[0:<index].concat(puzzle.givens[index + 1:<len(puzzle.givens)])
        Analysis trial = Analysis(puzzle.row_clues, puzzle.column_clues, others)
        if trial.status == "unique" or (analyzed.status != "unique" and trial.status == "multiple")
            numbers = numbers.append(int(index) + 1)
    return "givens {label}={number_list(numbers)}"

class Grading(string result, string[] lines)

Grading grade_answer(Puzzle puzzle, Analysis analyzed)
    int[] rows = []
    int[] columns = []
    int[] givens = []
    for int row < puzzle.height
        if not line.has_placement(puzzle.answer[row], puzzle.row_clues[row])
            rows = rows.append(row + 1)
    for int column < puzzle.width
        if not line.has_placement(propagation.line_cells(puzzle.answer, false, column), puzzle.column_clues[column])
            columns = columns.append(column + 1)
    bool[][] given_cells = []
    for int row < puzzle.height
        given_cells = given_cells.append(array(nat(puzzle.width), fill = false))
    for nat index < len(puzzle.givens)
        Given given = puzzle.givens[index]
        given_cells[given.row][given.column] = true
        int state = puzzle.answer[given.row][given.column]
        if state != line.UNKNOWN and state != given.state
            givens = givens.append(int(index) + 1)
    int known = propagation.determined_count(puzzle.answer)
    bool mismatched = len(rows) > 0 or len(columns) > 0 or len(givens) > 0
    string result = if known < puzzle.width * puzzle.height then "partial" elif mismatched then "wrong" else "correct"
    string text = "answer result={result} known={known} rows={number_list(rows)} columns={number_list(columns)} givens={number_list(givens)}"
    if result == "partial"
        string extendable = "no"
        if not mismatched
            Given[] additions = puzzle.givens
            for int row < puzzle.height
                for int column < puzzle.width
                    int state = puzzle.answer[row][column]
                    if state != line.UNKNOWN and not given_cells[row][column]
                        additions = additions.append(Given(row, column, state))
            Analysis trial = Analysis(puzzle.row_clues, puzzle.column_clues, additions)
            if trial.status == "unique" or trial.status == "multiple"
                extendable = "yes"
        text += " extendable={extendable}"
    if analyzed.status == "unique"
        int differs = 0
        for int row < puzzle.height
            for int column < puzzle.width
                int state = puzzle.answer[row][column]
                if state != line.UNKNOWN and state != analyzed.solutions[0][row][column]
                    differs += 1
        text += " differs={differs}"
    string[] lines = [text]
    for int side < 2
        int[] mismatches = if side == 0 then rows else columns
        for int number = mismatches[]
            int index = number - 1
            bool is_row = side == 0
            int[] clue = if is_row then puzzle.row_clues[index] else puzzle.column_clues[index]
            int[] cells = propagation.line_cells(puzzle.answer, is_row, index)
            string suffix = if result == "partial" then "cells=" + render.state_string(cells) else "got=" + clues.comma_separated(clues.run_clue(cells))
            lines = lines.append("mismatch {propagation.line_label(is_row, index)} expected={clues.comma_separated(clue)} {suffix}")
    return Grading(result, lines)

class Report(Puzzle puzzle)
    Analysis analyzed = Analysis(puzzle.row_clues, puzzle.column_clues, puzzle.givens)
    string evaluation = evaluate_givens(puzzle, analyzed)
    Grading grading = if puzzle.answer_present then grade_answer(puzzle, analyzed) else Grading("-", [])

    int score()
        return analyzed.line_solves + 25 * analyzed.guesses

    string[] paragraph()
        string[] lines = [
            "PUZZLE " + puzzle.name,
            "size={puzzle.width}x{puzzle.height} givens={len(puzzle.givens)} status={analyzed.status} difficulty={analyzed.difficulty}",
            "clues " + clue_statistics(puzzle.row_clues, puzzle.column_clues),
            "simple known={propagation.determined_count(analyzed.simple.grid)} line_solves={len(analyzed.simple.details.steps)} result={analyzed.simple.result}",
            "logic known={propagation.determined_count(analyzed.logic.grid)} line_solves={len(analyzed.logic.details.steps)} result={analyzed.logic.result}",
            "steps " + step_statistics(analyzed.logic.details)
        ]
        if puzzle.width * puzzle.height <= 49
            lines = lines.append("trace " + analyzed.logic.details.record())
        if analyzed.logic.result == "stuck"
            lines = lines.append("stuck rows={unknown_summary(analyzed.logic.grid)} columns={unknown_summary(grid_columns(analyzed.logic.grid))}")
        if analyzed.status == "contradiction"
            propagation.Step conflict = analyzed.logic.details.conflict
            int[] clue = if conflict.is_row then puzzle.row_clues[conflict.index] else puzzle.column_clues[conflict.index]
            int[] cells = propagation.line_cells(analyzed.logic.grid, conflict.is_row, conflict.index)
            lines = lines.append("conflict line={conflict.label()} clue={clues.comma_separated(clue)} cells={render.state_string(cells)}")
        if analyzed.searched
            lines = lines.concat(search_lines(analyzed.search_result))
        if analyzed.status == "multiple"
            search.Cell[] cells = differing_cells(analyzed.solutions[0], analyzed.solutions[1])
            string[] listed = []
            for search.Cell cell = cells[]
                listed = listed.append(cell_text(cell.row, cell.column))
            string values = listed.join(" ")
            lines = lines.append("differ count={len(cells)} cells={values}")
        lines = lines.concat(display_lines(analyzed))
        if analyzed.status == "unique"
            lines = lines.append("sheet")
            lines = lines.concat(render.answer_sheet(puzzle.row_clues, puzzle.column_clues, analyzed.solutions[0]))
            lines = lines.append("picture " + features_text(analyzed.solutions[0]))
        if evaluation != ""
            lines = lines.append(evaluation)
        if puzzle.answer_present
            lines = lines.concat(grading.lines)
        return lines

    string stats_row()
        string[] fields = [puzzle.name, analyzed.status, analyzed.difficulty, puzzle.width.string(), puzzle.height.string(), len(puzzle.givens).string(), propagation.determined_count(analyzed.simple.grid).string(), propagation.determined_count(analyzed.logic.grid).string(), analyzed.line_solves.string(), analyzed.guesses.string(), analyzed.max_depth.string(), len(analyzed.solutions).string(), grading.result]
        return fields.join(",")

int difficulty_order(string difficulty)
    return if difficulty == "easy" then 0 elif difficulty == "medium" then 1 else 2

bool report_before(Report first, Report second)
    int left = difficulty_order(first.analyzed.difficulty)
    int right = difficulty_order(second.analyzed.difficulty)
    if left != right
        return left < right
    if first.score() != second.score()
        return first.score() < second.score()
    return first.puzzle.name < second.puzzle.name

string[] ranking_lines(Report[] reports)
    Report[] ranked = []
    for Report report = reports[]
        if report.analyzed.status == "unique"
            ranked = ranked.append(report)
    for 1 <= int index < int(len(ranked))
        Report entry = ranked[index]
        int position = index
        while position > 0 and report_before(entry, ranked[position - 1])
            ranked[position] = ranked[position - 1]
            position -= 1
        ranked[position] = entry
    string[] lines = ["RANKING"]
    for nat index < len(ranked)
        Report entry = ranked[index]
        lines = lines.append("rank {index + 1} {entry.puzzle.name} {entry.analyzed.difficulty} score={entry.score()} size={entry.puzzle.width}x{entry.puzzle.height}")
    return lines

string[] join_paragraphs(string[][] paragraphs)
    string[] result = []
    for string[] paragraph = paragraphs[]
        if len(result) > 0
            result = result.append("")
        result = result.concat(paragraph)
    return result

void write_lines(string name, string[] lines)
    if not file.is_directory("output")
        file.mkdir("output")
    string text = if len(lines) == 0 then "" else lines.join(NL) + NL
    file.write("output/" + name, text)

Report[] process_puzzles(string[][] blocks)
    map.Map<string, int> earlier
    Report[] reports = []
    string[][] paragraphs = []
    string[] stats = ["puzzle,status,difficulty,width,height,givens,simple_known,logic_known,line_solves,guesses,max_depth,solutions,answer"]
    for string[] block = blocks[]
        Puzzle puzzle = Puzzle(block)
        string problem = .puzzle.validate(earlier)
        .earlier.set(puzzle.name, 1)
        if problem != ""
            paragraphs = paragraphs.append(["PUZZLE " + puzzle.name, "error " + problem])
            string invalid = puzzle.name + ",invalid"
            for int index < 11
                invalid += ",-"
            stats = stats.append(invalid)
        else
            Report report = Report(puzzle)
            reports = reports.append(report)
            paragraphs = paragraphs.append(report.paragraph())
            stats = stats.append(report.stats_row())
    int[] statuses = [0, 0, 0, 0]
    int[] difficulties = [0, 0, 0]
    string[] status_names = ["contradiction", "none", "unique", "multiple"]
    string[] difficulty_names = ["easy", "medium", "hard"]
    int line_solves = 0
    int guesses = 0
    for Report report = reports[]
        for nat index < len(status_names)
            if report.analyzed.status == status_names[index]
                statuses[index] += 1
        for nat index < len(difficulty_names)
            if report.analyzed.difficulty == difficulty_names[index]
                difficulties[index] += 1
        line_solves += report.analyzed.line_solves
        guesses += report.analyzed.guesses
    paragraphs = paragraphs.append(ranking_lines(reports))
    paragraphs = paragraphs.append(["SUMMARY puzzles={len(blocks)} invalid={int(len(blocks)) - int(len(reports))} contradiction={statuses[0]} none={statuses[1]} unique={statuses[2]} multiple={statuses[3]} easy={difficulties[0]} medium={difficulties[1]} hard={difficulties[2]} line_solves={line_solves} guesses={guesses}"])
    write_lines("solutions.txt", join_paragraphs(paragraphs))
    write_lines("stats.csv", stats)
    return reports

Given[] sorted_givens(Given[] givens)
    Given[] result = givens
    for 1 <= int index < int(len(result))
        Given entry = result[index]
        int position = index
        while position > 0
            Given previous = result[position - 1]
            if previous.row < entry.row or (previous.row == entry.row and previous.column <= entry.column)
                break
            result[position] = previous
            position -= 1
        result[position] = entry
    return result

class Generation(int[][] grid)
    int[][] row_clues = []
    int[][] column_clues = []
    for int[] row = grid[]
        row_clues = row_clues.append(clues.run_clue(row))
    for int[] column = grid_columns(grid)[]
        column_clues = column_clues.append(clues.run_clue(column))
    Given[] givens = []
    string[] log = []
    Analysis initial = Analysis(row_clues, column_clues, givens)
    local Analysis current = initial
    while current.status == "multiple"
        search.Cell[] differences = differing_cells(current.solutions[0], current.solutions[1])
        search.Cell chosen = differences[0]
        int state = grid[chosen.row][chosen.column]
        givens = givens.append(Given(chosen.row, chosen.column, state))
        current = Analysis(row_clues, column_clues, givens)
        log = log.append("# hint {len(givens)} cell={cell_text(chosen.row, chosen.column)} value={render.state_char(state)} status={current.status}")
    local Given[] original = givens
    for Given given = original[]
        Given[] others = []
        for Given other = givens[]
            if other.row != given.row or other.column != given.column
                others = others.append(other)
        Analysis trial = Analysis(row_clues, column_clues, others)
        if trial.status == "unique"
            givens = others
            log = log.append("# drop cell={cell_text(given.row, given.column)}")
    Analysis final_analysis = Analysis(row_clues, column_clues, givens)
    local int logic_hints = 0
    while final_analysis.difficulty == "hard"
        search.Cell chosen = search.guess_cell(final_analysis.logic.grid)
        int state = grid[chosen.row][chosen.column]
        givens = givens.append(Given(chosen.row, chosen.column, state))
        final_analysis = Analysis(row_clues, column_clues, givens)
        logic_hints += 1
        log = log.append("# logic hint {logic_hints} cell={cell_text(chosen.row, chosen.column)} value={render.state_char(state)} difficulty={final_analysis.difficulty}")

    string[] puzzle_lines(string name)
        string[] lines = ["PUZZLE " + name, "SIZE {len(column_clues)} {len(row_clues)}", "ROWS"]
        for int[] clue = row_clues[]
            lines = lines.append(clues.spaced(clue))
        lines = lines.append("COLUMNS")
        for int[] clue = column_clues[]
            lines = lines.append(clues.spaced(clue))
        for Given given = sorted_givens(givens)[]
            lines = lines.append("GIVEN {given.row + 1} {given.column + 1} {render.state_char(given.state)}")
        return lines.append("END")

string same_clues_name(Report[] reports, int[][] row_clues, int[][] column_clues)
    for Report report = reports[]
        if report.puzzle.row_clues == row_clues and report.puzzle.column_clues == column_clues
            return report.puzzle.name
    return "-"

string[] picture_paragraph(Picture picture, Generation generation, Report[] reports)
    Analysis initial = generation.initial
    Analysis final_analysis = generation.final_analysis
    string duplicate = same_clues_name(reports, generation.row_clues, generation.column_clues)
    string[] lines = [
        "# picture {picture.name} size={len(generation.grid[0])}x{len(generation.grid)} {features_text(generation.grid)}",
        "# clues {clue_statistics(generation.row_clues, generation.column_clues)} duplicate_of={duplicate}",
        "# plain status={initial.status} difficulty={initial.difficulty} line_solves={initial.line_solves} guesses={initial.guesses}"
    ]
    lines = lines.concat(generation.log)
    lines = lines.append("# final status={final_analysis.status} difficulty={final_analysis.difficulty} hints={len(generation.givens)} line_solves={final_analysis.line_solves} guesses={final_analysis.guesses}")
    return lines.concat(generation.puzzle_lines(picture.name))

void process_pictures(string[][] blocks, Report[] reports)
    map.Map<string, int> earlier
    string[][] paragraphs = []
    int valid = 0
    int unique = 0
    int line_logic = 0
    int hinted = 0
    int hints = 0
    for string[] block = blocks[]
        Picture picture = Picture(block)
        string problem = picture.validate(earlier)
        .earlier.set(picture.name, 1)
        if problem != ""
            paragraphs = paragraphs.append(["# picture {picture.name} error {problem}"])
            continue
        Generation generation = Generation(state_grid(picture.rows))
        valid += 1
        if generation.initial.status == "unique"
            unique += 1
        if generation.initial.difficulty == "easy" or generation.initial.difficulty == "medium"
            line_logic += 1
        if len(generation.givens) > 0
            hinted += 1
        hints += int(len(generation.givens))
        paragraphs = paragraphs.append(picture_paragraph(picture, generation, reports))
    paragraphs = paragraphs.append(["# SUMMARY pictures={len(blocks)} invalid={int(len(blocks)) - valid} unique={unique} line_logic={line_logic} hinted={hinted} hints={hints}"])
    write_lines("generated.txt", join_paragraphs(paragraphs))

if main
    Report[] reports = process_puzzles(read_blocks("input/puzzles.txt"))
    process_pictures(read_blocks("input/pictures.txt"), reports)
