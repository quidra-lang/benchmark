import line = "./line_solver.qui"
import propagation = "./propagation.qui"

class Cell(int row, int column)

Cell guess_cell(int[][] grid)
    int[] row_unknowns = array(len(grid), fill = 0)
    int[] column_unknowns = array(len(grid[0]), fill = 0)
    for nat row < len(grid)
        for nat column < len(grid[row])
            if grid[row][column] == line.UNKNOWN
                row_unknowns[row] += 1
                column_unknowns[column] += 1
    Cell best = Cell(-1, -1)
    int best_score = 0
    for nat row < len(grid)
        for nat column < len(grid[row])
            if grid[row][column] == line.UNKNOWN
                int score = row_unknowns[row] + column_unknowns[column]
                if best.row < 0 or score < best_score
                    best = Cell(int(row), int(column))
                    best_score = score
    return best

class Guess(int number, int depth, int row, int column, int value, int solves, int known, string result)

class Search(int[][] row_clues, int[][] column_clues)
    Guess[] guesses = []
    int[][][] solutions = []
    int backtracks = 0
    int max_depth = 0
    int line_solves = 0

    bool .run(int[][] grid, int depth)
        Cell chosen = guess_cell(grid)
        for int value = [line.FILLED, line.EMPTY][]
            int number = int(len(guesses)) + 1
            if depth > max_depth
                max_depth = depth
            int[][] child = grid
            child[chosen.row][chosen.column] = value
            bool[] row_marks = array(len(row_clues), fill = false)
            bool[] column_marks = array(len(column_clues), fill = false)
            row_marks[chosen.row] = true
            column_marks[chosen.column] = true
            propagation.Result propagated = propagation.propagate(&child, row_clues, column_clues, true, row_marks, column_marks)
            int known = propagation.determined_count(child)
            string result = "open"
            if propagated.contradiction
                result = "contradiction at=" + propagated.conflict.label()
                backtracks += 1
            elif known == int(len(row_clues) * len(column_clues))
                solutions = solutions.append(child)
                result = "solution{len(solutions)}"
            int solves = int(len(propagated.steps))
            line_solves += solves
            guesses = guesses.append(Guess(number, depth, chosen.row, chosen.column, value, solves, known, result))
            if result == "open"
                if .run(child, depth + 1)
                    return true
            elif len(solutions) == 2
                return true
        return false
