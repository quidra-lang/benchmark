const int UNKNOWN = 0
const int FILLED = 1
const int EMPTY = 2

bool[][] fit_table(int[] cells, int[] clue)
    int[] empties = [0]
    for int state = cells[]
        empties = empties.append(empties[len(empties) - 1] + (if state == EMPTY then 1 else 0))
    bool[][] table = []
    for nat index <= len(cells)
        table = table.append(array(len(clue) + 1, fill = false))
    table[0][0] = true
    for 1 <= int end <= int(len(cells))
        for int count <= int(len(clue))
            bool fits = cells[end - 1] != FILLED and table[end - 1][count]
            if not fits and count > 0
                int start = end - clue[count - 1]
                if start >= 0 and empties[end] == empties[start]
                    fits = if start == 0 then count == 1 else cells[start - 1] != FILLED and table[start - 1][count - 1]
            table[end][count] = fits
    return table

class Placements(int[] cells, int[] clue)
    int length = int(len(cells))
    bool[][] before = fit_table(cells, clue)
    bool[][] after = fit_table(cells[::-1], clue[::-1])

    bool consistent()
        return before[length][len(clue)]

    bool can_start(int block, int start)
        int end = start + clue[block]
        for start <= int index < end
            if cells[index] == EMPTY
                return false
        bool left = if start == 0 then block == 0 else cells[start - 1] != FILLED and before[start - 1][block]
        int rest = int(len(clue)) - block - 1
        bool right = if end == length then rest == 0 else cells[end] != FILLED and after[length - end - 1][rest]
        return left and right

    int[] starts(int block)
        int[] result = []
        for int start <= length - clue[block]
            if can_start(block, start)
                result = result.append(start)
        return result

    bool can_be_empty(int index)
        if cells[index] == FILLED
            return false
        int count = int(len(clue))
        for int blocks <= count
            if before[index][blocks] and after[length - index - 1][count - blocks]
                return true
        return false

class LineResult(bool contradiction, int[] cells)

bool has_placement(int[] cells, int[] clue)
    Placements placements = Placements(cells, clue)
    return placements.consistent()

LineResult solve_line(int[] cells, int[] clue, bool precise)
    Placements placements = Placements(cells, clue)
    if not placements.consistent()
        return LineResult(true, cells)
    int[] solved = cells
    bool[] fillable = array(len(cells), fill = false)
    bool[] covered = array(len(cells), fill = false)
    for int block < int(len(clue))
        int length = clue[block]
        int[] starts = placements.starts(block)
        if precise
            for int start = starts[]
                for start <= int index < start + length
                    fillable[index] = true
        else
            int low = starts[0]
            int high = starts[len(starts) - 1]
            for high <= int index < low + length
                if solved[index] == UNKNOWN
                    solved[index] = FILLED
            for low <= int index < high + length
                covered[index] = true
    for nat index < len(cells)
        if solved[index] != UNKNOWN
            continue
        if precise
            bool emptiable = placements.can_be_empty(int(index))
            if fillable[index] and not emptiable
                solved[index] = FILLED
            elif emptiable and not fillable[index]
                solved[index] = EMPTY
        elif not covered[index]
            solved[index] = EMPTY
    return LineResult(false, solved)
