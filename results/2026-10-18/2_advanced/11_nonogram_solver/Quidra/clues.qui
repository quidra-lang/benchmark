import line = "./line_solver.qui"

bool is_clue_line(string text)
    if text == ""
        return false
    for int point = text.codepoints()[]
        if point != 32 and not (48 <= point <= 57)
            return false
    return true

int[] | none parse_clue(string text)
    if text == "0"
        return []
    int[] result = []
    for string token = text.split(" ")[]
        if len(token) < 1 or len(token) > 2 or token[0] == "0"
            return none
        for int point = token.codepoints()[]
            if point < 48 or point > 57
                return none
        result = result.append(int.parse(token))
    return result

int[] run_clue(int[] cells)
    int[] result = []
    int run = 0
    for int state = cells[]
        if state == line.FILLED
            run += 1
        elif run > 0
            result = result.append(run)
            run = 0
    if run > 0
        result = result.append(run)
    return result

string formatted(int[] clue, string separator)
    if len(clue) == 0
        return "0"
    string[] tokens = []
    for int length = clue[]
        tokens = tokens.append(length.string())
    return tokens.join(separator)

string spaced(int[] clue)
    return formatted(clue, " ")

string comma_separated(int[] clue)
    return formatted(clue, ",")

int total(int[] clue)
    int result = 0
    for int length = clue[]
        result += length
    return result

bool fits(int[] clue, int length)
    return total(clue) + int(len(clue)) - 1 <= length
