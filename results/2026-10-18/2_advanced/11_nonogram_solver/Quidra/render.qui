import line = "./line_solver.qui"
import clues = "./clues.qui"

string state_char(int state)
    return if state == line.FILLED then "#" elif state == line.EMPTY then "." else "?"

int char_state(string character)
    return if character == "#" then line.FILLED elif character == "." then line.EMPTY else line.UNKNOWN

string state_string(int[] cells)
    string result = ""
    for int state = cells[]
        result += state_char(state)
    return result

string[] grid_display(string[] names, int[][][] grids)
    string[] lines = ["grid " + names.join(" ")]
    for nat row < len(grids[0])
        string[] parts = []
        for int[][] grid = grids[]
            parts = parts.append(state_string(grid[row]))
        lines = lines.append(parts.join(" | "))
    return lines

string pad_left(string text, int width)
    string result = text
    while int(len(result)) < width
        result = " " + result
    return result

string trim_right(string text)
    int end = int(len(text))
    while end > 0 and text[end - 1] == " "
        end -= 1
    return text[0:<end]

string[] answer_sheet(int[][] row_clues, int[][] column_clues, int[][] grid)
    string[][] tokens = []
    int width = 0
    int depth = 0
    int margin = 0
    for int[] clue = column_clues[]
        string[] column = clues.spaced(clue).split(" ")
        tokens = tokens.append(column)
        if int(len(column)) > depth
            depth = int(len(column))
        for string token = column[]
            if int(len(token)) + 1 > width
                width = int(len(token)) + 1
    for int[] clue = row_clues[]
        int length = int(len(clues.spaced(clue)))
        if length > margin
            margin = length
    string[] result = []
    for int row < depth
        string text = string.repeat(" ", nat(margin))
        for string[] column = tokens[]
            int skipped = depth - int(len(column))
            text += if row >= skipped then pad_left(column[row - skipped], width) else string.repeat(" ", nat(width))
        result = result.append(trim_right(text))
    for nat row < len(grid)
        string text = pad_left(clues.spaced(row_clues[row]), margin)
        for int state = grid[row][]
            text += string.repeat(" ", nat(width - 1)) + state_char(state)
        result = result.append(text)
    return result
