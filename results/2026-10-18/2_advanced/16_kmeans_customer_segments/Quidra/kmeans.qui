import math

real64 squared_distance(real64[] first, real64[] second)
    real64[] differences = first - second
    return math.sum(differences * differences)

real64[] mean_point(real64[][] points)
    return [for nat feature = points[0].indices()[] then math.sum([for real64[] point = points[] then point[feature]]) / real64(len(points))]

int[][] groups(int[] labels, int k)
    int[] empty_members = []
    int[][] members = array(nat(k), fill = empty_members)
    for int i < int(len(labels))
        members[labels[i]] = members[labels[i]].append(i)
    return members

real64[] cluster_center(real64[][] points, int[] labels, int label)
    return mean_point([for int i = (0:<int(len(points)))[] if labels[i] == label then points[i]])

real64[][] cluster_centers(real64[][] points, int[] labels, int k)
    return [for int label = (0:<k)[] then cluster_center(points, labels, label)]

class Assignment(int[] labels, real64[] errors)

Assignment assign(real64[][] points, real64[][] centers)
    int[] labels = []
    real64[] errors = []
    for real64[] point = points[]
        int chosen = 0
        real64 best = squared_distance(point, centers[0])
        for 1 <= int label < int(len(centers))
            real64 distance = squared_distance(point, centers[label])
            if distance < best
                chosen = label
                best = distance
        labels = labels.append(chosen)
        errors = errors.append(best)
    return Assignment(labels, errors)

int refill(Assignment &current, int k)
    int[] sizes = array(nat(k), fill = 0)
    for int label = current.labels[]
        sizes[label] += 1
    int reseeds = 0
    for int label < k
        if sizes[label] != 0
            continue
        int chosen = -1
        for int i < int(len(current.labels))
            if sizes[current.labels[i]] >= 2 and (chosen < 0 or current.errors[i] > current.errors[chosen])
                chosen = i
        sizes[current.labels[chosen]] -= 1
        sizes[label] += 1
        current.labels[chosen] = label
        current.errors[chosen] = 0.0
        reseeds += 1
    return reseeds

real64 sse(real64[][] points, int[] labels, real64[][] centers)
    return math.sum([for int i = (0:<int(len(points)))[] then squared_distance(points[i], centers[labels[i]])])

class LloydResult(int[] labels, real64[][] centers, int iterations, int reseeds, bool converged, real64 within)

LloydResult lloyd(real64[][] points, real64[][] initial, int limit)
    int k = int(len(initial))
    Assignment current = assign(points, initial)
    int iterations = 0
    int reseeds = 0
    bool converged = false
    while iterations < limit
        reseeds += refill(&current, k)
        real64[][] updated_centers = cluster_centers(points, current.labels, k)
        iterations += 1
        Assignment updated = assign(points, updated_centers)
        converged = updated.labels == current.labels
        current = updated
        if converged
            break
    reseeds += refill(&current, k)
    real64[][] centers = cluster_centers(points, current.labels, k)
    return LloydResult(current.labels, centers, iterations, reseeds, converged, sse(points, current.labels, centers))
