import math
import kmeans = "./kmeans.qui"

real64[][] distance_table(real64[][] points)
    real64[][] distances = array(len(points), fill = array(len(points), fill = 0.0))
    for int i < int(len(points))
        for i + 1 <= int j < int(len(points))
            real64 value = math.sqrt(kmeans.squared_distance(points[i], points[j]))
            distances[i][j] = value
            distances[j][i] = value
    return distances

real64[] silhouettes(real64[][] distances, int[] labels, int[] sizes)
    int k = int(len(sizes))
    real64[] values = []
    for int i < int(len(labels))
        int own = labels[i]
        if sizes[own] == 1
            values = values.append(0.0)
            continue
        real64[] totals = array(nat(k), fill = 0.0)
        for int j < int(len(labels))
            if j != i
                totals[labels[j]] += distances[i][j]
        real64 inner = totals[own] / real64(sizes[own] - 1)
        real64 outer = math.min_all([for int label = (0:<k)[] if label != own then totals[label] / real64(sizes[label])])
        real64 largest = math.max(inner, outer)
        values = values.append(if largest == 0.0 then 0.0 else (outer - inner) / largest)
    return values

real64 calinski_harabasz(real64[][] points, real64[][] centers, int[] sizes, real64 within)
    real64[] overall = kmeans.mean_point(points)
    real64 between = math.sum([for int label = (0:<int(len(centers)))[] then real64(sizes[label]) * kmeans.squared_distance(centers[label], overall)])
    return (between / real64(int(len(centers)) - 1)) / (within / real64(int(len(points)) - int(len(centers))))

real64 davies_bouldin(real64[][] points, int[] labels, real64[][] centers, int[] sizes)
    int k = int(len(centers))
    real64[] spreads = array(nat(k), fill = 0.0)
    for int i < int(len(points))
        spreads[labels[i]] += math.sqrt(kmeans.squared_distance(points[i], centers[labels[i]]))
    spreads = spreads / real64(sizes)
    real64[] maxima = []
    for int label < k
        real64[] ratios = [for int other = (0:<k)[] if other != label then (spreads[label] + spreads[other]) / math.sqrt(kmeans.squared_distance(centers[label], centers[other]))]
        maxima = maxima.append(math.max_all(ratios))
    return math.sum(maxima) / real64(k)

real64 elbow(int k, int first_k, int last_k, real64 within, real64 first, real64 last)
    real64 x = real64(k - first_k) / real64(last_k - first_k)
    real64 y = (within - last) / (first - last)
    return ((1.0 - x) - y) / math.sqrt(2.0)

real64 hartigan(real64 within, real64 following, int count, int k)
    return (within / following - 1.0) * real64(count - k - 1)

real64 adjusted_rand(int[] first, int[] second)
    int sx = 0
    int sy = 0
    int shared = 0
    for int i < int(len(first))
        for i + 1 <= int j < int(len(first))
            bool same_first = first[i] == first[j]
            bool same_second = second[i] == second[j]
            if same_first
                sx += 1
            if same_second
                sy += 1
            if same_first and same_second
                shared += 1
    int count = int(len(first))
    int total = count * (count - 1) / 2
    int numerator = 2 * (total * shared - sx * sy)
    int denominator = total * (sx + sy) - 2 * sx * sy
    return if denominator == 0 then 1.0 else real64(numerator) / real64(denominator)
