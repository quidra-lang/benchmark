import math
import transactions = "./transactions.qui"

string[] names()
    return ["recency", "frequency", "monetary", "basket", "categories", "tenure"]

bool root_feature(int feature)
    return 1 <= feature <= 3

real64[] transform(real64[] values)
    return [for int i = (0:<int(len(values)))[] then if root_feature(i) then math.sqrt(values[i]) else values[i]]

class Customer(string id, transactions.Order[] orders, local int reference_day)
    int recency = reference_day - math.max_all([for transactions.Order order = orders[] then order.day])
    int frequency = int(len(orders))
    int spend = math.sum([for transactions.Order order = orders[] then order.net])
    real64 monetary = real64(spend) / 100.0
    real64 basket = monetary / real64(frequency)
    map.Map<string, int> category_spend
    for transactions.Order order = orders[]
        for transactions.Row row = order.rows[]
            .category_spend.set(row.category, transactions.lookup(category_spend, row.category) + row.amount)
    int categories = math.sum<int>([for int amount = category_spend.values()[] if amount > 0 then 1])
    int tenure = reference_day - math.min_all([for transactions.Order order = orders[] then order.day])
    real64[] raw = [real64(recency), real64(frequency), monetary, basket, real64(categories), real64(tenure)]
    real64[] transformed = transform(raw)

Customer[] eligible_customers(transactions.Order[] orders, int day)
    map.Map<string, int> eligible
    for transactions.Order order = orders[]
        if order.net > 0
            .eligible.set(order.customer, 1)
    Customer[] customers = []
    for string id = eligible.keys().sorted()[]
        transactions.Order[] purchases = [for transactions.Order order = orders[] if order.net > 0 and order.customer == id then order]
        customers = customers.append(Customer(id, purchases, day))
    return customers

real64 mean(real64[] values)
    return math.sum(values) / real64(len(values))

real64 sample_sd(real64[] values)
    real64[] differences = values - mean(values)
    return math.sqrt(math.sum(differences * differences) / real64(int(len(values)) - 1))

class Scale(real64 raw_mean, real64 raw_sd, real64 mean_value, real64 deviation)

Scale[] fit_scaling(Customer[] customers)
    Scale[] scaling = []
    for int feature < 6
        real64[] raw = [for Customer customer = customers[] then customer.raw[feature]]
        real64[] transformed = [for Customer customer = customers[] then customer.transformed[feature]]
        scaling = scaling.append(Scale(mean(raw), sample_sd(raw), mean(transformed), sample_sd(transformed)))
    return scaling

real64[] standardize(real64[] values, Scale[] scaling)
    return [for int feature = (0:<int(len(values)))[] then if scaling[feature].deviation == 0.0 then 0.0 else (values[feature] - scaling[feature].mean_value) / scaling[feature].deviation]

real64 correlation(real64[][] points, int first, int second)
    return math.sum([for real64[] point = points[] then point[first] * point[second]]) / real64(int(len(points)) - 1)
