import math

const real64 pi = 3.141592653589793

real64 determinant(real64[] cov)
    return cov[0] * cov[2] - cov[1] * cov[1]

real64 mahalanobis(real64[] point, real64[] mean, real64[] cov)
    real64 dx = point[0] - mean[0]
    real64 dy = point[1] - mean[1]
    return (cov[2] * dx * dx - 2.0 * cov[1] * dx * dy + cov[0] * dy * dy) / determinant(cov)

real64 log_density(real64[] point, real64[] component)
    real64 first = math.log(component[0])
    real64 constant = math.log(2.0 * pi)
    real64 log_det = math.log(determinant(component[3:<6]))
    return first - constant - log_det / 2.0 - mahalanobis(point, component[1:<3], component[3:<6]) / 2.0

real64 arctangent(real64 value)
    bool invert = value > 1.0
    real64 z = if invert then 1.0 / value else value
    bool reduce = z > 0.41421356237309503
    if reduce
        z = (z - 1.0) / (z + 1.0)
    real64 squared = z * z
    real64 power = z
    real64 total = 0.0
    for int j < 40
        total += power / real64(2 * j + 1)
        power *= -squared
    if reduce
        total += pi / 4.0
    return if invert then pi / 2.0 - total else total

real64 atan2(real64 vertical, real64 horizontal)
    if horizontal == 0.0
        return if vertical >= 0.0 then pi / 2.0 else -pi / 2.0
    real64 ratio = vertical / horizontal
    real64 result = arctangent(if ratio < 0.0 then -ratio else ratio)
    if ratio < 0.0
        result = -result
    if horizontal < 0.0
        result += if vertical >= 0.0 then pi else -pi
    return result

real64[] eigen(real64[] cov)
    real64 a = cov[0]
    real64 b = cov[1]
    real64 c = cov[2]
    real64 h = (a + c) / 2.0
    real64 delta = (a - c) / 2.0
    real64 g = math.sqrt(delta * delta + b * b)
    real64 leading = h + g
    real64 trailing = h - g
    real64 ux = 1.0
    real64 uy = 0.0
    if b == 0.0
        if a < c
            ux = 0.0
            uy = 1.0
    else
        real64 vx = if a >= c then leading - c else b
        real64 vy = if a >= c then b else leading - a
        real64 length = math.sqrt(vx * vx + vy * vy)
        ux = vx / length
        uy = vy / length
        if vx < 0.0
            ux = -ux
            uy = -uy
    real64 angle = atan2(uy, ux) * 180.0 / pi
    real64 first_axis = math.sqrt(leading)
    real64 second_axis = math.sqrt(trailing)
    real64 area = pi * math.sqrt(leading * trailing)
    real64 correlation = b / math.sqrt(a * c)
    return [leading, trailing, ux, uy, angle, first_axis, second_axis, area, correlation]

real64[] bhattacharyya(real64[] first, real64[] second)
    real64[] cov = [(first[3] + second[3]) / 2.0, (first[4] + second[4]) / 2.0, (first[5] + second[5]) / 2.0]
    real64 ratio = determinant(cov) / math.sqrt(determinant(first[3:<6]) * determinant(second[3:<6]))
    real64 logarithm = math.log(ratio)
    real64 distance = mahalanobis(second[1:<3], first[1:<3], cov) / 8.0 + logarithm / 2.0
    real64 coefficient = math.exp(-distance)
    return [distance, coefficient]
