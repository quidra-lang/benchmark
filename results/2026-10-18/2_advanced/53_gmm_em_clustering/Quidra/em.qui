import math
import gaussian = "./gaussian.qui"

real64[][] adjust(real64[][] initial, string kind)
    real64[][] model = initial
    real64[] shared = [0.0, 0.0, 0.0]
    if kind == "TIED"
        for int column < 3
            for real64[] component = initial[]
                shared[column] += component[0] * component[column + 3]
    for auto &component = &model[]
        if kind == "DIAG"
            component[4] = 0.0
        elif kind == "SPHERICAL"
            real64 variance = (component[3] + component[5]) / 2.0
            component[3] = variance
            component[4] = 0.0
            component[5] = variance
        elif kind == "TIED"
            for int column < 3
                component[column + 3] = shared[column]
    return model

(real64[][], real64[], real64) expectation(real64[][] points, real64[][] model)
    real64[][] records = []
    real64[] densities = []
    real64 loglik = 0.0
    for real64[] point = points[]
        real64[] scores = []
        real64 maximum = -inf
        for real64[] component = model[]
            real64 score = gaussian.log_density(point, component)
            scores = scores.append(score)
            if score > maximum
                maximum = score
        real64[] row = []
        real64 total = 0.0
        for real64 score = scores[]
            real64 value = math.exp(score - maximum)
            row = row.append(value)
            total += value
        for auto &value = &row[]
            value /= total
        real64 logarithm = math.log(total)
        real64 density = maximum + logarithm
        records = records.append(row)
        densities = densities.append(density)
        loglik += density
    return (records, densities, loglik)

real64[][] maximization(real64[][] points, real64[][] records, string kind, real64 epsilon)
    int count = int(len(records[0]))
    real64 sample_size = real64(len(points))
    real64[][] model = []
    real64[] counts = []
    real64[][] scatters = []
    for int k < count
        real64 nk = 0.0
        real64 sx = 0.0
        real64 sy = 0.0
        for int i < int(len(points))
            real64 r = records[i][k]
            nk += r
            sx += r * points[i][0]
            sy += r * points[i][1]
        real64 mx = sx / nk
        real64 my = sy / nk
        counts = counts.append(nk)
        model = model.append([nk / sample_size, mx, my, 0.0, 0.0, 0.0])
        real64 a = 0.0
        real64 b = 0.0
        real64 c = 0.0
        for int i < int(len(points))
            real64 dx = points[i][0] - mx
            real64 dy = points[i][1] - my
            real64 r = records[i][k]
            a += r * dx * dx
            b += r * dx * dy
            c += r * dy * dy
        scatters = scatters.append([a, b, c])
    if kind == "TIED"
        real64[] shared = [0.0, 0.0, 0.0]
        for int column < 3
            for real64[] scatter = scatters[]
                shared[column] += scatter[column]
            shared[column] /= sample_size
        shared[0] += epsilon
        shared[2] += epsilon
        for int k < count
            for int column < 3
                model[k][column + 3] = shared[column]
    else
        for int k < count
            real64 a = scatters[k][0] / counts[k] + epsilon
            real64 b = if kind == "FULL" then scatters[k][1] / counts[k] else 0.0
            real64 c = scatters[k][2] / counts[k] + epsilon
            if kind == "SPHERICAL"
                real64 variance = (scatters[k][0] / counts[k] + scatters[k][2] / counts[k]) / 2.0 + epsilon
                a = variance
                c = variance
            model[k][3] = a
            model[k][4] = b
            model[k][5] = c
    return model

(real64[][], real64[][], real64[], real64[]) run(real64[][] points, real64[][] initial, string kind, int iterations, real64 epsilon)
    real64[][] model = adjust(initial, kind)
    (real64[][] records, real64[] densities, real64 loglik) = expectation(points, model)
    real64[] trace = [loglik]
    for int iteration < iterations
        model = maximization(points, records, kind, epsilon)
        (records, densities, loglik) = expectation(points, model)
        trace = trace.append(loglik)
    return (model, records, densities, trace)
