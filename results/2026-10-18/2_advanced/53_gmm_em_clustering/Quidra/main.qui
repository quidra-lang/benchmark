import math
import dataset = "./dataset.qui"
import gaussian = "./gaussian.qui"
import em = "./em.qui"
import kmeans = "./kmeans.qui"
import report = "./report.qui"

int winner(real64[] row)
    int best = 0
    for 1 <= int k < int(len(row))
        if row[k] > row[best]
            best = k
    return best

real64 row_entropy(real64[] row)
    real64 total = 0.0
    for real64 value = row[]
        if value > 0.0
            real64 logarithm = math.log(value)
            total += value * logarithm
    return -total

int parameter_count(int count, string kind)
    if kind == "FULL"
        return 6 * count - 1
    if kind == "TIED"
        return 3 * count + 2
    if kind == "DIAG"
        return 5 * count - 1
    return 4 * count - 1

class Fitted(int count, string kind, int type_index, real64[][] model, real64[][] records, real64[] densities, real64[] trace, local real64 tolerance, local int sample_size)
    int p = parameter_count(count, kind)
    real64 loglik = trace[int(len(trace)) - 1]
    real64 bic = -2.0 * loglik + real64(p) * math.log(real64(sample_size))
    real64 aic = -2.0 * loglik + 2.0 * real64(p)
    int[] labels = []
    int[] sizes = [for int k < count then 0]
    real64 entropy_value = 0.0
    for real64[] row = records[]
        int chosen = winner(row)
        labels = labels.append(chosen)
        sizes[chosen] += 1
        entropy_value += row_entropy(row)
    real64 icl = bic + 2.0 * entropy_value
    int settled_at = int(len(trace)) - 1
    local int position = int(len(trace)) - 1
    while position >= 0
        real64 gap = trace[position] - loglik
        if (if gap < 0.0 then -gap else gap) > tolerance
            break
        settled_at = position
        position -= 1
    int largest_t = 1
    real64 largest_value = -inf
    int[] violations = []
    for 1 <= int t < int(len(trace))
        real64 increase = trace[t] - trace[t - 1]
        if increase > largest_value
            largest_t = t
            largest_value = increase
        real64 previous = trace[t - 1]
        if trace[t] < previous - 0.000001 * (if previous < 0.0 then -previous else previous)
            violations = violations.append(t)

Fitted fit(real64[][] points, real64[][] initial, int count, string kind, int type_index, dataset.Settings settings)
    (real64[][] model, real64[][] records, real64[] densities, real64[] trace) = em.run(points, initial, kind, settings.iterations, settings.epsilon)
    return Fitted(count, kind, type_index, model, records, densities, trace, settings.tolerance, int(len(points)))

real64 criterion_value(Fitted model, int criterion)
    return if criterion == 0 then model.bic elif criterion == 1 then model.aic else model.icl

bool model_before(Fitted first, Fitted second, int criterion)
    int a = report.scaled(criterion_value(first, criterion))
    int b = report.scaled(criterion_value(second, criterion))
    if a != b
        return a < b
    if first.p != second.p
        return first.p < second.p
    if first.count != second.count
        return first.count < second.count
    return first.type_index < second.type_index

Fitted[] ranking(Fitted[] source, int criterion)
    Fitted[] result = []
    for Fitted model = source[]
        int index = 0
        while index < int(len(result)) and not model_before(model, result[index], criterion)
            index += 1
        Fitted[] updated = []
        for int j < int(len(result))
            if j == index
                updated = updated.append(model)
            updated = updated.append(result[j])
        if index == int(len(result))
            updated = updated.append(model)
        result = updated
    return result

Fitted[] by_count(Fitted[] source, int target)
    return [for Fitted model = source[] if model.count == target then model]

Fitted[] by_kind(Fitted[] source, string target)
    return [for Fitted model = source[] if model.kind == target then model]

int rank_position(Fitted[] source, Fitted target)
    for int j < int(len(source))
        if source[j].count == target.count and source[j].type_index == target.type_index
            return j + 1
    return 0

int[][] contingency(int[] first, int[] second, int rows, int columns)
    int[][] result = [for int a < rows then [for int b < columns then 0]]
    for int i < int(len(first))
        result[first[i]][second[i]] += 1
    return result

int choose2(int count)
    return count * (count - 1) / 2

int gcd(int first, int second)
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return first

string ari(int[] first, int[] second, int rows, int columns)
    int[][] matrix = contingency(first, second, rows, columns)
    int shared = 0
    int a = 0
    int b = 0
    for int[] row = matrix[]
        int total = 0
        for int value = row[]
            shared += choose2(value)
            total += value
        a += choose2(total)
    for int column < columns
        int total = 0
        for int row < rows
            total += matrix[row][column]
        b += choose2(total)
    int z = choose2(int(len(first)))
    int numerator = 2 * (z * shared - a * b)
    int denominator = z * (a + b) - 2 * a * b
    if denominator == 0
        numerator = 1
        denominator = 1
    else
        if denominator < 0
            numerator = -numerator
            denominator = -denominator
        int divisor = gcd(if numerator < 0 then -numerator else numerator, denominator)
        numerator /= divisor
        denominator /= divisor
    return "{numerator}/{denominator} " + report.dec(real64(numerator) / real64(denominator))

class Metrics(bool valid, real64 silhouette, real64 ch, real64 db, real64[] cluster)

Metrics partition_metrics(real64[][] points, int[] labels, int count)
    int sample_size = int(len(points))
    int[] sizes = [for int k < count then 0]
    real64[][] centers = [for int k < count then [0.0, 0.0]]
    int[] occupied = []
    real64[] center = [0.0, 0.0]
    for real64[] point = points[]
        center[0] += point[0]
        center[1] += point[1]
    center[0] /= real64(sample_size)
    center[1] /= real64(sample_size)
    for int k < count
        for int i < sample_size
            if labels[i] == k
                sizes[k] += 1
                centers[k][0] += points[i][0]
                centers[k][1] += points[i][1]
        if sizes[k] > 0
            occupied = occupied.append(k)
            centers[k][0] /= real64(sizes[k])
            centers[k][1] /= real64(sizes[k])
    real64[] cluster = [for int k < count then 0.0]
    if len(occupied) < 2
        return Metrics(false, 0.0, 0.0, 0.0, cluster)
    real64 silhouette = 0.0
    for int i < sample_size
        int own = labels[i]
        real64 own_sum = 0.0
        real64 nearest = inf
        for int k = occupied[]
            real64 total = 0.0
            for int j < sample_size
                if labels[j] == k and j != i
                    total += kmeans.distance(points[i], points[j])
            if k == own
                own_sum = total
            elif total / real64(sizes[k]) < nearest
                nearest = total / real64(sizes[k])
        real64 score = 0.0
        if sizes[own] > 1
            real64 a = own_sum / real64(sizes[own] - 1)
            score = (nearest - a) / (if a > nearest then a else nearest)
        silhouette += score
        cluster[own] += score
    real64 between = 0.0
    real64 within = 0.0
    real64[] scatter = [for int k < count then 0.0]
    for int k = occupied[]
        cluster[k] /= real64(sizes[k])
        between += real64(sizes[k]) * kmeans.distance2(centers[k], center)
        for int i < sample_size
            if labels[i] == k
                scatter[k] += kmeans.distance(points[i], centers[k])
        scatter[k] /= real64(sizes[k])
    for int i < sample_size
        within += kmeans.distance2(points[i], centers[labels[i]])
    int groups = int(len(occupied))
    real64 ch = (between / real64(groups - 1)) / (within / real64(sample_size - groups))
    real64 db = 0.0
    for int k = occupied[]
        real64 worst = -inf
        for int other = occupied[]
            if other != k
                real64 candidate = (scatter[k] + scatter[other]) / kmeans.distance(centers[k], centers[other])
                if candidate > worst
                    worst = candidate
        db += worst
    return Metrics(true, silhouette / real64(sample_size), ch, db / real64(groups), cluster)

string metric_text(Metrics stats, int key)
    if not stats.valid
        return "-"
    return report.dec(if key == 0 then stats.silhouette elif key == 1 then stats.ch else stats.db)

class Means(real64[][] centers, int[] labels, int iterations, real64 inertia, int[] sizes)

(real64, int[]) cluster_statistics(int[][] clusters, real64[][] records)
    real64 total = 0.0
    int[] sizes = [for int j < int(len(clusters)) then 0]
    for real64[] row = records[]
        real64[] probabilities = []
        for int[] cluster = clusters[]
            real64 probability = 0.0
            for int k = cluster[]
                probability += row[k]
            probabilities = probabilities.append(probability)
        total += row_entropy(probabilities)
        sizes[winner(probabilities)] += 1
    return (total, sizes)

int[][] merge_clusters(int[][] source, int first, int second)
    int[][] result = []
    for int j < int(len(source))
        if j == second
            continue
        int[] cluster = source[j]
        if j == first
            cluster = cluster.concat(source[second]).sorted()
        result = result.append(cluster)
    return result

string cluster_name(int[] cluster)
    return [for int k = cluster[] then (k + 1).string()].join("+")

int[][] permutations(int[] prefix, int count)
    if int(len(prefix)) == count
        return [prefix]
    int[][] result = []
    for int k < count
        bool used = false
        for int value = prefix[]
            if value == k
                used = true
        if not used
            result = result.concat(permutations(prefix.append(k), count))
    return result

class Analysis(dataset.Input data)
    Fitted[] models = []
    Means[] means = []
    Fitted[] bic_ranked = []
    Fitted[] aic_ranked = []
    Fitted[] icl_ranked = []
    string[][] selection_blocks = []

    void .estimate()
        for int count = data.settings.ks[]
            real64[][] centers = [for real64[] component = data.initial[count][] then component[1:<3]]
            (real64[][] final_centers, int[] labels, int iterations, real64 inertia, int[] sizes) = kmeans.run(data.points, centers, data.settings.kmeans_iterations)
            means = means.append(Means(final_centers, labels, iterations, inertia, sizes))
            for int type_index < int(len(data.settings.types))
                string kind = data.settings.types[type_index]
                models = models.append(fit(data.points, data.initial[count], count, kind, type_index, data.settings))
        bic_ranked = ranking(models, 0)
        aic_ranked = ranking(models, 1)
        icl_ranked = ranking(models, 2)

    int means_index(int count)
        for int j < int(len(data.settings.ks))
            if data.settings.ks[j] == count
                return j
        return 0

    void model_files()
        string[][] blocks = []
        string[] trace_lines = ["K,type,iteration,loglik"]
        for Fitted fitted = models[]
            string[] block = ["model K={fitted.count} type={fitted.kind}", "parameters {fitted.p}", "loglik " + report.dec(fitted.loglik), "bic " + report.dec(fitted.bic), "aic " + report.dec(fitted.aic), "icl " + report.dec(fitted.icl), "mean_entropy " + report.dec(fitted.entropy_value / real64(len(data.points))), "settled_at {fitted.settled_at}", "largest_increase iteration {fitted.largest_t} value " + report.dec(fitted.largest_value), "violations {len(fitted.violations)}", "sizes " + report.integers(fitted.sizes)]
            for int k < fitted.count
                real64[] component = fitted.model[k]
                real64[] geometry = gaussian.eigen(component[3:<6])
                block = block.append("component {k + 1} weight " + report.dec(component[0]) + " mean " + report.values(component[1:<3]) + " cov " + report.values(component[3:<6]) + " axes " + report.values(geometry[5:<7]) + " angle " + report.dec(geometry[4]))
            blocks = blocks.append(block)
            for int t < int(len(fitted.trace))
                trace_lines = trace_lines.append("{fitted.count},{fitted.kind},{t}," + report.dec(fitted.trace[t]))
        report.write_blocks("models.txt", blocks)
        report.write_lines("loglik_trace.csv", trace_lines)
        Fitted selected = bic_ranked[0]
        Means km = means[means_index(selected.count)]
        string[] assignments = ["id,component,max_responsibility,log_density,kmeans_cluster"]
        for int i < int(len(data.points))
            real64 maximum = selected.records[i][winner(selected.records[i])]
            assignments = assignments.append("{data.ids[i]},{selected.labels[i] + 1}," + report.dec(maximum) + "," + report.dec(selected.densities[i]) + ",{km.labels[i] + 1}")
        report.write_lines("assignments.csv", assignments)

    void .rankings_and_partitions()
        Fitted selected = bic_ranked[0]
        string[] block = ["ranking by bic", "rank K type parameters loglik bic delta_bic aic aic_rank icl icl_rank"]
        for int j < int(len(bic_ranked))
            Fitted fitted = bic_ranked[j]
            real64 delta = real64(report.scaled(fitted.bic) - report.scaled(selected.bic)) / 10000.0
            block = block.append("{j + 1} {fitted.count} {fitted.kind} {fitted.p} " + report.dec(fitted.loglik) + " " + report.dec(fitted.bic) + " " + report.dec(delta) + " " + report.dec(fitted.aic) + " {rank_position(aic_ranked, fitted)} " + report.dec(fitted.icl) + " {rank_position(icl_ranked, fitted)}")
        block = block.concat(["selected K={selected.count} type={selected.kind}", "best_aic K={aic_ranked[0].count} type={aic_ranked[0].kind}", "best_icl K={icl_ranked[0].count} type={icl_ranked[0].kind}"])
        selection_blocks = selection_blocks.append(block)
        block = ["best K per type"]
        for string kind = data.settings.types[]
            Fitted[] subset = by_kind(models, kind)
            block = block.append("{kind} bic {ranking(subset, 0)[0].count} aic {ranking(subset, 1)[0].count} icl {ranking(subset, 2)[0].count}")
        selection_blocks = selection_blocks.append(block)
        Fitted[] best_models = []
        for int index < int(len(data.settings.ks))
            int count = data.settings.ks[index]
            Fitted best = ranking(by_count(models, count), 0)[0]
            best_models = best_models.append(best)
            Means km = means[index]
            Metrics gm_stats = partition_metrics(data.points, best.labels, count)
            Metrics km_stats = partition_metrics(data.points, km.labels, count)
            block = ["K={count} type={best.kind} bic " + report.dec(best.bic), "  kmeans iterations {km.iterations} inertia " + report.dec(km.inertia), "  ari " + ari(best.labels, km.labels, count, count), "  silhouette gmm " + metric_text(gm_stats, 0) + " kmeans " + metric_text(km_stats, 0), "  calinski_harabasz gmm " + metric_text(gm_stats, 1) + " kmeans " + metric_text(km_stats, 1), "  davies_bouldin gmm " + metric_text(gm_stats, 2) + " kmeans " + metric_text(km_stats, 2)]
            if index > 0
                Fitted previous = best_models[index - 1]
                int[][] matrix = contingency(previous.labels, best.labels, previous.count, count)
                string[] parents = []
                int[] shares = []
                for int k < count
                    int chosen = -1
                    int largest = 0
                    for int a < previous.count
                        if matrix[a][k] > largest
                            largest = matrix[a][k]
                            chosen = a
                    parents = parents.append(if chosen < 0 then "-" else (chosen + 1).string())
                    shares = shares.append(largest)
                block = block.append("  parents K={previous.count} " + parents.join(" ") + " shared " + report.integers(shares))
            selection_blocks = selection_blocks.append(block)
        block = ["violations"]
        for Fitted fitted = models[]
            for int t = fitted.violations[]
                block = block.append("K={fitted.count} type={fitted.kind} iteration {t} previous " + report.dec(fitted.trace[t - 1]) + " current " + report.dec(fitted.trace[t]))
        if len(block) == 1
            block = block.append("none")
        selection_blocks = selection_blocks.append(block)

    void .components_and_overlap()
        Fitted selected = bic_ranked[0]
        Metrics stats = partition_metrics(data.points, selected.labels, selected.count)
        string[] block = ["selected components"]
        for int k < selected.count
            real64[] component = selected.model[k]
            real64[] geometry = gaussian.eigen(component[3:<6])
            int[] observed = [for int j < int(len(data.settings.edges)) + 1 then 0]
            real64 soft = 0.0
            int inside_one = 0
            int inside_two = 0
            for int i < int(len(data.points))
                soft += selected.records[i][k]
                if selected.labels[i] == k
                    real64 q = gaussian.mahalanobis(data.points[i], component[1:<3], component[3:<6])
                    if q <= 1.0
                        inside_one += 1
                    if q <= 4.0
                        inside_two += 1
                    real64 rho = math.sqrt(q)
                    int bucket = 0
                    while bucket < int(len(data.settings.edges)) and rho >= data.settings.edges[bucket]
                        bucket += 1
                    observed[bucket] += 1
            real64[] expected = []
            real64 left = 0.0
            real64 chi = 0.0
            for int j < int(len(observed))
                real64 end_probability = 0.0
                if j < int(len(data.settings.edges))
                    real64 right = data.settings.edges[j]
                    end_probability = math.exp(-right * right / 2.0)
                real64 start_probability = math.exp(-left * left / 2.0)
                real64 expectation = real64(selected.sizes[k]) * (start_probability - end_probability)
                expected = expected.append(expectation)
                real64 delta = real64(observed[j]) - expectation
                chi += delta * delta / expectation
                if j < int(len(data.settings.edges))
                    left = data.settings.edges[j]
            block = block.append("component {k + 1} weight " + report.dec(component[0]) + " size {selected.sizes[k]} soft_size " + report.dec(soft) + " mean " + report.values(component[1:<3]))
            block = block.append("  cov " + report.values(component[3:<6]) + " corr " + report.dec(geometry[8]))
            block = block.append("  eigen " + report.values(geometry[0:<2]) + " direction " + report.values(geometry[2:<4]) + " angle " + report.dec(geometry[4]))
            block = block.append("  axes_1sigma " + report.values(geometry[5:<7]) + " axes_2sigma " + report.values([2.0 * geometry[5], 2.0 * geometry[6]]))
            block = block.append("  inside_1sigma {inside_one} inside_2sigma {inside_two} area_1sigma " + report.dec(geometry[7]))
            block = block.append("  silhouette " + (if stats.valid and selected.sizes[k] > 0 then report.dec(stats.cluster[k]) else "-"))
            block = block.append("  gof observed " + report.integers(observed) + " expected " + report.values(expected) + " chi2 " + report.dec(chi))
        selection_blocks = selection_blocks.append(block)
        block = ["overlap"]
        for int first < selected.count - 1
            for first + 1 <= int second < selected.count
                real64[] overlap = gaussian.bhattacharyya(selected.model[first], selected.model[second])
                real64 shared = 0.0
                for real64[] row = selected.records[]
                    shared += row[first] * row[second]
                block = block.append("{first + 1}-{second + 1} bhattacharyya " + report.dec(overlap[0]) + " coefficient " + report.dec(overlap[1]) + " shared " + report.dec(shared))
        if len(block) == 1
            block = block.append("none")
        selection_blocks = selection_blocks.append(block)

    void .merging()
        Fitted selected = bic_ranked[0]
        int[][] clusters = [for int k < selected.count then [k]]
        (real64 start_entropy, int[] initial_sizes) = cluster_statistics(clusters, selected.records)
        string[] block = ["merging", "start entropy " + report.dec(start_entropy)]
        int step = 0
        while len(clusters) > 1
            int[][] best = []
            int first = -1
            int second = -1
            real64 best_entropy = inf
            int[] best_sizes = []
            for int a < int(len(clusters)) - 1
                for a + 1 <= int b < int(len(clusters))
                    int[][] proposed = merge_clusters(clusters, a, b)
                    (real64 total, int[] sizes) = cluster_statistics(proposed, selected.records)
                    if first < 0 or report.scaled(total) < report.scaled(best_entropy)
                        best = proposed
                        first = a
                        second = b
                        best_entropy = total
                        best_sizes = sizes
            step += 1
            block = block.append("step {step} merge " + cluster_name(clusters[first]) + " " + cluster_name(clusters[second]) + " entropy " + report.dec(best_entropy) + " sizes " + report.integers(best_sizes))
            clusters = best
        selection_blocks = selection_blocks.append(block)

    void .kmeans_comparison_and_refit()
        Fitted selected = bic_ranked[0]
        Means km = means[means_index(selected.count)]
        int sample_size = int(len(data.points))
        int[][] matrix = contingency(selected.labels, km.labels, selected.count, selected.count)
        int[] best_permutation = []
        int agreement = -1
        for int[] permutation = permutations([], selected.count)[]
            int total = 0
            for int j < selected.count
                total += matrix[permutation[j]][j]
            if total > agreement
                agreement = total
                best_permutation = permutation
        string[] block = ["kmeans K={selected.count}", "iterations {km.iterations}", "inertia " + report.dec(km.inertia), "sizes " + report.integers(km.sizes)]
        for int k < selected.count
            block = block.append("center {k + 1} " + report.values(km.centers[k]))
        block = block.append("contingency")
        for int[] row = matrix[]
            block = block.append(report.integers(row))
        block = block.append("ari " + ari(selected.labels, km.labels, selected.count, selected.count))
        block = block.append("matching " + report.integers([for int k = best_permutation[] then k + 1]))
        block = block.append("agreement {agreement}/{sample_size} " + report.dec(real64(agreement) / real64(sample_size)))
        int disagreements = 0
        for int i < sample_size
            int cluster = km.labels[i]
            if best_permutation[cluster] != selected.labels[i]
                disagreements += 1
                real64 maximum = selected.records[i][winner(selected.records[i])]
                block = block.append("disagree {data.ids[i]} gmm {selected.labels[i] + 1} kmeans {cluster + 1} max " + report.dec(maximum))
        block = block.append("disagreements {disagreements}")
        selection_blocks = selection_blocks.append(block)
        real64[][] initial = []
        for int k < selected.count
            real64 a = 0.0
            real64 b = 0.0
            real64 c = 0.0
            for int i < sample_size
                if km.labels[i] == k
                    real64 dx = data.points[i][0] - km.centers[k][0]
                    real64 dy = data.points[i][1] - km.centers[k][1]
                    a += dx * dx
                    b += dx * dy
                    c += dy * dy
            real64 size = real64(km.sizes[k])
            initial = initial.append([size / real64(sample_size), km.centers[k][0], km.centers[k][1], a / size + data.settings.epsilon, b / size, c / size + data.settings.epsilon])
        Fitted refit = fit(data.points, initial, selected.count, selected.kind, selected.type_index, data.settings)
        block = ["refit_from_kmeans K={selected.count} type={selected.kind}", "loglik " + report.dec(refit.loglik) + " bic " + report.dec(refit.bic) + " settled_at {refit.settled_at}", "sizes " + report.integers(refit.sizes), "ari_vs_selected " + ari(selected.labels, refit.labels, selected.count, selected.count)]
        selection_blocks = selection_blocks.append(block)

    void .cross_validation()
        Fitted selected = bic_ranked[0]
        int folds = data.settings.folds
        string[] block = ["cross_validation K={selected.count} type={selected.kind} folds {folds}"]
        real64 total = 0.0
        for int fold < folds
            real64[][] training = []
            real64[][] testing = []
            for int i < int(len(data.points))
                if i % folds == fold
                    testing = testing.append(data.points[i])
                else
                    training = training.append(data.points[i])
            (real64[][] model, real64[][] records, real64[] densities, real64[] trace) = em.run(training, data.initial[selected.count], selected.kind, data.settings.iterations, data.settings.epsilon)
            (real64[][] test_records, real64[] test_densities, real64 test_total) = em.expectation(testing, model)
            real64 train_loglik = trace[int(len(trace)) - 1] / real64(len(training))
            real64 test_loglik = test_total / real64(len(testing))
            total += test_loglik
            block = block.append("fold {fold + 1} train {len(training)} test {len(testing)} train_loglik " + report.dec(train_loglik) + " test_loglik " + report.dec(test_loglik))
        block = block.append("mean_test_loglik " + report.dec(total / real64(folds)))
        selection_blocks = selection_blocks.append(block)

    int[] point_order(Fitted selected, bool uncertain_points)
        int[] result = []
        for int i < int(len(data.points))
            real64 score = if uncertain_points then selected.records[i][winner(selected.records[i])] else selected.densities[i]
            real64 threshold = if uncertain_points then data.settings.uncertain else data.settings.low_density
            if score >= threshold
                continue
            int key = report.scaled(score)
            int[] updated = []
            bool added = false
            for int previous = result[]
                real64 previous_score = if uncertain_points then selected.records[previous][winner(selected.records[previous])] else selected.densities[previous]
                if not added and key < report.scaled(previous_score)
                    updated = updated.append(i)
                    added = true
                updated = updated.append(previous)
            if not added
                updated = updated.append(i)
            result = updated
        return result

    void .uncertain_and_outliers()
        Fitted selected = bic_ranked[0]
        int[] uncertain = point_order(selected, true)
        string[] block = ["uncertain threshold " + report.dec(data.settings.uncertain)]
        for int i = uncertain[]
            real64[] row = selected.records[i]
            block = block.append("{data.ids[i]} component {selected.labels[i] + 1} max " + report.dec(row[winner(row)]) + " responsibilities " + report.values(row))
        block = block.append("count {len(uncertain)}")
        selection_blocks = selection_blocks.append(block)
        int[] outliers = point_order(selected, false)
        block = ["outliers threshold " + report.dec(data.settings.low_density)]
        for int i = outliers[]
            int k = selected.labels[i]
            real64 q = gaussian.mahalanobis(data.points[i], selected.model[k][1:<3], selected.model[k][3:<6])
            block = block.append("{data.ids[i]} component {k + 1} log_density " + report.dec(selected.densities[i]) + " q " + report.dec(q))
        block = block.append("count {len(outliers)}")
        selection_blocks = selection_blocks.append(block)

    int[] map_cell(real64[] point)
        real64 dx = (data.settings.xmax - data.settings.xmin) / real64(data.settings.width)
        real64 dy = (data.settings.ymax - data.settings.ymin) / real64(data.settings.height)
        int column = math.floor((point[0] - data.settings.xmin) / dx)
        int row = math.floor((data.settings.ymax - point[1]) / dy)
        return [int(column), int(row)]

    bool valid_cell(int[] cell)
        return 0 <= cell[0] < data.settings.width and 0 <= cell[1] < data.settings.height

    string[] map_rows(string[][] grid)
        return [for string[] row = grid[] then row.join("")]

    void map_file()
        Fitted selected = bic_ranked[0]
        dataset.Settings settings = data.settings
        int width = settings.width
        int height = settings.height
        real64 dx = (settings.xmax - settings.xmin) / real64(width)
        real64 dy = (settings.ymax - settings.ymin) / real64(height)
        real64[][][] coordinates = []
        real64[][] densities = []
        real64[][][] responsibilities = []
        int[][] winners = []
        real64 maximum = 0.0
        real64 mass = 0.0
        for int row < height
            real64[][] coordinate_row = []
            real64[] density_row = []
            real64[][] responsibility_row = []
            int[] winner_row = []
            for int column < width
                real64[] point = [settings.xmin + (real64(column) + 0.5) * dx, settings.ymax - (real64(row) + 0.5) * dy]
                coordinate_row = coordinate_row.append(point)
                real64[] scores = []
                real64 density = 0.0
                real64 max_score = -inf
                for real64[] component = selected.model[]
                    real64 score = gaussian.log_density(point, component)
                    scores = scores.append(score)
                    real64 term = math.exp(score)
                    density += term
                    if score > max_score
                        max_score = score
                real64[] probabilities = []
                real64 normalizer = 0.0
                for real64 score = scores[]
                    real64 term = math.exp(score - max_score)
                    probabilities = probabilities.append(term)
                    normalizer += term
                for auto &probability = &probabilities[]
                    probability /= normalizer
                density_row = density_row.append(density)
                responsibility_row = responsibility_row.append(probabilities)
                winner_row = winner_row.append(winner(scores))
                if density > maximum
                    maximum = density
                mass += density
            coordinates = coordinates.append(coordinate_row)
            densities = densities.append(density_row)
            responsibilities = responsibilities.append(responsibility_row)
            winners = winners.append(winner_row)
        string[][] density_map = [for int row < height then [for int column < width then " "]]
        string[][] region_map = density_map
        string[][] uncertainty_map = density_map
        string[][] point_map = density_map
        int[] level_counts = [for int level < 10 then 0]
        for int row < height
            for int column < width
                int raw = math.floor(10.0 * densities[row][column] / maximum)
                int level = int(raw)
                if level > 9
                    level = 9
                level_counts[level] += 1
                density_map[row][column] = report.levels[level]
                region_map[row][column] = (winners[row][column] + 1).string()
                int uncertainty_level = 0
                if selected.count >= 2
                    real64 denominator = math.log(real64(selected.count))
                    int scaled_entropy = math.floor(10.0 * row_entropy(responsibilities[row][column]) / denominator)
                    uncertainty_level = int(scaled_entropy)
                    if uncertainty_level < 0
                        uncertainty_level = 0
                    elif uncertainty_level > 9
                        uncertainty_level = 9
                uncertainty_map[row][column] = report.levels[uncertainty_level]
                bool contour = false
                for real64[] component = selected.model[]
                    if gaussian.mahalanobis(coordinates[row][column], component[1:<3], component[3:<6]) > 4.0
                        continue
                    for int[] offset = [[0, -1], [0, 1], [-1, 0], [1, 0]][]
                        int[] neighbor = [column + offset[0], row + offset[1]]
                        if valid_cell(neighbor) and gaussian.mahalanobis(coordinates[neighbor[1]][neighbor[0]], component[1:<3], component[3:<6]) > 4.0
                            contour = true
                            break
                    if contour
                        break
                point_map[row][column] = if contour then "." else " "
        for int k < selected.count
            int[] cell = map_cell(selected.model[k][1:<3])
            if valid_cell(cell)
                density_map[cell[1]][cell[0]] = (k + 1).string()
        int[][] bins = [for int row < height then [for int column < width then -1]]
        int outside = 0
        for int i < int(len(data.points))
            int[] cell = map_cell(data.points[i])
            if not valid_cell(cell)
                outside += 1
                continue
            int previous = bins[cell[1]][cell[0]]
            if previous == -1
                bins[cell[1]][cell[0]] = selected.labels[i]
            elif previous != selected.labels[i]
                bins[cell[1]][cell[0]] = -2
        for int row < height
            for int column < width
                int component = bins[row][column]
                if component == -2
                    point_map[row][column] = "*"
                elif component >= 0
                    point_map[row][column] = (component + 1).string()
        string[] rows = ["density K={selected.count} type={selected.kind}", "x " + report.dec(settings.xmin) + " " + report.dec(settings.xmax) + " y " + report.dec(settings.ymin) + " " + report.dec(settings.ymax) + " grid {width}x{height}", "max_density " + report.dec(maximum, 6) + " mass_in_map " + report.dec(mass * dx * dy)]
        rows = rows.concat(report.framed(map_rows(density_map)))
        for int level < 10
            rows = rows.append("level {level} {DQ}{report.levels[level]}{DQ} from " + report.dec(real64(level) * maximum / 10.0, 6) + " cells {level_counts[level]}")
        rows = rows.concat(["", "regions"]).concat(report.framed(map_rows(region_map)))
        rows = rows.concat(["", "uncertainty"]).concat(report.framed(map_rows(uncertainty_map)))
        rows = rows.concat(["", "points"]).concat(report.framed(map_rows(point_map)))
        rows = rows.append("outside {outside}")
        report.write_lines("density_map.txt", rows)

    void .run()
        .estimate()
        model_files()
        .rankings_and_partitions()
        .components_and_overlap()
        .merging()
        .kmeans_comparison_and_refit()
        .cross_validation()
        .uncertain_and_outliers()
        report.write_blocks("selection.txt", selection_blocks)
        map_file()

void run()
    auto analysis = Analysis(dataset.read_inputs())
    .analysis.run()

run()
