import math

const string levels = " .:-=+*#%@"

int power10(int places)
    int result = 1
    for int j < places
        result *= 10
    return result

int scaled(real64 value, int places = 4)
    real64 absolute = if value < 0.0 then -value else value
    real64 rounded = math.floor(absolute * real64(power10(places)) + 0.5)
    int result = int(rounded)
    return if value < 0.0 then -result else result

string dec(real64 value, int places = 4)
    int rounded = scaled(value, places)
    string sign = if rounded < 0 then "-" else ""
    int magnitude = if rounded < 0 then -rounded else rounded
    int scale = power10(places)
    string tail = (magnitude % scale).string()
    return sign + (magnitude / scale).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string optional(real64 | none value)
    match value
        real64 present
            return dec(present)
        none
            return "-"

string integers(int[] values)
    return [for int value = values[] then value.string()].join(" ")

string values(real64[] numbers)
    return [for real64 value = numbers[] then dec(value)].join(" ")

string[] framed(string[] grid)
    string border = "+" + string.repeat("-", len(grid[0])) + "+"
    string[] rows = [border]
    for string row = grid[]
        rows = rows.append("|" + row + "|")
    return rows.append(border)

void write_lines(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)

void write_blocks(string name, string[][] blocks)
    string[] rows = []
    for int j < int(len(blocks))
        if j > 0
            rows = rows.append("")
        rows = rows.concat(blocks[j])
    write_lines(name, rows)
