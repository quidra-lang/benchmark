import math

real64 distance2(real64[] first, real64[] second)
    dx := first[0] - second[0]
    dy := first[1] - second[1]
    return dx * dx + dy * dy

real64 distance(real64[] first, real64[] second)
    result := math.sqrt(distance2(first, second))
    return result

int[] assign(real64[][] points, real64[][] centers)
    int[] labels := []
    for point := points[]
        chosen := 0
        real64 best := inf
        for: k < int(len(centers))
            candidate := distance2(point, centers[k])
            if candidate < best
                chosen = k
                best = candidate
        labels = labels.append(chosen)
    return labels

(real64[][], int[], int, real64, int[]) run(real64[][] points, real64[][] initial, int maximum)
    centers := initial
    labels := assign(points, centers)
    iterations := 0
    for: 1 <= iteration <= maximum
        real64[][] updated := []
        for: k < int(len(centers))
            real64 sx := 0.0
            real64 sy := 0.0
            count := 0
            for: i < int(len(points))
                if labels[i] == k
                    sx += points[i][0]
                    sy += points[i][1]
                    count += 1
            updated = updated.append(if count == 0 then centers[k] else [sx / real64(count), sy / real64(count)])
        centers = updated
        next_labels := assign(points, centers)
        same := labels == next_labels
        labels = next_labels
        iterations = iteration
        if same
            break
    real64 inertia := 0.0
    sizes := [for k := (0:<int(len(centers)))[] then 0]
    for: i < int(len(points))
        sizes[labels[i]] += 1
        inertia += distance2(points[i], centers[labels[i]])
    return (centers, labels, iterations, inertia, sizes)
