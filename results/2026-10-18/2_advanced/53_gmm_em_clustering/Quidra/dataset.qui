int integer(string text)
    int value = int.parse(text)
    return value

real64 number(string text)
    real64 value = real64.parse(text)
    return value

string[] lines(string path)
    string content = file.read(path)
    string[] rows = content.split(NL)
    return rows[0:<int(len(rows)) - 1]

class Settings(local string[][] rows)
    int[] ks = [for string text = rows[0][1:<int(len(rows[0]))][] then integer(text)]
    int iterations = integer(rows[1][1])
    string[] types = rows[2][1:<int(len(rows[2]))]
    real64 epsilon = number(rows[3][1])
    real64 tolerance = number(rows[4][1])
    int kmeans_iterations = integer(rows[5][1])
    int folds = integer(rows[6][1])
    real64 uncertain = number(rows[7][1])
    real64 low_density = number(rows[8][1])
    real64[] edges = [for string text = rows[9][1:<int(len(rows[9]))][] then number(text)]
    real64 xmin = number(rows[10][1])
    real64 xmax = number(rows[10][2])
    real64 ymin = number(rows[11][1])
    real64 ymax = number(rows[11][2])
    int width = integer(rows[12][1])
    int height = integer(rows[12][2])

class Input(string[] ids, real64[][] points, real64[][][] initial, Settings settings)

Input read_inputs()
    string[] ids = []
    real64[][] points = []
    string[] rows = lines("input/points.csv")
    for string row = rows[1:<int(len(rows))][]
        string[] fields = row.split(",")
        ids = ids.append(fields[0])
        points = points.append([number(fields[1]), number(fields[2])])
    real64[][][] initial = [[], [], [], [], []]
    int count = 0
    real64[] weights = []
    for string row = lines("input/init.txt")[]
        if row == ""
            continue
        string[] fields = row.split(" ")
        if fields[0] == "K"
            count = integer(fields[1])
        elif fields[0] == "W"
            weights = [for string text = fields[1:<int(len(fields))][] then number(text)]
        else
            int component = integer(fields[1]) - 1
            real64[] values = [weights[component]]
            for 2 <= int j < 7
                values = values.append(number(fields[j]))
            initial[count] = initial[count].append(values)
    string[][] parameters = [for string row = lines("input/params.txt")[] then row.split(" ")]
    return Input(ids, points, initial, Settings(parameters))
