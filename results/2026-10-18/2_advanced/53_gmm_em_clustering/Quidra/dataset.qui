int integer(string text)
    value := int(text)
    return value

real64 number(string text)
    value := real64(text)
    return value

string[] lines(string path)
    content := string.from_utf8(file.read_bin(path))
    rows := content.split(NL)
    return rows[0:<int(#rows) - 1]

class Settings(local string[][] rows)
    ks := [for text := rows[0][1:<int(#rows[0])][] then integer(text)]
    iterations := integer(rows[1][1])
    types := rows[2][1:<int(#rows[2])]
    epsilon := number(rows[3][1])
    tolerance := number(rows[4][1])
    kmeans_iterations := integer(rows[5][1])
    folds := integer(rows[6][1])
    uncertain := number(rows[7][1])
    low_density := number(rows[8][1])
    edges := [for text := rows[9][1:<int(#rows[9])][] then number(text)]
    xmin := number(rows[10][1])
    xmax := number(rows[10][2])
    ymin := number(rows[11][1])
    ymax := number(rows[11][2])
    width := integer(rows[12][1])
    height := integer(rows[12][2])

class Input(string[] ids, real64[][] points, real64[][][] initial, Settings settings)

Input read_inputs()
    string[] ids := []
    real64[][] points := []
    rows := lines("input/points.csv")
    for row := rows[1:<int(#rows)][]
        fields := row.split(",")
        ids = ids.append(fields[0])
        points = points.append([number(fields[1]), number(fields[2])])
    real64[][][] initial := [[], [], [], [], []]
    count := 0
    real64[] weights := []
    for row := lines("input/init.txt")[]
        if row == ""
            continue
        fields := row.split(" ")
        if fields[0] == "K"
            count = integer(fields[1])
        elif fields[0] == "W"
            weights = [for text := fields[1:<int(#fields)][] then number(text)]
        else
            component := integer(fields[1]) - 1
            values := [weights[component]]
            for: 2 <= j < 7
                values = values.append(number(fields[j]))
            initial[count] = initial[count].append(values)
    parameters := [for row := lines("input/params.txt")[] then row.split(" ")]
    return Input(ids, points, initial, Settings(parameters))
