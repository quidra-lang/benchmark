import enrolment = "./enrolment.qui"

class Room(string id, int capacity)
class Placement(int course, int room, int first, int last)
class Packing(bool success, Placement[] placements)

Room[] load(string[] &errors)
    Room[] result = []
    string[] lines = enrolment.read_lines("input/rooms.csv")
    for 1 <= int i < int(len(lines))
        string[] fields = lines[i].split(",")
        string id = fields[0]
        int capacity = int.parse(fields[1])
        bool duplicate = false
        for Room room = result[]
            if room.id == id
                duplicate = true
        if duplicate
            errors = errors.append("rooms.csv line {i + 1}: duplicate room {id}")
        elif capacity < 1
            errors = errors.append("rooms.csv line {i + 1}: bad capacity {capacity}")
        else
            int position = int(len(result))
            result = result.append(Room(id, capacity))
            while position > 0
                Room previous = result[position - 1]
                if previous.capacity < capacity or (previous.capacity == capacity and previous.id < id)
                    break
                result[position] = previous
                position -= 1
            result[position] = Room(id, capacity)
    return result

int[] by_size(enrolment.Course[] courses, int[] selected)
    int[] result = []
    for int c = selected[]
        int position = int(len(result))
        result = result.append(c)
        while position > 0
            int previous = result[position - 1]
            if len(courses[previous].students) > len(courses[c].students) or (len(courses[previous].students) == len(courses[c].students) and previous < c)
                break
            result[position] = previous
            position -= 1
        result[position] = c
    return result

Packing pack(Room[] available, enrolment.Course[] courses, int[] selected)
    int[] remaining = []
    for Room room = available[]
        remaining = remaining.append(room.capacity)
    int[] durations = array(len(available), fill = 0)
    Placement[] placements = []
    for int c = by_size(courses, selected)[]
        int count = int(len(courses[c].students))
        bool placed = false
        for int r < int(len(available))
            if remaining[r] >= count and (durations[r] == 0 or durations[r] == courses[c].duration)
                int first = available[r].capacity - remaining[r] + 1
                placements = placements.append(Placement(c, r, first, first + count - 1))
                remaining[r] -= count
                durations[r] = courses[c].duration
                placed = true
                break
        if not placed
            return Packing(false, [])
    return Packing(true, placements)
