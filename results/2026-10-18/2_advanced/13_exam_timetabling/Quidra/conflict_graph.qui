import enrolment = "./enrolment.qui"

class Graph(enrolment.Course[] courses, local enrolment.Student[] students)
    int count = int(len(courses))
    int[] shared = array(nat(count * count), fill = 0)
    int[] vertices = []
    int[] degrees = array(nat(count), fill = 0)
    for int c < count
        if len(courses[c].students) > 0
            vertices = vertices.append(c)
    for enrolment.Student student = students[]
        for int i < int(len(student.courses))
            for i + 1 <= int j < int(len(student.courses))
                int a = student.courses[i]
                int b = student.courses[j]
                shared[a * count + b] += 1
                shared[b * count + a] += 1
    for int a < count
        for int b < count
            if shared[a * count + b] > 0
                degrees[a] += 1

    int strength(int a, int b)
        return shared[a * count + b]

    int shared_total(int c)
        int total = 0
        for int other < count
            total += strength(c, other)
        return total

    int[] by_degree(int[] selected)
        int[] result = []
        for int c = selected[]
            int position = int(len(result))
            result = result.append(c)
            while position > 0
                int previous = result[position - 1]
                if degrees[previous] > degrees[c] or (degrees[previous] == degrees[c] and previous < c)
                    break
                result[position] = previous
                position -= 1
            result[position] = c
        return result

    int[][] components()
        bool[] seen = array(nat(count), fill = false)
        int[][] result = []
        for int start = vertices[]
            if seen[start]
                continue
            int[] group = [start]
            seen[start] = true
            int position = 0
            while position < int(len(group))
                for int other = vertices[]
                    if strength(group[position], other) > 0 and not seen[other]
                        seen[other] = true
                        group = group.append(other)
                position += 1
            group = group.sorted()
            int at = int(len(result))
            result = result.append(group)
            while at > 0
                int[] previous = result[at - 1]
                if len(previous) > len(group) or (len(previous) == len(group) and previous[0] < group[0])
                    break
                result[at] = previous
                at -= 1
            result[at] = group
        return result

    int[] clique(int[] candidates)
        int[] result = []
        while len(candidates) > 0
            int chosen = by_degree(candidates)[0]
            result = result.append(chosen)
            int[] next = []
            for int c = candidates[]
                if strength(chosen, c) > 0
                    next = next.append(c)
            candidates = next
        return result

    int[] chain(int[] assignment, int start, int home, int target)
        int[] result = [start]
        bool[] seen = array(nat(count), fill = false)
        seen[start] = true
        int position = 0
        while position < int(len(result))
            for int other = vertices[]
                if not seen[other] and strength(result[position], other) > 0 and (assignment[other] == home or assignment[other] == target)
                    seen[other] = true
                    result = result.append(other)
            position += 1
        return result.sorted()

bool reachable(int[] arrows, int count, int source, int target)
    int[] queue = [source]
    bool[] seen = array(nat(count), fill = false)
    seen[source] = true
    int position = 0
    while position < int(len(queue))
        int current = queue[position]
        if current == target
            return true
        for int next < count
            if arrows[current * count + next] > 0 and not seen[next]
                seen[next] = true
                queue = queue.append(next)
        position += 1
    return false
