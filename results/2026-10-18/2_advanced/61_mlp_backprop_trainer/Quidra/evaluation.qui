import math

string padded(int value, int width)
    string text = value.string()
    return string.repeat("0", nat(width - int(len(text)))) + text

string real_text(real64 value, int places)
    int factor = 10 ^ places
    real64 magnitude = if value < 0.0 then -value else value
    int rounded = math.floor(magnitude * real64(factor) + 0.5)
    string sign_text = if value < 0.0 and rounded != 0 then "-" else ""
    return sign_text + (rounded / factor).string() + "." + padded(rounded % factor, places)

string ratio(int numerator, int denominator)
    if denominator == 0
        return "-"
    int rounded = (20000 * numerator + denominator) / (2 * denominator)
    return (rounded / 10000).string() + "." + padded(rounded % 10000, 4)

int[] best_two(real64[] scores)
    int first = 0
    for int i < int(len(scores))
        if scores[i] > scores[first]
            first = i
    int second = if first == 0 then 1 else 0
    for int i < int(len(scores))
        if i != first and scores[i] > scores[second]
            second = i
    return [first, second]

int[][] confusion(int[] labels, int[] predictions, int classes)
    int[][] table = [for int k < classes then [for int j < classes then 0]]
    for int i < int(len(labels))
        table[labels[i]][predictions[i]] += 1
    return table

class Measures(int support, int predicted, string precision, string recall, string f1)

Measures class_measures(int[][] table, int klass)
    int support = 0
    int predicted = 0
    for int i < int(len(table))
        support += table[klass][i]
        predicted += table[i][klass]
    int correct = table[klass][klass]
    return Measures(support, predicted, ratio(correct, predicted), ratio(correct, support), ratio(2 * correct, support + predicted))

string[] level_maps(int[][] levels, int width, int height)
    string[] rows = []
    for int row < height
        string[] maps = []
        for int[] level = levels[]
            maps = maps.append([for int column < width then level[row * width + column].string()].join(""))
        rows = rows.append(maps.join(" "))
    return rows

string[] ascii_image(string pixels, int width)
    string[] rows = []
    for 0 <= int first < int(len(pixels)) step width
        rows = rows.append([for int i < width then (if pixels[first + i] == "1" then "#" else ".")].join(""))
    return rows
