import layers = "./layers.qui"

class Layer(int inputs, int outputs, string activation, int weight_start, int weight_end, int bias_start, int bias_end)
class Layout(Layer[] levels, bool[] is_weight, int parameters, int weight_count)

Layout layout_for(int inputs, int[] units, string[] activations)
    Layer[] levels = []
    bool[] is_weight = []
    int previous = inputs
    int index = 0
    int weight_count = 0
    for int i < int(len(units))
        int outputs = units[i]
        int weights = outputs * previous
        levels = levels.append(Layer(previous, outputs, activations[i], index, index + weights, index + weights, index + weights + outputs))
        is_weight = is_weight.concat([for int p < weights then true]).concat([for int p < outputs then false])
        weight_count += weights
        index += weights + outputs
        previous = outputs
    return Layout(levels, is_weight, index, weight_count)

real64[][] layer_weights(real64[] theta, Layer level)
    return [for int j < level.outputs then theta[level.weight_start + j * level.inputs:<level.weight_start + (j + 1) * level.inputs]]

class Cache(real64[][] z, real64[][] a, real64[][][] weights, real64[] scores, real64 loss, real64[] output_delta)

Cache forward(Layout layout, real64[] theta, real64[] input, int label)
    real64[][] activations = [input]
    real64[][] preactivations = []
    real64[][][] all_weights = []
    real64[] scores = []
    real64[] output_delta = []
    real64 loss = 0.0
    for int index < int(len(layout.levels))
        Layer level = layout.levels[index]
        real64[][] weights = layer_weights(theta, level)
        real64[] biases = theta[level.bias_start:<level.bias_end]
        all_weights = all_weights.append(weights)
        real64[] z = layers.pre_activation(weights, biases, activations[index])
        preactivations = preactivations.append(z)
        if index == int(len(layout.levels)) - 1
            layers.Output output = layers.output_scores(level.activation, z, label)
            scores = output.scores
            output_delta = output.delta
            loss = output.loss
            activations = activations.append(scores)
        else
            activations = activations.append([for real64 value = z[] then layers.hidden_activation(level.activation, value)])
    return Cache(preactivations, activations, all_weights, scores, loss, output_delta)

class Gradient(real64[] values, Cache cache, real64[] input_gradient)

Gradient gradient(Layout layout, real64[] theta, real64[] input, int label, bool include_input = false)
    Cache cache = forward(layout, theta, input, label)
    int count = int(len(layout.levels))
    real64[][] deltas = [for int i < count then []]
    deltas[count - 1] = cache.output_delta
    int index = count - 2
    while index >= 0
        real64[] propagated = layers.backward_sum(cache.weights[index + 1], deltas[index + 1])
        Layer level = layout.levels[index]
        deltas[index] = [for int j < level.outputs then propagated[j] * layers.hidden_derivative(level.activation, cache.z[index][j], cache.a[index + 1][j])]
        index -= 1
    real64[] values = [for int p < layout.parameters then 0.0]
    for int i < count
        Layer level = layout.levels[i]
        int destination = level.weight_start
        for int j < level.outputs
            for int k < level.inputs
                values[destination] = deltas[i][j] * cache.a[i][k]
                destination += 1
        for int j < level.outputs
            values[level.bias_start + j] = deltas[i][j]
    real64[] input_gradient = if include_input then layers.backward_sum(cache.weights[0], deltas[0]) else []
    return Gradient(values, cache, input_gradient)

class Mean(real64[] values, real64 loss)

Mean average_gradient(Layout layout, real64[] theta, real64[][] inputs, int[] labels)
    real64[] values = [for int p < layout.parameters then 0.0]
    real64 loss = 0.0
    for int i < int(len(inputs))
        Gradient result = gradient(layout, theta, inputs[i], labels[i])
        loss += result.cache.loss
        for int p < layout.parameters
            values[p] += result.values[p]
    real64 count = real64(len(inputs))
    return Mean([for real64 value = values[] then value / count], loss / count)
