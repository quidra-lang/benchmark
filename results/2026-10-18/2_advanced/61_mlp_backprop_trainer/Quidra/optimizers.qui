import math

class State(string kind, real64[] extra, int count)
    real64[] momentum = [for int p < count then 0.0]
    real64[] first = [for int p < count then 0.0]
    real64[] second = [for int p < count then 0.0]
    real64 power1 = 1.0
    real64 power2 = 1.0

real64 epoch_rate(real64 initial, int epoch, int step, real64 gamma)
    real64 rate = initial
    for int i < (epoch - 1) / step
        rate *= gamma
    return rate

void update(real64[] &theta, real64[] gradient, State &state, real64 rate)
    if state.kind == "SGD"
        for int p < int(len(theta))
            theta[p] -= rate * gradient[p]
    elif state.kind == "MOMENTUM"
        real64 mu = state.extra[0]
        for int p < int(len(theta))
            state.momentum[p] = mu * state.momentum[p] + gradient[p]
            theta[p] -= rate * state.momentum[p]
    else
        real64 beta1 = state.extra[0]
        real64 beta2 = state.extra[1]
        real64 epsilon = state.extra[2]
        state.power1 *= beta1
        state.power2 *= beta2
        for int p < int(len(theta))
            real64 value = gradient[p]
            state.first[p] = beta1 * state.first[p] + (1.0 - beta1) * value
            state.second[p] = beta2 * state.second[p] + (1.0 - beta2) * value * value
            real64 corrected_first = state.first[p] / (1.0 - state.power1)
            real64 corrected_second = state.second[p] / (1.0 - state.power2)
            real64 root = math.sqrt(corrected_second)
            theta[p] -= rate * corrected_first / (root + epsilon)
