string lowercase_symbol(string symbol)
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string lower = "abcdefghijklmnopqrstuvwxyz"
    match upper.find(symbol)
        nat found
            return lower[found]
        none
            return symbol

bool is_bigram(string term)
    return term.contains("_")

class Tokens(local string article, local set.Set<string> stops)
    int raw_count = 0
    int stopword_count = 0
    int short_count = 0
    string[] words = []
    string[] bigrams = []
    string[] combined = []
    local string[] extracted = []
    local string current = ""
    for int position < int(len(article))
        string symbol = lowercase_symbol(article[position])
        if "abcdefghijklmnopqrstuvwxyz0123456789".contains(symbol)
            current += symbol
        elif current != ""
            extracted = extracted.append(current)
            current = ""
    if current != ""
        extracted = extracted.append(current)
    raw_count = int(len(extracted))
    for string word = extracted[]
        if stops.has(word)
            stopword_count += 1
        elif len(word) == 1
            short_count += 1
        else
            words = words.append(word)
    for int position < int(len(words)) - 1
        bigrams = bigrams.append(words[position] + "_" + words[position + 1])
    combined = words.concat(bigrams)

    string[] terms(bool include_bigrams)
        return if include_bigrams then combined else words
