import math
import bayes = "./naive_bayes.qui"

real64 vector_length(real64[] values)
    return math.sqrt(math.sum(values * values))

class Centroids(local int[][] encoded, local int[] labels, local int classes, local int[] frequencies)
    real64[] idf = [for int frequency = frequencies[] then math.log(real64(len(encoded)) / real64(frequency))]
    real64[][] centers = array(nat(classes), fill = array(len(frequencies), fill = 0.0))
    real64[] lengths = []
    local int[] documents = array(nat(classes), fill = 0)
    for int document < int(len(encoded))
        int category = labels[document]
        documents[category] += 1
        int[] counts = array(len(frequencies), fill = 0)
        for int term = encoded[document][]
            counts[term] += 1
        real64[] values = [for int count = counts[] then real64(count)] * idf
        real64 magnitude = vector_length(values)
        if magnitude > 0.0
            centers[category] = centers[category] + values / magnitude
    for int category < classes
        centers[category] = centers[category] / real64(documents[category])
        lengths = lengths.append(vector_length(centers[category]))

    real64[] vector(int[] sequence)
        int[] counts = array(len(idf), fill = 0)
        for int term = sequence[]
            counts[term] += 1
        return [for int count = counts[] then real64(count)] * idf

    bayes.Prediction predict(int[] sequence)
        real64[] values = vector(sequence)
        real64 magnitude = vector_length(values)
        real64[] similarities = []
        for int category < int(len(centers))
            real64 similarity = 0.0
            if magnitude > 0.0 and lengths[category] > 0.0
                similarity = math.sum(values * centers[category]) / (magnitude * lengths[category])
            similarities = similarities.append(similarity)
        int[] order = bayes.score_order(similarities)
        return bayes.Prediction(order[0], similarities[order[0]], order, similarities, [], 0.0, 0.0, order[1])
