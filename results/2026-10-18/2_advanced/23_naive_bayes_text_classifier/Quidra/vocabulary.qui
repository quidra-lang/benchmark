import math

int[] first_occurrences(int[] sequence)
    set.Set<int> seen
    int[] result = []
    for int term = sequence[]
        if not seen.has(term)
            .seen.add(term)
            result = result.append(term)
    return result

int[] document_counts(map.Map<string, int[]> table, string key, int width)
    match table.get(key)
        int[] present
            return present
        none
            return array(nat(width), fill = 0)

real64 chi_square(int present, int frequency, int class_size, int total)
    int other_present = frequency - present
    int absent = class_size - present
    int other_absent = total - class_size - other_present
    int difference = present * other_absent - other_present * absent
    int numerator = total * difference * difference
    int denominator = frequency * (total - frequency) * class_size * (total - class_size)
    return if denominator == 0 then 0.0 else real64(numerator) / real64(denominator)

class RankedTerm(string name, int frequency, real64 chi2, int best_class)

class Vocabulary(local string[][] texts, local int[] labels, local int categories, local int minimum, local int limit)
    int term_count = 0
    int candidate_count = 0
    RankedTerm[] ranked = []
    string[] terms = []
    map.Map<string, int> index
    int[] frequencies = []
    local map.Map<string, int[]> counts
    local int[] class_sizes = array(nat(categories), fill = 0)
    for int document < int(len(texts))
        int category = labels[document]
        class_sizes[category] += 1
        set.Set<string> seen
        for string term = texts[document][]
            if not seen.has(term)
                .seen.add(term)
                int[] row = document_counts(counts, term, categories)
                row[category] += 1
                .counts.set(term, row)
    local string[] all_terms = counts.keys().sorted()
    term_count = int(len(all_terms))
    for string term = all_terms[]
        int[] row = document_counts(counts, term, categories)
        int frequency = math.sum(row)
        if frequency < minimum
            continue
        int best = 0
        real64 largest = chi_square(row[0], frequency, class_sizes[0], int(len(texts)))
        for 1 <= int category < categories
            real64 score = chi_square(row[category], frequency, class_sizes[category], int(len(texts)))
            if score > largest
                best = category
                largest = score
        auto entry = RankedTerm(term, frequency, largest, best)
        int place = int(len(ranked))
        ranked = ranked.append(entry)
        while place > 0 and entry.chi2 > ranked[place - 1].chi2
            ranked[place] = ranked[place - 1]
            place -= 1
        ranked[place] = entry
    candidate_count = int(len(ranked))
    if limit > 0 and int(len(ranked)) > limit
        ranked = ranked[0:<limit]
    terms = ([for RankedTerm entry = ranked[] then entry.name]).sorted()
    for int term_position < int(len(terms))
        .index.set(terms[term_position], term_position)
        frequencies = frequencies.append(math.sum(document_counts(counts, terms[term_position], categories)))

    int vocabulary_size()
        return int(len(terms))

    int[] encode(string[] sequence)
        int[] result = []
        for string term = sequence[]
            match index.get(term)
                int found
                    result = result.append(found)
                none
                    continue
        return result
