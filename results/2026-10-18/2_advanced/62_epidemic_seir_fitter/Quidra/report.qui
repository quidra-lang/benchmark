import math

string fmt(real64 value, int places = 4)
    int factor = 10 ^ places
    real64 magnitude = if value < 0.0 then -value else value
    int rounded = math.floor(magnitude * real64(factor) + 0.5)
    string tail = (rounded % factor).string()
    string sign = if value < 0.0 and rounded != 0 then "-" else ""
    return sign + (rounded / factor).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string[] curve_plot(int[] observed, real64[] fitted)
    int days = int(len(observed))
    int maximum = observed[0]
    for int value = observed[]
        if value > maximum
            maximum = value
    int width = int(len(maximum.string()))
    string[][] grid = [for int row < 20 then [for int column < 70 then "."]]
    for int column < 70
        int day = column * (days - 1) / 69
        int observed_row = 20 * observed[day] / maximum
        if observed_row > 19
            observed_row = 19
        int fitted_row = math.floor(20.0 * fitted[day] / real64(maximum))
        if fitted_row > 19
            fitted_row = 19
        grid[observed_row][column] = "o"
        grid[fitted_row][column] = if observed_row == fitted_row then "#" else "*"
    string[] lines = ["plot observed o fitted * both # days 1 {days} max {maximum}"]
    int row = 19
    while row >= 0
        string label = (maximum * row / 20).string()
        lines = lines.append(string.repeat(" ", nat(width - int(len(label)))) + label + " |" + grid[row].join(""))
        row -= 1
    string ticks = [for int column < 70 then (if column % 10 == 0 then "+" else "-")].join("")
    lines = lines.append(string.repeat(" ", nat(width + 1)) + "+" + ticks)
    string[] labels = [for int column < 70 then " "]
    for 0 <= int column < 70 step 10
        string label = (1 + column * (days - 1) / 69).string()
        for int offset < int(len(label))
            labels[column + offset] = label[offset]
    while len(labels) > 0 and labels[int(len(labels)) - 1] == " "
        labels = labels[0:<int(len(labels)) - 1]
    return lines.append(string.repeat(" ", nat(width + 2)) + labels.join(""))
