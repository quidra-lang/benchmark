import math

string fmt(real64 value, places := 4)
    factor := 10 ^ places
    magnitude := if value < 0.0 then -value else value
    rounded := math.floor(magnitude * real64(factor) + 0.5)
    tail := (rounded % factor).string()
    sign := if value < 0.0 and rounded != 0 then "-" else ""
    return sign + (rounded / factor).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string[] curve_plot(int[] observed, real64[] fitted)
    days := int(len(observed))
    maximum := observed[0]
    for value := observed[]
        if value > maximum
            maximum = value
    width := int(len(maximum.string()))
    grid := [for row := (0:<20)[] then [for column := (0:<70)[] then "."]]
    for: column < 70
        day := column * (days - 1) / 69
        observed_row := 20 * observed[day] / maximum
        if observed_row > 19
            observed_row = 19
        fitted_row := math.floor(20.0 * fitted[day] / real64(maximum))
        if fitted_row > 19
            fitted_row = 19
        grid[observed_row][column] = "o"
        grid[fitted_row][column] = if observed_row == fitted_row then "#" else "*"
    lines := ["plot observed o fitted * both # days 1 {days} max {maximum}"]
    row := 19
    while row >= 0
        label := (maximum * row / 20).string()
        lines = lines.append(string.repeat(" ", nat(width - int(len(label)))) + label + " |" + grid[row].join(""))
        row -= 1
    ticks := [for column := (0:<70)[] then (if column % 10 == 0 then "+" else "-")].join("")
    lines = lines.append(string.repeat(" ", nat(width + 1)) + "+" + ticks)
    labels := [for column := (0:<70)[] then " "]
    for: 0 <= column < 70 step 10
        label := (1 + column * (days - 1) / 69).string()
        for: offset < int(len(label))
            labels[column + offset] = label[offset]
    while len(labels) > 0 and labels[int(len(labels)) - 1] == " "
        labels = labels[0:<int(len(labels)) - 1]
    return lines.append(string.repeat(" ", nat(width + 2)) + labels.join(""))
