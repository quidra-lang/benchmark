const real64 phi = 0.6180339887498949

class Golden(real64 point, real64 value, real64[][] records)

Golden golden<T>(func<real64>(T, real64) cost, T context, real64 a, real64 b, int iterations)
    real64 c = b - phi * (b - a)
    real64 d = a + phi * (b - a)
    real64 fc = cost(context, c)
    real64 fd = cost(context, d)
    real64[][] records = [[a, b, c, d, fc, fd]]
    for int i < iterations
        if fc < fd
            b = d
            d = c
            fd = fc
            c = b - phi * (b - a)
            fc = cost(context, c)
        else
            a = c
            c = d
            fc = fd
            d = a + phi * (b - a)
            fd = cost(context, d)
        records = records.append([a, b, c, d, fc, fd])
    return if fc < fd then Golden(c, fc, records) else Golden(d, fd, records)

class Vertex(int serial, real64[] point, real64 value)
class Record(string operation, Vertex best)
class Simplex(Vertex[] initial, Record[] records, Vertex[] vertices)

Vertex[] ordered(Vertex[] vertices)
    Vertex[] result = []
    for Vertex vertex = vertices[]
        int position = int(len(result))
        for int i < int(len(result))
            if vertex.value < result[i].value or (vertex.value == result[i].value and vertex.serial < result[i].serial)
                position = i
                break
        result = result[0:<position].concat([vertex]).concat(result[position:<int(len(result))])
    return result

real64[] toward(real64[] origin, real64[] target, real64 factor)
    return [for int axis < 2 then origin[axis] + factor * (target[axis] - origin[axis])]

Simplex nelder_mead<T>(func<real64>(T, real64, real64) cost, T context, real64 beta, real64 gamma, real64 delta_beta, real64 delta_gamma, real64 alpha, real64 chi, real64 psi, real64 omega, int iterations)
    real64[][] points = [[beta, gamma], [beta + delta_beta, gamma], [beta, gamma + delta_gamma]]
    Vertex[] vertices = [for int i < 3 then Vertex(i, points[i], cost(context, points[i][0], points[i][1]))]
    Vertex[] initial = vertices
    Record[] records = []
    int serial = 3
    for int iteration < iterations
        vertices = ordered(vertices)
        Vertex first = vertices[0]
        Vertex second = vertices[1]
        Vertex third = vertices[2]
        real64[] centroid = [for int axis < 2 then (first.point[axis] + second.point[axis]) / 2.0]
        real64[] reflected = [for int axis < 2 then centroid[axis] + alpha * (centroid[axis] - third.point[axis])]
        real64 fr = cost(context, reflected[0], reflected[1])
        bool accepted = false
        real64[] point = []
        real64 value = 0.0
        string operation = "shrink"
        if fr < first.value
            real64[] expanded = toward(centroid, reflected, chi)
            real64 fe = cost(context, expanded[0], expanded[1])
            accepted = true
            if fe < fr
                point = expanded
                value = fe
                operation = "expand"
            else
                point = reflected
                value = fr
                operation = "reflect"
        elif fr < second.value
            accepted = true
            point = reflected
            value = fr
            operation = "reflect"
        elif fr < third.value
            real64[] contracted = toward(centroid, reflected, psi)
            real64 fc = cost(context, contracted[0], contracted[1])
            if fc <= fr
                accepted = true
                point = contracted
                value = fc
                operation = "contract_out"
        else
            real64[] contracted = toward(centroid, third.point, psi)
            real64 fc = cost(context, contracted[0], contracted[1])
            if fc < third.value
                accepted = true
                point = contracted
                value = fc
                operation = "contract_in"
        if accepted
            vertices = [first, second, Vertex(serial, point, value)]
            serial += 1
        else
            vertices = [first]
            for Vertex old = [second, third][]
                real64[] shrunk = toward(first.point, old.point, omega)
                vertices = vertices.append(Vertex(serial, shrunk, cost(context, shrunk[0], shrunk[1])))
                serial += 1
        vertices = ordered(vertices)
        records = records.append(Record(operation, vertices[0]))
    return Simplex(initial, records, vertices)
