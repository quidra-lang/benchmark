real64[] rk4_step<T>(func<real64[]>(T, real64[], real64) rates, T context, real64[] state, real64 multiplier)
    real64 h = 0.25
    real64 half = h / 2.0
    real64 sixth = h / 6.0
    real64[] k1 = rates(context, state, multiplier)
    real64[] k2 = rates(context, [for int i < int(len(state)) then state[i] + half * k1[i]], multiplier)
    real64[] k3 = rates(context, [for int i < int(len(state)) then state[i] + half * k2[i]], multiplier)
    real64[] k4 = rates(context, [for int i < int(len(state)) then state[i] + h * k3[i]], multiplier)
    return [for int i < int(len(state)) then state[i] + sixth * (((k1[i] + 2.0 * k2[i]) + 2.0 * k3[i]) + k4[i])]

real64[][] simulate<T>(func<real64[]>(T, real64[], real64) rates, T context, real64[] initial, real64[] multipliers, int[] inflows)
    real64[] state = initial
    real64[][] daily = []
    for real64 multiplier = multipliers[]
        for int index = inflows[]
            state[index] = 0.0
        for int quarter < 4
            state = rk4_step(rates, context, state, multiplier)
        daily = daily.append(state)
    return daily
