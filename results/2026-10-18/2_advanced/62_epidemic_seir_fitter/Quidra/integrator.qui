real64[] rk4_step<T>(func<real64[]>(T, real64[], real64) rates, T context, real64[] state, real64 multiplier)
    real64 h := 0.25
    real64 half := h / 2.0
    real64 sixth := h / 6.0
    real64[] k1 := rates(context, state, multiplier)
    k2_state := [for i := (0:<int(len(state)))[] then state[i] + half * k1[i]]
    k2 := rates(context, k2_state, multiplier)
    k3_state := [for i := (0:<int(len(state)))[] then state[i] + half * k2[i]]
    k3 := rates(context, k3_state, multiplier)
    k4_state := [for i := (0:<int(len(state)))[] then state[i] + h * k3[i]]
    k4 := rates(context, k4_state, multiplier)
    return [for i := (0:<int(len(state)))[] then state[i] + sixth * (((k1[i] + 2.0 * k2[i]) + 2.0 * k3[i]) + k4[i])]

real64[][] simulate<T>(func<real64[]>(T, real64[], real64) rates, T context, real64[] initial, real64[] multipliers, int[] inflows)
    real64[] state := initial
    real64[][] daily := []
    for multiplier := multipliers[]
        for index := inflows[]
            state[index] = 0.0
        for int quarter < 4
            state = rk4_step(rates, context, state, multiplier)
        daily = daily.append(state)
    return daily
