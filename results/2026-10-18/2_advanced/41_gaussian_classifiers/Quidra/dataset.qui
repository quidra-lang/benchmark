string[] read_lines(string path)
    string content = file.read(path)
    string[] lines = content.split(NL)
    return lines[0:<int(len(lines)) - 1]

int integer(string text)
    int result = int.parse(text)
    return result

real64 decimal(string text)
    real64 result = real64.parse(text)
    return result

int find_name(string[] names, string name)
    for int index < int(len(names))
        if names[index] == name
            return index
    return -1

class Row(int id, real64[] values, string label)
    int class_index = -1

class Table(string[] features, Row[] rows)

Table read_table(string path)
    string[] lines = read_lines(path)
    string[] header = lines[0].split(",")
    string[] features = header[1:<int(len(header)) - 1]
    Row[] rows = []
    for 1 <= int index < int(len(lines))
        string[] fields = lines[index].split(",")
        real64[] values = []
        for 1 <= int column < int(len(fields)) - 1
            values = values.append(decimal(fields[column]))
        rows = rows.append(Row(integer(fields[0]), values, fields[len(fields) - 1]))
    return Table(features, rows)

class Subset(string name, int[] features)
class Params()
    string prior = "empirical"
    real64 epsilon = 0.0
    real64 gamma = 0.0
    real64[] smoothing_grid = []
    real64[] gamma_grid = []
    int folds = 2
    real64[] calibration_edges = []
    real64[] reject_thresholds = []
    int[] curve = []
    real64 theta = 0.0
    int bootstrap_count = 1
    int seed = 1
    int[] map_size = [2, 2]
    int[] plot_size = [2, 2]
    Subset[] subsets = []
    int[][] pairs = []

Params read_params(string[] features)
    Params params = Params()
    for string line = read_lines("input/params.txt")[]
        string[] words = line.split(" ")
        string keyword = words[0]
        string[] args = words[1:<int(len(words))]
        if keyword == "PRIOR"
            params.prior = args[0]
        elif keyword == "SUBSET"
            int[] indices = []
            for 1 <= int index < int(len(args))
                indices = indices.append(find_name(features, args[index]))
            params.subsets = params.subsets.append(Subset(args[0], indices))
        elif keyword == "PAIR"
            params.pairs = params.pairs.append([find_name(features, args[0]), find_name(features, args[1])])
        elif keyword == "VAR_SMOOTHING"
            params.epsilon = decimal(args[0])
        elif keyword == "QDA_GAMMA"
            params.gamma = decimal(args[0])
        elif keyword == "SMOOTHING_GRID"
            params.smoothing_grid = [for string word = args[] then decimal(word)]
        elif keyword == "GAMMA_GRID"
            params.gamma_grid = [for string word = args[] then decimal(word)]
        elif keyword == "CV_FOLDS"
            params.folds = integer(args[0])
        elif keyword == "CALIBRATION_EDGES"
            params.calibration_edges = [for string word = args[] then decimal(word)]
        elif keyword == "REJECT_THRESHOLDS"
            params.reject_thresholds = [for string word = args[] then decimal(word)]
        elif keyword == "CURVE"
            params.curve = [for string word = args[] then integer(word)]
        elif keyword == "OUTLIER_THRESHOLD"
            params.theta = decimal(args[0])
        elif keyword == "BOOTSTRAP"
            params.bootstrap_count = integer(args[0])
            params.seed = integer(args[1])
        elif keyword == "MAP_SIZE"
            params.map_size = [integer(args[0]), integer(args[1])]
        elif keyword == "PLOT_SIZE"
            params.plot_size = [integer(args[0]), integer(args[1])]
    return params

class Dataset(string[] features, string[] classes, Row[] train, Row[] testing, real64[][] costs, Params[] parameters)

Dataset read_inputs()
    Table training = read_table("input/train.csv")
    Table testing = read_table("input/test.csv")
    string[] classes = []
    for Row row = training.rows[]
        if find_name(classes, row.label) < 0
            classes = classes.append(row.label)
    classes = classes.sorted()
    Row[] train = training.rows
    Row[] test_rows = testing.rows
    for int index < int(len(train))
        train[index].class_index = find_name(classes, train[index].label)
    for int index < int(len(test_rows))
        test_rows[index].class_index = find_name(classes, test_rows[index].label)
    real64[][] costs = array(len(classes), fill = array(len(classes), fill = 0.0))
    string[] lines = read_lines("input/costs.csv")
    string[] columns = lines[0].split(",")
    for 1 <= int index < int(len(lines))
        string[] fields = lines[index].split(",")
        int actual = find_name(classes, fields[0])
        for 1 <= int column < int(len(fields))
            costs[actual][find_name(classes, columns[column])] = decimal(fields[column])
    Params params = read_params(training.features)
    return Dataset(training.features, classes, train, test_rows, costs, [params])
