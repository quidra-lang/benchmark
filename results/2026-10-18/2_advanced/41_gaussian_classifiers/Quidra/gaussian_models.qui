public import dataset = "./dataset.qui"
import algebra = "./linalg.qui"

int argmax(real64[] values)
    int best = 0
    for 1 <= int index < int(len(values))
        if values[index] > values[best]
            best = index
    return best

int argmin(real64[] values)
    int best = 0
    for 1 <= int index < int(len(values))
        if values[index] < values[best]
            best = index
    return best

class Statistics(int row_count, int[] counts, real64[][] means, real64[][][] scatter, real64[] center, real64[] variances, real64[][] pooled)

Statistics statistics(dataset.Row[] rows, int[] features, int count)
    int size = int(len(features))
    real64[][][] groups = array(nat(count), fill = [])
    real64[][] vectors = []
    for dataset.Row row = rows[]
        real64[] vector = []
        for int feature = features[]
            vector = vector.append(row.values[feature])
        vectors = vectors.append(vector)
        groups[row.class_index] = groups[row.class_index].append(vector)
    int[] counts = []
    real64[][] means = []
    real64[][][] scatter = []
    for int category < count
        real64[][] group = groups[category]
        counts = counts.append(int(len(group)))
        real64[] mean = []
        for int feature < size
            real64 total = 0.0
            for real64[] vector = group[]
                total += vector[feature]
            mean = mean.append(total / algebra.as_real(int(len(group))))
        means = means.append(mean)
        real64[][] matrix = algebra.zeros(size)
        for int first < size
            for int second < size
                real64 total = 0.0
                for real64[] vector = group[]
                    total += (vector[first] - mean[first]) * (vector[second] - mean[second])
                matrix[first][second] = total
        scatter = scatter.append(matrix)
    real64[] center = []
    real64[] variances = []
    for int feature < size
        real64 total = 0.0
        for real64[] vector = vectors[]
            total += vector[feature]
        real64 average = total / algebra.as_real(int(len(rows)))
        center = center.append(average)
        total = 0.0
        for real64[] vector = vectors[]
            real64 delta = vector[feature] - average
            total += delta * delta
        variances = variances.append(total / algebra.as_real(int(len(rows))))
    real64[][] pooled = algebra.zeros(size)
    for int first < size
        for int second < size
            real64 total = 0.0
            for int category < count
                total += scatter[category][first][second]
            pooled[first][second] = total / algebra.as_real(int(len(rows)) - count)
    return Statistics(int(len(rows)), counts, means, scatter, center, variances, pooled)

class Prediction(int predicted, real64[] posterior, real64[] log_posterior, real64 confidence, int decision)

class Model(string name, int[] features, Statistics[] records, string prior_mode, real64 epsilon, real64 gamma)
    real64[][] means = records[0].means
    real64[] priors = []
    real64[] log_priors = []
    real64[][][] covariances = []
    real64[][][] factors = []
    real64[] log_determinants = []
    real64 max_variance = records[0].variances[argmax(records[0].variances)]
    real64 added_variance = epsilon * max_variance
    real64 normalizer = algebra.as_real(int(len(features))) * algebra.logarithm(2.0 * 3.141592653589793) / 2.0
    local Statistics stats = records[0]
    local int count = int(len(stats.counts))
    local int size = int(len(features))
    for int category < count
        real64 prior = if prior_mode == "empirical" then algebra.as_real(stats.counts[category]) / algebra.as_real(stats.row_count) else 1.0 / algebra.as_real(count)
        priors = priors.append(prior)
        log_priors = log_priors.append(algebra.logarithm(prior))
        real64[][] covariance = algebra.zeros(size)
        for int first < size
            for int second < size
                if name == "LDA"
                    covariance[first][second] = stats.pooled[first][second]
                elif name == "NB"
                    if first == second
                        covariance[first][second] = stats.scatter[category][first][second] / algebra.as_real(stats.counts[category]) + added_variance
                else
                    real64 value = stats.scatter[category][first][second] / algebra.as_real(stats.counts[category] - 1)
                    covariance[first][second] = if first == second then value else value * (1.0 - gamma)
        covariances = covariances.append(covariance)
        real64[][] factor = algebra.cholesky(covariance)
        factors = factors.append(factor)
        log_determinants = log_determinants.append(algebra.log_determinant(factor))

    real64[] vector(real64[] values)
        real64[] result = []
        for int feature = features[]
            result = result.append(values[feature])
        return result

    real64[] squared_distances(real64[] point)
        real64[] result = []
        for int category < int(len(means))
            real64[] delta = []
            for int feature < int(len(point))
                delta = delta.append(point[feature] - means[category][feature])
            result = result.append(algebra.quadratic(factors[category], delta))
        return result

    real64[] distances(real64[] values)
        return squared_distances(vector(values))

    real64[] scores(real64[] point)
        real64[] distances_squared = squared_distances(point)
        real64[] result = []
        for int category < int(len(means))
            result = result.append(log_priors[category] - normalizer - log_determinants[category] / 2.0 - distances_squared[category] / 2.0)
        return result

    int predict(real64[] values)
        return argmax(scores(vector(values)))

    Prediction infer_vector(real64[] point, real64[][] costs = [])
        real64[] discriminants = scores(point)
        int predicted = argmax(discriminants)
        real64 maximum = discriminants[predicted]
        real64[] exponentials = []
        real64 total = 0.0
        for real64 score = discriminants[]
            real64 value = algebra.exponential(score - maximum)
            exponentials = exponentials.append(value)
            total += value
        real64 log_total = algebra.logarithm(total)
        real64[] posterior = []
        real64[] log_posterior = []
        for int category < int(len(means))
            posterior = posterior.append(exponentials[category] / total)
            log_posterior = log_posterior.append((discriminants[category] - maximum) - log_total)
        int decision = predicted
        if len(costs) > 0
            real64[] risks = []
            for int decided < int(len(means))
                real64 risk = 0.0
                for int category < int(len(means))
                    risk += posterior[category] * costs[category][decided]
                risks = risks.append(risk)
            decision = argmin(risks)
        return Prediction(predicted, posterior, log_posterior, posterior[argmax(posterior)], decision)

    Prediction infer(real64[] values, real64[][] costs = [])
        return infer_vector(vector(values), costs)

Model train(dataset.Row[] rows, int[] features, int count, string name, string prior_mode, real64 epsilon, real64 gamma)
    Statistics stats = statistics(rows, features, count)
    return Model(name, features, [stats], prior_mode, epsilon, gamma)
