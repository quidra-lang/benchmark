import math
import minstd = "./minstd.qui"

real64 mean(int[] values)
    return real64(math.sum(values)) / real64(100 * int(len(values)))

int doubled_median(int[] values)
    int[] ordered = values.sorted()
    int count = int(len(values))
    return ordered[(count + 1) / 2 - 1] + ordered[(count + 2) / 2 - 1]

real64 median(int[] values)
    return real64(doubled_median(values)) / 200.0

real64 trimmed_mean(int[] values)
    int[] ordered = values.sorted()
    int count = int(len(values))
    int trim = count / 10
    return real64(math.sum(ordered[trim:<count - trim])) / real64(100 * (count - 2 * trim))

real64[] deviations(int[] values)
    return real64(values) / 100.0 - mean(values)

real64 sd(int[] values)
    real64[] offsets = deviations(values)
    return math.sqrt(math.sum(offsets * offsets) / real64(int(len(values)) - 1))

real64[] central_moments(int[] values)
    real64[] offsets = deviations(values)
    real64 count = real64(len(values))
    return [math.sum(offsets * offsets) / count, math.sum(offsets * offsets * offsets) / count, math.sum(offsets * offsets * offsets * offsets) / count]

real64 mad(int[] values)
    int center = doubled_median(values)
    return real64(doubled_median([for int value = values[] then math.abs(2 * value - center)])) / 400.0

int quantile_numerator(int[] values, int percent)
    int[] ordered = values.sorted()
    int position = (int(len(values)) - 1) * percent
    int index = position / 100
    int fraction = position - 100 * index
    if fraction == 0
        return 100 * ordered[index]
    return 100 * ordered[index] + fraction * (ordered[index + 1] - ordered[index])

int[] winsorized(int[] values)
    int[] ordered = values.sorted()
    int trim = int(len(values)) / 10
    int low = ordered[trim]
    int high = ordered[len(values) - 1 - nat(trim)]
    return [for int value = values[] then math.min(math.max(value, low), high)]

real64 mean_difference(int[] x, int[] y)
    int k = int(len(x))
    int m = int(len(y))
    return real64(m * math.sum(x) - k * math.sum(y)) / real64(100 * k * m)

real64 median_ratio(int[] x, int[] y)
    return real64(doubled_median(x)) / real64(doubled_median(y))

real64 hodges_lehmann(int[] x, int[] y)
    int[] differences = []
    for int first = x[]
        differences = differences.concat([for int second = y[] then first - second])
    return real64(doubled_median(differences)) / 200.0

real64 pooled_sd(int[] x, int[] y)
    real64 first = sd(x)
    real64 second = sd(y)
    real64 squares = real64(int(len(x)) - 1) * first * first + real64(int(len(y)) - 1) * second * second
    return math.sqrt(squares / real64(int(len(x)) + int(len(y)) - 2))

real64 cohen_d(int[] x, int[] y)
    return mean_difference(x, y) / pooled_sd(x, y)

real64 correlation(int[] x, int[] y)
    real64[] first = deviations(x)
    real64[] second = deviations(y)
    return math.sum(first * second) / math.sqrt(math.sum(first * first) * math.sum(second * second))

real64[] statistics(int[] values)
    return [mean(values), median(values), trimmed_mean(values), sd(values)]

real64[] pair_statistics(int[] x, int[] y)
    return [mean_difference(x, y), median_ratio(x, y), hodges_lehmann(x, y), cohen_d(x, y)]

int[] resample_indices(minstd.Generator &generator, int size)
    int[] indices = []
    for int i < size
        indices = indices.append(.generator.below(size))
    return indices

int[][] ordinary_indices(minstd.Generator &generator, int size, int count)
    int[][] indices = []
    for int i < count
        indices = indices.append(resample_indices(&generator, size))
    return indices

int[][] balanced_indices(minstd.Generator &generator, int size, int count)
    int[] sequence = []
    for int i < count
        sequence = sequence.concat(0:<size)
    .generator.shuffle(&sequence)
    return [for int i = (0:<count)[] then sequence[i * size:<(i + 1) * size]]

int[] without(int[] values, int index)
    return values[0:<index].concat(values[index + 1:<len(values)])

class MeanSe(local real64[] values)
    real64 average = math.sum(values) / real64(len(values))
    real64[] offsets = values - average
    real64 se = math.sqrt(math.sum(offsets * offsets) / real64(int(len(values)) - 1))

real64 phi(real64 x)
    if x < 0.0
        return 1.0 - phi(-x)
    real64 eta = 1.0 / (1.0 + 0.2316419 * x)
    real64 psi = eta * (0.319381530 + eta * (-0.356563782 + eta * (1.781477937 + eta * (-1.821255978 + eta * 1.330274429))))
    return 1.0 - 0.3989422804014327 * math.exp(-(x * x) / 2.0) * psi

real64 phi_inverse(real64 p)
    if p > 0.5
        return -phi_inverse(1.0 - p)
    real64 eta = math.sqrt(-2.0 * math.log(p))
    real64 numerator = 2.515517 + eta * (0.802853 + eta * 0.010328)
    real64 denominator = 1.0 + eta * (1.432788 + eta * (0.189269 + eta * 0.001308))
    return -(eta - numerator / denominator)
