import math
import resampling = "./resampling.qui"

class ValueCount(int value, int count)

int[] reduced_fraction(int numerator, int denominator)
    int first = numerator
    int second = denominator
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return [numerator / first, denominator / first]

ValueCount[] value_counts(int[] values)
    int[] ordered = values.sorted()
    ValueCount[] counts = []
    for int value = ordered[]
        if len(counts) == 0 or counts[len(counts) - 1].value != value
            counts = counts.append(ValueCount(value, 1))
        else
            counts[len(counts) - 1].count += 1
    return counts

int[] doubled_ranks(int[] values)
    ValueCount[] counts = value_counts(values)
    int[] assigned = []
    int smaller = 0
    for ValueCount entry = counts[]
        assigned = assigned.append(2 * smaller + entry.count + 1)
        smaller += entry.count
    int[] ranks = []
    for int value = values[]
        for int i < int(len(counts))
            if counts[i].value == value
                ranks = ranks.append(assigned[i])
                break
    return ranks

int contrast(int first_total, int first_size, int second_total, int second_size)
    return second_size * first_total - first_size * second_total

int[][] position_choices(int total, int size)
    int[] choice = 0:<size
    int[][] choices = []
    while true
        choices = choices.append(choice)
        int index = size - 1
        while index >= 0 and choice[index] == total - size + index
            index -= 1
        if index < 0
            break
        choice[index] += 1
        for index + 1 <= int j < size
            choice[j] = choice[j - 1] + 1
    return choices

int[][] split_list(int[] items, int[] sizes)
    int[][] parts = []
    int start = 0
    for int size = sizes[]
        parts = parts.append(items[start:<start + size])
        start += size
    return parts

class Squares(real64 between, real64 within)

Squares sums_of_squares(int[][] samples)
    int count = math.sum([for int[] sample = samples[] then int(len(sample))])
    int total = math.sum([for int[] sample = samples[] then math.sum(sample)])
    real64 grand_mean = real64(total) / real64(100 * count)
    real64[] between_values = []
    real64[] within_values = []
    for int[] sample = samples[]
        real64 center = resampling.mean(sample)
        real64 offset = center - grand_mean
        between_values = between_values.append(real64(len(sample)) * (offset * offset))
        real64[] deviations = real64(sample) / 100.0 - center
        within_values = within_values.append(math.sum(deviations * deviations))
    return Squares(math.sum(between_values), math.sum(within_values))

real64 f_statistic(real64 between, real64 within, int groups, int count)
    return between / real64(groups - 1) / (within / real64(count - groups))

real64 h_statistic(int[] rank_sums, int[] sizes, real64 correction)
    int count = math.sum(sizes)
    real64 total = math.sum([for int i = (0:<int(len(sizes)))[] then real64(rank_sums[i] * rank_sums[i]) / real64(4 * sizes[i])])
    return (12.0 * total / real64(count * (count + 1)) - real64(3 * (count + 1))) / correction

int[] split_statistics(int[] values, int[] ranks, int[] order, int size)
    int[] first = values[order[0:<size]]
    int[] second = values[order[size:<len(order)]]
    int k = int(len(first))
    int m = int(len(second))
    int first_center = resampling.doubled_median(first)
    int second_center = resampling.doubled_median(second)
    int first_deviation = math.sum([for int value = first[] then math.abs(2 * value - first_center)])
    int second_deviation = math.sum([for int value = second[] then math.abs(2 * value - second_center)])
    return [contrast(math.sum(first), k, math.sum(second), m), first_center - second_center, math.sum(ranks[order[0:<size]]) - k * (k + m + 1), contrast(first_deviation, k, second_deviation, m)]

int[] signed_ranks(int[] differences)
    int[] magnitudes = [for int difference = differences[] if difference != 0 then math.abs(difference)]
    int[] ranks = doubled_ranks(magnitudes)
    int position = 0
    int[] signed = []
    for int difference = differences[]
        if difference == 0
            signed = signed.append(0)
        else
            signed = signed.append(if difference > 0 then ranks[position] else -ranks[position])
            position += 1
    return signed

class Delta(int numerator, int denominator)
    bool at_least(Delta bound)
        return numerator * bound.denominator >= bound.numerator * denominator

Delta[] group_deltas(int[][] samples, int[][] pairs)
    int[] totals = [for int[] sample = samples[] then math.sum(sample)]
    int[] sizes = [for int[] sample = samples[] then int(len(sample))]
    return [for int[] pair = pairs[] then Delta(math.abs(contrast(totals[pair[0]], sizes[pair[0]], totals[pair[1]], sizes[pair[1]])), sizes[pair[0]] * sizes[pair[1]])]
