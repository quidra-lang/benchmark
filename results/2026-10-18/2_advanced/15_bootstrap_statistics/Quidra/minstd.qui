class Generator(int state)
    int .draw()
        state = 48271 * state % 2147483647
        return state

    int .below(int limit)
        return .draw() % limit

    void .shuffle(int[] &items)
        for int(len(items)) - 1 >= int i >= 1
            int j = .draw() % (i + 1)
            int saved = items[i]
            items[i] = items[j]
            items[j] = saved
