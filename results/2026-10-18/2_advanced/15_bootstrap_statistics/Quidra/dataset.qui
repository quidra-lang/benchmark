int hundredths(string text)
    string[] parts := text.split(".")
    fraction := 0
    if len(parts) > 1
        fraction = int.parse(if len(parts[1]) == 1 then parts[1] + "0" else parts[1])
    return 100 * int.parse(parts[0]) + fraction

string[] read_lines(string path)
    string[] lines := string.from_utf8(file.read_bin(path)).split(NL)
    if len(lines) > 0 and lines[len(lines) - 1] == ""
        lines = lines[0:<len(lines) - 1]
    return lines

class Group(int number, string name, int[] values)
class Paired(int[] before, int[] after)
    int[] differences := after - before

class Settings(local string[] lines)
    seed := 0
    bootstrap := 0
    permutations := 0
    confidence := 0
    pilot := 0
    power_sims := 0
    power_perms := 0
    bins := 0
    string[][] comparisons := []
    for line := lines[]
        string[] fields := line.split(" ")
        if fields[0] == "compare"
            comparisons = comparisons.append(fields[1:<len(fields)])
        elif fields[0] == "seed"
            seed = int.parse(fields[1])
        elif fields[0] == "bootstrap"
            bootstrap = int.parse(fields[1])
        elif fields[0] == "permutations"
            permutations = int.parse(fields[1])
        elif fields[0] == "confidence"
            confidence = int.parse(fields[1])
        elif fields[0] == "pilot"
            pilot = int.parse(fields[1])
        elif fields[0] == "power"
            power_sims = int.parse(fields[1])
            power_perms = int.parse(fields[2])
        else
            bins = int.parse(fields[1])

class Dataset(Group[] groups, Paired paired, Settings settings, int[][] pairs)

Dataset load()
    Group[] groups := []
    string[] rows := read_lines("input/samples.csv")
    for: 1 <= i < int(len(rows))
        string[] fields := rows[i].split(",")
        position := -1
        for: j < int(len(groups))
            if groups[j].name == fields[0]
                position = j
                break
        if position < 0
            position = int(len(groups))
            groups = groups.append(Group(position + 1, fields[0], []))
        groups[position].values = groups[position].values.append(hundredths(fields[1]))
    int[] before := []
    int[] after := []
    string[] paired_rows := read_lines("input/paired.csv")
    for: 1 <= i < int(len(paired_rows))
        string[] fields := paired_rows[i].split(",")
        before = before.append(hundredths(fields[1]))
        after = after.append(hundredths(fields[2]))
    settings := Settings(read_lines("input/params.txt"))
    int[][] pairs := []
    for comparison := settings.comparisons[]
        int[] indices := []
        for name := comparison[]
            for: i < int(len(groups))
                if groups[i].name == name
                    indices = indices.append(i)
                    break
        pairs = pairs.append(indices)
    return Dataset(groups, Paired(before, after), settings, pairs)
