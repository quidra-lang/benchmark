bool contains_node(int[] values, int wanted)
    for int value = values[]
        if value == wanted
            return true
    return false

class Tree(int size, int[][] adjacent, real64[][] lengths, int negative)
    int .internal()
        int node = int(len(adjacent))
        adjacent = adjacent.append([])
        for int i < node
            lengths[i] = lengths[i].append(0.0)
        lengths = lengths.append([for int i <= node then 0.0])
        return node

    void .connect(int first, int second, real64 length = 0.0)
        if not contains_node(adjacent[first], second)
            adjacent[first] = adjacent[first].append(second)
            adjacent[second] = adjacent[second].append(first)
        lengths[first][second] = length
        lengths[second][first] = length

    real64 .disconnect(int first, int second)
        real64 length = lengths[first][second]
        adjacent[first] = [for int value = adjacent[first][] if value != second then value]
        adjacent[second] = [for int value = adjacent[second][] if value != first then value]
        lengths[first][second] = 0.0
        lengths[second][first] = 0.0
        return length

    int[] taxa()
        return [for int i < size if len(adjacent[i]) != 0 then i]

    int[] internal_nodes()
        return [for size <= int i < int(len(adjacent)) if len(adjacent[i]) != 0 then i]

    int[][] edges()
        int[][] result = []
        for int first < int(len(adjacent))
            for int second = adjacent[first].sorted()[]
                if first < second
                    result = result.append([first, second])
        return result

Tree empty_tree(int size)
    return Tree(size, [for int i < size then []], [for int i < size then [for int j < size then 0.0]], 0)

Tree star(int size, int[] taxa)
    Tree result = empty_tree(size)
    int node = .result.internal()
    for int taxon = taxa[]
        .result.connect(node, taxon)
    return result

class Rooted(int root, int[] parents, int[][] children, int[] masks, int[] order, int ingroup)

void visit_nodes(Tree tree, int node, int parent, int[] &parents, int[][] &children, int[] &masks, int[] &order)
    parents[node] = parent
    order = order.append(node)
    int mask = if node < tree.size then 2 ^ node else 0
    for int child = tree.adjacent[node][]
        if child != parent
            children[node] = children[node].append(child)
            visit_nodes(tree, child, node, &parents, &children, &masks, &order)
            mask += masks[child]
    masks[node] = mask

Rooted root_tree(Tree tree, int outgroup)
    int size = int(len(tree.adjacent))
    int root = tree.adjacent[outgroup][0]
    int[] parents = [for int i < size then -2]
    int[][] children = [for int i < size then []]
    int[] masks = [for int i < size then 0]
    int[] order = []
    visit_nodes(tree, root, -1, &parents, &children, &masks, &order)
    return Rooted(root, parents, children, masks, order, masks[root] - 2 ^ outgroup)

int[] split_set(Tree tree, int outgroup)
    Rooted orientation = root_tree(tree, outgroup)
    return [for int node = tree.internal_nodes()[] if node != orientation.root then orientation.masks[node]].sorted()

Tree neighbor_joining(real64[][] matrix, int[] taxa)
    int size = int(len(matrix))
    Tree result = empty_tree(size)
    int capacity = 2 * size
    real64[][] pair_distances = [for int i < capacity then [for int j < capacity then (if i < size and j < size then matrix[i][j] else 0.0)]]
    int[] active = taxa
    while len(active) >= 4
        int count = int(len(active))
        real64[] totals = [for int i < capacity then 0.0]
        for int first = active[]
            for int second = active[]
                if first != second
                    totals[first] += pair_distances[first][second]
        int first = active[0]
        int second = active[1]
        real64 minimum = real64(count - 2) * pair_distances[first][second] - totals[first] - totals[second]
        for int i < count
            for i + 1 <= int j < count
                int a = active[i]
                int b = active[j]
                real64 value = real64(count - 2) * pair_distances[a][b] - totals[a] - totals[b]
                if value < minimum
                    minimum = value
                    first = a
                    second = b
        int node = .result.internal()
        real64 distance = pair_distances[first][second]
        real64 first_length = distance / 2.0 + (totals[first] - totals[second]) / real64(2 * (count - 2))
        .result.connect(first, node, first_length)
        .result.connect(second, node, distance - first_length)
        int[] remaining = [for int other = active[] if other != first and other != second then other]
        for int other = remaining[]
            real64 value = (pair_distances[first][other] + pair_distances[second][other] - distance) / 2.0
            pair_distances[node][other] = value
            pair_distances[other][node] = value
        active = remaining.append(node)
    int first = active[0]
    int second = active[1]
    int third = active[2]
    int node = .result.internal()
    real64 a = pair_distances[first][second]
    real64 b = pair_distances[first][third]
    real64 c = pair_distances[second][third]
    .result.connect(first, node, (a + b - c) / 2.0)
    .result.connect(second, node, (a + c - b) / 2.0)
    .result.connect(third, node, (b + c - a) / 2.0)
    for int[] edge = result.edges()[]
        if result.lengths[edge[0]][edge[1]] < 0.0
            .result.connect(edge[0], edge[1], 0.0)
            result.negative += 1
    return result

real64[] path_distances(Tree tree, int start)
    int size = int(len(tree.adjacent))
    real64[] result = [for int i < size then 0.0]
    int[][] stack = [[start, -1]]
    while len(stack) != 0
        int[] item = stack[int(len(stack)) - 1]
        stack = stack[0:<int(len(stack)) - 1]
        for int neighbour = tree.adjacent[item[0]][]
            if neighbour != item[1]
                result[neighbour] = result[item[0]] + tree.lengths[item[0]][neighbour]
                stack = stack.append([neighbour, item[0]])
    return result

int[] path_steps(Tree tree, int start)
    int size = int(len(tree.adjacent))
    int[] result = [for int i < size then 0]
    int[][] stack = [[start, -1]]
    while len(stack) != 0
        int[] item = stack[int(len(stack)) - 1]
        stack = stack[0:<int(len(stack)) - 1]
        for int neighbour = tree.adjacent[item[0]][]
            if neighbour != item[1]
                result[neighbour] = result[item[0]] + 1
                stack = stack.append([neighbour, item[0]])
    return result

real64[][] patristic_matrix(Tree tree)
    real64[][] result = [for int i < tree.size then [for int j < tree.size then 0.0]]
    int[] taxa = tree.taxa()
    for int first = taxa[]
        real64[] values = path_distances(tree, first)
        for int second = taxa[]
            result[first][second] = values[second]
    return result
