const string bases = "ACGT"
const string allowed = "ACGTRYSWKMBDHVN-"
const int[] base_sets = [1, 2, 4, 8, 5, 10, 6, 9, 12, 3, 14, 13, 11, 7, 15, 15]

int character_index(string text, string wanted)
    for int i < int(len(text))
        if text[i] == wanted
            return i
    return -1

int base_set(string character)
    int index = character_index(allowed, character)
    return if index < 0 then 0 else base_sets[index]

int base_index(string character)
    return character_index(bases, character)

string uppercase(string text)
    string lower = "abcdefghijklmnopqrstuvwxyz"
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string result = ""
    for int i < int(len(text))
        int index = character_index(lower, text[i])
        result += if index < 0 then text[i] else upper[index]
    return result

class Record(int line, string name, string sequence)

Record[] read_fasta()
    string text = file.read("input/alignment.fasta")
    string[] lines = text.split(NL)
    Record[] records = []
    string name = ""
    string sequence = ""
    int header_line = 0
    for int i < int(len(lines)) - 1
        string line = lines[i]
        if line[0] == ">"
            if header_line > 0
                records = records.append(Record(header_line, name, uppercase(sequence)))
            name = line[1:<int(len(line))].split(" ")[0]
            header_line = i + 1
            sequence = ""
        else
            sequence += line
    return records.append(Record(header_line, name, uppercase(sequence)))

class Patterns(string[] texts, int[][] encoded, int[] weights, int[] columns)

Patterns compress_patterns(string[] sequences)
    string[] texts = []
    int[] weights = []
    int[] columns = []
    for int c < int(len(sequences[0]))
        string pattern = [for string sequence = sequences[] then sequence[c]].join("")
        int index = -1
        for int i < int(len(texts))
            if texts[i] == pattern
                index = i
                break
        if index < 0
            index = int(len(texts))
            texts = texts.append(pattern)
            weights = weights.append(0)
        weights[index] += 1
        columns = columns.append(index)
    int[][] encoded = [for string pattern = texts[] then [for int i < int(len(pattern)) then base_set(pattern[i])]]
    return Patterns(texts, encoded, weights, columns)

int[] classify_columns(string[] sequences)
    int[] totals = [0, 0, 0, 0, 0]
    for int c < int(len(sequences[0]))
        int[] counts = [0, 0, 0, 0]
        bool gapped = false
        for string sequence = sequences[]
            int base = base_index(sequence[c])
            if base >= 0
                counts[base] += 1
            if sequence[c] == "-"
                gapped = true
        int kinds = int(len([for int count = counts[] if count > 0 then count]))
        int repeated = int(len([for int count = counts[] if count >= 2 then count]))
        if kinds == 0
            totals[4] += 1
        elif kinds == 1
            totals[0] += 1
        else
            totals[1] += 1
        if repeated >= 2
            totals[2] += 1
        if gapped
            totals[3] += 1
    return totals
