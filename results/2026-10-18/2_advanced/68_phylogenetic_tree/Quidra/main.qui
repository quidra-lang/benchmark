import math
import alignment = "./alignment.qui"
import distances = "./distances.qui"
import tree_building = "./tree_building.qui"
import parsimony = "./parsimony.qui"
import tree_io = "./tree_io.qui"

const string[] model_names = ["P", "JC", "K2P"]
const string[] methods = ["NJ_P", "NJ_JC", "NJ_K2P", "ME", "MP", "CONSENSUS"]

int integer(string text)
    int value = int.parse(text)
    return value

real64 number(string text)
    real64 value = real64.parse(text)
    return value

string[] read_lines(string path)
    string text = file.read(path)
    string[] lines = text.split(NL)
    return lines[0:<int(len(lines)) - 1]

int name_index(string[] values, string wanted)
    for int i < int(len(values))
        if values[i] == wanted
            return i
    return -1

bool has_integer(int[] values, int wanted)
    for int value = values[]
        if value == wanted
            return true
    return false

int sum_integers(int[] values)
    int result = 0
    for int value = values[]
        result += value
    return result

real64 sum_reals(real64[] values)
    real64 result = 0.0
    for real64 value = values[]
        result += value
    return result

int population_count(int mask, int size)
    int count = 0
    for int taxon < size
        if tree_io.contains_taxon(mask, taxon)
            count += 1
    return count

int mask_intersection(int first, int second, int size)
    int result = 0
    for int taxon < size
        if tree_io.contains_taxon(first, taxon) and tree_io.contains_taxon(second, taxon)
            result += 2 ^ taxon
    return result

bool subset(int first, int second, int size)
    return mask_intersection(first, second, size) == first

int[] unique_integers(int[] values)
    int[] result = []
    for int value = values.sorted()[]
        if len(result) == 0 or result[int(len(result)) - 1] != value
            result = result.append(value)
    return result

class Params(int model, string outgroup_name, int replicates, int seed, int max_missing, real64 saturation, string[] exhaustive_names, int low_sites)

Params read_parameters()
    string[][] rows = [for string row = read_lines("input/params.txt")[] then row.split(" ")]
    return Params(name_index(model_names, rows[0][1]), rows[1][1], integer(rows[2][1]), integer(rows[3][1]), integer(rows[4][1]), number(rows[5][1]), rows[6][1:<int(len(rows[6]))], integer(rows[7][1]))

class Rejection(int line, string name, string reason)
class Checked(string[] names, string[] sequences, Rejection[] rejected, int columns)

Checked check_records(alignment.Record[] records, int maximum_missing)
    int length = int(len(records[0].sequence))
    set.Set<string> seen = set.Set<string>()
    string[] names = []
    string[] sequences = []
    Rejection[] rejected = []
    for alignment.Record record = records[]
        string reason = if seen.has(record.name) then "duplicate name" else ""
        .seen.add(record.name)
        if reason == ""
            for int c < int(len(record.sequence))
                if alignment.base_set(record.sequence[c]) == 0
                    reason = "invalid character {record.sequence[c]} at column {c + 1}"
                    break
        if reason == "" and int(len(record.sequence)) != length
            reason = "length mismatch {len(record.sequence)}"
        if reason == ""
            int missing = 0
            for int c < length
                if record.sequence[c] == "-" or record.sequence[c] == "N"
                    missing += 1
            if 100 * missing > maximum_missing * length
                reason = "too many missing {missing}"
        if reason == ""
            names = names.append(record.name)
            sequences = sequences.append(record.sequence)
        else
            rejected = rejected.append(Rejection(record.line, record.name, reason))
    return Checked(names, sequences, rejected, length)

class Bounds(int minimum, int maximum, int[] by_column)

Bounds parsimony_bounds(alignment.Patterns patterns)
    int[] minimum_by_pattern = []
    int maximum = 0
    for int p < int(len(patterns.encoded))
        int[] pattern = patterns.encoded[p]
        int minimum = 4
        for 1 <= int mask < 16
            bool intersects = true
            for int bases = pattern[]
                intersects = intersects and parsimony.intersection(mask, bases) != 0
            if intersects
                int count = population_count(mask, 4) - 1
                if count < minimum
                    minimum = count
        minimum_by_pattern = minimum_by_pattern.append(minimum)
        int greatest = int(len(pattern))
        for int base < 4
            int count = int(len([for int bases = pattern[] if not parsimony.contains_base(bases, base) then bases]))
            if count < greatest
                greatest = count
        maximum += greatest * patterns.weights[p]
    int[] by_column = [for int column = patterns.columns[] then minimum_by_pattern[column]]
    return Bounds(sum_integers(by_column), maximum, by_column)

real64 bme_length(tree_building.Tree tree, real64[][] matrix)
    int[] taxa = tree.taxa()
    real64 result = 0.0
    for int i < int(len(taxa))
        int first = taxa[i]
        int[] steps = tree_building.path_steps(tree, first)
        for i + 1 <= int j < int(len(taxa))
            int second = taxa[j]
            result += matrix[first][second] / real64(2 ^ (steps[second] - 1))
    return result

class Stepwise(tree_building.Tree tree, int initial, int score, int[][] additions, int evaluated, int[] taxa)

Stepwise stepwise_addition(int[] taxa, int size, alignment.Patterns patterns, int outgroup)
    tree_building.Tree tree = tree_building.star(size, taxa[0:<3])
    int initial = parsimony.score(tree, patterns.encoded, patterns.weights, outgroup)
    int current = initial
    int[][] additions = []
    int evaluated = 0
    for int taxon = taxa[3:<int(len(taxa))][]
        tree_building.Tree chosen = tree
        int best = -1
        int selected_mask = 0
        int ties = 0
        for int[] branch = parsimony.branches(tree, outgroup)[]
            tree_building.Tree candidate = parsimony.insert(tree, branch[1], branch[2], taxon)
            int value = parsimony.score(candidate, patterns.encoded, patterns.weights, outgroup)
            evaluated += 1
            if best < 0 or value < best
                best = value
                chosen = candidate
                selected_mask = branch[0]
                ties = 1
            elif value == best
                ties += 1
        tree = chosen
        current = best
        additions = additions.append([taxon, selected_mask, current, ties])
    return Stepwise(tree, initial, current, additions, evaluated, taxa)

class ParsMove(int mask, int swap, int score)
class ParsSearch(tree_building.Tree tree, int score, ParsMove[] moves, int evaluated)

ParsSearch search_parsimony(tree_building.Tree initial, alignment.Patterns patterns, int outgroup)
    tree_building.Tree tree = initial
    int current = parsimony.score(tree, patterns.encoded, patterns.weights, outgroup)
    ParsMove[] moves = []
    int evaluated = 0
    while true
        bool improved = false
        for parsimony.Candidate candidate = parsimony.nni_candidates(tree, outgroup)[]
            int value = parsimony.score(candidate.tree, patterns.encoded, patterns.weights, outgroup)
            evaluated += 1
            if value < current
                tree = candidate.tree
                current = value
                moves = moves.append(ParsMove(candidate.mask, candidate.swap, value))
                improved = true
                break
        if not improved
            break
    return ParsSearch(tree, current, moves, evaluated)

class BmeMove(int mask, int swap, real64 length)
class BmeSearch(tree_building.Tree tree, real64 length, BmeMove[] moves, int evaluated)

BmeSearch search_bme(tree_building.Tree initial, real64[][] matrix, int outgroup)
    tree_building.Tree tree = initial
    real64 current = bme_length(tree, matrix)
    BmeMove[] moves = []
    int evaluated = 0
    while true
        bool improved = false
        for parsimony.Candidate candidate = parsimony.nni_candidates(tree, outgroup)[]
            real64 value = bme_length(candidate.tree, matrix)
            evaluated += 1
            if value < current
                tree = candidate.tree
                current = value
                moves = moves.append(BmeMove(candidate.mask, candidate.swap, value))
                improved = true
                break
        if not improved
            break
    return BmeSearch(tree, current, moves, evaluated)

void populate_consensus(tree_building.Tree &tree, int parent, int mask, int[] clades)
    int size = tree.size
    int[] maximal = []
    for int clade = clades[]
        if clade == mask or not subset(clade, mask, size)
            continue
        bool contained = false
        for int other = clades[]
            if other != clade and other != mask and subset(clade, other, size) and subset(other, mask, size)
                contained = true
        if not contained
            maximal = maximal.append(clade)
    int covered = 0
    for int clade = maximal[]
        int node = .tree.internal()
        .tree.connect(parent, node)
        populate_consensus(&tree, node, clade, clades)
        covered += clade
    for int taxon < size
        if tree_io.contains_taxon(mask, taxon) and not tree_io.contains_taxon(covered, taxon)
            .tree.connect(parent, taxon)

tree_building.Tree consensus_tree(int size, int[] taxa, int outgroup, int[] clades)
    tree_building.Tree tree = tree_building.empty_tree(size)
    int root = .tree.internal()
    .tree.connect(root, outgroup)
    int ingroup = sum_integers([for int taxon = taxa[] if taxon != outgroup then 2 ^ taxon])
    populate_consensus(&tree, root, ingroup, clades)
    return tree

class Exhaustive(tree_building.Tree[] trees, int[] scores, real64[] lengths, string[] newicks, int best, int[] optimal, tree_building.Tree strict, int heuristic_score, int bme_best, real64 second)

Exhaustive exhaustive_search(int size, int[] taxa, int outgroup, alignment.Patterns patterns, real64[][] matrix, string[] names)
    tree_building.Tree[] trees = [tree_building.star(size, taxa[0:<3])]
    for int taxon = taxa[3:<int(len(taxa))][]
        tree_building.Tree[] expanded = []
        for tree_building.Tree tree = trees[]
            for int[] branch = parsimony.branches(tree, outgroup)[]
                expanded = expanded.append(parsimony.insert(tree, branch[1], branch[2], taxon))
        trees = expanded
    int[] scores = [for tree_building.Tree tree = trees[] then parsimony.score(tree, patterns.encoded, patterns.weights, outgroup)]
    real64[] lengths = [for tree_building.Tree tree = trees[] then bme_length(tree, matrix)]
    string[] newicks = [for tree_building.Tree tree = trees[] then tree_io.newick(tree, names, outgroup, false, [], false)]
    int best = scores.sorted()[0]
    string[] optimal_text = [for int i < int(len(trees)) if scores[i] == best then newicks[i]].sorted()
    int[] optimal = [for string text = optimal_text[] then name_index(newicks, text)]
    int[] common = tree_building.split_set(trees[optimal[0]], outgroup)
    for int index = optimal[1:<int(len(optimal))][]
        int[] splits = tree_building.split_set(trees[index], outgroup)
        common = [for int mask = common[] if has_integer(splits, mask) then mask]
    tree_building.Tree strict = consensus_tree(size, taxa, outgroup, common)
    Stepwise heuristic_start = stepwise_addition(taxa, size, patterns, outgroup)
    int heuristic_score = search_parsimony(heuristic_start.tree, patterns, outgroup).score
    int bme_best = 0
    for int i < int(len(trees))
        bool earlier = [newicks[i], newicks[bme_best]].sorted()[0] == newicks[i]
        if lengths[i] < lengths[bme_best] or (lengths[i] == lengths[bme_best] and earlier)
            bme_best = i
    real64 second = [for int i < int(len(trees)) if i != bme_best then lengths[i]].sorted()[0]
    return Exhaustive(trees, scores, lengths, newicks, best, optimal, strict, heuristic_score, bme_best, second)

real64[] site_likelihoods(tree_building.Tree tree, alignment.Patterns patterns, int outgroup, string[] names)
    tree_building.Rooted orientation = tree_building.root_tree(tree, outgroup)
    int[][] children = tree_io.child_order(tree, orientation, names)
    int nodes = int(len(tree.adjacent))
    real64[] same = [for int node < nodes then 0.0]
    real64[] different = same
    for int node = orientation.order[1:<int(len(orientation.order))][]
        real64 decay = math.exp(-(4.0 * tree.lengths[node][orientation.parents[node]]) / 3.0)
        same[node] = 0.25 + 0.75 * decay
        different[node] = 0.25 - 0.25 * decay
    real64[] by_pattern = []
    for int[] pattern = patterns.encoded[]
        real64[][] values = [for int node < nodes then [for int x < 4 then 0.0]]
        for int node = orientation.order[::-1][]
            if node < tree.size
                values[node] = [for int x < 4 then (if parsimony.contains_base(pattern[node], x) then 1.0 else 0.0)]
            else
                for int x < 4
                    real64 product = 1.0
                    for int child = children[node][]
                        real64 sum = 0.0
                        for int y < 4
                            sum += (if x == y then same[child] else different[child]) * values[child][y]
                        product *= sum
                    values[node][x] = product
        real64 joint = sum_reals([for int x < 4 then 0.25 * values[orientation.root][x]])
        real64 logarithm = math.log(joint)
        by_pattern = by_pattern.append(logarithm)
    return [for int column = patterns.columns[] then by_pattern[column]]

int rf_distance(int[] first, int[] second)
    int result = 0
    for int mask = first[]
        if not has_integer(second, mask)
            result += 1
    for int mask = second[]
        if not has_integer(first, mask)
            result += 1
    return result

int quartet_topology(int[] splits, int a, int b, int c, int d)
    for int mask = splits[]
        bool aa = tree_io.contains_taxon(mask, a)
        bool bb = tree_io.contains_taxon(mask, b)
        bool cc = tree_io.contains_taxon(mask, c)
        bool dd = tree_io.contains_taxon(mask, d)
        if aa == bb and cc == dd and aa != cc
            return 1
        if aa == cc and bb == dd and aa != bb
            return 2
        if aa == dd and bb == cc and aa != bb
            return 3
    return 0

int quartet_distance(int[] first, int[] second, int size)
    int result = 0
    for int a < size
        for a + 1 <= int b < size
            for b + 1 <= int c < size
                for c + 1 <= int d < size
                    if quartet_topology(first, a, b, c, d) != quartet_topology(second, a, b, c, d)
                        result += 1
    return result

class Generator(int state)
    int .draw()
        state = (48271 * state) % 2147483647
        return state

class Bootstrap(int[] supports, string[] replicate_lines, int identical, tree_building.Tree consensus, int[] appeared)

Bootstrap bootstrap_trees(string[] sequences, int[] taxa, int outgroup, Params params, int[] main_splits)
    int size = int(len(taxa))
    int length = int(len(sequences[0]))
    Generator generator = Generator(params.seed)
    int[] supports = [for int mask < 2 ^ size then 0]
    string[] lines = []
    int identical = 0
    for 1 <= int replicate <= params.replicates
        int[] weights = [for int c < length then 0]
        for int draw < length
            int value = .generator.draw()
            weights[value % length] += 1
        real64[][] matrix = distances.build_matrix(sequences, weights, params.model, params.saturation).values
        tree_building.Tree tree = tree_building.neighbor_joining(matrix, taxa)
        int[] splits = tree_building.split_set(tree, outgroup)
        for int mask = splits[]
            supports[mask] += 1
        int rf = rf_distance(splits, main_splits)
        if rf == 0
            identical += 1
        int distinct = int(len([for int weight = weights[] if weight > 0 then weight]))
        lines = lines.append("REPLICATE {replicate} distinct {distinct} rf {rf}")
    int[] appeared = [for int mask < int(len(supports)) if supports[mask] > 0 then mask]
    int[] majority = [for int mask = appeared[] if 2 * supports[mask] > params.replicates then mask]
    return Bootstrap(supports, lines, identical, consensus_tree(size, taxa, outgroup, majority), appeared)

string state_character(int state)
    for int base < 4
        if state == 2 ^ base
            return alignment.bases[base]
    return "N"

string[] format_matrix(string[] names, real64[][] matrix)
    int width = 0
    for string name = names[]
        if int(len(name)) > width
            width = int(len(name))
    string[] lines = []
    for int i < int(len(names))
        string padding = string.repeat(" ", nat(width - int(len(names[i]))))
        string values = [for real64 value = matrix[i][] then tree_io.format_real(value, 5)].join(" ")
        lines = lines.append(names[i] + padding + " " + values)
    return lines

class Study(alignment.Record[] records, Params params)
    Checked checked = check_records(records, params.max_missing)
    string[] names = checked.names
    string[] sequences = checked.sequences
    int size = int(len(names))
    int length = checked.columns
    int outgroup = name_index(names, params.outgroup_name)
    int[] taxa = [for int i < size then i]
    int[] ingroup = [for int i < size if i != outgroup then i]
    int[] exhaustive_taxa = [outgroup].concat([for int i = ingroup[] if has_integer([for string name = params.exhaustive_names[] then name_index(names, name)], i) then i])
    alignment.Patterns patterns = alignment.compress_patterns(sequences)
    int[] ordinary_weights = [for int c < length then 1]
    distances.Matrix[] matrices = [for int model < 3 then distances.build_matrix(sequences, ordinary_weights, model, params.saturation)]
    real64[][] main_matrix = matrices[params.model].values
    tree_building.Tree[] nj_trees = [for distances.Matrix matrix = matrices[] then tree_building.neighbor_joining(matrix.values, taxa)]
    tree_building.Tree main_tree = nj_trees[params.model]
    int[] main_splits = tree_building.split_set(main_tree, outgroup)
    Bounds bounds = parsimony_bounds(patterns)
    int[] mp_order = [outgroup].concat(ingroup)
    Stepwise mp_start = stepwise_addition(mp_order, size, patterns, outgroup)
    ParsSearch mp_search = search_parsimony(mp_start.tree, patterns, outgroup)
    tree_building.Tree mp_tree = mp_search.tree
    parsimony.Reconstruction reconstruction = parsimony.reconstruct(mp_tree, patterns.encoded, patterns.weights, patterns.columns, outgroup)
    for int i < int(len(reconstruction.branch_rows))
        .mp_tree.connect(reconstruction.branch_rows[i][1], reconstruction.branch_rows[i][2], real64(reconstruction.branch_changes[i]) / real64(length))
    BmeSearch me_search = search_bme(main_tree, main_matrix, outgroup)
    Exhaustive exhaustive = exhaustive_search(size, exhaustive_taxa, outgroup, patterns, main_matrix, names)
    real64[][] site_logs = [for tree_building.Tree tree = nj_trees[] then site_likelihoods(tree, patterns, outgroup, names)]
    real64[] loglik = [for real64[] values = site_logs[] then sum_reals(values)]
    int[][] nj_changes = []
    for tree_building.Tree tree = nj_trees[]
        local int[] by_pattern = parsimony.pattern_scores(tree, patterns.encoded, outgroup)
        nj_changes = nj_changes.append([for int column = patterns.columns[] then by_pattern[column]])
    Bootstrap bootstrap = bootstrap_trees(sequences, taxa, outgroup, params, main_splits)
    tree_building.Tree[] trees = nj_trees.concat([me_search.tree, mp_tree, bootstrap.consensus])
    int[][] splits = [for tree_building.Tree tree = trees[] then tree_building.split_set(tree, outgroup)]
    int[] scores = [for int i < 5 then parsimony.score(trees[i], patterns.encoded, patterns.weights, outgroup)]
    real64[] bme = [for int i < 5 then bme_length(trees[i], main_matrix)]
    real64[][][] patristic = [for tree_building.Tree tree = nj_trees[] then tree_building.patristic_matrix(tree)]
    real64[] tree_lengths = [for tree_building.Tree tree = nj_trees[] then sum_reals([for int[] edge = tree.edges()[] then tree.lengths[edge[0]][edge[1]]])]
    real64[] squared_errors = [for int model < 3 then 0.0]
    for int model < 3
        for int i < size
            for i + 1 <= int j < size
                local real64 difference = matrices[model].values[i][j] - patristic[model][i][j]
                squared_errors[model] += difference * difference

    string newick_text(tree_building.Tree tree, bool lengths, bool support)
        return tree_io.newick(tree, names, outgroup, lengths, bootstrap.supports, support)

    string[] summary_lines()
        string[] lines = ["INPUT records {len(records)} accepted {size} rejected {len(checked.rejected)} columns {length}"]
        for Rejection rejection = checked.rejected[]
            lines = lines.append("REJECT line {rejection.line} {rejection.name} {rejection.reason}")
        int[][] column_counts = [for int c < length then [0, 0, 0, 0]]
        for string sequence = sequences[]
            for int c < length
                int base = alignment.base_index(sequence[c])
                if base >= 0
                    column_counts[c][base] += 1
        int[] composition = [0, 0, 0, 0]
        for int taxon < size
            int[] counts = [0, 0, 0, 0]
            int ambiguous = 0
            int missing = 0
            int unique = 0
            for int c < length
                string character = sequences[taxon][c]
                int base = alignment.base_index(character)
                if base >= 0
                    counts[base] += 1
                    if column_counts[c][base] == 1 and sum_integers(column_counts[c]) > 1
                        unique += 1
                elif character == "-" or character == "N"
                    missing += 1
                else
                    ambiguous += 1
            int bases = sum_integers(counts)
            real64 gc = real64(counts[1] + counts[2]) / real64(bases)
            lines = lines.append("TAXON {names[taxon]} bases {bases} ambiguous {ambiguous} missing {missing} unique {unique} gc " + tree_io.format_real(gc, 4))
            for int base < 4
                composition[base] += counts[base]
        int[] classes = alignment.classify_columns(sequences)
        lines = lines.concat(["COLUMNS constant {classes[0]} variable {classes[1]} informative {classes[2]} gapped {classes[3]} empty {classes[4]}", "PATTERNS {len(patterns.texts)}"])
        int total = sum_integers(composition)
        string values = [for int base < 4 then alignment.bases[base] + " " + tree_io.format_real(real64(composition[base]) / real64(total), 4)].join(" ")
        return lines.append("COMPOSITION " + values)

    string[] distance_lines()
        string[][] blocks = []
        string[] pairs = []
        int[] totals = [0, 0, 0]
        for int i < size
            for i + 1 <= int j < size
                int[] counts = matrices[0].tallies[i][j]
                for int k < 3
                    totals[k] += counts[k]
                pairs = pairs.append("PAIR {names[i]} {names[j]} sites {counts[0]} transitions {counts[1]} transversions {counts[2]}")
        blocks = blocks.append(pairs.append("TOTAL sites {totals[0]} transitions {totals[1]} transversions {totals[2]}"))
        for int model < 3
            string[] lines = ["MODEL {model_names[model]}"].concat(format_matrix(names, matrices[model].values))
            for int i < size
                for i + 1 <= int j < size
                    if matrices[model].saturated_pairs[i][j]
                        lines = lines.append("SATURATED {names[i]} {names[j]} sites {matrices[model].tallies[i][j][0]}")
            blocks = blocks.append(lines)
        blocks = blocks.append(["PATRISTIC {methods[params.model]}"].concat(format_matrix(names, patristic[params.model])))
        string[] me = ["ME start {methods[params.model]} length " + tree_io.format_real(bme_length(main_tree, main_matrix), 5)]
        for BmeMove move = me_search.moves[]
            me = me.append("NNI edge " + tree_io.symbols(move.mask, size) + " swap {move.swap} length " + tree_io.format_real(move.length, 5))
        me = me.concat(["ME moves {len(me_search.moves)} evaluated {me_search.evaluated} length " + tree_io.format_real(me_search.length, 5),
            "EXHAUSTIVE taxa {len(exhaustive_taxa)} trees {len(exhaustive.trees)} best " + tree_io.format_real(exhaustive.lengths[exhaustive.bme_best], 5) + " second " + tree_io.format_real(exhaustive.second, 5),
            "BEST {exhaustive.newicks[exhaustive.bme_best]} parsimony {exhaustive.scores[exhaustive.bme_best]}"])
        blocks = blocks.append(me)
        string[] result = []
        for string[] block = blocks[]
            if len(result) != 0
                result = result.append("")
            result = result.concat(block)
        return result

    string[] tree_lines()
        return [for int i < 6 then methods[i] + " " + newick_text(trees[i], i < 3 or i == 4, i == 5)]

    string[] cladogram_lines()
        string[] lines = []
        for int i < 6
            if i != 0
                lines = lines.append("")
            lines = lines.append("TREE {methods[i]}").concat(tree_io.cladogram(trees[i], names, outgroup, bootstrap.supports))
        return lines

    string score_line(string method, int score)
        real64 ci = real64(bounds.minimum) / real64(score)
        real64 ri = real64(bounds.maximum - score) / real64(bounds.maximum - bounds.minimum)
        return "TREE {method} score {score} ci " + tree_io.format_real(ci, 4) + " ri " + tree_io.format_real(ri, 4)

    string[] parsimony_lines()
        string[] lines = ["BOUNDS minimum {bounds.minimum} maximum {bounds.maximum}"]
        for int i < 3
            lines = lines.append(score_line(methods[i], scores[i]))
        lines = lines.append("START {names[mp_order[0]]} {names[mp_order[1]]} {names[mp_order[2]]} score {mp_start.initial}")
        for int[] addition = mp_start.additions[]
            lines = lines.append("ADD {names[addition[0]]} edge " + tree_io.symbols(addition[1], size) + " score {addition[2]} ties {addition[3]}")
        lines = lines.append("STEPWISE score {mp_start.score} evaluated {mp_start.evaluated}")
        for ParsMove move = mp_search.moves[]
            lines = lines.append("NNI edge " + tree_io.symbols(move.mask, size) + " swap {move.swap} score {move.score}")
        lines = lines.concat(["SEARCH moves {len(mp_search.moves)} evaluated {mp_search.evaluated} score {mp_search.score}", score_line("MP", mp_search.score), "MP " + newick_text(mp_tree, true, false)])
        int maximum = reconstruction.site_changes.sorted()[length - 1]
        for int changes <= maximum
            int count = int(len([for int value = reconstruction.site_changes[] if value == changes then value]))
            lines = lines.append("CHANGES {changes} columns {count}")
        int homoplasy = int(len([for int c < length if reconstruction.site_changes[c] > bounds.by_column[c] then c]))
        lines = lines.append("HOMOPLASY columns {homoplasy} extra {mp_search.score - bounds.minimum}")
        tree_building.Rooted orientation = tree_building.root_tree(mp_tree, outgroup)
        int node_count = int(len(mp_tree.adjacent))
        int[] keys = []
        for int node = mp_tree.internal_nodes()[]
            int mask = if node == orientation.root then orientation.ingroup else orientation.masks[node]
            keys = keys.append(tree_io.symbol_key(mask, size) * node_count + node)
        for int key = keys.sorted()[]
            int node = key % node_count
            int mask = if node == orientation.root then orientation.ingroup else orientation.masks[node]
            string sequence = [for int state = reconstruction.states[node][] then state_character(state)].join("")
            lines = lines.append("ANCESTOR " + tree_io.symbols(mask, size) + " " + sequence)
        lines = lines.concat(["", "EXHAUSTIVE taxa {len(exhaustive_taxa)} trees {len(exhaustive.trees)} best {exhaustive.best} optimal {len(exhaustive.optimal)}"])
        for int score = unique_integers(exhaustive.scores)[]
            int count = int(len([for int value = exhaustive.scores[] if value == score then value]))
            lines = lines.append("SCORE {score} trees {count}")
        for int index = exhaustive.optimal[]
            lines = lines.append("OPTIMAL {exhaustive.newicks[index]} bme " + tree_io.format_real(exhaustive.lengths[index], 5))
        lines = lines.append("STRICT " + newick_text(exhaustive.strict, false, false))
        return lines.append("HEURISTIC score {exhaustive.heuristic_score} optimal " + (if exhaustive.heuristic_score == exhaustive.best then "yes" else "no"))

    string[] likelihood_lines()
        string[] lines = ["LIKELIHOOD columns {length} patterns {len(patterns.texts)}"]
        for int i < 3
            lines = lines.append("TREE {methods[i]} loglik " + tree_io.format_real(loglik[i], 4) + " per_site " + tree_io.format_real(loglik[i] / real64(length), 4))
        for int a < 3
            for a + 1 <= int b < 3
                real64[] deltas = [for int c < length then site_logs[a][c] - site_logs[b][c]]
                real64 difference = sum_reals(deltas)
                real64 average = difference / real64(length)
                real64 variance_sum = sum_reals([for real64 delta = deltas[] then (delta - average) * (delta - average)])
                real64 se = math.sqrt((real64(length) / real64(length - 1)) * variance_sum)
                lines = lines.append("KH {methods[a]} {methods[b]} difference " + tree_io.format_real(difference, 4) + " se " + tree_io.format_real(se, 4) + " z " + tree_io.format_real(difference / se, 4))
        lines = lines.append("LOWEST {methods[params.model]} sites {params.low_sites}")
        int[] units = [for real64 value = site_logs[params.model][] then tree_io.rounded_units(value, 4)]
        int minimum = units.sorted()[0]
        int[] keys = [for int c < length then (units[c] - minimum) * length + c]
        int[] ordered = keys.sorted()
        for int i < params.low_sites
            int c = ordered[i] % length
            string pattern = patterns.texts[patterns.columns[c]]
            lines = lines.append("SITE {c + 1} loglik " + tree_io.format_real(site_logs[params.model][c], 4) + " changes {nj_changes[params.model][c]} pattern {pattern}")
        return lines

    string[] bootstrap_lines()
        string[] lines = ["BOOTSTRAP model {model_names[params.model]} replicates {params.replicates} seed {params.seed}"].concat(bootstrap.replicate_lines).append("IDENTICAL {bootstrap.identical}")
        for int mask = tree_io.ordered_masks(main_splits, size)[]
            lines = lines.append("SUPPORT " + tree_io.symbols(mask, size) + " {bootstrap.supports[mask]}")
        int base = 2 ^ size
        int[] keys = [for int mask = bootstrap.appeared[] then ((params.replicates - bootstrap.supports[mask]) * base + tree_io.symbol_key(mask, size)) * base + mask]
        for int key = keys.sorted()[]
            int mask = key % base
            lines = lines.append("SPLIT " + tree_io.symbols(mask, size) + " {bootstrap.supports[mask]}")
        lines = lines.append("CONSENSUS " + newick_text(bootstrap.consensus, false, true))
        for int removed = ingroup[]
            int[] remaining = [for int taxon = taxa[] if taxon != removed then taxon]
            tree_building.Tree jackknife = tree_building.neighbor_joining(main_matrix, remaining)
            int[] restricted = []
            for int mask = main_splits[]
                int value = if tree_io.contains_taxon(mask, removed) then mask - 2 ^ removed else mask
                int count = population_count(value, size)
                if count >= 2 and count <= size - 3
                    restricted = restricted.append(value)
            int rf = rf_distance(tree_building.split_set(jackknife, outgroup), unique_integers(restricted))
            lines = lines.append("JACKKNIFE {names[removed]} rf {rf}")
        return lines

    string[] clock_lines()
        string[] pairs = []
        int rejected = 0
        for int i < int(len(ingroup))
            for i + 1 <= int j < int(len(ingroup))
                int a = ingroup[i]
                int b = ingroup[j]
                int m1 = 0
                int m2 = 0
                for int c < length
                    int first = alignment.base_index(sequences[a][c])
                    int second = alignment.base_index(sequences[b][c])
                    int reference = alignment.base_index(sequences[outgroup][c])
                    if first < 0 or second < 0 or reference < 0 or first == second
                        continue
                    if second == reference
                        m1 += 1
                    if first == reference
                        m2 += 1
                int difference = m1 - m2
                int numerator = difference * difference
                int denominator = m1 + m2
                bool reject = 1000 * numerator > 3841 * denominator
                if reject
                    rejected += 1
                string chi2 = if denominator == 0 then "-" else tree_io.format_real(real64(numerator) / real64(denominator), 4)
                pairs = pairs.append("RRT {names[a]} {names[b]} m1 {m1} m2 {m2} chi2 {chi2} " + (if reject then "reject" else "ok"))
        string[] lines = ["RELATIVE_RATE outgroup {names[outgroup]} pairs {len(pairs)} rejected {rejected}"].concat(pairs)
        tree_building.Rooted orientation = tree_building.root_tree(main_tree, outgroup)
        real64[] values = tree_building.path_distances(main_tree, orientation.root)
        real64 average = sum_reals([for int taxon = ingroup[] then values[taxon]]) / real64(len(ingroup))
        real64 variance = sum_reals([for int taxon = ingroup[] then (values[taxon] - average) * (values[taxon] - average)]) / real64(int(len(ingroup)) - 1)
        real64 sd = math.sqrt(variance)
        lines = lines.append("ROOT_TO_TIP {methods[params.model]} mean " + tree_io.format_real(average, 5) + " sd " + tree_io.format_real(sd, 5) + " cv " + tree_io.format_real(sd / average, 4))
        for int taxon = ingroup[]
            lines = lines.append("TIP {names[taxon]} " + tree_io.format_real(values[taxon], 5))
        return lines

    string[] comparison_lines()
        string[] lines = []
        for int i < 6
            int supported = int(len([for int mask = splits[i][] if 2 * bootstrap.supports[mask] > params.replicates then mask]))
            string score = if i == 5 then "-" else scores[i].string()
            string evolution = if i == 5 then "-" else tree_io.format_real(bme[i], 5)
            string total_length = if i < 3 then tree_io.format_real(tree_lengths[i], 5) elif i == 4 then tree_io.format_real(real64(mp_search.score) / real64(length), 5) else "-"
            string negative = if i < 3 then nj_trees[i].negative.string() else "-"
            string sse = if i < 3 then tree_io.format_real(squared_errors[i], 6) else "-"
            string likelihood = if i < 3 then tree_io.format_real(loglik[i], 4) else "-"
            lines = lines.append("TREE {methods[i]} splits {len(splits[i])} supported {supported} parsimony {score} bme {evolution} length {total_length} negative {negative} sse {sse} loglik {likelihood}")
        lines = lines.append("RF " + methods.join(" "))
        for int a < 6
            string values = [for int b < 6 then rf_distance(splits[a], splits[b]).string()].join(" ")
            lines = lines.append(methods[a] + " " + values)
        lines = lines.append("QUARTET " + methods.join(" "))
        for int a < 6
            string values = [for int b < 6 then quartet_distance(splits[a], splits[b], size).string()].join(" ")
            lines = lines.append(methods[a] + " " + values)
        int[] all_clades = []
        for int[] clades = splits[]
            all_clades = all_clades.concat(clades)
        all_clades = tree_io.ordered_masks(unique_integers(all_clades), size)
        int[][] main_branches = parsimony.branches(main_tree, outgroup)
        for int mask = all_clades[]
            string marks = [for int i < 6 then (if has_integer(splits[i], mask) then "+" else "-")].join("")
            string branch_length = "-"
            for int[] branch = main_branches[]
                if branch[0] == mask
                    branch_length = tree_io.format_real(main_tree.lengths[branch[1]][branch[2]], 5)
                    break
            string changes = "-"
            for int i < int(len(reconstruction.branch_rows))
                if reconstruction.branch_rows[i][0] == mask
                    changes = reconstruction.branch_changes[i].string()
                    break
            lines = lines.append("CLADE " + tree_io.symbols(mask, size) + " support {bootstrap.supports[mask]} trees {marks} length {branch_length} changes {changes}")
        return lines

    string[] hypothesis_lines()
        string[] lines = []
        int ingroup_mask = sum_integers([for int taxon = ingroup[] then 2 ^ taxon])
        int exhaustive_ingroup = sum_integers([for int taxon = exhaustive_taxa[] if taxon != outgroup then 2 ^ taxon])
        int[][] exhaustive_splits = [for tree_building.Tree tree = exhaustive.trees[] then tree_building.split_set(tree, outgroup)]
        for string row = read_lines("input/clades.txt")[]
            string[] fields = row.split(" ")
            string name = fields[0]
            int mask = 0
            string reason = ""
            for string taxon_name = fields[1:<int(len(fields))][]
                int taxon = name_index(names, taxon_name)
                if taxon < 0
                    reason = "unknown taxon {taxon_name}"
                    break
                mask += 2 ^ taxon
            if reason == "" and tree_io.contains_taxon(mask, outgroup)
                reason = "contains outgroup"
            if reason != ""
                lines = lines.append("INVALID {name} {reason}")
                continue
            lines = lines.append("CLADE {name} taxa {population_count(mask, size)} support {bootstrap.supports[mask]}")
            for int i < 6
                int common = ingroup_mask
                for int clade = splits[i][]
                    if subset(mask, clade, size) and population_count(clade, size) < population_count(common, size)
                        common = clade
                string[] intruders = [for int taxon = ingroup[] if tree_io.contains_taxon(common, taxon) and not tree_io.contains_taxon(mask, taxon) then names[taxon]]
                string joined = if len(intruders) == 0 then "-" else intruders.join(",")
                string monophyletic = if common == mask then "yes" else "no"
                lines = lines.append("TEST {name} {methods[i]} monophyletic {monophyletic} mrca {population_count(common, size)} intruders {joined}")
            int restricted = mask_intersection(mask, exhaustive_ingroup, size)
            int count = population_count(restricted, size)
            if count < 2 or count >= int(len(exhaustive_taxa)) - 1
                lines = lines.append("SUBSET {name} untestable")
            else
                int[] score_min = [0, 0]
                real64[] bme_min = [0.0, 0.0]
                bool[] seen = [false, false]
                for int index < int(len(exhaustive.trees))
                    int side = if has_integer(exhaustive_splits[index], restricted) then 0 else 1
                    if not seen[side] or exhaustive.scores[index] < score_min[side]
                        score_min[side] = exhaustive.scores[index]
                    if not seen[side] or exhaustive.lengths[index] < bme_min[side]
                        bme_min[side] = exhaustive.lengths[index]
                    seen[side] = true
                lines = lines.append("SUBSET {name} taxa {count} with {score_min[0]} without {score_min[1]} bme_with " + tree_io.format_real(bme_min[0], 5) + " bme_without " + tree_io.format_real(bme_min[1], 5))
        return lines

void run_program()
    Study study = Study(alignment.read_fasta(), read_parameters())
    tree_io.write_lines("summary.txt", study.summary_lines())
    tree_io.write_lines("distances.txt", study.distance_lines())
    tree_io.write_lines("trees.nwk", study.tree_lines())
    tree_io.write_lines("cladograms.txt", study.cladogram_lines())
    tree_io.write_lines("parsimony.txt", study.parsimony_lines())
    tree_io.write_lines("likelihood.txt", study.likelihood_lines())
    tree_io.write_lines("bootstrap.txt", study.bootstrap_lines())
    tree_io.write_lines("clock.txt", study.clock_lines())
    tree_io.write_lines("comparison.txt", study.comparison_lines())
    tree_io.write_lines("hypotheses.txt", study.hypothesis_lines())

run_program()
