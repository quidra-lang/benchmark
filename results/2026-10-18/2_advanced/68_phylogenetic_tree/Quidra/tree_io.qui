import math
import tree_building = "./tree_building.qui"

int rounded_units(real64 value, int places)
    real64 magnitude = if value < 0.0 then -value else value
    int units = math.floor(magnitude * real64(10 ^ places) + 0.5)
    return if value < 0.0 then -units else units

string format_real(real64 value, int places)
    int factor = 10 ^ places
    int units = rounded_units(value, places)
    string sign = if units < 0 then "-" else ""
    if units < 0
        units = -units
    string tail = (units % factor).string()
    return sign + (units / factor).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

bool contains_taxon(int mask, int taxon)
    return (mask / (2 ^ taxon)) % 2 == 1

string symbols(int mask, int size)
    return [for int taxon < size then (if contains_taxon(mask, taxon) then "*" else ".")].join("")

int symbol_key(int mask, int size)
    int key = 0
    for int taxon < size
        key = 2 * key + (if contains_taxon(mask, taxon) then 0 else 1)
    return key

int[] ordered_masks(int[] masks, int size)
    int base = 2 ^ size
    int[] keys = [for int mask = masks[] then symbol_key(mask, size) * base + mask]
    return [for int key = keys.sorted()[] then key % base]

int[][] child_order(tree_building.Tree tree, tree_building.Rooted orientation, string[] names)
    int size = int(len(tree.adjacent))
    string[] minimum = [for int node < size then ""]
    int[][] children = [for int node < size then []]
    for int node = orientation.order[::-1][]
        if node < tree.size
            minimum[node] = names[node]
        else
            string[] ordered = [for int child = orientation.children[node][] then minimum[child]].sorted()
            for string name = ordered[]
                for int child = orientation.children[node][]
                    if minimum[child] == name
                        children[node] = children[node].append(child)
                        break
            minimum[node] = ordered[0]
    return children

string node_text(tree_building.Tree tree, tree_building.Rooted orientation, int[][] children, string[] names, int node, bool lengths, int[] support, bool with_support)
    string text = ""
    if node < tree.size
        text = names[node]
    else
        text = "(" + [for int child = children[node][] then node_text(tree, orientation, children, names, child, lengths, support, with_support)].join(",") + ")"
        if with_support and node != orientation.root
            text += support[orientation.masks[node]].string()
    if lengths and node != orientation.root
        text += ":" + format_real(tree.lengths[node][orientation.parents[node]], 5)
    return text

string newick(tree_building.Tree tree, string[] names, int outgroup, bool lengths, int[] support, bool with_support)
    tree_building.Rooted orientation = tree_building.root_tree(tree, outgroup)
    int[][] children = child_order(tree, orientation, names)
    return node_text(tree, orientation, children, names, orientation.root, lengths, support, with_support) + ";"

void descend(tree_building.Tree tree, tree_building.Rooted orientation, int[][] children, string[] names, int[] support, int node, string prefix, string[] &lines)
    for int i < int(len(children[node]))
        int child = children[node][i]
        bool last = i + 1 == int(len(children[node]))
        string connector = if last then "`-- " else "|-- "
        string label = if child < tree.size then names[child] else "[{support[orientation.masks[child]]}]"
        lines = lines.append(prefix + connector + label)
        descend(tree, orientation, children, names, support, child, prefix + (if last then "    " else "|   "), &lines)

string[] cladogram(tree_building.Tree tree, string[] names, int outgroup, int[] support)
    tree_building.Rooted orientation = tree_building.root_tree(tree, outgroup)
    int[][] children = child_order(tree, orientation, names)
    string[] lines = ["*"]
    descend(tree, orientation, children, names, support, orientation.root, "", &lines)
    return lines

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
