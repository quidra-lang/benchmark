import math
import alignment = "./alignment.qui"

int[] tally_pair(string first, string second, int[] weights)
    sites := 0
    transitions := 0
    transversions := 0
    for: c < int(len(weights))
        int a := alignment.base_index(first[c])
        int b := alignment.base_index(second[c])
        if a < 0 or b < 0
            continue
        sites += weights[c]
        if a != b
            bool transition := (a == 0 and b == 2) or (a == 2 and b == 0) or (a == 1 and b == 3) or (a == 3 and b == 1)
            if transition
                transitions += weights[c]
            else
                transversions += weights[c]
    return [sites, transitions, transversions]

bool saturated(int[] counts, int model)
    int n := counts[0]
    int s := counts[1]
    int v := counts[2]
    return n == 0 or (model == 1 and 4 * (s + v) >= 3 * n) or (model == 2 and (2 * s + v >= n or 2 * v >= n))

real64 corrected(int[] counts, int model, real64 saturation_distance)
    if saturated(counts, model)
        return saturation_distance
    n := real64(counts[0])
    int s := counts[1]
    int v := counts[2]
    if model == 0
        return real64(s + v) / n
    if model == 1
        real64 logarithm := math.log(1.0 - real64(4 * (s + v)) / real64(3 * counts[0]))
        return -0.75 * logarithm
    real64 first := math.log(1.0 - real64(2 * s) / n - real64(v) / n)
    real64 second := math.log(1.0 - real64(2 * v) / n)
    return -0.5 * first - 0.25 * second

class Matrix(real64[][] values, int[][][] tallies, bool[][] saturated_pairs)

Matrix build_matrix(string[] sequences, int[] weights, int model, real64 saturation_distance)
    size := int(len(sequences))
    real64[][] values := [for i := (0:<int(size))[] then [for j := (0:<int(size))[] then 0.0]]
    int[][][] tallies := [for i := (0:<int(size))[] then [for j := (0:<int(size))[] then [0, 0, 0]]]
    bool[][] saturated_pairs := [for i := (0:<int(size))[] then [for j := (0:<int(size))[] then false]]
    for: int i < size
        for: i + 1 <= int j < size
            int[] counts := tally_pair(sequences[i], sequences[j], weights)
            real64 value := corrected(counts, model, saturation_distance)
            tallies[i][j] = counts
            tallies[j][i] = counts
            values[i][j] = value
            values[j][i] = value
            saturated_pairs[i][j] = saturated(counts, model)
            saturated_pairs[j][i] = saturated_pairs[i][j]
    return Matrix(values, tallies, saturated_pairs)
