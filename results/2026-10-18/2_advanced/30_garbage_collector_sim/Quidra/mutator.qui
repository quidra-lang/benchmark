class CollectorEntry(string name, string algorithm, int young = 0, int age = 0)
class Config(int heap_size, CollectorEntry[] collectors, string[] maps, int[] windows, int width)
class Command(int line, string name)
    int pointers = 0
    int data = 0
    int slot = 0
    int field = 0
    int source = -1
    int count = 0
    string label = ""

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

Config read_config(string path)
    int heap_size = 0
    CollectorEntry[] collectors = []
    string[] maps = []
    int[] windows = []
    int width = 0
    for string line = read_lines(path)[]
        string[] fields = line.split(" ")
        if fields[0] == "HEAP"
            heap_size = int.parse(fields[1])
        elif fields[0] == "COLLECTOR"
            int young = if len(fields) > 3 then int.parse(fields[3]) else 0
            int age = if len(fields) > 4 then int.parse(fields[4]) else 0
            collectors = collectors.append(CollectorEntry(fields[1], fields[2], young, age))
        elif fields[0] == "MAPS"
            maps = fields[1:]
        elif fields[0] == "MMU"
            windows = [for string value = fields[1:][] then int.parse(value)]
        else
            width = int.parse(fields[1])
    return Config(heap_size, collectors, maps, windows, width)

bool is_number(string token)
    if len(token) < 1 or len(token) > 4 or (len(token) > 1 and token[0] == "0")
        return false
    for int position < int(len(token))
        string character = token[position]
        if not "0123456789".contains(character)
            return false
    return true

bool is_label(string token)
    if len(token) < 1 or len(token) > 16
        return false
    for int position < int(len(token))
        string character = token[position]
        if not "abcdefghijklmnopqrstuvwxyz0123456789_".contains(character)
            return false
    return true

int source_value(string token)
    return if token == "-" then -1 else int.parse(token)

class Parsed(Command command, string reason)

Parsed parse_line(int line, string text)
    string[] tokens = text.split(" ")
    string name = tokens[0]
    string[] form = []
    if name == "ALLOC" or name == "LOAD"
        form = ["number", "number"]
    elif name == "PUSH"
        form = ["source"]
    elif name == "POP"
        form = ["number"]
    elif name == "SET"
        form = ["number", "number", "source"]
    elif name == "OVERWRITE"
        form = ["number", "source"]
    elif name == "CHECKPOINT"
        form = ["label"]
    Command command = Command(line, name)
    if len(form) == 0 or len(tokens) != len(form) + 1
        return Parsed(command, "syntax")
    for int position < int(len(form))
        string token = tokens[position + 1]
        bool valid = if form[position] == "number" then is_number(token) elif form[position] == "source" then token == "-" or is_number(token) else is_label(token)
        if not valid
            return Parsed(command, "syntax")
    if name == "ALLOC"
        command.pointers = int.parse(tokens[1])
        command.data = int.parse(tokens[2])
    elif name == "PUSH"
        command.source = source_value(tokens[1])
    elif name == "LOAD"
        command.slot = int.parse(tokens[1])
        command.field = int.parse(tokens[2])
    elif name == "POP"
        command.count = int.parse(tokens[1])
    elif name == "SET"
        command.slot = int.parse(tokens[1])
        command.field = int.parse(tokens[2])
        command.source = source_value(tokens[3])
    elif name == "OVERWRITE"
        command.slot = int.parse(tokens[1])
        command.source = source_value(tokens[2])
    else
        command.label = tokens[1]
    if (name == "ALLOC" and (command.pointers > 6 or command.data > 24)) or (name == "POP" and command.count == 0)
        return Parsed(command, "range")
    return Parsed(command, "")
