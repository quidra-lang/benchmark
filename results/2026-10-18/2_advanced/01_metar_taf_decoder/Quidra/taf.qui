import groups = "./groups.qui"
import units = "./units.qui"

int[] slots()
    return [1, 3, 5, 6]

bool indicator(string text)
    return groups.locate(["BECMG", "TEMPO", "PROB30", "PROB40"], text) >= 0 or (len(text) == 8 and text.starts_with("FM") and units.digits(text[2:<8], 6, 6))

class Change(string kind, int start, int finish, groups.Group[] body)
    groups.Section state = groups.Section()

class Parts(groups.Group[] base, Change[] changes)
class Temporary(string kind, groups.Section state)
class Hour(int moment, groups.Section prevailing, Temporary[] temporary)

Parts split(groups.Group[] body, units.Calendar calendar, int issue_day, int valid_start, int valid_finish, int report, groups.Problem[] &problems)
    int cursor = 0
    while cursor < int(len(body)) and not indicator(body[cursor].text)
        cursor += 1
    groups.Group[] base = body[0:<cursor]
    Change[] changes = []
    while cursor < int(len(body))
        groups.Group item = body[cursor]
        string kind = if item.text.starts_with("FM") then "FM" else item.text
        cursor += 1
        if (kind == "PROB30" or kind == "PROB40") and cursor < int(len(body)) and body[cursor].text == "TEMPO"
            kind += " TEMPO"
            cursor += 1
        int finish = cursor
        while finish < int(len(body)) and not indicator(body[finish].text)
            finish += 1
        if kind == "FM"
            int moment = calendar.change(item.text, issue_day)
            if moment < valid_start or moment >= valid_finish
                groups.record(&problems, report, item.position, "invalid period", item.text)
            else
                changes = changes.append(Change(kind, moment, moment, body[cursor:<finish]))
        elif cursor == finish or len(body[cursor].text) != 9 or body[cursor].text[4] != "/" or not units.digits(body[cursor].text[0:<4], 4, 4) or not units.digits(body[cursor].text[5:<9], 4, 4)
            groups.record(&problems, report, item.position, "missing period", kind)
        else
            units.Period period = calendar.period(body[cursor].text, issue_day)
            if not period.valid or period.start < valid_start or period.finish > valid_finish
                groups.record(&problems, report, body[cursor].position, "invalid period", body[cursor].text)
            else
                changes = changes.append(Change(kind, period.start, period.finish, body[cursor + 1:<finish]))
        cursor = finish
    return Parts(base, changes)

groups.Section overlay(groups.Section base, groups.Section change)
    groups.Section result = base
    for int kind = slots()[]
        if change.singles[kind].present
            result.singles[kind] = change.singles[kind]
            result.lists[kind] = change.lists[kind]
    return result

Hour[] expand(int start, int finish, groups.Section base, Change[] changes)
    Hour[] result = []
    for start <= int hour < finish step 60
        groups.Section state = base
        for Change change = changes[]
            if change.kind == "FM" and change.start <= hour
                state = change.state
            if change.kind == "BECMG" and change.finish <= hour
                state = overlay(state, change.state)
        Temporary[] temporary = []
        for Change change = changes[]
            if change.kind != "FM" and change.kind != "BECMG" and change.start <= hour and hour < change.finish
                temporary = temporary.append(Temporary(change.kind, overlay(state, change.state)))
        result = result.append(Hour(hour, state, temporary))
    return result
