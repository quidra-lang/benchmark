int absolute(int value)
    return if value < 0 then -value else value

int floor_div(int numerator, int denominator)
    if numerator >= 0
        return numerator / denominator
    return -((-numerator + denominator - 1) / denominator)

int modulo(int value, int divisor)
    return value - floor_div(value, divisor) * divisor

int knots(int value)
    return (value * 1944 + 500) / 1000

int in_hg(int value)
    return (value * 2953 + 500) / 1000

int h_pa(int value)
    return (value * 33864 + 50000) / 100000

int sine(int angle)
    int[] table = [0, 174, 342, 500, 643, 766, 866, 940, 985, 1000]
    int reduced = modulo(angle, 360)
    int offset = reduced
    if reduced > 270
        offset = 360 - reduced
    elif reduced > 180
        offset = reduced - 180
    elif reduced > 90
        offset = 180 - reduced
    return table[offset / 10] * (if reduced <= 180 then 1 else -1)

int cosine(int angle)
    return sine(angle + 90)

int days(int year, int month)
    if month == 2
        return if year % 400 == 0 or (year % 4 == 0 and year % 100 != 0) then 29 else 28
    if month == 4 or month == 6 or month == 9 or month == 11
        return 30
    return 31

bool digits(string text, int minimum = 1, int maximum = 1000)
    if int(len(text)) < minimum or int(len(text)) > maximum
        return false
    for nat offset < len(text)
        if not "0123456789".contains(text[offset])
            return false
    return true

string pad(int value, int width)
    string result = value.string()
    while int(len(result)) < width
        result = "0" + result
    return result

class Period(bool valid = false, int start = 0, int finish = 0)

class Calendar(int year, int month)
    string stamp(int moment)
        int output_year = year
        int output_month = month
        int remaining = moment
        if remaining >= days(year, month) * 1440
            remaining -= days(year, month) * 1440
            output_month += 1
            if output_month == 13
                output_month = 1
                output_year += 1
        return "{pad(output_year, 4)}-{pad(output_month, 2)}-{pad(remaining / 1440 + 1, 2)}T{pad(remaining % 1440 / 60, 2)}:{pad(remaining % 60, 2)}Z"

    int observation(string text)
        if len(text) != 7 or text[6] != "Z" or not digits(text[0:<6])
            return -1
        int day = int.parse(text[0:<2])
        int hour = int.parse(text[2:<4])
        int minute = int.parse(text[4:<6])
        if day < 1 or day > days(year, month) or hour > 23 or minute > 59
            return -1
        return ((day - 1) * 24 + hour) * 60 + minute

    int day_time(int day, int hour, int minute, int issue_day)
        bool following = day < issue_day
        int following_month = if month == 12 then 1 else month + 1
        int following_year = year + (if month == 12 then 1 else 0)
        int limit = if following then days(following_year, following_month) else days(year, month)
        if day < 1 or day > limit
            return -1
        return (if following then days(year, month) * 1440 else 0) + ((day - 1) * 24 + hour) * 60 + minute

    Period period(string text, int issue_day, int limit = 0)
        if len(text) != 9 or text[4] != "/" or not digits(text[0:<4]) or not digits(text[5:<9])
            return Period()
        int first_hour = int.parse(text[2:<4])
        int last_hour = int.parse(text[7:<9])
        if first_hour > 23 or last_hour < 1 or last_hour > 24
            return Period()
        int first = day_time(int.parse(text[0:<2]), first_hour, 0, issue_day)
        int last = day_time(int.parse(text[5:<7]), last_hour, 0, issue_day)
        if first < 0 or last < 0 or first >= last or (limit > 0 and last > first + limit)
            return Period()
        return Period(true, first, last)

    int change(string text, int issue_day)
        if len(text) != 8 or not text.starts_with("FM") or not digits(text[2:<8])
            return -1
        int hour = int.parse(text[4:<6])
        int minute = int.parse(text[6:<8])
        if hour > 23 or minute > 59
            return -1
        return day_time(int.parse(text[2:<4]), hour, minute, issue_day)

class Fraction(int numerator, int denominator)

Fraction miles(string kind, int whole, int numerator, int denominator)
    if kind == "mile"
        return Fraction(whole * denominator + numerator, denominator)
    return Fraction(1000 * whole, 1609344)

int meters(string kind, int whole, int numerator, int denominator)
    if kind != "mile"
        return whole
    Fraction value = miles(kind, whole, numerator, denominator)
    return 1609344 * value.numerator / (1000 * value.denominator)

string fraction(int numerator, int denominator)
    if denominator == 0
        return "undefined"
    int left = absolute(numerator)
    int right = denominator
    while right != 0
        int remainder = left % right
        left = right
        right = remainder
    return "{numerator / left}/{denominator / left}"
