import units = "./units.qui"

string[] descriptors()
    return "MI BC PR DR BL SH TS FZ".split(" ")

string[] descriptor_words()
    return "shallow|patches|partial|low drifting|blowing|showers|thunderstorm|freezing".split("|")

string[] phenomena()
    return "DZ RA SN SG IC PL GR GS UP BR FG FU VA DU SA HZ PY PO SQ FC SS DS".split(" ")

string[] phenomenon_words()
    return "drizzle|rain|snow|snow grains|ice crystals|ice pellets|hail|small hail|unknown precipitation|mist|fog|smoke|volcanic ash|dust|sand|haze|spray|dust whirls|squalls|funnel cloud|sandstorm|duststorm".split("|")

string[] amounts()
    return "FEW SCT BKN OVC".split(" ")

string[] amount_words()
    return "few scattered broken overcast".split(" ")

string[] clear_codes()
    return "SKC CLR NSC".split(" ")

string[] clear_words()
    return "sky clear|clear below 12000 ft|no significant cloud".split("|")

int locate(string[] values, string text)
    for nat offset < len(values)
        if values[offset] == text
            return int(offset)
    return -1

// Slot indices: modifier, wind, variation, visibility, RVR, weather,
// cloud, temperature, pressure, no trend.
class Value(bool present = false)
    string raw = ""
    string name = ""
    string suffix = ""
    string qualifier = ""
    string qualifier_second = ""
    string unit = ""
    string trend = ""
    string intensity = ""
    string descriptor = ""
    string[] codes = []
    int direction = 0
    int speed = 0
    int gust = -1
    int direction_start = 0
    int direction_end = 0
    int whole_or_meters = 0
    int numerator = 0
    int denominator = 1
    int reading_first = 0
    int reading_second = 0
    int height = 0
    int temperature = 0
    int dew_point = 0
    int pressure = 0
    int inches = 0
    int hectopascals = 0
    int reading_value = 0
    int next_cursor = 0
    bool mixed = false
    bool fractional = false

class Section(string context = "")
    Value[] singles = array(10, fill = Value())
    Value[][] lists = []
    for _ < 10
        lists = lists.append([])

class Runway(string name, int heading)
class Station(string code, int elevation, Runway[] runways, string name)
class Group(string text, int position)
class Problem(int report, int position, string reason, string text = "", bool quoted = true)

void record(Problem[] &problems, int report, int position, string reason, string text = "", bool quoted = true)
    problems = problems.append(Problem(report, position, reason, text, quoted))

int signed_temperature(string text)
    bool negative = text.starts_with("M")
    string body = if negative then text[1:<len(text)] else text
    if not units.digits(body, 2, 2)
        return 1000
    return int.parse(body) * (if negative then -1 else 1)

Value reading(string text, int start)
    Value result = Value(true)
    int cursor = start
    if cursor < int(len(text)) and (text[cursor] == "M" or text[cursor] == "P")
        result.qualifier = text[cursor]
        cursor += 1
    if cursor + 4 > int(len(text)) or not units.digits(text[cursor:<cursor + 4], 4, 4)
        return Value()
    result.reading_value = int.parse(text[cursor:<cursor + 4])
    result.next_cursor = cursor + 4
    return result

Value format(int kind, string text)
    Value result = Value(true)
    result.raw = text
    if kind == 0
        if text != "AUTO" and text != "COR"
            return Value()
        result.name = text
    elif kind == 1
        string body = text
        if body.ends_with("MPS")
            result.unit = "MPS"
            body = body[0:<len(body) - 3]
        elif body.ends_with("KT")
            result.unit = "KT"
            body = body[0:<len(body) - 2]
        else
            return Value()
        if len(body) < 5 or (body[0:<3] != "VRB" and not units.digits(body[0:<3], 3, 3))
            return Value()
        result.direction = if body[0:<3] == "VRB" then -1 else int.parse(body[0:<3])
        string[] speeds = body[3:<len(body)].split("G")
        if len(speeds) > 2 or not units.digits(speeds[0], 2, 3)
            return Value()
        result.speed = int.parse(speeds[0])
        if len(speeds) == 2
            if not units.digits(speeds[1], 2, 3)
                return Value()
            result.gust = int.parse(speeds[1])
    elif kind == 2
        if len(text) != 7 or text[3] != "V" or not units.digits(text[0:<3], 3, 3) or not units.digits(text[4:<7], 3, 3)
            return Value()
        result.direction_start = int.parse(text[0:<3])
        result.direction_end = int.parse(text[4:<7])
    elif kind == 3
        if text == "CAVOK"
            result.name = "cavok"
            result.whole_or_meters = 10000
            result.qualifier = "P"
        elif units.digits(text, 4, 4)
            result.name = "meter"
            result.whole_or_meters = int.parse(text)
            if result.whole_or_meters == 9999
                result.whole_or_meters = 10000
                result.qualifier = "P"
        else
            if not text.ends_with("SM")
                return Value()
            result.name = "mile"
            result.denominator = 1
            string body = text[0:<len(text) - 2]
            if len(body) > 0 and (body[0] == "M" or body[0] == "P")
                result.qualifier = body[0]
                body = body[1:<len(body)]
            string[] parts = body.split(" ")
            if len(parts) > 2
                return Value()
            if len(parts) == 2
                if result.qualifier != "" or not units.digits(parts[0], 1, 1)
                    return Value()
                result.whole_or_meters = int.parse(parts[0])
                result.mixed = true
                body = parts[1]
            string[] ratio = body.split("/")
            if len(ratio) == 2
                if not units.digits(ratio[0], 1, 1) or not units.digits(ratio[1], 1, 2)
                    return Value()
                result.numerator = int.parse(ratio[0])
                result.denominator = int.parse(ratio[1])
                result.fractional = true
            elif len(ratio) == 1 and not result.mixed and units.digits(body, 1, 2)
                result.whole_or_meters = int.parse(body)
            else
                return Value()
    elif kind == 4
        string[] parts = text.split("/")
        if len(parts) != 2 or not parts[0].starts_with("R")
            return Value()
        string runway = parts[0][1:<len(parts[0])]
        if len(runway) < 2 or len(runway) > 3 or not units.digits(runway[0:<2], 2, 2)
            return Value()
        if len(runway) == 3 and not "LCR".contains(runway[2])
            return Value()
        result.name = runway
        string body = parts[1]
        Value first_reading = reading(body, 0)
        if not first_reading.present
            return Value()
        result.reading_first = first_reading.reading_value
        result.qualifier = first_reading.qualifier
        int cursor = first_reading.next_cursor
        if cursor < int(len(body)) and body[cursor] == "V"
            Value last_reading = reading(body, cursor + 1)
            if not last_reading.present
                return Value()
            result.reading_second = last_reading.reading_value
            result.qualifier_second = last_reading.qualifier
            result.mixed = true
            cursor = last_reading.next_cursor
        result.unit = "m"
        if body[cursor:<len(body)].starts_with("FT")
            result.unit = "ft"
            cursor += 2
        if cursor < int(len(body)) and "UDN".contains(body[cursor])
            result.trend = body[cursor]
            cursor += 1
        if cursor != int(len(body))
            return Value()
    elif kind == 5
        if text == "NSW"
            result.name = "NSW"
            return result
        string body = text
        if body.starts_with("VC")
            result.intensity = "VC"
            body = body[2:<len(body)]
        elif len(body) > 0 and (body[0] == "-" or body[0] == "+")
            result.intensity = body[0]
            body = body[1:<len(body)]
        if len(body) == 0 or len(body) % 2 != 0
            return Value()
        for 0 <= int cursor < int(len(body)) step 2
            string code = body[cursor:<cursor + 2]
            if locate(descriptors(), code) < 0 and locate(phenomena(), code) < 0
                return Value()
            result.codes = result.codes.append(code)
        if locate(descriptors(), result.codes[0]) >= 0
            result.descriptor = result.codes[0]
            result.codes = result.codes[1:<len(result.codes)]
    elif kind == 6
        if locate(clear_codes(), text) >= 0
            result.name = text
            result.height = -1
        elif len(text) == 5 and text.starts_with("VV") and units.digits(text[2:<5], 3, 3)
            result.name = "VV"
            result.height = int.parse(text[2:<5]) * 100
        else
            if len(text) < 6 or locate(amounts(), text[0:<3]) < 0 or not units.digits(text[3:<6], 3, 3)
                return Value()
            result.name = text[0:<3]
            result.height = int.parse(text[3:<6]) * 100
            result.suffix = text[6:<len(text)]
            if result.suffix != "" and result.suffix != "CB" and result.suffix != "TCU"
                return Value()
    elif kind == 7
        string[] parts = text.split("/")
        if len(parts) != 2
            return Value()
        result.temperature = signed_temperature(parts[0])
        result.dew_point = signed_temperature(parts[1])
        if result.temperature == 1000 or result.dew_point == 1000
            return Value()
    elif kind == 8
        if len(text) != 5 or (text[0] != "A" and text[0] != "Q") or not units.digits(text[1:<5], 4, 4)
            return Value()
        result.unit = text[0]
        result.pressure = int.parse(text[1:<5])
    elif text != "NOSIG"
        return Value()
    return result

bool valid(int kind, Value value, Section state, Station station)
    if kind == 1
        if value.direction < 0
            if value.speed < 1
                return false
        elif value.direction > 360 or value.direction % 10 != 0 or ((value.direction == 0) != (value.speed == 0))
            return false
        return value.gust < 0 or (value.direction != 0 and value.gust > value.speed)
    if kind == 2
        return 10 <= value.direction_start <= 360 and value.direction_start % 10 == 0 and 10 <= value.direction_end <= 360 and value.direction_end % 10 == 0 and value.direction_start != value.direction_end and state.singles[1].present and state.singles[1].direction > 0
    if kind == 3 and value.name == "mile"
        if not value.fractional
            return value.whole_or_meters >= 1
        return (value.denominator == 2 or value.denominator == 4 or value.denominator == 8 or value.denominator == 16) and value.numerator >= 1 and value.numerator < value.denominator and (not value.mixed or value.whole_or_meters >= 1)
    if kind == 4
        bool found = false
        for Runway runway = station.runways[]
            if runway.name == value.name
                found = true
        return found and (not value.mixed or value.reading_first < value.reading_second)
    if kind == 5
        Value[] accepted = state.lists[5]
        if len(accepted) >= 3
            return false
        for Value previous = accepted[]
            if previous.name == "NSW"
                return false
        if value.name == "NSW"
            return len(accepted) == 0 and (state.context == "trend" or state.context == "change")
        int precipitation = 0
        for nat offset < len(value.codes)
            int code_index = locate(phenomena(), value.codes[offset])
            if code_index < 0
                return false
            if code_index < 9
                precipitation += 1
            for nat earlier < offset
                if value.codes[earlier] == value.codes[offset]
                    return false
        if len(value.codes) == 0 and value.descriptor != "TS" and value.descriptor != "SH"
            return false
        if (value.intensity == "-" or value.intensity == "+") and precipitation == 0
            return false
        return len(value.codes) < 2 or precipitation == int(len(value.codes))
    if kind == 6 and len(state.lists[6]) > 0
        Value previous = state.lists[6][len(state.lists[6]) - 1]
        return locate(amounts(), value.name) >= 0 and locate(amounts(), previous.name) >= 0 and value.height > previous.height
    if kind == 7
        return value.dew_point <= value.temperature
    if kind == 8
        return if value.unit == "A" then 2500 <= value.pressure <= 3150 else 850 <= value.pressure <= 1070
    return true

void accept(Section &state, int kind, Value value)
    if kind == 1 and value.unit == "MPS"
        value.speed = units.knots(value.speed)
        if value.gust >= 0
            value.gust = units.knots(value.gust)
    if kind == 8
        value.inches = if value.unit == "A" then value.pressure else units.in_hg(value.pressure)
        value.hectopascals = if value.unit == "Q" then value.pressure else units.h_pa(value.pressure)
    state.singles[kind] = value
    if kind == 4 or kind == 5 or kind == 6
        state.lists[kind] = state.lists[kind].append(value)
    if kind == 3 and value.name == "cavok"
        state.singles[5] = Value(true)
        state.singles[6] = Value(true)
        state.lists[5] = []
        state.lists[6] = []
