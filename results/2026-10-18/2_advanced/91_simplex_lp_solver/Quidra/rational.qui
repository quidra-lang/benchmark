int absolute(int value)
    return if value < 0 then -value else value

int gcd(int first, int second)
    int left = absolute(first)
    int right = absolute(second)
    while right != 0
        int remainder = left % right
        left = right
        right = remainder
    return if left == 0 then 1 else left

class Fraction(int numerator, int denominator = 1)
    local int divisor = gcd(numerator, denominator)
    numerator /= divisor
    denominator /= divisor
    if denominator < 0
        numerator = -numerator
        denominator = -denominator

    Fraction add(const Fraction other)
        return Fraction(numerator * other.denominator + other.numerator * denominator, denominator * other.denominator)

    Fraction subtract(const Fraction other)
        return Fraction(numerator * other.denominator - other.numerator * denominator, denominator * other.denominator)

    Fraction multiply(const Fraction other)
        return Fraction(numerator * other.numerator, denominator * other.denominator)

    Fraction divide(const Fraction other)
        return Fraction(numerator * other.denominator, denominator * other.numerator)

    Fraction negate()
        return Fraction(-numerator, denominator)

    Fraction magnitude()
        return Fraction(absolute(numerator), denominator)

    int compare(const Fraction other)
        int left = numerator * other.denominator
        int right = other.numerator * denominator
        return if left < right then -1 elif left > right then 1 else 0

    int floor()
        return if numerator < 0 and numerator % denominator != 0 then numerator / denominator - 1 else numerator / denominator

    int ceil()
        return -negate().floor()

    string text()
        return if denominator == 1 then numerator.string() else "{numerator}/{denominator}"

    string approximate()
        Fraction scaled = magnitude().multiply(Fraction(1000000)).add(Fraction(1, 2))
        int rounded = scaled.floor()
        string tail = (rounded % 1000000).string()
        while len(tail) < 6
            tail = "0" + tail
        string prefix = if numerator < 0 and rounded > 0 then "-" else ""
        return "{prefix}{rounded / 1000000}.{tail}"

bool digits(string text)
    if text == ""
        return false
    for int position < int(len(text))
        if text[position] < "0" or text[position] > "9"
            return false
    return true

Fraction | none read(string word, bool signed = false)
    int sign = 1
    string text = word
    if text.starts_with("-")
        if not signed
            return none
        sign = -1
        text = text[1:<int(len(text))]
    string[] slash = text.split("/")
    if len(slash) == 2 and digits(slash[0]) and digits(slash[1])
        int denominator = int.parse(slash[1])
        if denominator == 0
            return none
        int numerator = int.parse(slash[0])
        return Fraction(sign * numerator, denominator)
    string[] dot = text.split(".")
    if len(dot) == 2 and digits(dot[0]) and digits(dot[1])
        int numerator = int.parse(dot[0] + dot[1])
        int denominator = 1
        for int position < int(len(dot[1]))
            denominator *= 10
        return Fraction(sign * numerator, denominator)
    if digits(text)
        int numerator = int.parse(text)
        return Fraction(sign * numerator)
    return none

string[] texts(const Fraction[] values)
    string[] result = []
    for Fraction value = values[]
        result = result.append(value.text())
    return result
