import lexer = "./lexer.qui"
import values = "./values_fields.qui"

class RuntimeError(lexer.Position position, string message)

string text_character(int code)
    if code == 10
        return NL
    const string printable = " !{DQ}#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{{|}}~"
    return printable[code - 32]

string digits_text(int amount, int base)
    string alphabet = "0123456789abcdef"
    string result = ""
    while amount > 0 or result == ""
        result = alphabet[amount % base] + result
        amount /= base
    return result

string | RuntimeError format(const values.Value[] arguments, const lexer.Position position)
    string specification = arguments[0].string_value()
    string result = ""
    int cursor = 0
    int argument_index = 1
    while cursor < int(len(specification))
        if specification[cursor] != "%"
            result += specification[cursor]
            cursor += 1
            continue
        cursor += 1
        if cursor < int(len(specification)) and specification[cursor] == "%"
            result += "%"
            cursor += 1
            continue
        bool left = false
        bool zero = false
        while cursor < int(len(specification)) and (specification[cursor] == "-" or specification[cursor] == "0")
            left = left or specification[cursor] == "-"
            zero = zero or specification[cursor] == "0"
            cursor += 1
        int start = cursor
        while cursor < int(len(specification)) and lexer.digit(specification[cursor])
            cursor += 1
        int width = if cursor == start then 0 else int.parse(specification[start:<cursor])
        int precision = -1
        if cursor < int(len(specification)) and specification[cursor] == "."
            cursor += 1
            start = cursor
            while cursor < int(len(specification)) and lexer.digit(specification[cursor])
                cursor += 1
            precision = if cursor == start then 0 else int.parse(specification[start:<cursor])
        if cursor == int(len(specification)) or not "discxo".contains(specification[cursor])
            return RuntimeError(position, "invalid format")
        string conversion = specification[cursor]
        cursor += 1
        if argument_index == int(len(arguments))
            return RuntimeError(position, "not enough arguments")
        values.Value value = arguments[argument_index]
        argument_index += 1
        bool numeric = "dixo".contains(conversion)
        string body = ""
        if numeric
            int amount = value.number()
            int magnitude = if amount < 0 then -amount else amount
            string digits = digits_text(magnitude, if conversion == "x" then 16 elif conversion == "o" then 8 else 10)
            if precision >= 0
                if precision == 0 and amount == 0
                    digits = ""
                while int(len(digits)) < precision
                    digits = "0" + digits
            body = (if amount < 0 then "-" else "") + digits
        elif conversion == "s"
            body = value.string_value()
            if precision >= 0 and precision < int(len(body))
                body = body[0:<precision]
        elif value.kind == "number" or value.kind == "numeric"
            int code = value.number()
            if code != 10 and (code < 32 or code > 126)
                return RuntimeError(position, "invalid character code")
            body = text_character(code)
        else
            string text = value.string_value()
            body = if text == "" then "" else text[0]
        int padding = width - int(len(body))
        if padding > 0
            if left
                body += string.repeat(" ", nat(padding))
            elif numeric and zero and precision < 0
                string zeros = string.repeat("0", nat(padding))
                body = if body.starts_with("-") then "-" + zeros + body[1:<int(len(body))] else zeros + body
            else
                body = string.repeat(" ", nat(padding)) + body
        result += body
    return result

values.Value | RuntimeError scalar(string name, const values.Value[] arguments, const lexer.Position position)
    if name == "substr"
        string text = arguments[0].string_value()
        int original = arguments[1].number()
        int start = if original < 1 then 1 else original
        int finish = if len(arguments) == 3 then original + arguments[2].number() else int(len(text)) + 1
        if finish > int(len(text)) + 1
            finish = int(len(text)) + 1
        return values.Value("string", if finish > start then text[start - 1:<finish - 1] else "")
    if name == "index"
        string text = arguments[0].string_value()
        string target = arguments[1].string_value()
        if target == ""
            return values.Value("number", amount = 0)
        match text.find(target)
            nat index
                return values.Value("number", amount = int(index) + 1)
            none
                return values.Value("number", amount = 0)
    if name == "toupper" or name == "tolower"
        string text = arguments[0].string_value()
        string result = ""
        for int index < int(len(text))
            string character = text[index]
            int code = character.codepoints()[0]
            if name == "toupper" and character >= "a" and character <= "z"
                result += text_character(code - 32)
            elif name == "tolower" and character >= "A" and character <= "Z"
                result += text_character(code + 32)
            else
                result += character
        return values.Value("string", result)
    if name == "int"
        return values.Value("number", amount = arguments[0].number())
    match format(arguments, position)
        string text
            return values.Value("string", text)
        RuntimeError problem
            return problem
