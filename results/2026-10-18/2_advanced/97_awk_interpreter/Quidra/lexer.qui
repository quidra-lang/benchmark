class Position(int line, int column)
    string text()
        return "{line}:{column}"

class Token(string kind, string text, string value, Position position)
class Result(Token[] tokens, Position | none problem)

bool letter(string character)
    return (character >= "A" and character <= "Z") or (character >= "a" and character <= "z")

bool digit(string character)
    return character >= "0" and character <= "9"

bool has(const string[] items, string sought)
    for string item = items[]
        if item == sought
            return true
    return false

Result lex(string source)
    Position[] positions = []
    int line_number = 1
    int column = 1
    for int index < int(len(source))
        positions = positions.append(Position(line_number, column))
        if source[index] == NL
            line_number += 1
            column = 1
        else
            column += 1
    positions = positions.append(Position(line_number, 1))
    string[] keywords = ["BEGIN", "END", "function", "if", "else", "while", "for", "do", "break", "continue", "next", "exit", "return", "delete", "in", "getline", "print", "printf"]
    string[] builtins = ["length", "substr", "index", "split", "sprintf", "toupper", "tolower", "close", "int"]
    string[] symbols = ["+=", "-=", "*=", "/=", "%=", "^=", "==", "<=", ">=", "!=", "++", "--", "&&", "||", ">>"]
    Token[] tokens = []
    int cursor = 0
    while cursor < int(len(source))
        string character = source[cursor]
        if character == " "
            cursor += 1
            continue
        if character == "\" and cursor + 1 < int(len(source)) and source[cursor + 1] == NL
            cursor += 2
            continue
        if character == "#"
            while cursor < int(len(source)) and source[cursor] != NL
                cursor += 1
            continue
        int start = cursor
        string kind = "symbol"
        string value = ""
        if character == NL
            cursor += 1
            kind = "newline"
        elif digit(character)
            while cursor < int(len(source)) and digit(source[cursor])
                cursor += 1
            kind = "number"
        elif letter(character) or character == "_"
            while cursor < int(len(source)) and (letter(source[cursor]) or digit(source[cursor]) or source[cursor] == "_")
                cursor += 1
            string word = source[start:<cursor]
            kind = if has(keywords, word) then "keyword" elif has(builtins, word) then "builtin" elif cursor < int(len(source)) and source[cursor] == "(" then "function" else "name"
        elif character == DQ
            cursor += 1
            bool closed = false
            while cursor < int(len(source))
                if source[cursor] == NL
                    return Result([], positions[start])
                if source[cursor] == DQ
                    cursor += 1
                    closed = true
                    break
                if source[cursor] == "\"
                    int slash = cursor
                    cursor += 1
                    if cursor == int(len(source))
                        return Result([], positions[start])
                    string escaped = source[cursor]
                    if escaped == "n"
                        value += NL
                    elif escaped == "t"
                        value += HT
                    elif escaped == "\" or escaped == DQ or escaped == "/"
                        value += escaped
                    else
                        return Result([], positions[slash])
                    cursor += 1
                else
                    value += source[cursor]
                    cursor += 1
            if not closed
                return Result([], positions[start])
            kind = "string"
        elif cursor + 1 < int(len(source)) and has(symbols, source[cursor:<cursor + 2])
            cursor += 2
        elif "+-*/%^!><?:=()[]{{}},;$".contains(character)
            cursor += 1
        else
            return Result([], positions[cursor])
        tokens = tokens.append(Token(kind, source[start:<cursor], value, positions[start]))
    return Result(tokens.append(Token("end", "", "", positions[int(len(source))])), none)
