import tiles = "./tiles.qui"

class Split(int pair, int[][] sets)

int[][] ordered_sets(int[][] blocks)
    int[][] result = blocks
    for 1 <= int i < int(len(result))
        int j = i
        while j > 0
            int left = result[j - 1][0] * 2 + (if result[j - 1][0] == result[j - 1][2] then 0 else 1)
            int right = result[j][0] * 2 + (if result[j][0] == result[j][2] then 0 else 1)
            if left <= right
                break
            int[] temporary = result[j - 1]
            result[j - 1] = result[j]
            result[j] = temporary
            j -= 1
    return result

void visit_sets(int[] remaining, int pair_kind, int needed, int[][] chosen, Split[] &found)
    int first = -1
    for int i < 34
        if remaining[i] > 0
            first = i
            break
    if int(len(chosen)) == needed
        if first < 0
            int[][] ordered = ordered_sets(chosen)
            bool duplicate = false
            for Split prior = found[]
                if prior.pair == pair_kind and prior.sets == ordered
                    duplicate = true
            if not duplicate
                found = found.append(Split(pair_kind, ordered))
        return
    if first < 0
        return
    if remaining[first] >= 3
        int[] next = remaining
        next[first] -= 3
        visit_sets(next, pair_kind, needed, chosen.append([first, first, first]), &found)
    if first < 27 and first % 9 <= 6 and remaining[first + 1] > 0 and remaining[first + 2] > 0
        int[] next = remaining
        next[first] -= 1
        next[first + 1] -= 1
        next[first + 2] -= 1
        visit_sets(next, pair_kind, needed, chosen.append([first, first + 1, first + 2]), &found)

Split[] standard_splits(int[] counts, int meld_count = 0)
    int total = 0
    for int amount = counts[]
        total += amount
    int needed = 4 - meld_count
    Split[] result = []
    if total != needed * 3 + 2
        return result
    for int pair_kind < 34
        if counts[pair_kind] >= 2
            int[] remaining = counts
            remaining[pair_kind] -= 2
            visit_sets(remaining, pair_kind, needed, [], &result)
    return result

bool seven_pairs(int[] counts)
    int pairs = 0
    for int amount = counts[]
        if amount == 2
            pairs += 1
        elif amount != 0
            return false
    return pairs == 7

bool thirteen_orphans(int[] counts)
    int total = 0
    for int kind < 34
        total += counts[kind]
        if tiles.is_yaochuu(kind)
            if counts[kind] == 0
                return false
        elif counts[kind] != 0
            return false
    return total == 14

bool winning_form(int[] counts, int meld_count = 0)
    return len(standard_splits(counts, meld_count)) > 0 or (meld_count == 0 and (seven_pairs(counts) or thirteen_orphans(counts)))

int[] waiting_kinds(int[] hand_counts, int[] meld_counts, int meld_count)
    int[] result = []
    for int kind < 34
        if hand_counts[kind] + meld_counts[kind] < 4
            int[] concealed = hand_counts
            concealed[kind] += 1
            if winning_form(concealed, meld_count)
                result = result.append(kind)
    return result

string wait_shape(string form, int[] block, int winning_kind, int[] hand_counts)
    if form == "chiitoitsu"
        return "tanki"
    if form == "kokushi"
        for int kind = tiles.orphans()[]
            if hand_counts[kind] != 1
                return "single"
        return "thirteen"
    if len(block) == 2
        return "tanki"
    if block[0] == block[2]
        return "shanpon"
    int first = block[0]
    if winning_kind == first + 1
        return "kanchan"
    if (first % 9 == 0 and winning_kind == first + 2) or (first % 9 == 6 and winning_kind == first)
        return "penchan"
    return "ryanmen"
