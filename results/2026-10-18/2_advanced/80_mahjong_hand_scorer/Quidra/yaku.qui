class Entry(string name, int concealed, int opened)
class Award(string name, int amount)

Entry[] ordinary_table()
    return [
        Entry("riichi", 1, -1), Entry("double_riichi", 2, -1), Entry("ippatsu", 1, -1),
        Entry("menzen_tsumo", 1, -1), Entry("pinfu", 1, -1), Entry("tanyao", 1, 1),
        Entry("iipeikou", 1, -1), Entry("haku", 1, 1), Entry("hatsu", 1, 1),
        Entry("chun", 1, 1), Entry("jikaze", 1, 1), Entry("bakaze", 1, 1),
        Entry("haitei", 1, 1), Entry("houtei", 1, 1), Entry("rinshan", 1, 1),
        Entry("chankan", 1, 1), Entry("chiitoitsu", 2, -1), Entry("toitoi", 2, 2),
        Entry("sanankou", 2, 2), Entry("sanshoku_doujun", 2, 1), Entry("sanshoku_doukou", 2, 2),
        Entry("ittsu", 2, 1), Entry("chanta", 2, 1), Entry("sankantsu", 2, 2),
        Entry("shousangen", 2, 2), Entry("honroutou", 2, 2), Entry("honitsu", 3, 2),
        Entry("junchan", 3, 2), Entry("ryanpeikou", 3, -1), Entry("chinitsu", 6, 5),
    ]

Award[] yakuman_table()
    return [
        Award("tenhou", 1), Award("chiihou", 1), Award("kokushi", 1), Award("kokushi_13", 2),
        Award("suuankou", 1), Award("suuankou_tanki", 2), Award("daisangen", 1),
        Award("shousuushii", 1), Award("daisuushii", 2), Award("tsuuiisou", 1),
        Award("chinroutou", 1), Award("ryuuiisou", 1), Award("chuuren", 1),
        Award("junsei_chuuren", 2), Award("suukantsu", 1),
    ]

string[] flag_names()
    return ["riichi", "double_riichi", "ippatsu", "haitei", "houtei", "rinshan", "chankan", "tenhou", "chiihou"]

string[] categories()
    return ["none", "mangan", "haneman", "baiman", "sanbaiman", "kazoe_yakuman", "yakuman"]

Award[] ordinary_awards(set.Set<string> names, bool closed)
    Award[] result = []
    for Entry entry = ordinary_table()[]
        int han = if closed then entry.concealed else entry.opened
        if names.has(entry.name) and han >= 0
            result = result.append(Award(entry.name, han))
    return result

Award[] yakuman_awards(set.Set<string> names, bool double)
    Award[] result = []
    for Award entry = yakuman_table()[]
        if names.has(entry.name)
            result = result.append(Award(entry.name, if double then entry.amount else 1))
    return result
