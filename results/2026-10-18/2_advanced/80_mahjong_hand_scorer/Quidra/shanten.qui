import tiles = "./tiles.qui"

string state_key(int[] counts, bool suited)
    return (if suited then "s" else "z") + [for int amount = counts[] then amount.string()].join(",")

int[][] block_patterns(int[] counts, bool suited, map.Map<string, int[][]> &cache)
    string key = state_key(counts, suited)
    match cache.get(key)
        int[][] cached
            return cached
        none
            void
    int first = -1
    for int i < int(len(counts))
        if counts[i] > 0
            first = i
            break
    if first < 0
        return [[0, 0, 0]]
    int[][] removed = [[first]]
    int[][] extras = [[0, 0, 0]]
    if counts[first] >= 3
        removed = removed.append([first, first, first])
        extras = extras.append([1, 0, 0])
    if counts[first] >= 2
        removed = removed.concat([[first, first], [first, first]])
        extras = extras.concat([[0, 1, 0], [0, 0, 1]])
    if suited
        if first <= 6 and counts[first + 1] > 0 and counts[first + 2] > 0
            removed = removed.append([first, first + 1, first + 2])
            extras = extras.append([1, 0, 0])
        for 1 <= int difference <= 2
            int other = first + difference
            if other < 9 and counts[other] > 0
                removed = removed.append([first, other])
                extras = extras.append([0, 1, 0])
    int[] best = array(10, fill = -1)
    for int choice < int(len(removed))
        int[] remaining = counts
        for int kind = removed[choice][]
            remaining[kind] -= 1
        for int[] pattern = block_patterns(remaining, suited, &cache)[]
            int sets = pattern[0] + extras[choice][0]
            int pair = pattern[2] + extras[choice][2]
            if sets > 4 or pair > 1
                continue
            int partial = pattern[1] + extras[choice][1]
            if partial > 4
                partial = 4
            int slot = sets * 2 + pair
            if partial > best[slot]
                best[slot] = partial
    int[][] result = []
    for int slot < 10
        if best[slot] >= 0
            result = result.append([slot / 2, best[slot], slot % 2])
    .cache.set(key, result)
    return result

int standard_number(int[] counts, map.Map<string, int[][]> &cache)
    int[][] states = [[0, 0, 0]]
    for int suit < 4
        int stop = if suit == 3 then 34 else suit * 9 + 9
        int[][] patterns = block_patterns(counts[suit * 9:<stop], suit < 3, &cache)
        int[] best = array(10, fill = -1)
        for int[] prior = states[]
            for int[] pattern = patterns[]
                int sets = prior[0] + pattern[0]
                int pair = prior[2] + pattern[2]
                if sets > 4 or pair > 1
                    continue
                int partial = prior[1] + pattern[1]
                if partial > 4
                    partial = 4
                int slot = sets * 2 + pair
                if partial > best[slot]
                    best[slot] = partial
        states = []
        for int slot < 10
            if best[slot] >= 0
                states = states.append([slot / 2, best[slot], slot % 2])
    int result = 8
    for int[] pattern = states[]
        int partial = pattern[1]
        if partial > 4 - pattern[0]
            partial = 4 - pattern[0]
        int candidate = 8 - 2 * pattern[0] - partial - pattern[2]
        if candidate < result
            result = candidate
    return result

int[] shanten_numbers(int[] counts, map.Map<string, int[][]> &cache)
    int pairs = 0
    int kinds = 0
    int orphan_kinds = 0
    bool orphan_pair = false
    for int kind < 34
        if counts[kind] > 0
            kinds += 1
            if tiles.is_yaochuu(kind)
                orphan_kinds += 1
        if counts[kind] >= 2
            pairs += 1
            if tiles.is_yaochuu(kind)
                orphan_pair = true
    int missing = if kinds < 7 then 7 - kinds else 0
    return [standard_number(counts, &cache), 6 - pairs + missing, 13 - orphan_kinds - (if orphan_pair then 1 else 0)]
