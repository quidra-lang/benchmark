import dates = "./dates_calendar.qui"

int[] coupon_schedule(int issue, int maturity, int frequency, bool end_of_month = false, bool long_stub = false)
    dates.Civil anchor = dates.civil_date(maturity)
    bool eom = end_of_month and anchor.day == dates.month_length(anchor.year, anchor.month)
    int[] result = []
    int boundary = maturity
    int count = 0
    while boundary > issue
        result = result.append(boundary)
        count += 1
        int index = anchor.year * 12 + anchor.month - 1 - (12 / frequency) * count
        int year = index / 12
        int month = index % 12 + 1
        int last = dates.month_length(year, month)
        int day = if eom or anchor.day > last then last else anchor.day
        boundary = dates.day_number(year, month, day)
    if long_stub and boundary != issue and len(result) >= 2
        result = result[0:<len(result) - 1]
    return result.append(issue).sorted()
