class Node(string operation, string text, int[] children)
class Tree(Node[] nodes, int root)
class Parser(string[] tokens)
    int position := 0
    Node[] nodes := []

string[] tokenize(string text)
    string[] tokens := []
    int i := 0
    while i < int(len(text))
        string c := text[i]
        if c == " "
            i += 1
            continue
        int first := i
        if c == DQ
            i += 1
            while text[i] != DQ
                i += 1
            i += 1
        elif "0123456789".contains(c)
            i += 1
            while i < int(len(text)) and "0123456789".contains(text[i])
                i += 1
        elif "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c)
            i += 1
            while i < int(len(text)) and "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.".contains(text[i])
                i += 1
        else
            i += 1
            if i < int(len(text)) and text[i] == "=" and "=!<>".contains(c)
                i += 1
        tokens = tokens.append(text[first:<i])
    return tokens

string peek(Parser parser)
    return if parser.position < int(len(parser.tokens)) then parser.tokens[parser.position] else ""

string take(Parser &parser)
    string result := parser.tokens[parser.position]
    parser.position += 1
    return result

int add(Parser &parser, string operation, string text, int[] children)
    int index := int(len(parser.nodes))
    parser.nodes = parser.nodes.append(Node(operation, text, children))
    return index

int precedence(string token)
    if token == "or"
        return 1
    if token == "and"
        return 2
    if token == "==" or token == "!=" or token == "<" or token == "<=" or token == ">" or token == ">=" or token == "in"
        return 4
    if token == "+" or token == "-"
        return 5
    return if token == "*" then 6 else 0

int parse_expression(Parser &parser, int minimum)
    string token := take(&parser)
    int left := -1
    if token == "not" or token == "-"
        int child := parse_expression(&parser, if token == "not" then 3 else 7)
        left = add(&parser, token, "", [child])
    elif token == "("
        left = parse_expression(&parser, 1)
        string closing := take(&parser)
    elif token == "["
        int[] children := []
        while peek(parser) != "]"
            string value := take(&parser)
            children = children.append(add(&parser, "string", value[1:<int(len(value)) - 1], []))
            if peek(parser) != "]"
                string separator := take(&parser)
        string closing := take(&parser)
        left = add(&parser, "bag", "", children)
    elif token.starts_with(DQ)
        left = add(&parser, "string", token[1:<int(len(token)) - 1], [])
    elif "0123456789".contains(token[0])
        left = add(&parser, "integer", token, [])
    elif token == "true" or token == "false"
        left = add(&parser, "boolean", token, [])
    elif token == "it"
        left = add(&parser, "it", "", [])
    elif token.contains(".")
        left = add(&parser, "attribute", token, [])
    else
        string opening := take(&parser)
        int[] children := []
        while peek(parser) != ")"
            children = children.append(parse_expression(&parser, 1))
            if peek(parser) != ")"
                string separator := take(&parser)
        string closing := take(&parser)
        left = add(&parser, token, "", children)
    while precedence(peek(parser)) >= minimum
        string operation := take(&parser)
        int right := parse_expression(&parser, precedence(operation) + 1)
        left = add(&parser, operation, "", [left, right])
    return left

Tree parse(string text)
    Parser parser := Parser(tokenize(text))
    int root := parse_expression(&parser, 1)
    return Tree(parser.nodes, root)
