int[][] points(int[] sizes)
    int count := 1
    for int size := sizes[]
        count *= size
    int[][] result := []
    for int ordinal < count
        int[] point := array(len(sizes), fill = 0)
        int rest := ordinal
        int dimension := int(len(sizes)) - 1
        while dimension >= 0
            point[dimension] = rest % sizes[dimension]
            rest /= sizes[dimension]
            dimension -= 1
        result = result.append(point)
    return result

string day_notation(bool[] days)
    string[] runs := []
    int day := 1
    while day <= 365
        if not days[day]
            day += 1
            continue
        int first := day
        while day < 365 and days[day + 1]
            day += 1
        runs = runs.append("{first}-{day}")
        day += 1
    return runs.join(",")

int blocker(int[] earlier, string[] standalone)
    for int index := earlier[]
        if standalone[index] != "NOT_APPLICABLE"
            return index
    return -1

int conflict_winner(string algorithm, int earlier, int later, string first_effect)
    if algorithm == "first-applicable"
        return earlier
    string effect := if algorithm == "deny-overrides" or algorithm == "permit-unless-deny" then "DENY" else "PERMIT"
    return if first_effect == effect then earlier else later
