class Decision(string name := "NOT_APPLICABLE", string reason := "")

string ip()
    return "INDETERMINATE{{P}}"
string id()
    return "INDETERMINATE{{D}}"
string idp()
    return "INDETERMINATE{{DP}}"

bool definite(string name)
    return name == "PERMIT" or name == "DENY"

bool indeterminate(string name)
    return name.starts_with("INDETERMINATE")

string for_effect(string effect)
    return if effect == "PERMIT" then ip() else id()

bool stop(string algorithm, string decision)
    if algorithm == "first-applicable"
        return decision != "NOT_APPLICABLE"
    if algorithm == "deny-overrides" or algorithm == "permit-unless-deny"
        return decision == "DENY"
    if algorithm == "permit-overrides" or algorithm == "deny-unless-permit"
        return decision == "PERMIT"
    return false

bool has(Decision[] values, string name)
    for value := values[]
        if value.name == name
            return true
    return false

Decision finish(string algorithm, Decision[] values)
    for value := values[]
        if stop(algorithm, value.name)
            return value
    if algorithm == "deny-unless-permit"
        return Decision("DENY")
    if algorithm == "permit-unless-deny"
        return Decision("PERMIT")
    if algorithm == "first-applicable"
        return Decision()
    name := "NOT_APPLICABLE"
    if algorithm == "deny-overrides"
        if has(values, idp()) or (has(values, id()) and (has(values, ip()) or has(values, "PERMIT")))
            name = idp()
        elif has(values, id())
            name = id()
        elif has(values, "PERMIT")
            name = "PERMIT"
        elif has(values, ip())
            name = ip()
    else
        if has(values, idp()) or (has(values, ip()) and (has(values, id()) or has(values, "DENY")))
            name = idp()
        elif has(values, ip())
            name = ip()
        elif has(values, "DENY")
            name = "DENY"
        elif has(values, id())
            name = id()
    if indeterminate(name)
        for value := values[]
            if indeterminate(value.name)
                return Decision(name, value.reason)
    return Decision(name)

Decision applicability(string target, string reason, string earlier, string current)
    if target == "INDETERMINATE"
        return Decision(idp(), reason)
    if target == "MATCH" and earlier != ""
        return Decision(idp(), "multiple applicable {earlier} {current}")
    return Decision()

string notation(Decision decision)
    return if indeterminate(decision.name) then "{decision.name} ({decision.reason})" else decision.name
