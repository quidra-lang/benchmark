import math
import dataset = "./dataset.qui"

class Fraction(int numerator, int denominator)
    int compare(Fraction other)
        int first = numerator * other.denominator
        int second = other.numerator * denominator
        return if first < second then -1 elif first > second then 1 else 0

int[] class_counts(dataset.Row[] rows, int classes)
    int[] counts = array(nat(classes), fill = 0)
    for dataset.Row row = rows[]
        counts[row.label] += 1
    return counts

int square_sum(int[] counts)
    return math.sum(counts ^ 2)

int majority(int[] counts)
    int chosen = 0
    for 1 <= int i < int(len(counts))
        if counts[i] > counts[chosen]
            chosen = i
    return chosen

int error_count(int[] counts)
    return math.sum(counts) - counts[majority(counts)]

Fraction quality(int[] left, int[] right)
    int left_size = math.sum(left)
    int right_size = math.sum(right)
    return Fraction(square_sum(left) * right_size + square_sum(right) * left_size, left_size * right_size)

bool improves(Fraction value, int[] counts)
    return value.numerator * math.sum(counts) > square_sum(counts) * value.denominator

real64 decrease(int[] counts, int[] left, int[] right)
    real64 first = real64(square_sum(left)) / real64(math.sum(left))
    real64 second = real64(square_sum(right)) / real64(math.sum(right))
    real64 parent = real64(square_sum(counts)) / real64(math.sum(counts))
    return (first + second) - parent
