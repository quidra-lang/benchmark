import math

int position(string[] names, string wanted)
    for int i < int(len(names))
        if names[i] == wanted
            return i
    return -1

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    if len(lines) > 0 and lines[len(lines) - 1] == ""
        lines = lines[0:<len(lines) - 1]
    return lines

class Attribute(int index, string name, bool is_integer, string[] values)
    int parse(string text)
        if text == "?"
            return -1
        return if is_integer then int.parse(text) else position(values, text)

class Row(string id, int[] values, int label)
    int missing_count()
        return math.sum<int>([for int value = values[] if value < 0 then 1])

int[] integer_fields(string line)
    string[] fields = line.split(" ")
    return [for string value = fields[1:<len(fields)][] then int.parse(value)]

class Settings(local string[] lines)
    int max_depth = integer_fields(lines[0])[0]
    int min_split = integer_fields(lines[1])[0]
    int min_leaf = integer_fields(lines[2])[0]
    int max_surrogates = integer_fields(lines[3])[0]
    int folds = integer_fields(lines[4])[0]
    int[] curve = integer_fields(lines[5])
    int bag_trees = integer_fields(lines[6])[0]
    int bag_seed = integer_fields(lines[7])[0]
    int permutation_repeats = integer_fields(lines[8])[0]
    int permutation_seed = integer_fields(lines[9])[0]

class Dataset(Attribute[] attributes, string target, string[] classes, Row[] train, Row[] validation, Row[] test, Settings settings)

Row[] read_rows(string path, Attribute[] attributes, string[] classes)
    string[] lines = read_lines(path)
    Row[] rows = []
    for 1 <= int i < int(len(lines))
        string[] fields = lines[i].split(",")
        int[] values = [for Attribute attribute = attributes[] then attribute.parse(fields[attribute.index + 1])]
        rows = rows.append(Row(fields[0], values, position(classes, fields[len(fields) - 1])))
    return rows

Dataset load()
    string[] schema = read_lines("input/schema.txt")
    Attribute[] attributes = []
    string target = ""
    string[] classes = []
    for string line = schema[]
        string[] fields = line.split(" ")
        if fields[0] == "ATTRIBUTE"
            attributes = attributes.append(Attribute(int(len(attributes)), fields[1], fields[2] == "INT", fields[3:<len(fields)]))
        else
            target = fields[1]
            classes = fields[2:<len(fields)]
    Row[] train = read_rows("input/train.csv", attributes, classes)
    Row[] validation = read_rows("input/validation.csv", attributes, classes)
    Row[] test = read_rows("input/test.csv", attributes, classes)
    return Dataset(attributes, target, classes, train, validation, test, Settings(read_lines("input/params.txt")))
