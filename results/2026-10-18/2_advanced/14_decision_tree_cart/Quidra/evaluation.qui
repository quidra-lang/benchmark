import math
import dataset = "./dataset.qui"
import tree_builder = "./tree_builder.qui"

string real_text(real64 value, int places = 4)
    string text = if places == 6 then "{value:frac=6}" else "{value:frac=4}"
    if text == "-0.0000" or text == "-0.000000"
        return text[1:<len(text)]
    return text

int gcd(int first, int second)
    first = math.abs(first)
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return first

string ratio_text(int numerator, int denominator)
    if denominator == 0
        return "0/0 -"
    return "{numerator}/{denominator} {real_text(real64(numerator) / real64(denominator))}"

string fraction_text(int numerator, int denominator, int places = 4)
    if denominator == 0
        return "- -"
    int divisor = gcd(numerator, denominator)
    int reduced_numerator = numerator / divisor
    int reduced_denominator = denominator / divisor
    real64 value = real64(reduced_numerator) / real64(reduced_denominator)
    return "{reduced_numerator}/{reduced_denominator} {real_text(value, places)}"

real64 average(real64[] values)
    return math.sum(values) / real64(len(values))

class Direction(bool left, int method)
class Route(int[] path, int[] methods)

Direction direction(tree_builder.Node node, dataset.Row row)
    int value = row.values[node.split.attribute.index]
    if value >= 0
        return Direction(node.split.goes_left(value), 0)
    for tree_builder.Surrogate surrogate = node.surrogates[]
        value = row.values[surrogate.split.attribute.index]
        if value >= 0
            return Direction(surrogate.goes_left(value), 1)
    return Direction(node.default_left, 2)

class View(tree_builder.Tree tree, bool[] cut, int depth_limit = -1)
    bool is_leaf(int index)
        tree_builder.Node node = tree.nodes[index]
        return node.left < 0 or cut[index] or (depth_limit >= 0 and node.depth >= depth_limit)

    int[] preorder(int start = 0)
        int[] pending = [start]
        int[] result = []
        while len(pending) > 0
            int index = pending[len(pending) - 1]
            pending = pending[0:<len(pending) - 1]
            result = result.append(index)
            if not is_leaf(index)
                pending = pending.append(tree.nodes[index].right).append(tree.nodes[index].left)
        return result

    int[] leaves(int start = 0)
        return [for int index = preorder(start)[] if is_leaf(index) then index]

    int[] internal_nodes(int start = 0)
        return [for int index = preorder(start)[] if not is_leaf(index) then index]

    int tree_depth()
        return math.max_all([for int index = leaves()[] then tree.nodes[index].depth])

    int training_errors()
        return math.sum([for int index = leaves()[] then tree.nodes[index].errors])

    Route route(dataset.Row row)
        int index = 0
        int[] path = [index]
        int[] methods = []
        while not is_leaf(index)
            tree_builder.Node node = tree.nodes[index]
            Direction choice = direction(node, row)
            index = if choice.left then node.left else node.right
            path = path.append(index)
            methods = methods.append(choice.method)
        return Route(path, methods)

    tree_builder.Node leaf_of(dataset.Row row)
        Route result = route(row)
        return tree.nodes[result.path[len(result.path) - 1]]

    int predict(dataset.Row row)
        return leaf_of(row).prediction

    int correct_count(dataset.Row[] rows)
        return math.sum<int>([for dataset.Row row = rows[] if predict(row) == row.label then 1])

View full_tree(tree_builder.Tree tree)
    return View(tree, array(len(tree.nodes), fill = false))

int[][] confusion_matrix(int[] actual, int[] predicted, int classes)
    int[][] matrix = array(nat(classes), fill = array(nat(classes), fill = 0))
    for int i < int(len(actual))
        matrix[actual[i]][predicted[i]] += 1
    return matrix

string counts_text(int[] counts)
    return [for int count = counts[] then "{count}"].join(" ")

string[] classification_lines(string title, string[] classes, int[] actual, int[] predicted)
    int count = int(len(classes))
    int[][] matrix = confusion_matrix(actual, predicted, count)
    int correct = math.sum([for nat i = matrix.indices()[] then matrix[i][i]])
    int total = int(len(actual))
    string[] lines = ["confusion {title} correct {correct}/{total} accuracy {fraction_text(correct, total)}", "actual\predicted " + classes.join(" ")]
    for int i < count
        lines = lines.append(classes[i] + " " + counts_text(matrix[i]))
    real64[] f1 = []
    for int k < count
        int hits = matrix[k][k]
        int predicted_total = math.sum([for int[] row = matrix[] then row[k]])
        int support = math.sum(matrix[k])
        if predicted_total + support > 0
            f1 = f1.append(real64(2 * hits) / real64(predicted_total + support))
        lines = lines.append("class {classes[k]} precision {fraction_text(hits, predicted_total)} recall {fraction_text(hits, support)} f1 {fraction_text(2 * hits, predicted_total + support)} support {support}")
    return lines.append("macro_f1 {real_text(average(f1))}")
