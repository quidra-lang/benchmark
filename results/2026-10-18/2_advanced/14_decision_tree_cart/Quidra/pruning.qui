import math
import dataset = "./dataset.qui"
import impurity = "./impurity.qui"
import tree_builder = "./tree_builder.qui"
import evaluation = "./evaluation.qui"

class Decision(int node, int rows, int leaf_error, int subtree_error, bool pruned)
class Reduced(evaluation.View tree, Decision[] decisions)
class SequenceTree(impurity.Fraction alpha, evaluation.View tree)

dataset.Row[][] reached_rows(evaluation.View tree, dataset.Row[] rows)
    dataset.Row[][] result = array(len(tree.tree.nodes), fill = [])
    for dataset.Row row = rows[]
        for int index = tree.route(row).path[]
            result[index] = result[index].append(row)
    return result

int decide(tree_builder.Tree tree, int index, dataset.Row[][] reached, Decision[] &decisions, bool[] &cut)
    tree_builder.Node node = tree.nodes[index]
    int leaf_error = math.sum<int>([for dataset.Row row = reached[index][] if row.label != node.prediction then 1])
    if node.left < 0
        return leaf_error
    int subtree_error = decide(tree, node.left, reached, &decisions, &cut)
    subtree_error += decide(tree, node.right, reached, &decisions, &cut)
    bool pruned = leaf_error <= subtree_error
    decisions = decisions.append(Decision(index, int(len(reached[index])), leaf_error, subtree_error, pruned))
    if pruned
        cut[index] = true
        return leaf_error
    return subtree_error

Reduced reduced_error(tree_builder.Tree tree, dataset.Row[] rows)
    evaluation.View grown = evaluation.full_tree(tree)
    dataset.Row[][] reached = reached_rows(grown, rows)
    Decision[] decisions = []
    bool[] cut = grown.cut
    decide(tree, 0, reached, &decisions, &cut)
    return Reduced(evaluation.View(tree, cut), decisions)

SequenceTree[] cost_complexity(tree_builder.Tree tree)
    evaluation.View current = evaluation.full_tree(tree)
    SequenceTree[] result = [SequenceTree(impurity.Fraction(0, 1), current)]
    while not current.is_leaf(0)
        impurity.Fraction alpha = impurity.Fraction(0, 1)
        bool selected = false
        bool[] weakest = array(len(tree.nodes), fill = false)
        for int index = current.internal_nodes()[]
            int[] leaves = current.leaves(index)
            int errors = math.sum([for int leaf = leaves[] then tree.nodes[leaf].errors])
            impurity.Fraction strength = impurity.Fraction(tree.nodes[index].errors - errors, int(len(leaves)) - 1)
            if not selected or strength.compare(alpha) < 0
                alpha = strength
                selected = true
                weakest = array(len(tree.nodes), fill = false)
                weakest[index] = true
            elif strength.compare(alpha) == 0
                weakest[index] = true
        bool[] cut = current.cut
        for int index < int(len(cut))
            if weakest[index]
                cut[index] = true
        current = evaluation.View(tree, cut)
        result = result.append(SequenceTree(alpha, current))
    return result
