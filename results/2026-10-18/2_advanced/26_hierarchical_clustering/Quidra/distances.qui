import math

const string[] types = ["euclidean", "manhattan", "correlation"]

real64 squared(real64[] first, real64[] second)
    return math.sum((first - second) * (first - second))

class Statistics(local real64[][] rows)
    real64[] means = []
    real64[] deviations = []
    for nat feature < len(rows[0])
        real64[] column = [for real64[] row = rows[] then row[feature]]
        real64 mean_value = math.sum(column) / real64(len(rows))
        real64 spread = math.sum((column - mean_value) * (column - mean_value)) / real64(int(len(rows)) - 1)
        means = means.append(mean_value)
        deviations = deviations.append(math.sqrt(spread))

real64[][] standardize(real64[][] rows, real64[] means, real64[] deviations)
    return [for real64[] row = rows[] then (row - means) / deviations]

real64 distance(real64[] first, real64[] second, string kind)
    if kind == "euclidean"
        return math.sqrt(squared(first, second))
    if kind == "manhattan"
        return math.sum(math.abs(first - second))
    real64 mean_first = math.sum(first) / real64(len(first))
    real64 mean_second = math.sum(second) / real64(len(second))
    real64[] centered_first = first - mean_first
    real64[] centered_second = second - mean_second
    real64 cross = math.sum(centered_first * centered_second)
    real64 spread = math.sum(centered_first * centered_first) * math.sum(centered_second * centered_second)
    return 1.0 - cross / math.sqrt(spread)

real64[][] distance_matrix(real64[][] vectors, string kind)
    int count = int(len(vectors))
    real64[][] matrix = array(nat(count), fill = array(nat(count), fill = 0.0))
    for int first < count
        for first + 1 <= int second < count
            real64 value = distance(vectors[first], vectors[second], kind)
            matrix[first][second] = value
            matrix[second][first] = value
    return matrix
