import math
import data = "./dataset.qui"
import metric = "./distances.qui"
import agg = "./agglomerative.qui"
import drawing = "./dendrogram.qui"
import validation = "./validation.qui"

string real_text(real64 | none value)
    match value
        real64
            string formatted = "{value:frac=4}"
            return if formatted == "-0.0000" then "0.0000" else formatted
        none
            return "-"

string reals(real64[] values)
    return [for real64 value = values[] then real_text(value)].join(" ")

string integers(int[] values)
    return [for int value = values[] then "{value}"].join(" ")

real64 rounded_key(real64 value)
    real64 rounded = real64.parse(real_text(value))
    return rounded

real64 | error required_real(real64 | none value)
    match value
        real64
            return value
        none
            return error("missing clustering metric")

string ari_text(validation.Fraction fraction)
    return "{fraction.numerator}/{fraction.denominator} {real_text(fraction.value())}"

real64[] pair_values(real64[][] matrix)
    real64[] values = []
    for int first < int(len(matrix))
        for first + 1 <= int second < int(len(matrix))
            values = values.append(matrix[first][second])
    return values

int histogram_bin(real64 value, real64 maximum)
    int position = math.floor(10.0 * value / maximum)
    return math.min(9, position)

real64[] centroid(real64[][] vectors)
    return [for int feature = (0:<int(len(vectors[0])))[] then math.sum([for real64[] vector = vectors[] then vector[feature]]) / real64(len(vectors))]

int[][] cluster_members(int[] partition, int groups)
    int[] empty = []
    int[][] members = array(nat(groups), fill = empty)
    for int position < int(len(partition))
        members[partition[position] - 1] = members[partition[position] - 1].append(position)
    return members

int majority_class(int[] row)
    int best = 0
    for 1 <= int category < int(len(row))
        if row[category] > row[best]
            best = category
    return best

string[] join_parts(string[][] parts)
    string[] lines = []
    for string[] part = parts[]
        if len(lines) > 0
            lines = lines.append("")
        lines = lines.concat(part)
    return lines

class Minstd(int state)
    int .draw()
        state = 48271 * state % 2147483647
        return state

class Tree(agg.Merge[] merges, int count)
    real64[] heights = [for agg.Merge merge = merges[] then merge.height]
    int[][] children = drawing.ordered_children(merges, count)
    int[] order = drawing.leaf_order(children, count)
    int[][] members = [for int leaf = (0:<count)[] then [leaf]]
    int[] depths = array(nat(count), fill = 0)
    real64[] subtree_heights = []
    for agg.Merge merge = merges[]
        members = members.append(members[merge.a].concat(members[merge.b]))
        depths = depths.append(1 + math.max(depths[merge.a], depths[merge.b]))
        real64 first_height = if merge.a < count then 0.0 else subtree_heights[merge.a - count]
        real64 second_height = if merge.b < count then 0.0 else subtree_heights[merge.b - count]
        subtree_heights = subtree_heights.append(math.max(merge.height, math.max(first_height, second_height)))

    real64 height_of(int node)
        return if node < count then 0.0 else heights[node - count]

    int[] partition(bool[] selected)
        int[] owner = 0:<count
        for int step < int(len(selected))
            if selected[step]
                for int leaf = members[count + step][]
                    owner[leaf] = count + step
        int[] numbers = array(nat(2 * count - 1), fill = 0)
        int groups = 0
        for int leaf = order[]
            if numbers[owner[leaf]] == 0
                groups += 1
                numbers[owner[leaf]] = groups
        return [for int node = owner[] then numbers[node]]

    int[] cut_height(real64 height)
        return partition([for real64 value = subtree_heights[] then value <= height])

    int[] cut_into(int groups)
        return partition([for int step = (0:<int(len(merges)))[] then step < count - groups])

    real64[][] cophenetic()
        real64[][] matrix = array(nat(count), fill = array(nat(count), fill = 0.0))
        for agg.Merge merge = merges[]
            for int first = members[merge.a][]
                for int second = members[merge.b][]
                    matrix[first][second] = merge.height
                    matrix[second][first] = merge.height
        return matrix

    real64[] joining_heights()
        real64[] values = array(nat(count), fill = 0.0)
        for agg.Merge merge = merges[]
            for int child = [merge.a, merge.b][]
                if child < count
                    values[child] = merge.height
        return values

    real64[] height_sequence(int step, int depth)
        if depth == 0
            return []
        agg.Merge merge = merges[step]
        real64[] sequence = [merge.height]
        for int child = [merge.a, merge.b][]
            if child >= count
                sequence = sequence.concat(height_sequence(child - count, depth - 1))
        return sequence

    string newick(int node, string[] idents)
        if node < count
            return idents[node]
        string[] branches = []
        for int child = children[node - count][]
            branches = branches.append(newick(child, idents) + ":" + real_text(height_of(node) - height_of(child)))
        return "(" + branches.join(",") + ")"

class Evaluation(int[] partition, int[] sizes, real64 | none silhouette, real64 | none dunn, real64 wss, real64 | none ch, validation.Fraction ari)
    string text()
        return "sizes {integers(sizes)} silhouette {real_text(silhouette)} dunn {real_text(dunn)} wss {real_text(wss)} ch {real_text(ch)} ari {ari_text(ari)}"

class LinkageResult(string method, Tree tree, real64[] cophenetic, real64 correlation, Evaluation[] height_cuts, Evaluation[] count_cuts, int[] label_partition)

class Study(local data.Observations observations, data.Settings settings)
    string[] names = observations.names
    int count = int(len(observations.rows))
    string[] idents = [for data.Observation row = observations.rows[] then row.ident]
    string[] labels = [for data.Observation row = observations.rows[] then row.label]
    string[] classes = []
    int[] targets = []
    real64[][] raw = [for data.Observation row = observations.rows[] then row.values]
    local metric.Statistics statistics = metric.Statistics(raw)
    real64[] means = statistics.means
    real64[] deviations = statistics.deviations
    real64[][] vectors = if settings.standardize == "yes" then metric.standardize(raw, means, deviations) else raw
    real64[][] delta = metric.distance_matrix(vectors, settings.distance)
    real64[] distance_pairs = pair_values(delta)
    real64 distance_max = math.max_all(distance_pairs)
    int[] neighbors = []
    LinkageResult[] results = []
    int chosen = 0
    int position = 0
    int kappa = 0
    int[] selected = []
    int[][] members = []
    real64[] silhouettes = []
    int[][] table = []
    int[] majority = []
    for string label = labels.sorted()[]
        if len(classes) == 0 or classes[len(classes) - 1] != label
            classes = classes.append(label)
    for string label = labels[]
        for int category < int(len(classes))
            if classes[category] == label
                targets = targets.append(category)
                break
    for int observation < count
        neighbors = neighbors.append(nearest_neighbor(observation))
    for string method = settings.linkages[]
        results = results.append(analyse(method))
    for int result < int(len(results))
        for int candidate < int(len(settings.cut_counts))
            if results[result].count_cuts[candidate].ari.greater(results[chosen].count_cuts[position].ari)
                chosen = result
                position = candidate
    kappa = settings.cut_counts[position]
    selected = results[chosen].count_cuts[position].partition
    members = cluster_members(selected, kappa)
    silhouettes = validation.silhouette_values(selected, kappa, delta)
    table = class_table(selected)
    majority = [for int[] row = table[] then majority_class(row)]

    int nearest_neighbor(int observation)
        int best = -1
        for int other < count
            if other != observation and (best < 0 or delta[observation][other] < delta[observation][best])
                best = other
        return best

    int[][] class_table(int[] partition)
        return validation.contingency(partition - 1, targets, math.max_all(partition), int(len(classes)))

    validation.Fraction label_ari(int[] partition)
        return validation.adjusted_rand(class_table(partition))

    int match_count(int[] partition)
        return math.sum([for int[] row = class_table(partition)[] then math.max_all(row)])

    validation.Fraction partition_ari(int[] first, int[] second)
        return validation.adjusted_rand(validation.contingency(first - 1, second - 1, math.max_all(first), math.max_all(second)))

    real64 | none mean_silhouette(int[] partition, real64[][] distances)
        int groups = math.max_all(partition)
        return if groups < 2 then none else math.sum(validation.silhouette_values(partition, groups, distances)) / real64(len(partition))

    real64[][] centroids(int[] partition)
        int[][] groups = cluster_members(partition, math.max_all(partition))
        return [for int[] group = groups[] then centroid([for int observation = group[] then vectors[observation]])]

    real64 within_sum(int[] partition)
        real64[][] centers = centroids(partition)
        return math.sum([for int observation = (0:<count)[] then metric.squared(vectors[observation], centers[partition[observation] - 1])])

    Evaluation evaluate(int[] partition)
        int groups = math.max_all(partition)
        int[][] group_list = cluster_members(partition, groups)
        int[] sizes = [for int[] group = group_list[] then int(len(group))]
        real64 wss = within_sum(partition)
        real64 diameter = 0.0
        real64 gap_between = inf
        for int first < count
            for first + 1 <= int second < count
                if partition[first] == partition[second]
                    diameter = math.max(diameter, delta[first][second])
                else
                    gap_between = math.min(gap_between, delta[first][second])
        real64 | none ch = none
        if 2 <= groups < count
            real64[] overall = centroid(vectors)
            real64[][] centers = centroids(partition)
            real64 bss = math.sum([for int group = (0:<groups)[] then real64(sizes[group]) * metric.squared(centers[group], overall)])
            ch = bss / real64(groups - 1) / (wss / real64(count - groups))
        real64 | none dunn = if groups >= 2 and diameter > 0.0 then gap_between / diameter else none
        return Evaluation(partition, sizes, mean_silhouette(partition, delta), dunn, wss, ch, label_ari(partition))

    LinkageResult analyse(string method)
        auto tree = Tree(agg.agglomerate(delta, method), count)
        real64[] cophenetic = pair_values(tree.cophenetic())
        Evaluation[] height_cuts = [for real64 height = settings.cut_heights[] then evaluate(tree.cut_height(height))]
        Evaluation[] count_cuts = [for int clusters = settings.cut_counts[] then evaluate(tree.cut_into(clusters))]
        return LinkageResult(method, tree, cophenetic, validation.correlation(distance_pairs, cophenetic), height_cuts, count_cuts, tree.cut_into(int(len(classes))))

    string[] linkage_table()
        string[] lines = ["method,step,a,b,height,size"]
        for LinkageResult result = results[]
            for int step < int(len(result.tree.merges))
                agg.Merge merge = result.tree.merges[step]
                lines = lines.append("{result.method},{step + 1},{merge.a},{merge.b},{real_text(merge.height)},{merge.size}")
        return lines

    string[] clusters_table()
        string[] header = ["id", "label"]
        for LinkageResult result = results[]
            for int cut < int(len(settings.cut_heights))
                header = header.append("{result.method}_h{cut + 1}")
            for int clusters = settings.cut_counts[]
                header = header.append("{result.method}_k{clusters}")
        string[] lines = [header.join(",")]
        for int observation < count
            string[] fields = [idents[observation], labels[observation]]
            for LinkageResult result = results[]
                for Evaluation cut = result.height_cuts.concat(result.count_cuts)[]
                    fields = fields.append("{cut.partition[observation]}")
            lines = lines.append(fields.join(","))
        return lines

    string[] dendrogram_report()
        string[][] blocks = []
        for LinkageResult result = results[]
            Tree tree = result.tree
            real64 maximum = math.max_all(tree.heights)
            int[] cuts = [for real64 height = settings.cut_heights[] then drawing.column(height, maximum, settings.width)]
            string[] lines = ["dendrogram {result.method} height_max {real_text(maximum)} width {settings.width}"]
            lines = lines.concat(drawing.dendrogram_rows(tree.merges, tree.children, tree.order, idents, labels, maximum, cuts, settings.width))
            for int cut < int(len(cuts))
                string column_text = if cuts[cut] <= settings.width then "{cuts[cut]}" else "-"
                lines = lines.append("cut {real_text(settings.cut_heights[cut])} column {column_text}")
            blocks = blocks.append(lines)
        return join_parts(blocks)

    string[] trees_report()
        return [for LinkageResult result = results[] then "{result.method} {result.tree.newick(2 * count - 2, idents)};"]

    string pair_text(int first, int second)
        return "{real_text(delta[first][second])} {idents[first]} {idents[second]}"

    string[] data_part()
        string[] lines = ["data n {count} features {len(names)} classes {len(classes)} distance {settings.distance} standardize {settings.standardize}"]
        for int feature < int(len(names))
            lines = lines.append("feature {names[feature]} mean {real_text(means[feature])} sd {real_text(deviations[feature])}")
        int[] smallest = [0, 1]
        int[] largest = [0, 1]
        for int first < count
            for first + 1 <= int second < count
                if delta[first][second] < delta[smallest[0]][smallest[1]]
                    smallest = [first, second]
                if delta[first][second] > delta[largest[0]][largest[1]]
                    largest = [first, second]
        real64 nearest_mean = math.sum([for int observation = (0:<count)[] then delta[observation][neighbors[observation]]]) / real64(count)
        int reciprocal = math.sum<int>([for int observation = (0:<count)[] if observation < neighbors[observation] and neighbors[neighbors[observation]] == observation then 1])
        lines = lines.append("distances pairs {len(distance_pairs)} min {pair_text(smallest[0], smallest[1])} max {pair_text(largest[0], largest[1])} mean {real_text(math.sum(distance_pairs) / real64(len(distance_pairs)))}")
        lines = lines.append("nearest_neighbors mean {real_text(nearest_mean)} reciprocal_pairs {reciprocal}")
        return lines.append("labels {evaluate(targets + 1).text()}")

    string[] correlation_part()
        real64[][] columns = [for int feature = (0:<int(len(names)))[] then [for real64[] row = raw[] then row[feature]]]
        string[] lines = ["correlation " + names.join(" ")]
        for int feature < int(len(names))
            lines = lines.append(names[feature] + " " + reals([for real64[] column = columns[] then validation.correlation(columns[feature], column)]))
        return lines

    string[] histogram_part()
        int[] counts = array(10, fill = 0)
        for real64 value = distance_pairs[]
            counts[histogram_bin(value, distance_max)] += 1
        int highest = math.max_all(counts)
        string[] lines = ["histogram"]
        for int bin_number < 10
            int frequency = counts[bin_number]
            int length = frequency * 50 / highest
            string bar = if length > 0 then " " + string.repeat("#", nat(length)) else ""
            lines = lines.append("{real_text(real64(bin_number) * distance_max / 10.0)} {real_text(real64(bin_number + 1) * distance_max / 10.0)} {frequency}{bar}")
        return lines

    string[] linkage_part(LinkageResult result)
        Tree tree = result.tree
        real64 path = math.sum([for int row = (0:<count - 1)[] then delta[tree.order[row]][tree.order[row + 1]]])
        int[] inversions = [for int step = (1:<count - 1)[] if tree.heights[step] < tree.heights[step - 1] then step]
        string[] lines = ["linkage {result.method}", "cophenetic {real_text(result.correlation)} leaf_path {real_text(path)}", "heights min {real_text(math.min_all(tree.heights))} max {real_text(math.max_all(tree.heights))} inversions {len(inversions)}"]
        for int step = inversions[]
            lines = lines.append("inversion step {step + 1} height {real_text(tree.heights[step])} previous {real_text(tree.heights[step - 1])}")
        real64[] ordered = tree.subtree_heights.sorted()
        real64[] gaps = [for int clusters = (2:settings.gap_max_k)[] then ordered[count - clusters] - ordered[count - clusters - 1]]
        int suggested = 2
        for 3 <= int clusters <= settings.gap_max_k
            if rounded_key(gaps[clusters - 2]) > rounded_key(gaps[suggested - 2])
                suggested = clusters
        lines = lines.concat(["gaps " + reals(gaps), "suggested_k {suggested}"])
        real64[] joining = tree.joining_heights()
        int[] late = 0:<count
        for 1 <= int index < count
            int value = late[index]
            int cursor = index
            while cursor > 0 and joining[value] > joining[late[cursor - 1]]
                late[cursor] = late[cursor - 1]
                cursor -= 1
            late[cursor] = value
        lines = lines.append("late_joiners " + [for int observation = late[0:<settings.list_size][] then "{idents[observation]}:{real_text(joining[observation])}"].join(" "))
        int[] kinds = [0, 0, 0]
        for agg.Merge merge = tree.merges[]
            int leaves = (if merge.a < count then 1 else 0) + (if merge.b < count then 1 else 0)
            kinds[2 - leaves] += 1
        int matches = match_count(result.label_partition)
        lines = lines.append("merges leaf_leaf {kinds[0]} leaf_cluster {kinds[1]} cluster_cluster {kinds[2]} depth {tree.depths[2 * count - 2]}")
        lines = lines.append("label_cut k {len(classes)} purity {matches}/{count} {real_text(real64(matches) / real64(count))}")
        lines = lines.append("inconsistency depth {settings.inconsistency_depth}")
        for count - settings.inconsistency_count - 1 <= int step < count - 1
            real64[] sequence = tree.height_sequence(step, settings.inconsistency_depth)
            real64 average = math.sum(sequence) / real64(len(sequence))
            real64 deviation = 0.0
            real64 coefficient = 0.0
            if len(sequence) >= 2
                deviation = math.sqrt(math.sum((sequence - average) * (sequence - average)) / real64(int(len(sequence)) - 1))
                coefficient = (tree.heights[step] - average) / deviation
            lines = lines.append("step {step + 1} height {real_text(tree.heights[step])} mean {real_text(average)} sd {real_text(deviation)} count {len(sequence)} coefficient {real_text(coefficient)}")
        for int cut < int(len(settings.cut_heights))
            lines = lines.append("cut height {real_text(settings.cut_heights[cut])} clusters {len(result.height_cuts[cut].sizes)} {result.height_cuts[cut].text()}")
        for int cut < int(len(settings.cut_counts))
            lines = lines.append("cut k {settings.cut_counts[cut]} {result.count_cuts[cut].text()}")
        return lines

    string[] mst_part(LinkageResult single)
        agg.Edge[] edges = agg.minimum_spanning_tree(delta)
        real64[] weights = [for agg.Edge edge = edges[] then edge.weight]
        real64 total = math.sum(weights)
        weights = weights.sorted()
        bool heights_match = true
        bool[][] linked = array(nat(count), fill = array(nat(count), fill = false))
        for int index < int(len(edges))
            if math.abs(weights[index] - single.tree.heights[index]) > 0.000000001
                heights_match = false
            linked[edges[index].parent][edges[index].child] = true
            linked[edges[index].child][edges[index].parent] = true
        int nearest = math.sum<int>([for int observation = (0:<count)[] if linked[observation][neighbors[observation]] then 1])
        string height_result = if heights_match then "match" else "mismatch"
        string[] lines = ["mst total {real_text(total)} heights {height_result} nn_edges {nearest}/{count}"]
        int[] numbers = 0:<int(len(edges))
        for 1 <= int index < int(len(numbers))
            int value = numbers[index]
            int cursor = index
            while cursor > 0 and edges[value].weight < edges[numbers[cursor - 1]].weight
                numbers[cursor] = numbers[cursor - 1]
                cursor -= 1
            numbers[cursor] = value
        for int cut < int(len(settings.cut_counts))
            int clusters = settings.cut_counts[cut]
            int[] component = 0:<count
            for int step < count - clusters
                agg.Edge edge = edges[numbers[step]]
                int old = component[edge.child]
                int replacement = component[edge.parent]
                for int observation < count
                    if component[observation] == old
                        component[observation] = replacement
            int[] partition = single.count_cuts[cut].partition
            bool agrees = true
            for int first < count
                for first + 1 <= int second < count
                    if (component[first] == component[second]) != (partition[first] == partition[second])
                        agrees = false
            string result = if agrees then "match" else "mismatch"
            lines = lines.append("mst partition k {clusters} {result}")
        return lines

    string[] compare_part()
        string method = settings.compare_linkage
        int label_count = int(len(classes))
        string[] lines = ["compare linkage {method} k {label_count}"]
        for string kind = metric.types[]
            real64[][] distances = metric.distance_matrix(vectors, kind)
            auto tree = Tree(agg.agglomerate(distances, method), count)
            int[] partition = tree.cut_into(label_count)
            real64 coefficient = validation.correlation(pair_values(distances), pair_values(tree.cophenetic()))
            lines = lines.append("metric {kind} cophenetic {real_text(coefficient)} silhouette {real_text(mean_silhouette(partition, distances))} ari {ari_text(label_ari(partition))}")
        return lines

    string[] cophenetic_part()
        string[] lines = ["cophenetic_matrix", "linkage " + settings.linkages.join(" ")]
        for LinkageResult first = results[]
            real64[] values = [for LinkageResult second = results[] then validation.correlation(first.cophenetic, second.cophenetic)]
            lines = lines.append(first.method + " " + reals(values))
        return lines

    string[] agreement_part()
        string[] lines = ["agreement k {len(classes)}", "linkage " + settings.linkages.join(" ")]
        for LinkageResult first = results[]
            real64[] values = [for LinkageResult second = results[] then partition_ari(first.label_partition, second.label_partition).value()]
            lines = lines.append(first.method + " " + reals(values))
        return lines

    string[] summary_part()
        int[] ranking = 0:<int(len(results))
        for 1 <= int index < int(len(ranking))
            int value = ranking[index]
            int cursor = index
            while cursor > 0 and rounded_key(results[value].correlation) > rounded_key(results[ranking[cursor - 1]].correlation)
                ranking[cursor] = ranking[cursor - 1]
                cursor -= 1
            ranking[cursor] = value
        string[] lines = ["summary", "cophenetic_ranking " + [for int result = ranking[] then results[result].method].join(" ")]
        for int cut < int(len(settings.cut_counts))
            int best = 0
            for 1 <= int result < int(len(results))
                if results[result].count_cuts[cut].ari.greater(results[best].count_cuts[cut].ari)
                    best = result
            lines = lines.append("best_ari k {settings.cut_counts[cut]} {results[best].method} {ari_text(results[best].count_cuts[cut].ari)}")
        for LinkageResult result = results[]
            int best = 0
            for 1 <= int cut < int(len(settings.cut_counts))
                real64 candidate = required_real(result.count_cuts[cut].silhouette)
                real64 incumbent = required_real(result.count_cuts[best].silhouette)
                if rounded_key(candidate) > rounded_key(incumbent)
                    best = cut
            lines = lines.append("best_silhouette {result.method} k {settings.cut_counts[best]} {real_text(result.count_cuts[best].silhouette)}")
        return lines.append("selected {results[chosen].method} k {kappa}")

    string[] validation_report()
        string[][] parts = [data_part(), correlation_part(), histogram_part()]
        for LinkageResult result = results[]
            parts = parts.append(linkage_part(result))
        for LinkageResult result = results[]
            if result.method == "single"
                parts = parts.append(mst_part(result))
        return join_parts(parts.concat([compare_part(), cophenetic_part(), agreement_part(), summary_part()]))

    real64 separation(int[] first, int[] second)
        real64 best = inf
        for int observation = first[]
            for int other = second[]
                best = math.min(best, delta[observation][other])
        return best

    string[] cluster_lines(int cluster)
        int[] group = members[cluster]
        int size = int(len(group))
        int category = majority[cluster]
        int majority_count = table[cluster][category]
        real64 silhouette = math.sum([for int observation = group[] then silhouettes[observation]]) / real64(size)
        real64[] original_means = [for int feature = (0:<int(len(names)))[] then math.sum([for int observation = group[] then raw[observation][feature]]) / real64(size)]
        int medoid = -1
        real64 medoid_sum = 0.0
        int[] widest = []
        for int index < size
            int observation = group[index]
            real64 total = math.sum([for int other = group[] then delta[observation][other]])
            if medoid < 0 or total < medoid_sum
                medoid = observation
                medoid_sum = total
            for int other = group[index + 1:][]
                if len(widest) == 0 or delta[observation][other] > delta[widest[0]][widest[1]]
                    widest = [observation, other]
        int nearest = -1
        real64 nearest_separation = 0.0
        for int other < kappa
            if other == cluster
                continue
            real64 value = separation(group, members[other])
            if nearest < 0 or value < nearest_separation
                nearest = other
                nearest_separation = value
        string diameter = if len(widest) == 0 then "0.0000 - -" else pair_text(widest[0], widest[1])
        return ["cluster {cluster + 1} size {size} silhouette {real_text(silhouette)} majority {classes[category]} purity {majority_count}/{size} {real_text(real64(majority_count) / real64(size))}", "  mean " + reals(original_means), "  medoid {idents[medoid]} diameter {diameter} nearest {nearest + 1} separation {real_text(nearest_separation)}"]

    string[] selection_part()
        Evaluation cut = results[chosen].count_cuts[position]
        string[] lines = ["selected linkage {results[chosen].method} k {kappa} ari {ari_text(cut.ari)} silhouette {real_text(cut.silhouette)}"]
        for int cluster < kappa
            lines = lines.concat(cluster_lines(cluster))
        return lines

    string[] centroid_part()
        real64[][] centers = centroids(selected)
        string[] lines = ["centroid_distances"]
        for int cluster < kappa
            real64[] values = [for real64[] center = centers[] then math.sqrt(metric.squared(centers[cluster], center))]
            lines = lines.append("{cluster + 1} " + reals(values))
        return lines

    string[] profile_part()
        nat width = math.max_all([for string name = names[] then len(name)])
        string[] lines = ["profile_bars"]
        for int cluster < kappa
            int[] group = members[cluster]
            lines = lines.append("cluster {cluster + 1}")
            for int feature < int(len(names))
                real64 zeta = math.sum([for int observation = group[] then (raw[observation][feature] - means[feature]) / deviations[feature]]) / real64(len(group))
                int length = math.floor(math.abs(zeta) * 4.0)
                length = math.min(10, length)
                string bar = string.repeat("#", nat(length))
                string left = if zeta < 0.0 then string.repeat(" ", nat(10 - length)) + bar else string.repeat(" ", 10)
                string right = if zeta < 0.0 then string.repeat(" ", 10) else bar + string.repeat(" ", nat(10 - length))
                string feature_name = names[feature] + string.repeat(" ", width - len(names[feature]))
                lines = lines.append("{feature_name} {left}|{right} {real_text(zeta)}")
        return lines

    string[] contingency_part()
        string[] lines = ["contingency", "cluster " + classes.join(" ") + " total"]
        for int cluster < kappa
            lines = lines.append("{cluster + 1} {integers(table[cluster])} {math.sum(table[cluster])}")
        int[] totals = [for int category = (0:<int(len(classes)))[] then math.sum([for int[] row = table[] then row[category]])]
        int matches = match_count(selected)
        return lines.concat(["total {integers(totals)} {count}", "purity {matches}/{count} {real_text(real64(matches) / real64(count))}"])

    string[] misplaced_part()
        string[] lines = ["misplaced"]
        int misplaced = 0
        for int observation < count
            int category = majority[selected[observation] - 1]
            if targets[observation] != category
                misplaced += 1
                lines = lines.append("{idents[observation]} label {labels[observation]} cluster {selected[observation]} majority {classes[category]}")
        return lines.append("count {misplaced}")

    string[] weakest_part()
        int[] ordered = 0:<count
        for 1 <= int index < count
            int value = ordered[index]
            int cursor = index
            while cursor > 0 and silhouettes[value] < silhouettes[ordered[cursor - 1]]
                ordered[cursor] = ordered[cursor - 1]
                cursor -= 1
            ordered[cursor] = value
        string[] lines = ["weakest"]
        for int observation = ordered[0:<settings.list_size][]
            lines = lines.append("{idents[observation]} label {labels[observation]} cluster {selected[observation]} silhouette {real_text(silhouettes[observation])}")
        return lines

    string[] feature_part()
        real64[] ratios = []
        for int feature < int(len(names))
            real64[] values = [for real64[] vector = vectors[] then vector[feature]]
            real64 overall = math.sum(values) / real64(count)
            real64[] cluster_means = [for int[] group = members[] then math.sum([for int observation = group[] then values[observation]]) / real64(len(group))]
            real64 between = math.sum([for int cluster = (0:<kappa)[] then real64(len(members[cluster])) * (cluster_means[cluster] - overall) * (cluster_means[cluster] - overall)])
            real64 within = math.sum([for int observation = (0:<count)[] then (values[observation] - cluster_means[selected[observation] - 1]) * (values[observation] - cluster_means[selected[observation] - 1])])
            ratios = ratios.append(between / real64(kappa - 1) / (within / real64(count - kappa)))
        int[] ranking = 0:<int(len(names))
        for 1 <= int index < int(len(ranking))
            int value = ranking[index]
            int cursor = index
            while cursor > 0 and rounded_key(ratios[value]) > rounded_key(ratios[ranking[cursor - 1]])
                ranking[cursor] = ranking[cursor - 1]
                cursor -= 1
            ranking[cursor] = value
        string[] lines = ["features"]
        for int rank < int(len(ranking))
            int feature = ranking[rank]
            lines = lines.append("{rank + 1} {names[feature]} f_ratio {real_text(ratios[feature])}")
        return lines

    string class_counts(Tree tree, int node)
        int[] counts = array(len(classes), fill = 0)
        for int observation = tree.members[node][]
            counts[targets[observation]] += 1
        return [for int frequency = counts[] then "{frequency}"].join("/")

    string[] top_merges_part()
        Tree tree = results[chosen].tree
        string[] lines = ["top_merges"]
        for count - settings.inconsistency_count - 1 <= int step < count - 1
            agg.Merge merge = tree.merges[step]
            lines = lines.append("step {step + 1} height {real_text(merge.height)} a {merge.a} {len(tree.members[merge.a])} {class_counts(tree, merge.a)} b {merge.b} {len(tree.members[merge.b])} {class_counts(tree, merge.b)}")
        return lines

    string[] drop_feature_part()
        string[] lines = ["drop_feature"]
        for int feature < int(len(names))
            real64[][] reduced = [for real64[] vector = vectors[] then vector[0:<feature].concat(vector[feature + 1:])]
            auto tree = Tree(agg.agglomerate(metric.distance_matrix(reduced, settings.distance), results[chosen].method), count)
            int[] partition = tree.cut_into(kappa)
            lines = lines.append("{names[feature]} ari_selected {ari_text(partition_ari(partition, selected))} ari_labels {ari_text(label_ari(partition))}")
        return lines

    string[] refinement_part()
        int limit = settings.refine_iterations
        int iterations = limit
        real64[][] centers = centroids(selected)
        int[] previous = selected
        for 1 <= int iteration <= limit
            int[] assignment = []
            for real64[] vector = vectors[]
                int best = 0
                real64 best_value = metric.squared(vector, centers[0])
                for 1 <= int cluster < kappa
                    real64 value = metric.squared(vector, centers[cluster])
                    if value < best_value
                        best = cluster
                        best_value = value
                assignment = assignment.append(best + 1)
            if assignment == previous
                iterations = iteration
                break
            int[][] groups = cluster_members(assignment, kappa)
            for int cluster < kappa
                if len(groups[cluster]) > 0
                    centers[cluster] = centroid([for int observation = groups[cluster][] then vectors[observation]])
            previous = assignment
        int changed = math.sum<int>([for int observation = (0:<count)[] if selected[observation] != previous[observation] then 1])
        int[] sizes = [for int[] group = cluster_members(previous, kappa)[] then int(len(group))]
        return ["refinement max_iterations {limit}", "iterations {iterations} changed {changed} wss {real_text(within_sum(selected))} -> {real_text(within_sum(previous))}", "sizes {integers(sizes)} silhouette {real_text(mean_silhouette(previous, delta))}", "ari_selected {ari_text(partition_ari(previous, selected))} ari_labels {ari_text(label_ari(previous))}"]

    real64[] jaccard(int[] sample_partition, int[] restricted)
        int[][] counts = validation.contingency(restricted - 1, sample_partition - 1, kappa, math.max_all(sample_partition))
        int[] columns = [for int cluster = (0:<int(len(counts[0])))[] then math.sum([for int[] row = counts[] then row[cluster]])]
        real64[] values = []
        for int[] row = counts[]
            int size = math.sum(row)
            auto best = validation.Fraction(0, 1)
            if size > 0
                for int cluster < int(len(row))
                    auto candidate = validation.Fraction(row[cluster], size + columns[cluster] - row[cluster])
                    if candidate.greater(best)
                        best = candidate
            values = values.append(best.value())
        return values

    string[] stability_part()
        int size = count * settings.percent / 100
        auto generator = Minstd(settings.seed)
        real64[] aris = []
        real64[][] jaccards = []
        string[] lines = ["stability replicates {settings.replicates} percent {settings.percent} seed {settings.seed}"]
        for 1 <= int replicate <= settings.replicates
            int[] order = 0:<count
            for int step < size
                int draw = .generator.draw()
                int other = step + draw % (count - step)
                int saved = order[step]
                order[step] = order[other]
                order[other] = saved
            int[] sample = order[0:<size].sorted()
            real64[][] distances = [for int first = sample[] then [for int second = sample[] then delta[first][second]]]
            auto tree = Tree(agg.agglomerate(distances, results[chosen].method), size)
            int[] partition = tree.cut_into(kappa)
            int[] restricted = [for int observation = sample[] then selected[observation]]
            validation.Fraction agreement = partition_ari(partition, restricted)
            real64[] similarities = jaccard(partition, restricted)
            aris = aris.append(agreement.value())
            jaccards = jaccards.append(similarities)
            lines = lines.append("replicate {replicate} size {size} ari {ari_text(agreement)} jaccard {reals(similarities)}")
        real64[] average_jaccards = [for int cluster = (0:<kappa)[] then math.sum([for real64[] row = jaccards[] then row[cluster]]) / real64(settings.replicates)]
        return lines.concat(["mean_ari {real_text(math.sum(aris) / real64(settings.replicates))}", "mean_jaccard " + reals(average_jaccards)])

    string[] distance_map_part()
        int[] order = results[chosen].tree.order
        string frame = "+" + string.repeat("-", nat(count)) + "+"
        string shades = "@%#*+=-:. "
        string[] lines = ["distance_map {results[chosen].method}", frame]
        for int first = order[]
            string row = [for int second = order[] then shades[histogram_bin(delta[first][second], distance_max)]].join("")
            lines = lines.append("|" + row + "|")
        return lines.append(frame)

    string[] profiles_report()
        return join_parts([selection_part(), centroid_part(), profile_part(), contingency_part(), misplaced_part(), weakest_part(), feature_part(), top_merges_part(), drop_feature_part(), refinement_part(), stability_part(), distance_map_part()])

void run_study()
    data.Observations observations = data.read_observations("input/data.csv")
    auto study = Study(observations, data.read_settings("input/params.txt"))
    bool directory_exists = file.is_directory("output")
    if not directory_exists
        file.mkdir("output")
    data.write_lines("output/linkage.csv", study.linkage_table())
    data.write_lines("output/clusters.csv", study.clusters_table())
    data.write_lines("output/dendrogram.txt", study.dendrogram_report())
    data.write_lines("output/trees.txt", study.trees_report())
    data.write_lines("output/validation.txt", study.validation_report())
    data.write_lines("output/profiles.txt", study.profiles_report())

if main
    run_study()
