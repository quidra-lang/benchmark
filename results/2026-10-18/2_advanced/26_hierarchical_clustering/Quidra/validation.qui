import math

real64 correlation(real64[] first, real64[] second)
    real64 mean_first = math.sum(first) / real64(len(first))
    real64 mean_second = math.sum(second) / real64(len(second))
    real64[] centered_first = first - mean_first
    real64[] centered_second = second - mean_second
    real64 cross = math.sum(centered_first * centered_second)
    real64 sx = math.sum(centered_first * centered_first)
    real64 sy = math.sum(centered_second * centered_second)
    return cross / math.sqrt(sx * sy)

int[][] contingency(int[] first, int[] second, int rows, int columns)
    int[][] table = array(nat(rows), fill = array(nat(columns), fill = 0))
    for nat position < len(first)
        table[first[position]][second[position]] += 1
    return table

int pair_count(int size)
    return size * (size - 1) / 2

class Fraction(int numerator, int denominator)
    real64 value()
        return real64(numerator) / real64(denominator)

    bool greater(Fraction other)
        return numerator * other.denominator > other.numerator * denominator

Fraction adjusted_rand(int[][] table)
    int count = math.sum([for int[] row = table[] then math.sum(row)])
    int same = math.sum([for int[] row = table[] then math.sum([for int cell = row[] then pair_count(cell)])])
    int row_pairs = math.sum([for int[] row = table[] then pair_count(math.sum(row))])
    int column_pairs = 0
    for nat column < len(table[0])
        column_pairs += pair_count(math.sum([for int[] row = table[] then row[column]]))
    int total = pair_count(count)
    int numerator = 2 * (total * same - row_pairs * column_pairs)
    int denominator = total * (row_pairs + column_pairs) - 2 * row_pairs * column_pairs
    if denominator == 0
        return Fraction(1, 1)
    int first = math.abs(numerator)
    int second = math.abs(denominator)
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    if denominator < 0
        first = -first
    return Fraction(numerator / first, denominator / first)

real64[] silhouette_values(int[] partition, int groups, real64[][] delta)
    int[] sizes = array(nat(groups + 1), fill = 0)
    for int group = partition[]
        sizes[group] += 1
    real64[] values = []
    for nat position < len(partition)
        int own = partition[position]
        if sizes[own] == 1
            values = values.append(0.0)
            continue
        real64[] sums = array(nat(groups + 1), fill = 0.0)
        for nat other < len(partition)
            if other != position
                sums[partition[other]] += delta[position][other]
        real64 inner = sums[own] / real64(sizes[own] - 1)
        real64 outer = inf
        for 1 <= int group <= groups
            if group != own
                outer = math.min(outer, sums[group] / real64(sizes[group]))
        values = values.append((outer - inner) / math.max(inner, outer))
    return values
