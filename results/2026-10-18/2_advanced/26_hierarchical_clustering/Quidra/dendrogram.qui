import math
import agg = "./agglomerative.qui"

int[][] ordered_children(agg.Merge[] merges, int count)
    int[] minimum = 0:<count
    int[][] children = []
    for agg.Merge merge = merges[]
        children = children.append(if minimum[merge.a] < minimum[merge.b] then [merge.a, merge.b] else [merge.b, merge.a])
        minimum = minimum.append(math.min(minimum[merge.a], minimum[merge.b]))
    return children

int[] leaf_order(int[][] children, int count)
    int[] order = []
    int[] pending = [count + int(len(children)) - 1]
    while len(pending) > 0
        int node = pending[len(pending) - 1]
        pending = pending[0:<int(len(pending)) - 1]
        if node < count
            order = order.append(node)
        else
            int[] pair = children[node - count]
            pending = pending.concat([pair[1], pair[0]])
    return order

int column(real64 height, real64 maximum, int width)
    real64 position = height / maximum * real64(width)
    if position >= real64(width + 1)
        return width + 1
    int result = math.floor(position)
    return result

void mark(int[][] &grid, int row, int x, int priority)
    grid[row][x] = math.max(grid[row][x], priority)

string[] dendrogram_rows(agg.Merge[] merges, int[][] children, int[] order, string[] idents, string[] labels, real64 maximum, int[] cuts, int width)
    int count = int(len(order))
    int[][] grid = array(nat(count), fill = array(nat(width + 1), fill = 0))
    int[] anchor = array(nat(2 * count - 1), fill = 0)
    for int row < count
        anchor[order[row]] = row
    for int x = cuts[]
        if x <= width
            for int row < count
                mark(&grid, row, x, 1)
    int[] columns = [for agg.Merge merge = merges[] then column(merge.height, maximum, width)]
    for int step < int(len(children))
        int upper = children[step][0]
        int lower = children[step][1]
        int x = columns[step]
        mark(&grid, anchor[upper], x, 4)
        mark(&grid, anchor[lower], x, 4)
        for anchor[upper] + 1 <= int row < anchor[lower]
            mark(&grid, row, x, 3)
        for int child = children[step][]
            int start = if child < count then 0 else columns[child - count] + 1
            for start <= int position < x
                mark(&grid, anchor[child], position, 2)
        anchor[count + step] = (anchor[upper] + anchor[lower]) / 2
    nat id_width = math.max_all([for string ident = idents[] then len(ident)])
    nat label_width = math.max_all([for string label = labels[] then len(label)])
    string marks = " :-|+"
    string[] rows = []
    for int row < count
        int leaf = order[row]
        string cells = [for int priority = grid[row][] then marks[priority]].join("")
        string text = idents[leaf] + string.repeat(" ", id_width - len(idents[leaf])) + " " + labels[leaf] + string.repeat(" ", label_width - len(labels[leaf])) + " " + cells
        while text.ends_with(" ")
            text = text[0:<int(len(text)) - 1]
        rows = rows.append(text)
    string scale = [for int x = (0:width)[] then if x % 10 == 0 then "+" else "-"].join("")
    return rows.append(string.repeat(" ", id_width + label_width + 2) + scale)
