class Observation(string ident, string label, real64[] values)
class Observations(string[] names, Observation[] rows)

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<int(len(lines)) - 1]

Observations read_observations(string path)
    string[] lines = read_lines(path)
    string[] names = lines[0].split(",")[2:]
    Observation[] rows = []
    for string line = lines[1:][]
        string[] fields = line.split(",")
        rows = rows.append(Observation(fields[0], fields[1], [for string value = fields[2:][] then real64.parse(value)]))
    return Observations(names, rows)

class Settings(local string[][] rows)
    string distance = rows[0][1]
    string standardize = rows[1][1]
    string[] linkages = rows[2][1:]
    real64[] cut_heights = [for string value = rows[3][1:][] then real64.parse(value)]
    int[] cut_counts = [for string value = rows[4][1:][] then int.parse(value)]
    int inconsistency_depth = int.parse(rows[5][1])
    int inconsistency_count = int.parse(rows[5][2])
    int gap_max_k = int.parse(rows[6][1])
    int list_size = int.parse(rows[7][1])
    int width = int.parse(rows[8][1])
    string compare_linkage = rows[9][1]
    int replicates = int.parse(rows[10][1])
    int percent = int.parse(rows[10][2])
    int seed = int.parse(rows[10][3])
    int refine_iterations = int.parse(rows[11][1])

Settings read_settings(string path)
    return Settings([for string line = read_lines(path)[] then line.split(" ")])

void write_lines(string path, string[] lines)
    file.write(path, if len(lines) == 0 then "" else lines.join(NL) + NL)
