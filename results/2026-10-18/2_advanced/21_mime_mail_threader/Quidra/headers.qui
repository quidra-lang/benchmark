import mime = "./mime.qui"

string lowercase(string text)
    nat8[] bytes = nat8[](text.utf8())
    for nat8 &code = &bytes[]
        if 65 <= code <= 90
            code += 32
    string result = string.from_utf8(bin(bytes))
    return result

string[] split_words(string text)
    return [for string word = text.split(HT).join(" ").split(" ")[] if word != "" then word]

string collapse_whitespace(string text)
    return split_words(text).join(" ")

int find_from(string text, string needle, int start = 0)
    match text[start:<len(text)].find(needle)
        nat position
            return start + int(position)
        none
            return -1

bool one_of(string value, string[] choices)
    for string choice = choices[]
        if value == choice
            return true
    return false

class Line(int number, string text)
class Field(string name, string value)

class Header(local Line[] source_lines)
    Field[] fields = []
    int[] invalid_lines = []
    local bool in_field = false
    for Line line = source_lines[]
        if line.text[0] == " " or line.text[0] == HT
            if in_field
                fields[len(fields) - 1].value += line.text
            else
                invalid_lines = invalid_lines.append(line.number)
            continue
        local int colon = find_from(line.text, ":")
        in_field = colon > 0
        if in_field
            for int code = line.text[0:<colon].codepoints()[]
                if not (33 <= code <= 126)
                    in_field = false
                    break
        if in_field
            fields = fields.append(Field(lowercase(line.text[0:<colon]), line.text[colon + 1:<len(line.text)]))
        else
            invalid_lines = invalid_lines.append(line.number)
    for int position < int(len(fields))
        fields[position].value = fields[position].value.trim()

    int count(string name)
        int result = 0
        string wanted = lowercase(name)
        for Field field = fields[]
            if field.name == wanted
                result += 1
        return result

    string get(string name, string fallback = "")
        string wanted = lowercase(name)
        for Field field = fields[]
            if field.name == wanted
                return field.value
        return fallback

string | none remove_comments(string text)
    string result = ""
    int depth = 0
    bool escaped = false
    for int position < int(len(text))
        string symbol = text[position]
        if depth == 0
            if symbol == "("
                depth = 1
                result += " "
            else
                result += symbol
        elif escaped
            escaped = false
        elif symbol.codepoints()[0] == 92
            escaped = true
        elif symbol == "("
            depth += 1
        elif symbol == ")"
            depth -= 1
    return if depth == 0 then result else none

int | none skip_comment(string text, int start)
    int depth = 0
    int position = start
    while position < int(len(text))
        string symbol = text[position]
        if symbol.codepoints()[0] == 92
            position += 2
            continue
        if symbol == "("
            depth += 1
        elif symbol == ")"
            depth -= 1
            if depth == 0
                return position + 1
        position += 1
    return none

class Quoted(string text, int end)

Quoted | none read_quoted(string text, int start)
    string result = ""
    int position = start + 1
    while position < int(len(text))
        string symbol = text[position]
        if symbol == DQ
            return Quoted(result, position + 1)
        if symbol.codepoints()[0] == 92
            position += 1
            if position == int(len(text))
                return none
            symbol = text[position]
        result += symbol
        position += 1
    return none

bool word_character(string symbol, bool for_address)
    int code = symbol.codepoints()[0]
    if for_address
        return (65 <= code <= 90) or (97 <= code <= 122) or (48 <= code <= 57) or "!#$%&'*+-/=?^_`{{|}}~".contains(symbol)
    string excluded = "()<>@,;:/[]?=" + DQ
    return 33 <= code <= 126 and code != 92 and not excluded.contains(symbol)

class Token(string kind, string text, bool spaced)

Token[] | none tokenize(string text, bool for_address)
    Token[] tokens = []
    string specials = if for_address then "<>:;@,." else "/;="
    bool spaced = false
    int position = 0
    while position < int(len(text))
        string symbol = text[position]
        if symbol == " " or symbol == HT
            spaced = true
            position += 1
            continue
        if symbol == "("
            match skip_comment(text, position)
                int end
                    position = end
                none
                    return none
            spaced = true
            continue
        if symbol == DQ
            match read_quoted(text, position)
                Quoted quoted
                    tokens = tokens.append(Token("quoted", quoted.text, spaced))
                    position = quoted.end
                none
                    return none
        elif specials.contains(symbol)
            tokens = tokens.append(Token(symbol, symbol, spaced))
            position += 1
        elif word_character(symbol, for_address)
            int end = position + 1
            while end < int(len(text)) and word_character(text[end], for_address)
                end += 1
            tokens = tokens.append(Token("word", text[position:<end], spaced))
            position = end
        else
            return none
        spaced = false
    return tokens

nat8[] | none decode_q(string text)
    nat8[] result = []
    int position = 0
    while position < int(len(text))
        if text[position] == "_"
            result = result.append(32)
            position += 1
        elif text[position] == "="
            if position + 2 >= int(len(text))
                return none
            int high = mime.hex_value(text[position + 1])
            int low = mime.hex_value(text[position + 2])
            if high < 0 or low < 0
                return none
            result = result.append(nat8(16 * high + low))
            position += 3
        else
            result = result.append(nat8(text[position].codepoints()[0]))
            position += 1
    return result

class WordDecoded(string text, bool decoded, bool failed)

WordDecoded decode_word(string word)
    if len(word) < 4 or not word.starts_with("=?") or not word.ends_with("?=")
        return WordDecoded(word, false, false)
    string[] pieces = word[2:<len(word) - 2].split("?")
    if len(pieces) != 3
        return WordDecoded(word, false, false)
    for string piece = pieces[]
        if piece == ""
            return WordDecoded(word, false, false)
    if lowercase(pieces[0]) != "us-ascii" or not one_of(pieces[1], ["Q", "q", "B", "b"])
        return WordDecoded(word, false, true)
    nat8[] | none raw = if pieces[1] == "Q" or pieces[1] == "q" then decode_q(pieces[2]) else mime.strict_base64(pieces[2])
    nat8[] bytes = []
    match raw
        nat8[] decoded
            bytes = decoded
        none
            return WordDecoded(word, false, true)
    for nat8 code = bytes[]
        if not (32 <= code <= 126)
            return WordDecoded(word, false, true)
    string result = string.from_utf8(bin(bytes))
    return WordDecoded(result, true, false)

class TextDecoded(string text, bool failed)

TextDecoded decode_unstructured(string value)
    string result = ""
    bool failed = false
    bool previous_decoded = false
    bool first = true
    for string word = split_words(value)[]
        WordDecoded decoded = decode_word(word)
        if not first and not (decoded.decoded and previous_decoded)
            result += " "
        result += decoded.text
        failed = failed or decoded.failed
        previous_decoded = decoded.decoded
        first = false
    return TextDecoded(collapse_whitespace(result), failed)

class Parameters(string main_type, string subtype, map.Map<string, string> values)
    string get(string name)
        match values.get(name)
            string value
                return value
            none
                return ""

Parameters | none parse_parameters(string value, bool with_subtype)
    Token[] tokens = []
    match tokenize(value, false)
        Token[] parsed
            tokens = parsed
        none
            return none
    if len(tokens) == 0 or tokens[0].kind != "word"
        return none
    string main_type = lowercase(tokens[0].text)
    string subtype = ""
    int position = 1
    if with_subtype
        if len(tokens) < 3 or tokens[1].kind != "/" or tokens[2].kind != "word"
            return none
        subtype = lowercase(tokens[2].text)
        position = 3
    map.Map<string, string> parameters
    while position < int(len(tokens))
        if position + 3 >= int(len(tokens))
            return none
        if tokens[position].kind != ";" or tokens[position + 1].kind != "word" or tokens[position + 2].kind != "=" or not one_of(tokens[position + 3].kind, ["word", "quoted"])
            return none
        string name = lowercase(tokens[position + 1].text)
        if not parameters.has(name)
            .parameters.set(name, tokens[position + 3].text)
        position += 4
    return Parameters(main_type, subtype, parameters)
