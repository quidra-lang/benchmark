class MessageInfo(int number, bool dated, int seconds, string id, string[] references, string base_subject, bool reply)
class Container(string id)
    int message = -1
    int parent = -1
    int[] children = []
    string subject = ""
    bool subject_container = false

bool key_less(MessageInfo first, MessageInfo second)
    if first.dated != second.dated
        return first.dated
    if first.dated and first.seconds != second.seconds
        return first.seconds < second.seconds
    if first.id != second.id
        string[] ordered = [first.id, second.id].sorted()
        return ordered[0] == first.id
    return first.number < second.number

int[] postorder(int[] roots, Container[] nodes)
    int[] stack = [for int id = roots[::-1][] then 2 * id]
    int[] result = []
    while len(stack) > 0
        int encoded = stack[len(stack) - 1]
        stack = stack[0:<len(stack) - 1]
        int id = encoded / 2
        if encoded % 2 == 1
            result = result.append(id)
        else
            stack = stack.append(encoded + 1)
            for int child = nodes[id].children[::-1][]
                stack = stack.append(2 * child)
    return result

int[] ranked_ids(int[] ids, int[] keys, int stride)
    int64[] encoded = [for int id = ids[] then int64(keys[id] * stride + id)]
    return [for int64 value = encoded.sorted()[] then int(value) % stride]

int[] group_of(map.Map<string, int[]> groups, string subject)
    match groups.get(subject)
        int[] found
            return found
        none
            return []

class Forest(MessageInfo[] messages)
    Container[] nodes = []
    map.Map<string, int> table
    int[] roots = []
    int[] message_nodes = array(len(messages), fill = -1)
    int[] message_ranks = array(len(messages), fill = 0)
    local int[] ordered = []
    for int index < int(len(messages))
        int position = int(len(ordered))
        ordered = ordered.append(index)
        while position > 0
            if not key_less(messages[index], messages[ordered[position - 1]])
                break
            ordered[position] = ordered[position - 1]
            position -= 1
        ordered[position] = index
    for int index < int(len(ordered))
        message_ranks[ordered[index]] = index
    for int index < int(len(messages))
        .add_message(index)
    roots = [for int id = (0:<int(len(nodes)))[] if nodes[id].parent < 0 then id]
    .prune_roots()
    .sort_all()
    .merge_subjects()
    .sort_all()

    int .container_of(string message_id)
        match table.get(message_id)
            int found
                return found
            none
                int id = int(len(nodes))
                nodes = nodes.append(Container(message_id))
                .table.set(message_id, id)
                return id

    bool ancestor_or_self(int ancestor, int other)
        int current = other
        while current >= 0
            if current == ancestor
                return true
            current = nodes[current].parent
        return false

    void .adopt(int parent, int child)
        nodes[child].parent = parent
        nodes[parent].children = nodes[parent].children.append(child)

    void .add_message(int message_index)
        MessageInfo info = messages[message_index]
        int container = -1
        if info.id == ""
            container = int(len(nodes))
            nodes = nodes.append(Container(""))
        else
            container = .container_of(info.id)
        nodes[container].message = message_index
        message_nodes[message_index] = container
        int[] references = []
        for string reference = info.references[]
            references = references.append(.container_of(reference))
        for int position < int(len(references)) - 1
            int current = references[position]
            int following = references[position + 1]
            if nodes[following].parent < 0 and not ancestor_or_self(following, current)
                .adopt(current, following)
        int previous = nodes[container].parent
        if previous >= 0
            nodes[previous].children = [for int child = nodes[previous].children[] if child != container then child]
            nodes[container].parent = -1
        if len(references) > 0 and not ancestor_or_self(container, references[len(references) - 1])
            .adopt(references[len(references) - 1], container)

    void .prune_roots()
        int[] empty = []
        int[][] replacements = array(len(nodes), fill = empty)
        for int id = postorder(roots, nodes)[]
            int[] children = []
            for int child = nodes[id].children[]
                children = children.concat(replacements[child])
            nodes[id].children = children
            bool keep = nodes[id].message >= 0 or (nodes[id].parent < 0 and len(children) >= 2)
            int parent = if keep then id else nodes[id].parent
            for int child = children[]
                nodes[child].parent = parent
            replacements[id] = if keep then [id] else children
        int[] result = []
        for int id = roots[]
            result = result.concat(replacements[id])
        roots = result

    void .sort_all()
        int[] keys = array(len(nodes), fill = 0)
        int stride = int(len(nodes)) + 1
        for int id = postorder(roots, nodes)[]
            if nodes[id].message >= 0
                keys[id] = message_ranks[nodes[id].message]
            else
                int best = int(len(messages))
                for int child = nodes[id].children[]
                    if keys[child] < best
                        best = keys[child]
                keys[id] = best
            nodes[id].children = ranked_ids(nodes[id].children, keys, stride)
        roots = ranked_ids(roots, keys, stride)

    string root_subject(int root)
        if nodes[root].subject_container
            return nodes[root].subject
        int message_index = nodes[root].message
        if message_index < 0
            message_index = nodes[nodes[root].children[0]].message
        return messages[message_index].base_subject

    void .merge_subjects()
        map.Map<string, int[]> groups
        for int root = roots[]
            string subject = root_subject(root)
            if subject != ""
                .groups.set(subject, group_of(groups, subject).append(root))
        int[] result = []
        for int root = roots[]
            string subject = root_subject(root)
            if subject == "" or len(group_of(groups, subject)) == 1
                result = result.append(root)
        for string subject = groups.keys().sorted()[]
            int[] group = group_of(groups, subject)
            if len(group) < 2
                continue
            int target = -1
            int original = -1
            int originals = 0
            for int root = group[]
                int message_index = nodes[root].message
                if message_index < 0 and target < 0
                    target = root
                if message_index >= 0 and not messages[message_index].reply
                    original = root
                    originals += 1
            if target < 0 and originals == 1
                target = original
            if target < 0
                target = int(len(nodes))
                nodes = nodes.append(Container(""))
                nodes[target].subject = subject
                nodes[target].subject_container = true
            for int root = group[]
                if root == target
                    continue
                if nodes[root].message >= 0
                    .adopt(target, root)
                else
                    for int child = nodes[root].children[]
                        .adopt(target, child)
            nodes[target].parent = -1
            result = result.append(target)
        roots = result
