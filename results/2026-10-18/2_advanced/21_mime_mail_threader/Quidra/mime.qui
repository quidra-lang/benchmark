const string base64_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

string character(int code)
    string result = string.from_utf8(bin(nat8(code)))
    return result

int hex_value(string text)
    int code = text.codepoints()[0]
    return if 48 <= code <= 57 then code - 48 elif 65 <= code <= 70 then code - 55 elif 97 <= code <= 102 then code - 87 else -1

string trim_trailing(string text)
    int end = int(len(text))
    while end > 0 and (text[end - 1] == " " or text[end - 1] == HT)
        end -= 1
    return text[0:<end]

nat8[] | none strict_base64(string text)
    if len(text) % 4 != 0
        return none
    int end = int(len(text))
    while end > 0 and text[end - 1] == "="
        end -= 1
    if int(len(text)) - end >= 3
        return none
    nat8[] result = []
    int buffer = 0
    int bits = 0
    for int position < end
        int value = -1
        match base64_alphabet.find(text[position])
            nat found
                value = int(found)
            none
                return none
        buffer = buffer * 64 + value
        bits += 6
        if bits >= 8
            bits -= 8
            int scale = 2 ^ bits
            result = result.append(nat8(buffer / scale))
            buffer %= scale
    return result

string | none decode_base64_body(string text)
    string compact = text.split(" ").join("").split(HT).join("").split(NL).join("")
    nat8[] bytes = []
    match strict_base64(compact)
        nat8[] decoded
            bytes = decoded
        none
            return none
    nat8[] normalized = []
    int position = 0
    while position < int(len(bytes))
        if bytes[position] == 13 and position + 1 < int(len(bytes)) and bytes[position + 1] == 10
            normalized = normalized.append(10)
            position += 2
        else
            normalized = normalized.append(bytes[position])
            position += 1
    for nat8 code = normalized[]
        if code != 9 and code != 10 and not (32 <= code <= 126)
            return none
    string result = string.from_utf8(bin(normalized))
    return result

class Decoded(string text, bool failed)

Decoded decode_quoted_printable(string text)
    string[] lines = text.split(NL)
    string result = ""
    bool failed = false
    for int index < int(len(lines))
        string line = trim_trailing(lines[index])
        bool soft = line.ends_with("=")
        if soft
            line = line[0:<len(line) - 1]
        int position = 0
        while position < int(len(line))
            int decoded = -1
            if line[position] == "=" and position + 2 < int(len(line))
                int high = hex_value(line[position + 1])
                int low = hex_value(line[position + 2])
                if high >= 0 and low >= 0
                    int code = 16 * high + low
                    if code == 9 or (32 <= code <= 126)
                        decoded = code
            if decoded >= 0
                result += character(decoded)
                position += 3
            else
                if line[position] == "="
                    failed = true
                result += line[position]
                position += 1
        if not soft and index + 1 < int(len(lines))
            result += NL
    return Decoded(result, failed)
