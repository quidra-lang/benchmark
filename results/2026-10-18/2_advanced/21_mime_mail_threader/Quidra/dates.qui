import headers = "./headers.qui"

bool is_leap(int year)
    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0

int days_in_month(int year, int month)
    int[] lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    return if month == 2 and is_leap(year) then 29 else lengths[month - 1]

int days_in_year(int year)
    return if is_leap(year) then 366 else 365

int days_since_epoch(int year, int month, int day)
    int total = day - 1
    for 1970 <= int current < year
        total += days_in_year(current)
    for 1 <= int current < month
        total += days_in_month(year, current)
    return total

string format_utc(int seconds)
    int days = seconds / 86400
    int remainder = seconds % 86400
    int year = 1970
    while days >= days_in_year(year)
        days -= days_in_year(year)
        year += 1
    int month = 1
    while days >= days_in_month(year, month)
        days -= days_in_month(year, month)
        month += 1
    int day = days + 1
    int hour = remainder / 3600
    int minute = (remainder % 3600) / 60
    int second = remainder % 60
    return "{year:int=4,zero}-{month:int=2,zero}-{day:int=2,zero} {hour:int=2,zero}:{minute:int=2,zero}:{second:int=2,zero}"

bool has_digits(string text, int low, int high)
    if not (low <= int(len(text)) <= high)
        return false
    for int code = text.codepoints()[]
        if not (48 <= code <= 57)
            return false
    return true

int position_of(string value, string[] names)
    for int position < int(len(names))
        if value == names[position]
            return position
    return -1

int | error parse_date(string value)
    string stripped = ""
    match headers.remove_comments(value)
        string text
            stripped = text
        none
            return error("bad Date syntax")
    string[] tokens = headers.split_words(stripped.split(",").join(" , "))
    string[] weekdays = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
    string[] months = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    int weekday = -1
    if len(tokens) >= 3 and tokens[1] == ","
        weekday = position_of(headers.lowercase(tokens[0]), weekdays)
        if weekday >= 0
            tokens = tokens[2:<len(tokens)]
    if len(tokens) != 5
        return error("bad Date syntax")
    string[] pieces = tokens[3].split(":")
    int month = position_of(headers.lowercase(tokens[1]), months) + 1
    bool valid_year = has_digits(tokens[2], 2, 2) or has_digits(tokens[2], 4, 4)
    bool valid_time = len(pieces) == 2 or len(pieces) == 3
    for string piece = pieces[]
        valid_time = valid_time and has_digits(piece, 2, 2)
    string zone = headers.lowercase(tokens[4])
    string[] zone_names = ["ut", "gmt", "z", "est", "edt", "cst", "cdt", "mst", "mdt", "pst", "pdt"]
    int[] zone_offsets = [0, 0, 0, -300, -240, -360, -300, -420, -360, -480, -420]
    bool numeric_zone = len(zone) == 5 and (zone[0] == "+" or zone[0] == "-") and has_digits(zone[1:<len(zone)], 4, 4)
    int named_zone = position_of(zone, zone_names)
    if not has_digits(tokens[0], 1, 2) or month == 0 or not valid_year or not valid_time or (not numeric_zone and named_zone < 0)
        return error("bad Date syntax")
    int day = int.parse(tokens[0])
    int year = int.parse(tokens[2])
    if len(tokens[2]) == 2
        year += if year < 50 then 2000 else 1900
    int hour = int.parse(pieces[0])
    int minute = int.parse(pieces[1])
    int second = if len(pieces) == 3 then int.parse(pieces[2]) else 0
    int offset = 0
    if numeric_zone
        int zone_hour = int.parse(zone[1:<3])
        int zone_minute = int.parse(zone[3:<5])
        if zone_hour > 23 or zone_minute > 59
            return error("Date out of range")
        offset = zone_hour * 60 + zone_minute
        if zone[0] == "-"
            offset = -offset
    else
        offset = zone_offsets[named_zone]
    if year < 1970 or year > 2099 or day < 1 or day > days_in_month(year, month) or hour > 23 or minute > 59 or second > 59
        return error("Date out of range")
    int days = days_since_epoch(year, month, day)
    int seconds = days * 86400 + hour * 3600 + minute * 60 + second - offset * 60
    if seconds < 0
        return error("Date out of range")
    if weekday >= 0 and (days + 3) % 7 != weekday
        return error("Date weekday mismatch")
    return seconds
