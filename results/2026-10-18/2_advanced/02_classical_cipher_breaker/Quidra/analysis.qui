import scoring = "./scoring.qui"

int[] letter_counts(string text)
    int[] counts = array(26, fill = 0)
    for nat index < len(text)
        counts[scoring.letter_value(text[index])] += 1
    return counts

int coincidence(string text)
    int total = 0
    for int count = letter_counts(text)[]
        total += count * (count - 1)
    int count = int(len(text))
    return 100000 * total / (count * (count - 1))

string[] columns(string text, int period)
    string[] result = array(nat(period), fill = "")
    for nat index < len(text)
        result[int(index) % period] += text[index]
    return result

int[] column_indices(string text, int period)
    int[] result = []
    for string column = columns(text, period)[]
        result = result.append(coincidence(column))
    return result

int gcd(int left, int right)
    while right != 0
        int rest = left % right
        left = right
        right = rest
    return left

class Repeat(string text, int[] positions, int[] gaps, int divisor)

Repeat[] repeated_trigrams(string text)
    map.Map<string, int[]> positions
    for 0 <= int index < int(len(text)) - 2
        string trigram = text[index:<index + 3]
        int[] found = []
        match positions.get(trigram)
            int[] previous
                found = previous
            none
                found = []
        .positions.set(trigram, found.append(index + 1))
    Repeat[] result = []
    for string trigram = positions.keys().sorted()[]
        match positions.get(trigram)
            int[] found
                if len(found) > 1
                    int[] gaps = []
                    int divisor = 0
                    for 1 <= int index < int(len(found))
                        int gap = found[index] - found[index - 1]
                        gaps = gaps.append(gap)
                        divisor = gcd(divisor, gap)
                    result = result.append(Repeat(trigram, found, gaps, divisor))
            none
                continue
    return result

string percentage(int count, int total)
    int tenths = (2000 * count + total) / (2 * total)
    return "{tenths / 10}.{tenths % 10}"

int[] pair_counts(string text, int stride)
    int[] counts = array(676, fill = 0)
    for 0 <= int index < int(len(text)) - 1 step stride
        counts[26 * scoring.letter_value(text[index]) + scoring.letter_value(text[index + 1])] += 1
    return counts

int distinct(int[] counts)
    int result = 0
    for int count = counts[]
        if count > 0
            result += 1
    return result

string top_pairs(int[] counts)
    int[] ordered = counts.sorted(descending = true)
    string[] result = []
    int previous = -1
    for int count = ordered[]
        if count == 0 or len(result) == 10
            break
        if count == previous
            continue
        previous = count
        for 0 <= int index < 676
            if counts[index] == count and len(result) < 10
                result = result.append(scoring.alphabet[index / 26] + scoring.alphabet[index % 26] + ":" + count.string())
    return result.join(" ")
