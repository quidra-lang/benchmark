const string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const string lowercase = "abcdefghijklmnopqrstuvwxyz"

int letter_value(string character)
    for 0 <= int index < 26
        if character == alphabet[index] or character == lowercase[index]
            return index
    return -1

string uppercase(string text)
    string result = ""
    for nat index < len(text)
        int value = letter_value(text[index])
        result += if value < 0 then text[index] else alphabet[value]
    return result

string letter_string(string text)
    string result = ""
    for nat index < len(text)
        int value = letter_value(text[index])
        if value >= 0
            result += alphabet[value]
    return result

class Weights(int[] monograms, int[][] bigrams)
    int monogram(string text)
        int total = 0
        for nat index < len(text)
            total += monograms[letter_value(text[index])]
        return total

    int bigram(string text)
        int total = 0
        for 1 <= int index < int(len(text))
            total += bigrams[letter_value(text[index - 1])][letter_value(text[index])]
        return total

Weights read_weights()
    string source = file.read("input/weights.txt")
    string[] lines = source.split(NL)
    int[] monograms = []
    for string word = lines[1].split(" ")[]
        monograms = monograms.append(int.parse(word))
    int[][] bigrams = []
    for 3 <= int row < 29
        int[] values = []
        for string word = lines[row].split(" ")[]
            values = values.append(int.parse(word))
        bigrams = bigrams.append(values)
    return Weights(monograms, bigrams)
