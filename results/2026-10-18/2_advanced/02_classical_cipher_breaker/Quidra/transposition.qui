int rail_number(int position, int rails)
    int cycle = 2 * rails - 2
    int offset = position % cycle
    return if offset < cycle - offset then offset else cycle - offset

string rail_fence(string text, int rails, bool decrypt)
    string[] result = array(len(text), fill = "")
    int cursor = 0
    for int rail < rails
        for int position < int(len(text))
            if rail_number(position, rails) == rail
                if decrypt
                    result[position] = text[cursor]
                else
                    result[cursor] = text[position]
                cursor += 1
    return result.join("")

int[] column_order(string key)
    string[] labels = []
    for nat index < len(key)
        labels = labels.append(key[index] + index.string())
    string[] ordered = labels.sorted()
    int[] result = []
    for string label = ordered[]
        result = result.append(int.parse(label[1]))
    return result

string rank_string(string key)
    int[] ranks = array(len(key), fill = 0)
    int[] order = column_order(key)
    for nat index < len(order)
        ranks[order[index]] = int(index) + 1
    string result = ""
    for int rank = ranks[]
        result += rank.string()
    return result

string columnar(string text, string key, bool decrypt)
    int width = int(len(key))
    string[] result = array(len(text), fill = "")
    int cursor = 0
    for int column = column_order(key)[]
        for column <= int position < int(len(text)) step width
            if decrypt
                result[position] = text[cursor]
            else
                result[cursor] = text[position]
            cursor += 1
    return result.join("")
