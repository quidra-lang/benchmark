import scoring = "./scoring.qui"

string replace_j(string text)
    string result = ""
    for nat index < len(text)
        result += if text[index] == "J" then "I" else text[index]
    return result

string square(string key)
    string source = replace_j(key) + "ABCDEFGHIKLMNOPQRSTUVWXYZ"
    string result = ""
    for nat index < len(source)
        if not result.contains(source[index])
            result += source[index]
    return result

bool valid(string text)
    string normalized = replace_j(text)
    if len(normalized) % 2 != 0
        return false
    for 0 <= int index < int(len(normalized)) step 2
        if normalized[index] == normalized[index + 1]
            return false
    return true

string prepare(string text)
    string normalized = replace_j(text)
    string result = ""
    int position = 0
    while position < int(len(normalized))
        string first = normalized[position]
        if position + 1 < int(len(normalized)) and normalized[position + 1] != first
            result += first + normalized[position + 1]
            position += 2
        else
            result += first + (if first == "X" then "Q" else "X")
            position += 1
    return result

string transform(string text, string key, bool decrypt)
    string grid = square(key)
    int[] positions = array(26, fill = 0)
    for 0 <= int index < 25
        positions[scoring.letter_value(grid[index])] = index
    string source = if decrypt then replace_j(text) else prepare(text)
    string result = ""
    int direction = if decrypt then 4 else 1
    for 0 <= int index < int(len(source)) step 2
        int left = positions[scoring.letter_value(source[index])]
        int right = positions[scoring.letter_value(source[index + 1])]
        int left_row = left / 5
        int right_row = right / 5
        int left_column = left % 5
        int right_column = right % 5
        if left_row == right_row
            left_column = (left_column + direction) % 5
            right_column = (right_column + direction) % 5
        elif left_column == right_column
            left_row = (left_row + direction) % 5
            right_row = (right_row + direction) % 5
        else
            int saved = left_column
            left_column = right_column
            right_column = saved
        result += grid[left_row * 5 + left_column] + grid[right_row * 5 + right_column]
    return result
