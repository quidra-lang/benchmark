import scoring = "./scoring.qui"

int modulo(int value)
    int result = value % 26
    return if result < 0 then result + 26 else result

int inverse(int multiplier)
    for 1 <= int value < 26
        if multiplier * value % 26 == 1
            return value
    return 1

string transform(string text, string cipher, string key, bool decrypt)
    int shift = 0
    int multiplier = 1
    if cipher == "caesar"
        shift = int.parse(key)
    elif cipher == "affine"
        string[] parts = key.split(",")
        multiplier = int.parse(parts[0])
        shift = int.parse(parts[1])
    int[] plain = []
    string result = ""
    for nat position < len(text)
        string character = text[position]
        int value = scoring.letter_value(character)
        if value < 0
            result += character
            continue
        if cipher == "vigenere"
            shift = scoring.letter_value(key[len(plain) % len(key)])
        elif cipher == "autokey"
            shift = if len(plain) < len(key) then scoring.letter_value(key[len(plain)]) else plain[len(plain) - len(key)]
        int transformed = modulo(if decrypt then inverse(multiplier) * (value - shift) else multiplier * value + shift)
        plain = plain.append(if decrypt then transformed else value)
        result += if scoring.alphabet.contains(character) then scoring.alphabet[transformed] else scoring.lowercase[transformed]
    return result
