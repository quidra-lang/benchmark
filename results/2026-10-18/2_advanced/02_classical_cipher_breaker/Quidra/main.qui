import scoring = "./scoring.qui"
import substitution = "./substitution.qui"
import transposition = "./transposition.qui"
import playfair = "./playfair.qui"
import analysis = "./analysis.qui"

string[] commands()
    return ["ENCRYPT", "DECRYPT", "BREAK", "ANALYZE", "COMPARE", "IDENTIFY"]

int position_of(string[] values, string word)
    for nat index < len(values)
        if values[index] == word
            return int(index)
    return -1

bool naming_command(string command)
    return command == "ENCRYPT" or command == "DECRYPT" or command == "BREAK"

bool substitution_cipher(string cipher)
    return position_of(["caesar", "affine", "vigenere", "autokey"], cipher) >= 0

bool valid_name(string text)
    if len(text) < 1 or len(text) > 16
        return false
    for nat index < len(text)
        if not "abcdefghijklmnopqrstuvwxyz0123456789_".contains(text[index])
            return false
    return true

bool digits(string text, int maximum)
    if len(text) == 0 or int(len(text)) > maximum
        return false
    for nat index < len(text)
        if not "0123456789".contains(text[index])
            return false
    return true

bool affine_multiplier(int value)
    return value >= 1 and value < 26 and value % 2 == 1 and value != 13

string | error parse_key(string cipher, string word)
    if cipher == "caesar" or cipher == "railfence"
        if digits(word, 2)
            int value = int.parse(word)
            int low = if cipher == "caesar" then 0 else 2
            int high = if cipher == "caesar" then 25 else 20
            if low <= value <= high
                return value.string()
    elif cipher == "affine"
        string[] parts = word.split(",")
        if len(parts) == 2 and digits(parts[0], 2) and digits(parts[1], 2)
            int multiplier = int.parse(parts[0])
            int offset = int.parse(parts[1])
            if affine_multiplier(multiplier) and offset <= 25
                return "{multiplier},{offset}"
    elif cipher == "columnar"
        bool accepted = 2 <= len(word) <= 9
        for nat index < len(word)
            if scoring.letter_value(word[index]) < 0 and not "0123456789".contains(word[index])
                accepted = false
        if accepted
            return scoring.uppercase(word)
    else
        int limit = if cipher == "playfair" then 25 else 20
        if 1 <= int(len(word)) <= limit and len(scoring.letter_string(word)) == len(word)
            string result = scoring.uppercase(word)
            return if cipher == "playfair" then playfair.replace_j(result) else result
    return error("bad key {word}")

class Options(int top = 5, int max_length = 10, int ioc = 6000, int kasiski = 60, int refine = 5, int max_rails = 10, string keys = "")

Options defaults(string cipher)
    Options result = Options()
    if cipher == "autokey"
        result.max_length = 8
    elif cipher == "columnar"
        result.max_length = 6
    return result

Options | error parse_options(string command, string cipher, string[] words)
    Options result = defaults(cipher)
    string[] allowed = []
    if command == "BREAK"
        allowed = ["TOP"]
        if cipher == "vigenere"
            allowed = allowed.concat(["MAXLEN", "IOC", "KASISKI", "REFINE"])
        elif cipher == "autokey" or cipher == "columnar"
            allowed = allowed.append("MAXLEN")
        elif cipher == "railfence"
            allowed = allowed.append("MAXRAILS")
        elif cipher == "playfair"
            allowed = allowed.append("KEYS")
    elif command == "ANALYZE"
        allowed = ["MAXLEN"]
    elif command == "IDENTIFY"
        allowed = ["KEYS"]
    string[] seen = []
    for string word = words[]
        string[] pieces = word.split("=")
        if len(pieces) != 2 or position_of(allowed, pieces[0]) < 0 or position_of(seen, pieces[0]) >= 0
            return error("bad option {word}")
        string name = pieces[0]
        string text = pieces[1]
        seen = seen.append(name)
        if name == "KEYS"
            if not valid_name(text)
                return error("bad option {word}")
            result.keys = text
            continue
        if not digits(text, 6)
            return error("bad option {word}")
        int value = int.parse(text)
        int low = 1
        int high = 20
        if name == "MAXLEN"
            low = if cipher == "autokey" then 1 else 2
            high = if cipher == "columnar" then 6 else 20
        elif name == "MAXRAILS"
            low = 2
        elif name == "IOC"
            high = 100000
        elif name == "KASISKI"
            high = 100
        elif name == "REFINE"
            low = 0
            high = 10
        if value < low or value > high
            return error("bad option {word}")
        if name == "TOP"
            result.top = value
        elif name == "MAXLEN"
            result.max_length = value
        elif name == "MAXRAILS"
            result.max_rails = value
        elif name == "IOC"
            result.ioc = value
        elif name == "KASISKI"
            result.kasiski = value
        elif name == "REFINE"
            result.refine = value
    if command == "BREAK" and cipher == "playfair" and result.keys == ""
        return error("missing option KEYS")
    return result

class Job(string command, string cipher = "", string key = "", string source = "", string other = "", string new_name = "", Options options = Options())

Job | error parse_job(string[] words, map.Map<string, string[]> messages)
    Job result = Job(words[0])
    if position_of(commands(), result.command) < 0
        return error("unknown command")
    int count = int(len(words))
    if naming_command(result.command) and count >= 5 and words[count - 2] == "AS"
        result.new_name = words[count - 1]
        if not valid_name(result.new_name)
            return error("bad syntax")
        words = words[0:<count - 2]
        count -= 2
    if result.command == "ENCRYPT" or result.command == "DECRYPT"
        if count != 4
            return error("bad syntax")
    elif result.command == "BREAK"
        if count < 3
            return error("bad syntax")
    elif result.command == "COMPARE"
        if count != 3
            return error("bad syntax")
    elif count < 2 or count > 3
        return error("bad syntax")
    if naming_command(result.command)
        result.cipher = words[1]
        if position_of(["caesar", "affine", "vigenere", "autokey", "playfair", "railfence", "columnar"], result.cipher) < 0
            return error("unknown cipher {result.cipher}")
        if result.command != "BREAK"
            result.key = try parse_key(result.cipher, words[2])
            result.source = words[3]
        else
            result.source = words[2]
            result.options = try parse_options(result.command, result.cipher, words[3:<count])
    else
        result.source = words[1]
        if result.command == "COMPARE"
            result.other = words[2]
        else
            result.options = try parse_options(result.command, "", words[2:<count])
    if not messages.has(result.source)
        return error("unknown message {result.source}")
    string second = if result.command == "COMPARE" then result.other else result.options.keys
    if second != "" and not messages.has(second)
        return error("unknown message {second}")
    if result.new_name != "" and messages.has(result.new_name)
        return error("duplicate message {result.new_name}")
    return result

string transform(string cipher, string text, string key, bool decrypt)
    if substitution_cipher(cipher)
        return substitution.transform(text, cipher, key, decrypt)
    if cipher == "railfence"
        return transposition.rail_fence(text, int.parse(key), decrypt)
    if cipher == "columnar"
        return transposition.columnar(text, key, decrypt)
    return playfair.transform(text, key, decrypt)

string[] group_form(string text)
    string[] groups = []
    for 0 <= int start < int(len(text)) step 5
        int finish = if start + 5 < int(len(text)) then start + 5 else int(len(text))
        groups = groups.append(text[start:<finish])
    string[] lines = []
    for 0 <= int start < int(len(groups)) step 10
        int finish = if start + 10 < int(len(groups)) then start + 10 else int(len(groups))
        lines = lines.append(groups[start:<finish].join(" "))
    return lines

string[] solution(string cipher, string key, string text, string letters)
    if substitution_cipher(cipher)
        return transform(cipher, text, key, true).split(NL)
    return group_form(transform(cipher, letters, key, true))

string[] key_list(string text)
    string[] result = []
    string word = ""
    for nat index < len(text)
        int value = scoring.letter_value(text[index])
        if value >= 0
            word += if value == 9 then "I" else scoring.alphabet[value]
        elif word != ""
            if position_of(result, word) < 0
                result = result.append(word)
            word = ""
    if word != "" and position_of(result, word) < 0
        result = result.append(word)
    return result

string numbers(int[] values)
    string[] parts = []
    for int value = values[]
        parts = parts.append(value.string())
    return parts.join(",")

class Profile(int[] averages = [], int[] kasiski = [], int[][] columns = [], analysis.Repeat[] repeats = [], int spacings = 0)
    string[] lines()
        string[] result = []
        for nat index < len(averages)
            result = result.append("L={index + 1} ioc={averages[index]} kasiski={kasiski[index]} cols={numbers(columns[index])}")
        result = result.append("kasiski repeats={len(repeats)} spacings={spacings}")
        for analysis.Repeat repeated = repeats[]
            result = result.append("{repeated.text} at={numbers(repeated.positions)} gaps={numbers(repeated.gaps)} gcd={repeated.divisor}")
        return result

Profile profile(string letters, int maximum)
    Profile result = Profile()
    result.repeats = analysis.repeated_trigrams(letters)
    int[] gaps = []
    for analysis.Repeat repeated = result.repeats[]
        gaps = gaps.concat(repeated.gaps)
    result.spacings = int(len(gaps))
    for 1 <= int period <= maximum
        int[] indices = analysis.column_indices(letters, period)
        int total = 0
        for int value = indices[]
            total += value
        int hits = 0
        for int gap = gaps[]
            if gap % period == 0
                hits += 1
        result.averages = result.averages.append(total / period)
        result.kasiski = result.kasiski.append(hits)
        result.columns = result.columns.append(indices)
    return result

string[] permutations(string remaining, string prefix = "")
    if len(remaining) == 0
        return [prefix]
    string[] result = []
    for nat index < len(remaining)
        string rest = remaining[0:<index] + remaining[index + 1:<len(remaining)]
        result = result.concat(permutations(rest, prefix + remaining[index]))
    return result

string column_key(string cipher, string letters, int width, scoring.Weights weights)
    string result = ""
    for string column = analysis.columns(letters, width)[]
        int best_score = -1
        int chosen = 0
        for int shift < 26
            int total = 0
            int previous = shift
            for nat index < len(column)
                int value = scoring.letter_value(column[index])
                int plain = substitution.modulo(value - (if cipher == "autokey" then previous else shift))
                total += weights.monograms[plain]
                previous = plain
            if total > best_score
                best_score = total
                chosen = shift
        result += scoring.alphabet[chosen]
    return result

class Candidate(string key, string plaintext, int score)

class BreakResult(string cipher, string key = "", int score = 0, Candidate[] candidates = [], Profile statistics = Profile(), int length = 0, string method = "", int passes = 0, int changes = 0)

BreakResult break_cipher(string cipher, string letters, Options options, string[] playfair_keys, scoring.Weights weights)
    string[] keys = []
    if cipher == "caesar"
        for int shift < 26
            keys = keys.append(shift.string())
    elif cipher == "affine"
        for 1 <= int multiplier < 26 step 2
            if multiplier != 13
                for int shift < 26
                    keys = keys.append("{multiplier},{shift}")
    elif cipher == "railfence"
        for 2 <= int rails <= options.max_rails
            keys = keys.append(rails.string())
    elif cipher == "columnar"
        for 2 <= int width <= options.max_length
            keys = keys.concat(permutations("123456"[0:<width]))
    elif cipher == "playfair"
        keys = playfair_keys
    else
        for 1 <= int width <= options.max_length
            keys = keys.append(column_key(cipher, letters, width, weights))
    Candidate[] candidates = []
    for string key = keys[]
        string plaintext = transform(cipher, letters, key, true)
        int score = if cipher == "caesar" or cipher == "affine" then weights.monogram(plaintext) else weights.bigram(plaintext)
        candidates = candidates.append(Candidate(key, plaintext, score))
    Candidate[] ranked = candidates
    for 1 <= int offset < int(len(ranked))
        Candidate current = ranked[offset]
        int cursor = offset
        while cursor > 0 and ranked[cursor - 1].score < current.score
            ranked[cursor] = ranked[cursor - 1]
            cursor -= 1
        ranked[cursor] = current
    BreakResult result = BreakResult(cipher, ranked[0].key, ranked[0].score, ranked)
    if cipher != "vigenere"
        return result
    result.statistics = profile(letters, options.max_length)
    int kasiski_length = 0
    if result.statistics.spacings > 0
        for 2 <= int width <= options.max_length
            if 100 * result.statistics.kasiski[width - 1] >= options.kasiski * result.statistics.spacings
                kasiski_length = width
    if kasiski_length > 0 and result.statistics.averages[kasiski_length - 1] >= options.ioc
        result.length = kasiski_length
        result.method = "kasiski"
    else
        for nat index < len(result.statistics.averages)
            if result.statistics.averages[index] >= options.ioc
                result.length = int(index) + 1
                result.method = "ioc"
                break
        if result.length == 0
            int best = -1
            for nat index < len(result.statistics.averages)
                if result.statistics.averages[index] > best
                    best = result.statistics.averages[index]
                    result.length = int(index) + 1
            result.method = "maxioc"
    result.key = candidates[result.length - 1].key
    result.score = candidates[result.length - 1].score
    while result.passes < options.refine
        result.passes += 1
        int changes = 0
        for int index < result.length
            int best = result.score
            string chosen = result.key
            for int shift < 26
                string candidate = result.key[0:<index] + scoring.alphabet[shift] + result.key[index + 1:<len(result.key)]
                int score = weights.bigram(transform(cipher, letters, candidate, true))
                if score > best
                    best = score
                    chosen = candidate
            if best > result.score
                result.key = chosen
                result.score = best
                changes += 1
        result.changes += changes
        if changes == 0
            break
    return result

map.Map<string, string[]> read_messages()
    map.Map<string, string[]> result
    string source = file.read("input/messages.txt")
    string name = ""
    string[] body = []
    for string line = source.split(NL)[]
        if name == ""
            if line.starts_with("MESSAGE ")
                name = line[8:<len(line)]
                body = []
        elif line == "END"
            .result.set(name, body)
            name = ""
        else
            body = body.append(line)
    return result

string message_text(map.Map<string, string[]> messages, string name)
    match messages.get(name)
        string[] lines
            return lines.join(NL)
        none
            return ""

string suffix(string new_name)
    return if new_name == "" then "" else " as=" + new_name

class Desk(scoring.Weights weights, map.Map<string, string[]> messages)
    int jobs = 0
    int[] ok = array(6, fill = 0)
    int[] errors = array(6, fill = 0)
    string[] results = []
    string[] candidates = []
    string[] reports = []

    void .output(string header, string[] lines, string new_name = "")
        results = results.append(header).concat(lines)
        if new_name != ""
            .messages.set(new_name, lines)

    void .break_report(int number, Job job, string letters, BreakResult broken)
        int margin = 0
        if len(broken.candidates) > 1
            margin = broken.candidates[0].score - broken.candidates[1].score
        candidates = candidates.append("JOB {number} BREAK {job.cipher} source={job.source} tried={len(broken.candidates)} margin={margin}")
        for int index < job.options.top
            if index == int(len(broken.candidates))
                break
            Candidate candidate = broken.candidates[index]
            candidates = candidates.append("{index + 1} {candidate.key} {candidate.score} {candidate.plaintext[0:<40]}")
        if job.cipher == "vigenere"
            reports = reports.concat(["JOB {number} BREAK vigenere source={job.source}", "letters={len(letters)}"])
            reports = reports.concat(broken.statistics.lines())
            reports = reports.append("decision length={broken.length} method={broken.method}")
            reports = reports.append("refine passes={broken.passes} changes={broken.changes} key={broken.key}")
        elif job.cipher == "playfair"
            int[] pair_counts = analysis.pair_counts(playfair.replace_j(letters), 2)
            string grid = playfair.square(broken.key)
            string[] rows = []
            for 0 <= int start < 25 step 5
                rows = rows.append(grid[start:<start + 5])
            reports = reports.concat(["JOB {number} BREAK playfair source={job.source}", "letters={len(letters)}", "digraphs pairs={len(letters) / 2} distinct={analysis.distinct(pair_counts)}", "top " + analysis.top_pairs(pair_counts), "square " + rows.join(" ")])

    void .analyze(int number, Job job, string letters)
        int count = int(len(letters))
        int[] counts = analysis.letter_counts(letters)
        int doubles = 0
        int pair_doubles = 0
        for int index < count - 1
            if letters[index] == letters[index + 1]
                doubles += 1
                if index % 2 == 0
                    pair_doubles += 1
        results = results.append("JOB {number} ANALYZE source={job.source} letters={count}")
        reports = reports.concat(["JOB {number} ANALYZE source={job.source}", "letters={count}", "ioc={analysis.coincidence(letters)} mono={weights.monogram(letters)} bigram={weights.bigram(letters)}", "doubles={doubles} pair_doubles={pair_doubles} distinct={analysis.distinct(counts)}"])
        for int index < 26
            reports = reports.append("{scoring.alphabet[index]} {counts[index]} {analysis.percentage(counts[index], count)}")
        reports = reports.append("bigrams " + analysis.top_pairs(analysis.pair_counts(letters, 1)))
        Profile statistics = profile(letters, job.options.max_length)
        reports = reports.concat(statistics.lines())

    void .compare(int number, Job job, string letters)
        string other = scoring.letter_string(message_text(messages, job.other))
        string header = "JOB {number} COMPARE {job.source} {job.other}"
        if letters == other
            results = results.append(header + " equal letters={len(letters)}")
            return
        int shared = if len(letters) < len(other) then int(len(letters)) else int(len(other))
        int first = shared + 1
        int mismatches = 0
        for int index < shared
            if letters[index] != other[index]
                if mismatches == 0
                    first = index + 1
                mismatches += 1
        results = results.append(header + " differ letters={len(letters)},{len(other)} first={first} mismatches={mismatches}")

    void | error .identify(int number, Job job, string text, string letters, string[] playfair_keys)
        int count = int(len(letters))
        int coincidence = analysis.coincidence(letters)
        int average = weights.monogram(letters) / count
        bool shaped = len(letters) % 2 == 0 and not letters.contains("J") and playfair.valid(letters)
        string family = if shaped then "playfair" elif coincidence >= 5500 and average >= 44 then "transposition" elif coincidence >= 5500 then "monoalphabetic" else "polyalphabetic"
        if family == "playfair" and job.options.keys != "" and len(playfair_keys) == 0
            return error("empty key list")
        string[] ciphers = []
        if family == "playfair"
            if job.options.keys != ""
                ciphers = ["playfair"]
        elif family == "transposition"
            ciphers = ["railfence", "columnar"]
        elif family == "monoalphabetic"
            ciphers = ["affine"]
        else
            ciphers = ["vigenere", "autokey"]
        reports = reports.concat(["JOB {number} IDENTIFY source={job.source}", "letters={count} ioc={coincidence} mono_avg={average} distinct={analysis.distinct(analysis.letter_counts(letters))} shape={if shaped then "yes" else "no"}", "family={family}"])
        string header = "JOB {number} IDENTIFY source={job.source} family={family}"
        if len(ciphers) == 0
            results = results.append(header)
            return
        BreakResult chosen = BreakResult("")
        bool first = true
        for string cipher = ciphers[]
            BreakResult broken = break_cipher(cipher, letters, defaults(cipher), playfair_keys, weights)
            reports = reports.append("try {cipher} key={broken.key} score={broken.score}")
            if first or broken.score > chosen.score
                chosen = broken
                first = false
        if chosen.cipher == "affine" and chosen.key.starts_with("1,")
            chosen.cipher = "caesar"
            chosen.key = chosen.key[2:<len(chosen.key)]
        string[] lines = solution(chosen.cipher, chosen.key, text, letters)
        .output(header + " cipher={chosen.cipher} key={chosen.key} score={chosen.score} lines={len(lines)}", lines)
        reports = reports.append("choice {chosen.cipher}")

    void | error .execute(int number, Job job)
        string text = message_text(messages, job.source)
        string letters = scoring.letter_string(text)
        if job.command == "COMPARE"
            .compare(number, job, letters)
            return
        if job.command == "ENCRYPT" or job.command == "DECRYPT"
            if len(letters) == 0
                return error("no letters")
            bool decrypt = job.command == "DECRYPT"
            if decrypt and job.cipher == "playfair" and not playfair.valid(letters)
                return error("bad playfair text")
            string transformed = transform(job.cipher, if substitution_cipher(job.cipher) then text else letters, job.key, decrypt)
            string[] lines = if substitution_cipher(job.cipher) then transformed.split(NL) else group_form(transformed)
            int count = int(len(scoring.letter_string(transformed)))
            .output("JOB {number} {job.command} {job.cipher} key={job.key} source={job.source} letters={count} lines={len(lines)}{suffix(job.new_name)}", lines, job.new_name)
            return
        if len(letters) < 40
            return error("text too short")
        string[] playfair_keys = []
        if job.options.keys != ""
            playfair_keys = key_list(message_text(messages, job.options.keys))
        if job.command == "BREAK"
            if job.cipher == "playfair"
                if not playfair.valid(letters)
                    return error("bad playfair text")
                if len(playfair_keys) == 0
                    return error("empty key list")
            BreakResult broken = break_cipher(job.cipher, letters, job.options, playfair_keys, weights)
            string[] lines = solution(job.cipher, broken.key, text, letters)
            .output("JOB {number} BREAK {job.cipher} source={job.source} key={broken.key} score={broken.score} lines={len(lines)}{suffix(job.new_name)}", lines, job.new_name)
            .break_report(number, job, letters, broken)
        elif job.command == "ANALYZE"
            .analyze(number, job, letters)
        else
            try .identify(number, job, text, letters, playfair_keys)

    void .run(string line)
        jobs += 1
        string[] words = line.split(" ")
        int command = position_of(commands(), words[0])
        string failure = ""
        match parse_job(words, messages)
            Job job
                match .execute(jobs, job)
                    void
                        ok[command] += 1
                    error problem
                        failure = problem.message
            error problem
                failure = problem.message
        if failure != ""
            results = results.append("JOB {jobs} ERROR {failure}")
            if command >= 0
                errors[command] += 1

    void .finish()
        int successes = 0
        string[] names = commands()
        for nat index < len(names)
            results = results.append("TOTAL {names[index]} ok={ok[index]} errors={errors[index]}")
            successes += ok[index]
        results = results.append("SUMMARY jobs={jobs} ok={successes} errors={jobs - successes} messages={messages.size()}")

void write_lines(string path, string[] lines)
    file.write(path, if len(lines) == 0 then "" else lines.join(NL) + NL)

if main
    Desk desk = Desk(scoring.read_weights(), read_messages())
    string jobs_text = file.read("input/jobs.txt")
    for string line = jobs_text.split(NL)[]
        if line != "" and not line.starts_with("#")
            .desk.run(line)
    .desk.finish()
    if not file.is_directory("output")
        file.mkdir("output")
    write_lines("output/results.txt", desk.results)
    write_lines("output/candidates.txt", desk.candidates)
    write_lines("output/analysis.txt", desk.reports)
