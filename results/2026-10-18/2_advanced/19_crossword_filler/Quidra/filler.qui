import slots = "./slots.qui"
import words = "./word_index.qui"

class GridState(string[] letters, int[] assigned, bool[] used)
    string pattern(slots.Slot slot)
        return [for int position = slot.cells[] then letters[position]].join("")

    int[] .assign(slots.Slot slot, int id, string word)
        int[] changed = []
        for int index < slot.length
            int position = slot.cells[index]
            if letters[position] == "."
                letters[position] = word[index]
                changed = changed.append(position)
        assigned[slot.index] = id
        used[id] = true
        return changed

    void .unassign(slots.Slot slot, int[] changed)
        for int position = changed[]
            letters[position] = "."
        used[assigned[slot.index]] = false
        assigned[slot.index] = -1

class Attempt(slots.Layout layout, words.WordIndex index, local GridState initial, int min_score, int budget)
    GridState state = initial
    GridState best = initial
    int nodes = 0
    int backtracks = 0
    int prunes = 0
    int dead_ends = 0
    int[] sequence = []
    int max_depth = 0
    int[] failures = array(len(layout.entries), fill = 0)
    string[] trace = []
    string outcome = "unfillable"

    int[] candidates(slots.Slot slot)
        return index.candidates(state.pattern(slot), min_score, state.used)

    (int, int[]) choose_slot()
        int chosen = -1
        int[] choices = []
        for slots.Slot slot = layout.entries[]
            if state.assigned[slot.index] >= 0
                continue
            int[] available = candidates(slot)
            if chosen < 0 or len(available) < len(choices)
                chosen = slot.index
                choices = available
        return (chosen, choices)

    int wiped_out_slot(slots.Slot slot)
        for int crossing = slot.crossings[]
            if state.assigned[crossing] < 0 and len(candidates(layout.entries[crossing])) == 0
                return crossing
        return -1

    string .search()
        (int chosen, int[] choices) = choose_slot()
        if chosen < 0
            return "complete"
        slots.Slot slot = layout.entries[chosen]
        if len(choices) == 0
            dead_ends += 1
            failures[chosen] += 1
            return "fail"
        for int id = choices[]
            if nodes == budget
                return "abort"
            nodes += 1
            int[] changed = .state.assign(slot, id, index.ranked[id].word)
            sequence = sequence.append(chosen)
            int wiped = wiped_out_slot(slot)
            if nodes <= 10
                string mark = if wiped >= 0 then "!" else ""
                trace = trace.append("{slot.label}={index.ranked[id].word}{mark}")
            string result = "fail"
            if wiped >= 0
                prunes += 1
                failures[wiped] += 1
            else
                if int(len(sequence)) > max_depth
                    max_depth = int(len(sequence))
                    best = state
                result = .search()
            if result != "fail"
                return result
            .state.unassign(slot, changed)
            sequence = sequence[0:<len(sequence) - 1]
            backtracks += 1
        return "fail"

    void .run()
        string result = .search()
        outcome = if result == "complete" then "filled" elif result == "abort" then "budget" else "unfillable"

    GridState final_state()
        return if outcome == "filled" then state else best
