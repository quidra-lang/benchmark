import math
import grid = "./grid.qui"
import slots = "./slots.qui"
import words = "./word_index.qui"
import filler = "./filler.qui"
import render = "./render.qui"

const string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

class Settings(int node_budget, int min_score, string symmetry, int relax_step, int weak_score)
class Block(string name, string[] options, string[] rows)
class Issue(int line, string reason)
class Duplicate(int line, string word, int first)
class InvalidTemplate(string name, string reason)

string[] read_lines(string name)
    string[] lines = file.read("input/" + name).split(NL)
    return lines[0:<len(lines) - 1]

bool ignored(string line)
    return line == "" or line[0] == "#"

bool contains_name(string[] names, string target)
    for string name = names[]
        if name == target
            return true
    return false

bool valid_name(string name)
    if not (1 <= len(name) <= 20)
        return false
    for int code = name.codepoints()[]
        if not ((97 <= code <= 122) or (48 <= code <= 57) or code == 95)
            return false
    return true

bool valid_row(string row, int width)
    if not (3 <= len(row) <= 15) or int(len(row)) != width
        return false
    for int code = row.codepoints()[]
        if code != 46 and code != 35 and not (65 <= code <= 90)
            return false
    return true

string joined(string[] values, string separator)
    return if len(values) == 0 then "-" else values.join(separator)

Settings read_settings()
    map.Map<string, string> values
    for string line = read_lines("params.txt")[]
        if not ignored(line)
            string[] parts = line.split(" ")
            .values.set(parts[0], parts[1])
    string[] keys = ["node_budget", "min_score", "symmetry", "relax_step", "weak_score"]
    string[] parsed = []
    for string key = keys[]
        match values.get(key)
            string value
                parsed = parsed.append(value)
            none
                void
    return Settings(int.parse(parsed[0]), int.parse(parsed[1]), parsed[2], int.parse(parsed[3]), int.parse(parsed[4]))

Block[] read_blocks()
    Block[] blocks = []
    bool inside = false
    Block current = Block("", [], [])
    for string line = read_lines("templates.txt")[]
        if not inside
            if len(line) >= 9 and line[0:<9] == "TEMPLATE "
                current = Block(line[9:<len(line)], [], [])
                inside = true
        elif line == "END"
            blocks = blocks.append(current)
            inside = false
        elif len(line.split(" ")) > 1
            current.options = current.options.append(line)
        else
            current.rows = current.rows.append(line)
    return blocks

class WordList(local string[] source_lines)
    int line_count = int(len(source_lines))
    map.Map<string, int> scores
    map.Map<string, int> first_lines
    Issue[] invalid = []
    Duplicate[] duplicates = []
    for int position < line_count
        local string line = source_lines[position]
        match words.word_line_error(line)
            string reason
                invalid = invalid.append(Issue(position + 1, reason))
                continue
            none
                void
        local string[] parts = line.split(" ")
        local string word = parts[0]
        match first_lines.get(word)
            int first
                duplicates = duplicates.append(Duplicate(position + 1, word, first))
            none
                .scores.set(word, int.parse(parts[1]))
                .first_lines.set(word, position + 1)
    words.WordIndex index = words.WordIndex(scores)

    string[] report_lines()
        string[] result = ["WORDLIST lines={line_count} valid={len(index.ranked)} invalid={len(invalid)} duplicates={len(duplicates)}"]
        for Issue issue = invalid[]
            result = result.append("invalid {issue.line} {issue.reason}")
        for Duplicate duplicate = duplicates[]
            result = result.append("duplicate {duplicate.line} {duplicate.word} first={duplicate.first}")
        for 3 <= int length <= 15
            int[] bucket = index.words_of_length(length)
            if len(bucket) == 0
                continue
            int total = math.sum([for int id = bucket[] then index.ranked[id].score])
            words.Entry best = index.ranked[bucket[0]]
            result = result.append("length {length} words={len(bucket)} average={render.decimal(total, int(len(bucket)), 2)} best={best.word}:{best.score}")
        string[] bands = ["bands"]
        for int band < 5
            int low = band * 20 + 1
            int high = (band + 1) * 20
            int count = math.sum<int>([for words.Entry entry = index.ranked[] if low <= entry.score <= high then 1])
            bands = bands.append("{low}-{high}={count}")
        result = result.append(bands.join(" "))
        string[] top = []
        for int position < 5
            top = top.append("{index.ranked[position].word}:{index.ranked[position].score}")
        result = result.append("top " + top.join(" "))
        int64[] letter_order = []
        for int letter < 26
            int count = 0
            for words.Entry entry = index.ranked[]
                if entry.word.contains(alphabet[letter])
                    count += 1
            letter_order = letter_order.append(int64(count * 32 + letter))
        int64[] sorted_letters = letter_order.sorted()
        string[] rare = []
        for int position < 5
            int key = int(sorted_letters[position])
            rare = rare.append("{alphabet[key % 32]}:{key / 32}")
        return result.append("rare_letters " + rare.join(" "))

class Clue(string word, int number, string text)
    int uses = 0

class ClueBook(local string[] source_lines, words.WordIndex index)
    int entries = 0
    int added = 0
    Issue[] invalid = []
    Issue[] unknown = []
    Clue[] clues = []
    local int[] empty = []
    int[][] by_word = array(len(index.ranked), fill = empty)
    for int position < int(len(source_lines))
        local string line = source_lines[position]
        if ignored(line)
            continue
        entries += 1
        match words.clue_line_error(line)
            string reason
                invalid = invalid.append(Issue(position + 1, reason))
                continue
            none
                void
        local string[] parts = line.split("|")
        local int id = index.id_of(parts[0])
        if id < 0
            unknown = unknown.append(Issue(position + 1, parts[0]))
        else
            local int clue_index = int(len(clues))
            clues = clues.append(Clue(parts[0], int(len(by_word[id])) + 1, parts[1]))
            by_word[id] = by_word[id].append(clue_index)
            added += 1

    string | none .choose(int id)
        if len(by_word[id]) == 0
            return none
        int chosen = by_word[id][0]
        for int candidate = by_word[id][]
            if clues[candidate].uses < clues[chosen].uses
                chosen = candidate
        clues[chosen].uses += 1
        return clues[chosen].text

    string[] report_lines()
        int word_count = math.sum<int>([for int[] bucket = by_word[] if len(bucket) > 0 then 1])
        string[] result = ["CLUES entries={entries} valid={added} invalid={len(invalid)} unknown={len(unknown)} words={word_count}"]
        for Issue issue = invalid[]
            result = result.append("clue_invalid {issue.line} {issue.reason}")
        for Issue issue = unknown[]
            result = result.append("clue_unknown {issue.line} {issue.reason}")
        int used_count = math.sum<int>([for Clue clue = clues[] if clue.uses >= 1 then 1])
        int repeated_count = math.sum<int>([for Clue clue = clues[] if clue.uses >= 2 then 1])
        result = result.append("CLUE_USE used={used_count} unused={int(len(clues)) - used_count} repeated={repeated_count}")
        for string word = index.scores.keys().sorted()[]
            for int clue_index = by_word[index.id_of(word)][]
                Clue clue = clues[clue_index]
                if clue.uses >= 2
                    result = result.append("repeated {word} clue={clue.number} uses={clue.uses}")
        return result

int total_score(filler.GridState state, words.WordIndex index)
    int total = 0
    for int id = state.assigned[]
        if id >= 0
            total += index.ranked[id].score
    return total

string slot_entry(slots.Slot slot, filler.GridState state, words.WordIndex index)
    words.Entry entry = index.ranked[state.assigned[slot.index]]
    return "{slot.label}:{entry.word}:{entry.score}"

int[] occurring_lengths(slots.Layout layout)
    int[] result = []
    for 3 <= int length <= 15
        for slots.Slot slot = layout.entries[]
            if slot.length == length
                result = result.append(length)
                break
    return result

int[] highlighted(int[] values, bool[] eligible, bool descending)
    int stride = int(len(values)) + 1
    int maximum = math.max_all(values)
    int64[] keys = []
    for int position < int(len(values))
        if eligible[position]
            int primary = if descending then maximum - values[position] else values[position]
            keys = keys.append(int64(primary * stride + position))
    int[] result = []
    for int64 key = keys.sorted()[]
        if len(result) == 3
            break
        result = result.append(int(key) % stride)
    return result

class ValidTemplate(string name, grid.Grid board, slots.Layout layout, filler.GridState initial, bool[] theme_slots, int initial_minimum, int budget, string required_symmetry, filler.Attempt[] attempts, string[] chosen)
    filler.Attempt final_attempt = attempts[len(attempts) - 1]
    filler.GridState state = final_attempt.final_state()

    bool is_filled()
        return final_attempt.outcome == "filled"

    string[] grid_paragraph()
        string[] result = ["TEMPLATE {name}", "outcome={final_attempt.outcome} attempts={len(attempts)} min_score={final_attempt.min_score}"]
        return result.concat(render.grid_lines(board, state.letters)).append("numbers").concat(render.number_lines(layout))

    string[] clue_paragraph(words.WordIndex index)
        string[] result = ["TEMPLATE {name}"]
        int clued = 0
        int missing = 0
        int unfilled = 0
        for bool across = [true, false][]
            slots.Slot[] group = [for slots.Slot slot = layout.entries[] if slot.across == across then slot]
            if len(group) > 0
                result = result.append(if across then "ACROSS" else "DOWN")
            for slots.Slot slot = group[]
                int id = state.assigned[slot.index]
                if id < 0
                    unfilled += 1
                    result = result.append(render.list_line(slot, "(unfilled)", state.pattern(slot), "-", false))
                else
                    string clue = chosen[slot.index]
                    if clue == ""
                        missing += 1
                        clue = "(no clue)"
                    else
                        clued += 1
                    result = result.append(render.list_line(slot, clue, index.ranked[id].word, "{index.ranked[id].score}", theme_slots[slot.index]))
        return result.append("clued={clued} missing={missing} unfilled={unfilled}")

    string grid_summary()
        int white = int(len(board.white_cells()))
        int black = board.size() - white
        int givens = math.sum<int>([for int position = board.white_cells()[] if board.is_given(position) then 1])
        string[] holding = []
        for string symmetry = ["rot180", "mirror"][]
            if board.asymmetric_cell(symmetry) < 0
                holding = holding.append(symmetry)
        string symmetry_text = if len(holding) == 0 then "none" else holding.join(",")
        return "grid size={board.width}x{board.height} blocks={black} white={white} density={render.decimal(100 * black, board.size(), 1)} givens={givens} required={required_symmetry} symmetry={symmetry_text}"

    string slot_summary()
        int[] lengths = [for slots.Slot slot = layout.entries[] then slot.length]
        int across = math.sum<int>([for slots.Slot slot = layout.entries[] if slot.across then 1])
        int total = int(len(layout.entries))
        string[] counts = []
        for int length = occurring_lengths(layout)[]
            int count = math.sum<int>([for int value = lengths[] if value == length then 1])
            counts = counts.append("{length}:{count}")
        int unchecked = math.sum<int>([for int position = board.white_cells()[] if layout.owner_count(position) == 1 then 1])
        return "slots across={across} down={total - across} total={total} lengths={counts.join(",")} avg_length={render.decimal(math.sum(lengths), total, 2)} longest={math.max_all(lengths)} unchecked={unchecked}"

    string coverage_line(words.WordIndex index)
        string[] parts = []
        for int length = occurring_lengths(layout)[]
            int count = math.sum<int>([for int id = index.words_of_length(length)[] if index.ranked[id].score >= initial_minimum then 1])
            parts = parts.append("{length}:{count}")
        return "coverage " + parts.join(" ")

    string tightest_line(words.WordIndex index)
        int[] counts = array(len(layout.entries), fill = 0)
        bool[] eligible = array(len(layout.entries), fill = false)
        for slots.Slot slot = layout.entries[]
            if not theme_slots[slot.index]
                counts[slot.index] = int(len(index.candidates(initial.pattern(slot), initial_minimum, initial.used)))
                eligible[slot.index] = true
        string[] parts = [for int id = highlighted(counts, eligible, false)[] then "{layout.entries[id].label}:{counts[id]}"]
        return "tightest " + joined(parts, " ")

    string hotspots_line()
        bool[] eligible = [for int count = final_attempt.failures[] then count > 0]
        string[] parts = [for int id = highlighted(final_attempt.failures, eligible, true)[] then "{layout.entries[id].label}:{final_attempt.failures[id]}"]
        return "hotspots " + joined(parts, " ")

    string worst_crossing(words.WordIndex index)
        int worst = -1
        int worst_sum = 0
        for int position = board.white_cells()[]
            int across = layout.across_slot[position]
            int down = layout.down_slot[position]
            if across < 0 or down < 0
                continue
            int combined = index.ranked[state.assigned[across]].score + index.ranked[state.assigned[down]].score
            if worst < 0 or combined < worst_sum
                worst = position
                worst_sum = combined
        if worst < 0
            return "-"
        slots.Slot across = layout.entries[layout.across_slot[worst]]
        slots.Slot down = layout.entries[layout.down_slot[worst]]
        string across_word = index.ranked[state.assigned[across.index]].word
        string down_word = index.ranked[state.assigned[down.index]].word
        return "{board.location_text(worst)} {across.label}:{across_word}+{down.label}:{down_word}={worst_sum}"

    string[] quality_lines(words.WordIndex index, int weak_score)
        int total = total_score(state, index)
        int weakest = 0
        string[] weak = []
        for slots.Slot slot = layout.entries[]
            int score = index.ranked[state.assigned[slot.index]].score
            if score < index.ranked[state.assigned[weakest]].score
                weakest = slot.index
            if score < weak_score
                weak = weak.append(slot_entry(slot, state, index))
        bool[] present = array(26, fill = false)
        int[] points = [1, 3, 3, 2, 1, 4, 2, 4, 1, 8, 5, 1, 3, 1, 1, 3, 10, 1, 1, 1, 1, 4, 4, 8, 4, 10]
        int total_points = 0
        for int position = board.white_cells()[]
            int letter = state.letters[position].codepoints()[0] - 65
            present[letter] = true
            total_points += points[letter]
        string missing = ""
        for int letter < 26
            if not present[letter]
                missing += alphabet[letter]
        int distinct = math.sum<int>([for bool found = present[] if found then 1])
        string pangram = if missing == "" then "yes" else "no"
        return [
            "quality total={total} average={render.decimal(total, int(len(layout.entries)), 2)} weakest={slot_entry(layout.entries[weakest], state, index)} weak={joined(weak, ",")}",
            "letters distinct={distinct} pangram={pangram} missing={if missing == "" then "-" else missing} scrabble={render.decimal(total_points, int(len(board.white_cells())), 2)} worst_crossing={worst_crossing(index)}",
        ]

    string partial_line(words.WordIndex index)
        int assigned_count = math.sum<int>([for int id = state.assigned[] if id >= 0 then 1])
        int lettered = math.sum<int>([for int position = board.white_cells()[] if state.letters[position] != "." then 1])
        string[] blocked = []
        for slots.Slot slot = layout.entries[]
            if state.assigned[slot.index] < 0 and len(index.candidates(state.pattern(slot), final_attempt.min_score, state.used)) == 0
                blocked = blocked.append(slot.label)
        return "partial assigned={assigned_count}/{len(layout.entries)} letters={lettered}/{len(board.white_cells())} blocked={joined(blocked, ",")}"

    string[] stats_paragraph(words.WordIndex index, int weak_score)
        string[] result = ["TEMPLATE {name}", grid_summary(), slot_summary()]
        string[] themes = [for slots.Slot slot = layout.entries[] if theme_slots[slot.index] then slot_entry(slot, state, index)]
        if len(themes) > 0
            result = result.append("themes " + themes.join(" "))
        result = result.append(coverage_line(index)).append(tightest_line(index))
        for int position < int(len(attempts))
            filler.Attempt attempt = attempts[position]
            result = result.append("attempt {position + 1} min_score={attempt.min_score} budget={attempt.budget} outcome={attempt.outcome} nodes={attempt.nodes} backtracks={attempt.backtracks} prunes={attempt.prunes} dead_ends={attempt.dead_ends} max_depth={attempt.max_depth}")
        result = result.append("trace " + joined(final_attempt.trace, " ")).append(hotspots_line())
        if is_filled()
            string[] order = [for int id = final_attempt.sequence[] then layout.entries[id].label]
            result = result.append("order " + joined(order, " ")).concat(quality_lines(index, weak_score))
        else
            result = result.append(partial_line(index))
        return result

InvalidTemplate | ValidTemplate process_template(Block block, Settings settings, words.WordIndex index, ClueBook &clue_book, string[] earlier_names)
    if not valid_name(block.name)
        return InvalidTemplate(block.name, "bad name")
    if contains_name(earlier_names, block.name)
        return InvalidTemplate(block.name, "duplicate name")
    int budget = settings.node_budget
    int minimum = settings.min_score
    string symmetry = settings.symmetry
    string[] themes = []
    string[] seen_options = []
    for int position < int(len(block.options))
        string line = block.options[position]
        string key = line.split(" ")[0]
        string value = line[len(key) + 1:<len(line)]
        bool valid = true
        if key == "theme"
            valid = words.valid_word(value) and not contains_name(themes, value)
            if valid
                themes = themes.append(value)
        elif contains_name(seen_options, key)
            valid = false
        elif key == "node_budget" and words.valid_integer(value, 1, 100000)
            budget = int.parse(value)
        elif key == "min_score" and words.valid_integer(value, 1, 100)
            minimum = int.parse(value)
        elif key == "symmetry" and contains_name(["rot180", "mirror", "none"], value)
            symmetry = value
        else
            valid = false
        if not valid
            return InvalidTemplate(block.name, "bad option {position + 1}")
        seen_options = seen_options.append(key)
    if not (3 <= len(block.rows) <= 15)
        return InvalidTemplate(block.name, "bad height")
    for int position < int(len(block.rows))
        if not valid_row(block.rows[position], int(len(block.rows[0])))
            return InvalidTemplate(block.name, "bad row {position + 1}")
    auto board = grid.Grid(block.rows)
    if symmetry != "none"
        int asymmetric = board.asymmetric_cell(symmetry)
        if asymmetric >= 0
            return InvalidTemplate(block.name, "asymmetric at {board.location_text(asymmetric)}")
    int components = board.component_count()
    if components != 1
        return InvalidTemplate(block.name, "disconnected components={components}")
    match slots.short_run_error(board)
        string reason
            return InvalidTemplate(block.name, reason)
        none
            void
    auto layout = slots.Layout(board)
    int orphan = layout.orphan_cell()
    if orphan >= 0
        return InvalidTemplate(block.name, "orphan cell {board.location_text(orphan)}")
    string[] letters = [for int position = (0:<board.size())[] then board.cells[position]]
    auto initial = filler.GridState(letters, array(len(layout.entries), fill = -1), array(len(index.ranked), fill = false))
    bool[] theme_slots = array(len(layout.entries), fill = false)
    for int position < int(len(themes))
        int id = index.id_of(themes[position])
        if id < 0
            return InvalidTemplate(block.name, "unknown theme {position + 1}")
        int chosen = -1
        for slots.Slot slot = layout.entries[]
            if initial.assigned[slot.index] < 0 and slot.length == int(len(themes[position])) and words.matches(themes[position], initial.pattern(slot))
                chosen = slot.index
                break
        if chosen < 0
            return InvalidTemplate(block.name, "theme {position + 1} does not fit")
        .initial.assign(layout.entries[chosen], id, themes[position])
        theme_slots[chosen] = true
    filler.Attempt[] attempts = []
    int attempt_minimum = minimum
    while true
        auto attempt = filler.Attempt(layout, index, initial, attempt_minimum, budget)
        .attempt.run()
        attempts = attempts.append(attempt)
        if attempt.outcome == "filled" or settings.relax_step < 1 or attempt_minimum <= 1
            break
        attempt_minimum = math.max(attempt_minimum - settings.relax_step, 1)
    filler.GridState final_state = attempts[len(attempts) - 1].final_state()
    string[] chosen_clues = array(len(layout.entries), fill = "")
    for bool across = [true, false][]
        for slots.Slot slot = layout.entries[]
            if slot.across == across and final_state.assigned[slot.index] >= 0
                match .clue_book.choose(final_state.assigned[slot.index])
                    string clue
                        chosen_clues[slot.index] = clue
                    none
                        void
    return ValidTemplate(block.name, board, layout, initial, theme_slots, minimum, budget, symmetry, attempts, chosen_clues)

string[] ranking_paragraph(ValidTemplate[] filled, words.WordIndex index)
    ValidTemplate[] ranked = []
    for ValidTemplate candidate = filled[]
        int candidate_total = total_score(candidate.state, index)
        int position = int(len(ranked))
        ranked = ranked.append(candidate)
        while position > 0
            ValidTemplate previous = ranked[position - 1]
            int left = candidate_total * int(len(previous.layout.entries))
            int right = total_score(previous.state, index) * int(len(candidate.layout.entries))
            string[] names = [candidate.name, previous.name].sorted()
            if left < right or (left == right and names[0] != candidate.name)
                break
            ranked[position] = previous
            position -= 1
        ranked[position] = candidate
    string[] result = ["RANKING"]
    for int position < int(len(ranked))
        ValidTemplate template = ranked[position]
        int total = total_score(template.state, index)
        int entries = int(len(template.layout.entries))
        result = result.append("rank {position + 1} {template.name} average={render.decimal(total, entries, 2)} total={total} entries={entries}")
    return result

string[] reuse_paragraph(ValidTemplate[] filled, words.WordIndex index)
    string[] empty = []
    string[][] appearances = array(len(index.ranked), fill = empty)
    for ValidTemplate template = filled[]
        for int id = template.state.assigned[]
            appearances[id] = appearances[id].append(template.name)
    string[] result = ["REUSE"]
    for int(len(filled)) >= int count >= 2
        for string word = index.scores.keys().sorted()[]
            string[] names = appearances[index.id_of(word)]
            if int(len(names)) == count
                result = result.append("reused {word} {count} {names.join(",")}")
    return result

string[] summary_paragraph(int block_count, ValidTemplate[] valid)
    int filled = 0
    int unfillable = 0
    int budget = 0
    int attempts = 0
    int nodes = 0
    for ValidTemplate template = valid[]
        if template.final_attempt.outcome == "filled"
            filled += 1
        elif template.final_attempt.outcome == "unfillable"
            unfillable += 1
        else
            budget += 1
        attempts += int(len(template.attempts))
        for filler.Attempt attempt = template.attempts[]
            nodes += attempt.nodes
    return ["SUMMARY templates={block_count} invalid={block_count - int(len(valid))} filled={filled} unfillable={unfillable} budget={budget} attempts={attempts} nodes={nodes}"]

void write_lines(string name, string[] lines)
    file.write("output/" + name, if len(lines) == 0 then "" else lines.join(NL) + NL)

void write_paragraphs(string name, string[][] paragraphs)
    string[] lines = []
    for string[] paragraph = paragraphs[]
        if len(lines) > 0
            lines = lines.append("")
        lines = lines.concat(paragraph)
    write_lines(name, lines)

void fill_crosswords()
    Settings settings = read_settings()
    auto word_list = WordList(read_lines("words.txt"))
    auto clue_book = ClueBook(read_lines("clues.txt"), word_list.index)
    Block[] blocks = read_blocks()
    string[] earlier_names = []
    ValidTemplate[] valid = []
    ValidTemplate[] filled = []
    string[][] grid_paragraphs = []
    string[][] clue_paragraphs = []
    string[][] stats = []
    for Block block = blocks[]
        match process_template(block, settings, word_list.index, &clue_book, earlier_names)
            InvalidTemplate invalid
                grid_paragraphs = grid_paragraphs.append(["TEMPLATE {invalid.name}", "error {invalid.reason}"])
            ValidTemplate template
                valid = valid.append(template)
                if template.is_filled()
                    filled = filled.append(template)
                grid_paragraphs = grid_paragraphs.append(template.grid_paragraph())
                clue_paragraphs = clue_paragraphs.append(template.clue_paragraph(word_list.index))
                stats = stats.append(template.stats_paragraph(word_list.index, settings.weak_score))
        earlier_names = earlier_names.append(block.name)
    stats = stats.append(ranking_paragraph(filled, word_list.index)).append(reuse_paragraph(filled, word_list.index)).append(summary_paragraph(int(len(blocks)), valid))
    bool directory_exists = file.is_directory("output")
    if not directory_exists
        file.mkdir("output")
    write_paragraphs("grid.txt", grid_paragraphs)
    write_paragraphs("clues.txt", clue_paragraphs)
    write_paragraphs("search_stats.txt", stats)
    write_lines("wordlist.txt", word_list.report_lines().concat(clue_book.report_lines()))

if main
    fill_crosswords()
