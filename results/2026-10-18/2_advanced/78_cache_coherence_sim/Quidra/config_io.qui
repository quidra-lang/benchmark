class Scenario(string name, string protocol, string l1, string l2)
class Region(string name, int first, int last)
class Config()
    cores := 0
    line_size := 0
    l1_size := 0
    l1_ways := 0
    l2_size := 0
    l2_ways := 0
    t1 := 0
    t2 := 0
    tm := 0
    tb := 0
    interval := 0
    top := 0
    primary := ""
    Scenario[] scenarios := []
    Region[] regions := []
    int[] watch := []

bool decimal_integer(string text, maximum := 9)
    if len(text) == 0 or int(len(text)) > maximum or (len(text) > 1 and text[0] == "0")
        return false
    for: i < int(len(text))
        if not "0123456789".contains(text[i])
            return false
    return true

int hex_digit(string character)
    digits := "0123456789abcdef"
    for: i < 16
        if digits[i] == character
            return i
    return -1

bool valid_hex(string text)
    if len(text) != 8
        return false
    for: i < 8
        if hex_digit(text[i]) < 0
            return false
    return true

int parse_hex(string text)
    result := 0
    for: i < int(len(text))
        result = 16 * result + hex_digit(text[i])
    return result

string hex_address(int value)
    digits := "0123456789abcdef"
    result := ""
    rest := value
    for: i < 8
        result = digits[rest % 16] + result
        rest /= 16
    return result

string[] read_lines(string path)
    source := file.read(path)
    string[] result := []
    while .source(string &line)
        result = result.append(line)
    return result

Config read_config()
    config := Config()
    for line := read_lines("input/config.txt")[]
        f := line.split(" ")
        if f[0] == "CORES"
            config.cores = int.parse(f[1])
        elif f[0] == "LINE"
            config.line_size = int.parse(f[1])
        elif f[0] == "L1"
            config.l1_size = int.parse(f[1])
            config.l1_ways = int.parse(f[2])
        elif f[0] == "L2"
            config.l2_size = int.parse(f[1])
            config.l2_ways = int.parse(f[2])
        elif f[0] == "LATENCY"
            config.t1 = int.parse(f[1])
            config.t2 = int.parse(f[2])
            config.tm = int.parse(f[3])
            config.tb = int.parse(f[4])
        elif f[0] == "SCENARIO"
            config.scenarios = config.scenarios.append(Scenario(f[1], f[2], f[3], f[4]))
        elif f[0] == "PRIMARY"
            config.primary = f[1]
        elif f[0] == "INTERVAL"
            config.interval = int.parse(f[1])
        elif f[0] == "TOP"
            config.top = int.parse(f[1])
        elif f[0] == "REGION"
            config.regions = config.regions.append(Region(f[1], parse_hex(f[2]), parse_hex(f[3])))
        else
            config.watch = config.watch.append(parse_hex(f[1]) / config.line_size)
    return config

void write_lines(string filename, string[] lines)
    destination := file.write("output/" + filename)
    if len(lines) > 0
        .destination(lines.join(NL) + NL)
