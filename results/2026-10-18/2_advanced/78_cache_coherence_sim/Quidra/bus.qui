import math
import config_io = "./config_io.qui"

class Transaction(int number, int start, int core, string kind, int block)
    string[] snoops := []
    int snoop_hits := 0
    int invalidations := 0
    int supplier := -1
    bool flushed := false
    string l2 := ""
    int evicted := -1
    string[] back_copies := []
    bool dirty_eviction := false
    string source := ""
class Bus(int latency)
    int free := 0
    int wait := 0
    Transaction[] transactions := []

Transaction assign(Bus &bus, int core, string kind, int block, int requested)
    int start := math.max(requested, bus.free)
    bus.wait += start - requested
    bus.free = start + bus.latency
    Transaction result := Transaction(int(len(bus.transactions)) + 1, start, core, kind, block)
    bus.transactions = bus.transactions.append(result)
    return result

string format_line(Transaction transaction, int line_size)
    string result := "{transaction.number} {transaction.start} c{transaction.core} {transaction.kind} " + config_io.hex_address(transaction.block * line_size)
    if transaction.kind == "WB"
        return result
    result += " snoop " + (if len(transaction.snoops) == 0 then "none" else transaction.snoops.join(" "))
    if transaction.kind == "BusUpgr"
        return result
    if transaction.kind == "BusRd" or transaction.kind == "BusRdX"
        result += " data " + transaction.source
    result += " l2 " + transaction.l2
    if transaction.evicted >= 0
        string copies := if len(transaction.back_copies) == 0 then "none" else transaction.back_copies.join(" ")
        string quality := if transaction.dirty_eviction then "dirty" else "clean"
        result += " evict " + config_io.hex_address(transaction.evicted * line_size) + " {copies} {quality}"
    return result
