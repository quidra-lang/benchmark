class Request(string transaction, string state)
class Snoop(string state, bool supply, bool flush)

bool dirty(string state)
    return state == "M" or state == "O"

Request requester(string protocol, string old, string operation, bool others)
    if protocol == "VI"
        if operation == "R"
            return Request(if old == "I" then "BusRd" else "", "V")
        return Request("BusWr", if old == "I" then "I" else "V")
    if old == "I"
        if operation == "W"
            return Request("BusRdX", "M")
        return Request("BusRd", if protocol != "MSI" and not others then "E" else "S")
    if operation == "R"
        return Request("", old)
    if old == "M" or old == "E"
        return Request("", "M")
    return Request("BusUpgr", "M")

Snoop snoop(string protocol, string old, string transaction)
    if protocol == "VI"
        return Snoop(if transaction == "BusRd" then "V" else "I", false, false)
    if transaction == "BusRd"
        if old == "M"
            return Snoop(if protocol == "MOESI" then "O" else "S", true, protocol != "MOESI")
        if old == "O"
            return Snoop("O", true, false)
        return Snoop("S", false, false)
    return Snoop("I", transaction == "BusRdX" and dirty(old), false)
