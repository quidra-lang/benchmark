class Problem(int line, int column, string reason)
class Comment(string text, int line, int column, int blank, bool line_comment, bool own = false)
class Token(string text, string kind, int line, int column, int blank, Comment[] leading = [], Comment[] trailing = [])
class Occurrence(bool token, int index)
class Lexed(Token[] tokens = [], Comment[] comments = [], Occurrence[] order = [])

bool has<T>(const T[] items, T sought)
    for T item = items[]
        if item == sought
            return true
    return false

int minimum(int first, int second)
    return if first < second then first else second

int maximum(int first, int second)
    return if first > second then first else second

string repeat(string text, int count)
    string result = ""
    for int iteration < count
        result += text
    return result

string trim_end(string text)
    int finish = int(len(text))
    while finish > 0 and text[finish - 1] == " "
        finish -= 1
    return text[0:<finish]

bool letter(string character)
    return (character >= "A" and character <= "Z") or (character >= "a" and character <= "z")

bool digit(string character)
    return character >= "0" and character <= "9"

Lexed | Problem lex(const string[] lines)
    Lexed result = Lexed()
    int previous = 0
    for int row < int(len(lines))
        string line = lines[row]
        int position = 0
        while position < int(len(line))
            if line[position] == " "
                position += 1
                continue
            int start = position
            int line_number = row + 1
            int blank = maximum(0, line_number - previous - 1)
            string remaining = line[position:<int(len(line))]
            if remaining.starts_with("//")
                result.order = result.order.append(Occurrence(false, int(len(result.comments))))
                result.comments = result.comments.append(Comment(trim_end(remaining), line_number, position + 1, blank, true))
                previous = line_number
                break
            if remaining.starts_with("/*")
                int finish = position + 2
                while finish + 1 < int(len(line)) and line[finish:<finish + 2] != "*/"
                    finish += 1
                if finish + 1 >= int(len(line))
                    return Problem(line_number, start + 1, "unterminated comment")
                result.order = result.order.append(Occurrence(false, int(len(result.comments))))
                result.comments = result.comments.append(Comment(line[position:<finish + 2], line_number, position + 1, blank, false))
                previous = line_number
                position = finish + 2
                continue
            string kind = ""
            string character = line[position]
            if letter(character) or character == "_"
                position += 1
                while position < int(len(line)) and (letter(line[position]) or digit(line[position]) or line[position] == "_")
                    position += 1
                string word = line[start:<position]
                kind = if has(["int", "float", "bool", "string", "void", "if", "else", "while", "for", "return", "break", "continue", "true", "false", "switch", "case", "default"], word) then "keyword" else "identifier"
            elif digit(character)
                position += 1
                while position < int(len(line)) and digit(line[position])
                    position += 1
                if position + 1 < int(len(line)) and line[position] == "." and digit(line[position + 1])
                    position += 2
                    while position < int(len(line)) and digit(line[position])
                        position += 1
                kind = "number"
            elif character == DQ
                position += 1
                bool closed = false
                while position < int(len(line))
                    if line[position] == "\"
                        position += 2
                    elif line[position] == DQ
                        position += 1
                        closed = true
                        break
                    else
                        position += 1
                if not closed
                    return Problem(line_number, start + 1, "unterminated string")
                kind = "string"
            elif position + 1 < int(len(line)) and has(["<=", ">=", "==", "!=", "&&", "||", "+=", "-=", "*=", "/=", "%="], line[position:<position + 2])
                position += 2
                kind = "symbol"
            elif "+-*/%<>=!()[]{{}},;.?:".contains(character)
                position += 1
                kind = "symbol"
            else
                return Problem(line_number, start + 1, "unexpected character '{character}'")
            result.order = result.order.append(Occurrence(true, int(len(result.tokens))))
            result.tokens = result.tokens.append(Token(line[start:<position], kind, line_number, start + 1, blank))
            previous = line_number
    result.tokens = result.tokens.append(Token("", "end", int(len(lines)) + 1, 1, 0))
    return result
