int count_value(map.Map<string, int> values, string key)
    match values.get(key)
        int value
            return value
        none
            return 0

int[] number_values(map.Map<string, int[]> values, string key)
    match values.get(key)
        int[] found
            return found
        none
            return []

bool has_item(string[] items, string name)
    for string item = items[]
        if item == name
            return true
    return false

bool contains(string[] items, string[] wanted)
    for string item = wanted[]
        if not has_item(items, item)
            return false
    return true

string[] unique_sorted(string[] items)
    string[] result = []
    for string item = items.sorted()[]
        if len(result) == 0 or result[len(result) - 1] != item
            result = result.append(item)
    return result

class Product(string name, string category, int price)

Product | error product_value(map.Map<string, Product> products, string name)
    match products.get(name)
        Product found
            return found
        none
            return error("missing product {name}")

class Transaction(string tid, string customer, int day)
    map.Map<string, int> counts

    string[] products()
        return counts.keys().sorted()

    int units()
        int result = 0
        for string item = counts.keys()[]
            result += count_value(counts, item)
        return result

bool add_product(Transaction &transaction, string item)
    int previous = count_value(transaction.counts, item)
    .transaction.counts.set(item, previous + 1)
    return previous > 0

string[][] read_records(string name)
    string text = file.read("input/" + name)
    string[] lines = text.split(NL)
    string[][] result = []
    for 1 <= int index < int(len(lines))
        if lines[index] != ""
            result = result.append(lines[index].split(","))
    return result

string[] extended_basket(string[] items, map.Map<string, string> taxonomy)
    string[] result = items
    for string item = items[]
        match taxonomy.get(item)
            string category
                result = result.append(category)
            none
                void
    return unique_sorted(result)
