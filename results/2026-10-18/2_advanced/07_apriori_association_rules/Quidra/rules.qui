int gcd(int first, int second)
    int left = if first < 0 then -first else first
    int right = if second < 0 then -second else second
    while right > 0
        int remainder = left % right
        left = right
        right = remainder
    return left

class Ratio(int numerator, int denominator = 1)
    if denominator < 0
        numerator = -numerator
        denominator = -denominator
    local int divisor = gcd(numerator, denominator)
    numerator /= divisor
    denominator /= divisor

    int compare(Ratio other)
        int left = numerator * other.denominator
        int right = other.numerator * denominator
        return if left < right then -1 elif left > right then 1 else 0

    Ratio subtract(Ratio other)
        return Ratio(numerator * other.denominator - other.numerator * denominator, denominator * other.denominator)

    Ratio scaled(int factor, int divisor = 1)
        return Ratio(numerator * factor, denominator * divisor)

Ratio lift_of(int total, int together, int first_count, int second_count)
    return Ratio(total * together, first_count * second_count)

class Rule(string[] itemset, string[] antecedent, string[] consequent, int count, local int total, local int antecedent_count, local int consequent_count)
    Ratio support = Ratio(count, total)
    Ratio confidence = Ratio(count, antecedent_count)
    Ratio lift = lift_of(total, count, antecedent_count, consequent_count)
    Ratio leverage = Ratio(total * count - antecedent_count * consequent_count, total * total)
    bool infinite = antecedent_count == count
    Ratio conviction = Ratio(0)
    if not infinite
        conviction = Ratio((total - consequent_count) * antecedent_count, total * (antecedent_count - count))
    Ratio improvement = Ratio(0)
    int rank = 0

bool meets_thresholds(Ratio confidence, Ratio lift, Ratio min_confidence, Ratio min_lift)
    return confidence.compare(min_confidence) >= 0 and lift.compare(min_lift) >= 0

bool before(Rule first, Rule second)
    int order = first.confidence.compare(second.confidence)
    if order != 0
        return order > 0
    order = first.lift.compare(second.lift)
    if order != 0
        return order > 0
    if first.count != second.count
        return first.count > second.count
    string left = first.antecedent.join("+")
    string right = second.antecedent.join("+")
    if left != right
        return left < right
    return first.consequent.join("+") < second.consequent.join("+")

Rule[] sorted_rules(Rule[] values)
    if len(values) < 2
        return values
    nat middle = len(values) / 2
    Rule[] left = sorted_rules(values[0:<middle])
    Rule[] right = sorted_rules(values[middle:<len(values)])
    Rule[] result = []
    nat first = 0
    nat second = 0
    while first < len(left) and second < len(right)
        if before(right[second], left[first])
            result = result.append(right[second])
            second += 1
        else
            result = result.append(left[first])
            first += 1
    return result.concat(left[first:<len(left)]).concat(right[second:<len(right)])

class RuleSet(int generated, Rule[] entries)
    int productive = 0
    for Rule entry = entries[]
        if entry.improvement.numerator > 0
            productive += 1
