import rules = "./rules.qui"

string fraction_text(rules.Ratio value)
    int numerator = if value.numerator < 0 then -value.numerator else value.numerator
    int scaled = 10000 * numerator / value.denominator
    int whole = scaled / 10000
    int fraction = scaled % 10000
    string decimal = "{whole}.{fraction:int=4,zero}"
    if value.numerator < 0
        string sign = if scaled > 0 then "-" else ""
        return "-{numerator}/{value.denominator}={sign}{decimal}"
    return "{numerator}/{value.denominator}={decimal}"

string percent_text(int part, int whole)
    int scaled = 10000 * part / whole
    int fraction = scaled % 100
    return "{scaled / 100}.{fraction:int=2,zero}%"

string money_text(int cents)
    int fraction = cents % 100
    return "{cents / 100}.{fraction:int=2,zero}"

string itemset_text(string[] items)
    return items.join("+")

string rule_arrow(rules.Rule rule)
    return itemset_text(rule.antecedent) + " -> " + itemset_text(rule.consequent)

string rule_csv_line(rules.Rule rule)
    string conviction = if rule.infinite then "INF" else fraction_text(rule.conviction)
    string[] fields = [rule.rank.string(), itemset_text(rule.antecedent), itemset_text(rule.consequent), rule.count.string(), fraction_text(rule.support), fraction_text(rule.confidence), fraction_text(rule.lift), fraction_text(rule.leverage), conviction, fraction_text(rule.improvement)]
    return fields.join(",")

string[] rules_csv(rules.Rule[] entries)
    string[] lines = ["rank,antecedent,consequent,count,support,confidence,lift,leverage,conviction,improvement"]
    for rules.Rule rule = entries[]
        lines = lines.append(rule_csv_line(rule))
    return lines

void write_report(string name, string[] lines)
    if not file.is_directory("output")
        file.mkdir("output")
    string text = if len(lines) == 0 then "" else lines.join(NL) + NL
    file.write("output/" + name, text)
