import baskets = "./baskets.qui"

class Itemset(string[] items, int count)

string[][] one_smaller_subsets(string[] items)
    string[][] result = []
    for nat index < len(items)
        result = result.append(items[0:<index].concat(items[index + 1:<len(items)]))
    return result

class Candidates()
    int joined = 0
    int excluded = 0
    int pruned = 0
    string[][] itemsets = []

Candidates generate_candidates(string[][] previous, int size, map.Map<string, string> taxonomy, bool exclude_categories)
    Candidates result = Candidates()
    map.Map<string, bool> known
    for string[] items = previous[]
        .known.set(items.join("+"), true)
    for nat left < len(previous)
        string[] first = previous[left]
        for left + 1 <= nat right < len(previous)
            string[] second = previous[right]
            if first[0:<len(first) - 1] != second[0:<len(second) - 1]
                break
            result.joined += 1
            string[] candidate = first.append(second[len(second) - 1])
            bool excluded = false
            if exclude_categories and size == 2
                match taxonomy.get(candidate[0])
                    string category
                        excluded = category == candidate[1]
                    none
                        void
                match taxonomy.get(candidate[1])
                    string category
                        excluded = excluded or category == candidate[0]
                    none
                        void
            if excluded
                result.excluded += 1
                continue
            bool pruned = false
            for string[] subset = one_smaller_subsets(candidate)[]
                if not known.has(subset.join("+"))
                    pruned = true
                    break
            if pruned
                result.pruned += 1
            else
                result.itemsets = result.itemsets.append(candidate)
    return result

class Counter(local string[][] itemsets)
    int total = int(len(itemsets))
    map.Map<string, int[]> rows
    for nat index < len(itemsets)
        for string item = itemsets[index][]
            int[] previous = baskets.number_values(rows, item)
            .rows.set(item, previous.append(int(index)))

    int support(string[] wanted)
        if len(wanted) == 0
            return total
        int[] matching = baskets.number_values(rows, wanted[0])
        for 1 <= int index < int(len(wanted))
            int[] next_rows = baskets.number_values(rows, wanted[index])
            int[] intersection = []
            int left = 0
            int right = 0
            while left < int(len(matching)) and right < int(len(next_rows))
                if matching[left] == next_rows[right]
                    intersection = intersection.append(matching[left])
                    left += 1
                    right += 1
                elif matching[left] < next_rows[right]
                    left += 1
                else
                    right += 1
            matching = intersection
            if len(matching) == 0
                break
        return int(len(matching))

map.Map<string, int> count_supports(Counter counter, string[][] candidates)
    map.Map<string, int> result
    for string[] items = candidates[]
        .result.set(items.join("+"), counter.support(items))
    return result
