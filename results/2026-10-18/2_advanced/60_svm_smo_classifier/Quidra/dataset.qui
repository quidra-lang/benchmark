int integer(string text)
    int result = int.parse(text)
    return result

real64 number(string text)
    real64 result = real64.parse(text)
    return result

string[] lines(string path)
    string content = file.read(path)
    string[] rows = content.split(NL)
    return rows[0:<int(len(rows)) - 1]

class Example(string id, real64[] point, int label)
class Kernel(string name, string kind, int degree, real64 gamma, real64 coef0)
class Params(real64[] c_grid, Kernel[] kernels, real64 tolerance, real64 eps, int max_passes, int fold_count, int[] learning_curve, int newton_iterations, string multiclass_name, real64 multiclass_c, real64 regularization, int pegasos_iterations, int seed, real64[] plot_x, real64[] plot_y, int[] plot_size)

Example[] read_binary(string name)
    Example[] result = []
    string[] rows = lines("input/" + name)
    for string row = rows[1:<int(len(rows))][]
        string[] fields = row.split(",")
        result = result.append(Example(fields[0], [number(fields[1]), number(fields[2])], integer(fields[3])))
    return result

Params read_settings()
    real64[] c_grid = []
    Kernel[] kernels = []
    real64 tolerance = 0.0
    real64 eps = 0.0
    int max_passes = 0
    int fold_count = 0
    int[] learning_curve = []
    int newton_iterations = 0
    string multiclass_name = ""
    real64 multiclass_c = 0.0
    real64 regularization = 0.0
    int pegasos_iterations = 0
    int seed = 0
    real64[] plot_x = []
    real64[] plot_y = []
    int[] plot_size = []
    for string row = lines("input/params.txt")[]
        string[] fields = row.split(" ")
        string key = fields[0]
        if key == "C_GRID"
            c_grid = [for string text = fields[1:<int(len(fields))][] then number(text)]
        elif key == "KERNEL"
            string kind = fields[2]
            int degree = if kind == "poly" then integer(fields[3]) else 1
            real64 gamma = if kind == "poly" then number(fields[4]) elif kind == "rbf" then number(fields[3]) else 0.0
            real64 coef0 = if kind == "poly" then number(fields[5]) else 0.0
            kernels = kernels.append(Kernel(fields[1], kind, degree, gamma, coef0))
        elif key == "TOLERANCE"
            tolerance = number(fields[1])
        elif key == "EPS"
            eps = number(fields[1])
        elif key == "MAX_PASSES"
            max_passes = integer(fields[1])
        elif key == "FOLDS"
            fold_count = integer(fields[1])
        elif key == "LEARNING_CURVE"
            learning_curve = [for string text = fields[1:<int(len(fields))][] then integer(text)]
        elif key == "NEWTON_ITERATIONS"
            newton_iterations = integer(fields[1])
        elif key == "MULTICLASS"
            multiclass_name = fields[1]
            multiclass_c = number(fields[2])
        elif key == "PEGASOS"
            regularization = number(fields[1])
            pegasos_iterations = integer(fields[2])
            seed = integer(fields[3])
        elif key == "PLOT_X"
            plot_x = [number(fields[1]), number(fields[2])]
        elif key == "PLOT_Y"
            plot_y = [number(fields[1]), number(fields[2])]
        else
            plot_size = [integer(fields[1]), integer(fields[2])]
    return Params(c_grid, kernels, tolerance, eps, max_passes, fold_count, learning_curve, newton_iterations, multiclass_name, multiclass_c, regularization, pegasos_iterations, seed, plot_x, plot_y, plot_size)

class Input(Example[] training, Example[] testing, Example[] multi_training, Example[] multi_testing, Params params)

Input read_inputs()
    Example[] multi_training = []
    Example[] multi_testing = []
    string[] rows = lines("input/multiclass.csv")
    for string row = rows[1:<int(len(rows))][]
        string[] fields = row.split(",")
        Example example = Example(fields[0], [number(fields[1]), number(fields[2])], integer(fields[3]))
        if fields[4] == "train"
            multi_training = multi_training.append(example)
        else
            multi_testing = multi_testing.append(example)
    return Input(read_binary("train.csv"), read_binary("test.csv"), multi_training, multi_testing, read_settings())
