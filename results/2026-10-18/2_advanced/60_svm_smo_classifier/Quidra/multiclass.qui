import kernels = "./kernels.qui"
import smo = "./smo.qui"

int[][] pairs()
    return [[1, 2], [1, 3], [2, 3]]
class Classification(real64[] ovr_values, real64[] ovo_values, int ovr, int ovo, int[] votes, bool tied)
class Models(smo.Model[] ovr_models, smo.Model[] ovo_models)
    Classification classify(real64[] point)
        rest_values := [for model := ovr_models[] then model.decision(point)]
        rest_prediction := 0
        for: 1 <= i < 3
            if rest_values[i] > rest_values[rest_prediction]
                rest_prediction = i
        real64[] pair_values := []
        votes := [0, 0, 0]
        real64[] scores := [0.0, 0.0, 0.0]
        class_pairs := pairs()
        for: i < 3
            first := class_pairs[i][0] - 1
            second := class_pairs[i][1] - 1
            value := ovo_models[i].decision(point)
            pair_values = pair_values.append(value)
            votes[if value > 0.0 then first else second] += 1
            scores[first] += value
            scores[second] -= value
        most_votes := votes[0]
        for vote := votes[]
            if vote > most_votes
                most_votes = vote
        prediction := -1
        candidates := 0
        for: i < 3
            if votes[i] == most_votes
                candidates += 1
                if prediction < 0 or scores[i] > scores[prediction]
                    prediction = i
        return Classification(rest_values, pair_values, rest_prediction + 1, prediction + 1, votes, candidates > 1)

Models train(real64[][] points, int[] classes, string kind, int degree, real64 gamma, real64 coef0, real64 coefficient, real64 tolerance, real64 eps, int max_passes)
    matrix := kernels.matrix(kind, degree, gamma, coef0, points)
    smo.Model[] rest := []
    for: 1 <= class_number <= 3
        labels := [for value := classes[] then (if value == class_number then 1 else -1)]
        rest = rest.append(smo.train(points, labels, kind, degree, gamma, coef0, matrix, coefficient, tolerance, eps, max_passes))
    smo.Model[] paired := []
    for pair := pairs()[]
        int[] indices := []
        for: i < int(#points)
            if classes[i] == pair[0] or classes[i] == pair[1]
                indices = indices.append(i)
        pair_points := [for i := indices[] then points[i]]
        labels := [for i := indices[] then (if classes[i] == pair[0] then 1 else -1)]
        paired = paired.append(smo.train(pair_points, labels, kind, degree, gamma, coef0, kernels.submatrix(matrix, indices), coefficient, tolerance, eps, max_passes))
    return Models(rest, paired)
