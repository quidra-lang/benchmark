import math
import evaluation = "./evaluation.qui"

real64 value(string kind, int degree, real64 gamma, real64 coef0, real64[] first, real64[] second)
    if kind == "rbf"
        real64 e1 = first[0] - second[0]
        real64 e2 = first[1] - second[1]
        return math.exp(-gamma * (e1 * e1 + e2 * e2))
    real64 dot = first[0] * second[0] + first[1] * second[1]
    if kind == "linear"
        return dot
    real64 factor = gamma * dot + coef0
    real64 result = 1.0
    for int i < degree
        result *= factor
    return result

string description(string kind, int degree, real64 gamma, real64 coef0)
    if kind == "linear"
        return "linear"
    if kind == "rbf"
        return "rbf gamma " + evaluation.fixed(gamma)
    return "poly degree {degree} gamma " + evaluation.fixed(gamma) + " coef0 " + evaluation.fixed(coef0)

real64[][] matrix(string kind, int degree, real64 gamma, real64 coef0, real64[][] points)
    return [for real64[] first = points[] then [for real64[] second = points[] then value(kind, degree, gamma, coef0, first, second)]]

real64[][] submatrix(real64[][] values, int[] indices)
    return [for int i = indices[] then [for int j = indices[] then values[i][j]]]
