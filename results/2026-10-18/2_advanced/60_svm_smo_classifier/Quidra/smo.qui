import kernels = "./kernels.qui"

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

real64 minimum(real64 first, real64 second)
    return if first < second then first else second

real64 maximum(real64 first, real64 second)
    return if first > second then first else second

class Pass(bool full, int examined, int changed, real64[] alpha)
class Model(real64[][] points, int[] labels, string kind, int degree, real64 gamma, real64 coef0, real64[][] matrix, real64 coefficient, real64 tolerance, real64 eps, int max_passes)
    real64[] alpha = [for real64[] point = points[] then 0.0]
    real64 b = 0.0
    real64[] errors = [for int label = labels[] then -real64(label)]
    int full_passes = 0
    int nonbound_passes = 0
    int examined = 0
    int steps = 0
    int[] choices = [0, 0, 0]
    int[] clipping = [0, 0, 0]
    Pass[] records = []
    bool converged = false

    int passes()
        return full_passes + nonbound_passes

    bool nonbound(int index)
        return alpha[index] > 0.0 and alpha[index] < coefficient

    real64 snap(real64 value)
        return if value < 0.00000001 then 0.0 elif value > coefficient - 0.00000001 then coefficient else value

    bool .take(int first, int second)
        if first == second
            return false
        real64 alpha1 = alpha[first]
        real64 alpha2 = alpha[second]
        real64 y1 = real64(labels[first])
        real64 y2 = real64(labels[second])
        real64 error1 = errors[first]
        real64 error2 = errors[second]
        real64 lower = if y1 != y2 then maximum(0.0, alpha2 - alpha1) else maximum(0.0, alpha2 + alpha1 - coefficient)
        real64 upper = if y1 != y2 then minimum(coefficient, coefficient + alpha2 - alpha1) else minimum(coefficient, alpha2 + alpha1)
        if lower == upper
            return false
        real64 k11 = matrix[first][first]
        real64 k12 = matrix[first][second]
        real64 k22 = matrix[second][second]
        real64 eta = k11 + k22 - 2.0 * k12
        if eta <= 0.0
            return false
        real64 a2 = alpha2 + y2 * (error1 - error2) / eta
        int clip = 0
        if a2 < lower
            a2 = lower
            clip = 1
        elif a2 > upper
            a2 = upper
            clip = 2
        a2 = snap(a2)
        if absolute(a2 - alpha2) < eps * (a2 + alpha2 + eps)
            return false
        real64 a1 = snap(alpha1 + y1 * y2 * (alpha2 - a2))
        real64 t1 = y1 * (a1 - alpha1)
        real64 t2 = y2 * (a2 - alpha2)
        real64 b1 = error1 + t1 * k11 + t2 * k12 + b
        real64 b2 = error2 + t1 * k12 + t2 * k22 + b
        real64 threshold = if a1 > 0.0 and a1 < coefficient then b1 elif a2 > 0.0 and a2 < coefficient then b2 else (b1 + b2) / 2.0
        real64 delta = threshold - b
        for int i < int(len(points))
            errors[i] += t1 * matrix[first][i] + t2 * matrix[second][i] - delta
        if a1 > 0.0 and a1 < coefficient
            errors[first] = 0.0
        if a2 > 0.0 and a2 < coefficient
            errors[second] = 0.0
        alpha[first] = a1
        alpha[second] = a2
        b = threshold
        steps += 1
        clipping[clip] += 1
        return true

    int .examine(int second)
        examined += 1
        real64 residual = errors[second] * real64(labels[second])
        if not ((residual < -tolerance and alpha[second] < coefficient) or (residual > tolerance and alpha[second] > 0.0))
            return 0
        int partner = -1
        real64 largest_difference = -1.0
        for int i < int(len(points))
            if i != second and nonbound(i)
                real64 difference = absolute(errors[i] - errors[second])
                if difference > largest_difference
                    largest_difference = difference
                    partner = i
        if partner >= 0 and .take(partner, second)
            choices[0] += 1
            return 1
        for int first < int(len(points))
            if nonbound(first) and .take(first, second)
                choices[1] += 1
                return 1
        for int first < int(len(points))
            if .take(first, second)
                choices[2] += 1
                return 1
        return 0

    void .fit()
        bool all = true
        while true
            int examined_before = examined
            int changed = 0
            for int i < int(len(points))
                if all or nonbound(i)
                    changed += .examine(i)
            if all
                full_passes += 1
            else
                nonbound_passes += 1
            records = records.append(Pass(all, examined - examined_before, changed, (if all then alpha else [])))
            if all and changed == 0
                converged = true
                break
            if passes() == max_passes
                break
            if all
                all = false
            elif changed == 0
                all = true

    real64 decision(real64[] point)
        real64 total = 0.0
        for int i < int(len(alpha))
            if alpha[i] > 0.0
                total += alpha[i] * real64(labels[i]) * kernels.value(kind, degree, gamma, coef0, points[i], point)
        return total - b

    real64[] training_decisions()
        real64[] result = []
        for real64[] row = matrix[]
            real64 total = 0.0
            for int i < int(len(alpha))
                if alpha[i] > 0.0
                    total += alpha[i] * real64(labels[i]) * row[i]
            result = result.append(total - b)
        return result

Model train(real64[][] points, int[] labels, string kind, int degree, real64 gamma, real64 coef0, real64[][] matrix, real64 coefficient, real64 tolerance, real64 eps, int max_passes)
    Model result = Model(points, labels, kind, degree, gamma, coef0, matrix, coefficient, tolerance, eps, max_passes)
    .result.fit()
    return result
