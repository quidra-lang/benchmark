import variable = "./variable_charts.qui"

class Zones(local variable.Limits limits)
    real64 lcl = limits.lcl
    real64 cl = limits.cl
    real64 ucl = limits.ucl
    local real64 upper_step = (ucl - cl) / 3.0
    local real64 lower_step = (cl - lcl) / 3.0
    real64 u1 = cl + upper_step
    real64 u2 = cl + 2.0 * upper_step
    real64 l1 = cl - lower_step
    real64 l2 = cl - 2.0 * lower_step

class Signal(string chart, string rule, int start, int end, real64 value, string direction)

string evaluate_rule(int rule, real64[] window, Zones zones)
    real64 last = window[len(window) - 1]
    if rule == 1
        if last > zones.ucl or last < zones.lcl
            return if last > zones.cl then "UP" else "DOWN"
        return ""
    if rule == 2 or rule == 3
        real64 upper = if rule == 2 then zones.u2 else zones.u1
        real64 lower = if rule == 2 then zones.l2 else zones.l1
        int needed = if rule == 2 then 2 else 4
        int above = 0
        int below = 0
        for real64 value = window[]
            if value > upper
                above += 1
            if value < lower
                below += 1
        if last > upper and above >= needed
            return "UP"
        if last < lower and below >= needed
            return "DOWN"
        return ""
    bool upward = true
    bool downward = true
    bool alternating = true
    bool inside = true
    bool outside = true
    bool has_upper = false
    bool has_lower = false
    for nat index < len(window)
        real64 value = window[index]
        if rule == 4
            upward = upward and value > zones.cl
            downward = downward and value < zones.cl
        elif rule == 5 and index > 0
            upward = upward and value > window[index - 1]
            downward = downward and value < window[index - 1]
        if index > 0
            real64 difference = value - window[index - 1]
            if difference == 0.0
                alternating = false
            if index > 1
                real64 previous = window[index - 1] - window[index - 2]
                if (difference > 0.0) == (previous > 0.0)
                    alternating = false
        inside = inside and value > zones.l1 and value < zones.u1
        outside = outside and (value > zones.u1 or value < zones.l1)
        has_upper = has_upper or value > zones.u1
        has_lower = has_lower or value < zones.l1
    if rule == 4 or rule == 5
        if upward
            return "UP"
        if downward
            return "DOWN"
    if rule == 6 and alternating
        return "NONE"
    if rule == 7 and inside
        return "NONE"
    if rule == 8 and outside and has_upper and has_lower
        return "NONE"
    return ""

Signal[] check_rules(string chart, int[] numbers, real64[] values, variable.Limits limits, int[] selected)
    int[] lengths = [1, 3, 5, 8, 6, 14, 15, 8]
    Zones zones = Zones(limits)
    Signal[] result = []
    for 1 <= int count <= int(len(values))
        for int rule = selected[]
            int width = lengths[rule - 1]
            if count >= width
                string side = evaluate_rule(rule, values[count - width:<count], zones)
                if side != ""
                    result = result.append(Signal(chart, rule.string(), numbers[count - width], numbers[count - 1], values[count - 1], side))
    return result

string zone_name(Zones zones, real64 value)
    if value > zones.ucl
        return "OUT+"
    if value < zones.lcl
        return "OUT-"
    if value > zones.u2
        return "A+"
    if value > zones.u1
        return "B+"
    if value > zones.cl
        return "C+"
    if value < zones.l2
        return "A-"
    if value < zones.l1
        return "B-"
    if value < zones.cl
        return "C-"
    return "C0"
