class Reference(int object_index, int index)
class Section(string name, int alignment, int size, int[] data = [], string discard = "", int output = -1, bool live = false, int address = 0, map.Map<int, int> strings = map.Map<int, int>())
class Definition(string kind, int section = -1, int offset = 0, int size = 0, int alignment = 1)
class Symbol(string name, string binding, Definition definition)
class Relocation(int section, int offset, string kind, int symbol, int addend)
class Group(string signature, int[] sections)
class Object(string name, Section[] sections = [], Group[] groups = [], Symbol[] symbols = [], Relocation[] relocations = [])

bool belongs(string name, string output)
    return name == output or name.starts_with(output + ".")

bool nobits(string name)
    return belongs(name, ".bss")

bool string_section(string name)
    return belongs(name, ".rodata.str")

string[] read_lines(string name)
    string text = file.read("input/{name}")
    string[] result = text.split(NL)
    return result[0:<int(len(result)) - 1]

int hex_number(string text)
    int result = 0
    for int index < int(len(text))
        string character = text[index]
        int code = character.codepoints()[0]
        result = result * 16 + (if code <= 57 then code - 48 else code - 87)
    return result

int section_index(const Object object_file, string name)
    for int index < int(len(object_file.sections))
        if object_file.sections[index].name == name
            return index
    return -1

int symbol_index(const Object object_file, string name)
    for int index < int(len(object_file.symbols))
        if object_file.symbols[index].name == name
            return index
    return -1

Object parse(string name, const string[] lines)
    Object result = Object(name)
    for string line = lines[]
        string[] fields = line.split(" ")
        if fields[0] == "section"
            result.sections = result.sections.append(Section(fields[1], int.parse(fields[2]), int.parse(fields[3])))
        elif fields[0] == "data"
            int last = int(len(result.sections)) - 1
            for int index < int(len(fields[1])) step 2
                result.sections[last].data = result.sections[last].data.append(hex_number(fields[1][index:<index + 2]))
        elif fields[0] == "comdat"
            int[] indices = []
            for string section_name = fields[2:<int(len(fields))][]
                indices = indices.append(section_index(result, section_name))
            result.groups = result.groups.append(Group(fields[1], indices))
        elif fields[0] == "symbol"
            Definition definition = Definition("undefined")
            if fields[3] == "common"
                definition = Definition("common", size = int.parse(fields[4]), alignment = int.parse(fields[5]))
            elif fields[3] != "undef"
                definition = Definition("section", section_index(result, fields[3]), int.parse(fields[4]))
            result.symbols = result.symbols.append(Symbol(fields[1], fields[2], definition))
        elif fields[0] == "reloc"
            result.relocations = result.relocations.append(Relocation(section_index(result, fields[1]), int.parse(fields[2]), fields[3], symbol_index(result, fields[4]), int.parse(fields[5])))
    return result
