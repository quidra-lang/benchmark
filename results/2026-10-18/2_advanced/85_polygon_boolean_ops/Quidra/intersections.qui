import rational = "./rational.qui"

bool on(rational.Point first, rational.Point second, rational.Point point)
    rational.Point left = if rational.x_less(first, second) then first else second
    rational.Point right = if rational.x_less(first, second) then second else first
    rational.Point low = if rational.y_less(first, second) then first else second
    rational.Point high = if rational.y_less(first, second) then second else first
    return rational.cross(first, second, point) == 0 and not rational.x_less(point, left) and not rational.x_less(right, point) and not rational.y_less(point, low) and not rational.y_less(high, point)

bool opposite(int first, int second)
    return (first < 0 and second > 0) or (first > 0 and second < 0)

bool touch(rational.Point first, rational.Point second, rational.Point third, rational.Point fourth)
    bool proper_crossing = opposite(rational.cross(first, second, third), rational.cross(first, second, fourth)) and opposite(rational.cross(third, fourth, first), rational.cross(third, fourth, second))
    return proper_crossing or on(first, second, third) or on(first, second, fourth) or on(third, fourth, first) or on(third, fourth, second)

bool overlap(rational.Point first, rational.Point second, rational.Point third, rational.Point fourth)
    if rational.cross(first, second, third) != 0 or rational.cross(first, second, fourth) != 0
        return false
    bool horizontal = first.x * second.denominator != second.x * first.denominator
    rational.Fraction first_value = rational.Fraction(if horizontal then first.x else first.y, first.denominator)
    rational.Fraction second_value = rational.Fraction(if horizontal then second.x else second.y, second.denominator)
    rational.Fraction third_value = rational.Fraction(if horizontal then third.x else third.y, third.denominator)
    rational.Fraction fourth_value = rational.Fraction(if horizontal then fourth.x else fourth.y, fourth.denominator)
    rational.Fraction lower_a = if first_value.less(second_value) then first_value else second_value
    rational.Fraction upper_a = if first_value.less(second_value) then second_value else first_value
    rational.Fraction lower_b = if third_value.less(fourth_value) then third_value else fourth_value
    rational.Fraction upper_b = if third_value.less(fourth_value) then fourth_value else third_value
    rational.Fraction lower = if lower_a.less(lower_b) then lower_b else lower_a
    rational.Fraction upper = if upper_a.less(upper_b) then upper_a else upper_b
    return lower.less(upper)

class Line(int horizontal, int vertical, int constant)

Line line(rational.Point first, rational.Point second)
    int horizontal = first.y * second.denominator - first.denominator * second.y
    int vertical = first.denominator * second.x - first.x * second.denominator
    int constant = first.x * second.y - first.y * second.x
    int divisor = rational.gcd(rational.gcd(horizontal, vertical), constant)
    return Line(horizontal / divisor, vertical / divisor, constant / divisor)

rational.Point line_intersection(rational.Point first, rational.Point second, rational.Point third, rational.Point fourth)
    Line left = line(first, second)
    Line right = line(third, fourth)
    return rational.Point(left.vertical * right.constant - left.constant * right.vertical, left.constant * right.horizontal - left.horizontal * right.constant, left.horizontal * right.vertical - left.vertical * right.horizontal)

class Crossing(rational.Point point, rational.Fraction position_a, rational.Fraction position_b)

Crossing | none crossing(rational.Point first, rational.Point second, rational.Point third, rational.Point fourth)
    int horizontal_a = second.x - first.x
    int vertical_a = second.y - first.y
    int horizontal_b = fourth.x - third.x
    int vertical_b = fourth.y - third.y
    int denominator = horizontal_a * vertical_b - vertical_a * horizontal_b
    if denominator == 0
        return none
    int horizontal_gap = third.x - first.x
    int vertical_gap = third.y - first.y
    int numerator_a = horizontal_gap * vertical_b - vertical_gap * horizontal_b
    int numerator_b = horizontal_gap * vertical_a - vertical_gap * horizontal_a
    if denominator < 0
        denominator = -denominator
        numerator_a = -numerator_a
        numerator_b = -numerator_b
    if numerator_a <= 0 or numerator_a >= denominator or numerator_b <= 0 or numerator_b >= denominator
        return none
    rational.Point point = rational.Point(first.x * denominator + numerator_a * horizontal_a, first.y * denominator + numerator_a * vertical_a, denominator)
    return Crossing(point, rational.Fraction(numerator_a, denominator), rational.Fraction(numerator_b, denominator))

string segment(rational.Point first, rational.Point second)
    return "{first.text()}-{second.text()}"
