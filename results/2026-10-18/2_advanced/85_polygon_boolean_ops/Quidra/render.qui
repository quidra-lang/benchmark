import rational = "./rational.qui"
import rings = "./rings.qui"

class Drawing(string[] lines, int[] counts)

Drawing draw(const rational.Point[][][] region, const rational.Point[][] operand_a, const rational.Point[][] operand_b, bool binary, const int[] settings)
    int origin_x = settings[0]
    int origin_y = settings[1]
    int width = settings[2]
    int height = settings[3]
    int columns = settings[4]
    int row_count = settings[5]
    rational.Point[][] all_rings = rings.flatten(region)
    string[] lines = []
    int[] counts = [0, 0, 0, 0]
    for int row < row_count
        string text = ""
        for int column < columns
            rational.Point center = rational.Point(2 * origin_x + (2 * column + 1) * width, 2 * origin_y + (2 * (row_count - 1 - row) + 1) * height, 2)
            if rings.interior(center, all_rings)
                counts[0] += 1
                text += "#"
            elif binary
                bool first = rings.interior(center, operand_a)
                bool second = rings.interior(center, operand_b)
                if first and second
                    counts[3] += 1
                    text += "+"
                elif first
                    counts[1] += 1
                    text += "a"
                elif second
                    counts[2] += 1
                    text += "b"
                else
                    text += "."
            else
                text += "."
        lines = lines.append(text)
    return Drawing(lines, counts)
