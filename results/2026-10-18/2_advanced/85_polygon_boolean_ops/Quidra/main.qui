import rational = "./rational.qui"
import intersections = "./intersections.qui"
import rings = "./rings.qui"
import gh = "./greiner_hormann.qui"
import render = "./render.qui"

class Polygon(rational.Point[][] input_rings, rational.Point[][] canonical)
class Target(rational.Point[][][] region, bool binary = false, rational.Point[][] operand_a = [], rational.Point[][] operand_b = [])
class Definition(string name, Polygon polygon)
class SourceLine(int number, string text)

bool digits(string text)
    if len(text) == 0
        return false
    for int position < int(len(text))
        if text[position] < "0" or text[position] > "9"
            return false
    return true

int | none integer_word(string text)
    string body = text
    if body.starts_with("-")
        body = body[1:<int(len(body))]
    if len(body) > 9 or not digits(body)
        return none
    int value = int.parse(text)
    return value

int integer_value(string text)
    int value = int.parse(text)
    return value

bool valid_name(string text)
    if len(text) == 0 or len(text) > 16
        return false
    for int index < int(len(text))
        string character = text[index]
        if not (("a" <= character <= "z") or ("0" <= character <= "9") or character == "_")
            return false
    return true

string | none validate(const rational.Point[][] input_rings)
    for int ring_index < int(len(input_rings))
        rational.Point[] ring = input_rings[ring_index]
        int count = int(len(ring))
        int number = ring_index + 1
        if count < 3
            return "too_few_vertices ring {number}"
        for rational.Point point = ring[]
            if point.x < 0 or point.y < 0 or point.x > 1000 * point.denominator or point.y > 1000 * point.denominator
                return "out_of_range ring {number} {point.text()}"
        rational.Point[] seen = []
        for rational.Point point = ring[]
            if rational.has(seen, point)
                return "duplicate_vertex ring {number} {point.text()}"
            seen = seen.append(point)
        for int index < count
            if rational.cross(ring[(index + count - 1) % count], ring[index], ring[(index + 1) % count]) == 0
                return "collinear ring {number} {ring[index].text()}"
        for int first_edge < count
            for first_edge + 1 <= int second_edge < count
                if second_edge == first_edge + 1 or (first_edge == 0 and second_edge == count - 1)
                    continue
                rational.Point first_start = ring[first_edge]
                rational.Point first_end = ring[(first_edge + 1) % count]
                rational.Point second_start = ring[second_edge]
                rational.Point second_end = ring[(second_edge + 1) % count]
                if intersections.touch(first_start, first_end, second_start, second_end)
                    return "self_intersection ring {number} {intersections.segment(first_start, first_end)} {intersections.segment(second_start, second_end)}"
    for int first_ring < int(len(input_rings))
        for first_ring + 1 <= int second_ring < int(len(input_rings))
            rational.Point[] first = input_rings[first_ring]
            rational.Point[] second = input_rings[second_ring]
            for int first_edge < int(len(first))
                for int second_edge < int(len(second))
                    rational.Point first_start = first[first_edge]
                    rational.Point first_end = first[(first_edge + 1) % int(len(first))]
                    rational.Point second_start = second[second_edge]
                    rational.Point second_end = second[(second_edge + 1) % int(len(second))]
                    if intersections.touch(first_start, first_end, second_start, second_end)
                        return "rings_touch rings {first_ring + 1} {second_ring + 1} {intersections.segment(first_start, first_end)} {intersections.segment(second_start, second_end)}"
    for 1 <= int hole < int(len(input_rings))
        if not rings.inside(input_rings[hole][0], input_rings[0])
            return "hole_outside ring {hole + 1} {input_rings[hole][0].text()}"
    for 1 <= int first_hole < int(len(input_rings))
        for first_hole + 1 <= int second_hole < int(len(input_rings))
            if rings.inside(input_rings[second_hole][0], input_rings[first_hole])
                return "hole_in_hole rings {first_hole + 1} {second_hole + 1} {input_rings[second_hole][0].text()}"
            if rings.inside(input_rings[first_hole][0], input_rings[second_hole])
                return "hole_in_hole rings {first_hole + 1} {second_hole + 1} {input_rings[first_hole][0].text()}"
    return none

rational.Point[][] | error parse_block(const SourceLine[] content, int end_line)
    rational.Point[][] input_rings = []
    int index = 0
    while index < int(len(content))
        SourceLine header = content[index]
        string[] words = header.text.split(" ")
        if len(words) != 2
            return error("format line {header.number}")
        bool appropriate = (words[0] == "OUTER" and len(input_rings) == 0) or (words[0] == "HOLE" and len(input_rings) > 0)
        if not appropriate or len(words[1]) > 9 or not digits(words[1])
            return error("format line {header.number}")
        int vertex_count = integer_value(words[1])
        if vertex_count <= 0
            return error("format line {header.number}")
        index += 1
        rational.Point[] ring = []
        for int vertex_index < vertex_count
            if index == int(len(content))
                return error("format line {end_line}")
            SourceLine vertex_line = content[index]
            string[] coordinates = vertex_line.text.split(" ")
            if len(coordinates) != 2
                return error("format line {vertex_line.number}")
            int horizontal
            int vertical
            match integer_word(coordinates[0])
                int parsed_x
                    horizontal = parsed_x
                none
                    return error("format line {vertex_line.number}")
            match integer_word(coordinates[1])
                int parsed_y
                    vertical = parsed_y
                none
                    return error("format line {vertex_line.number}")
            ring = ring.append(rational.Point(horizontal, vertical))
            index += 1
        input_rings = input_rings.append(ring)
    if len(input_rings) == 0
        return error("format line {end_line}")
    return input_rings

Polygon | error checked_polygon(const rational.Point[][] input_rings)
    match validate(input_rings)
        string reason
            return error(reason)
        none
            return Polygon(input_rings, rings.canonical(input_rings))

Polygon | error block_polygon(const SourceLine[] content, int end_line)
    rational.Point[][] input_rings = try parse_block(content, end_line)
    return checked_polygon(input_rings)

class Polygons()
    set.Set<string> used = set.Set<string>()
    map.Map<string, Polygon> valid = map.Map<string, Polygon>()
    string[] rejected = []
    int blocks = 0
    int valid_blocks = 0

Polygons read_polygons()
    string text = file.read("input/polygons.txt")
    string[] lines = text.split(NL)
    Polygons collection = Polygons()
    int index = 0
    while index < int(len(lines))
        if lines[index] == "" or lines[index].starts_with("#")
            index += 1
            continue
        string[] start_words = lines[index].split(" ")
        string name = start_words[1]
        int start_line = index + 1
        index += 1
        SourceLine[] content = []
        while lines[index] != "END"
            if lines[index] != "" and not lines[index].starts_with("#")
                content = content.append(SourceLine(index + 1, lines[index]))
            index += 1
        int end_line = index + 1
        index += 1
        collection.blocks += 1
        if collection.used.has(name)
            collection.rejected = collection.rejected.append("polygon {name} duplicate_name line {start_line}")
            continue
        .collection.used.add(name)
        match block_polygon(content, end_line)
            Polygon polygon
                .collection.valid.set(name, polygon)
                collection.valid_blocks += 1
            error problem
                collection.rejected = collection.rejected.append("polygon {name} {problem.message}")
    return collection

Polygon | error resolve_polygon(const Polygons collection, string name)
    if not collection.used.has(name)
        return error("unknown_polygon {name}")
    match collection.valid.get(name)
        Polygon polygon
            return polygon
        none
            return error("invalid_polygon {name}")

Target | error resolve_target(string text, const Polygons collection, const map.Map<int, Target> results)
    if text.starts_with("@")
        string suffix = text[1:<int(len(text))]
        if len(suffix) > 9 or not digits(suffix)
            return error("bad_target {text}")
        int number = integer_value(suffix)
        match results.get(number)
            Target found
                return found
            none
                return error("bad_target {text}")
    Polygon polygon = try resolve_polygon(collection, text)
    return Target([polygon.canonical])

string | none general(const rational.Point[][] first, const rational.Point[][] second, string first_name, string second_name)
    for rational.Point[] first_ring = first[]
        for rational.Point point = first_ring[]
            for rational.Point[] second_ring = second[]
                if rational.has(second_ring, point)
                    return "shared_vertex {point.text()}"
    for rational.Point[] first_ring = first[]
        for int first_edge < int(len(first_ring))
            for rational.Point[] second_ring = second[]
                for int second_edge < int(len(second_ring))
                    rational.Point first_start = first_ring[first_edge]
                    rational.Point first_end = first_ring[(first_edge + 1) % int(len(first_ring))]
                    rational.Point second_start = second_ring[second_edge]
                    rational.Point second_end = second_ring[(second_edge + 1) % int(len(second_ring))]
                    if intersections.overlap(first_start, first_end, second_start, second_end)
                        return "overlapping_edges {intersections.segment(first_start, first_end)} {intersections.segment(second_start, second_end)}"
    for int side < 2
        rational.Point[][] vertices = if side == 0 then first else second
        rational.Point[][] edges = if side == 0 then second else first
        string vertex_name = if side == 0 then first_name else second_name
        string edge_name = if side == 0 then second_name else first_name
        for rational.Point[] vertex_ring = vertices[]
            for rational.Point point = vertex_ring[]
                for rational.Point[] edge_ring = edges[]
                    for int edge_index < int(len(edge_ring))
                        rational.Point edge_start = edge_ring[edge_index]
                        rational.Point edge_end = edge_ring[(edge_index + 1) % int(len(edge_ring))]
                        if intersections.on(edge_start, edge_end, point)
                            return "vertex_on_edge {vertex_name} {point.text()} {edge_name} {intersections.segment(edge_start, edge_end)}"
    return none

bool convex(const rational.Point[][] input_rings)
    if len(input_rings) != 1
        return false
    rational.Point[] ring = input_rings[0]
    int count = int(len(ring))
    for int index < count
        if rational.cross(ring[(index + count - 1) % count], ring[index], ring[(index + 1) % count]) <= 0
            return false
    return true

rational.Point[][] clip(const rational.Point[][] input_rings, const rational.Point[] window)
    rational.Point[][] result = []
    for rational.Point[] source_ring = input_rings[]
        rational.Point[] points = source_ring
        for int edge < int(len(window))
            rational.Point first = window[edge]
            rational.Point second = window[(edge + 1) % int(len(window))]
            rational.Point[] next_points = []
            for int index < int(len(points))
                rational.Point previous = points[(index + int(len(points)) - 1) % int(len(points))]
                rational.Point current = points[index]
                bool previous_inside = rational.cross(first, second, previous) > 0
                bool current_inside = rational.cross(first, second, current) > 0
                if previous_inside != current_inside
                    next_points = next_points.append(intersections.line_intersection(previous, current, first, second))
                if current_inside
                    next_points = next_points.append(current)
            points = next_points
        rational.Point[] clean = []
        for int index < int(len(points))
            if points[index] != points[(index + int(len(points)) - 1) % int(len(points))]
                clean = clean.append(points[index])
        if len(clean) >= 3
            result = result.append(clean)
    return result

bool cyclic(const rational.Point[] first, const rational.Point[] second)
    if len(first) != len(second)
        return false
    for int offset < int(len(second))
        bool equal = true
        for int index < int(len(first))
            if first[index] != second[(index + offset) % int(len(second))]
                equal = false
                break
        if equal
            return true
    return false

string locate(const rational.Point[][][] region, rational.Point point)
    for int polygon_index < int(len(region))
        rational.Point[][] polygon = region[polygon_index]
        for int ring_index < int(len(polygon))
            if rings.boundary(point, polygon[ring_index])
                if ring_index == 0
                    return "boundary outer {polygon_index + 1}"
                return "boundary hole {polygon_index + 1} {ring_index}"
    for int polygon_index < int(len(region))
        rational.Point[][] polygon = region[polygon_index]
        if not rings.inside(point, polygon[0])
            continue
        bool hole = false
        for 1 <= int ring_index < int(len(polygon))
            hole = hole or rings.inside(point, polygon[ring_index])
        if not hole
            return "inside polygon {polygon_index + 1}"
    return "outside"

string operand_location(rational.Point point, const rational.Point[][] input_rings)
    for rational.Point[] ring = input_rings[]
        if rings.boundary(point, ring)
            return "boundary"
    return if rings.interior(point, input_rings) then "inside" else "outside"

rational.Point[] hull_half(const rational.Point[] points)
    rational.Point[] result = []
    for rational.Point point = points[]
        while len(result) >= 2
            int count = int(len(result))
            if rational.cross(result[count - 2], result[count - 1], point) > 0
                break
            result = result[0:<count - 1]
        result = result.append(point)
    return result[0:<int(len(result)) - 1]

rational.Point[] convex_hull(const rational.Point[] ring)
    rational.Point[] ordered = rational.sorted_points(ring, by_x = true)
    rational.Point[] backward = ordered[::-1]
    return hull_half(ordered).concat(hull_half(backward))

int twice_area(const rational.Point[] ring)
    int total = 0
    for int index < int(len(ring))
        rational.Point first = ring[index]
        rational.Point second = ring[(index + 1) % int(len(ring))]
        total += first.x * second.y - second.x * first.y
    return total

bool has_vertex(const rational.Point[][] input_rings, rational.Point point)
    for rational.Point[] ring = input_rings[]
        if rational.has(ring, point)
            return true
    return false

class Values(string[] lines, int ring_count, int hole_count, int vertex_count, real64 area)

Values result_values(const rational.Point[][][] region, const rational.Point[][] operand_a, const rational.Point[][] operand_b)
    int ring_count = 0
    int vertex_count = 0
    for rational.Point[][] polygon = region[]
        ring_count += int(len(polygon))
        for rational.Point[] ring = polygon[]
            vertex_count += int(len(ring))
    int hole_count = ring_count - int(len(region))
    real64 area = rings.total_area(region)
    string[] lines = ["polygons {len(region)} rings {ring_count} holes {hole_count} vertices {vertex_count} area {rational.real_text(area)}"]
    real64 centroid_x = 0.0
    real64 centroid_y = 0.0
    real64 perimeter = 0.0
    int[] origins = [0, 0, 0]
    rational.Point[] points = []
    for int polygon_index < int(len(region))
        rational.Point[][] polygon = region[polygon_index]
        for int ring_index < int(len(polygon))
            rational.Point[] ring = polygon[ring_index]
            string label = if ring_index == 0 then "outer {polygon_index + 1}" else "hole {polygon_index + 1} {ring_index}"
            string[] printed_points = []
            for rational.Point point = ring[]
                printed_points = printed_points.append(point.text())
            lines = lines.append("{label} {len(ring)} {rational.real_text(rings.area(ring))} {printed_points.join(" ")}")
            perimeter += rings.perimeter(ring)
            for int index < int(len(ring))
                rational.Point first = ring[index]
                rational.Point second = ring[(index + 1) % int(len(ring))]
                real64 horizontal = first.real_x()
                real64 vertical = first.real_y()
                real64 next_horizontal = second.real_x()
                real64 next_vertical = second.real_y()
                real64 product = horizontal * next_vertical - next_horizontal * vertical
                centroid_x += (horizontal + next_horizontal) * product
                centroid_y += (vertical + next_vertical) * product
                if has_vertex(operand_a, first)
                    origins[0] += 1
                elif has_vertex(operand_b, first)
                    origins[1] += 1
                else
                    origins[2] += 1
                points = points.append(first)
    if len(points) == 0
        lines = lines.concat(["bbox none", "centroid none"])
    else
        rational.Point minimum_x = points[0]
        rational.Point minimum_y = points[0]
        rational.Point maximum_x = points[0]
        rational.Point maximum_y = points[0]
        for rational.Point point = points[]
            if rational.x_less(point, minimum_x)
                minimum_x = point
            if rational.y_less(point, minimum_y)
                minimum_y = point
            if rational.x_less(maximum_x, point)
                maximum_x = point
            if rational.y_less(maximum_y, point)
                maximum_y = point
        rational.Point low = rational.Point(minimum_x.x * minimum_y.denominator, minimum_y.y * minimum_x.denominator, minimum_x.denominator * minimum_y.denominator)
        rational.Point high = rational.Point(maximum_x.x * maximum_y.denominator, maximum_y.y * maximum_x.denominator, maximum_x.denominator * maximum_y.denominator)
        lines = lines.append("bbox {low.text()} {high.text()}")
        real64 center_x = centroid_x / (6.0 * area)
        real64 center_y = centroid_y / (6.0 * area)
        lines = lines.append("centroid ({rational.real_text(center_x)},{rational.real_text(center_y)})")
    lines = lines.concat(["perimeter {rational.real_text(perimeter)}", "origins a {origins[0]} b {origins[1]} crossing {origins[2]}"])
    return Values(lines, ring_count, hole_count, vertex_count, area)

string[] properties(Polygon polygon, real64 area)
    string[] orientations = []
    for rational.Point[] input_ring = polygon.input_rings[]
        orientations = orientations.append(if twice_area(input_ring) > 0 then "ccw" else "cw")
    int reflex = 0
    for rational.Point[] ring = polygon.canonical[]
        int count = int(len(ring))
        for int index < count
            if rational.cross(ring[(index + count - 1) % count], ring[index], ring[(index + 1) % count]) < 0
                reflex += 1
    rational.Point[] hull = convex_hull(polygon.canonical[0])
    real64 hull_area = real64(twice_area(hull)) / 2.0
    real64 solidity = area / hull_area
    return ["input {orientations.join(" ")}", "reflex {reflex}", "hull {len(hull)} {rational.real_text(hull_area)} solidity {rational.real_text(solidity, 6)}"]

string[] operation_kinds()
    return ["UNION", "INTERSECTION", "DIFFERENCE", "XOR", "CLIP", "AREA", "MOVE", "ROTATE", "MIRROR", "SNAP", "LOCATE", "RENDER"]

bool in_range(string text, int low, int high)
    match integer_word(text)
        int value
            return low <= value <= high
        none
            return false

bool arguments(const string[] words)
    string kind = words[0]
    int expected = 3
    if kind == "AREA"
        expected = 2
    elif kind == "LOCATE"
        expected = 4
    elif kind == "MOVE" or kind == "MIRROR"
        expected = 5
    elif kind == "ROTATE"
        expected = 6
    elif kind == "RENDER"
        expected = 8
    if int(len(words)) != expected
        return false
    if kind == "LOCATE"
        return in_range(words[2], 0, 1000) and in_range(words[3], 0, 1000)
    if kind == "RENDER"
        if not (in_range(words[2], 0, 1000) and in_range(words[3], 0, 1000) and in_range(words[4], 1, 100) and in_range(words[5], 1, 100) and in_range(words[6], 1, 100) and in_range(words[7], 1, 60))
            return false
        return integer_value(words[2]) + integer_value(words[4]) * integer_value(words[6]) <= 1000 and integer_value(words[3]) + integer_value(words[5]) * integer_value(words[7]) <= 1000
    if kind == "MOVE"
        return in_range(words[2], -1000, 1000) and in_range(words[3], -1000, 1000) and valid_name(words[4])
    if kind == "ROTATE"
        return in_range(words[2], 0, 1000) and in_range(words[3], 0, 1000) and in_range(words[4], 1, 3) and valid_name(words[5])
    if kind == "MIRROR"
        return (words[2] == "x" or words[2] == "y") and in_range(words[3], 0, 1000) and valid_name(words[4])
    if kind == "SNAP"
        return valid_name(words[2])
    return true

void | error require_general(const rational.Point[][] first, const rational.Point[][] second, string first_name, string second_name)
    match general(first, second, first_name, second_name)
        string reason
            return error(reason)
        none
            return

Polygon | error transform_polygon(string kind, const string[] words, Polygon original, Target resolved, string new_name)
    rational.Point[][] input_rings = []
    if kind == "SNAP"
        for rational.Point[] target_ring = resolved.region[0][]
            rational.Point[] snapped_ring = []
            for rational.Point target_point = target_ring[]
                snapped_ring = snapped_ring.append(target_point.snapped())
            input_rings = input_rings.append(snapped_ring)
        match validate(input_rings)
            string reason
                return error("invalid_result {reason}")
            none
                return Polygon(input_rings, rings.canonical(input_rings))
    for rational.Point[] original_ring = original.input_rings[]
        rational.Point[] moved_ring = []
        for rational.Point original_point = original_ring[]
            int horizontal = original_point.x
            int vertical = original_point.y
            if kind == "MOVE"
                horizontal += integer_value(words[2])
                vertical += integer_value(words[3])
            elif kind == "ROTATE"
                int center_x = integer_value(words[2])
                int center_y = integer_value(words[3])
                int turns = integer_value(words[4])
                for int turn < turns
                    int next_x = center_x - (vertical - center_y)
                    int next_y = center_y + (horizontal - center_x)
                    horizontal = next_x
                    vertical = next_y
            else
                int reflection_line = integer_value(words[3])
                if words[2] == "x"
                    horizontal = 2 * reflection_line - horizontal
                else
                    vertical = 2 * reflection_line - vertical
            moved_ring = moved_ring.append(rational.Point(horizontal, vertical))
        input_rings = input_rings.append(moved_ring)
    for rational.Point[] transformed_ring = input_rings[]
        for rational.Point transformed_point = transformed_ring[]
            if transformed_point.x < 0 or transformed_point.y < 0 or transformed_point.x > 1000 or transformed_point.y > 1000
                return error("out_of_range {new_name}")
    return Polygon(input_rings, rings.canonical(input_rings))

class Operation(string[] lines)
    string[] area_lines = []
    string[] drawing = []
    Target | none target = none
    Definition | none definition = none
    int crossings = 0

Operation | error operation(int number, string text, const Polygons collection, const map.Map<int, Target> results)
    string[] words = text.split(" ")
    string kind = words[0]
    string[] kinds = operation_kinds()
    if not rational.has(kinds, kind)
        return error("unknown_operation {kind}")
    if not arguments(words)
        return error("bad_arguments")
    bool binary = rational.has(kinds[0:<5], kind)
    bool defining = rational.has(["MOVE", "ROTATE", "MIRROR", "SNAP"], kind)
    Polygon primary = Polygon([], [])
    Polygon secondary = Polygon([], [])
    Target resolved = Target([])
    if binary or rational.has(["AREA", "MOVE", "ROTATE", "MIRROR"], kind)
        primary = try resolve_polygon(collection, words[1])
    if binary
        secondary = try resolve_polygon(collection, words[2])
    if rational.has(["LOCATE", "RENDER", "SNAP"], kind)
        resolved = try resolve_target(words[1], collection, results)
    string new_name = ""
    if defining
        new_name = words[int(len(words)) - 1]
        if collection.used.has(new_name)
            return error("duplicate_name {new_name}")
    if kind == "SNAP" and len(resolved.region) != 1
        return error("not_single {words[1]}")
    if kind == "CLIP" and not convex(secondary.canonical)
        return error("not_convex {words[2]}")
    if binary
        try require_general(primary.canonical, secondary.canonical, words[1], words[2])
    Operation result = Operation(["op {number} {text}"])
    if kind == "LOCATE"
        rational.Point point = rational.Point(integer_value(words[2]), integer_value(words[3]))
        result.lines = result.lines.append("location {locate(resolved.region, point)}")
        if resolved.binary
            result.lines = result.lines.append("operands a {operand_location(point, resolved.operand_a)} b {operand_location(point, resolved.operand_b)}")
        return result
    if kind == "RENDER"
        int[] settings = []
        for 2 <= int index < int(len(words))
            settings = settings.append(integer_value(words[index]))
        render.Drawing rendered = render.draw(resolved.region, resolved.operand_a, resolved.operand_b, resolved.binary, settings)
        int[] counts = rendered.counts
        result.drawing = ["render {number} {words[1]} cols {settings[4]} rows {settings[5]} result {counts[0]} a {counts[1]} b {counts[2]} both {counts[3]}"].concat(rendered.lines)
        result.lines = []
        return result
    Polygon polygon = primary
    if defining
        polygon = try transform_polygon(kind, words, primary, resolved, new_name)
        result.definition = Definition(new_name, polygon)
    rational.Point[][][] region = []
    if binary
        rational.Point[][] first_rings = primary.canonical
        rational.Point[][] second_rings = secondary.canonical
        gh.Graph graph = gh.build(first_rings, second_rings)
        string relation = "overlap"
        if len(graph.ordered) == 0
            if graph.inside_a == int(len(first_rings)) and graph.inside_b == 0
                relation = "within"
            elif graph.inside_b == int(len(second_rings)) and graph.inside_a == 0
                relation = "contains"
            elif graph.inside_a == 0 and graph.inside_b == 0
                relation = "disjoint"
        rational.Point[][][] union_region = graph.result("UNION")
        rational.Point[][][] intersection = graph.result("INTERSECTION")
        real64 iou = rings.total_area(intersection) / rings.total_area(union_region)
        result.crossings = int(len(graph.ordered))
        result.lines = result.lines.concat(["relation {relation} iou {rational.real_text(iou, 6)}", "crossings {result.crossings}"])
        for gh.Ordered crossing = graph.ordered[]
            string direction = if crossing.entering then "in" else "out"
            result.lines = result.lines.append("crossing {crossing.point.text()} {direction}")
        if kind == "UNION"
            region = union_region
        elif kind == "INTERSECTION" or kind == "CLIP"
            region = intersection
        elif kind == "DIFFERENCE"
            region = graph.result("DIFFERENCE")
        else
            gh.Graph reversed_graph = gh.build(second_rings, first_rings)
            region = rings.sorted_polygons(graph.result("DIFFERENCE").concat(reversed_graph.result("DIFFERENCE")))
        result.target = Target(region, true, first_rings, second_rings)
    else
        region = [polygon.canonical]
        result.target = Target(region)
    rational.Point[][] origin_a = if binary then primary.canonical else polygon.canonical
    rational.Point[][] origin_b = if binary then secondary.canonical else []
    Values computed = result_values(region, origin_a, origin_b)
    result.lines = result.lines.concat(computed.lines)
    string joined_words = words.join(":")
    result.area_lines = ["{number}:{joined_words},{computed.ring_count},{computed.hole_count},{computed.vertex_count},{rational.real_text(computed.area)}"]
    if not binary
        result.lines = result.lines.concat(properties(polygon, computed.area))
    if kind == "CLIP"
        rational.Point[][] clipped = clip(origin_a, secondary.canonical[0])
        rational.Point[][] result_rings = rings.flatten(region)
        bool equal = len(clipped) == len(result_rings)
        for rational.Point[] result_ring = result_rings[]
            bool found = false
            for rational.Point[] clipped_ring = clipped[]
                if cyclic(result_ring, clipped_ring)
                    found = true
                    break
            equal = equal and found
        int vertex_count = 0
        for rational.Point[] clipped_ring = clipped[]
            vertex_count += int(len(clipped_ring))
        string verdict = if equal then "match" else "mismatch"
        result.lines = result.lines.append("crosscheck {verdict} rings {len(clipped)} vertices {vertex_count}")
    return result

void record_target(map.Map<int, Target> &targets, int number, Target | none value)
    match value
        Target saved
            .targets.set(number, saved)
        none
            return

int record_definition(Polygons &collection, Definition | none value)
    match value
        Definition added
            .collection.used.add(added.name)
            .collection.valid.set(added.name, added.polygon)
            return 1
        none
            return 0

void write(string name, const string[] lines)
    bool present = file.is_directory("output")
    if not present
        file.mkdir("output")
    string text = if len(lines) == 0 then "" else lines.join(NL) + NL
    file.write("output/" + name, text)

void run_program()
    Polygons collection = read_polygons()
    map.Map<int, Target> targets = map.Map<int, Target>()
    string[] rejections = collection.rejected
    string[] results = []
    string[] areas = ["operation,rings,holes,vertices,area"]
    string[] drawing = []
    int total = 0
    int succeeded = 0
    int defined = 0
    int crossing_count = 0
    string[] kinds = operation_kinds()
    int[][] counts = array(len(kinds), fill = [0, 0])
    string operation_text = file.read("input/operations.txt")
    string[] operation_lines = operation_text.split(NL)
    for string line = operation_lines[]
        if line == "" or line.starts_with("#")
            continue
        total += 1
        string[] words = line.split(" ")
        string kind = words[0]
        int kind_index = -1
        for int index < int(len(kinds))
            if kinds[index] == kind
                kind_index = index
                break
        if kind_index >= 0
            counts[kind_index][0] += 1
        match operation(total, line, collection, targets)
            Operation accepted
                succeeded += 1
                counts[kind_index][1] += 1
                crossing_count += accepted.crossings
                results = results.concat(accepted.lines)
                areas = areas.concat(accepted.area_lines)
                drawing = drawing.concat(accepted.drawing)
                record_target(&targets, total, accepted.target)
                defined += record_definition(&collection, accepted.definition)
            error rejected
                rejections = rejections.append("op {total} {rejected.message}")
    results = results.concat(["summary polygons {collection.blocks} valid {collection.valid_blocks} invalid {collection.blocks - collection.valid_blocks} defined {defined}", "summary operations {total} succeeded {succeeded} rejected {total - succeeded}", "summary crossings {crossing_count}"])
    for int index < int(len(kinds))
        results = results.append("kind {kinds[index]} {counts[index][0]} {counts[index][1]}")
    rejections = ["rejections {len(rejections)}"].concat(rejections)
    write("results.txt", results)
    write("areas.csv", areas)
    write("render.txt", drawing)
    write("rejections.txt", rejections)

if main
    run_program()
