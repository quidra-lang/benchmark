import rational = "./rational.qui"
import intersections = "./intersections.qui"
import rings = "./rings.qui"

class Crossing(rational.Point point, int ring_a, int edge_a, int ring_b, int edge_b, rational.Fraction position_a, rational.Fraction position_b)
class Node(rational.Point point, int crossing_id, bool entering)
class Location(int ring_a = 0, int index_a = 0, int ring_b = 0, int index_b = 0)
class Ordered(rational.Point point, bool entering)

class Graph(Node[][][] nodes, Location[] locations, Ordered[] ordered, int[] crossing_order, int inside_a, int inside_b)
    rational.Point[][][] result(string kind)
        bool[] inverted = [false, false]
        if kind == "UNION"
            inverted = [true, true]
        elif kind == "DIFFERENCE"
            inverted = [true, false]
        bool[] visited = array(len(locations), fill = false)
        rational.Point[][] output_rings = []
        for int start_id = crossing_order[]
            if visited[start_id]
                continue
            int side = 0
            int current_id = start_id
            rational.Point[] points = []
            while true
                Location location = locations[current_id]
                int ring_index = if side == 0 then location.ring_a else location.ring_b
                int node_index = if side == 0 then location.index_a else location.index_b
                Node[] sequence = nodes[side][ring_index]
                Node current_node = sequence[node_index]
                visited[current_id] = true
                points = points.append(current_node.point)
                bool forward = current_node.entering != inverted[side]
                int next_index = node_index
                while true
                    next_index = if forward then (next_index + 1) % int(len(sequence)) else (next_index + int(len(sequence)) - 1) % int(len(sequence))
                    if sequence[next_index].crossing_id >= 0
                        break
                    points = points.append(sequence[next_index].point)
                int found_id = sequence[next_index].crossing_id
                if found_id == start_id
                    break
                current_id = found_id
                side = 1 - side
            output_rings = output_rings.append(points)
        for int side_index < 2
            rational.Point[][] other_rings = []
            for Node[] other_nodes = nodes[1 - side_index][]
                rational.Point[] other_points = []
                for Node other_node = other_nodes[]
                    other_points = other_points.append(other_node.point)
                other_rings = other_rings.append(other_points)
            for Node[] sequence_nodes = nodes[side_index][]
                bool has_crossing = false
                rational.Point[] ring_points = []
                for Node listed_node = sequence_nodes[]
                    has_crossing = has_crossing or listed_node.crossing_id >= 0
                    ring_points = ring_points.append(listed_node.point)
                if not has_crossing and rings.interior(ring_points[0], other_rings) != inverted[side_index]
                    output_rings = output_rings.append(ring_points)
        return rings.assemble(output_rings)

Graph build(const rational.Point[][] first, const rational.Point[][] second)
    int inside_a = 0
    int inside_b = 0
    for rational.Point[] first_ring = first[]
        if rings.interior(first_ring[0], second)
            inside_a += 1
    for rational.Point[] second_ring = second[]
        if rings.interior(second_ring[0], first)
            inside_b += 1
    Crossing[] crossings = []
    for int ring_a < int(len(first))
        for int edge_a < int(len(first[ring_a]))
            for int ring_b < int(len(second))
                for int edge_b < int(len(second[ring_b]))
                    auto found = intersections.crossing(first[ring_a][edge_a], first[ring_a][(edge_a + 1) % int(len(first[ring_a]))], second[ring_b][edge_b], second[ring_b][(edge_b + 1) % int(len(second[ring_b]))])
                    match found
                        intersections.Crossing value
                            crossings = crossings.append(Crossing(value.point, ring_a, edge_a, ring_b, edge_b, value.position_a, value.position_b))
                        none
                            continue
    Location[] locations = array(len(crossings), fill = Location())
    Node[][][] nodes = [[], []]
    Ordered[] ordered = []
    int[] crossing_order = []
    for int side < 2
        rational.Point[][] primary = if side == 0 then first else second
        rational.Point[][] secondary = if side == 0 then second else first
        for int ring_index < int(len(primary))
            rational.Point[] ring = primary[ring_index]
            Node[] sequence = []
            bool in_other = rings.interior(ring[0], secondary)
            for int edge_index < int(len(ring))
                sequence = sequence.append(Node(ring[edge_index], -1, false))
                int[] on_edge = []
                for int crossing_index < int(len(crossings))
                    Crossing candidate = crossings[crossing_index]
                    bool belongs = if side == 0 then candidate.ring_a == ring_index and candidate.edge_a == edge_index else candidate.ring_b == ring_index and candidate.edge_b == edge_index
                    if belongs
                        on_edge = on_edge.append(crossing_index)
                for int position < int(len(on_edge))
                    int current = position
                    while current > 0
                        Crossing candidate_crossing = crossings[on_edge[current]]
                        Crossing previous_crossing = crossings[on_edge[current - 1]]
                        bool earlier = if side == 0 then candidate_crossing.position_a.less(previous_crossing.position_a) else candidate_crossing.position_b.less(previous_crossing.position_b)
                        if not earlier
                            break
                        int saved = on_edge[current]
                        on_edge[current] = on_edge[current - 1]
                        on_edge[current - 1] = saved
                        current -= 1
                for int id = on_edge[]
                    if side == 0
                        locations[id].ring_a = ring_index
                        locations[id].index_a = int(len(sequence))
                        crossing_order = crossing_order.append(id)
                        ordered = ordered.append(Ordered(crossings[id].point, not in_other))
                    else
                        locations[id].ring_b = ring_index
                        locations[id].index_b = int(len(sequence))
                    sequence = sequence.append(Node(crossings[id].point, id, not in_other))
                    in_other = not in_other
            nodes[side] = nodes[side].append(sequence)
    return Graph(nodes, locations, ordered, crossing_order, inside_a, inside_b)
