import fixed = "./fixed_point.qui"
import vector = "./vector3.qui"

int[] slab(int[] low, int[] high, int[] origin, int[] direction)
    int near = 0
    int far = 0
    int near_axis = -1
    int far_axis = -1
    for int axis < 3
        int component = direction[axis]
        if component == 0
            if origin[axis] < low[axis] or origin[axis] > high[axis]
                return []
        else
            int a = fixed.floor_div((low[axis] - origin[axis]) * 4096, component)
            int b = fixed.floor_div((high[axis] - origin[axis]) * 4096, component)
            int entry = if a < b then a else b
            int leave = if a > b then a else b
            if near_axis < 0 or entry > near
                near = entry
                near_axis = axis
            if far_axis < 0 or leave < far
                far = leave
                far_axis = axis
    return if near > far then [] else [near, near_axis, far, far_axis]

int[] candidate(string kind, int[] geometry, int[] origin, int[] direction, int epsilon)
    if kind == "sphere"
        int[] oc = vector.sub(origin, geometry[0:<3])
        int b = vector.dot(oc, direction)
        int center_t = fixed.floor_div(-b * 4096, vector.dot(direction, direction))
        int[] h = vector.add(oc, vector.sc(direction, center_t))
        int q = fixed.floor_div(geometry[3] * geometry[3], 4096) - vector.dot(h, h)
        if q < 0
            return []
        int width = fixed.floor_div(fixed.isqrt(q * 4096) * 4096, vector.length(direction))
        int distance = center_t - width
        if distance <= epsilon
            distance = center_t + width
        return if distance > epsilon then [distance, 0, -1] else []
    if kind == "plane"
        int denominator = vector.dot(direction, geometry[3:<6])
        if denominator == 0
            return []
        int distance = fixed.floor_div(vector.dot(vector.sub(geometry[0:<3], origin), geometry[3:<6]) * 4096, denominator)
        return if distance > epsilon then [distance, 0, -1] else []
    int[] interval = slab(geometry[0:<3], geometry[3:<6], origin, direction)
    if len(interval) == 0
        return []
    if interval[0] > epsilon
        return [interval[0], 1, interval[1]]
    if interval[2] > epsilon
        return [interval[2], 0, interval[3]]
    return []

int[] outward(string kind, int[] geometry, int[] point, int[] direction, int[] hit)
    if kind == "sphere"
        return vector.norm(vector.sub(point, geometry[0:<3]))
    if kind == "plane"
        return geometry[3:<6]
    int axis = hit[2]
    int sign = if direction[axis] > 0 then 1 else -1
    if hit[1] == 1
        sign = -sign
    int[] result = [0, 0, 0]
    result[axis] = sign * 4096
    return result

int[][] bounds(string kind, int[] geometry, int margin)
    if kind == "plane"
        return []
    int[] low = []
    int[] high = []
    for int axis < 3
        low = low.append(if kind == "sphere" then geometry[axis] - geometry[3] - margin else geometry[axis] - margin)
        high = high.append(if kind == "sphere" then geometry[axis] + geometry[3] + margin else geometry[axis + 3] + margin)
    return [low, high]
