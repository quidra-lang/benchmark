import vector = "./vector3.qui"

int integer(string text)
    int result = int.parse(text)
    return result

class Material(string name, int[] values)
    int[] checker = []
    int checker_size = 0

class Object(string label, string kind, int material, int[] geometry)

class Light(string kind, int[] values, int samples)

class Scene()
    int[] eye = [0, 0, 0]
    int[] forward = [0, 0, 0]
    int[] right = [0, 0, 0]
    int[] up = [0, 0, 0]
    int[] view = [0, 0]
    int[] background = [0, 0, 0]
    int ambient = 0
    int[] fog = []
    Material[] materials = []
    Object[] objects = []
    Light[] lights = []

int material_index(Material[] values, string name)
    for int j < int(len(values))
        if values[j].name == name
            return j
    return -1

Scene read_scene()
    auto result = Scene()
    string content = file.read("input/scene.txt")
    for string row = content.split(NL)[]
        if row == "" or row.starts_with("#")
            continue
        string[] fields = row.split(" ")
        string kind = fields[0]
        if kind == "material"
            int[] values = [for string text = fields[2:<int(len(fields))][] then integer(text)]
            result.materials = result.materials.append(Material(fields[1], values))
        elif kind == "checker"
            int index = material_index(result.materials, fields[1])
            result.materials[index].checker = [integer(fields[2]), integer(fields[3]), integer(fields[4])]
            result.materials[index].checker_size = integer(fields[5])
        elif kind == "sphere" or kind == "plane" or kind == "box"
            int[] geometry = [for string text = fields[3:<int(len(fields))][] then integer(text)]
            if kind == "plane"
                int[] normal = vector.norm(geometry[3:<6])
                for int j < 3
                    geometry[j + 3] = normal[j]
            result.objects = result.objects.append(Object(fields[1], kind, material_index(result.materials, fields[2]), geometry))
        else
            int[] values = [for string text = fields[1:<int(len(fields))][] then integer(text)]
            if kind == "point" or kind == "spot" or kind == "sun" or kind == "area"
                int samples = 1
                if kind == "sun"
                    int[] direction = vector.norm(vector.neg(values[0:<3]))
                    for int j < 3
                        values[j] = direction[j]
                elif kind == "spot"
                    int[] direction = vector.norm(values[3:<6])
                    for int j < 3
                        values[j + 3] = direction[j]
                elif kind == "area"
                    samples = values[9] * values[9]
                result.lights = result.lights.append(Light(kind, values, samples))
            elif kind == "eye"
                result.eye = values
            elif kind == "forward"
                result.forward = values
            elif kind == "right"
                result.right = values
            elif kind == "up"
                result.up = values
            elif kind == "view"
                result.view = values
            elif kind == "background"
                result.background = values
            elif kind == "ambient"
                result.ambient = values[0]
            elif kind == "fog"
                result.fog = values
    return result
