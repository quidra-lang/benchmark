import fixed = "./fixed_point.qui"
import vector = "./vector3.qui"

int[] base_color(int[] material, int[] checker, int checker_size, int[] point)
    if checker_size > 0
        int parity = fixed.floor_div(point[0], checker_size) + fixed.floor_div(point[1], checker_size) + fixed.floor_div(point[2], checker_size)
        if parity % 2 != 0
            return checker
    return material[0:<3]

int[] phong(int[] material, int[] normal, int[] light, int[] view, int ndl, int intensity, int factor)
    int effective = fixed.mul(intensity, factor)
    int diffuse = fixed.mul(fixed.mul(material[3], ndl), effective)
    int[] reflected_light = vector.sub(vector.sc(normal, 2 * ndl), light)
    int rv = vector.dot(reflected_light, view)
    int specular = 0
    if rv > 0
        int power = 4096
        for int j < material[5]
            power = fixed.mul(power, rv)
        specular = fixed.mul(fixed.mul(material[4], power), effective)
    return [diffuse, specular]

int[] reflected(int[] direction, int[] normal)
    return vector.norm(vector.sub(direction, vector.sc(normal, 2 * vector.dot(direction, normal))))

(int, int, int[], bool) refraction(int[] material, int[] direction, int[] normal, bool front)
    int wr = material[6]
    int wt = material[7]
    if wt == 0
        return (wr, wt, [], false)
    int eta = if front then fixed.floor_div(4096 * 4096, material[8]) else material[8]
    int cosine = -vector.dot(direction, normal)
    int discriminant = 4096 * 4096 - fixed.floor_div(fixed.mul(eta, eta) * (4096 * 4096 - cosine * cosine), 4096)
    if discriminant < 0
        return (wr + wt, 0, [], true)
    int[] transmitted = vector.norm(vector.add(vector.sc(direction, eta), vector.sc(normal, fixed.mul(eta, cosine) - fixed.isqrt(discriminant))))
    int r0 = fixed.floor_div((material[8] - 4096) * 4096, material[8] + 4096)
    int reflectance = fixed.mul(r0, r0)
    int x = 4096 - (if cosine < 4096 then cosine else 4096)
    int power = 4096
    for int j < 5
        power = fixed.mul(power, x)
    int fresnel = reflectance + fixed.mul(4096 - reflectance, power)
    int transfer = fixed.mul(material[7], fresnel)
    return (wr + transfer, wt - transfer, transmitted, false)

int[] mix(int[][] colors, int[] weights)
    int[] result = [0, 0, 0]
    for int j < int(len(colors))
        for int axis < 3
            result[axis] += fixed.floor_div(colors[j][axis] * weights[j], 4096)
    return result
