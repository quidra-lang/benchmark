import math
import genetic = "./genetic.qui"
import gantt = "./gantt.qui"

string[] read_lines(string path)
    content := string.from_utf8(file.read_bin(path))
    lines := content.split(NL)
    return lines[0:<len(lines) - 1]

class Parameters(local string[][] rows)
    seed := int.parse(rows[0][1])
    population := int.parse(rows[1][1])
    generations := int.parse(rows[2][1])
    tournament := int.parse(rows[3][1])
    int[] crossover := [for part := rows[4][1].split("/")[] then int.parse(part)]
    int[] swap := [for part := rows[5][1].split("/")[] then int.parse(part)]
    int[] insert := [for part := rows[6][1].split("/")[] then int.parse(part)]
    int elitism := int.parse(rows[7][1])
    int[] checkpoints := [for value := rows[8][1:][] then int.parse(value)]
    int tabu_iterations := int.parse(rows[9][1])
    int tabu_tenure := int.parse(rows[10][1])
    int gantt_width := int.parse(rows[11][1])

string percentage(int part, int whole)
    tenths := (2000 * part + whole) / (2 * whole)
    return "{tenths / 10}.{tenths % 10}%"

string job_letter(int number)
    return "ABCDEFGHIJKLM"[number - 1]

string integers(int[] values)
    return [for value := values[] then "{value}"].join(" ")

int makespan_of(int[] starts, int[] durations)
    result := 0
    for: ident < int(len(starts))
        result = math.max(result, starts[ident] + durations[ident])
    return result

int jackson_bound(genetic.dispatch.instance.Instance problem, genetic.dispatch.instance.Machine machine)
    remaining := [for ident := machine.operations[] then problem.operations[ident].duration]
    left := int(len(remaining))
    moment := 0
    bound := 0
    while left > 0
        release := 2147483647
        for: position < int(len(remaining))
            if remaining[position] > 0
                release = math.min(release, problem.operations[machine.operations[position]].head)
        moment = math.max(moment, release)
        chosen := -1
        for: position < int(len(remaining))
            operation := problem.operations[machine.operations[position]]
            if remaining[position] == 0 or operation.head > moment
                continue
            if chosen < 0
                chosen = position
            else
                previous := problem.operations[machine.operations[chosen]]
                if operation.tail > previous.tail or (operation.tail == previous.tail and operation.job < previous.job)
                    chosen = position
        step := remaining[chosen]
        for ident := machine.operations[]
            head := problem.operations[ident].head
            if head > moment
                step = math.min(step, head - moment)
        moment += step
        remaining[chosen] -= step
        if remaining[chosen] == 0
            left -= 1
            bound = math.max(bound, moment + problem.operations[machine.operations[chosen]].tail)
    return bound

int[] order_starts(genetic.dispatch.instance.Instance problem, int[][] order, int[] durations)
    starts := array(len(problem.operations), fill = -1)
    completions := array(len(problem.operations), fill = 0)
    positions := array(nat(problem.machine_count), fill = 0)
    placed := 0
    while placed < int(len(problem.operations))
        for: int machine < problem.machine_count
            sequence := order[machine]
            while positions[machine] < int(len(sequence))
                position := positions[machine]
                ident := sequence[position]
                previous := problem.operations[ident].job_prev
                if previous >= 0 and starts[previous] < 0
                    break
                ready := if previous < 0 then 0 else completions[previous]
                free := if position == 0 then 0 else completions[sequence[position - 1]]
                starts[ident] = math.max(ready, free)
                completions[ident] = starts[ident] + durations[ident]
                positions[machine] += 1
                placed += 1
    return starts

class Move(int first, int second)
class LeftShift(bool possible, start := 0, position := 0)
class Slacks(int[] slack, int[] free)

class Schedule(genetic.dispatch.instance.Instance problem, int[] starts)
    int[] completions := [for ident := (0:<int(len(starts)))[] then starts[ident] + problem.durations[ident]]
    makespan := completions.max()
    int[][] order := array(nat(problem.machine_count), fill = [])
    machine_prev := array(len(starts), fill = -1)
    machine_next := array(len(starts), fill = -1)

    for ident := by_start()[]
        local machine := problem.operations[ident].machine - 1
        if len(order[machine]) > 0
            local previous := order[machine][-1]
            machine_prev[ident] = previous
            machine_next[previous] = ident
        order[machine] = order[machine].append(ident)

    int[] by_start()
        int[] result := []
        for: ident < int(len(starts))
            position := int(len(result))
            result = result.append(ident)
            while position > 0
                previous := result[position - 1]
                if starts[previous] < starts[ident] or (starts[previous] == starts[ident] and previous < ident)
                    break
                result[position] = previous
                position -= 1
            result[position] = ident
        return result

    int[] chromosome()
        return [for ident := by_start()[] then problem.operations[ident].job]

    int[] critical_path()
        current := 0
        while completions[current] != makespan
            current += 1
        int[] reverse := []
        while true
            reverse = reverse.append(current)
            if starts[current] == 0
                break
            previous := machine_prev[current]
            current = if previous >= 0 and completions[previous] == starts[current] then previous else problem.operations[current].job_prev
        return reverse[::-1]

    int[][] blocks(int[] path)
        int[][] result := []
        for ident := path[]
            last := int(len(result)) - 1
            if last >= 0 and problem.operations[result[last][-1]].machine == problem.operations[ident].machine
                result[last] = result[last].append(ident)
            else
                result = result.append([ident])
        return result

    Move[] moves()
        Move[] result := []
        for block := blocks(critical_path())[]
            for: 1 <= position < int(len(block))
                result = result.append(Move(block[position - 1], block[position]))
        return result

    int path_count()
        ways := array(len(starts), fill = 0)
        for ident := by_start()[]
            if starts[ident] == 0
                ways[ident] = 1
            else
                for previous := [problem.operations[ident].job_prev, machine_prev[ident]][]
                    if previous >= 0 and completions[previous] == starts[ident]
                        ways[ident] += ways[previous]
        count := 0
        for: ident < int(len(starts))
            if completions[ident] == makespan
                count += ways[ident]
        return count

    LeftShift left_shift(int ident)
        operation := problem.operations[ident]
        sequence := order[operation.machine - 1]
        position := 0
        while sequence[position] != ident
            position += 1
        if position == 0
            return LeftShift(false)
        ready := if operation.job_prev < 0 then 0 else completions[operation.job_prev]
        for: insertion < position
            begin := if insertion == 0 then 0 else completions[sequence[insertion - 1]]
            start := math.max(begin, ready)
            if start + operation.duration <= starts[sequence[insertion]]
                return LeftShift(true, start, insertion)
        return LeftShift(false)

    int shiftable_count()
        count := 0
        for: ident < int(len(starts))
            if left_shift(ident).possible
                count += 1
        return count

    Slacks slacks()
        latest := array(len(starts), fill = 0)
        slack := array(len(starts), fill = 0)
        free := array(len(starts), fill = 0)
        for ident := by_start()[::-1][]
            latest_limit := makespan
            start_limit := makespan
            for following := [problem.operations[ident].job_next, machine_next[ident]][]
                if following >= 0
                    latest_limit = math.min(latest_limit, latest[following])
                    start_limit = math.min(start_limit, starts[following])
            latest[ident] = latest_limit - problem.durations[ident]
            slack[ident] = latest[ident] - starts[ident]
            free[ident] = start_limit - completions[ident]
        return Slacks(slack, free)

    int[] path_counts(int[] path)
        counts := array(nat(problem.machine_count), fill = 0)
        for ident := path[]
            counts[problem.operations[ident].machine - 1] += 1
        return counts

    int bottleneck(int[] path)
        counts := path_counts(path)
        best := 0
        for: 1 <= machine < int(len(counts))
            if counts[machine] > counts[best]
                best = machine
        return best

    int flow()
        total := 0
        for job := problem.jobs[]
            total += completions[job.operations[-1]]
        return total

    int total_idle()
        int[] durations := problem.durations
        return makespan * problem.machine_count - durations.sum()

    string letters(int machine)
        return [for ident := order[machine][] then job_letter(problem.operations[ident].job)].join("")

Schedule schedule_of_order(genetic.dispatch.instance.Instance problem, int[][] order)
    return Schedule(problem, order_starts(problem, order, problem.durations))

int[][] apply_move(genetic.dispatch.instance.Instance problem, int[][] order, Move move)
    result := order
    machine := problem.operations[move.first].machine - 1
    position := 0
    while result[machine][position] != move.first
        position += 1
    result[machine][position] = move.second
    result[machine][position + 1] = move.first
    return result

int[] distances(Schedule first, Schedule second)
    int[] result := []
    for: int machine < first.problem.machine_count
        rank := array(len(first.starts), fill = 0)
        for: position < int(len(second.order[machine]))
            rank[second.order[machine][position]] = position
        sequence := first.order[machine]
        count := 0
        for: low < int(len(sequence))
            for: low + 1 <= high < int(len(sequence))
                if rank[sequence[low]] > rank[sequence[high]]
                    count += 1
        result = result.append(count)
    return result

class TabuRecord(int iteration, int move_count, int tabu_count, Move move, bool aspiration, int value, int best)
class Search(int start_value, int[][] best_order, int best_value, int found, TabuRecord[] records, string reason)

Search tabu_search(genetic.dispatch.instance.Instance problem, int[][] order, Parameters params)
    start := schedule_of_order(problem, order).makespan
    current := order
    best_order := order
    best := start
    found := 0
    TabuRecord[] records := []
    reason := "limit"
    map<string, int> expiry
    for: 1 <= iteration <= params.tabu_iterations
        moves := schedule_of_order(problem, current).moves()
        if len(moves) == 0
            reason = "no_moves"
            break
        int[] values := []
        bool[] blocked := []
        chosen := -1
        tabu_count := 0
        for: position < int(len(moves))
            move := moves[position]
            value := schedule_of_order(problem, apply_move(problem, current, move)).makespan
            values = values.append(value)
            end_iteration := 0
            match expiry.get("{move.first}:{move.second}")
                int limit
                    end_iteration = limit
                none
                    end_iteration = 0
            forbidden := end_iteration >= iteration
            blocked = blocked.append(forbidden)
            if forbidden
                tabu_count += 1
            if (not forbidden or value < best) and (chosen < 0 or value < values[chosen])
                chosen = position
        if chosen < 0
            reason = "all_tabu"
            break
        selected := moves[chosen]
        current = apply_move(problem, current, selected)
        .expiry.set("{selected.second}:{selected.first}", iteration + params.tabu_tenure)
        if values[chosen] < best
            best_order = current
            best = values[chosen]
            found = iteration
        records = records.append(TabuRecord(iteration, int(len(moves)), tabu_count, selected, blocked[chosen], values[chosen], best))
    return Search(start, best_order, best, found, records, reason)

class Shift(int ident, int old_start, int new_start)
class Activation(int[][] order, Shift[] shifts)

Activation activate(genetic.dispatch.instance.Instance problem, int[][] order)
    current := order
    Shift[] shifts := []
    while true
        schedule := schedule_of_order(problem, current)
        selected := -1
        target := LeftShift(false)
        for ident := schedule.by_start()[]
            candidate := schedule.left_shift(ident)
            if candidate.possible
                selected = ident
                target = candidate
                break
        if selected < 0
            break
        machine := problem.operations[selected].machine - 1
        remaining := [for ident := current[machine][] if ident != selected then ident]
        current[machine] = remaining[0:<target.position].append(selected).concat(remaining[target.position:])
        shifts = shifts.append(Shift(selected, schedule.starts[selected], target.start))

    return Activation(current, shifts)

int[] ranking(int[] values)
    int[] result := []
    for: index < int(len(values))
        position := int(len(result))
        result = result.append(index)
        while position > 0 and values[index] < values[result[position - 1]]
            result[position] = result[position - 1]
            position -= 1
        result[position] = index
    return result

int gcd(int first, int second)
    a := first
    b := second
    while b
        a, b = b, a % b
    return a

class Record(int generation, int value, int individual)
class Counts()
    crossovers := 0
    swaps := 0
    inserts := 0

void mutate(genetic.minstd.Minstd &rng, int[] &child, Parameters params, Counts &counts)
    if .rng.chance(params.swap)
        counts.swaps += 1
        genetic.swap_mutation(&rng, &child)
    if .rng.chance(params.insert)
        counts.inserts += 1
        genetic.insert_mutation(&rng, &child)

class GeneticResult(int[][] population, int[] values, int[] ranked, Record[] records, string[] progress, Counts counts)

GeneticResult run_ga(genetic.dispatch.instance.Instance problem, Parameters params, Schedule[] baselines)
    rng := genetic.minstd.Minstd(params.seed)
    jobs := [for job := problem.jobs[] then job.number]
    int[] basic := []
    for job := problem.jobs[]
        for _ < int(len(job.operations))
            basic = basic.append(job.number)
    population := [for schedule := baselines[] then schedule.chromosome()]
    while int(len(population)) < params.population
        chromosome := basic
        .rng.shuffle(&chromosome)
        population = population.append(chromosome)
    counts := Counts()
    Record[] records := []
    progress := ["generation,best,mean,worst,distinct"]
    previous_best := 2147483647
    int[] values := []
    int[] ranked := []
    for: 0 <= int generation <= params.generations
        values = [for chromosome := population[] then makespan_of(genetic.decode(problem, chromosome), problem.durations)]
        ranked = ranking(values)
        best := ranked[0]
        if values[best] < previous_best
            records = records.append(Record(generation, values[best], best + 1))
        previous_best = values[best]
        for checkpoint := params.checkpoints[]
            if checkpoint != generation
                continue
            distinct<string> seen
            for chromosome := population[]
                .seen.add(integers(chromosome))
            total := values.sum()
            divisor := gcd(total, int(len(values)))
            progress = progress.append("{generation},{values[best]},{total / divisor}/{int(len(values)) / divisor},{values[ranked[-1]]},{seen.size()}")
        if generation == params.generations
            break
        offspring := [for index := ranked[0:<params.elitism][] then population[index]]
        for _ < (params.population - params.elitism) / 2
            first_index := genetic.tournament(&rng, values, params.tournament)
            second_index := genetic.tournament(&rng, values, params.tournament)
            first := population[first_index]
            second := population[second_index]
            if .rng.chance(params.crossover)
                counts.crossovers += 1
                children := genetic.crossover(&rng, first, second, jobs)
                first = children.first
                second = children.second
            mutate(&rng, &first, params, &counts)
            mutate(&rng, &second, params, &counts)
            offspring = offspring.append(first).append(second)
        population = offspring
    return GeneticResult(population, values, ranked, records, progress, counts)

void write_lines(string name, string[] lines)
    writer1 := file.write("output/" + name)
    .writer1(lines.join(NL) + NL)

problem := genetic.dispatch.instance.load_instance("input/instance.txt")
params := Parameters([for row := read_lines("input/ga_params.txt")[] then row.split(" ")])
rules := ["SPT", "LPT", "MWKR", "FIFO"]
jacksons := [for machine := problem.machines[] then jackson_bound(problem, machine)]
job_bound := 0
for: 1 <= index < int(len(problem.jobs))
    if problem.jobs[index].work > problem.jobs[job_bound].work
        job_bound = index
machine_bound := 0
jackson_machine := 0
for: 1 <= int machine < problem.machine_count
    if problem.machines[machine].bound > problem.machines[machine_bound].bound
        machine_bound = machine
    if jacksons[machine] > jacksons[jackson_machine]
        jackson_machine = machine
lower := math.max(problem.jobs[job_bound].work, math.max(problem.machines[machine_bound].bound, jacksons[jackson_machine]))
Schedule[] baselines := []
genetic.dispatch.Result[] dispatches := []
Search[] baseline_searches := []
for rule := rules[]
    result := genetic.dispatch.giffler_thompson(problem, rule)
    schedule := Schedule(problem, result.starts)
    baselines = baselines.append(schedule)
    dispatches = dispatches.append(result)
    baseline_searches = baseline_searches.append(tabu_search(problem, schedule.order, params))
ga := run_ga(problem, params, baselines)
best_chromosome := ga.population[ga.ranked[0]]
ga_schedule := Schedule(problem, genetic.decode(problem, best_chromosome))
gene_positions := array(len(problem.operations), fill = 0)
gene_operations := genetic.gene_operations(problem, best_chromosome)
for: position < int(len(gene_operations))
    gene_positions[gene_operations[position]] = position + 1
active_decode := genetic.dispatch.giffler_thompson(problem, "GENES", gene_positions)
activated := activate(problem, ga_schedule.order)
activated_value := schedule_of_order(problem, activated.order).makespan
search := tabu_search(problem, activated.order, params)
final := schedule_of_order(problem, search.best_order)
path := final.critical_path()
blocks := final.blocks(path)
slacks := final.slacks()
baseline_lines := ["INSTANCE jobs {len(problem.jobs)} machines {problem.machine_count} operations {len(problem.operations)} work {problem.durations.sum()} errors {len(problem.errors)}"]
for problem_text := problem.errors[]
    baseline_lines = baseline_lines.append("ERROR " + problem_text)
for job := problem.jobs[]
    route := [for ident := job.operations[] then "M{problem.operations[ident].machine}"].join(" ")
    baseline_lines = baseline_lines.append("JOB J{job.number} operations {len(job.operations)} work {job.work} route {route}")
for: int index < problem.machine_count
    machine := problem.machines[index]
    baseline_lines = baseline_lines.append("MACHINE M{machine.number} operations {len(machine.operations)} load {machine.load} head {machine.head} tail {machine.tail} bound {machine.bound} jackson {jacksons[index]}")
baseline_lines = baseline_lines.concat(["BOUND job {problem.jobs[job_bound].work} J{problem.jobs[job_bound].number}", "BOUND machine {problem.machines[machine_bound].bound} M{machine_bound + 1}", "BOUND jackson {jacksons[jackson_machine]} M{jackson_machine + 1}", "BOUND lower {lower}"])
best_baseline := 0
for: index < 4
    schedule := baselines[index]
    previous_search := baseline_searches[index]
    rule := rules[index]
    baseline_path := schedule.critical_path()
    bottleneck := schedule.bottleneck(baseline_path) + 1
    gap := percentage(schedule.makespan - lower, lower)
    baseline_lines = baseline_lines.concat(["RULE {rule} makespan {schedule.makespan} gap {gap} flow {schedule.flow()} idle {schedule.total_idle()} decisions {dispatches[index].decisions} ties {dispatches[index].ties}", "PATH {rule} operations {len(baseline_path)} blocks {len(schedule.blocks(baseline_path))} critical_paths {schedule.path_count()} bottleneck M{bottleneck}", "TABU {rule} makespan {schedule.makespan} -> {previous_search.best_value} found {previous_search.found} iterations {len(previous_search.records)} stop {previous_search.reason}"])
    if schedule.makespan < baselines[best_baseline].makespan
        best_baseline = index
baseline_lines = baseline_lines.append("BEST {rules[best_baseline]} makespan {baselines[best_baseline].makespan}")
for machine := problem.machines[]
    parts := ["UTILIZATION M{machine.number}"]
    for: index < 4
        parts = parts.append(rules[index] + " " + percentage(machine.load, baselines[index].makespan))
    baseline_lines = baseline_lines.append(parts.join(" "))
schedule_lines := ["GA best {ga_schedule.makespan} generation {ga.records[-1].generation} crossovers {ga.counts.crossovers} swaps {ga.counts.swaps} inserts {ga.counts.inserts}"]
for record := ga.records[]
    schedule_lines = schedule_lines.append("RECORD generation {record.generation} makespan {record.value} individual {record.individual}")
distinct<string> top_seen
top_count := 0
for index := ga.ranked[]
    chromosome := ga.population[index]
    key := integers(chromosome)
    if top_seen.has(key)
        continue
    .top_seen.add(key)
    top_count += 1
    other := Schedule(problem, genetic.decode(problem, chromosome))
    distance := distances(other, ga_schedule).sum()
    schedule_lines = schedule_lines.append("TOP {top_count} individual {index + 1} makespan {ga.values[index]} distance {distance}")
    if top_count == 5
        break
schedule_lines = schedule_lines.concat(["GA_CHROMOSOME " + integers(best_chromosome), "ACTIVE_DECODE makespan {makespan_of(active_decode.starts, problem.durations)} decisions {active_decode.decisions}"])
for: index < int(len(activated.shifts))
    shift := activated.shifts[index]
    operation := problem.operations[shift.ident]
    schedule_lines = schedule_lines.append("SHIFT {index + 1} {operation.code} M{operation.machine} start {shift.old_start} -> {shift.new_start}")
schedule_lines = schedule_lines.concat(["ACTIVATED makespan {ga_schedule.makespan} -> {activated_value} shifts {len(activated.shifts)}", "SCHEDULE makespan {final.makespan} lower_bound {lower} gap " + percentage(final.makespan - lower, lower) + " improvement {ga_schedule.makespan - final.makespan} shiftable {final.shiftable_count()}", "CHROMOSOME " + integers(final.chromosome()), "LEGEND " + [for job := problem.jobs[] then job_letter(job.number) + "=J{job.number}"].join(" ")])
scale := gantt.chart_scale(final.makespan, params.gantt_width)
schedule_lines = schedule_lines.concat(["GANTT scale {scale.quantum} columns {scale.columns}", gantt.time_row(scale), gantt.rule_row(scale.columns)])
on_path := array(len(problem.operations), fill = false)
for ident := path[]
    on_path[ident] = true
gantt.Interval[][] machine_intervals := array(nat(problem.machine_count), fill = [])
for operation := problem.operations[]
    mark := if on_path[operation.ident] then "abcdefghijklm"[operation.job - 1] else job_letter(operation.job)
    machine := operation.machine - 1
    machine_intervals[machine] = machine_intervals[machine].append(gantt.Interval(final.starts[operation.ident], final.completions[operation.ident], mark))
for: int machine < problem.machine_count
    schedule_lines = schedule_lines.append(gantt.chart_row("M{machine + 1}", machine_intervals[machine], scale))
schedule_lines = schedule_lines.append(gantt.busy_row(machine_intervals, scale))
for job := problem.jobs[]
    intervals := [for ident := job.operations[] then gantt.Interval(final.starts[ident], final.completions[ident], "{problem.operations[ident].machine % 10}")]
    schedule_lines = schedule_lines.append(gantt.chart_row("J{job.number}", intervals, scale))
for: int machine < problem.machine_count
    parts := ["ORDER M{machine + 1} FINAL " + final.letters(machine)]
    for: index < 4
        parts = parts.append(rules[index] + " " + baselines[index].letters(machine))
    schedule_lines = schedule_lines.append(parts.join(" "))
for machine := problem.machines[]
    sequence := final.order[machine.number - 1]
    string[] intervals := []
    string[] description := []
    gaps := 0
    longest := 0
    previous := 0
    for: position < int(len(sequence))
        ident := sequence[position]
        start := final.starts[ident]
        completion := final.completions[ident]
        if start > previous
            intervals = intervals.append("{previous}-{start}")
            if position > 0
                gaps += 1
                longest = math.max(longest, start - previous)
        description = description.append("J{problem.operations[ident].job}:{start}-{completion}")
        previous = completion
    if previous < final.makespan
        intervals = intervals.append("{previous}-{final.makespan}")
    schedule_lines = schedule_lines.concat(["MACHINE M{machine.number} load {machine.load} idle {final.makespan - machine.load} utilization " + percentage(machine.load, final.makespan) + " gaps {gaps} longest_gap {longest} sequence " + description.join(" "), "IDLE M{machine.number} " + (if len(intervals) == 0 then "none" else intervals.join(" "))])
total_waiting := 0
for job := problem.jobs[]
    completion := final.completions[job.operations[-1]]
    total_waiting += completion - job.work
    schedule_lines = schedule_lines.append("JOB J{job.number} operations {len(job.operations)} work {job.work} start {final.starts[job.operations[0]]} completion {completion} waiting {completion - job.work}")
schedule_lines = schedule_lines.append("TOTAL flow {final.flow()} waiting {total_waiting} idle {final.total_idle()}")
compared := baselines.append(ga_schedule)
labels := rules.append("GA")
all_distances := [for other := compared[] then distances(final, other)]
totals := array(5, fill = 0)
total_pairs := 0
for: int machine < problem.machine_count
    count := int(len(problem.machines[machine].operations))
    pairs := count * (count - 1) / 2
    total_pairs += pairs
    parts := ["DISTANCE M{machine + 1} pairs {pairs}"]
    for: index < 5
        parts = parts.append(labels[index] + " {all_distances[index][machine]}")
        totals[index] += all_distances[index][machine]
    schedule_lines = schedule_lines.append(parts.join(" "))
schedule_lines = schedule_lines.append("DISTANCE total pairs {total_pairs} " + [for index := (0:<5)[] then labels[index] + " {totals[index]}"].join(" "))
critical_lines := ["SEARCH start {search.start_value} iterations {params.tabu_iterations} tenure {params.tabu_tenure}"]
for record := search.records[]
    first := problem.operations[record.move.first]
    second := problem.operations[record.move.second]
    kind := if record.aspiration then "aspiration" else "free"
    critical_lines = critical_lines.append("ITER {record.iteration} moves {record.move_count} tabu {record.tabu_count} swap M{first.machine} {first.code} {second.code} {kind} makespan {record.value} best {record.best}")
critical_lines = critical_lines.concat(["STOP iterations {len(search.records)} reason {search.reason} best {search.best_value} found {search.found}", "PATH operations {len(path)} blocks {len(blocks)} makespan {final.makespan} critical_paths {final.path_count()}"])
for: position < int(len(path))
    ident := path[position]
    operation := problem.operations[ident]
    link := if position == 0 then "start" elif final.machine_prev[ident] == path[position - 1] then "machine" else "job"
    critical_lines = critical_lines.append("NODE {position + 1} {operation.code} M{operation.machine} {final.starts[ident]}-{final.completions[ident]} {link}")
for: index < int(len(blocks))
    block := blocks[index]
    names := [for ident := block[] then problem.operations[ident].code].join(" ")
    critical_lines = critical_lines.append("BLOCK {index + 1} M{problem.operations[block[0]].machine} {final.starts[block[0]]}-{final.completions[block[-1]]} {names}")
neighbours := final.moves()
for: position < int(len(neighbours))
    move := neighbours[position]
    first := problem.operations[move.first]
    second := problem.operations[move.second]
    value := schedule_of_order(problem, apply_move(problem, final.order, move)).makespan
    critical_lines = critical_lines.append("NEIGHBOUR {position + 1} M{first.machine} {first.code} {second.code} makespan {value}")
critical_count := 0
for value := slacks.slack[]
    if value == 0
        critical_count += 1
critical_lines = critical_lines.append("CRITICAL operations {critical_count} total {len(problem.operations)}")
for job := problem.jobs[]
    critical_lines = critical_lines.append("SLACK J{job.number} " + integers([for ident := job.operations[] then slacks.slack[ident]]))
for job := problem.jobs[]
    critical_lines = critical_lines.append("FREE J{job.number} " + integers([for ident := job.operations[] then slacks.free[ident]]))
path_counts := final.path_counts(path)
for: int machine < problem.machine_count
    count := 0
    durations := problem.durations
    for ident := problem.machines[machine].operations[]
        if slacks.slack[ident] == 0
            count += 1
        durations[ident] += (durations[ident] + 9) / 10
    sensitivity := makespan_of(order_starts(problem, final.order, durations), durations)
    critical_lines = critical_lines.append("MACHINE M{machine + 1} critical {count} path {path_counts[machine]} sensitivity {sensitivity} delta {sensitivity - final.makespan}")
bottleneck := final.bottleneck(path)
critical_lines = critical_lines.append("BOTTLENECK M{bottleneck + 1} path {path_counts[bottleneck]}")
output_exists := file.is_directory("output")
if not output_exists
    file.mkdir("output")
write_lines("baselines.txt", baseline_lines)
write_lines("ga_progress.csv", ga.progress)
write_lines("best_schedule.txt", schedule_lines)
write_lines("critical_path.txt", critical_lines)
