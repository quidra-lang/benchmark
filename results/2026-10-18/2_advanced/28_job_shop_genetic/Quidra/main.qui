import math
import instance = "./instance.qui"
import minstd = "./minstd.qui"
import dispatch = "./dispatch_rules.qui"
import genetic = "./genetic.qui"
import gantt = "./gantt.qui"

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

class Parameters(local string[][] rows)
    int seed = int.parse(rows[0][1])
    int population = int.parse(rows[1][1])
    int generations = int.parse(rows[2][1])
    int tournament = int.parse(rows[3][1])
    int[] crossover = [for string part = rows[4][1].split("/")[] then int.parse(part)]
    int[] swap = [for string part = rows[5][1].split("/")[] then int.parse(part)]
    int[] insert = [for string part = rows[6][1].split("/")[] then int.parse(part)]
    int elitism = int.parse(rows[7][1])
    int[] checkpoints = [for string value = rows[8][1:][] then int.parse(value)]
    int tabu_iterations = int.parse(rows[9][1])
    int tabu_tenure = int.parse(rows[10][1])
    int gantt_width = int.parse(rows[11][1])

string percentage(int part, int whole)
    int tenths = (2000 * part + whole) / (2 * whole)
    return "{tenths / 10}.{tenths % 10}%"

string job_letter(int number)
    return "ABCDEFGHIJKLM"[number - 1]

string integers(int[] values)
    return [for int value = values[] then "{value}"].join(" ")

int makespan_of(int[] starts, int[] durations)
    int result = 0
    for int ident < int(len(starts))
        result = math.max(result, starts[ident] + durations[ident])
    return result

int jackson_bound(instance.Instance problem, instance.Machine machine)
    int[] remaining = [for int ident = machine.operations[] then problem.operations[ident].duration]
    int left = int(len(remaining))
    int time = 0
    int bound = 0
    while left > 0
        int release = 2147483647
        for int position < int(len(remaining))
            if remaining[position] > 0
                release = math.min(release, problem.operations[machine.operations[position]].head)
        time = math.max(time, release)
        int chosen = -1
        for int position < int(len(remaining))
            instance.Operation operation = problem.operations[machine.operations[position]]
            if remaining[position] == 0 or operation.head > time
                continue
            if chosen < 0
                chosen = position
            else
                instance.Operation previous = problem.operations[machine.operations[chosen]]
                if operation.tail > previous.tail or (operation.tail == previous.tail and operation.job < previous.job)
                    chosen = position
        int step = remaining[chosen]
        for int ident = machine.operations[]
            int head = problem.operations[ident].head
            if head > time
                step = math.min(step, head - time)
        time += step
        remaining[chosen] -= step
        if remaining[chosen] == 0
            left -= 1
            bound = math.max(bound, time + problem.operations[machine.operations[chosen]].tail)
    return bound

int[] order_starts(instance.Instance problem, int[][] order, int[] durations)
    int[] starts = array(len(problem.operations), fill = -1)
    int[] completions = array(len(problem.operations), fill = 0)
    int[] positions = array(nat(problem.machine_count), fill = 0)
    int placed = 0
    while placed < int(len(problem.operations))
        for int machine < problem.machine_count
            int[] sequence = order[machine]
            while positions[machine] < int(len(sequence))
                int position = positions[machine]
                int ident = sequence[position]
                int previous = problem.operations[ident].job_prev
                if previous >= 0 and starts[previous] < 0
                    break
                int ready = if previous < 0 then 0 else completions[previous]
                int free = if position == 0 then 0 else completions[sequence[position - 1]]
                starts[ident] = math.max(ready, free)
                completions[ident] = starts[ident] + durations[ident]
                positions[machine] += 1
                placed += 1
    return starts

class Move(int first, int second)
class LeftShift(bool possible, int start = 0, int position = 0)
class Slacks(int[] slack, int[] free)

class Schedule(instance.Instance problem, int[] starts)
    int[] completions = [for int ident < int(len(starts)) then starts[ident] + problem.durations[ident]]
    int makespan = math.max_all(completions)
    int[][] order = array(nat(problem.machine_count), fill = [])
    int[] machine_prev = array(len(starts), fill = -1)
    int[] machine_next = array(len(starts), fill = -1)

    for int ident = by_start()[]
        local int machine = problem.operations[ident].machine - 1
        if len(order[machine]) > 0
            local int previous = order[machine][len(order[machine]) - 1]
            machine_prev[ident] = previous
            machine_next[previous] = ident
        order[machine] = order[machine].append(ident)

    int[] by_start()
        int[] result = []
        for int ident < int(len(starts))
            int position = int(len(result))
            result = result.append(ident)
            while position > 0
                int previous = result[position - 1]
                if starts[previous] < starts[ident] or (starts[previous] == starts[ident] and previous < ident)
                    break
                result[position] = previous
                position -= 1
            result[position] = ident
        return result

    int[] chromosome()
        return [for int ident = by_start()[] then problem.operations[ident].job]

    int[] critical_path()
        int current = 0
        while completions[current] != makespan
            current += 1
        int[] reverse = []
        while true
            reverse = reverse.append(current)
            if starts[current] == 0
                break
            int previous = machine_prev[current]
            current = if previous >= 0 and completions[previous] == starts[current] then previous else problem.operations[current].job_prev
        return reverse[::-1]

    int[][] blocks(int[] path)
        int[][] result = []
        for int ident = path[]
            int last = int(len(result)) - 1
            if last >= 0 and problem.operations[result[last][len(result[last]) - 1]].machine == problem.operations[ident].machine
                result[last] = result[last].append(ident)
            else
                result = result.append([ident])
        return result

    Move[] moves()
        Move[] result = []
        for int[] block = blocks(critical_path())[]
            for 1 <= int position < int(len(block))
                result = result.append(Move(block[position - 1], block[position]))
        return result

    int path_count()
        int[] ways = array(len(starts), fill = 0)
        for int ident = by_start()[]
            if starts[ident] == 0
                ways[ident] = 1
            else
                for int previous = [problem.operations[ident].job_prev, machine_prev[ident]][]
                    if previous >= 0 and completions[previous] == starts[ident]
                        ways[ident] += ways[previous]
        int count = 0
        for int ident < int(len(starts))
            if completions[ident] == makespan
                count += ways[ident]
        return count

    LeftShift left_shift(int ident)
        instance.Operation operation = problem.operations[ident]
        int[] sequence = order[operation.machine - 1]
        int position = 0
        while sequence[position] != ident
            position += 1
        if position == 0
            return LeftShift(false)
        int ready = if operation.job_prev < 0 then 0 else completions[operation.job_prev]
        for int insertion < position
            int begin = if insertion == 0 then 0 else completions[sequence[insertion - 1]]
            int start = math.max(begin, ready)
            if start + operation.duration <= starts[sequence[insertion]]
                return LeftShift(true, start, insertion)
        return LeftShift(false)

    int shiftable_count()
        int count = 0
        for int ident < int(len(starts))
            if left_shift(ident).possible
                count += 1
        return count

    Slacks slacks()
        int[] latest = array(len(starts), fill = 0)
        int[] slack = array(len(starts), fill = 0)
        int[] free = array(len(starts), fill = 0)
        for int ident = by_start()[::-1][]
            int latest_limit = makespan
            int start_limit = makespan
            for int following = [problem.operations[ident].job_next, machine_next[ident]][]
                if following >= 0
                    latest_limit = math.min(latest_limit, latest[following])
                    start_limit = math.min(start_limit, starts[following])
            latest[ident] = latest_limit - problem.durations[ident]
            slack[ident] = latest[ident] - starts[ident]
            free[ident] = start_limit - completions[ident]
        return Slacks(slack, free)

    int[] path_counts(int[] path)
        int[] counts = array(nat(problem.machine_count), fill = 0)
        for int ident = path[]
            counts[problem.operations[ident].machine - 1] += 1
        return counts

    int bottleneck(int[] path)
        int[] counts = path_counts(path)
        int best = 0
        for 1 <= int machine < int(len(counts))
            if counts[machine] > counts[best]
                best = machine
        return best

    int flow()
        int total = 0
        for instance.Job job = problem.jobs[]
            total += completions[job.operations[len(job.operations) - 1]]
        return total

    int total_idle()
        return makespan * problem.machine_count - math.sum(problem.durations)

    string letters(int machine)
        return [for int ident = order[machine][] then job_letter(problem.operations[ident].job)].join("")

Schedule schedule_of_order(instance.Instance problem, int[][] order)
    return Schedule(problem, order_starts(problem, order, problem.durations))

int[][] apply_move(instance.Instance problem, int[][] order, Move move)
    int[][] result = order
    int machine = problem.operations[move.first].machine - 1
    int position = 0
    while result[machine][position] != move.first
        position += 1
    result[machine][position] = move.second
    result[machine][position + 1] = move.first
    return result

int[] distances(Schedule first, Schedule second)
    int[] result = []
    for int machine < first.problem.machine_count
        int[] rank = array(len(first.starts), fill = 0)
        for int position < int(len(second.order[machine]))
            rank[second.order[machine][position]] = position
        int[] sequence = first.order[machine]
        int count = 0
        for int low < int(len(sequence))
            for low + 1 <= int high < int(len(sequence))
                if rank[sequence[low]] > rank[sequence[high]]
                    count += 1
        result = result.append(count)
    return result

class TabuRecord(int iteration, int move_count, int tabu_count, Move move, bool aspiration, int value, int best)
class Search(int start_value, int[][] best_order, int best_value, int found, TabuRecord[] records, string reason)

Search tabu_search(instance.Instance problem, int[][] order, Parameters params)
    int start = schedule_of_order(problem, order).makespan
    int[][] current = order
    int[][] best_order = order
    int best = start
    int found = 0
    TabuRecord[] records = []
    string reason = "limit"
    map.Map<string, int> expiry
    for 1 <= int iteration <= params.tabu_iterations
        Move[] moves = schedule_of_order(problem, current).moves()
        if len(moves) == 0
            reason = "no_moves"
            break
        int[] values = []
        bool[] blocked = []
        int chosen = -1
        int tabu_count = 0
        for int position < int(len(moves))
            Move move = moves[position]
            int value = schedule_of_order(problem, apply_move(problem, current, move)).makespan
            values = values.append(value)
            int end_iteration = 0
            match expiry.get("{move.first}:{move.second}")
                int limit
                    end_iteration = limit
                none
                    end_iteration = 0
            bool forbidden = end_iteration >= iteration
            blocked = blocked.append(forbidden)
            if forbidden
                tabu_count += 1
            if (not forbidden or value < best) and (chosen < 0 or value < values[chosen])
                chosen = position
        if chosen < 0
            reason = "all_tabu"
            break
        Move selected = moves[chosen]
        current = apply_move(problem, current, selected)
        .expiry.set("{selected.second}:{selected.first}", iteration + params.tabu_tenure)
        if values[chosen] < best
            best_order = current
            best = values[chosen]
            found = iteration
        records = records.append(TabuRecord(iteration, int(len(moves)), tabu_count, selected, blocked[chosen], values[chosen], best))
    return Search(start, best_order, best, found, records, reason)

class Shift(int ident, int old_start, int new_start)
class Activation(int[][] order, Shift[] shifts)

Activation activate(instance.Instance problem, int[][] order)
    int[][] current = order
    Shift[] shifts = []
    while true
        Schedule schedule = schedule_of_order(problem, current)
        int selected = -1
        LeftShift target = LeftShift(false)
        for int ident = schedule.by_start()[]
            LeftShift candidate = schedule.left_shift(ident)
            if candidate.possible
                selected = ident
                target = candidate
                break
        if selected < 0
            return Activation(current, shifts)
        int machine = problem.operations[selected].machine - 1
        int[] remaining = [for int ident = current[machine][] if ident != selected then ident]
        current[machine] = remaining[0:<target.position].append(selected).concat(remaining[target.position:])
        shifts = shifts.append(Shift(selected, schedule.starts[selected], target.start))

int[] ranking(int[] values)
    int[] result = []
    for int index < int(len(values))
        int position = int(len(result))
        result = result.append(index)
        while position > 0 and values[index] < values[result[position - 1]]
            result[position] = result[position - 1]
            position -= 1
        result[position] = index
    return result

int gcd(int first, int second)
    int a = first
    int b = second
    while b != 0
        int remainder = a % b
        a = b
        b = remainder
    return a

class Record(int generation, int value, int individual)
class Counts()
    int crossovers = 0
    int swaps = 0
    int inserts = 0

void mutate(minstd.Minstd &rng, int[] &child, Parameters params, Counts &counts)
    if .rng.chance(params.swap)
        counts.swaps += 1
        genetic.swap_mutation(&rng, &child)
    if .rng.chance(params.insert)
        counts.inserts += 1
        genetic.insert_mutation(&rng, &child)

class GeneticResult(int[][] population, int[] values, int[] ranked, Record[] records, string[] progress, Counts counts)

GeneticResult run_ga(instance.Instance problem, Parameters params, Schedule[] baselines)
    minstd.Minstd rng = minstd.Minstd(params.seed)
    int[] jobs = [for instance.Job job = problem.jobs[] then job.number]
    int[] basic = []
    for instance.Job job = problem.jobs[]
        for int _ < int(len(job.operations))
            basic = basic.append(job.number)
    int[][] population = [for Schedule schedule = baselines[] then schedule.chromosome()]
    while int(len(population)) < params.population
        int[] chromosome = basic
        .rng.shuffle(&chromosome)
        population = population.append(chromosome)
    Counts counts = Counts()
    Record[] records = []
    string[] progress = ["generation,best,mean,worst,distinct"]
    int previous_best = 2147483647
    int[] values = []
    int[] ranked = []
    for 0 <= int generation <= params.generations
        values = [for int[] chromosome = population[] then makespan_of(genetic.decode(problem, chromosome), problem.durations)]
        ranked = ranking(values)
        int best = ranked[0]
        if values[best] < previous_best
            records = records.append(Record(generation, values[best], best + 1))
        previous_best = values[best]
        for int checkpoint = params.checkpoints[]
            if checkpoint != generation
                continue
            set.Set<string> seen
            for int[] chromosome = population[]
                .seen.add(integers(chromosome))
            int total = math.sum(values)
            int divisor = gcd(total, int(len(values)))
            progress = progress.append("{generation},{values[best]},{total / divisor}/{int(len(values)) / divisor},{values[ranked[len(ranked) - 1]]},{seen.size()}")
        if generation == params.generations
            break
        int[][] offspring = [for int index = ranked[0:<params.elitism][] then population[index]]
        for int _ < (params.population - params.elitism) / 2
            int first_index = genetic.tournament(&rng, values, params.tournament)
            int second_index = genetic.tournament(&rng, values, params.tournament)
            int[] first = population[first_index]
            int[] second = population[second_index]
            if .rng.chance(params.crossover)
                counts.crossovers += 1
                genetic.Children children = genetic.crossover(&rng, first, second, jobs)
                first = children.first
                second = children.second
            mutate(&rng, &first, params, &counts)
            mutate(&rng, &second, params, &counts)
            offspring = offspring.append(first).append(second)
        population = offspring
    return GeneticResult(population, values, ranked, records, progress, counts)

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)

instance.Instance problem = instance.load_instance("input/instance.txt")
Parameters params = Parameters([for string row = read_lines("input/ga_params.txt")[] then row.split(" ")])
string[] rules = ["SPT", "LPT", "MWKR", "FIFO"]
int[] jacksons = [for instance.Machine machine = problem.machines[] then jackson_bound(problem, machine)]
int job_bound = 0
for 1 <= int index < int(len(problem.jobs))
    if problem.jobs[index].work > problem.jobs[job_bound].work
        job_bound = index
int machine_bound = 0
int jackson_machine = 0
for 1 <= int machine < problem.machine_count
    if problem.machines[machine].bound > problem.machines[machine_bound].bound
        machine_bound = machine
    if jacksons[machine] > jacksons[jackson_machine]
        jackson_machine = machine
int lower = math.max(problem.jobs[job_bound].work, math.max(problem.machines[machine_bound].bound, jacksons[jackson_machine]))
Schedule[] baselines = []
dispatch.Result[] dispatches = []
Search[] baseline_searches = []
for string rule = rules[]
    dispatch.Result result = dispatch.giffler_thompson(problem, rule)
    Schedule schedule = Schedule(problem, result.starts)
    baselines = baselines.append(schedule)
    dispatches = dispatches.append(result)
    baseline_searches = baseline_searches.append(tabu_search(problem, schedule.order, params))
GeneticResult ga = run_ga(problem, params, baselines)
int[] best_chromosome = ga.population[ga.ranked[0]]
Schedule ga_schedule = Schedule(problem, genetic.decode(problem, best_chromosome))
int[] gene_positions = array(len(problem.operations), fill = 0)
int[] gene_operations = genetic.gene_operations(problem, best_chromosome)
for int position < int(len(gene_operations))
    gene_positions[gene_operations[position]] = position + 1
dispatch.Result active_decode = dispatch.giffler_thompson(problem, "GENES", gene_positions)
Activation activated = activate(problem, ga_schedule.order)
int activated_value = schedule_of_order(problem, activated.order).makespan
Search search = tabu_search(problem, activated.order, params)
Schedule final = schedule_of_order(problem, search.best_order)
int[] path = final.critical_path()
int[][] blocks = final.blocks(path)
Slacks slacks = final.slacks()
string[] baseline_lines = ["INSTANCE jobs {len(problem.jobs)} machines {problem.machine_count} operations {len(problem.operations)} work {math.sum(problem.durations)} errors {len(problem.errors)}"]
for string problem_text = problem.errors[]
    baseline_lines = baseline_lines.append("ERROR " + problem_text)
for instance.Job job = problem.jobs[]
    string route = [for int ident = job.operations[] then "M{problem.operations[ident].machine}"].join(" ")
    baseline_lines = baseline_lines.append("JOB J{job.number} operations {len(job.operations)} work {job.work} route {route}")
for int index < problem.machine_count
    instance.Machine machine = problem.machines[index]
    baseline_lines = baseline_lines.append("MACHINE M{machine.number} operations {len(machine.operations)} load {machine.load} head {machine.head} tail {machine.tail} bound {machine.bound} jackson {jacksons[index]}")
baseline_lines = baseline_lines.concat(["BOUND job {problem.jobs[job_bound].work} J{problem.jobs[job_bound].number}", "BOUND machine {problem.machines[machine_bound].bound} M{machine_bound + 1}", "BOUND jackson {jacksons[jackson_machine]} M{jackson_machine + 1}", "BOUND lower {lower}"])
int best_baseline = 0
for int index < 4
    Schedule schedule = baselines[index]
    Search previous_search = baseline_searches[index]
    string rule = rules[index]
    int[] baseline_path = schedule.critical_path()
    int bottleneck = schedule.bottleneck(baseline_path) + 1
    string gap = percentage(schedule.makespan - lower, lower)
    baseline_lines = baseline_lines.concat(["RULE {rule} makespan {schedule.makespan} gap {gap} flow {schedule.flow()} idle {schedule.total_idle()} decisions {dispatches[index].decisions} ties {dispatches[index].ties}", "PATH {rule} operations {len(baseline_path)} blocks {len(schedule.blocks(baseline_path))} critical_paths {schedule.path_count()} bottleneck M{bottleneck}", "TABU {rule} makespan {schedule.makespan} -> {previous_search.best_value} found {previous_search.found} iterations {len(previous_search.records)} stop {previous_search.reason}"])
    if schedule.makespan < baselines[best_baseline].makespan
        best_baseline = index
baseline_lines = baseline_lines.append("BEST {rules[best_baseline]} makespan {baselines[best_baseline].makespan}")
for instance.Machine machine = problem.machines[]
    string[] parts = ["UTILIZATION M{machine.number}"]
    for int index < 4
        parts = parts.append(rules[index] + " " + percentage(machine.load, baselines[index].makespan))
    baseline_lines = baseline_lines.append(parts.join(" "))
string[] schedule_lines = ["GA best {ga_schedule.makespan} generation {ga.records[len(ga.records) - 1].generation} crossovers {ga.counts.crossovers} swaps {ga.counts.swaps} inserts {ga.counts.inserts}"]
for Record record = ga.records[]
    schedule_lines = schedule_lines.append("RECORD generation {record.generation} makespan {record.value} individual {record.individual}")
set.Set<string> top_seen
int top_count = 0
for int index = ga.ranked[]
    int[] chromosome = ga.population[index]
    string key = integers(chromosome)
    if top_seen.has(key)
        continue
    .top_seen.add(key)
    top_count += 1
    Schedule other = Schedule(problem, genetic.decode(problem, chromosome))
    int distance = math.sum(distances(other, ga_schedule))
    schedule_lines = schedule_lines.append("TOP {top_count} individual {index + 1} makespan {ga.values[index]} distance {distance}")
    if top_count == 5
        break
schedule_lines = schedule_lines.concat(["GA_CHROMOSOME " + integers(best_chromosome), "ACTIVE_DECODE makespan {makespan_of(active_decode.starts, problem.durations)} decisions {active_decode.decisions}"])
for int index < int(len(activated.shifts))
    Shift shift = activated.shifts[index]
    instance.Operation operation = problem.operations[shift.ident]
    schedule_lines = schedule_lines.append("SHIFT {index + 1} {operation.code} M{operation.machine} start {shift.old_start} -> {shift.new_start}")
schedule_lines = schedule_lines.concat(["ACTIVATED makespan {ga_schedule.makespan} -> {activated_value} shifts {len(activated.shifts)}", "SCHEDULE makespan {final.makespan} lower_bound {lower} gap " + percentage(final.makespan - lower, lower) + " improvement {ga_schedule.makespan - final.makespan} shiftable {final.shiftable_count()}", "CHROMOSOME " + integers(final.chromosome()), "LEGEND " + [for instance.Job job = problem.jobs[] then job_letter(job.number) + "=J{job.number}"].join(" ")])
gantt.Scale scale = gantt.chart_scale(final.makespan, params.gantt_width)
schedule_lines = schedule_lines.concat(["GANTT scale {scale.quantum} columns {scale.columns}", gantt.time_row(scale), gantt.rule_row(scale.columns)])
bool[] on_path = array(len(problem.operations), fill = false)
for int ident = path[]
    on_path[ident] = true
gantt.Interval[][] machine_intervals = array(nat(problem.machine_count), fill = [])
for instance.Operation operation = problem.operations[]
    string mark = if on_path[operation.ident] then "abcdefghijklm"[operation.job - 1] else job_letter(operation.job)
    int machine = operation.machine - 1
    machine_intervals[machine] = machine_intervals[machine].append(gantt.Interval(final.starts[operation.ident], final.completions[operation.ident], mark))
for int machine < problem.machine_count
    schedule_lines = schedule_lines.append(gantt.chart_row("M{machine + 1}", machine_intervals[machine], scale))
schedule_lines = schedule_lines.append(gantt.busy_row(machine_intervals, scale))
for instance.Job job = problem.jobs[]
    gantt.Interval[] intervals = [for int ident = job.operations[] then gantt.Interval(final.starts[ident], final.completions[ident], "{problem.operations[ident].machine % 10}")]
    schedule_lines = schedule_lines.append(gantt.chart_row("J{job.number}", intervals, scale))
for int machine < problem.machine_count
    string[] parts = ["ORDER M{machine + 1} FINAL " + final.letters(machine)]
    for int index < 4
        parts = parts.append(rules[index] + " " + baselines[index].letters(machine))
    schedule_lines = schedule_lines.append(parts.join(" "))
for instance.Machine machine = problem.machines[]
    int[] sequence = final.order[machine.number - 1]
    string[] intervals = []
    string[] description = []
    int gaps = 0
    int longest = 0
    int previous = 0
    for int position < int(len(sequence))
        int ident = sequence[position]
        int start = final.starts[ident]
        int completion = final.completions[ident]
        if start > previous
            intervals = intervals.append("{previous}-{start}")
            if position > 0
                gaps += 1
                longest = math.max(longest, start - previous)
        description = description.append("J{problem.operations[ident].job}:{start}-{completion}")
        previous = completion
    if previous < final.makespan
        intervals = intervals.append("{previous}-{final.makespan}")
    schedule_lines = schedule_lines.concat(["MACHINE M{machine.number} load {machine.load} idle {final.makespan - machine.load} utilization " + percentage(machine.load, final.makespan) + " gaps {gaps} longest_gap {longest} sequence " + description.join(" "), "IDLE M{machine.number} " + (if len(intervals) == 0 then "none" else intervals.join(" "))])
int total_waiting = 0
for instance.Job job = problem.jobs[]
    int completion = final.completions[job.operations[len(job.operations) - 1]]
    total_waiting += completion - job.work
    schedule_lines = schedule_lines.append("JOB J{job.number} operations {len(job.operations)} work {job.work} start {final.starts[job.operations[0]]} completion {completion} waiting {completion - job.work}")
schedule_lines = schedule_lines.append("TOTAL flow {final.flow()} waiting {total_waiting} idle {final.total_idle()}")
Schedule[] compared = baselines.append(ga_schedule)
string[] labels = rules.append("GA")
int[][] all_distances = [for Schedule other = compared[] then distances(final, other)]
int[] totals = array(5, fill = 0)
int total_pairs = 0
for int machine < problem.machine_count
    int count = int(len(problem.machines[machine].operations))
    int pairs = count * (count - 1) / 2
    total_pairs += pairs
    string[] parts = ["DISTANCE M{machine + 1} pairs {pairs}"]
    for int index < 5
        parts = parts.append(labels[index] + " {all_distances[index][machine]}")
        totals[index] += all_distances[index][machine]
    schedule_lines = schedule_lines.append(parts.join(" "))
schedule_lines = schedule_lines.append("DISTANCE total pairs {total_pairs} " + [for int index < 5 then labels[index] + " {totals[index]}"].join(" "))
string[] critical_lines = ["SEARCH start {search.start_value} iterations {params.tabu_iterations} tenure {params.tabu_tenure}"]
for TabuRecord record = search.records[]
    instance.Operation first = problem.operations[record.move.first]
    instance.Operation second = problem.operations[record.move.second]
    string kind = if record.aspiration then "aspiration" else "free"
    critical_lines = critical_lines.append("ITER {record.iteration} moves {record.move_count} tabu {record.tabu_count} swap M{first.machine} {first.code} {second.code} {kind} makespan {record.value} best {record.best}")
critical_lines = critical_lines.concat(["STOP iterations {len(search.records)} reason {search.reason} best {search.best_value} found {search.found}", "PATH operations {len(path)} blocks {len(blocks)} makespan {final.makespan} critical_paths {final.path_count()}"])
for int position < int(len(path))
    int ident = path[position]
    instance.Operation operation = problem.operations[ident]
    string link = if position == 0 then "start" elif final.machine_prev[ident] == path[position - 1] then "machine" else "job"
    critical_lines = critical_lines.append("NODE {position + 1} {operation.code} M{operation.machine} {final.starts[ident]}-{final.completions[ident]} {link}")
for int index < int(len(blocks))
    int[] block = blocks[index]
    string names = [for int ident = block[] then problem.operations[ident].code].join(" ")
    critical_lines = critical_lines.append("BLOCK {index + 1} M{problem.operations[block[0]].machine} {final.starts[block[0]]}-{final.completions[block[len(block) - 1]]} {names}")
Move[] neighbours = final.moves()
for int position < int(len(neighbours))
    Move move = neighbours[position]
    instance.Operation first = problem.operations[move.first]
    instance.Operation second = problem.operations[move.second]
    int value = schedule_of_order(problem, apply_move(problem, final.order, move)).makespan
    critical_lines = critical_lines.append("NEIGHBOUR {position + 1} M{first.machine} {first.code} {second.code} makespan {value}")
int critical_count = 0
for int value = slacks.slack[]
    if value == 0
        critical_count += 1
critical_lines = critical_lines.append("CRITICAL operations {critical_count} total {len(problem.operations)}")
for instance.Job job = problem.jobs[]
    critical_lines = critical_lines.append("SLACK J{job.number} " + integers([for int ident = job.operations[] then slacks.slack[ident]]))
for instance.Job job = problem.jobs[]
    critical_lines = critical_lines.append("FREE J{job.number} " + integers([for int ident = job.operations[] then slacks.free[ident]]))
int[] path_counts = final.path_counts(path)
for int machine < problem.machine_count
    int count = 0
    int[] durations = problem.durations
    for int ident = problem.machines[machine].operations[]
        if slacks.slack[ident] == 0
            count += 1
        durations[ident] += (durations[ident] + 9) / 10
    int sensitivity = makespan_of(order_starts(problem, final.order, durations), durations)
    critical_lines = critical_lines.append("MACHINE M{machine + 1} critical {count} path {path_counts[machine]} sensitivity {sensitivity} delta {sensitivity - final.makespan}")
int bottleneck = final.bottleneck(path)
critical_lines = critical_lines.append("BOTTLENECK M{bottleneck + 1} path {path_counts[bottleneck]}")
if not file.is_directory("output")
    file.mkdir("output")
write_lines("baselines.txt", baseline_lines)
write_lines("ga_progress.csv", ga.progress)
write_lines("best_schedule.txt", schedule_lines)
write_lines("critical_path.txt", critical_lines)
