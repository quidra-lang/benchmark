import math
import instance = "./instance.qui"
import minstd = "./minstd.qui"

int[] gene_operations(instance.Instance problem, int[] chromosome)
    int[] counts = array(14, fill = 0)
    int[] operations = []
    for int gene = chromosome[]
        operations = operations.append(problem.job_ops[gene][counts[gene]])
        counts[gene] += 1
    return operations

int[] decode(instance.Instance problem, int[] chromosome)
    int[] starts = array(len(problem.operations), fill = 0)
    int[] ready = array(14, fill = 0)
    int[] free = array(nat(problem.machine_count), fill = 0)
    for int ident = gene_operations(problem, chromosome)[]
        instance.Operation operation = problem.operations[ident]
        int start = math.max(ready[operation.job], free[operation.machine - 1])
        starts[ident] = start
        ready[operation.job] = start + operation.duration
        free[operation.machine - 1] = start + operation.duration
    return starts

int tournament(minstd.Minstd &rng, int[] values, int size)
    int best = -1
    for _ < size
        int index = .rng.below(int(len(values)))
        if best < 0 or values[index] < values[best] or (values[index] == values[best] and index < best)
            best = index
    return best

int[] preserve_order(int[] keeper, int[] donor, bool[] kept)
    int[] fillers = [for int gene = donor[] if not kept[gene] then gene]
    int[] child = []
    int position = 0
    for int gene = keeper[]
        if kept[gene]
            child = child.append(gene)
        else
            child = child.append(fillers[position])
            position += 1
    return child

class Children(int[] first, int[] second)

Children crossover(minstd.Minstd &rng, int[] first, int[] second, int[] jobs)
    bool[] kept = array(14, fill = false)
    for int job = jobs[]
        if .rng.below(2) == 0
            kept[job] = true
    return Children(preserve_order(first, second, kept), preserve_order(second, first, kept))

void swap_mutation(minstd.Minstd &rng, int[] &chromosome)
    int first = .rng.below(int(len(chromosome)))
    int second = .rng.below(int(len(chromosome)))
    int held = chromosome[first]
    chromosome[first] = chromosome[second]
    chromosome[second] = held

void insert_mutation(minstd.Minstd &rng, int[] &chromosome)
    int source = .rng.below(int(len(chromosome)))
    int target = .rng.below(int(len(chromosome)))
    int held = chromosome[source]
    int[] remaining = chromosome[0:<source].concat(chromosome[source + 1:])
    chromosome = remaining[0:<target].append(held).concat(remaining[target:])
