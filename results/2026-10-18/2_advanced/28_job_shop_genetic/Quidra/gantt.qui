import math

class Scale(int quantum, int columns)
class Interval(int start, int finish, string mark)

Scale chart_scale(int makespan, int width)
    int magnitude = 1
    while true
        for int step = [1, 2, 5][]
            int quantum = step * magnitude
            int columns = (makespan + quantum - 1) / quantum
            if columns <= width
                return Scale(quantum, columns)
        magnitude *= 10

string time_row(Scale scale)
    string row = "time"
    for 0 <= int column < scale.columns step 10
        row += string.repeat(" ", nat(math.max(0, 6 + column - int(len(row))))) + "{column * scale.quantum}"
    return row

string rule_row(int columns)
    return "      " + [for int column < columns then if column % 10 == 0 then "+" else "-"].join("")

string framed(string label, string marks)
    return label + string.repeat(" ", nat(math.max(0, 4 - int(len(label))))) + " |" + marks + "|"

string chart_row(string label, Interval[] intervals, Scale scale)
    string marks = ""
    for int column < scale.columns
        int widest = 0
        int earliest = 2147483647
        string mark = "."
        for Interval interval = intervals[]
            int overlap = math.min(interval.finish, (column + 1) * scale.quantum) - math.max(interval.start, column * scale.quantum)
            if overlap > widest or (overlap == widest and overlap > 0 and interval.start < earliest)
                widest = overlap
                earliest = interval.start
                mark = interval.mark
        marks += mark
    return framed(label, marks)

string busy_row(Interval[][] machine_intervals, Scale scale)
    string marks = ""
    for int column < scale.columns
        int time = column * scale.quantum
        int busy = 0
        for Interval[] intervals = machine_intervals[]
            for Interval interval = intervals[]
                if interval.start <= time < interval.finish
                    busy += 1
                    break
        marks += if busy == 10 then "X" else "{busy}"
    return framed("busy", marks)
