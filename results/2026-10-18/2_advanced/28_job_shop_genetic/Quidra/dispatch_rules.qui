import math
import instance = "./instance.qui"

class Result(int[] starts, int decisions, int ties)

Result giffler_thompson(instance.Instance problem, string rule, int[] gene_positions = [])
    int[] starts = array(len(problem.operations), fill = 0)
    int[] next_index = array(14, fill = 0)
    int[] ready = array(14, fill = 0)
    int[] free = array(nat(problem.machine_count), fill = 0)
    int decisions = 0
    int ties = 0
    for _ < int(len(problem.operations))
        int[] candidates = []
        int[] earliest = []
        int cutoff = 2147483647
        int chosen_machine = 2147483647
        for instance.Job job = problem.jobs[]
            if next_index[job.number] >= int(len(job.operations))
                continue
            int ident = job.operations[next_index[job.number]]
            instance.Operation operation = problem.operations[ident]
            int start = math.max(ready[job.number], free[operation.machine - 1])
            int completion = start + operation.duration
            candidates = candidates.append(ident)
            earliest = earliest.append(start)
            if completion < cutoff or (completion == cutoff and operation.machine < chosen_machine)
                cutoff = completion
                chosen_machine = operation.machine
        int chosen = -1
        int minimum = 2147483647
        int conflict_count = 0
        int minimum_count = 0
        for int position < int(len(candidates))
            instance.Operation operation = problem.operations[candidates[position]]
            if operation.machine != chosen_machine or earliest[position] >= cutoff
                continue
            conflict_count += 1
            int value = if rule == "SPT" then operation.duration elif rule == "LPT" then -operation.duration elif rule == "MWKR" then -operation.duration - operation.tail elif rule == "FIFO" then ready[operation.job] else gene_positions[operation.ident]
            if value < minimum
                minimum = value
                chosen = position
                minimum_count = 1
            elif value == minimum
                minimum_count += 1
        if conflict_count > 1
            decisions += 1
        if minimum_count > 1
            ties += 1
        instance.Operation selected = problem.operations[candidates[chosen]]
        starts[selected.ident] = earliest[chosen]
        ready[selected.job] = earliest[chosen] + selected.duration
        free[chosen_machine - 1] = earliest[chosen] + selected.duration
        next_index[selected.job] += 1
    return Result(starts, decisions, ties)
