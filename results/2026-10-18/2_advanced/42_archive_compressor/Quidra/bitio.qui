int power_two(int exponent)
    int result = 1
    for _ < exponent
        result *= 2
    return result

int bits(int value)
    int count = 0
    while value > 0
        count += 1
        value /= 2
    return count

string key(int[] values)
    string[] fields = [for int value = values[] then "{value}"]
    return fields.join(",")

class DecodeError(string kind, int position)
class Decoded(int[] data, DecodeError[] problems = [])

Decoded failure(string kind, int position)
    return Decoded([], [DecodeError(kind, position)])

class Writer()
    int[] data = []
    int partial = 0
    int used = 0
    int bit_count = 0

    void .write(int value, int width)
        for width - 1 >= int shift >= 0
            partial = partial * 2 + value / power_two(shift) % 2
            used += 1
            if used == 8
                data = data.append(partial)
                partial = 0
                used = 0
        bit_count += width

    int[] finish()
        return if used > 0 then data.append(partial * power_two(8 - used)) else data

class Reader(int[] payload, bool zero_fill = false)
    int position = 0
    DecodeError[] problems = []

    bool failed()
        return len(problems) > 0

    int .read(int width, int output_position = 0)
        if failed()
            return 0
        int limit = 8 * int(len(payload))
        if not zero_fill and position + width > limit
            problems = [DecodeError("end_of_data", output_position)]
            return 0
        int value = 0
        for _ < width
            value *= 2
            if position < limit
                value += payload[position / 8] / power_two(7 - position % 8) % 2
            position += 1
        return value
