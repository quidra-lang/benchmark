bool less(int[] first, int[] second)
    return first[0] < second[0] or (first[0] == second[0] and first[1] < second[1])

int[] tree_lengths(int[] frequencies)
    int[] lengths = array(len(frequencies), fill = 0)
    int[][] nodes = []
    int[] active = []
    for int symbol < int(len(frequencies))
        if frequencies[symbol] > 0
            active = active.append(int(len(nodes)))
            nodes = nodes.append([frequencies[symbol], symbol, symbol, -1, -1])
    if len(active) == 0
        return lengths
    if len(active) == 1
        lengths[nodes[active[0]][2]] = 1
        return lengths
    while len(active) > 1
        int[] chosen = []
        for _ < 2
            int best = 0
            for 1 <= int index < int(len(active))
                if less(nodes[active[index]], nodes[active[best]])
                    best = index
            chosen = chosen.append(active[best])
            active = active[0:<best].concat(active[best + 1:<int(len(active))])
        int[] first = nodes[chosen[0]]
        int[] second = nodes[chosen[1]]
        active = active.append(int(len(nodes)))
        nodes = nodes.append([first[0] + second[0], if first[1] < second[1] then first[1] else second[1], -1, chosen[0], chosen[1]])
    int[][] pending = [[active[0], 0]]
    while len(pending) > 0
        int[] item = pending[len(pending) - 1]
        pending = pending[0:<int(len(pending)) - 1]
        int[] node = nodes[item[0]]
        if node[2] >= 0
            lengths[node[2]] = item[1]
        else
            pending = pending.append([node[3], item[1] + 1]).append([node[4], item[1] + 1])
    return lengths

class Lengths(int[] values, int halvings)

Lengths limited_lengths(int[] frequencies, int maximum)
    int[] weights = frequencies
    int halvings = 0
    int[] lengths = tree_lengths(weights)
    int longest = 0
    for int length = lengths[]
        if length > longest
            longest = length
    while longest > maximum
        for int index < int(len(weights))
            weights[index] = (weights[index] + 1) / 2
        halvings += 1
        lengths = tree_lengths(weights)
        longest = 0
        for int length = lengths[]
            if length > longest
                longest = length
    return Lengths(lengths, halvings)

int power_two(int exponent)
    int result = 1
    for _ < exponent
        result *= 2
    return result

int[] canonical(int[] lengths)
    int[] ordered = []
    for int symbol < int(len(lengths))
        if lengths[symbol] > 0
            int place = int(len(ordered))
            ordered = ordered.append(symbol)
            while place > 0 and lengths[symbol] < lengths[ordered[place - 1]]
                ordered[place] = ordered[place - 1]
                place -= 1
            ordered[place] = symbol
    int[] codes = array(len(lengths), fill = 0)
    int code = 0
    int previous = 0
    for int index < int(len(ordered))
        int symbol = ordered[index]
        if index > 0
            code = (code + 1) * power_two(lengths[symbol] - previous)
        codes[symbol] = code
        previous = lengths[symbol]
    return codes
