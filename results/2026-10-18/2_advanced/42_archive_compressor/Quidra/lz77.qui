public import bitio = "./bitio.qui"

class Token(int literal, int distance = 0, int length = 0)

int[] positions(map.Map<string, int[]> prefixes, string name)
    match prefixes.get(name)
        int[] stored
            return stored
        none
            return []

Token[] tokenize(int[] data, int offset_bits, int length_bits)
    int window = bitio.power_two(offset_bits)
    int lookahead = bitio.power_two(length_bits) + 2
    int position = 0
    Token[] tokens = []
    map.Map<string, int[]> prefixes = map.Map<string, int[]>()
    while position < int(len(data))
        int distance = 0
        int longest = 0
        int limit = if lookahead < int(len(data)) - position then lookahead else int(len(data)) - position
        if limit >= 3
            string name = bitio.key(data[position:<position + 3])
            int[] candidates = positions(prefixes, name)
            for int start = candidates[::-1][]
                int candidate_distance = position - start
                if candidate_distance > window
                    break
                int length = 3
                while length < limit and data[position + length] == data[position + length - candidate_distance]
                    length += 1
                if length > longest
                    distance = candidate_distance
                    longest = length
                if longest == limit
                    break
        int consumed = 1
        if longest >= 3
            tokens = tokens.append(Token(-1, distance, longest))
            consumed = longest
        else
            tokens = tokens.append(Token(data[position]))
        int end = if position + consumed < int(len(data)) - 2 then position + consumed else int(len(data)) - 2
        for position <= int start < end
            string name = bitio.key(data[start:<start + 3])
            int[] candidates = positions(prefixes, name)
            .prefixes.set(name, candidates.append(start))
        position += consumed
    return tokens

bitio.Decoded copy_match(int[] output, int distance, int length, int original)
    if distance > int(len(output))
        return bitio.failure("bad_offset", int(len(output)))
    if int(len(output)) + length > original
        return bitio.failure("overrun", int(len(output)))
    for _ < length
        output = output.append(output[int(len(output)) - distance])
    return bitio.Decoded(output)
