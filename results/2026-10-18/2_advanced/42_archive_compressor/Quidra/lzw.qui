public import bitio = "./bitio.qui"

map.Map<string, int> encoding_dictionary()
    map.Map<string, int> result = map.Map<string, int>()
    for int value < 256
        .result.set("{value}", value)
    return result

int lookup(map.Map<string, int> values, string name)
    match values.get(name)
        int value
            return value
        none
            return -1

int[][] decoding_dictionary()
    int[][] result = []
    for int value < 256
        result = result.append([value])
    return result.concat([[], []])

void emit(bitio.Writer &writer, int[] &stats, int &since_clear, int code, int length = 0)
    int width = bitio.bits(258 + since_clear)
    if width > 12
        width = 12
    .writer.write(code, width)
    stats[0] += 1
    stats[width - 7] += 1
    if length > stats[6]
        stats[6] = length
    if code == 256
        stats[1] += 1
        since_clear = 0
    else
        since_clear += 1

class Encoded(int[] data, int[] stats)

Encoded encode(int[] data)
    bitio.Writer writer = bitio.Writer()
    map.Map<string, int> dictionary = encoding_dictionary()
    int next_code = 258
    int since_clear = 0
    int[] stats = [0, 0, 0, 0, 0, 0, 0]
    emit(&writer, &stats, &since_clear, 256)
    int[] sequence = []
    for int value = data[]
        int[] extended = sequence.append(value)
        string extended_key = bitio.key(extended)
        if lookup(dictionary, extended_key) >= 0
            sequence = extended
        else
            emit(&writer, &stats, &since_clear, lookup(dictionary, bitio.key(sequence)), int(len(sequence)))
            .dictionary.set(extended_key, next_code)
            next_code += 1
            if next_code == 4096
                emit(&writer, &stats, &since_clear, 256)
                dictionary = encoding_dictionary()
                next_code = 258
            sequence = [value]
    if len(sequence) > 0
        emit(&writer, &stats, &since_clear, lookup(dictionary, bitio.key(sequence)), int(len(sequence)))
    emit(&writer, &stats, &since_clear, 257)
    return Encoded(writer.finish(), stats)

bitio.Decoded decode(int[] payload, int original)
    bitio.Reader reader = bitio.Reader(payload)
    int[][] dictionary = decoding_dictionary()
    int previous = -1
    int since_clear = 0
    int[] output = []
    while true
        int count = since_clear
        int width = bitio.bits(258 + count)
        if width > 12
            width = 12
        int code = .reader.read(width, int(len(output)))
        if reader.failed()
            return bitio.Decoded([], reader.problems)
        if code == 256
            dictionary = decoding_dictionary()
            previous = -1
            since_clear = 0
            continue
        since_clear += 1
        if code == 257
            if int(len(output)) < original
                return bitio.failure("early_end", int(len(output)))
            return bitio.Decoded(output)
        if count == 3838
            return bitio.failure("bad_code", int(len(output)))
        int next_code = int(len(dictionary))
        int[] sequence = []
        if previous < 0
            if code >= 256
                return bitio.failure("bad_code", int(len(output)))
            sequence = dictionary[code]
        elif code < next_code
            sequence = dictionary[code]
        elif code == next_code
            sequence = dictionary[previous].append(dictionary[previous][0])
        else
            return bitio.failure("bad_code", int(len(output)))
        if int(len(output)) + int(len(sequence)) > original
            return bitio.failure("overrun", int(len(output)))
        output = output.concat(sequence)
        if previous >= 0
            dictionary = dictionary.append(dictionary[previous].append(sequence[0]))
        previous = code
    return bitio.Decoded(output)
