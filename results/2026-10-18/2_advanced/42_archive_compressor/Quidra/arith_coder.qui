public import bitio = "./bitio.qui"

class Model()
    int[][] frequencies = array(256, fill = array(257, fill = 1))
    int[] totals = array(256, fill = 257)
    int[] rescales = array(256, fill = 0)
    bool[] used = array(256, fill = false)

    int[] interval(int context, int symbol)
        int cumulative = 0
        for int index < symbol
            cumulative += frequencies[context][index]
        return [cumulative, frequencies[context][symbol]]

    int[] locate(int context, int value)
        int symbol = 0
        int cumulative = 0
        while value >= cumulative + frequencies[context][symbol]
            cumulative += frequencies[context][symbol]
            symbol += 1
        return [symbol, cumulative, frequencies[context][symbol]]

    void .update(int context, int symbol)
        frequencies[context][symbol] += 32
        totals[context] += 32
        if totals[context] >= 8192
            totals[context] = 0
            for int index < 257
                frequencies[context][index] = (frequencies[context][index] + 1) / 2
                totals[context] += frequencies[context][index]
            rescales[context] += 1

void emit(bitio.Writer &writer, int &follow, int bit)
    .writer.write(bit, 1)
    for _ < follow
        .writer.write(1 - bit, 1)
    follow = 0

class Encoded(int[] data, int[] stats)

Encoded encode(int[] data)
    bitio.Writer writer = bitio.Writer()
    Model model = Model()
    int low = 0
    int high = 65535
    int follow = 0
    int context = 10
    for int position <= int(len(data))
        int symbol = if position < int(len(data)) then data[position] else 256
        model.used[context] = true
        int[] range = model.interval(context, symbol)
        int span = high - low + 1
        high = low + span * (range[0] + range[1]) / model.totals[context] - 1
        low += span * range[0] / model.totals[context]
        while true
            if high < 32768
                emit(&writer, &follow, 0)
            elif low >= 32768
                emit(&writer, &follow, 1)
                low -= 32768
                high -= 32768
            elif low >= 16384 and high < 49152
                follow += 1
                low -= 16384
                high -= 16384
            else
                break
            low *= 2
            high = 2 * high + 1
        if symbol != 256
            .model.update(context, symbol)
            context = symbol
    follow += 1
    emit(&writer, &follow, if low < 16384 then 0 else 1)
    int contexts = 0
    int rescales = 0
    for int index < 256
        if model.used[index]
            contexts += 1
        rescales += model.rescales[index]
    return Encoded(writer.finish(), [writer.bit_count, contexts, rescales])

bitio.Decoded decode(int[] payload, int original)
    bitio.Reader reader = bitio.Reader(payload, true)
    Model model = Model()
    int[] output = []
    int low = 0
    int high = 65535
    int value = .reader.read(16)
    int context = 10
    while true
        int span = high - low + 1
        int quantile = ((value - low + 1) * model.totals[context] - 1) / span
        int[] range = model.locate(context, quantile)
        int symbol = range[0]
        high = low + span * (range[1] + range[2]) / model.totals[context] - 1
        low += span * range[1] / model.totals[context]
        while true
            if high >= 32768
                if low >= 32768
                    low -= 32768
                    high -= 32768
                    value -= 32768
                elif low >= 16384 and high < 49152
                    low -= 16384
                    high -= 16384
                    value -= 16384
                else
                    break
            low *= 2
            high = 2 * high + 1
            int next_bit = .reader.read(1)
            value = 2 * value + next_bit
        if symbol == 256
            if int(len(output)) < original
                return bitio.failure("early_end", int(len(output)))
            return bitio.Decoded(output)
        if int(len(output)) == original
            return bitio.failure("overrun", int(len(output)))
        output = output.append(symbol)
        .model.update(context, symbol)
        context = symbol
    return bitio.Decoded(output)
