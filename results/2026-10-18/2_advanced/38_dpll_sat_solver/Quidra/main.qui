import encoders = "./encoders.qui"
import preprocess = "./preprocess.qui"
import dpll = "./dpll.qui"
import report = "./report.qui"

int absolute(int value)
    return if value < 0 then -value else value

bool only_name(string text)
    if len(text) < 1 or len(text) > 20
        return false
    for int index < int(len(text))
        if not "abcdefghijklmnopqrstuvwxyz0123456789_".contains(text[index])
            return false
    return true

string[] commands()
    return ["SOLVE", "ENUM", "CORE", "QUEENS", "PIGEON", "COLOR", "CHROMATIC"]

string[] argument_types(string command)
    return if command == "SOLVE" or command == "CORE" then ["file"] elif command == "ENUM" then ["file", "limit"] elif command == "QUEENS" then ["small", "limit"] elif command == "PIGEON" then ["small", "small", "limit"] elif command == "COLOR" then ["graph", "color", "limit"] elif command == "CHROMATIC" then ["graph", "color"] else []

class Graph(string name, int vertices)
    int[][] edges = []
    string invalid = ""
    int[] degree = array(nat(vertices), fill = 0)
    bool[][] neighbors = array(nat(vertices), fill = array(nat(vertices), fill = false))
    int[] greedy = array(nat(vertices), fill = 0)
    int used = 0
    int max_degree = 0

    void .finish()
        int[][] ordered = []
        for int[] edge = edges[]
            int place = int(len(ordered))
            ordered = ordered.append(edge)
            while place > 0 and (edge[0] < ordered[place - 1][0] or (edge[0] == ordered[place - 1][0] and edge[1] < ordered[place - 1][1]))
                ordered[place] = ordered[place - 1]
                place -= 1
            ordered[place] = edge
        edges = ordered
        for int[] edge = edges[]
            degree[edge[0] - 1] += 1
            degree[edge[1] - 1] += 1
            neighbors[edge[0] - 1][edge[1] - 1] = true
            neighbors[edge[1] - 1][edge[0] - 1] = true
        int[] order = []
        for int vertex < vertices
            int place = int(len(order))
            order = order.append(vertex)
            while place > 0 and degree[vertex] > degree[order[place - 1]]
                order[place] = order[place - 1]
                place -= 1
            order[place] = vertex
        for int vertex = order[]
            bool[] present = array(nat(vertices + 1), fill = false)
            for int adjacent < vertices
                if neighbors[vertex][adjacent] and greedy[adjacent] > 0
                    present[greedy[adjacent]] = true
            int candidate = 1
            while present[candidate]
                candidate += 1
            greedy[vertex] = candidate
            if candidate > used
                used = candidate
            if degree[vertex] > max_degree
                max_degree = degree[vertex]

Graph[] load_graphs()
    Graph[] graphs = []
    int current = -1
    string[] lines = encoders.cnf.read_lines("input/graphs.txt")
    for int index < int(len(lines))
        string line = lines[index]
        if current < 0
            if line != "" and not line.starts_with("#")
                string[] header = line.split(" ")
                int vertices = int.parse(header[2])
                current = int(len(graphs))
                graphs = graphs.append(Graph(header[1], vertices))
            continue
        Graph graph = graphs[current]
        if line == "END"
            .graph.finish()
            graphs[current] = graph
            current = -1
            continue
        if graph.invalid != ""
            continue
        string[] tokens = line.split(" ")
        string reason = ""
        if len(tokens) != 2 or not encoders.cnf.valid_number(tokens[0]) or not encoders.cnf.valid_number(tokens[1])
            reason = "bad edge line"
        else
            int first = int.parse(tokens[0])
            int second = int.parse(tokens[1])
            if first < 1 or first > graph.vertices or second < 1 or second > graph.vertices
                reason = "vertex out of range"
            elif first == second
                reason = "self loop"
            else
                int a = if first < second then first else second
                int b = if first < second then second else first
                bool duplicate = false
                for int[] edge = graph.edges[]
                    if edge[0] == a and edge[1] == b
                        duplicate = true
                        break
                if duplicate
                    reason = "duplicate edge"
                else
                    graph.edges = graph.edges.append([a, b])
        if reason != ""
            graph.invalid = reason + " at line {index + 1}"
        graphs[current] = graph
    return graphs

int graph_index(Graph[] graphs, string name)
    for int index < int(len(graphs))
        if graphs[index].name == name
            return index
    return -1

class Analysis()
    int failure_model = -1
    int failure_clause = -1
    int[] distribution = []
    int[] safe = []
    int[] diversity = []
    int[] backbone = []

class Solution(int variables, int[][] clauses, preprocess.Preparation[] preparations)
    bool[][] models = []
    string status = "UNSAT"
    int rounds = 0
    string stop = "limit"
    string[] trace = []
    int decisions = 0
    int propagations = 0
    int conflicts = 0
    int max_depth = 0
    int removed = preparations[0].counts[7]
    int colors = 0

Solution solve_formula(int variables, int[][] clauses, int limit)
    preprocess.Preparation preparation = preprocess.run(variables, clauses, limit == 1)
    Solution solution = Solution(variables, clauses, [preparation])
    int[][] blocking = []
    if preparation.empty_clause >= 0
        solution.stop = "preprocess"
    else
        while int(len(solution.models)) < limit
            solution.rounds += 1
            dpll.Round search = dpll.Round(variables, preparation.clauses.concat(blocking))
            dpll.Result result = .search.run()
            if solution.rounds == 1
                solution.trace = result.trace
            solution.decisions += result.decisions
            solution.propagations += result.propagations
            solution.conflicts += result.conflicts
            if result.max_depth > solution.max_depth
                solution.max_depth = result.max_depth
            if not result.satisfiable
                solution.stop = "all"
                break
            bool[] model = result.model
            for int variable < variables
                if preparation.fixed[variable] >= 0
                    model[variable] = preparation.fixed[variable] == 1
            solution.models = solution.models.append(model)
            int[] block = []
            for int variable = preparation.active[]
                block = block.append(if model[variable - 1] then -variable else variable)
            blocking = blocking.append(block)
    if len(solution.models) > 0
        solution.status = "SAT"
    return solution

bool true_literal(bool[] model, int literal)
    return if literal > 0 then model[literal - 1] else not model[-literal - 1]

bool satisfies(bool[] model, int[][] clauses)
    for int[] clause = clauses[]
        bool satisfied = false
        for int literal = clause[]
            if true_literal(model, literal)
                satisfied = true
                break
        if not satisfied
            return false
    return true

Analysis analyze(bool[][] models, int[][] clauses, int variables)
    Analysis analysis = Analysis()
    for int index < int(len(models))
        for int number < int(len(clauses))
            if not satisfies(models[index], [clauses[number]])
                analysis.failure_model = index + 1
                analysis.failure_clause = number + 1
                break
        if analysis.failure_model >= 0
            break
    for int[] clause = clauses[]
        int count = 0
        for int literal = clause[]
            if true_literal(models[0], literal)
                count += 1
        analysis.distribution = analysis.distribution.append(count)
    for int variable < variables
        bool[] inverted = models[0]
        inverted[variable] = not inverted[variable]
        if satisfies(inverted, clauses)
            analysis.safe = analysis.safe.append(variable + 1)
        bool same = true
        for bool[] model = models[]
            if model[variable] != models[0][variable]
                same = false
                break
        if same
            analysis.backbone = analysis.backbone.append(if models[0][variable] then variable + 1 else -(variable + 1))
    for int first < int(len(models))
        for first + 1 <= int second < int(len(models))
            int distance = 0
            for int variable < variables
                if models[first][variable] != models[second][variable]
                    distance += 1
            analysis.diversity = analysis.diversity.append(distance)
    return analysis

class Core(int[] clauses, int decisions, int conflicts)

Core unsat_core(int variables, int[][] clauses)
    bool[] remaining = array(len(clauses), fill = true)
    int decisions = 0
    int conflicts = 0
    for int remove < int(len(clauses))
        int[][] candidate = []
        for int index < int(len(clauses))
            if remaining[index] and index != remove
                candidate = candidate.append(clauses[index])
        Solution testing = solve_formula(variables, candidate, 1)
        decisions += testing.decisions
        conflicts += testing.conflicts
        if testing.status == "UNSAT"
            remaining[remove] = false
    int[] core = []
    for int index < int(len(clauses))
        if remaining[index]
            core = core.append(index + 1)
    return Core(core, decisions, conflicts)

class Job(int number, string text, string command, string[] args)
    string reason = ""
    int graph = -1
    int colors = 0
    int chromatic = -1
    Solution[] attempts = []
    Analysis[] analyses = []
    Core[] cores = []
    int decisions = 0
    int propagations = 0
    int conflicts = 0
    int max_depth = 0
    int rounds = 0
    int removed = 0

Job[] load_jobs()
    Job[] jobs = []
    for string line = encoders.cnf.read_lines("input/jobs.txt")[]
        if line != "" and not line.starts_with("#")
            string[] tokens = line.split(" ")
            jobs = jobs.append(Job(int(len(jobs)) + 1, line, tokens[0], tokens[1:]))
    return jobs

string validate(Job job, Graph[] graphs)
    string[] types = argument_types(job.command)
    if len(types) == 0
        return "unknown command {job.command}"
    if len(job.args) != len(types)
        return "wrong argument count"
    for int index < int(len(types))
        string argument = job.args[index]
        string kind = types[index]
        if kind == "file"
            if not argument.ends_with(".cnf") or not only_name(argument[0:<int(len(argument)) - 4])
                return "bad file name {argument}"
        elif kind == "graph"
            int selected = graph_index(graphs, argument)
            if selected < 0
                return "unknown graph {argument}"
            if graphs[selected].invalid != ""
                return "invalid graph {argument}: {graphs[selected].invalid}"
        else
            if not encoders.cnf.valid_number(argument)
                return "bad number {argument}"
            int value = int.parse(argument)
            int maximum = if kind == "small" then 8 elif kind == "color" then 6 else 200
            if value < 1 or value > maximum
                return "out of range {argument}"
    return ""

Job execute(Job job, Graph[] graphs)
    job.reason = validate(job, graphs)
    if job.reason != ""
        return job
    if job.command == "CHROMATIC"
        job.graph = graph_index(graphs, job.args[0])
        Graph graph = graphs[job.graph]
        int bound = int.parse(job.args[1])
        for 1 <= int colors <= bound
            encoders.cnf.Formula formula = encoders.coloring(graph.vertices, graph.edges, colors)
            Solution solution = solve_formula(formula.variables, formula.clauses, 1)
            solution.colors = colors
            job.attempts = job.attempts.append(solution)
            job.decisions += solution.decisions
            job.propagations += solution.propagations
            job.conflicts += solution.conflicts
            if solution.max_depth > job.max_depth
                job.max_depth = solution.max_depth
            job.rounds += solution.rounds
            job.removed += solution.removed
            job.colors = colors
            if solution.status == "SAT"
                job.chromatic = colors
                break
    else
        encoders.cnf.Formula formula = encoders.cnf.Formula(0, [])
        int limit = 1
        if job.command == "SOLVE" or job.command == "ENUM" or job.command == "CORE"
            formula = encoders.cnf.read(job.args[0])
            if formula.reason != ""
                job.reason = formula.reason
                return job
            if job.command == "ENUM"
                limit = int.parse(job.args[1])
        elif job.command == "QUEENS"
            int n = int.parse(job.args[0])
            formula = encoders.queens(n)
            limit = int.parse(job.args[1])
        elif job.command == "PIGEON"
            int pigeons = int.parse(job.args[0])
            int holes = int.parse(job.args[1])
            formula = encoders.pigeon(pigeons, holes)
            limit = int.parse(job.args[2])
        else
            job.graph = graph_index(graphs, job.args[0])
            job.colors = int.parse(job.args[1])
            Graph graph = graphs[job.graph]
            formula = encoders.coloring(graph.vertices, graph.edges, job.colors)
            limit = int.parse(job.args[2])
        Solution solution = solve_formula(formula.variables, formula.clauses, limit)
        job.attempts = [solution]
        job.decisions = solution.decisions
        job.propagations = solution.propagations
        job.conflicts = solution.conflicts
        job.max_depth = solution.max_depth
        job.rounds = solution.rounds
        job.removed = solution.removed
        if job.command == "CORE" and solution.status == "UNSAT"
            job.cores = [unsat_core(formula.variables, formula.clauses)]
    Solution solution = job.attempts[len(job.attempts) - 1]
    if len(solution.models) > 0
        job.analyses = [analyze(solution.models, solution.clauses, solution.variables)]
    return job

string heading(Job job)
    return "JOB {job.number} {job.text}"

string formula_summary(int variables, int[][] clauses)
    int[] lengths = [for int[] clause = clauses[] then int(len(clause))]
    int literals = 0
    for int length = lengths[]
        literals += length
    return "variables={variables} clauses={len(clauses)} literals={literals} lengths=" + report.frequency(lengths)

string graph_summary(Graph graph)
    return "graph vertices={graph.vertices} edges={len(graph.edges)} max_degree={graph.max_degree} greedy={graph.used}"

string search_report(int decisions, int propagations, int conflicts, int max_depth)
    return "search " + report.named(["decisions", "propagations", "conflicts", "max_depth"], ["{decisions}", "{propagations}", "{conflicts}", "{max_depth}"])

string[] preprocessing_report(preprocess.Preparation preparation)
    int[] counts = preparation.counts
    int[][] records = preparation.records
    string[] lines = ["preprocess " + report.named(["pure", "tautologies", "duplicate_literals", "unit_fixed", "unit_removed", "subsumed", "pure_fixed", "pure_removed", "removed"], [if preparation.pure then "on" else "off", "{counts[0]}", "{counts[1]}", "{counts[2]}", "{counts[3]}", "{counts[4]}", "{counts[5]}", "{counts[6]}", "{counts[7]}"]), "removed_clauses " + report.named(["tautology", "unit", "subsumed", "pure"], [report.number_list(records[0]), report.number_list(records[1]), report.number_list(records[2]), report.number_list(records[3])])]
    if preparation.empty_clause >= 0
        lines = lines.append("simplified empty_clause={preparation.empty_clause}")
    else
        int[] lengths = [for int[] clause = preparation.clauses[] then int(len(clause))]
        int literals = 0
        for int length = lengths[]
            literals += length
        int[] fixed = []
        for int index < int(len(preparation.fixed))
            if preparation.fixed[index] >= 0
                fixed = fixed.append(if preparation.fixed[index] == 1 then index + 1 else -(index + 1))
        lines = lines.concat(["simplified clauses={len(lengths)} literals={literals} lengths=" + report.frequency(lengths) + " fixed={len(fixed)} active={len(preparation.active)}", "fixed literals=" + report.number_list(fixed)])
    return lines

string verification_report(Solution solution, Analysis analysis)
    if analysis.failure_model >= 0
        return "verify failed model={analysis.failure_model} clause={analysis.failure_clause}"
    return "verify ok models={len(solution.models)} clauses={len(solution.clauses)} true_literals=" + report.frequency(analysis.distribution)

string[] analysis_report(Solution solution, Analysis analysis)
    string[] lines = [verification_report(solution, analysis), "flips safe={len(analysis.safe)} variables=" + report.number_list(analysis.safe)]
    if len(analysis.diversity) > 0
        int[] ordered = analysis.diversity.sorted()
        lines = lines.append("diversity pairs={len(ordered)} min_distance={ordered[0]} max_distance={ordered[len(ordered) - 1]}")
    if solution.stop == "all"
        lines = lines.append("backbone size={len(analysis.backbone)} literals=" + report.number_list(analysis.backbone))
    return lines

string[] result_paragraph(Job job, Graph[] graphs)
    string[] lines = [heading(job)]
    if job.reason != ""
        return lines.append("error {job.reason}")
    Solution solution = job.attempts[len(job.attempts) - 1]
    if job.command == "CHROMATIC"
        lines = lines.append(graph_summary(graphs[job.graph]))
        for Solution attempt = job.attempts[]
            lines = lines.append("attempt " + report.named(["k", "clauses", "removed", "result", "stop", "decisions", "propagations", "conflicts", "max_depth"], ["{attempt.colors}", "{len(attempt.clauses)}", "{attempt.removed}", attempt.status, attempt.stop, "{attempt.decisions}", "{attempt.propagations}", "{attempt.conflicts}", "{attempt.max_depth}"]))
        string chromatic = if job.chromatic < 0 then "-" else "{job.chromatic}"
        lines = lines.concat(["result {solution.status} chromatic={chromatic} attempts={len(job.attempts)}", search_report(job.decisions, job.propagations, job.conflicts, job.max_depth)])
        if len(job.analyses) > 0
            Analysis analysis = job.analyses[0]
            lines = lines.concat([verification_report(solution, analysis), "flips safe={len(analysis.safe)} variables=" + report.number_list(analysis.safe)])
    else
        if job.command == "COLOR"
            lines = lines.append(graph_summary(graphs[job.graph]))
        lines = lines.append("formula " + formula_summary(solution.variables, solution.clauses)).concat(preprocessing_report(solution.preparations[0]))
        lines = lines.concat(["result {solution.status} models={len(solution.models)} rounds={solution.rounds} stop={solution.stop}", search_report(solution.decisions, solution.propagations, solution.conflicts, solution.max_depth)])
        if solution.rounds > 0
            int count = if len(solution.trace) < 12 then int(len(solution.trace)) else 12
            string text = if count == 0 then "-" else solution.trace[0:<count].join(" ")
            if len(solution.trace) > 12
                text += " +{int(len(solution.trace)) - 12}"
            lines = lines.append("trace " + text)
        if len(job.analyses) > 0
            lines = lines.concat(analysis_report(solution, job.analyses[0]))
        if len(job.cores) > 0
            Core core = job.cores[0]
            lines = lines.append("core size={len(core.clauses)} decisions={core.decisions} conflicts={core.conflicts} clauses=" + report.number_list(core.clauses))
    return lines

bool sequence_equal(int[] first, int[] second)
    if len(first) != len(second)
        return false
    for int index < int(len(first))
        if first[index] != second[index]
            return false
    return true

bool sequence_less(int[] first, int[] second)
    for int index < int(len(first))
        if first[index] != second[index]
            return first[index] < second[index]
    return false

class Symmetry(int[] canonical, int orbit)

Symmetry canonical_queens(int[] columns)
    int n = int(len(columns))
    int[][] variants = []
    int[][] distinct = []
    for int transform < 8
        int[] current = array(nat(n), fill = 0)
        for int index < n
            int row = index + 1
            int column = columns[index]
            int r = row
            int c = column
            if transform == 1
                r = column
                c = n + 1 - row
            elif transform == 2
                r = n + 1 - row
                c = n + 1 - column
            elif transform == 3
                r = n + 1 - column
                c = row
            elif transform == 4
                c = n + 1 - column
            elif transform == 5
                r = n + 1 - row
            elif transform == 6
                r = column
                c = row
            elif transform == 7
                r = n + 1 - column
                c = n + 1 - row
            current[r - 1] = c
        variants = variants.append(current)
        bool known = false
        for int[] before = distinct[]
            if sequence_equal(current, before)
                known = true
                break
        if not known
            distinct = distinct.append(current)
    int[] best = variants[0]
    for int[] variant = variants[]
        if sequence_less(variant, best)
            best = variant
    return Symmetry(best, int(len(distinct)))

class Coloring(int[] canonical, int used)

Coloring canonical_colors(int[] colors)
    int[] seen = []
    int[] canonical = []
    for int color = colors[]
        int selected = -1
        for int index < int(len(seen))
            if seen[index] == color
                selected = index
        if selected < 0
            selected = int(len(seen))
            seen = seen.append(color)
        canonical = canonical.append(selected + 1)
    return Coloring(canonical, int(len(seen)))

class Group(int number, int first, int[] canonical, int orbit)
    int found = 0

string[] boards(Job job, Graph[] graphs)
    Solution solution = job.attempts[len(job.attempts) - 1]
    if job.command == "PIGEON"
        int p = int.parse(job.args[0])
        int h = int.parse(job.args[1])
        string[] lines = ["PIGEON job={job.number} pigeons={p} holes={h}"]
        for int index < int(len(solution.models))
            int[] places = encoders.positions(solution.models[index], p, h)
            bool[] occupied = array(nat(h + 1), fill = false)
            for int hole = places[]
                occupied[hole] = true
            int[] empty = []
            for 1 <= int hole <= h
                if not occupied[hole]
                    empty = empty.append(hole)
            lines = lines.append("assignment {index + 1} holes=" + report.number_list(places) + " empty=" + report.number_list(empty))
        int expected = if p <= h then 1 else 0
        if p <= h
            for int offset < p
                expected *= h - offset
        return lines.append("summary assignments={len(solution.models)} stop={solution.stop} expected={expected}")
    bool queens = job.command == "QUEENS"
    int rows = if queens then int.parse(job.args[0]) else graphs[job.graph].vertices
    int width = if queens then rows else job.colors
    string[] lines = []
    if queens
        lines = ["QUEENS job={job.number} n={rows}"]
    else
        Graph graph = graphs[job.graph]
        lines = ["{job.command} job={job.number} graph={graph.name} vertices={rows} edges={len(graph.edges)} colors={width}", "greedy used={graph.used} colors=" + report.number_list(graph.greedy)]
    Group[] groups = []
    for int index < int(len(solution.models))
        int[] places = encoders.positions(solution.models[index], rows, width)
        int[] canonical = []
        int orbit = 0
        int used = 0
        if queens
            Symmetry symmetry = canonical_queens(places)
            canonical = symmetry.canonical
            orbit = symmetry.orbit
        else
            Coloring coloring = canonical_colors(places)
            canonical = coloring.canonical
            used = coloring.used
        int selected = -1
        for int group < int(len(groups))
            if sequence_equal(canonical, groups[group].canonical)
                selected = group
                break
        bool first = selected < 0
        if first
            selected = int(len(groups))
            groups = groups.append(Group(selected + 1, index + 1, canonical, orbit))
        groups[selected].found += 1
        if queens
            lines = lines.append("solution {index + 1} columns=" + report.number_list(places) + " class={selected + 1}")
            if first
                lines = lines.concat(report.queens_board(places))
        else
            int[] sizes = array(nat(width), fill = 0)
            for int color = places[]
                sizes[color - 1] += 1
            lines = lines.append("coloring {index + 1} colors=" + report.number_list(places) + " used={used} sizes=" + report.number_list(sizes) + " class={selected + 1}")
    for Group group = groups[]
        string text = "class {group.number}"
        if queens
            text += " orbit={group.orbit}"
        lines = lines.append(text + " found={group.found} first={group.first} canonical=" + report.number_list(group.canonical))
    string name = if queens then "solutions" else "colorings"
    return lines.append("summary {name}={len(solution.models)} stop={solution.stop} classes={len(groups)}")

string[] summary(Job[] jobs, Job[] valid)
    int sat = 0
    int models = 0
    int rounds = 0
    int decisions = 0
    int propagations = 0
    int conflicts = 0
    int removed = 0
    for Job job = valid[]
        Solution solution = job.attempts[len(job.attempts) - 1]
        if solution.status == "SAT"
            sat += 1
        models += int(len(solution.models))
        rounds += job.rounds
        decisions += job.decisions
        propagations += job.propagations
        conflicts += job.conflicts
        removed += job.removed
    string[] lines = ["SUMMARY jobs={len(jobs)} sat={sat} unsat={int(len(valid)) - sat} error={int(len(jobs)) - int(len(valid))}", "totals models={models} rounds={rounds} decisions={decisions} propagations={propagations} conflicts={conflicts} removed_clauses={removed}"]
    for string command = commands()[]
        int count = 0
        int yes = 0
        int no = 0
        int d = 0
        int p = 0
        int c = 0
        for Job job = valid[]
            if job.command == command
                count += 1
                if job.attempts[len(job.attempts) - 1].status == "SAT"
                    yes += 1
                else
                    no += 1
                d += job.decisions
                p += job.propagations
                c += job.conflicts
        if count > 0
            lines = lines.append("command {command} jobs={count} sat={yes} unsat={no} decisions={d} propagations={p} conflicts={c}")
    if len(valid) > 0
        int hardest = 0
        int deepest = 0
        int busiest = 0
        for int index < int(len(valid))
            if valid[index].conflicts > valid[hardest].conflicts
                hardest = index
            if valid[index].max_depth > valid[deepest].max_depth
                deepest = index
            if valid[index].propagations > valid[busiest].propagations
                busiest = index
        lines = lines.concat(["hardest job={valid[hardest].number} conflicts={valid[hardest].conflicts}", "deepest job={valid[deepest].number} max_depth={valid[deepest].max_depth}", "busiest job={valid[busiest].number} propagations={valid[busiest].propagations}"])
    return lines

Graph[] graphs = load_graphs()
Job[] jobs = load_jobs()
Job[] valid = []
string[][] results = []
string[][] models_output = []
string[][] boards_output = []
string[] stats_output = ["job,command,status,variables,clauses,removed_clauses,decisions,propagations,conflicts,max_depth,models,rounds"]
for int index < int(len(jobs))
    Job job = execute(jobs[index], graphs)
    jobs[index] = job
    results = results.append(result_paragraph(job, graphs))
    if job.reason != ""
        continue
    valid = valid.append(job)
    Solution solution = job.attempts[len(job.attempts) - 1]
    if len(solution.models) > 0
        string[] lines = [heading(job)]
        for int number < int(len(solution.models))
            lines = lines.append("model {number + 1}").concat(encoders.cnf.model_lines(solution.models[number]))
        models_output = models_output.append(lines)
    if job.command == "QUEENS" or job.command == "PIGEON" or job.command == "COLOR" or job.command == "CHROMATIC"
        boards_output = boards_output.append(boards(job, graphs))
    string[] fields = ["{job.number}", job.command, solution.status, "{solution.variables}", "{len(solution.clauses)}", "{job.removed}", "{job.decisions}", "{job.propagations}", "{job.conflicts}", "{job.max_depth}", "{len(solution.models)}", "{job.rounds}"]
    stats_output = stats_output.append(fields.join(","))
results = results.append(summary(jobs, valid))
bool output_exists = file.is_directory("output")
if not output_exists
    file.mkdir("output")
report.save_paragraphs("results.txt", results)
report.save_paragraphs("models.txt", models_output)
report.save_paragraphs("boards.txt", boards_output)
report.save_lines("stats.csv", stats_output)
