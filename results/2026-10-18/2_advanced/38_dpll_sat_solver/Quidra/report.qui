string named(string[] names, string[] values)
    string[] fields = []
    for int index < int(len(names))
        fields = fields.append(names[index] + "=" + values[index])
    return fields.join(" ")

string number_list(int[] values)
    return if len(values) == 0 then "-" else [for int value = values[] then "{value}"].join(",")

string frequency(int[] values)
    int[] ordered = values.sorted()
    string[] fields = []
    int index = 0
    while index < int(len(ordered))
        int end = index + 1
        while end < int(len(ordered)) and ordered[end] == ordered[index]
            end += 1
        fields = fields.append("{ordered[index]}:{end - index}")
        index = end
    return if len(fields) == 0 then "-" else fields.join(",")

string[] queens_board(int[] columns)
    int count = int(len(columns))
    return [for int column = columns[] then string.repeat(".", nat(column - 1)) + "Q" + string.repeat(".", nat(count - column))]

void save_lines(string filename, string[] lines)
    file.write("output/" + filename, if len(lines) == 0 then "" else lines.join(NL) + NL)

void save_paragraphs(string filename, string[][] paragraphs)
    string[] parts = [for string[] lines = paragraphs[] then lines.join(NL)]
    file.write("output/" + filename, if len(parts) == 0 then "" else parts.join(NL + NL) + NL)
