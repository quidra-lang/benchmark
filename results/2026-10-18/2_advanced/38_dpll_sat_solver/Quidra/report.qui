string named(string[] names, string[] values)
    string[] fields := []
    for: index < int(len(names))
        fields = fields.append(names[index] + "=" + values[index])
    return fields.join(" ")

string number_list(int[] values)
    return if len(values) == 0 then "-" else [for value := values[] then "{value}"].join(",")

string frequency(int[] values)
    ordered := values.sorted()
    string[] fields := []
    index := 0
    while index < int(len(ordered))
        end := index + 1
        while end < int(len(ordered)) and ordered[end] == ordered[index]
            end += 1
        fields = fields.append("{ordered[index]}:{end - index}")
        index = end
    return if len(fields) == 0 then "-" else fields.join(",")

string[] queens_board(int[] columns)
    count := int(len(columns))
    return [for column := columns[] then string.repeat(".", nat(column - 1)) + "Q" + string.repeat(".", nat(count - column))]

void save_lines(string filename, string[] lines)
    writer1 := file.write("output/" + filename)
    .writer1(if len(lines) == 0 then "" else lines.join(NL) + NL)

void save_paragraphs(string filename, string[][] paragraphs)
    parts := [for lines := paragraphs[] then lines.join(NL)]
    writer2 := file.write("output/" + filename)
    .writer2(if len(parts) == 0 then "" else parts.join(NL + NL) + NL)
