int absolute(int value)
    return if value < 0 then -value else value

class Entry(int literal, string kind)
class Result(bool satisfiable, bool[] model, string[] trace, int decisions, int propagations, int conflicts, int max_depth)

class Round(int variables, int[][] clauses)
    int[] assignment = array(nat(variables), fill = -1)
    int[][] watches = array(nat(2 * variables + 1), fill = [])
    Entry[] trail = []
    int queue_head = 0
    string[] trace = []
    int decisions = 0
    int propagations = 0
    int conflicts = 0
    int max_depth = 0

    int value(int literal)
        int truth = assignment[absolute(literal) - 1]
        return if truth < 0 then -1 elif literal > 0 then truth else 1 - truth

    void .assign(int literal, string kind)
        assignment[absolute(literal) - 1] = if literal > 0 then 1 else 0
        trail = trail.append(Entry(literal, kind))
        trace = trace.append(kind + "{literal}")

    void .conflict()
        conflicts += 1
        trace = trace.append("C")

    Result .run()
        for int index < int(len(clauses))
            if len(clauses[index]) >= 2
                for int position < 2
                    int watched = clauses[index][position] + variables
                    watches[watched] = watches[watched].append(index)
        for int[] clause = clauses[]
            if len(clause) == 0
                .conflict()
                return Result(false, [], trace, decisions, propagations, conflicts, max_depth)
            if len(clause) == 1
                int truth = value(clause[0])
                if truth == 0
                    .conflict()
                    return Result(false, [], trace, decisions, propagations, conflicts, max_depth)
                if truth < 0
                    .assign(clause[0], "P")
                    propagations += 1
        bool finished = false
        bool satisfiable = false
        while not finished
            bool found_conflict = false
            while queue_head < int(len(trail))
                int false_literal = -trail[queue_head].literal
                queue_head += 1
                int watched = false_literal + variables
                int[] watch_list = watches[watched]
                int index = 0
                while index < int(len(watch_list))
                    int clause_id = watch_list[index]
                    int[] clause = clauses[clause_id]
                    if clause[0] == false_literal
                        int saved = clause[0]
                        clause[0] = clause[1]
                        clause[1] = saved
                        clauses[clause_id] = clause
                    int other = clause[0]
                    if value(other) == 1
                        index += 1
                        continue
                    int substitute = -1
                    for 2 <= int position < int(len(clause))
                        if value(clause[position]) != 0
                            substitute = position
                            break
                    if substitute >= 0
                        int saved = clause[1]
                        clause[1] = clause[substitute]
                        clause[substitute] = saved
                        clauses[clause_id] = clause
                        watch_list = watch_list[0:<index].concat(watch_list[index + 1:])
                        int new_watch = clause[1] + variables
                        watches[new_watch] = watches[new_watch].append(clause_id)
                        continue
                    int truth = value(other)
                    if truth == 0
                        .conflict()
                        found_conflict = true
                        break
                    if truth < 0
                        .assign(other, "P")
                        propagations += 1
                    index += 1
                watches[watched] = watch_list
                if found_conflict
                    break
            if found_conflict
                while len(trail) > 0 and trail[len(trail) - 1].kind != "D"
                    int literal = trail[len(trail) - 1].literal
                    assignment[absolute(literal) - 1] = -1
                    trail = trail[0:<int(len(trail)) - 1]
                if len(trail) == 0
                    finished = true
                else
                    int decision = trail[len(trail) - 1].literal
                    assignment[absolute(decision) - 1] = -1
                    trail = trail[0:<int(len(trail)) - 1]
                    .assign(-decision, "F")
                    queue_head = int(len(trail)) - 1
            else
                int[] counts = array(nat(2 * variables + 1), fill = 0)
                for int[] clause = clauses[]
                    bool satisfied = false
                    for int literal = clause[]
                        if value(literal) == 1
                            satisfied = true
                            break
                    if not satisfied
                        for int literal = clause[]
                            if value(literal) < 0
                                counts[literal + variables] += 1
                int best = 0
                int maximum = 0
                for 1 <= int variable <= variables
                    int[] literals = [variable, -variable]
                    for int literal = literals[]
                        if counts[literal + variables] > maximum
                            best = literal
                            maximum = counts[literal + variables]
                if best == 0
                    satisfiable = true
                    finished = true
                else
                    .assign(best, "D")
                    decisions += 1
                    int depth = 0
                    for Entry entry = trail[]
                        if entry.kind == "D" or entry.kind == "F"
                            depth += 1
                    if depth > max_depth
                        max_depth = depth
        bool[] model = [for int truth = assignment[] then truth == 1]
        return Result(satisfiable, model, trace, decisions, propagations, conflicts, max_depth)
