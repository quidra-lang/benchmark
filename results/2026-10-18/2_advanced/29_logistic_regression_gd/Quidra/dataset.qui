import math

class Example(string ident, real64[] values, int label)
class Examples(string[] names, Example[] rows)

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

Examples read_examples(string path)
    string[] lines = read_lines(path)
    string[] header = lines[0].split(",")
    string[] names = header[1:<len(header) - 1]
    Example[] rows = []
    for string line = lines[1:][]
        string[] fields = line.split(",")
        rows = rows.append(Example(fields[0], [for string value = fields[1:<len(fields) - 1][] then real64.parse(value)], int.parse(fields[len(fields) - 1])))
    return Examples(names, rows)

class Settings(local string[][] rows)
    int positive = int.parse(rows[0][1])
    int degree = int.parse(rows[1][1])
    real64 threshold = real64.parse(rows[2][1])
    real64[] lambdas = [for string value = rows[3][1:][] then real64.parse(value)]
    real64 gd_rate = real64.parse(rows[4][1])
    int gd_iterations = int.parse(rows[4][2])
    real64 sgd_rate = real64.parse(rows[5][1])
    int batch_size = int.parse(rows[5][2])
    int epochs = int.parse(rows[5][3])
    int sgd_seed = int.parse(rows[5][4])
    real64 softmax_rate = real64.parse(rows[6][1])
    int softmax_iterations = int.parse(rows[6][2])
    real64 softmax_lambda = real64.parse(rows[6][3])
    int bootstrap_count = int.parse(rows[7][1])
    int bootstrap_seed = int.parse(rows[7][2])
    int permutation_count = int.parse(rows[8][1])
    int permutation_seed = int.parse(rows[8][2])
    int map_width = int.parse(rows[9][1])
    int map_height = int.parse(rows[9][2])
    int cost_fp = int.parse(rows[10][1])
    int cost_fn = int.parse(rows[10][2])

Settings read_settings(string path)
    return Settings([for string line = read_lines(path)[] then line.split(" ")])

int[][] extend_tuples(int width, int remaining, int first, int[] prefix)
    if remaining == 0
        return [prefix]
    int[][] result = []
    for first <= int index < width
        result = result.concat(extend_tuples(width, remaining - 1, index, prefix.append(index)))
    return result

int[][] expansion_tuples(int width, int degree)
    int[][] result = []
    for 1 <= int length <= degree
        result = result.concat(extend_tuples(width, length, 0, []))
    return result

string[] expanded_names(string[] names, int[][] tuples)
    return [for int[] indices = tuples[] then [for int index = indices[] then names[index]].join("*")]

real64[] expanded_values(int[][] tuples, real64[] values)
    real64[] expanded = []
    for int[] indices = tuples[]
        real64 product = values[indices[0]]
        for int index = indices[1:][]
            product *= values[index]
        expanded = expanded.append(product)
    return expanded

class Statistics(real64[] means, real64[] deviations)

Statistics compute_statistics(real64[][] rows, int count)
    real64[] means = []
    real64[] deviations = []
    for int column < count
        real64 total = 0.0
        for real64[] row = rows[]
            total += row[column]
        real64 mean = total / real64(len(rows))
        real64 squares = 0.0
        for real64[] row = rows[]
            squares += (row[column] - mean) * (row[column] - mean)
        means = means.append(mean)
        deviations = deviations.append(math.sqrt(squares / real64(int(len(rows)) - 1)))
    return Statistics(means, deviations)

real64[] standardize(real64[] values, Statistics statistics, int count)
    return [1.0].concat([for int column = (0:<count)[] then (values[column] - statistics.means[column]) / statistics.deviations[column]])
