import math

real64 score(real64[] weights, real64[] vector)
    real64 total = 0.0
    for int column < int(len(weights))
        total += weights[column] * vector[column]
    return total

real64 probability(real64 value)
    if value >= 0.0
        return 1.0 / (1.0 + math.exp(-value))
    real64 exponential = math.exp(value)
    return exponential / (1.0 + exponential)

real64 loss(real64 value, int target)
    return math.max(value, 0.0) - real64(target) * value + math.log(1.0 + math.exp(-math.abs(value)))

real64 average_loss(real64[] weights, real64[][] vectors, int[] targets)
    real64 total = 0.0
    for int index < int(len(vectors))
        total += loss(score(weights, vectors[index]), targets[index])
    return total / real64(len(vectors))

real64 penalty(real64[] weights)
    real64 total = 0.0
    for real64 weight = weights[1:][]
        total += weight * weight
    return total

real64 objective(real64[] weights, real64[][] vectors, int[] targets, real64 lambda)
    return average_loss(weights, vectors, targets) + lambda * penalty(weights) / 2.0

real64[] gradient(real64[] weights, real64[][] vectors, int[] targets, real64 lambda)
    real64[] totals = array(len(weights), fill = 0.0)
    for int index < int(len(vectors))
        real64 residual = probability(score(weights, vectors[index])) - real64(targets[index])
        for int column < int(len(weights))
            totals[column] += residual * vectors[index][column]
    real64 count = real64(len(vectors))
    return [totals[0] / count].concat([for int column = (1:<int(len(weights)))[] then totals[column] / count + lambda * weights[column]])

real64[][] hessian(real64[] weights, real64[][] vectors, real64 lambda)
    int size = int(len(weights))
    real64[][] totals = array(nat(size), fill = array(nat(size), fill = 0.0))
    for real64[] vector = vectors[]
        real64 pi = probability(score(weights, vector))
        real64 variance = pi * (1.0 - pi)
        for int row < size
            for int column <= row
                totals[row][column] += variance * vector[row] * vector[column]
    real64[][] matrix = array(nat(size), fill = array(nat(size), fill = 0.0))
    for int row < size
        for int column <= row
            real64 value = totals[row][column] / real64(len(vectors))
            if row == column and row >= 1
                value += lambda
            matrix[row][column] = value
            matrix[column][row] = value
    return matrix
