import math
import logistic = "./logistic.qui"
import optimizers = "./optimizers.qui"

real64[] shifted_scores(real64[][] weights, real64[] vector)
    real64[] scores = [for real64[] row = weights[] then logistic.score(row, vector)]
    real64 top = math.max_all(scores)
    return [for real64 value = scores[] then value - top]

real64 exponential_total(real64[] shifted)
    real64 total = 0.0
    for real64 value = shifted[]
        total += math.exp(value)
    return total

real64[] probabilities(real64[][] weights, real64[] vector)
    real64[] shifted = shifted_scores(weights, vector)
    real64 total = exponential_total(shifted)
    return [for real64 value = shifted[] then math.exp(value) / total]

int predicted_class(real64[] class_probabilities)
    int best = 0
    for 1 <= int index < int(len(class_probabilities))
        if class_probabilities[index] > class_probabilities[best]
            best = index
    return best

real64 loss(real64[][] weights, real64[] vector, int label)
    real64[] shifted = shifted_scores(weights, vector)
    return math.log(exponential_total(shifted)) - shifted[label]

real64 average_loss(real64[][] weights, real64[][] vectors, int[] labels)
    real64 total = 0.0
    for int index < int(len(vectors))
        total += loss(weights, vectors[index], labels[index])
    return total / real64(len(vectors))

real64 penalty(real64[][] weights)
    real64 total = 0.0
    for real64[] row = weights[]
        for real64 weight = row[1:][]
            total += weight * weight
    return total

real64 objective(real64[][] weights, real64[][] vectors, int[] labels, real64 lambda)
    return average_loss(weights, vectors, labels) + lambda * penalty(weights) / 2.0

real64[][] gradient(real64[][] weights, real64[][] vectors, int[] labels, real64 lambda)
    int classes = int(len(weights))
    int size = int(len(weights[0]))
    real64[][] totals = array(nat(classes), fill = array(nat(size), fill = 0.0))
    for int index < int(len(vectors))
        real64[] class_probabilities = probabilities(weights, vectors[index])
        for int class_number < classes
            real64 residual = class_probabilities[class_number] - (if labels[index] == class_number then 1.0 else 0.0)
            for int column < size
                totals[class_number][column] += residual * vectors[index][column]
    real64[][] result = array(nat(classes), fill = array(nat(size), fill = 0.0))
    for int class_number < classes
        result[class_number][0] = totals[class_number][0] / real64(len(vectors))
        for 1 <= int column < size
            result[class_number][column] = totals[class_number][column] / real64(len(vectors)) + lambda * weights[class_number][column]
    return result

class Checkpoint(int iteration, real64[][] weights)

Checkpoint[] train(real64[][] vectors, int[] labels, int classes, real64 lambda, real64 rate, int iterations)
    real64[][] weights = array(nat(classes), fill = array(len(vectors[0]), fill = 0.0))
    Checkpoint[] checkpoints = [Checkpoint(0, weights)]
    for 1 <= int iteration <= iterations
        real64[][] direction = gradient(weights, vectors, labels, lambda)
        weights = [for int class_number = (0:<classes)[] then optimizers.move(weights[class_number], direction[class_number], rate)]
        if iteration % 100 == 0
            checkpoints = checkpoints.append(Checkpoint(iteration, weights))
    return checkpoints
