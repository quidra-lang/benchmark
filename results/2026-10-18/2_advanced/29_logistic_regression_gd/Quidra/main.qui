import math
import dataset = "./dataset.qui"
import logistic = "./logistic.qui"
import optimizers = "./optimizers.qui"
import softmax = "./softmax.qui"
import metrics = "./metrics.qui"

real64 total(real64[] values)
    real64 result = 0.0
    for real64 value = values[]
        result += value
    return result

real64 length(real64[] values)
    return math.sqrt(total([for real64 value = values[] then value * value]))

string reals(real64[] values, int places)
    return [for real64 value = values[] then metrics.fixed(value, places)].join(" ")

string integers(int[] values)
    return [for int value = values[] then "{value}"].join(" ")

int[] predict(real64[] probabilities, real64 threshold)
    return [for real64 value = probabilities[] then if value >= threshold then 1 else 0]

int count_equal(int[] first, int[] second)
    int count = 0
    for int index < int(len(first))
        if first[index] == second[index]
            count += 1
    return count

real64[] model_probabilities(real64[] weights, real64[][] vectors)
    return [for real64[] vector = vectors[] then logistic.probability(logistic.score(weights, vector))]

real64[] last_weights(optimizers.Checkpoint[] checkpoints)
    return checkpoints[len(checkpoints) - 1].weights

real64[][] inverse(real64[][] matrix)
    int size = int(len(matrix))
    real64[][] lower = optimizers.cholesky(matrix)
    real64[][] result = array(nat(size), fill = array(nat(size), fill = 0.0))
    for int column < size
        real64[] unit = array(nat(size), fill = 0.0)
        unit[column] = 1.0
        real64[] values = optimizers.solve(lower, unit)
        for int row < size
            result[row][column] = values[row]
    return result

class CrossValidation(real64 lambda, real64[] fold_losses, local real64[] losses, real64[] probabilities, int errors)
    real64 loss = total(losses) / real64(len(losses))

class Data(string[] names, dataset.Example[] train, dataset.Example[] test, dataset.Settings settings)
    int[][] tuples = dataset.expansion_tuples(int(len(names)), settings.degree)
    string[] feature_names = dataset.expanded_names(names, tuples)
    int feature_count = int(len(tuples))
    int classes = 0
    for dataset.Example example = train[]
        classes = math.max(classes, example.label + 1)
    real64[][] train_expanded = [for dataset.Example example = train[] then dataset.expanded_values(tuples, example.values)]
    real64[][] test_expanded = [for dataset.Example example = test[] then dataset.expanded_values(tuples, example.values)]
    dataset.Statistics overall = dataset.compute_statistics(train_expanded, feature_count)
    real64[][] train_vectors = [for real64[] values = train_expanded[] then dataset.standardize(values, overall, feature_count)]
    real64[][] test_vectors = [for real64[] values = test_expanded[] then dataset.standardize(values, overall, feature_count)]
    int[] train_targets = [for dataset.Example example = train[] then if example.label == settings.positive then 1 else 0]
    int[] test_targets = [for dataset.Example example = test[] then if example.label == settings.positive then 1 else 0]
    int[] train_labels = [for dataset.Example example = train[] then example.label]
    int[] test_labels = [for dataset.Example example = test[] then example.label]
    real64[] mean_values = overall.means[0:<len(names)]

    real64[] vector(real64[] values)
        return dataset.standardize(dataset.expanded_values(tuples, values), overall, feature_count)

    CrossValidation cross_validate(real64 lambda, int count)
        int size = int(len(train))
        real64[] losses = array(nat(size), fill = 0.0)
        real64[] probabilities = array(nat(size), fill = 0.0)
        real64[] fold_losses = []
        int errors = 0
        for int fold < 5
            int[] fitting = [for int index = (0:<size)[] if index % 5 != fold then index]
            int[] checking = [for int index = (0:<size)[] if index % 5 == fold then index]
            dataset.Statistics statistics = dataset.compute_statistics([for int index = fitting[] then train_expanded[index]], count)
            real64[][] vectors = [for int index = fitting[] then dataset.standardize(train_expanded[index], statistics, count)]
            int[] targets = [for int index = fitting[] then train_targets[index]]
            real64[] weights = last_weights(optimizers.newton_method(vectors, targets, lambda))
            real64 fold_total = 0.0
            for int index = checking[]
                real64 value = logistic.score(weights, dataset.standardize(train_expanded[index], statistics, count))
                losses[index] = logistic.loss(value, train_targets[index])
                probabilities[index] = logistic.probability(value)
                fold_total += losses[index]
                if (if probabilities[index] >= settings.threshold then 1 else 0) != train_targets[index]
                    errors += 1
            fold_losses = fold_losses.append(fold_total / real64(len(checking)))
        return CrossValidation(lambda, fold_losses, losses, probabilities, errors)

class Selection(local CrossValidation[] results)
    CrossValidation best = results[0]
    for CrossValidation result = results[]
        if result.loss <= best.loss
            best = result
    local real64 mean = total(best.fold_losses) / 5.0
    local real64 spread = total([for real64 value = best.fold_losses[] then (value - mean) * (value - mean)])
    real64 se = math.sqrt(spread / 4.0) / math.sqrt(5.0)
    real64 one_se = best.lambda
    for CrossValidation result = results[]
        if result.loss <= best.loss + se
            one_se = result.lambda

class Evaluation(local real64[] weights, local real64[][] vectors, local int[] targets, local real64 threshold)
    real64[] probabilities = model_probabilities(weights, vectors)
    int[] predictions = predict(probabilities, threshold)
    real64 loss = logistic.average_loss(weights, vectors, targets)
    int correct = count_equal(predictions, targets)
    metrics.Fraction area = metrics.auc(probabilities, targets)

class BinaryModel(string name, optimizers.Checkpoint[] checkpoints, local Data data)
    real64[] weights = last_weights(checkpoints)
    Evaluation train = Evaluation(weights, data.train_vectors, data.train_targets, data.settings.threshold)
    Evaluation test = Evaluation(weights, data.test_vectors, data.test_targets, data.settings.threshold)
    metrics.RocPoint[] roc = metrics.roc_points(test.probabilities, data.test_targets)

class SoftmaxModel(softmax.Checkpoint[] checkpoints, local Data data)
    real64[][] weights = checkpoints[len(checkpoints) - 1].weights
    real64[][] probabilities = [for real64[] vector = data.test_vectors[] then softmax.probabilities(weights, vector)]
    int[] predictions = [for real64[] values = probabilities[] then softmax.predicted_class(values)]

class Influence(local real64[] weights, local real64[][] vectors, local int[] targets, local real64 lambda)
    real64[][] matrix = inverse(logistic.hessian(weights, vectors, lambda))
    real64[] probabilities = []
    real64[] leverages = []
    real64[] residuals = []
    real64[] distances = []
    for int index < int(len(vectors))
        local real64[] vector = vectors[index]
        local real64 pi = logistic.probability(logistic.score(weights, vector))
        local real64 variance = pi * (1.0 - pi)
        local real64 quadratic = 0.0
        for int row < int(len(weights))
            for int column < int(len(weights))
                quadratic += vector[row] * matrix[row][column] * vector[column]
        local real64 leverage = variance * quadratic / real64(len(vectors))
        local real64 pearson = (real64(targets[index]) - pi) / math.sqrt(variance)
        probabilities = probabilities.append(pi)
        leverages = leverages.append(leverage)
        residuals = residuals.append(pearson / math.sqrt(1.0 - leverage))
        distances = distances.append(pearson * pearson * leverage / (real64(len(weights)) * ((1.0 - leverage) * (1.0 - leverage))))
    real64 edf = total(leverages)
    real64 deviance = 2.0 * real64(len(vectors)) * logistic.average_loss(weights, vectors, targets)
    real64 aic = deviance + 2.0 * edf
    real64 bic = deviance + math.log(real64(len(vectors))) * edf

real64[] original_units(real64[] weights, dataset.Statistics statistics)
    real64[] scaled = [for int index = (1:<int(len(weights)))[] then weights[index] / statistics.deviations[index - 1]]
    real64 shift = 0.0
    for int index < int(len(scaled))
        shift += scaled[index] * statistics.means[index]
    return [weights[0] - shift].concat(scaled)

class Bin()
    int count = 0
    real64 sum = 0.0
    int hits = 0

int bin_index(real64 value)
    return math.min(9, math.floor(value * 10.0))

Bin[] fill_bins(real64[] values, int[] hits)
    Bin[] bins = [for int empty_slot = (0:<10)[] then Bin()]
    for int index < int(len(values))
        int target = bin_index(values[index])
        bins[target].count += 1
        bins[target].sum += values[index]
        bins[target].hits += hits[index]
    return bins

string[] bin_lines(Bin[] bins, string mean_label, string rate_label)
    string[] lines = []
    for int index < 10
        Bin group = bins[index]
        real64 low = real64(index) / 10.0
        real64 high = real64(index + 1) / 10.0
        string mean = if group.count == 0 then "-" else metrics.fixed(group.sum / real64(group.count), 4)
        lines = lines.append("bin {low:frac=1}-{high:frac=1} count {group.count} {mean_label} {mean} {rate_label} " + metrics.ratio(group.hits, group.count))
    return lines

real64 calibration_error(Bin[] bins, int size)
    real64 result = 0.0
    for Bin group = bins[]
        if group.count > 0
            result += math.abs(group.sum - real64(group.hits))
    return result / real64(size)

int cost_of(metrics.RocPoint point, int positives, dataset.Settings settings)
    return settings.cost_fp * point.fp + settings.cost_fn * (positives - point.tp)

string[] term_lines(string[] names, real64[] weights, dataset.Statistics statistics)
    real64[] original = original_units(weights, statistics)
    string[] lines = ["term intercept standardized " + metrics.fixed(weights[0], 4) + " original " + metrics.fixed(original[0], 4)]
    for int index < int(len(names))
        lines = lines.append("term {names[index]} standardized " + metrics.fixed(weights[index + 1], 4) + " original " + metrics.fixed(original[index + 1], 4))
    return lines

class Study(Data data)
    CrossValidation[] validations = [for real64 candidate = data.settings.lambdas[] then data.cross_validate(candidate, data.feature_count)]
    Selection selection = Selection(validations)
    real64 lambda = selection.best.lambda
    BinaryModel[] models = [
        BinaryModel("gd", optimizers.gradient_descent(data.train_vectors, data.train_targets, lambda, data.settings.gd_rate, data.settings.gd_iterations), data),
        BinaryModel("sgd", optimizers.stochastic_gradient_descent(data.train_vectors, data.train_targets, lambda, data.settings.sgd_rate, data.settings.batch_size, data.settings.epochs, data.settings.sgd_seed), data),
        BinaryModel("newton", optimizers.newton_method(data.train_vectors, data.train_targets, lambda), data)
    ]
    SoftmaxModel soft_model = SoftmaxModel(softmax.train(data.train_vectors, data.train_labels, data.classes, data.settings.softmax_lambda, data.settings.softmax_rate, data.settings.softmax_iterations), data)
    Influence influence = Influence(models[2].weights, data.train_vectors, data.train_targets, lambda)

    string[] features_part()
        int count = data.feature_count
        int size = int(len(data.train))
        real64[][] correlation = array(nat(count), fill = array(nat(count), fill = 0.0))
        for int row < count
            for int column < count
                real64 value = 0.0
                for real64[] vector = data.train_vectors[]
                    value += vector[row + 1] * vector[column + 1]
                correlation[row][column] = value / real64(size - 1)
        real64[][] inflation = inverse(correlation)
        string[] lines = ["features {len(data.names)} degree {data.settings.degree} expanded {count}", "standardization"]
        for int index < count
            lines = lines.append(data.feature_names[index] + " mean " + metrics.fixed(data.overall.means[index], 6) + " sd " + metrics.fixed(data.overall.deviations[index], 6) + " vif " + metrics.fixed(inflation[index][index], 4))
        lines = lines.append("correlation")
        return lines.concat([for real64[] row = correlation[] then reals(row, 4)])

    string[][] weight_parts()
        string[][] parts = [features_part()]
        for BinaryModel model = models[]
            string[] lines = ["model {model.name} lambda " + metrics.fixed(lambda, 4)]
            lines = lines.concat(term_lines(data.feature_names, model.weights, data.overall))
            lines = lines.append("norm " + metrics.fixed(length(model.weights[1:]), 4))
            if model.name != "newton"
                real64[] differences = [for int index = (0:<int(len(model.weights)))[] then model.weights[index] - models[2].weights[index]]
                lines = lines.append("distance_to_newton " + metrics.fixed(length(differences), 6))
            parts = parts.append(lines)
        string[] coefficients = ["coefficients newton lambda " + metrics.fixed(lambda, 4)]
        string[] terms = ["intercept"].concat(data.feature_names)
        for int index < int(len(terms))
            real64 weight = models[2].weights[index]
            real64 standard_error = math.sqrt(influence.matrix[index][index] / real64(len(data.train)))
            coefficients = coefficients.append(terms[index] + " weight " + metrics.fixed(weight, 4) + " se " + metrics.fixed(standard_error, 4) + " z " + metrics.fixed(weight / standard_error, 4) + " lower " + metrics.fixed(weight - 1.96 * standard_error, 4) + " upper " + metrics.fixed(weight + 1.96 * standard_error, 4) + " odds_ratio " + metrics.fixed(math.exp(weight), 4))
        parts = parts.append(coefficients)
        string[] soft_lines = ["model softmax lambda " + metrics.fixed(data.settings.softmax_lambda, 4)]
        for int class_number < data.classes
            soft_lines = soft_lines.append("class {class_number}").concat(term_lines(data.feature_names, soft_model.weights[class_number], data.overall))
        return parts.append(soft_lines)

    string[] loss_trace()
        string[] lines = ["optimizer,iteration,loss,gradient_norm,test_loss"]
        for BinaryModel model = models[]
            for optimizers.Checkpoint checkpoint = model.checkpoints[]
                real64[] weights = checkpoint.weights
                real64 value = logistic.objective(weights, data.train_vectors, data.train_targets, lambda)
                real64 slope = length(logistic.gradient(weights, data.train_vectors, data.train_targets, lambda))
                real64 test_loss = logistic.average_loss(weights, data.test_vectors, data.test_targets)
                lines = lines.append("{model.name},{checkpoint.iteration}," + metrics.fixed(value, 6) + "," + metrics.fixed(slope, 6) + "," + metrics.fixed(test_loss, 6))
        for softmax.Checkpoint checkpoint = soft_model.checkpoints[]
            real64[][] weights = checkpoint.weights
            real64[][] gradient = softmax.gradient(weights, data.train_vectors, data.train_labels, data.settings.softmax_lambda)
            real64[] flat = []
            for real64[] row = gradient[]
                flat = flat.concat(row)
            real64 value = softmax.objective(weights, data.train_vectors, data.train_labels, data.settings.softmax_lambda)
            real64 test_loss = softmax.average_loss(weights, data.test_vectors, data.test_labels)
            lines = lines.append("softmax,{checkpoint.iteration}," + metrics.fixed(value, 6) + "," + metrics.fixed(length(flat), 6) + "," + metrics.fixed(test_loss, 6))
        return lines

    string[] predictions()
        string[] lines = ["id,model,probability,predicted,actual"]
        for BinaryModel model = models[]
            for int index < int(len(data.test))
                lines = lines.append(data.test[index].ident + ",{model.name}," + metrics.fixed(model.test.probabilities[index], 6) + ",{model.test.predictions[index]},{data.test_targets[index]}")
        for int index < int(len(data.test))
            int predicted = soft_model.predictions[index]
            lines = lines.append(data.test[index].ident + ",softmax," + metrics.fixed(soft_model.probabilities[index][predicted], 6) + ",{predicted},{data.test[index].label}")
        return lines

    string[] roc_lines()
        int positives = math.sum(data.test_targets)
        int negatives = int(len(data.test)) - positives
        string[] lines = ["model,threshold,tpr,fpr,precision"]
        for BinaryModel model = models[]
            lines = lines.append(model.name + ",inf,0.0000,0.0000,-")
            for metrics.RocPoint point = model.roc[]
                lines = lines.append(model.name + "," + metrics.fixed(point.threshold, 6) + "," + metrics.ratio(point.tp, positives) + "," + metrics.ratio(point.fp, negatives) + "," + metrics.ratio(point.tp, point.tp + point.fp))
        return lines

    string[] data_part()
        int[] train_counts = array(nat(data.classes), fill = 0)
        int[] test_counts = array(nat(data.classes), fill = 0)
        for int label = data.train_labels[]
            train_counts[label] += 1
        for int label = data.test_labels[]
            test_counts[label] += 1
        return ["data train {len(data.train)} test {len(data.test)} base_features {len(data.names)} degree {data.settings.degree} features {data.feature_count}", "binary positive_class {data.settings.positive} train {math.sum(data.train_targets)}/{len(data.train)} test {math.sum(data.test_targets)}/{len(data.test)}", "classes {data.classes} train " + integers(train_counts) + " test " + integers(test_counts)]

    string[] cross_validation_part()
        string[] lines = ["cross_validation folds 5 newton_iterations 10"]
        for CrossValidation result = validations[]
            lines = lines.append("lambda " + metrics.fixed(result.lambda, 4) + " fold_loss " + reals(result.fold_losses, 6) + " cv_loss " + metrics.fixed(result.loss, 6) + " errors {result.errors}/{len(data.train)}")
        lines = lines.append("selected lambda " + metrics.fixed(lambda, 4) + " cv_loss " + metrics.fixed(selection.best.loss, 6) + " se " + metrics.fixed(selection.se, 6) + " lambda_1se " + metrics.fixed(selection.one_se, 4))
        metrics.Confusion matrix = metrics.Confusion(predict(selection.best.probabilities, data.settings.threshold), data.train_targets)
        lines = lines.append("out_of_fold tp {matrix.tp} fp {matrix.fp} tn {matrix.tn} fn {matrix.fn} accuracy " + metrics.ratio(matrix.tp + matrix.tn, int(len(data.train))) + " auc " + metrics.auc(selection.best.probabilities, data.train_targets).text())
        return lines

    string[] lambda_path()
        string[] lines = ["lambda_path"]
        for real64 candidate = data.settings.lambdas[]
            real64[] weights = last_weights(optimizers.newton_method(data.train_vectors, data.train_targets, candidate))
            Evaluation train = Evaluation(weights, data.train_vectors, data.train_targets, data.settings.threshold)
            Evaluation test = Evaluation(weights, data.test_vectors, data.test_targets, data.settings.threshold)
            lines = lines.append("lambda " + metrics.fixed(candidate, 4) + " objective " + metrics.fixed(logistic.objective(weights, data.train_vectors, data.train_targets, candidate), 6) + " train_loss " + metrics.fixed(train.loss, 6) + " test_loss " + metrics.fixed(test.loss, 6) + " train_accuracy " + metrics.ratio(train.correct, int(len(data.train))) + " test_accuracy " + metrics.ratio(test.correct, int(len(data.test))) + " norm " + metrics.fixed(length(weights[1:]), 4))
        return lines

    string[] degree_part()
        string[] lines = ["degrees lambda " + metrics.fixed(lambda, 4)]
        for 1 <= int degree <= data.settings.degree
            int count = 0
            for int[] indices = data.tuples[]
                if int(len(indices)) <= degree
                    count += 1
            real64[][] train_vectors = [for real64[] vector = data.train_vectors[] then vector[0:<count + 1]]
            real64[][] test_vectors = [for real64[] vector = data.test_vectors[] then vector[0:<count + 1]]
            real64[] weights = last_weights(optimizers.newton_method(train_vectors, data.train_targets, lambda))
            CrossValidation validation = data.cross_validate(lambda, count)
            Evaluation train = Evaluation(weights, train_vectors, data.train_targets, data.settings.threshold)
            Evaluation test = Evaluation(weights, test_vectors, data.test_targets, data.settings.threshold)
            Influence measures = Influence(weights, train_vectors, data.train_targets, lambda)
            lines = lines.append("degree {degree} features {count} cv_loss " + metrics.fixed(validation.loss, 6) + " train_loss " + metrics.fixed(train.loss, 6) + " test_loss " + metrics.fixed(test.loss, 6) + " test_accuracy " + metrics.ratio(test.correct, int(len(data.test))) + " auc " + test.area.text() + " edf " + metrics.fixed(measures.edf, 4) + " aic " + metrics.fixed(measures.aic, 4) + " bic " + metrics.fixed(measures.bic, 4))
        return lines

    string[] learning_curve()
        string[] lines = ["learning_curve lambda " + metrics.fixed(lambda, 4)]
        for 1 <= int step <= 4
            int size = step * int(len(data.train)) / 4
            real64[][] rows = data.train_expanded[0:<size]
            dataset.Statistics statistics = dataset.compute_statistics(rows, data.feature_count)
            real64[][] train_vectors = [for real64[] values = rows[] then dataset.standardize(values, statistics, data.feature_count)]
            real64[][] test_vectors = [for real64[] values = data.test_expanded[] then dataset.standardize(values, statistics, data.feature_count)]
            int[] targets = data.train_targets[0:<size]
            real64[] weights = last_weights(optimizers.newton_method(train_vectors, targets, lambda))
            Evaluation train = Evaluation(weights, train_vectors, targets, data.settings.threshold)
            Evaluation test = Evaluation(weights, test_vectors, data.test_targets, data.settings.threshold)
            lines = lines.append("size {size} train_loss " + metrics.fixed(train.loss, 6) + " test_loss " + metrics.fixed(test.loss, 6) + " test_accuracy " + metrics.ratio(test.correct, int(len(data.test))) + " auc " + test.area.text())
        return lines

    string[] binary_part(BinaryModel model)
        int size = int(len(data.test))
        int positives = math.sum(data.test_targets)
        int negatives = size - positives
        metrics.Confusion matrix = metrics.Confusion(model.test.predictions, data.test_targets)
        real64 brier = total([for int index = (0:<size)[] then (model.test.probabilities[index] - real64(data.test_targets[index])) * (model.test.probabilities[index] - real64(data.test_targets[index]))]) / real64(size)
        metrics.RocPoint youden = model.roc[0]
        metrics.RocPoint best_f1 = model.roc[0]
        metrics.RocPoint cheapest = model.roc[0]
        real64 average_precision = 0.0
        int previous_tp = 0
        for metrics.RocPoint point = model.roc[]
            if point.tp * negatives - point.fp * positives > youden.tp * negatives - youden.fp * positives
                youden = point
            if point.tp * (positives + best_f1.tp + best_f1.fp) > best_f1.tp * (positives + point.tp + point.fp)
                best_f1 = point
            if cost_of(point, positives, data.settings) < cost_of(cheapest, positives, data.settings)
                cheapest = point
            average_precision += real64((point.tp - previous_tp) * point.tp) / real64(point.tp + point.fp)
            previous_tp = point.tp
        average_precision /= real64(positives)
        string[] lines = [
            "model {model.name} lambda " + metrics.fixed(lambda, 4),
            "train correct {model.train.correct}/{len(data.train)} accuracy " + metrics.ratio(model.train.correct, int(len(data.train))),
            "test tp {matrix.tp} fp {matrix.fp} tn {matrix.tn} fn {matrix.fn}",
            "test accuracy " + metrics.ratio(matrix.tp + matrix.tn, size) + " precision " + metrics.ratio(matrix.tp, matrix.tp + matrix.fp) + " recall " + metrics.ratio(matrix.tp, matrix.tp + matrix.fn) + " specificity " + metrics.ratio(matrix.tn, matrix.tn + matrix.fp) + " f1 " + metrics.ratio(2 * matrix.tp, 2 * matrix.tp + matrix.fp + matrix.fn),
            "log_loss " + metrics.fixed(model.test.loss, 6) + " brier " + metrics.fixed(brier, 6),
            "auc " + model.test.area.text() + " average_precision " + metrics.fixed(average_precision, 4),
            "youden threshold " + metrics.fixed(youden.threshold, 6) + " tpr " + metrics.ratio(youden.tp, positives) + " fpr " + metrics.ratio(youden.fp, negatives) + " j " + metrics.ratio(youden.tp * negatives - youden.fp * positives, positives * negatives),
            "best_f1 threshold " + metrics.fixed(best_f1.threshold, 6) + " precision " + metrics.ratio(best_f1.tp, best_f1.tp + best_f1.fp) + " recall " + metrics.ratio(best_f1.tp, positives) + " f1 " + metrics.ratio(2 * best_f1.tp, positives + best_f1.tp + best_f1.fp),
            "min_cost threshold " + metrics.fixed(cheapest.threshold, 6) + " cost {cost_of(cheapest, positives, data.settings)} fp {cheapest.fp} fn {positives - cheapest.tp}",
            "calibration"
        ]
        Bin[] bins = fill_bins(model.test.probabilities, data.test_targets)
        lines = lines.concat(bin_lines(bins, "mean_probability", "positive_rate"))
        real64 mce = 0.0
        real64 statistic = 0.0
        int groups = 0
        for Bin group = bins[]
            if group.count == 0
                continue
            groups += 1
            mce = math.max(mce, math.abs(group.sum / real64(group.count) - real64(group.hits) / real64(group.count)))
            statistic += (real64(group.hits) - group.sum) * (real64(group.hits) - group.sum) / (group.sum * (1.0 - group.sum / real64(group.count)))
        lines = lines.append("ece " + metrics.fixed(calibration_error(bins, size), 4) + " mce " + metrics.fixed(mce, 4) + " hosmer_lemeshow " + metrics.fixed(statistic, 4) + " groups {groups}")
        lines = lines.append("gains")
        int[] order = metrics.ordering(model.test.probabilities, true)
        for 1 <= int decile <= 10
            int rows = decile * size / 10
            int hits = math.sum([for int index = order[0:<rows][] then data.test_targets[index]])
            lines = lines.append("decile {decile} rows {rows} positives {hits} gain " + metrics.ratio(hits, positives) + " lift " + metrics.ratio(hits * size, rows * positives))
        return lines

    string[] comparison_part()
        string[] lines = []
        for int[] pair = [[0, 1], [0, 2], [1, 2]][]
            BinaryModel first = models[pair[0]]
            BinaryModel second = models[pair[1]]
            int same = count_equal(first.test.predictions, second.test.predictions)
            int only_first = 0
            int only_second = 0
            for int index < int(len(data.test))
                int target = data.test_targets[index]
                if first.test.predictions[index] == target and second.test.predictions[index] != target
                    only_first += 1
                elif second.test.predictions[index] == target and first.test.predictions[index] != target
                    only_second += 1
            int gap = math.abs(only_first - only_second) - 1
            lines = lines.append("agreement {first.name} {second.name} same {same}/{len(data.test)} only_first {only_first} only_second {only_second} mcnemar " + metrics.ratio(gap * gap, only_first + only_second))
        return lines

    real64 slope(real64[] original, real64[] values, int base)
        real64 sum = 0.0
        for int index < int(len(data.tuples))
            int[] indices = data.tuples[index]
            int occurrences = 0
            bool removed = false
            real64 product = 1.0
            for int component = indices[]
                if component == base
                    occurrences += 1
                if component == base and not removed
                    removed = true
                else
                    product *= values[component]
            if occurrences > 0
                sum += original[index + 1] * (real64(occurrences) * product)
        return sum

    string bootstrap_line()
        int size = int(len(data.test))
        int count = data.settings.bootstrap_count
        optimizers.Minstd generator = optimizers.Minstd(data.settings.bootstrap_seed)
        metrics.Fraction[] samples = []
        real64[] values = []
        for _ < count
            int[] picks = []
            for int position < size
                picks = picks.append(.generator.draw() % size)
            metrics.Fraction area = metrics.auc([for int index = picks[] then models[2].test.probabilities[index]], [for int index = picks[] then data.test_targets[index]])
            samples = samples.append(area)
            values = values.append(real64(area.numerator) / real64(area.denominator))
        real64 mean = total(values) / real64(count)
        real64 deviation = math.sqrt(total([for real64 value = values[] then (value - mean) * (value - mean)]) / real64(count - 1))
        int[] order = metrics.ordering(values)
        int tail = count / 40
        metrics.Fraction lower = samples[order[tail]]
        metrics.Fraction upper = samples[order[count - tail - 1]]
        return "bootstrap resamples {count} seed {data.settings.bootstrap_seed} auc_mean " + metrics.fixed(mean, 4) + " auc_sd " + metrics.fixed(deviation, 4) + " lower " + lower.text() + " upper " + upper.text()

    string[] diagnostics_part()
        BinaryModel model = models[2]
        int size = int(len(data.train))
        real64 base_rate = real64(math.sum(data.train_targets)) / real64(size)
        real64 null_loss = -(base_rate * math.log(base_rate) + (1.0 - base_rate) * math.log(1.0 - base_rate))
        string[] lines = ["diagnostics newton lambda " + metrics.fixed(lambda, 4), "fit null_loss " + metrics.fixed(null_loss, 6) + " train_loss " + metrics.fixed(model.train.loss, 6) + " mcfadden_r2 " + metrics.fixed(1.0 - model.train.loss / null_loss, 4) + " deviance " + metrics.fixed(influence.deviance, 4) + " edf " + metrics.fixed(influence.edf, 4) + " aic " + metrics.fixed(influence.aic, 4) + " bic " + metrics.fixed(influence.bic, 4)]
        int[] order = metrics.ordering(influence.probabilities)
        real64 statistic = 0.0
        string[] groups = []
        for 1 <= int group <= 10
            int[] members = order[(group - 1) * size / 10:<group * size / 10]
            int observed = math.sum([for int index = members[] then data.train_targets[index]])
            real64 expected = total([for int index = members[] then influence.probabilities[index]])
            statistic += (real64(observed) - expected) * (real64(observed) - expected) / (expected * (1.0 - expected / real64(len(members))))
            groups = groups.append("group {group} rows {len(members)} observed {observed} expected " + metrics.fixed(expected, 4))
        lines = lines.append("hosmer_lemeshow_train groups 10 statistic " + metrics.fixed(statistic, 4)).concat(groups).append("newton_iterations")
        for 1 <= int iteration <= 10
            real64[] weights = model.checkpoints[iteration - 1].weights
            optimizers.Direction direction = optimizers.newton_direction(weights, data.train_vectors, data.train_targets, lambda)
            real64 decrease = total([for int index = (0:<int(len(weights)))[] then direction.gradient[index] * direction.step[index]]) / 2.0
            lines = lines.append("iteration {iteration} objective " + metrics.fixed(logistic.objective(weights, data.train_vectors, data.train_targets, lambda), 6) + " gradient_norm " + metrics.fixed(length(direction.gradient), 6) + " step_norm " + metrics.fixed(length(direction.step), 6) + " predicted_decrease " + metrics.fixed(decrease, 6))
        real64[] original = original_units(model.weights, data.overall)
        real64 centre = logistic.probability(logistic.score(model.weights, data.vector(data.mean_values)))
        for int base < int(len(data.names))
            real64 sum = 0.0
            for int index < size
                real64 pi = influence.probabilities[index]
                sum += pi * (1.0 - pi) * slope(original, data.train[index].values, base)
            real64 at_mean = centre * (1.0 - centre) * slope(original, data.mean_values, base)
            lines = lines.append("marginal {data.names[base]} average " + metrics.fixed(sum / real64(size), 4) + " at_mean " + metrics.fixed(at_mean, 4))
        for 1 <= int cut <= 9
            metrics.Confusion matrix = metrics.Confusion(predict(model.test.probabilities, real64(cut) / 10.0), data.test_targets)
            lines = lines.append("cut 0.{cut} positive {matrix.tp + matrix.fp} tp {matrix.tp} fp {matrix.fp} precision " + metrics.ratio(matrix.tp, matrix.tp + matrix.fp) + " recall " + metrics.ratio(matrix.tp, matrix.tp + matrix.fn) + " accuracy " + metrics.ratio(matrix.tp + matrix.tn, int(len(data.test))))
        real64[] distances = [for real64 value = model.test.probabilities[] then math.abs(value - data.settings.threshold)]
        int listed = 0
        for int index = metrics.ordering(distances, true)[]
            if model.test.predictions[index] == data.test_targets[index]
                continue
            lines = lines.append("error {data.test[index].ident} actual {data.test_targets[index]} probability " + metrics.fixed(model.test.probabilities[index], 6))
            listed += 1
            if listed == 5
                break
        lines = lines.append(bootstrap_line())
        int large = 0
        for real64 value = influence.residuals[]
            if math.abs(value) > 2.0
                large += 1
        lines = lines.append("influence effective_parameters " + metrics.fixed(influence.edf, 4) + " large_residuals {large}")
        int[] cook_order = metrics.ordering(influence.distances, true)
        for int index = cook_order[0:<math.min(5, size)][]
            lines = lines.append("cook {data.train[index].ident} actual {data.train_targets[index]} probability " + metrics.fixed(influence.probabilities[index], 4) + " leverage " + metrics.fixed(influence.leverages[index], 4) + " residual " + metrics.fixed(influence.residuals[index], 4) + " distance " + metrics.fixed(influence.distances[index], 4))
        return lines

    int softmax_correct(real64[][] vectors)
        int[] predicted_values = [for real64[] vector = vectors[] then softmax.predicted_class(softmax.probabilities(soft_model.weights, vector))]
        return count_equal(predicted_values, data.test_labels)

    string[] importance_part()
        int size = int(len(data.test))
        int repeats = data.settings.permutation_count
        BinaryModel model = models[2]
        int base_correct = count_equal(soft_model.predictions, data.test_labels)
        string[] lines = ["importance repeats {repeats} seed {data.settings.permutation_seed}", "baseline log_loss " + metrics.fixed(model.test.loss, 6) + " auc " + model.test.area.text() + " softmax_accuracy " + metrics.ratio(base_correct, size)]
        optimizers.Minstd generator = optimizers.Minstd(data.settings.permutation_seed)
        for int base < int(len(data.names))
            real64[] losses = []
            int auc_total = 0
            int correct_total = 0
            for _ < repeats
                int[] order = 0:<size
                optimizers.shuffle(&order, &generator)
                real64[][] vectors = []
                for int index < size
                    real64[] values = data.test[index].values
                    values[base] = data.test[order[index]].values[base]
                    vectors = vectors.append(data.vector(values))
                losses = losses.append(logistic.average_loss(model.weights, vectors, data.test_targets))
                metrics.Fraction area = metrics.auc(model_probabilities(model.weights, vectors), data.test_targets)
                auc_total += area.numerator
                correct_total += softmax_correct(vectors)
            lines = lines.append("feature {data.names[base]} log_loss_increase " + metrics.fixed(total(losses) / real64(repeats) - model.test.loss, 6) + " auc " + metrics.fraction(auc_total, repeats * model.test.area.denominator) + " softmax_accuracy " + metrics.ratio(correct_total, repeats * size))
        return lines

    real64[][] extrema()
        real64[] low = data.train[0].values
        real64[] high = low
        for dataset.Example example = data.train[]
            for int base < int(len(data.names))
                low[base] = math.min(low[base], example.values[base])
                high[base] = math.max(high[base], example.values[base])
        return [low, high]

    string[] profile_part()
        string[] lines = ["profiles"]
        real64[][] limits = extrema()
        for int base < int(len(data.names))
            for 0 <= int step <= 4
                real64[] values = data.mean_values
                values[base] = limits[0][base] + (limits[1][base] - limits[0][base]) * real64(step) / 4.0
                real64[] vector = data.vector(values)
                real64 newton_probability = logistic.probability(logistic.score(models[2].weights, vector))
                lines = lines.append("profile {data.names[base]} value " + metrics.fixed(values[base], 4) + " newton " + metrics.fixed(newton_probability, 4) + " softmax " + reals(softmax.probabilities(soft_model.weights, vector), 4))
        return lines

    string[] softmax_part()
        int size = int(len(data.test))
        int classes = data.classes
        int[][] table = array(nat(classes), fill = array(nat(classes), fill = 0))
        int[] row_totals = array(nat(classes), fill = 0)
        int[] column_totals = array(nat(classes), fill = 0)
        for int index < size
            int label = data.test_labels[index]
            int predicted = soft_model.predictions[index]
            table[label][predicted] += 1
            row_totals[label] += 1
            column_totals[predicted] += 1
        string[] lines = ["softmax classes {classes} lambda " + metrics.fixed(data.settings.softmax_lambda, 4) + " iterations {data.settings.softmax_iterations}", "confusion"]
        lines = lines.concat([for int[] row = table[] then integers(row)])
        int diagonal = 0
        int chance = 0
        for int class_number < classes
            real64[] scores = [for real64[] values = soft_model.probabilities[] then values[class_number]]
            int[] targets = [for int label = data.test_labels[] then if label == class_number then 1 else 0]
            int hits = table[class_number][class_number]
            lines = lines.append("class {class_number} precision " + metrics.ratio(hits, column_totals[class_number]) + " recall " + metrics.ratio(hits, row_totals[class_number]) + " f1 " + metrics.ratio(2 * hits, column_totals[class_number] + row_totals[class_number]) + " auc " + metrics.auc(scores, targets).text())
            diagonal += hits
            chance += row_totals[class_number] * column_totals[class_number]
        lines = lines.append("accuracy " + metrics.ratio(diagonal, size) + " kappa " + metrics.ratio(size * diagonal - chance, size * size - chance))
        real64[] squares = []
        real64[] confidences = []
        int[] hits = []
        for int index < size
            real64 sum = 0.0
            for int class_number < classes
                real64 residual = soft_model.probabilities[index][class_number] - (if data.test_labels[index] == class_number then 1.0 else 0.0)
                sum += residual * residual
            squares = squares.append(sum)
            confidences = confidences.append(soft_model.probabilities[index][soft_model.predictions[index]])
            hits = hits.append(if soft_model.predictions[index] == data.test_labels[index] then 1 else 0)
        lines = lines.append("log_loss " + metrics.fixed(softmax.average_loss(soft_model.weights, data.test_vectors, data.test_labels), 6) + " brier " + metrics.fixed(total(squares) / real64(size), 6))
        real64[] binary_scores = [for real64[] values = soft_model.probabilities[] then values[data.settings.positive]]
        int[] predicted_values = predict(binary_scores, data.settings.threshold)
        real64 binary_loss = 0.0
        for int index < size
            binary_loss += -math.log(if data.test_targets[index] == 1 then binary_scores[index] else 1.0 - binary_scores[index])
        binary_loss /= real64(size)
        lines = lines.append("binary_view positive_class {data.settings.positive} auc " + metrics.auc(binary_scores, data.test_targets).text() + " log_loss " + metrics.fixed(binary_loss, 6) + " accuracy " + metrics.ratio(count_equal(predicted_values, data.test_targets), size) + " agreement_with_newton {count_equal(predicted_values, models[2].test.predictions)}/{size}")
        Bin[] bins = fill_bins(confidences, hits)
        return lines.append("confidence").concat(bin_lines(bins, "mean_confidence", "accuracy")).append("ece " + metrics.fixed(calibration_error(bins, size), 4))

    string[] one_vs_rest()
        real64 coefficient = data.settings.softmax_lambda
        int size = int(len(data.test))
        string[] lines = ["one_vs_rest lambda " + metrics.fixed(coefficient, 4) + " newton_iterations 10"]
        real64[][] class_probabilities = []
        for int class_number < data.classes
            int[] targets = [for int label = data.train_labels[] then if label == class_number then 1 else 0]
            int[] test_targets = [for int label = data.test_labels[] then if label == class_number then 1 else 0]
            real64[] weights = last_weights(optimizers.newton_method(data.train_vectors, targets, coefficient))
            Evaluation test = Evaluation(weights, data.test_vectors, test_targets, data.settings.threshold)
            real64 value = logistic.objective(weights, data.train_vectors, targets, coefficient)
            lines = lines.append("class {class_number} objective " + metrics.fixed(value, 6) + " auc " + test.area.text())
            class_probabilities = class_probabilities.append(test.probabilities)
        int[] predicted_values = []
        for int index < size
            real64[] column = [for real64[] probabilities = class_probabilities[] then probabilities[index]]
            predicted_values = predicted_values.append(softmax.predicted_class(column))
        return lines.append("accuracy " + metrics.ratio(count_equal(predicted_values, data.test_labels), size) + " agreement_with_softmax {count_equal(predicted_values, soft_model.predictions)}/{size}")

    string[] map_part()
        real64[][] limits = extrema()
        int width = data.settings.map_width
        int height = data.settings.map_height
        int[] cells = array(nat(data.classes), fill = 0)
        string[] class_rows = []
        string[] probability_rows = []
        for int row < height
            string class_row = ""
            string probability_row = ""
            for int column < width
                real64[] values = data.mean_values
                values[0] = limits[0][0] + (real64(column) + 0.5) * (limits[1][0] - limits[0][0]) / real64(width)
                values[1] = limits[1][1] - (real64(row) + 0.5) * (limits[1][1] - limits[0][1]) / real64(height)
                real64[] vector = data.vector(values)
                int predicted = softmax.predicted_class(softmax.probabilities(soft_model.weights, vector))
                cells[predicted] += 1
                class_row += "{predicted}"
                probability_row += "{bin_index(logistic.probability(logistic.score(models[2].weights, vector)))}"
            class_rows = class_rows.append(class_row)
            probability_rows = probability_rows.append(probability_row)
        return ["map {data.names[0]} {data.names[1]} width {width} height {height}", "softmax_classes"].concat(class_rows).concat(["cells " + integers(cells), "newton_probability"]).concat(probability_rows)

    string[][] evaluation_parts()
        string[][] parts = [data_part(), cross_validation_part(), lambda_path(), degree_part(), learning_curve()]
        for BinaryModel model = models[]
            parts = parts.append(binary_part(model))
        return parts.concat([comparison_part(), diagnostics_part(), importance_part(), profile_part(), softmax_part(), one_vs_rest(), map_part()])

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)

void write_parts(string name, string[][] parts)
    string[] lines = []
    for string[] part = parts[]
        if len(lines) > 0
            lines = lines.append("")
        lines = lines.concat(part)
    write_lines(name, lines)

dataset.Examples train = dataset.read_examples("input/train.csv")
dataset.Examples test = dataset.read_examples("input/test.csv")
Data data = Data(train.names, train.rows, test.rows, dataset.read_settings("input/params.txt"))
Study study = Study(data)
if not file.is_directory("output")
    file.mkdir("output")
write_parts("weights.txt", study.weight_parts())
write_lines("loss_trace.csv", study.loss_trace())
write_lines("predictions.csv", study.predictions())
write_parts("evaluation.txt", study.evaluation_parts())
write_lines("roc.csv", study.roc_lines())
