import math

string fixed(real64 value, int places)
    string text = if places == 4 then "{value:frac=4}" else "{value:frac=6}"
    real64 parsed = real64.parse(text)
    if text.starts_with("-") and parsed == 0.0
        return text[1:]
    return text

string ratio(int numerator, int denominator)
    if denominator == 0
        return "-"
    int rounded = (20000 * numerator + denominator) / (2 * denominator)
    int whole = rounded / 10000
    int part = rounded % 10000
    return "{whole}.{part:int=4,zero}"

string fraction(int numerator, int denominator)
    int first = numerator
    int second = denominator
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return "{numerator / first}/{denominator / first} " + ratio(numerator, denominator)

class Confusion(local int[] predictions, local int[] targets)
    int tp = 0
    int fp = 0
    int tn = 0
    int fn = 0
    for int index < int(len(predictions))
        if predictions[index] == 1 and targets[index] == 1
            tp += 1
        elif predictions[index] == 1
            fp += 1
        elif targets[index] == 0
            tn += 1
        else
            fn += 1

class Fraction(int numerator, int denominator)
    string text()
        return fraction(numerator, denominator)

int[] ordering(real64[] scores, bool descending = false)
    int[] result = []
    for int index < int(len(scores))
        int position = int(len(result))
        result = result.append(index)
        while position > 0
            int previous = result[position - 1]
            bool before = if descending then scores[index] > scores[previous] else scores[index] < scores[previous]
            if not before
                break
            result[position] = previous
            position -= 1
        result[position] = index
    return result

Fraction auc(real64[] scores, int[] targets)
    int[] order = ordering(scores)
    int positives = math.sum(targets)
    int rank_sum = 0
    int start = 0
    while start < int(len(order))
        int end = start
        while end + 1 < int(len(order)) and scores[order[end + 1]] == scores[order[start]]
            end += 1
        for start <= int position <= end
            if targets[order[position]] == 1
                rank_sum += start + end + 2
        start = end + 1
    return Fraction(rank_sum - positives * (positives + 1), 2 * positives * (int(len(targets)) - positives))

class RocPoint(real64 threshold, int tp, int fp)

RocPoint[] roc_points(real64[] probabilities, int[] targets)
    int[] order = ordering(probabilities, true)
    RocPoint[] points = []
    int tp = 0
    int fp = 0
    for int position < int(len(order))
        int index = order[position]
        if targets[index] == 1
            tp += 1
        else
            fp += 1
        if position + 1 == int(len(order)) or probabilities[order[position + 1]] != probabilities[index]
            points = points.append(RocPoint(probabilities[index], tp, fp))
    return points
