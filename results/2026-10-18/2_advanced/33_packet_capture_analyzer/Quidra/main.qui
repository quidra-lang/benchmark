import dump = "./hexdump.qui"
import network = "./link_network.qui"
import transport = "./transport.qui"
import dns = "./dns_app.qui"
import flow = "./flows.qui"

class Field(string name, string kind)
class Schema()
    Field[] fields = [
        Field("frame.number", "integer"),
        Field("frame.time", "integer"),
        Field("frame.len", "integer"),
        Field("frame.protocols", "string"),
        Field("frame.malformed", "string"),
        Field("frame.bad_checksum", "presence"),
        Field("eth.dst", "mac"),
        Field("eth.src", "mac"),
        Field("eth.type", "hex4"),
        Field("arp.opcode", "integer"),
        Field("arp.src.hw", "mac"),
        Field("arp.src.ip", "ipv4"),
        Field("arp.dst.hw", "mac"),
        Field("arp.dst.ip", "ipv4"),
        Field("ip.hdr_len", "integer"),
        Field("ip.tos", "hex2"),
        Field("ip.len", "integer"),
        Field("ip.id", "hex4"),
        Field("ip.flags.df", "integer"),
        Field("ip.flags.mf", "integer"),
        Field("ip.frag_offset", "integer"),
        Field("ip.ttl", "integer"),
        Field("ip.proto", "integer"),
        Field("ip.checksum", "hex4"),
        Field("ip.checksum.status", "string"),
        Field("ip.src", "ipv4"),
        Field("ip.dst", "ipv4"),
        Field("ip.fragment", "presence"),
        Field("icmp.type", "integer"),
        Field("icmp.code", "integer"),
        Field("icmp.checksum", "hex4"),
        Field("icmp.checksum.status", "string"),
        Field("icmp.id", "integer"),
        Field("icmp.seq", "integer"),
        Field("udp.srcport", "integer"),
        Field("udp.dstport", "integer"),
        Field("udp.length", "integer"),
        Field("udp.checksum", "hex4"),
        Field("udp.checksum.status", "string"),
        Field("tcp.srcport", "integer"),
        Field("tcp.dstport", "integer"),
        Field("tcp.stream", "integer"),
        Field("tcp.seq", "integer"),
        Field("tcp.seq_raw", "integer"),
        Field("tcp.ack", "integer"),
        Field("tcp.ack_raw", "integer"),
        Field("tcp.hdr_len", "integer"),
        Field("tcp.flags", "hex2"),
        Field("tcp.flags.fin", "integer"),
        Field("tcp.flags.syn", "integer"),
        Field("tcp.flags.rst", "integer"),
        Field("tcp.flags.psh", "integer"),
        Field("tcp.flags.ack", "integer"),
        Field("tcp.flags.urg", "integer"),
        Field("tcp.window", "integer"),
        Field("tcp.window.calc", "integer"),
        Field("tcp.checksum", "hex4"),
        Field("tcp.checksum.status", "string"),
        Field("tcp.urgent", "integer"),
        Field("tcp.option", "string"),
        Field("tcp.options.mss", "integer"),
        Field("tcp.options.wscale", "integer"),
        Field("tcp.options.malformed", "presence"),
        Field("tcp.len", "integer"),
        Field("tcp.analysis.retransmission", "presence"),
        Field("tcp.analysis.out_of_order", "presence"),
        Field("tcp.analysis.lost_segment", "presence"),
        Field("tcp.analysis.duplicate_ack", "presence"),
        Field("dns.id", "hex4"),
        Field("dns.flags", "hex4"),
        Field("dns.flags.response", "integer"),
        Field("dns.flags.opcode", "integer"),
        Field("dns.flags.rcode", "integer"),
        Field("dns.count.queries", "integer"),
        Field("dns.count.answers", "integer"),
        Field("dns.count.auth_rr", "integer"),
        Field("dns.count.add_rr", "integer"),
        Field("dns.qry.name", "string"),
        Field("dns.qry.type", "integer"),
        Field("dns.answer", "string"),
        Field("dns.authority", "string"),
        Field("dns.additional", "string"),
        Field("dns.a", "ipv4"),
        Field("data.len", "integer"),
    ]

    string field_type(string name)
        for Field field = fields[]
            if field.name == name
                return field.kind
        if name == "eth.addr"
            return "mac"
        if name == "ip.addr"
            return "ipv4"
        if name == "tcp.port" or name == "udp.port"
            return "integer"
        return if protocol_field(name) then "presence" else ""

bool contains(string[] values, string target)
    for string value = values[]
        if value == target
            return true
    return false

bool protocol_field(string name)
    return contains(["eth", "arp", "ip", "icmp", "udp", "tcp", "dns", "data"], name)

string seconds(int value)
    return "{value / 1000000}.{value % 1000000:int=6,zero}"

string optional(int value)
    return if value < 0 then "-" else "{value}"

string notation(string kind, dump.Atom value)
    if value.textual
        return value.text
    if kind == "hex2" or kind == "hex4"
        return "0x" + dump.hexadecimal(value.number, if kind == "hex2" then 2 else 4)
    if kind == "ipv4"
        return network.ipv4(value.number)
    if kind == "mac"
        return network.mac(value.number)
    return "{value.number}"

string shown(dump.Packet packet, Schema schema, string name)
    return notation(schema.field_type(name), packet.fields.values(name)[0])

dump.Atom[] field_values(dump.Packet packet, string name)
    if name == "eth.addr"
        return packet.fields.values("eth.dst").concat(packet.fields.values("eth.src"))
    if name == "ip.addr"
        return packet.fields.values("ip.src").concat(packet.fields.values("ip.dst"))
    if name == "tcp.port"
        return packet.fields.values("tcp.srcport").concat(packet.fields.values("tcp.dstport"))
    if name == "udp.port"
        return packet.fields.values("udp.srcport").concat(packet.fields.values("udp.dstport"))
    return packet.fields.values(name)

network.Layer | error dissect_layer(dump.Packet packet, string name, int[] bytes)
    if name == "eth"
        return network.ethernet(bytes)
    if name == "arp"
        return network.arp(bytes)
    if name == "ip"
        return network.ipv4_layer(bytes)
    if name == "icmp"
        return transport.icmp(bytes)
    if name == "udp"
        return transport.udp(bytes, packet.fields.number("ip.src"), packet.fields.number("ip.dst"))
    if name == "tcp"
        return transport.tcp(bytes, packet.fields.number("ip.src"), packet.fields.number("ip.dst"))
    return dns.dissect(bytes)

void dissect(dump.Packet &packet, int base_time)
    string reason = packet.dump_error
    if reason == ""
        string name = "eth"
        int[] payload = packet.data
        while true
            packet.layers = packet.layers.append(name)
            network.Layer | error result = dissect_layer(packet, name, payload)
            match result
                error problem
                    reason = problem.message
                    break
                network.Layer layer
                    .packet.fields.merge(layer.fields)
                    if name == "dns"
                        packet.answers = layer.answers
                    if layer.next_layer == ""
                        packet.remaining = layer.remaining
                        break
                    name = layer.next_layer
                    payload = layer.payload
    if reason == "" and len(packet.remaining) > 0
        packet.layers = packet.layers.append("data")
        .packet.fields.put_number("data.len", int(len(packet.remaining)))
    .packet.fields.put_number("frame.number", packet.number)
    .packet.fields.put_number("frame.time", packet.time - base_time)
    .packet.fields.put_number("frame.len", packet.length)
    if len(packet.layers) > 0
        .packet.fields.put_text("frame.protocols", packet.layers.join(":"))
    if reason != ""
        .packet.fields.put_text("frame.malformed", reason)
        packet.remaining = []
    for string name = ["ip", "icmp", "udp", "tcp"][]
        if packet.fields.text(name + ".checksum.status") == "bad"
            .packet.fields.put_presence("frame.bad_checksum")

string mark_text(dump.Packet packet, flow.Tracker tracker)
    if packet.fields.exists("tcp.analysis.duplicate_ack")
        match tracker.duplicates.get(packet.number)
            flow.DuplicateAck duplicate
                return "[TCP Dup ACK {duplicate.number}#{duplicate.count}] "
            none
                return ""
    string[] marks = ["retransmission", "out_of_order", "lost_segment"]
    string[] texts = ["[TCP Retransmission] ", "[TCP Out-Of-Order] ", "[TCP Previous segment not captured] "]
    for int index < 3
        if packet.fields.exists("tcp.analysis." + marks[index])
            return texts[index]
    return ""

string tcp_info(dump.Packet packet, flow.Tracker tracker)
    string[] flag_names = ["FIN", "SYN", "RST", "PSH", "ACK", "URG", "ECE", "CWR"]
    string[] flags = []
    int bit = 1
    for string name = flag_names[]
        if packet.fields.number("tcp.flags") / bit % 2 == 1
            flags = flags.append(name)
        bit *= 2
    string flag_text = if len(flags) == 0 then "<None>" else flags.join(", ")
    string text = mark_text(packet, tracker) + "{packet.fields.number("tcp.srcport")} -> {packet.fields.number("tcp.dstport")} [{flag_text}] Seq={packet.fields.number("tcp.seq")}"
    if packet.fields.number("tcp.flags.ack") == 1
        text += " Ack={packet.fields.number("tcp.ack")}"
    text += " Win={packet.fields.number("tcp.window.calc")} Len={packet.fields.number("tcp.len")}"
    for dump.Atom value = packet.fields.values("tcp.option")[]
        string[] words = value.text.split(" ")
        if words[0] == "MSS"
            text += " MSS={words[1]}"
        elif words[0] == "WS"
            text += " WS={flow.power2(int.parse(words[1]))}"
        elif words[0] == "SACK_PERM"
            text += " SACK_PERM"
        elif words[0] == "TS"
            text += " TSval={words[1]} TSecr={words[2]}"
    return text

string basic_info(dump.Packet packet, Schema schema, string protocol, flow.Tracker tracker)
    if packet.fields.exists("frame.malformed")
        return packet.fields.text("frame.malformed")
    if protocol == "ETH"
        return "EtherType " + shown(packet, schema, "eth.type")
    if protocol == "ARP"
        int opcode = packet.fields.number("arp.opcode")
        if opcode == 1
            return "Who has " + shown(packet, schema, "arp.dst.ip") + "? Tell " + shown(packet, schema, "arp.src.ip")
        if opcode == 2
            return shown(packet, schema, "arp.src.ip") + " is at " + shown(packet, schema, "arp.src.hw")
        return "Opcode {opcode}"
    if protocol == "IPv4"
        if not packet.fields.exists("ip.fragment")
            return "Protocol {packet.fields.number("ip.proto")}"
        string text = "Fragment id=" + shown(packet, schema, "ip.id") + " off={packet.fields.number("ip.frag_offset")}"
        return text + (if packet.fields.number("ip.flags.mf") == 1 then " MF" else "")
    if protocol == "ICMP"
        int kind = packet.fields.number("icmp.type")
        if kind == 0 or kind == 8
            return (if kind == 8 then "Echo request" else "Echo reply") + " id={packet.fields.number("icmp.id")} seq={packet.fields.number("icmp.seq")}"
        return "Type {kind} code {packet.fields.number("icmp.code")}"
    if protocol == "UDP"
        return "{packet.fields.number("udp.srcport")} -> {packet.fields.number("udp.dstport")} Len={packet.fields.number("udp.length") - 8}"
    if protocol == "TCP"
        return tcp_info(packet, tracker)
    string[] parts = [if packet.fields.number("dns.flags.response") == 1 then "Response" else "Query", shown(packet, schema, "dns.id")]
    int rcode = packet.fields.number("dns.flags.rcode")
    if rcode != 0
        parts = parts.append(dns.rcode_name(rcode))
    dump.Atom[] names = packet.fields.values("dns.qry.name")
    dump.Atom[] kinds = packet.fields.values("dns.qry.type")
    for int index < int(len(names))
        parts = parts.concat([dns.type_name(kinds[index].number), names[index].text])
    return parts.concat(packet.answers).join(" ")

string summary(dump.Packet packet, Schema schema, flow.Tracker tracker)
    string source = "-"
    string destination = "-"
    if packet.fields.exists("ip.src")
        source = shown(packet, schema, "ip.src")
        destination = shown(packet, schema, "ip.dst")
    elif packet.fields.exists("eth.src")
        source = shown(packet, schema, "eth.src")
        destination = shown(packet, schema, "eth.dst")
    string protocol = "DUMP"
    string[] names = ["eth", "arp", "ip", "icmp", "udp", "tcp", "dns"]
    string[] labels = ["ETH", "ARP", "IPv4", "ICMP", "UDP", "TCP", "DNS"]
    for string layer = packet.layers[]
        for int index < 7
            if names[index] == layer
                protocol = labels[index]
    string info = basic_info(packet, schema, protocol, tracker)
    if packet.fields.exists("tcp.options.malformed")
        info += " [bad TCP options]"
    string[] checksum_names = ["ip", "icmp", "udp", "tcp"]
    string[] checksum_labels = ["IPv4", "ICMP", "UDP", "TCP"]
    for int index < 4
        if packet.fields.text(checksum_names[index] + ".checksum.status") == "bad"
            info += " [bad {checksum_labels[index]} checksum]"
    return "{packet.number} " + seconds(packet.fields.number("frame.time")) + " {source} -> {destination} {protocol} {packet.length} {info}"

class Token(string kind, string text, int column)
class FilterNode(string kind, int left = -1, int right = -1, string field = "", string operation = "", dump.Atom value = dump.Atom())
class FilterTree(FilterNode[] nodes, int root)

bool comparison_operator(string text)
    return contains(["==", "!=", "<", ">", "<=", ">="], text)

Token[] | error tokenize(string expression)
    Token[] tokens = []
    int index = 0
    string word_characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:"
    while index < int(len(expression))
        string character = expression[index]
        int column = index + 1
        int end = if index + 2 <= int(len(expression)) then index + 2 else int(len(expression))
        string pair = expression[index:<end]
        if character == " "
            index += 1
            continue
        string kind
        string text
        if len(pair) == 2 and (comparison_operator(pair) or pair == "&&" or pair == "||")
            kind = pair
            text = pair
            index += 2
        elif contains(["(", ")", "!", "<", ">"], character)
            kind = character
            text = character
            index += 1
        elif character == DQ
            int last = index + 1
            while last < int(len(expression)) and expression[last] != DQ
                last += 1
            if last == int(len(expression))
                return error("unterminated string at column {column}")
            kind = "string"
            text = expression[index:last]
            index = last + 1
        elif word_characters.contains(character)
            int last = index
            while last < int(len(expression)) and word_characters.contains(expression[last])
                last += 1
            text = expression[index:<last]
            kind = if text == "and" then "&&" elif text == "or" then "||" elif text == "not" then "!" else "word"
            index = last
        else
            return error("invalid character '{character}' at column {column}")
        tokens = tokens.append(Token(kind, text, column))
    return tokens

bool decimal_digits(string text)
    if len(text) == 0
        return false
    for int index < int(len(text))
        if not "0123456789".contains(text[index])
            return false
    return true

dump.Atom | none converted(string kind, Token token)
    if kind == "string"
        return if token.kind == "string" then dump.Atom(0, token.text[1:<int(len(token.text)) - 1], true) else none
    if token.kind != "word"
        return none
    string text = token.text
    if kind == "integer" or kind == "hex2" or kind == "hex4"
        if 1 <= len(text) <= 15 and decimal_digits(text)
            return dump.Atom(int.parse(text))
        if text.starts_with("0x") and 3 <= len(text) <= 14 and dump.hex_digits(text[2:], true)
            return dump.Atom(dump.hex_value(text[2:]))
        return none
    string[] parts = text.split(if kind == "ipv4" then "." else ":")
    if int(len(parts)) != (if kind == "ipv4" then 4 else 6)
        return none
    int value = 0
    for string part = parts[]
        int byte
        if kind == "ipv4"
            if not (1 <= len(part) <= 3) or not decimal_digits(part)
                return none
            byte = int.parse(part)
            if byte > 255
                return none
        else
            if len(part) != 2 or not dump.hex_digits(part, true)
                return none
            byte = dump.hex_value(part)
        value = value * 256 + byte
    return dump.Atom(value)

string unexpected_text(Token token)
    return "unexpected '{token.text}' at column {token.column}"

class Parser(Token[] tokens, Schema schema)
    int position = 0
    FilterNode[] nodes = []

    string next_kind()
        return if position < int(len(tokens)) then tokens[position].kind else ""

    Token | error .take()
        if position >= int(len(tokens))
            return error("unexpected end of filter")
        Token token = tokens[position]
        position += 1
        return token

    int .append_node(FilterNode node)
        int index = int(len(nodes))
        nodes = nodes.append(node)
        return index

    int | error .parse_test(string name)
        string kind = schema.field_type(name)
        if kind == ""
            return error("unknown field {name}")
        if not comparison_operator(next_kind())
            return .append_node(FilterNode("exists", field = name))
        Token operator_token = try .take()
        string operation = operator_token.kind
        if kind == "presence" or kind == "string" and operation != "==" and operation != "!="
            return error("operator {operation} not allowed for {name}")
        Token token = try .take()
        if token.kind != "word" and token.kind != "string"
            return error(unexpected_text(token))
        dump.Atom | none value = converted(kind, token)
        match value
            none
                return error("invalid value {token.text} for {name}")
            dump.Atom found
                return .append_node(FilterNode("compare", field = name, operation = operation, value = found))

    int | error .negation()
        if next_kind() == "!"
            Token skipped = try .take()
            int child = try .negation()
            return .append_node(FilterNode("not", child))
        Token token = try .take()
        if token.kind == "("
            int child = try .expression()
            Token closing = try .take()
            if closing.kind != ")"
                return error(unexpected_text(closing))
            return child
        if token.kind == "word"
            return try .parse_test(token.text)
        return error(unexpected_text(token))

    int | error .product()
        int node = try .negation()
        while next_kind() == "&&"
            Token skipped = try .take()
            int right = try .negation()
            node = .append_node(FilterNode("and", node, right))
        return node

    int | error .expression()
        int node = try .product()
        while next_kind() == "||"
            Token skipped = try .take()
            int right = try .product()
            node = .append_node(FilterNode("or", node, right))
        return node

    FilterTree | error .parse()
        int root = try .expression()
        if position < int(len(tokens))
            return error(unexpected_text(tokens[position]))
        return FilterTree(nodes, root)

FilterTree | error parse_filter(string expression, Schema schema)
    Token[] tokens = try tokenize(expression)
    Parser parser = Parser(tokens, schema)
    return try .parser.parse()

bool compare(dump.Atom first, string operation, dump.Atom second)
    if first.textual
        return if operation == "==" then first.text == second.text else first.text != second.text
    if operation == "=="
        return first.number == second.number
    if operation == "<"
        return first.number < second.number
    if operation == ">"
        return first.number > second.number
    if operation == "<="
        return first.number <= second.number
    return first.number >= second.number

bool evaluate(FilterTree tree, int index, dump.Packet packet)
    FilterNode node = tree.nodes[index]
    if node.kind == "and"
        return evaluate(tree, node.left, packet) and evaluate(tree, node.right, packet)
    if node.kind == "or"
        return evaluate(tree, node.left, packet) or evaluate(tree, node.right, packet)
    if node.kind == "not"
        return not evaluate(tree, node.left, packet)
    if node.kind == "exists" and protocol_field(node.field)
        return contains(packet.layers, node.field)
    dump.Atom[] values = field_values(packet, node.field)
    if node.kind == "exists"
        return len(values) > 0
    if len(values) == 0
        return false
    if node.operation == "!="
        for dump.Atom value = values[]
            if value == node.value
                return false
        return true
    for dump.Atom value = values[]
        if compare(value, node.operation, node.value)
            return true
    return false

string[] details(dump.Packet[] packets, int number, Schema schema)
    if number < 1 or number > int(len(packets))
        return ["packet {number} not found"]
    dump.Packet packet = packets[number - 1]
    string[] lines = ["packet {number}"]
    for string layer = ["frame"].concat(packet.layers)[]
        lines = lines.append(layer)
        for Field field = schema.fields[]
            if field.name.starts_with(layer + ".")
                for dump.Atom value = packet.fields.values(field.name)[]
                    lines = lines.append("  " + field.name + (if field.kind == "presence" then "" else " = " + notation(field.kind, value)))
        if layer == "data"
            lines = lines.concat([for string line = dump.hex_dump(packet.remaining)[] then "  " + line])
    return lines

class Transactions()
    dump.Packet[] queries = []
    dump.Packet[] responses = []
    int[] times = []
    int unanswered = 0

Transactions dns_transactions(dump.Packet[] packets)
    Transactions result = Transactions()
    dump.Packet[] pending = []
    for dump.Packet packet = packets[]
        if not packet.fields.exists("dns.id")
            continue
        if packet.fields.number("dns.flags.response") == 0
            result.queries = result.queries.append(packet)
            pending = pending.append(packet)
            continue
        result.responses = result.responses.append(packet)
        for int index < int(len(pending))
            dump.Packet query = pending[index]
            if query.fields.number("dns.id") == packet.fields.number("dns.id") and query.fields.number("ip.src") == packet.fields.number("ip.dst") and query.fields.number("udp.srcport") == packet.fields.number("udp.dstport") and query.fields.number("ip.dst") == packet.fields.number("ip.src") and query.fields.number("udp.dstport") == packet.fields.number("udp.srcport")
                result.times = result.times.append(packet.time - query.time)
                pending = pending[0:<index].concat(pending[index + 1:])
                break
    result.unanswered = int(len(pending))
    return result

int lookup_count(map.Map<string, int> counts, string key)
    match counts.get(key)
        int value
            return value
        none
            return 0

string[] mark_names()
    return ["retransmission", "out_of_order", "lost_segment", "duplicate_ack"]

string[] protocol_statistics(dump.Packet[] packets, Transactions transactions)
    int bytes = 0
    for dump.Packet packet = packets[]
        bytes += packet.length
    string[] lines = ["packets {len(packets)}", "bytes {bytes}", "duration " + seconds(packets[len(packets) - 1].time - packets[0].time), "hierarchy"]
    string[] layers = ["eth", "arp", "ip", "icmp", "udp", "dns", "tcp"]
    int[] indents = [0, 2, 2, 4, 4, 6, 4]
    for int index < 7
        int count = 0
        int total = 0
        for dump.Packet packet = packets[]
            if contains(packet.layers, layers[index])
                count += 1
                total += packet.length
        lines = lines.append(string.repeat(" ", nat(indents[index])) + "{layers[index]} {count} {total}")
    lines = lines.append("checksums")
    for string layer = ["ip", "icmp", "udp", "tcp"][]
        int good = 0
        int bad = 0
        int unchecked = 0
        for dump.Packet packet = packets[]
            string status = packet.fields.text(layer + ".checksum.status")
            if status == "good"
                good += 1
            elif status == "bad"
                bad += 1
            elif status == "none"
                unchecked += 1
        lines = lines.append("{layer} good {good} bad {bad}" + (if layer == "udp" then " none {unchecked}" else ""))
    int bad_dump = 0
    for dump.Packet packet = packets[]
        if packet.dump_error != ""
            bad_dump += 1
    lines = lines.concat(["malformed", "dump {bad_dump}"])
    for string layer = ["eth", "arp", "ip", "icmp", "udp", "tcp", "dns"][]
        int count = 0
        for dump.Packet packet = packets[]
            if packet.dump_error == "" and packet.fields.exists("frame.malformed") and packet.layers[len(packet.layers) - 1] == layer
                count += 1
        lines = lines.append("{layer} {count}")
    lines = lines.append("tcp analysis")
    for string mark = mark_names()[]
        int count = 0
        for dump.Packet packet = packets[]
            if packet.fields.exists("tcp.analysis." + mark)
                count += 1
        lines = lines.append("{mark} {count}")
    lines = lines.concat(["dns", "queries {len(transactions.queries)}", "responses {len(transactions.responses)}", "transactions {len(transactions.times)}", "unanswered {transactions.unanswered}"])
    if len(transactions.times) == 0
        lines = lines.append("response_time -")
    else
        int minimum = transactions.times[0]
        int maximum = minimum
        for int value = transactions.times[]
            if value < minimum
                minimum = value
            if value > maximum
                maximum = value
        lines = lines.append("response_time min " + seconds(minimum) + " max " + seconds(maximum))
    int[] rcodes = array(16, fill = 0)
    for dump.Packet packet = transactions.responses[]
        rcodes[packet.fields.number("dns.flags.rcode")] += 1
    for int code < 16
        if rcodes[code] > 0
            lines = lines.append("rcode " + dns.rcode_name(code) + " {rcodes[code]}")
    map.Map<string, int> counts
    for dump.Packet packet = transactions.queries[]
        for dump.Atom name = packet.fields.values("dns.qry.name")[]
            .counts.set(name.text, lookup_count(counts, name.text) + 1)
    string[] names = []
    for string name = counts.keys().sorted()[]
        int position = int(len(names))
        names = names.append(name)
        while position > 0 and lookup_count(counts, name) > lookup_count(counts, names[position - 1])
            names[position] = names[position - 1]
            position -= 1
        names[position] = name
    lines = lines.append("names")
    for string name = names[]
        lines = lines.append(name + " {lookup_count(counts, name)}")
    return lines

string endpoint_text(flow.Endpoint endpoint)
    return network.ipv4(endpoint.address) + (if endpoint.port < 0 then "" else ":{endpoint.port}")

string[] conversation_lines(dump.Packet[] packets, int base_time)
    string[] lines = ["type,endpoint_a,endpoint_b,packets,bytes,packets_a_to_b,bytes_a_to_b,packets_b_to_a,bytes_b_to_a,start,duration"]
    for flow.Conversation row = flow.conversations(packets)[]
        string[] fields = [row.kind, endpoint_text(row.source), endpoint_text(row.destination), "{row.packets()}", "{row.bytes()}", "{row.packets_a_to_b}", "{row.bytes_a_to_b}", "{row.packets_b_to_a}", "{row.bytes_b_to_a}", seconds(row.start - base_time), seconds(row.finish - row.start)]
        lines = lines.append(fields.join(","))
    return lines

string[] endpoint_lines(dump.Packet[] packets)
    string[] lines = ["address,packets,bytes,tx_packets,tx_bytes,rx_packets,rx_bytes"]
    for flow.EndpointTotals row = flow.endpoints(packets)[]
        lines = lines.append(network.ipv4(row.address) + ",{row.packets()},{row.bytes()},{row.tx_packets},{row.tx_bytes},{row.rx_packets},{row.rx_bytes}")
    return lines

string side_line(flow.Side side)
    string[] parts = ["{side.name} packets {side.packets} payload {side.payload}"]
    string[] marks = mark_names()
    for int index < 4
        parts = parts.append("{marks[index]} {side.marks[index]}")
    return parts.join(" ")

string[] stream_lines(flow.Stream stream, dump.Packet[] packets)
    string rtt = "-"
    if stream.syn >= 0 and stream.handshake_ack >= 0
        rtt = seconds(packets[stream.handshake_ack - 1].time - packets[stream.syn - 1].time)
    string[] history = [for flow.StateChange change = stream.history[] then "{change.state} {change.number}"]
    string[] lines = [
        "stream {stream.number} " + endpoint_text(stream.client) + " -> " + endpoint_text(stream.server),
        "packets {stream.packets} bytes {stream.bytes} start " + seconds(stream.start - packets[0].time) + " duration " + seconds(stream.finish - stream.start),
        "states " + history.join(", "),
        "handshake syn " + optional(stream.syn) + " syn_ack " + optional(stream.syn_ack) + " ack " + optional(stream.handshake_ack) + " rtt " + rtt,
        "options client mss " + optional(stream.client_side.mss) + " wscale " + optional(stream.client_side.wscale) + " server mss " + optional(stream.server_side.mss) + " wscale " + optional(stream.server_side.wscale),
        side_line(stream.client_side),
        side_line(stream.server_side),
    ]
    for flow.Event event = stream.events[]
        lines = lines.append("event {event.number} {event.side} {event.mark} seq {event.start} len {event.length}")
    return lines

void write_lines(string name, string[] lines)
    file.write("output/" + name, if len(lines) == 0 then "" else lines.join(NL) + NL)

Schema schema = Schema()
dump.Packet[] packets = dump.read_capture("input/capture.txt")
int base_time = packets[0].time
flow.Tracker tracker = flow.Tracker()
for int index < int(len(packets))
    dissect(&packets[index], base_time)
    if packets[index].fields.exists("tcp.srcport")
        .tracker.track(&packets[index])
string[] summaries = [for dump.Packet packet = packets[] then summary(packet, schema, tracker)]
string[] summary_output = summaries
string[] detail_output = []
int detail_count = 0
for string request = dump.read_lines("input/filters.txt")[]
    if request.starts_with("FILTER ")
        string expression = request[7:]
        summary_output = summary_output.concat(["", "filter " + expression])
        FilterTree | error result = parse_filter(expression, schema)
        match result
            error problem
                summary_output = summary_output.append("error: " + problem.message)
            FilterTree tree
                int count = 0
                for int index < int(len(packets))
                    if evaluate(tree, tree.root, packets[index])
                        summary_output = summary_output.append(summaries[index])
                        count += 1
                summary_output = summary_output.append("matched {count} of {len(packets)}")
    elif request.starts_with("DETAIL ")
        int number = int.parse(request[7:])
        if detail_count > 0
            detail_output = detail_output.append("")
        detail_output = detail_output.concat(details(packets, number, schema))
        detail_count += 1
string[] streams_output = []
for int index < int(len(tracker.streams))
    if index > 0
        streams_output = streams_output.append("")
    streams_output = streams_output.concat(stream_lines(tracker.streams[index], packets))
if not file.is_directory("output")
    file.mkdir("output")
write_lines("summary.txt", summary_output)
write_lines("details.txt", detail_output)
write_lines("conversations.csv", conversation_lines(packets, base_time))
write_lines("endpoints.csv", endpoint_lines(packets))
write_lines("protocol_stats.txt", protocol_statistics(packets, dns_transactions(packets)))
write_lines("tcp_streams.txt", streams_output)
