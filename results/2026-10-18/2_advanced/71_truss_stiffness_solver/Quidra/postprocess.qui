import assembly = "./assembly.qui"
import model_io = "./model_io.qui"

class Result(string name, real64[] displacement, real64[] forces, real64[] reactions, real64[] external)

real64[] axial_forces(assembly.Geometry[] geometry, assembly.Properties[] properties, real64[] displacement, real64[] temperature, int removed)
    real64[] result = [for int i < int(len(geometry)) then 0.0]
    for int i < int(len(geometry))
        if i == removed
            continue
        assembly.Geometry shape = geometry[i]
        real64 extension = (displacement[shape.dofs[2]] - displacement[shape.dofs[0]]) * shape.cosine + (displacement[shape.dofs[3]] - displacement[shape.dofs[1]]) * shape.sine
        result[i] = properties[i].stiffness * extension - temperature[i]
    return result

real64[] reactions(real64[][] matrix, real64[] displacement, real64[] force, int[] restrained)
    real64[] result = [for int d < int(len(force)) then 0.0]
    for int row = restrained[]
        real64 value = matrix[row][0] * displacement[0]
        for 1 <= int column < int(len(force))
            value += matrix[row][column] * displacement[column]
        result[row] = value - force[row]
    return result

Result superpose(model_io.Combination combination, Result[] results)
    Result first = results[combination.cases[0]]
    real64 factor = combination.factors[0]
    real64[] displacement = [for real64 value = first.displacement[] then factor * value]
    real64[] forces = [for real64 value = first.forces[] then factor * value]
    real64[] reaction = [for real64 value = first.reactions[] then factor * value]
    real64[] external = [for real64 value = first.external[] then factor * value]
    for 1 <= int i < int(len(combination.cases))
        Result source = results[combination.cases[i]]
        factor = combination.factors[i]
        for int d < int(len(displacement))
            displacement[d] += factor * source.displacement[d]
            reaction[d] += factor * source.reactions[d]
            external[d] += factor * source.external[d]
        for int m < int(len(forces))
            forces[m] += factor * source.forces[m]
    return Result(combination.name, displacement, forces, reaction, external)

real64 equilibrium_residual(Result result, assembly.Geometry[] geometry)
    real64[] residual = [for int d < int(len(result.external)) then result.external[d] + result.reactions[d]]
    for int i < int(len(geometry))
        assembly.Geometry shape = geometry[i]
        real64[] direction = [shape.cosine, shape.sine, -shape.cosine, -shape.sine]
        for int j < 4
            residual[shape.dofs[j]] += result.forces[i] * direction[j]
    real64 largest = 0.0
    for real64 value = residual[]
        real64 magnitude = if value < 0.0 then -value else value
        if magnitude > largest
            largest = magnitude
    return largest
