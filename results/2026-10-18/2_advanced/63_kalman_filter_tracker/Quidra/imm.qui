import math
import matrix = "./matrix.qui"
import kalman = "./kalman.qui"

class Filter(real64[] densities, real64[][] transitions, real64[] probabilities, real64 sigma, real64 velocity_variance, real64[] measurement)
    kalman.Filter[] models = [for real64 density = densities[] then kalman.Filter(4, density, sigma, velocity_variance, 0.0, measurement)]

    void .step(real64 interval, real64[] observation)
        real64[] predicted = [for int j < 2 then transitions[0][j] * probabilities[0] + transitions[1][j] * probabilities[1]]
        real64[][] old_states = [for kalman.Filter model = models[] then model.state]
        real64[][][] old_covariances = [for kalman.Filter model = models[] then model.covariance]
        real64[] likelihoods = []
        for int j < 2
            real64 w0 = transitions[0][j] * probabilities[0] / predicted[j]
            real64 w1 = transitions[1][j] * probabilities[1] / predicted[j]
            real64[] mixed = [for int r < 4 then w0 * old_states[0][r] + w1 * old_states[1][r]]
            real64[][] covariance = [for int r < 4 then [for int s < 4 then w0 * (old_covariances[0][r][s] + (old_states[0][r] - mixed[r]) * (old_states[0][s] - mixed[s])) + w1 * (old_covariances[1][r][s] + (old_states[1][r] - mixed[r]) * (old_states[1][s] - mixed[s]))]]
            models[j].state = mixed
            models[j].covariance = covariance
            .models[j].predict(interval)
            real64 likelihood = 1.0
            if len(observation) != 0
                kalman.Update update = .models[j].update(observation)
                real64 root = math.sqrt(matrix.determinant2(update.covariance))
                likelihood = math.exp(-update.distance2 / 2.0) / (2.0 * 3.141592653589793 * root)
            likelihoods = likelihoods.append(likelihood)
        real64 denominator = likelihoods[0] * predicted[0] + likelihoods[1] * predicted[1]
        probabilities = [for int j < 2 then likelihoods[j] * predicted[j] / denominator]

    real64[] estimate()
        return [for int r < 4 then probabilities[0] * models[0].state[r] + probabilities[1] * models[1].state[r]]
