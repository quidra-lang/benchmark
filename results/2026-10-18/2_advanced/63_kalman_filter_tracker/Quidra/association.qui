int[][] ordered_pairs(int[][] pairs)
    int[][] result = []
    for int[] pair = pairs[]
        int position = int(len(result))
        for int i < int(len(result))
            if pair[0] < result[i][0] or (pair[0] == result[i][0] and pair[1] < result[i][1])
                position = i
                break
        result = result[0:<position].concat([pair]).concat(result[position:<int(len(result))])
    return result

int[][] minimum_matching(real64[][] costs)
    if len(costs) == 0 or len(costs[0]) == 0
        return []
    bool swapped = len(costs) > len(costs[0])
    real64[][] values = costs
    if swapped
        values = [for int j < int(len(costs[0])) then [for int i < int(len(costs)) then costs[i][j]]]
    int rows = int(len(values))
    int columns = int(len(values[0]))
    real64 infinity = 1e100
    real64[] u = [for int i <= rows then 0.0]
    real64[] v = [for int j <= columns then 0.0]
    int[] matched = [for int j <= columns then 0]
    int[] previous = matched
    for 1 <= int row <= rows
        matched[0] = row
        int column = 0
        real64[] distances = [for int j <= columns then infinity]
        bool[] used = [for int j <= columns then false]
        while true
            used[column] = true
            int current_row = matched[column]
            real64 delta = infinity
            int following = 0
            for 1 <= int candidate <= columns
                if not used[candidate]
                    real64 reduced = values[current_row - 1][candidate - 1] - u[current_row] - v[candidate]
                    if reduced < distances[candidate]
                        distances[candidate] = reduced
                        previous[candidate] = column
                    if distances[candidate] < delta
                        delta = distances[candidate]
                        following = candidate
            for int candidate <= columns
                if used[candidate]
                    u[matched[candidate]] += delta
                    v[candidate] -= delta
                else
                    distances[candidate] -= delta
            column = following
            if matched[column] == 0
                break
        while column != 0
            int following = previous[column]
            matched[column] = matched[following]
            column = following
    int[][] pairs = []
    for 1 <= int column <= columns
        if matched[column] != 0
            pairs = pairs.append(if swapped then [column - 1, matched[column] - 1] else [matched[column] - 1, column - 1])
    return ordered_pairs(pairs)

int[][] optimal_assignment(real64[][] costs, bool[][] usable)
    if len(costs) == 0 or len(costs[0]) == 0
        return []
    int rows = int(len(costs))
    int columns = int(len(costs[0]))
    real64 largest = 1.0
    bool any = false
    for int i < rows
        for int j < columns
            if usable[i][j]
                any = true
                if costs[i][j] > largest
                    largest = costs[i][j]
    if not any
        return []
    int smaller = if rows < columns then rows else columns
    real64 penalty = real64(smaller + 1) * (largest + 1.0)
    real64[][] values = [for int i < rows then [for int j < columns then (if usable[i][j] then costs[i][j] else penalty)]]
    int[][] pairs = minimum_matching(values)
    return [for int[] pair = pairs[] if usable[pair[0]][pair[1]] then pair]
