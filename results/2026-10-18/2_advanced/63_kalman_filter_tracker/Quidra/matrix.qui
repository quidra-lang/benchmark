real64 total(real64[] values)
    if len(values) == 0
        return 0.0
    real64 result = values[0]
    for 1 <= int i < int(len(values))
        result += values[i]
    return result

real64[][] zeros(int rows, int columns)
    return [for int i < rows then [for int j < columns then 0.0]]

real64[][] diagonal(real64[] values)
    int size = int(len(values))
    real64[][] result = zeros(size, size)
    for int i < size
        result[i][i] = values[i]
    return result

real64[][] identity(int size)
    return diagonal([for int i < size then 1.0])

real64[][] transpose(real64[][] values)
    return [for int j < int(len(values[0])) then [for int i < int(len(values)) then values[i][j]]]

real64[][] add(real64[][] first, real64[][] second)
    return [for int i < int(len(first)) then [for int j < int(len(first[i])) then first[i][j] + second[i][j]]]

real64[][] subtract(real64[][] first, real64[][] second)
    return [for int i < int(len(first)) then [for int j < int(len(first[i])) then first[i][j] - second[i][j]]]

real64[] vector_add(real64[] first, real64[] second)
    return [for int i < int(len(first)) then first[i] + second[i]]

real64[] vector_subtract(real64[] first, real64[] second)
    return [for int i < int(len(first)) then first[i] - second[i]]

real64[][] product(real64[][] first, real64[][] second)
    return [for real64[] row = first[] then [for int j < int(len(second[0])) then total([for int k < int(len(row)) then row[k] * second[k][j]])]]

real64[] vector_product(real64[][] values, real64[] vector)
    return [for real64[] row = values[] then total([for int k < int(len(vector)) then row[k] * vector[k]])]

real64[][] inverse(real64[][] values)
    int size = int(len(values))
    real64[][] unit = identity(size)
    real64[][] augmented = [for int i < size then values[i].concat(unit[i])]
    for int column < size
        real64 pivot = augmented[column][column]
        for int j < 2 * size
            augmented[column][j] /= pivot
        for int row < size
            if row != column
                real64 factor = augmented[row][column]
                for int j < 2 * size
                    augmented[row][j] -= factor * augmented[column][j]
    return [for real64[] row = augmented[] then row[size:<2 * size]]

real64 determinant2(real64[][] values)
    return values[0][0] * values[1][1] - values[0][1] * values[1][0]

real64 quadratic2(real64[] vector, real64[][] values)
    return vector[0] * (values[0][0] * vector[0] + values[0][1] * vector[1]) + vector[1] * (values[1][0] * vector[0] + values[1][1] * vector[1])
