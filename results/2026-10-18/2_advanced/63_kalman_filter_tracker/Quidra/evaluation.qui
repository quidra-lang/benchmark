import math
import association = "./association.qui"

real64 squared_distance(real64[] first, real64[] second)
    real64 dx = first[0] - second[0]
    real64 dy = first[1] - second[1]
    return dx * dx + dy * dy

real64 distance(real64[] first, real64[] second)
    real64 value = math.sqrt(squared_distance(first, second))
    return value

real64 ospa(real64[][] first, real64[][] second, real64 cutoff)
    if len(first) == 0 and len(second) == 0
        return 0.0
    if len(first) == 0 or len(second) == 0
        return cutoff
    real64[][] smaller = if len(first) <= len(second) then first else second
    real64[][] larger = if len(first) <= len(second) then second else first
    real64[][] costs = []
    for real64[] point = smaller[]
        real64[] row = []
        for real64[] other = larger[]
            real64 clipped = distance(point, other)
            if clipped > cutoff
                clipped = cutoff
            row = row.append(clipped * clipped)
        costs = costs.append(row)
    int[][] pairs = association.minimum_matching(costs)
    real64 total = costs[pairs[0][0]][pairs[0][1]]
    for 1 <= int i < int(len(pairs))
        total += costs[pairs[i][0]][pairs[i][1]]
    real64 result = math.sqrt((total + cutoff * cutoff * real64(int(len(larger)) - int(len(smaller)))) / real64(len(larger)))
    return result

int[] continuity(int[] labels)
    int covered = 0
    int groups = 0
    int swaps = 0
    int previous_label = -1
    bool previous_covered = false
    int delay = -1
    for int offset < int(len(labels))
        int label = labels[offset]
        if label < 0
            previous_covered = false
            continue
        covered += 1
        if delay < 0
            delay = offset
        if not previous_covered
            groups += 1
        if previous_label >= 0 and label != previous_label
            swaps += 1
        previous_label = label
        previous_covered = true
    int breaks = if groups == 0 then 0 else groups - 1
    return [covered, breaks, swaps, delay]

int rounded(real64 value)
    real64 magnitude = if value < 0.0 then -value else value
    int result = math.floor(magnitude * 10000.0 + 0.5)
    return if value < 0.0 then -result else result

string fmt(real64 value)
    int units = rounded(value)
    bool negative = units < 0
    if negative
        units = -units
    string tail = (units % 10000).string()
    return (if negative then "-" else "") + (units / 10000).string() + "." + string.repeat("0", nat(4 - int(len(tail)))) + tail
