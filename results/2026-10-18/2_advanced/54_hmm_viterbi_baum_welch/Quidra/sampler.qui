class Generator(int state)
    int .draw(real64[] weights)
        real64 total = 0.0
        for real64 weight = weights[]
            total += weight
        state = (48271 * state) % 2147483647
        real64 threshold = (real64(state) / 2147483647.0) * total
        real64 cumulative = 0.0
        for int j < int(len(weights))
            cumulative += weights[j]
            if threshold < cumulative
                return j
        return int(len(weights)) - 1

(int[], int[]) synthetic(real64[][] model, int length, Generator &generator)
    int count = int(len(model[0]))
    int[] states = []
    int[] observations = []
    for int t < length
        real64[] weights = if t == 0 then model[0] else model[states[t - 1] + 1]
        int state = .generator.draw(weights)
        int symbol = .generator.draw(model[count + state + 1])
        states = states.append(state)
        observations = observations.append(symbol)
    return (states, observations)

int[] posterior_path(real64[][] model, real64[][] forward, Generator &generator)
    int count = int(len(model[0]))
    int length = int(len(forward))
    int[] path = [for int t < length then 0]
    path[length - 1] = .generator.draw(forward[length - 1])
    int position = length - 2
    while position >= 0
        int following = path[position + 1]
        real64[] weights = [for int state < count then forward[position][state] * model[state + 1][following]]
        path[position] = .generator.draw(weights)
        position -= 1
    return path
