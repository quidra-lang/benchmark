import math

real64[] normalize(real64[] source)
    real64 total = 0.0
    for real64 value = source[]
        total += value
    return [for real64 value = source[] then value / total]

class Model(string name, string[] states, string[] symbols, string missing, real64[][] probabilities)

string[][] tokens(string name)
    string content = file.read("input/" + name)
    string[] rows = content.split(NL)
    return [for string row = rows[0:<int(len(rows)) - 1][] then row.split(" ")]

real64 number(string text)
    real64 result = real64.parse(text)
    return result

(Model, string[][], string[][], string[][]) read_inputs()
    string[][] rows = tokens("model.txt")
    string[] states = rows[0][1:<int(len(rows[0]))]
    string[] symbols = rows[1][1:<int(len(rows[1]))]
    real64[][] probabilities = []
    probabilities = probabilities.append(normalize([for string text = rows[3][1:<int(len(rows[3]))][] then number(text)]))
    for 4 <= int j < int(len(rows))
        probabilities = probabilities.append(normalize([for string text = rows[j][2:<int(len(rows[j]))][] then number(text)]))
    return (Model("INITIAL", states, symbols, rows[2][1], probabilities), tokens("sequences.txt"), tokens("labeled.txt"), tokens("params.txt"))

string decimal(real64 value, int places = 4)
    int scale = 1
    for int j < places
        scale *= 10
    real64 absolute = if value < 0.0 then -value else value
    int rounded = math.floor(absolute * real64(scale) + 0.5)
    int magnitude = int(rounded)
    string sign = if value < 0.0 and magnitude != 0 then "-" else ""
    string tail = (magnitude % scale).string()
    return sign + (magnitude / scale).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string optional(real64 | none value)
    match value
        real64 present
            return decimal(present)
        none
            return "-"

string values(real64[] numbers)
    return [for real64 value = numbers[] then decimal(value)].join(" ")

string[] model_lines(Model model)
    int count = int(len(model.states))
    string[] rows = ["MODEL {model.name}", "STATES " + model.states.join(" "), "SYMBOLS " + model.symbols.join(" "), "MISSING {model.missing}", "INITIAL " + values(model.probabilities[0])]
    for int i < count
        rows = rows.append("TRANSITION {model.states[i]} " + values(model.probabilities[i + 1]))
    for int i < count
        rows = rows.append("EMISSION {model.states[i]} " + values(model.probabilities[count + i + 1]))
    return rows

void write_lines(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)
