import model_io = "./model_io.qui"
import inference = "./inference.qui"

real64[][] empty_counts(real64[][] template)
    int count = int(len(template[0]))
    int symbols = int(len(template[count + 1]))
    real64[][] result = [[for int i < count then 0.0]]
    for int i < count
        result = result.append([for int j < count then 0.0])
    for int i < count
        result = result.append([for int c < symbols then 0.0])
    return result

real64[][] smoothed(real64[][] counts, real64 alpha)
    real64[][] result = []
    for real64[] row = counts[]
        result = result.append(model_io.normalize([for real64 value = row[] then value + alpha]))
    return result

real64[][] baum_welch_step(real64[][] model, int[][] sequences, real64 pseudocount)
    int count = int(len(model[0]))
    real64[][] counts = empty_counts(model)
    for int[] observations = sequences[]
        inference.ForwardBackward fb = inference.forward_backward(model, observations)
        for int state < count
            counts[0][state] += fb.posterior[0][state]
        for int t < int(len(observations))
            int observation = observations[t]
            for int state < count
                if observation >= 0
                    counts[count + state + 1][observation] += fb.posterior[t][state]
                if t + 1 < int(len(observations))
                    for int following < count
                        counts[state + 1][following] += inference.transition_probability(model, fb, t, state, following)
    return smoothed(counts, pseudocount)

real64[][] estimate_by_counting(real64[][] template, int[][] observations, int[][] paths, real64 alpha)
    int count = int(len(template[0]))
    real64[][] counts = empty_counts(template)
    for int record < int(len(paths))
        int[] path = paths[record]
        counts[0][path[0]] += 1.0
        for int t < int(len(path))
            int state = path[t]
            int observation = observations[record][t]
            if observation >= 0
                counts[count + state + 1][observation] += 1.0
            if t + 1 < int(len(path))
                counts[state + 1][path[t + 1]] += 1.0
    return smoothed(counts, alpha)

real64 total_loglik(real64[][] model, int[][] sequences)
    real64 total = 0.0
    for int[] observations = sequences[]
        inference.ForwardBackward result = inference.scaled_forward(model, observations)
        total += result.loglik
    return total
