import math

int maximum(real64[] values)
    int best = 0
    for 1 <= int j < int(len(values))
        if values[j] > values[best]
            best = j
    return best

real64[] emission_factors(real64[][] model, int observation, bool logarithms)
    int count = int(len(model[0]))
    real64[] result = []
    for int state < count
        real64 value = if observation < 0 then 1.0 else model[count + state + 1][observation]
        if logarithms
            value = math.log(value)
        result = result.append(value)
    return result

class ForwardBackward(real64[][] forward, real64[][] backward, real64[] scales, real64[][] emissions, real64[][] posterior, real64 loglik)

ForwardBackward scaled_forward(real64[][] model, int[] observations)
    int count = int(len(model[0]))
    real64[][] forward = []
    real64[] scales = []
    real64[][] emissions = []
    real64 loglik = 0.0
    for int t < int(len(observations))
        real64[] factors = emission_factors(model, observations[t], false)
        real64[] row = []
        real64 scale = 0.0
        for int j < count
            real64 value = 0.0
            if t == 0
                value = model[0][j] * factors[j]
            else
                real64 total = 0.0
                for int i < count
                    total += forward[t - 1][i] * model[i + 1][j]
                value = total * factors[j]
            row = row.append(value)
            scale += value
        for auto &value = &row[]
            value /= scale
        forward = forward.append(row)
        scales = scales.append(scale)
        emissions = emissions.append(factors)
        real64 logarithm = math.log(scale)
        loglik += logarithm
    return ForwardBackward(forward, [], scales, emissions, [], loglik)

ForwardBackward forward_backward(real64[][] model, int[] observations)
    ForwardBackward result = scaled_forward(model, observations)
    int count = int(len(model[0]))
    int length = int(len(observations))
    result.backward = [for int t < length then [for int i < count then 0.0]]
    result.backward[length - 1] = [for int i < count then 1.0]
    int position = length - 2
    while position >= 0
        for int i < count
            real64 total = 0.0
            for int j < count
                total += model[i + 1][j] * result.emissions[position + 1][j] * result.backward[position + 1][j]
            result.backward[position][i] = total / result.scales[position + 1]
        position -= 1
    result.posterior = [for int t < length then [for int i < count then result.forward[t][i] * result.backward[t][i]]]
    return result

real64 transition_probability(real64[][] model, ForwardBackward result, int position, int state, int following)
    return result.forward[position][state] * model[state + 1][following] * result.emissions[position + 1][following] * result.backward[position + 1][following] / result.scales[position + 1]

(int[], real64) viterbi(real64[][] model, int[] observations)
    int count = int(len(model[0]))
    real64[][] transitions = []
    for int i < count
        transitions = transitions.append([for real64 value = model[i + 1][] then math.log(value)])
    real64[] factors = emission_factors(model, observations[0], true)
    real64[] scores = []
    for int j < count
        real64 logarithm = math.log(model[0][j])
        scores = scores.append(logarithm + factors[j])
    int[][] predecessors = [[for int j < count then 0]]
    for 1 <= int t < int(len(observations))
        factors = emission_factors(model, observations[t], true)
        real64[] next_scores = []
        int[] previous_states = []
        for int j < count
            real64[] candidates = [for int i < count then scores[i] + transitions[i][j]]
            int previous = maximum(candidates)
            previous_states = previous_states.append(previous)
            next_scores = next_scores.append(candidates[previous] + factors[j])
        scores = next_scores
        predecessors = predecessors.append(previous_states)
    int length = int(len(observations))
    int[] path = [for int t < length then 0]
    path[length - 1] = maximum(scores)
    real64 logprob = scores[path[length - 1]]
    int position = length - 1
    while position > 0
        path[position - 1] = predecessors[position][path[position]]
        position -= 1
    return (path, logprob)

class Decoding(int[] viterbi_path, real64 logprob, int[] posterior_path, real64[] confidence, ForwardBackward fb)

Decoding decode(real64[][] model, int[] observations)
    ForwardBackward fb = forward_backward(model, observations)
    (int[] path, real64 logprob) = viterbi(model, observations)
    int[] posterior_path = []
    real64[] confidence = []
    for real64[] row = fb.posterior[]
        int chosen = maximum(row)
        posterior_path = posterior_path.append(chosen)
        confidence = confidence.append(row[chosen])
    return Decoding(path, logprob, posterior_path, confidence, fb)
