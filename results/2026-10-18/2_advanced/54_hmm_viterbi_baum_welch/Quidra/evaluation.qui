int absolute(int value)
    return if value < 0 then -value else value

int gcd(int first, int second)
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return first

string fraction(int numerator, int denominator)
    if denominator == 0
        return "-"
    if denominator < 0
        numerator = -numerator
        denominator = -denominator
    int divisor = gcd(absolute(numerator), denominator)
    return "{numerator / divisor}/{denominator / divisor}"

int[][] matrix(int count)
    return [for int i < count then [for int j < count then 0]]

void accumulate(int[][] &counts, int[] truth, int[] prediction)
    for int t < int(len(truth))
        counts[truth[t]][prediction[t]] += 1

int correct(int[] truth, int[] prediction)
    int total = 0
    for int t < int(len(truth))
        if truth[t] == prediction[t]
            total += 1
    return total

string padded(string value, int width)
    return string.repeat(" ", nat(width - int(len(value)))) + value

string[] matrix_lines(string[] states, int[][] counts)
    int width = 1
    for int[] row = counts[]
        for int value = row[]
            if int(len(value.string())) > width
                width = int(len(value.string()))
    string header = " "
    for string state = states[]
        header += " " + padded(state, width)
    string[] result = [header]
    for int i < int(len(states))
        string row = states[i]
        for int value = counts[i][]
            row += " " + padded(value.string(), width)
        result = result.append(row)
    return result

string[] metric_lines(string[] states, int[][] counts)
    int count = int(len(states))
    int[] rows = [for int i < count then 0]
    int[] columns = rows
    int total = 0
    int correct_count = 0
    for int i < count
        correct_count += counts[i][i]
        for int j < count
            rows[i] += counts[i][j]
            columns[j] += counts[i][j]
            total += counts[i][j]
    int expected = 0
    for int i < count
        expected += rows[i] * columns[i]
    string[] result = ["ACCURACY " + fraction(correct_count, total), "KAPPA " + fraction(total * correct_count - expected, total * total - expected)]
    for int i < count
        result = result.append("STATE {states[i]} precision " + fraction(counts[i][i], columns[i]) + " recall " + fraction(counts[i][i], rows[i]) + " f1 " + fraction(2 * counts[i][i], columns[i] + rows[i]))
    return result

int[][] runs(int[] path)
    int[][] result = []
    if len(path) == 0
        return result
    int start = 0
    int state = path[0]
    for 1 <= int t < int(len(path))
        if path[t] != state
            result = result.append([state, start, t - 1])
            state = path[t]
            start = t
    return result.append([state, start, int(len(path)) - 1])

int matched_regions(int[][] first, int[][] second)
    int total = 0
    for int[] a = first[]
        for int[] b = second[]
            if a[0] <= b[1] and b[0] <= a[1]
                total += 1
                break
    return total

int[] region_counts(int[][] predicted, int[][] truth)
    return [int(len(predicted)), int(len(truth)), matched_regions(predicted, truth), matched_regions(truth, predicted)]

int[] boundaries(int[] path)
    return [for 1 <= int t < int(len(path)) if path[t] != path[t - 1] then t]

int matched_boundaries(int[] first, int[] second, int tolerance)
    int total = 0
    for int a = first[]
        for int b = second[]
            if absolute(a - b) <= tolerance
                total += 1
                break
    return total

int[] boundary_counts(int[] prediction, int[] actual, int tolerance)
    int[] predicted = boundaries(prediction)
    int[] truth = boundaries(actual)
    return [int(len(predicted)), int(len(truth)), matched_boundaries(predicted, truth, tolerance), matched_boundaries(truth, predicted, tolerance)]
