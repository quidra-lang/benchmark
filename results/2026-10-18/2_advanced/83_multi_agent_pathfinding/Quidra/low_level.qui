import grid_map = "./grid_map.qui"

class Prohibitions(int cell_count)
    set.Set<int> states = set.Set<int>()
    set.Set<int> moves = set.Set<int>()
    map.Map<int, int> permanent = map.Map<int, int>()

class Budget(int limit)
    int searches = 0
    int expansions = 0

class SearchResult(string status, int[] path, int expansions)
class SearchNode(int cell, int tick, int f, int g, int number, int parent)

bool state_allowed(Prohibitions restrictions, int cell, int tick)
    if restrictions.states.has(tick * restrictions.cell_count + cell)
        return false
    match restrictions.permanent.get(cell)
        int start
            return tick < start
        none
            return true

bool action_allowed(Prohibitions restrictions, int source, int destination, int tick)
    if not state_allowed(restrictions, destination, tick)
        return false
    int key = (tick * restrictions.cell_count + source) * restrictions.cell_count + destination
    return source == destination or not restrictions.moves.has(key)

int arrival_allowed(Prohibitions restrictions, int goal)
    int result = 0
    for int key = restrictions.states.values()[]
        if key % restrictions.cell_count == goal
            int next = key / restrictions.cell_count + 1
            if next > result
                result = next
    return result

void reserve_path(Prohibitions &restrictions, int[] path, int start_tick = 0, bool permanent = false)
    int cells = restrictions.cell_count
    for int step < int(len(path))
        int tick = start_tick + step
        .restrictions.states.add(tick * cells + path[step])
        if step > 0 and path[step] != path[step - 1]
            .restrictions.moves.add((tick * cells + path[step]) * cells + path[step - 1])
    if permanent
        int goal = path[int(len(path)) - 1]
        int start = start_tick + int(len(path)) - 1
        match restrictions.permanent.get(goal)
            int previous
                if previous < start
                    start = previous
            none
                void
        .restrictions.permanent.set(goal, start)

bool search_before(SearchNode first, SearchNode second)
    if first.f != second.f
        return first.f < second.f
    if first.g != second.g
        return first.g > second.g
    return first.number < second.number

void push_open(SearchNode[] &heap, SearchNode node)
    heap = heap.append(node)
    int position = int(len(heap)) - 1
    while position > 0
        int parent = (position - 1) / 2
        if not search_before(heap[position], heap[parent])
            break
        SearchNode temporary = heap[parent]
        heap[parent] = heap[position]
        heap[position] = temporary
        position = parent

SearchNode pop_open(SearchNode[] &heap)
    SearchNode result = heap[0]
    int last = int(len(heap)) - 1
    SearchNode replacement = heap[last]
    heap = heap[0:<last]
    if last > 0
        heap[0] = replacement
        int position = 0
        while position * 2 + 1 < last
            int child = position * 2 + 1
            if child + 1 < last and search_before(heap[child + 1], heap[child])
                child += 1
            if not search_before(heap[child], heap[position])
                break
            SearchNode temporary = heap[position]
            heap[position] = heap[child]
            heap[child] = temporary
            position = child
    return result

SearchResult search_path(grid_map.Grid grid, grid_map.Agent agent, int[] distances, int start, int start_tick, Prohibitions restrictions, int maximum_tick, Budget &budget, bool window = false)
    budget.searches += 1
    int beginning = budget.expansions
    int arrival = arrival_allowed(restrictions, agent.goal)
    SearchNode root = SearchNode(start, start_tick, distances[start], 0, 0, -1)
    SearchNode[] heap = [root]
    SearchNode[] generated = [root]
    set.Set<int> seen = set.Set<int>()
    int cells = int(len(grid.free))
    .seen.add(start_tick * cells + start)
    while len(heap) > 0
        SearchNode current = pop_open(&heap)
        budget.expansions += 1
        int expanded = budget.expansions - beginning
        if budget.limit >= 0 and budget.expansions > budget.limit
            return SearchResult("aborted", [], expanded)
        if (current.cell == agent.goal and current.tick >= arrival) or (window and current.tick == maximum_tick)
            int[] reversed = []
            int cursor = current.number
            while cursor >= 0
                reversed = reversed.append(generated[cursor].cell)
                cursor = generated[cursor].parent
            return SearchResult("ok", reversed[::-1], expanded)
        if current.tick == maximum_tick
            continue
        for int destination = grid.destinations[current.cell][]
            int tick = current.tick + 1
            int key = tick * cells + destination
            if distances[destination] < 0 or seen.has(key) or not action_allowed(restrictions, current.cell, destination, tick)
                continue
            .seen.add(key)
            int number = int(len(generated))
            int g = tick - start_tick
            SearchNode node = SearchNode(destination, tick, g + distances[destination], g, number, current.number)
            generated = generated.append(node)
            push_open(&heap, node)
    return SearchResult("no_path", [], budget.expansions - beginning)
