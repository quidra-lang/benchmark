class Grid(int width, int height, string[] rows, bool[] free, int[][] destinations)
class Agent(int id, int start, int goal, string name)

string[] input_lines(string filename)
    string text = file.read("input/" + filename)
    string[] rows = text.split(NL)
    return rows[0:<int(len(rows)) - 1]

Grid read_grid()
    string[] rows = input_lines("map.txt")
    string[] dimensions = rows[0].split(" ")
    int width = int.parse(dimensions[0])
    int height = int.parse(dimensions[1])
    rows = rows[1:]
    bool[] free = []
    for int y < height
        for int x < width
            free = free.append(rows[y][x] == ".")
    int[][] destinations = []
    int[] dx = [0, 0, 1, 0, -1]
    int[] dy = [0, -1, 0, 1, 0]
    for int cell < width * height
        int[] adjacent = []
        if free[cell]
            for int action < 5
                int x = cell % width + dx[action]
                int y = cell / width + dy[action]
                if x >= 0 and x < width and y >= 0 and y < height and free[y * width + x]
                    adjacent = adjacent.append(y * width + x)
        destinations = destinations.append(adjacent)
    return Grid(width, height, rows, free, destinations)

Agent[] read_agents(Grid grid)
    string[] rows = input_lines("agents.csv")
    Agent[] result = []
    string names = "ABCDEFGHIJKLMNOPQRST"
    for 1 <= int i < int(len(rows))
        string[] fields = rows[i].split(",")
        int id = int.parse(fields[0])
        int start = int.parse(fields[2]) * grid.width + int.parse(fields[1])
        int goal = int.parse(fields[4]) * grid.width + int.parse(fields[3])
        result = result.append(Agent(id, start, goal, names[id]))
    return result

int degree(Grid grid, int cell)
    return int(len(grid.destinations[cell])) - 1

int[] distance_table(Grid grid, int goal)
    int[] result = array(len(grid.free), fill = -1)
    result[goal] = 0
    int[] queue = [goal]
    int cursor = 0
    while cursor < int(len(queue))
        int current = queue[cursor]
        cursor += 1
        for int adjacent = grid.destinations[current][]
            if result[adjacent] < 0
                result[adjacent] = result[current] + 1
                queue = queue.append(adjacent)
    return result
