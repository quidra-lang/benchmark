import signals = "./signals.qui"

int energy(int[] samples)
    int result = 0
    for int value = samples[]
        result += value * value
    return result

int isqrt(int value)
    if value == 0
        return 0
    int root = value
    int next = (root + 1) / 2
    while next < root
        root = next
        next = (root + value / root) / 2
    return root

int rms(int[] samples)
    return isqrt(energy(samples) / int(len(samples)))

int zero_crossings(int[] samples)
    int result = 0
    for 1 <= int index < int(len(samples))
        if (samples[index - 1] < 0) != (samples[index] < 0)
            result += 1
    return result

int count_clipped(int[] samples)
    int result = 0
    for int value = samples[]
        if value == -32768 or value == 32767
            result += 1
    return result

int gcd(int first, int second)
    int left = first
    int right = second
    while right > 0
        int remainder = left % right
        left = right
        right = remainder
    return left

string crest_fraction(int[] samples)
    int denominator = energy(samples)
    if denominator == 0
        return "none"
    int amplitude = signals.peak(samples)
    int numerator = amplitude * amplitude * int(len(samples))
    int divisor = gcd(numerator, denominator)
    return "{numerator / divisor}/{denominator / divisor}"

int autocorrelation(int[] samples, int lag)
    int result = 0
    for int index < int(len(samples)) - lag
        result += samples[index] * samples[index + lag]
    return result

int pitch_lag(int[] samples, int low, int high)
    int best = low
    int value = autocorrelation(samples, low)
    for low + 1 <= int lag <= high
        int current = autocorrelation(samples, lag)
        if current > value
            best = lag
            value = current
    return if value > 0 then best else 0
