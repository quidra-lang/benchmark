int magnitude(int value)
    return if value < 0 then -value else value

int minimum(int first, int second)
    return if first < second then first else second

int maximum(int first, int second)
    return if first > second then first else second

int floor_div(int numerator, int denominator)
    int upper = numerator
    int lower = denominator
    if lower < 0
        upper = -upper
        lower = -lower
    if upper >= 0
        return upper / lower
    return -((-upper + lower - 1) / lower)

int rdiv(int numerator, int denominator)
    return floor_div(2 * numerator + denominator, 2 * denominator)

int saturate(int value, int &clips)
    int limited = maximum(-32768, minimum(32767, value))
    if limited != value
        clips += 1
    return limited

int peak(int[] samples)
    int result = 0
    for int value = samples[]
        result = maximum(result, magnitude(value))
    return result

int sum_samples(int[] samples)
    int result = 0
    for int value = samples[]
        result += value
    return result

class Signal(string name, int rate, int[] samples, string origin = "input", int[] ingredients = [])

class Processed(int[] samples, int clipped)

Signal[] read_signals()
    string text = file.read("input/signals.txt")
    string[] lines = text.split(NL)
    Signal[] result = []
    int index = 0
    while index < int(len(lines)) and lines[index] != ""
        string[] header = lines[index].split(" ")
        int count = int.parse(header[3])
        index += 1
        int[] samples = []
        while int(len(samples)) < count
            for string token = lines[index].split(" ")[]
                samples = samples.append(int.parse(token))
            index += 1
        result = result.append(Signal(header[1], int.parse(header[2]), samples))
    return result

string[] format_signal(Signal signal)
    string[] lines = ["SIGNAL {signal.name} {signal.rate} {len(signal.samples)}"]
    for int start < int(len(signal.samples)) step 16
        int end = minimum(start + 16, int(len(signal.samples)))
        string[] values = []
        for start <= int index < end
            values = values.append(signal.samples[index].string())
        lines = lines.append(values.join(" "))
    return lines

int[] impulse(int count, int position, int amplitude)
    int[] result = array(nat(count), fill = 0)
    result[position] = amplitude
    return result

int[] step(int count, int position, int amplitude)
    int[] result = array(nat(count), fill = 0)
    for position <= int index < count
        result[index] = amplitude
    return result

int[] noise(int count, int seed)
    int state = seed
    int[] result = []
    for int index < count
        state = (48271 * state) % 2147483647
        result = result.append(state % 65536 - 32768)
    return result
