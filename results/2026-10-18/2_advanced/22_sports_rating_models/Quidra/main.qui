import math
import season = "./season.qui"
import elo_model = "./elo.qui"
import linear = "./linear_models.qui"
import iterative = "./iterative_models.qui"
import assessment = "./evaluation.qui"
import report = "./report.qui"

const string[] comparison_names = ["standings", "elo", "colley", "massey", "bt", "od", "winpct", "rpi", "pythag"]
const string[] prediction_names = ["base", "elo", "colley", "massey", "bt", "od", "winpct", "ensemble"]
const string[] link_names = ["colley", "massey", "od", "winpct"]
const int[] link_positions = [2, 3, 5, 6]

real64 mean(real64[] values)
    real64 total = 0.0
    for real64 value = values[]
        total += value
    return total / real64(len(values))

real exact_sum(real[] values)
    real total = real(0)
    for real value = values[]
        total += value
    return total

int[] ordered(real[] values, bool descending = false, int[] tiebreaks = [])
    int[] result = []
    for int index < int(len(values))
        int position = int(len(result))
        result = result.append(index)
        while position > 0
            int previous = result[position - 1]
            bool before = if descending then values[index] > values[previous] else values[index] < values[previous]
            if values[index] == values[previous] and len(tiebreaks) > 0
                before = tiebreaks[index] < tiebreaks[previous]
            if not before
                break
            result[position] = previous
            position -= 1
        result[position] = index
    return result

int[] competition_ranks(real[] values)
    int[] result = []
    for real value = values[]
        int rank = 1
        for real other = values[]
            if other > value
                rank += 1
        result = result.append(rank)
    return result

string result_letter(int scored, int conceded)
    return if scored > conceded then "W" elif scored == conceded then "D" else "L"

string result_code(real y)
    return if y == real(1) then "H" elif y == real(0) then "A" else "D"

string[] join_parts(string[][] parts)
    string[] lines = []
    for string[] part = parts[]
        if len(lines) > 0
            lines = lines.append("")
        lines = lines.concat(part)
    return lines

class Appearance(season.Match game, local int team)
    bool home = game.home == team
    int opponent = if home then game.away else game.home
    int scored = if home then game.home_score else game.away_score
    int conceded = if home then game.away_score else game.home_score
    string letter = result_letter(scored, conceded)

Appearance[] appearances_of(int team, season.Match[] matches)
    return [for season.Match item = matches[] if item.home == team or item.away == team then Appearance(item, team)]

string record_text(Appearance[] appearances)
    int won = 0
    int drawn = 0
    int lost = 0
    for Appearance item = appearances[]
        if item.letter == "W"
            won += 1
        elif item.letter == "D"
            drawn += 1
        else
            lost += 1
    return "{won}-{drawn}-{lost}"

class Record()
    int played = 0
    int won = 0
    int drawn = 0
    int lost = 0
    int scored = 0
    int conceded = 0
    int points = 0

    void .add(int score, int against, season.Settings config)
        played += 1
        scored += score
        conceded += against
        if score > against
            won += 1
            points += config.win_points
        elif score == against
            drawn += 1
            points += config.draw_points
        else
            lost += 1

    int difference()
        return scored - conceded

    real win_percentage()
        return real(2 * won + drawn) / real(2 * played)

Record[] team_records(int team_count, season.Match[] matches, season.Settings settings)
    Record[] records = [for int index = (0:<team_count)[] then Record()]
    for season.Match item = matches[]
        .records[item.home].add(item.home_score, item.away_score, settings)
        .records[item.away].add(item.away_score, item.home_score, settings)
    return records

class Standings(local int count, local season.Match[] schedule, local season.Settings config)
    Record[] records = team_records(count, schedule, config)
    int[] h2h_points = int[nat(count)](0)
    int[] h2h_difference = int[nat(count)](0)
    int[] order = []
    int[] positions = int[nat(count)](0)
    for season.Match item = schedule[]
        if records[item.home].points == records[item.away].points
            h2h_difference[item.home] += item.margin
            h2h_difference[item.away] -= item.margin
            if item.margin > 0
                h2h_points[item.home] += config.win_points
            elif item.margin < 0
                h2h_points[item.away] += config.win_points
            else
                h2h_points[item.home] += config.draw_points
                h2h_points[item.away] += config.draw_points
    for int index < count
        int place = int(len(order))
        order = order.append(index)
        while place > 0 and precedes(index, order[place - 1])
            order[place] = order[place - 1]
            place -= 1
        order[place] = index
    for int place < count
        positions[order[place]] = place + 1

    bool precedes(int first_team, int second_team)
        int[] first_values = [records[first_team].points, h2h_points[first_team], h2h_difference[first_team], records[first_team].difference(), records[first_team].scored]
        int[] second_values = [records[second_team].points, h2h_points[second_team], h2h_difference[second_team], records[second_team].difference(), records[second_team].scored]
        for int key < int(len(first_values))
            if first_values[key] != second_values[key]
                return first_values[key] > second_values[key]
        return first_team < second_team

    int[][] tied_groups()
        int[][] groups = []
        for int member = order[]
            int last = int(len(groups)) - 1
            if last >= 0 and records[groups[last][0]].points == records[member].points
                groups[last] = groups[last].append(member)
            else
                groups = groups.append([member])
        return [for int[] group = groups[] if len(group) > 1 then group]

class Streak(int length, int first, int last)

Streak longest_streak(Appearance[] appearances, string letters)
    auto best = Streak(0, 0, 0)
    int start = 0
    int length = 0
    for int index < int(len(appearances))
        Appearance item = appearances[index]
        if not letters.contains(item.letter)
            length = 0
            continue
        if length == 0
            start = index
        length += 1
        if length > best.length
            best = Streak(length, appearances[start].game.round, item.game.round)
    return best

string current_streak(Appearance[] appearances)
    string last = appearances[int(len(appearances)) - 1].letter
    int count = 0
    for Appearance item = appearances[::-1][]
        if item.letter != last
            break
        count += 1
    return "{last}{count}"

class ModelFit(local int count, local season.Match[] schedule, local season.Settings config)
    elo_model.EloRun elo_run = elo_model.run_elo(count, schedule, config.elo_k, config.elo_home, config.elo_initial)
    real64[] colley = linear.colley_ratings(count, schedule)
    local linear.Massey fitted_massey = linear.massey_ratings(count, schedule)
    real64[] massey = fitted_massey.ratings
    real64 home_advantage = fitted_massey.home_advantage
    local iterative.BradleyTerry fitted_bt = iterative.bradley_terry(count, schedule, config.bt_iterations)
    real64[] strengths = fitted_bt.strengths
    real64 home_factor = fitted_bt.home_factor
    local iterative.OffenseDefense fitted_od = iterative.offense_defense(count, schedule, config.od_iterations)
    real64[] offense = fitted_od.offense
    real64[] defense = fitted_od.defense
    real64[] od = fitted_od.ratings
    real[] win_percentages = [for Record item = team_records(count, schedule, config)[] then item.win_percentage()]

    real64 feature(int model_index, season.Match item)
        if model_index == 0
            return colley[item.home] - colley[item.away]
        if model_index == 1
            return massey[item.home] - massey[item.away]
        if model_index == 2
            return math.log(od[item.home]) - math.log(od[item.away])
        return real64(win_percentages[item.home]) - real64(win_percentages[item.away])

    real64 bt_probability(season.Match item)
        real64 home = home_factor * strengths[item.home]
        return home / (home + strengths[item.away])

    real64 predicted_margin(season.Match item)
        return massey[item.home] - massey[item.away] + home_advantage

class Prediction(season.Match game, real64[] probabilities, real64 margin_error)
    real64[] losses = [for real64 p = probabilities[] then assessment.log_loss(p, game.y)]
    real64[] briers = [for real64 p = probabilities[] then assessment.brier_score(p, game.y)]
    real[] correctness_scores = [for real64 p = probabilities[] then assessment.correctness(p, game.y)]

class ValidationRound(int number, local int count, local season.Match[] schedule, local season.Settings config)
    season.Match[] training = season.matches_before(schedule, number)
    ModelFit fitted = ModelFit(count, training, config)
    local real[] results = [for season.Match item = training[] then item.y]
    real64 base = real64(exact_sum(results) / real(len(results)))
    assessment.Link[] links = []
    Prediction[] predictions = []
    for int model_index < 4
        real64[] features = [for season.Match item = training[] then fitted.feature(model_index, item)]
        links = links.append(assessment.fit_link(features, results, config.link_iterations))
    for season.Match item = schedule[]
        if item.round == number
            predictions = predictions.append(predict(item, config))

    Prediction predict(season.Match item, season.Settings parameters)
        real64[] probabilities = real64[8](0.0)
        probabilities[0] = base
        probabilities[1] = elo_model.expected_score(fitted.elo_run.ratings[item.home], fitted.elo_run.ratings[item.away], real64(parameters.elo_home))
        for int model_index < 4
            assessment.Link link = links[model_index]
            probabilities[link_positions[model_index]] = assessment.sigma(link.alpha + link.beta * fitted.feature(model_index, item))
        probabilities[4] = fitted.bt_probability(item)
        real64 total = 0.0
        for 1 <= int index <= 6
            total += probabilities[index]
        probabilities[7] = total / 6.0
        return Prediction(item, probabilities, real64(item.margin) - fitted.predicted_margin(item))

class ModelScores(local Prediction[] items)
    real64[] losses = []
    real64[] briers = []
    real64[] skills = []
    real[] accuracies = []
    int[] loss_ranking = []
    int[] brier_ranking = []
    int[] accuracy_ranking = []
    for int index < 8
        losses = losses.append(mean([for Prediction item = items[] then item.losses[index]]))
        briers = briers.append(mean([for Prediction item = items[] then item.briers[index]]))
        skills = skills.append(1.0 - briers[index] / briers[0])
        accuracies = accuracies.append(exact_sum([for Prediction item = items[] then item.correctness_scores[index]]) / real(len(items)))
    loss_ranking = ordered([for real64 value = losses[] then report.decimal_value(value, 4)])
    brier_ranking = ordered([for real64 value = briers[] then report.decimal_value(value, 4)])
    accuracy_ranking = ordered(accuracies, true)

class Projection(local int count, local season.Match[] schedule, local season.Settings config)
    local season.Match[] played_matches = season.matches_before(schedule, config.holdout_round)
    Standings current = Standings(count, played_matches, config)
    real64[] ratings = elo_model.run_elo(count, played_matches, config.elo_k, config.elo_home, config.elo_initial).ratings
    season.Match[] remaining = [for season.Match item = schedule[] if item.round >= config.holdout_round then item]
    int[] total_points = int[nat(count)](0)
    int[] titles = int[nat(count)](0)
    int[] tops = int[nat(count)](0)
    int[] bottoms = int[nat(count)](0)
    int[] order = []
    int[] ranks = int[nat(count)](0)
    local real64[] probabilities = [for season.Match item = remaining[] then elo_model.expected_score(ratings[item.home], ratings[item.away], real64(config.elo_home))]
    local int generator_state = config.seed
    for int simulation < config.simulations
        int[] points = [for Record item = current.records[] then item.points]
        for int index < int(len(remaining))
            season.Match item = remaining[index]
            generator_state = 48271 * generator_state % 2147483647
            real64 uniform = real64(generator_state) / 2147483647.0
            int winner = if uniform < probabilities[index] then item.home else item.away
            points[winner] += config.win_points
        int[] simulated_order = ordered([for int value = points[] then real(value)], true, current.positions)
        for int place < count
            int team = simulated_order[place]
            total_points[team] += points[team]
            if place == 0
                titles[team] += 1
            if place < config.top_positions
                tops[team] += 1
            if place >= count - config.bottom_positions
                bottoms[team] += 1
    order = ordered([for int value = total_points[] then real(value)], true, current.positions)
    for int place < count
        ranks[order[place]] = place + 1

    real64 opponent_strength(int team)
        real64[] values = []
        for season.Match item = remaining[]
            if item.home == team
                values = values.append(ratings[item.away])
            elif item.away == team
                values = values.append(ratings[item.home])
        return mean(values)

real opponent_average(Appearance[] appearances, real[] values)
    real total = real(0)
    for Appearance item = appearances[]
        total += values[item.opponent]
    return total / real(len(appearances))

class LeagueAnalysis(local season.Season source)
    season.Team[] teams = source.teams
    season.Match[] matches = source.matches
    season.Settings settings = source.settings
    int team_count = int(len(teams))
    int final_round = matches[int(len(matches)) - 1].round
    Appearance[][] appearances = [for season.Team team = teams[] then appearances_of(team.index, matches)]
    Standings final_table = Standings(team_count, matches, settings)
    ModelFit fitted = ModelFit(team_count, matches, settings)
    Standings[] round_tables = [for int number = (1:final_round)[] then Standings(team_count, season.matches_before(matches, number + 1), settings)]
    Streak[] win_streaks = [for Appearance[] items = appearances[] then longest_streak(items, "W")]
    Streak[] unbeaten_streaks = [for Appearance[] items = appearances[] then longest_streak(items, "WD")]
    real[] sos = [for Appearance[] items = appearances[] then opponent_average(items, fitted.win_percentages)]
    real[] sos2 = [for Appearance[] items = appearances[] then opponent_average(items, sos)]
    real[] rpi = [for int index = (0:<team_count)[] then (fitted.win_percentages[index] + real(2) * sos[index] + sos2[index]) / real(4)]
    real64[] pythag = [for Record item = final_table.records[] then 1.0 / (1.0 + (real64(item.conceded) / real64(item.scored)) ^ settings.pythagorean_exponent)]
    real64[] luck = [for int index = (0:<team_count)[] then real64(fitted.win_percentages[index]) - pythag[index]]
    real[][] comparison = [
        [for int position = final_table.positions[] then real(-position)],
        [for real64 value = fitted.elo_run.ratings[] then report.decimal_value(value, 2)],
        [for real64 value = fitted.colley[] then report.decimal_value(value, 4)],
        [for real64 value = fitted.massey[] then report.decimal_value(value, 4)],
        [for real64 value = fitted.strengths[] then report.decimal_value(value, 4)],
        [for real64 value = fitted.od[] then report.decimal_value(value, 2)],
        fitted.win_percentages,
        rpi,
        [for real64 value = pythag[] then report.decimal_value(value, 4)]
    ]
    int[][] model_ranks = [for real[] values = comparison[1:<7][] then competition_ranks(values)]
    ValidationRound[] rounds = [for int number = (settings.holdout_round:final_round)[] then ValidationRound(number, team_count, matches, settings)]
    Prediction[] predictions = []
    for ValidationRound validation = rounds[]
        predictions = predictions.concat(validation.predictions)
    ModelScores scores = ModelScores(predictions)
    Projection projection = Projection(team_count, matches, settings)

    string code(int team)
        return teams[team].code

    string[] standings_lines()
        string[] lines = ["pos,team,name,played,won,drawn,lost,scored,conceded,diff,points,home,away,form,streak,close,longest_win,longest_unbeaten,winpct,sos,sos2,rpi,pythag,luck"]
        for int team = final_table.order[]
            Record item = final_table.records[team]
            Appearance[] played = appearances[team]
            Appearance[] home = [for Appearance entry = played[] if entry.home then entry]
            Appearance[] away = [for Appearance entry = played[] if not entry.home then entry]
            Appearance[] close = [for Appearance entry = played[] if math.abs(entry.scored - entry.conceded) <= settings.close_margin then entry]
            string form = [for Appearance entry = played[int(len(played)) - settings.form_length:<len(played)][] then entry.letter].join("")
            string[] fields = [
                "{final_table.positions[team]}", code(team), teams[team].name, "{item.played}", "{item.won}", "{item.drawn}", "{item.lost}", "{item.scored}", "{item.conceded}", "{item.difference()}", "{item.points}",
                record_text(home), record_text(away), form, current_streak(played), record_text(close), "{win_streaks[team].length}", "{unbeaten_streaks[team].length}",
                report.fraction_text(fitted.win_percentages[team]), report.fixed(sos[team]), report.fixed(sos2[team]), report.fixed(rpi[team]), report.fixed(pythag[team]), report.fixed(luck[team])
            ]
            lines = lines.append(fields.join(","))
        return lines

    string[] ratings_lines()
        int[] totals = []
        for int team < team_count
            int total = 0
            for int[] values = model_ranks[]
                total += values[team]
            totals = totals.append(total)
        int[] consensus_order = ordered([for int value = totals[] then real(value)])
        string[] lines = ["team,elo,elo_rank,colley,colley_rank,massey,massey_rank,bt,bt_rank,offense,defense,od,od_rank,winpct,winpct_rank,consensus,best_rank,worst_rank"]
        for int team = consensus_order[]
            int[] ranks = [for int[] values = model_ranks[] then values[team]]
            string[] fields = [
                code(team), report.fixed(fitted.elo_run.ratings[team], 2), "{ranks[0]}", report.fixed(fitted.colley[team]), "{ranks[1]}", report.fixed(fitted.massey[team]), "{ranks[2]}",
                report.fixed(fitted.strengths[team]), "{ranks[3]}", report.fixed(fitted.offense[team], 2), report.fixed(fitted.defense[team]), report.fixed(fitted.od[team], 2), "{ranks[4]}",
                report.fixed(fitted.win_percentages[team]), "{ranks[5]}", "{totals[team]}", "{math.min_all(ranks)}", "{math.max_all(ranks)}"
            ]
            lines = lines.append(fields.join(","))
        return lines

    string[] history_lines()
        string[] lines = ["round,team,elo,change,elo_rank,points,position"]
        real64[] previous = real64[nat(team_count)](real64(settings.elo_initial))
        for int index < final_round
            Standings table = round_tables[index]
            real64[] ratings = fitted.elo_run.round_ratings[index]
            int[] ranks = competition_ranks([for real64 value = ratings[] then report.decimal_value(value, 2)])
            for int team < team_count
                lines = lines.append(["{index + 1}", code(team), report.fixed(ratings[team], 2), report.fixed(ratings[team] - previous[team], 2), "{ranks[team]}", "{table.records[team].points}", "{table.positions[team]}"].join(","))
            previous = ratings
        return lines

    string[] summary_lines()
        real[] results = [for season.Match item = matches[] then item.y]
        int home_won = 0
        int drawn = 0
        int home_lost = 0
        for real y = results[]
            if y == real(1)
                home_won += 1
            elif y == real(0)
                home_lost += 1
            else
                drawn += 1
        real rate = exact_sum(results) / real(len(results))
        return [
            "season teams {team_count} matches {len(matches)} rounds {final_round}",
            "home won {home_won} drawn {drawn} lost {home_lost} rate {report.fraction_with_real(rate)}",
            "massey_home_advantage {report.fixed(fitted.home_advantage)}",
            "bt_home_factor {report.fixed(fitted.home_factor)}"
        ]

    string[] upset_lines()
        int[] candidates = []
        real64[] expectations = []
        for int index < int(len(matches))
            if matches[index].margin != 0
                candidates = candidates.append(index)
                expectations = expectations.append(if matches[index].margin > 0 then fitted.elo_run.expected[index] else 1.0 - fitted.elo_run.expected[index])
        int[] upset_order = ordered([for real64 value = expectations[] then report.decimal_value(value, 4)])
        string[] lines = ["upsets top {settings.upsets}"]
        for int position < math.min(settings.upsets, int(len(candidates)))
            int candidate = upset_order[position]
            int index = candidates[candidate]
            season.Match item = matches[index]
            bool home_win = item.margin > 0
            int winner = if home_win then item.home else item.away
            int loser = if home_win then item.away else item.home
            int winner_score = if home_win then item.home_score else item.away_score
            int loser_score = if home_win then item.away_score else item.home_score
            string side = if home_win then "home" else "away"
            lines = lines.append("round {item.round} {code(winner)} beat {code(loser)} {winner_score}-{loser_score} {side} expected {report.fixed(expectations[candidate])} gain {report.fixed(math.abs(fitted.elo_run.changes[index]), 2)}")
        return lines

    string[] tiebreak_lines()
        string[] lines = ["tiebreaks"]
        for int[] group = final_table.tied_groups()[]
            string[] team_codes = [for int team = group[] then code(team)]
            string[] group_points = [for int team = group[] then "{final_table.h2h_points[team]}"]
            string[] group_difference = [for int team = group[] then "{final_table.h2h_difference[team]}"]
            lines = lines.append("points {final_table.records[group[0]].points} order {team_codes.join(" ")} h2h_points {group_points.join(" ")} h2h_diff {group_difference.join(" ")}")
        if len(lines) == 1
            lines = lines.append("none")
        return lines

    string[] leader_lines()
        string[] lines = ["leaders"]
        int previous = -1
        int recorded = 0
        for int index < final_round
            Standings table = round_tables[index]
            int leader = table.order[0]
            if leader != previous
                lines = lines.append("round {index + 1} {code(leader)} points {table.records[leader].points}")
                recorded += 1
            previous = leader
        return lines.append("lead_changes {recorded - 1}")

    string[] streak_lines()
        string[] lines = []
        Streak[][] collections = [win_streaks, unbeaten_streaks]
        string[] labels = ["longest_win_streak", "longest_unbeaten_streak"]
        for int index < 2
            int longest = math.max_all([for Streak item = collections[index][] then item.length])
            for int team < team_count
                Streak streak = collections[index][team]
                if streak.length == longest
                    lines = lines.append("{labels[index]} {code(team)} length {streak.length} rounds {streak.first}-{streak.last}")
        return lines

    string[] crosstable_lines()
        int[] top = final_table.order[0:<settings.top_positions]
        string[] lines = ["crosstable top {settings.top_positions}", "team " + [for int team = top[] then code(team)].join(" ")]
        for int first_team = top[]
            string[] entries = []
            for int second_team = top[]
                Appearance[] meetings = [for Appearance item = appearances[first_team][] if item.opponent == second_team then item]
                entries = entries.append(if first_team == second_team then "-" else record_text(meetings))
            lines = lines.append(code(first_team) + " " + entries.join(" "))
        return lines

    string[] trajectory_lines()
        string[] lines = ["trajectories"]
        for int team < team_count
            real64[] ratings = [for real64[] snapshot = fitted.elo_run.round_ratings[] then snapshot[team]]
            real[] rounded = [for real64 value = ratings[] then report.decimal_value(value, 2)]
            int[] positions = [for Standings table = round_tables[] then table.positions[team]]
            int peak = 0
            int low = 0
            int best = 0
            int worst = 0
            for 1 <= int index < final_round
                if rounded[index] > rounded[peak]
                    peak = index
                if rounded[index] < rounded[low]
                    low = index
                if positions[index] < positions[best]
                    best = index
                if positions[index] > positions[worst]
                    worst = index
            lines = lines.append("{code(team)} elo_peak {report.fixed(ratings[peak], 2)} round {peak + 1} elo_low {report.fixed(ratings[low], 2)} round {low + 1} best_position {positions[best]} round {best + 1} worst_position {positions[worst]} round {worst + 1}")
        return lines

    string[] correlation_lines(bool spearman)
        string title = if spearman then "spearman" else "kendall"
        string[] lines = [title, "model " + comparison_names.join(" ")]
        for int first_model < 9
            string[] values = []
            for int second_model < 9
                real coefficient = if spearman then assessment.spearman_rho(comparison[first_model], comparison[second_model]) else assessment.kendall_tau(comparison[first_model], comparison[second_model])
                values = values.append(report.fraction_text(coefficient))
            lines = lines.append(comparison_names[first_model] + " " + values.join(" "))
        return lines

    string[] similarity_lines()
        int most_first = 0
        int most_second = 1
        int least_first = 0
        int least_second = 1
        real most = assessment.kendall_tau(comparison[0], comparison[1])
        real least = most
        for int first_model < 9
            for first_model + 1 <= int second_model < 9
                real coefficient = assessment.kendall_tau(comparison[first_model], comparison[second_model])
                if coefficient > most
                    most = coefficient
                    most_first = first_model
                    most_second = second_model
                if coefficient < least
                    least = coefficient
                    least_first = first_model
                    least_second = second_model
        return [
            "most_similar {comparison_names[most_first]} {comparison_names[most_second]} tau {report.fraction_with_real(most)}",
            "least_similar {comparison_names[least_first]} {comparison_names[least_second]} tau {report.fraction_with_real(least)}"
        ]

    string[] season_lines()
        return join_parts([summary_lines(), upset_lines(), tiebreak_lines(), leader_lines(), streak_lines(), crosstable_lines(), trajectory_lines(), correlation_lines(false), correlation_lines(true), similarity_lines()])

    string[] prediction_lines()
        string[] lines = ["round,home,away,home_score,away_score,result," + prediction_names.join(",")]
        for Prediction prediction = predictions[]
            season.Match item = prediction.game
            string[] fields = ["{item.round}", code(item.home), code(item.away), "{item.home_score}", "{item.away_score}", result_code(item.y)]
            fields = fields.concat([for real64 p = prediction.probabilities[] then report.fixed(p)])
            lines = lines.append(fields.join(","))
        return lines

    string[] link_lines()
        string[] lines = ["links"]
        for ValidationRound validation = rounds[]
            string[] parts = ["round {validation.number} train {len(validation.training)} base {report.fixed(validation.base)} bt_home {report.fixed(validation.fitted.home_factor)}"]
            for int index < 4
                assessment.Link link = validation.links[index]
                parts = parts.append("{link_names[index]} {report.fixed(link.alpha)} {report.fixed(link.beta)}")
            lines = lines.append(parts.join(" "))
        return lines

    string[] score_lines()
        string[] lines = ["scores", "model log_loss brier skill accuracy"]
        for int index < 8
            lines = lines.append("{prediction_names[index]} {report.fixed(scores.losses[index])} {report.fixed(scores.briers[index])} {report.fixed(scores.skills[index])} {report.fraction_with_real(scores.accuracies[index])}")
        int[][] rankings = [scores.loss_ranking, scores.brier_ranking, scores.accuracy_ranking]
        string[] labels = ["ranking_log_loss", "ranking_brier", "ranking_accuracy"]
        for int index < 3
            lines = lines.append(labels[index] + " " + [for int model_index = rankings[index][] then prediction_names[model_index]].join(" "))
        return lines

    string[] paired_lines()
        int reference = scores.loss_ranking[0]
        real64 sample_count = real64(len(predictions))
        string[] lines = ["paired_log_loss reference " + prediction_names[reference]]
        for int index < 8
            if index == reference
                continue
            real64[] deltas = [for Prediction item = predictions[] then item.losses[index] - item.losses[reference]]
            real64 average = mean(deltas)
            real64 squares = 0.0
            for real64 delta = deltas[]
                squares += (delta - average) * (delta - average)
            real64 spread = math.sqrt(squares / (sample_count - 1.0))
            real64 t_value = average / (spread / math.sqrt(sample_count))
            lines = lines.append("{prediction_names[index]} mean_diff {report.fixed(average)} sd {report.fixed(spread)} t {report.fixed(t_value, 2)}")
        return lines

    string[] margin_lines()
        real64[] errors = [for Prediction item = predictions[] then item.margin_error]
        real64 absolute = mean([for real64 value = errors[] then math.abs(value)])
        real64 root_squared = math.sqrt(mean([for real64 value = errors[] then value * value]))
        return ["massey_margin mae {report.fixed(absolute)} rmse {report.fixed(root_squared)} bias {report.fixed(mean(errors))}"]

    string[] round_loss_lines()
        string[] lines = ["round_log_loss", "round " + prediction_names.join(" ")]
        for ValidationRound validation = rounds[]
            string[] values = []
            for int index < 8
                values = values.append(report.fixed(mean([for Prediction item = validation.predictions[] then item.losses[index]])))
            lines = lines.append("{validation.number} " + values.join(" "))
        return lines

    string[] calibration_lines()
        int bins = settings.calibration_bins
        string[] lines = ["calibration bins {bins}"]
        for int index < 8
            Prediction[][] members = Prediction[][nat(bins)]([])
            for Prediction prediction = predictions[]
                int raw_bin = math.floor(real64(bins) * prediction.probabilities[index])
                int number = math.min(raw_bin + 1, bins)
                members[number - 1] = members[number - 1].append(prediction)
            for int number < bins
                Prediction[] group = members[number]
                string prefix = "{prediction_names[index]} bin {number + 1} count {len(group)} predicted "
                if len(group) == 0
                    lines = lines.append(prefix + "- observed -")
                else
                    real64 predicted = mean([for Prediction item = group[] then item.probabilities[index]])
                    real observed = exact_sum([for Prediction item = group[] then item.game.y]) / real(len(group))
                    lines = lines.append(prefix + report.fixed(predicted) + " observed " + report.fraction_text(observed))
        return lines

    string[] grid_lines()
        int[] validation_indices = [for int index = (0:<int(len(matches)))[] if matches[index].round >= settings.holdout_round then index]
        string[] headings = [for int home = settings.grid_home[] then "h{home}"]
        string[] lines = ["elo_grid", "k " + headings.join(" ")]
        bool found = false
        int best_k = 0
        int best_home = 0
        real64 best_loss = 0.0
        for int k_factor = settings.grid_k[]
            string[] row = ["{k_factor}"]
            for int home = settings.grid_home[]
                elo_model.EloRun run = elo_model.run_elo(team_count, matches, k_factor, home, settings.elo_initial)
                real64 loss = mean([for int index = validation_indices[] then assessment.log_loss(run.expected[index], matches[index].y)])
                row = row.append(report.fixed(loss))
                if not found or report.decimal_value(loss, 4) < report.decimal_value(best_loss, 4)
                    found = true
                    best_k = k_factor
                    best_home = home
                    best_loss = loss
            lines = lines.append(row.join(" "))
        return lines.append("best k {best_k} home {best_home} log_loss {report.fixed(best_loss)}")

    real projection_tau()
        real[] projected = [for int rank = projection.ranks[] then real(-rank)]
        real[] final_values = [for int position = final_table.positions[] then real(-position)]
        return assessment.kendall_tau(projected, final_values)

    string[] evaluation_lines()
        return join_parts([
            ["holdout rounds {settings.holdout_round}-{final_round} matches {len(predictions)}"],
            link_lines(), score_lines(), paired_lines(), margin_lines(), round_loss_lines(), calibration_lines(), grid_lines(),
            ["projection simulations {settings.simulations} kendall {report.fraction_with_real(projection_tau())}"]
        ])

    string[] projection_lines()
        real simulations = real(settings.simulations)
        string[] lines = ["projected,team,points_now,position_now,remaining_opponent_elo,expected_points,title,top,bottom,final_points,final_position"]
        for int team = projection.order[]
            string[] fields = [
                "{projection.ranks[team]}", code(team), "{projection.current.records[team].points}", "{projection.current.positions[team]}", report.fixed(projection.opponent_strength(team), 2),
                report.fixed(real(projection.total_points[team]) / simulations), report.fixed(real(projection.titles[team]) / simulations), report.fixed(real(projection.tops[team]) / simulations), report.fixed(real(projection.bottoms[team]) / simulations),
                "{final_table.records[team].points}", "{final_table.positions[team]}"
            ]
            lines = lines.append(fields.join(","))
        return lines

void analyze_league()
    auto analysis = LeagueAnalysis(season.load_season())
    bool directory_exists = file.is_directory("output")
    if not directory_exists
        file.mkdir("output")
    report.write_lines("standings.csv", analysis.standings_lines())
    report.write_lines("ratings.csv", analysis.ratings_lines())
    report.write_lines("history.csv", analysis.history_lines())
    report.write_lines("season.txt", analysis.season_lines())
    report.write_lines("predictions.csv", analysis.prediction_lines())
    report.write_lines("evaluation.txt", analysis.evaluation_lines())
    report.write_lines("projection.csv", analysis.projection_lines())

if main
    analyze_league()
