string fixed<T: numeric>(T value, int places = 4)
    string text = if places == 2 then "{value:frac=2}" else "{value:frac=4}"
    return if text == "-0.00" then "0.00" elif text == "-0.0000" then "0.0000" else text

real decimal_value(real64 value, int places)
    real result = real.parse(fixed(value, places))
    return result

string fraction_text(real value)
    string canonical = value.string()
    if canonical.contains("/")
        return canonical
    int denominator = 1
    string[] parts = canonical.split(".")
    if len(parts) > 1
        for int digit < int(len(parts[1]))
            denominator *= 10
    int numerator = int(value * real(denominator))
    int first = if numerator < 0 then -numerator else numerator
    int second = denominator
    while second != 0
        int remainder = first % second
        first = second
        second = remainder
    return "{numerator / first}/{denominator / first}"

string fraction_with_real(real value)
    return fraction_text(value) + " " + fixed(value)

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
