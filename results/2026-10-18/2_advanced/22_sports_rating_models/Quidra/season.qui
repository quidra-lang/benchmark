class Team(int index, string code, string name)

real match_result(int home_score, int away_score)
    return if home_score > away_score then real(1) elif home_score == away_score then real(1) / real(2) else real(0)

class Match(int round, int home, int away, int home_score, int away_score)
    int margin = home_score - away_score
    real y = match_result(home_score, away_score)

class Settings(local string[] rows)
    int win_points = int.parse(rows[0].split(" ")[1])
    int draw_points = int.parse(rows[1].split(" ")[1])
    int form_length = int.parse(rows[2].split(" ")[1])
    int close_margin = int.parse(rows[3].split(" ")[1])
    real64 pythagorean_exponent = real64.parse(rows[4].split(" ")[1])
    int elo_k = int.parse(rows[5].split(" ")[1])
    int elo_home = int.parse(rows[6].split(" ")[1])
    int elo_initial = int.parse(rows[7].split(" ")[1])
    int[] grid_k = [for string token = rows[8].split(" ")[1:<len(rows[8].split(" "))][] then int.parse(token)]
    int[] grid_home = [for string token = rows[9].split(" ")[1:<len(rows[9].split(" "))][] then int.parse(token)]
    int bt_iterations = int.parse(rows[10].split(" ")[1])
    int od_iterations = int.parse(rows[11].split(" ")[1])
    int link_iterations = int.parse(rows[12].split(" ")[1])
    int holdout_round = int.parse(rows[13].split(" ")[1])
    int upsets = int.parse(rows[14].split(" ")[1])
    int calibration_bins = int.parse(rows[15].split(" ")[1])
    int simulations = int.parse(rows[16].split(" ")[1])
    int seed = int.parse(rows[17].split(" ")[1])
    int top_positions = int.parse(rows[18].split(" ")[1])
    int bottom_positions = int.parse(rows[19].split(" ")[1])

Match[] matches_before(Match[] matches, int round_number)
    return [for Match item = matches[] if item.round < round_number then item]

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

class Season(Team[] teams, Match[] matches, Settings settings)

Season load_season()
    Team[] teams = []
    map.Map<string, int> indices
    string[] team_lines = read_lines("input/teams.csv")
    for string line = team_lines[1:<len(team_lines)][]
        string[] parts = line.split(",")
        int index = int(len(teams))
        .indices.set(parts[0], index)
        teams = teams.append(Team(index, parts[0], parts[1]))
    Match[] matches = []
    string[] match_lines = read_lines("input/matches.csv")
    for string line = match_lines[1:<len(match_lines)][]
        string[] parts = line.split(",")
        auto item = Match(int.parse(parts[0]), indices[parts[1]], indices[parts[2]], int.parse(parts[3]), int.parse(parts[4]))
        int position = int(len(matches))
        matches = matches.append(item)
        while position > 0 and matches[position - 1].round > item.round
            matches[position] = matches[position - 1]
            position -= 1
        matches[position] = item
    return Season(teams, matches, Settings(read_lines("input/params.txt")))
