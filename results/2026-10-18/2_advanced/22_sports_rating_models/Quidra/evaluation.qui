import math

real64 sigma(real64 value)
    return 1.0 / (1.0 + math.exp(-value))

class Link(real64 alpha, real64 beta)

Link fit_link(real64[] features, real[] results, int iterations)
    real64 alpha = 0.0
    real64 beta = 0.0
    for int iteration < iterations
        real64 g0 = 0.0
        real64 g1 = 0.0
        real64 h00 = 0.0
        real64 h01 = 0.0
        real64 h11 = 0.0
        for int index < int(len(features))
            real64 z = features[index]
            real64 p = sigma(alpha + beta * z)
            real64 w = p * (1.0 - p)
            real64 difference = real64(results[index]) - p
            g0 += difference
            g1 += difference * z
            h00 += w
            h01 += w * z
            h11 += w * z * z
        real64 det = h00 * h11 - h01 * h01
        real64 next_alpha = alpha + (h11 * g0 - h01 * g1) / det
        beta += (h00 * g1 - h01 * g0) / det
        alpha = next_alpha
    return Link(alpha, beta)

real64 log_loss(real64 p, real y)
    return if y == real(1) then -math.log(p) elif y == real(0) then -math.log(1.0 - p) else -(math.log(p) / 2.0 + math.log(1.0 - p) / 2.0)

real64 brier_score(real64 p, real y)
    real64 difference = p - real64(y)
    return difference * difference

real correctness(real64 p, real y)
    if y == real(1) / real(2)
        return y
    return if (p > 0.5 and y == real(1)) or (p < 0.5 and y == real(0)) then real(1) else real(0)

real[] average_ranks(real[] values)
    real[] ranks = []
    for real value = values[]
        int greater = 0
        int equal = 0
        for real other = values[]
            if other > value
                greater += 1
            if other == value
                equal += 1
        ranks = ranks.append(real(greater) + real(equal + 1) / real(2))
    return ranks

int direction(real first, real second)
    return if first > second then 1 elif first < second then -1 else 0

real kendall_tau(real[] first, real[] second)
    int count = int(len(first))
    int concordant = 0
    int discordant = 0
    for int t < count
        for t + 1 <= int u < count
            int agreement = direction(first[t], first[u]) * direction(second[t], second[u])
            if agreement > 0
                concordant += 1
            elif agreement < 0
                discordant += 1
    return real(concordant - discordant) / real(count * (count - 1) / 2)

real spearman_rho(real[] first, real[] second)
    int count = int(len(first))
    real[] first_ranks = average_ranks(first)
    real[] second_ranks = average_ranks(second)
    real squares = real(0)
    for int index < count
        real difference = first_ranks[index] - second_ranks[index]
        squares += difference * difference
    return real(1) - real(6) * squares / real(count * (count * count - 1))
