import math
import minstd = "./minstd.qui"
import entities = "./entities.qui"

class Room(int x, int y, int width, int height)
    int[] center()
        return [x + width / 2, y + height / 2]

class Node(int x, int y, int width, int height)
    int first = -1
    int second = -1
    int leaf = -1

class Level(int depth, int width, int height)
    string[][] terrain = array(nat(height), fill = array(nat(width), fill = " "))
    string[][] memory = array(nat(height), fill = array(nat(width), fill = " "))
    Room[] rooms = []
    int[] arrival = [0, 0]
    int arrival_room = 0
    int[] target = [0, 0]
    entities.Monster[] monsters = []
    entities.Item[] items = []
    int monsters_created = 0
    int items_placed = 0
    int kills = 0
    int picked = 0

    int monster_at(int x, int y)
        for int index < int(len(monsters))
            if monsters[index].x == x and monsters[index].y == y
                return index
        return -1

    int item_at(int x, int y)
        for int index < int(len(items))
            if items[index].x == x and items[index].y == y
                return index
        return -1

    int[] draw_interior_cell(minstd.Generator &generator, int index)
        Room room = rooms[index]
        int x = room.x + 1 + .generator.rnd(room.width - 2)
        int y = room.y + 1 + .generator.rnd(room.height - 2)
        return [x, y]

    (int, int[]) draw_room_cell(minstd.Generator &generator)
        int index = .generator.rnd(int(len(rooms)))
        int[] position = draw_interior_cell(&generator, index)
        return (index, position)

void split(Node[] &nodes, int current, int depth, int min_size, int max_split, int[] &leaves, minstd.Generator &generator)
    Node region = nodes[current]
    bool vertical_fits = region.width >= 2 * min_size
    bool horizontal_fits = region.height >= 2 * min_size
    if depth == max_split or not (vertical_fits or horizontal_fits)
        nodes[current].leaf = int(len(leaves))
        leaves = leaves.append(current)
        return
    bool vertical = vertical_fits
    if vertical_fits and horizontal_fits
        if 4 * region.width >= 5 * region.height
            vertical = true
        elif 4 * region.height >= 5 * region.width
            vertical = false
        else
            vertical = .generator.draw() % 2 == 0
    int first = int(len(nodes))
    int second = first + 1
    if vertical
        int cut = min_size + .generator.rnd(region.width - 2 * min_size + 1)
        nodes = nodes.append(Node(region.x, region.y, cut, region.height))
        nodes = nodes.append(Node(region.x + cut, region.y, region.width - cut, region.height))
    else
        int cut = min_size + .generator.rnd(region.height - 2 * min_size + 1)
        nodes = nodes.append(Node(region.x, region.y, region.width, cut))
        nodes = nodes.append(Node(region.x, region.y + cut, region.width, region.height - cut))
    nodes[current].first = first
    nodes[current].second = second
    split(&nodes, first, depth + 1, min_size, max_split, &leaves, &generator)
    split(&nodes, second, depth + 1, min_size, max_split, &leaves, &generator)

Room make_room(Level &level, Node region, int room_min, int room_max, minstd.Generator &generator)
    int width = room_min + .generator.rnd(math.min(room_max, region.width - 1) - room_min + 1)
    int height = room_min + .generator.rnd(math.min(room_max, region.height - 1) - room_min + 1)
    int x = region.x + .generator.rnd(region.width - width)
    int y = region.y + .generator.rnd(region.height - height)
    for y <= int row < y + height
        for x <= int column < x + width
            level.terrain[row][column] = if row == y or row == y + height - 1 then "-" elif column == x or column == x + width - 1 then "|" else "."
    return Room(x, y, width, height)

void dig_cell(Level &level, int x, int y)
    if level.terrain[y][x] == " "
        level.terrain[y][x] = "#"
    elif level.terrain[y][x] == "-" or level.terrain[y][x] == "|"
        level.terrain[y][x] = "+"

void dig(Level &level, int[] start, int[] end, bool horizontal_first)
    if horizontal_first
        for int x = (start[0]:end[0])[]
            dig_cell(&level, x, start[1])
        for int y = (start[1]:end[1])[]
            dig_cell(&level, end[0], y)
    else
        for int y = (start[1]:end[1])[]
            dig_cell(&level, start[0], y)
        for int x = (start[0]:end[0])[]
            dig_cell(&level, x, end[1])

int[] connect(Level &level, Node[] nodes, int current, minstd.Generator &generator)
    Node region = nodes[current]
    if region.leaf >= 0
        return [region.leaf]
    int[] first = connect(&level, nodes, region.first, &generator)
    int[] second = connect(&level, nodes, region.second, &generator)
    int best_a = -1
    int best_b = -1
    int best_distance = 0
    for int a = first[]
        int[] from = level.rooms[a].center()
        for int b = second[]
            int[] to = level.rooms[b].center()
            int distance = math.abs(from[0] - to[0]) + math.abs(from[1] - to[1])
            if best_a < 0 or distance < best_distance
                best_a = a
                best_b = b
                best_distance = distance
    bool horizontal_first = .generator.draw() % 2 == 0
    dig(&level, level.rooms[best_a].center(), level.rooms[best_b].center(), horizontal_first)
    return first.concat(second)

Level generate(minstd.Generator &generator, int depth, int width, int height, int min_size, int max_split, int room_min, int room_max)
    auto level = Level(depth, width, height)
    Node[] nodes = [Node(0, 0, width, height)]
    int[] leaves = []
    split(&nodes, 0, 0, min_size, max_split, &leaves, &generator)
    for int id = leaves[]
        Room room = make_room(&level, nodes[id], room_min, room_max, &generator)
        level.rooms = level.rooms.append(room)
    connect(&level, nodes, 0, &generator)
    (int arrival_room, int[] arrival) = level.draw_room_cell(&generator)
    level.arrival_room = arrival_room
    level.arrival = arrival
    level.terrain[arrival[1]][arrival[0]] = "<"
    int other = .generator.rnd(int(len(level.rooms)) - 1)
    if other >= arrival_room
        other += 1
    level.target = level.draw_interior_cell(&generator, other)
    return level
