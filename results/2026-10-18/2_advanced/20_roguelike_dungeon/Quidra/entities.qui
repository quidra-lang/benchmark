import combat = "./combat.qui"

class MonsterType(local string[] tokens)
    string name = tokens[0]
    string symbol = tokens[1]
    int min_depth = int.parse(tokens[2])
    int max_depth = int.parse(tokens[3])
    int weight = int.parse(tokens[4])
    combat.Dice hp = combat.parse_dice(tokens[5])
    int to_hit = int.parse(tokens[6])
    int defense = int.parse(tokens[7])
    combat.Dice damage = combat.parse_dice(tokens[8])
    int speed = int.parse(tokens[9])
    int xp = int.parse(tokens[10])
    bool erratic = tokens[11].contains("E")
    bool stationary = tokens[11].contains("S")
    bool regenerates = tokens[11].contains("R")
    bool poisonous = tokens[11].contains("P")

class ItemType(string category, string name, int min_depth, int max_depth, int weight)
    combat.Dice dice = combat.Dice(1, 1)
    int to_hit = 0
    int armor = 0
    string effect = ""
    int poison_turns = 0
    int nutrition = 0

ItemType parse_item_type(string[] tokens)
    auto kind = ItemType(tokens[0], tokens[1], int.parse(tokens[2]), int.parse(tokens[3]), int.parse(tokens[4]))
    if kind.category == "weapon"
        kind.dice = combat.parse_dice(tokens[5])
        kind.to_hit = int.parse(tokens[6])
    elif kind.category == "armor"
        kind.armor = int.parse(tokens[5])
    elif kind.category == "potion"
        kind.effect = tokens[5]
        if kind.effect == "heal"
            kind.dice = combat.parse_dice(tokens[6])
        elif kind.effect == "poison"
            kind.poison_turns = int.parse(tokens[6])
    elif kind.category == "scroll"
        kind.effect = tokens[5]
    elif kind.category == "food"
        kind.nutrition = int.parse(tokens[5])
    elif kind.category == "gold"
        kind.dice = combat.parse_dice(tokens[5])
    return kind

class Monster(int number, MonsterType kind, int type_index, int x, int y, int hp, bool asleep)
    int max_hp = hp
    int energy = 0
    bool was_visible = false

class Item(int identity, ItemType kind, int x, int y, int amount = 0)
    int bonus = 0

    string symbol()
        return if kind.category == "weapon" then ")" elif kind.category == "armor" then "[" elif kind.category == "potion" then "!" elif kind.category == "scroll" then "?" elif kind.category == "food" then "%" elif kind.category == "gold" then "$" else DQ

    string display_name()
        string plain = kind.name.split("_").join(" ")
        if kind.category == "weapon" or kind.category == "armor"
            return "+{bonus} {plain}"
        if kind.category == "gold"
            return "{amount} gold"
        return plain

    string reference_name()
        return if kind.category == "gold" then display_name() else "the " + display_name()
