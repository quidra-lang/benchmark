import math

class Generator(int state)
    int .draw()
        state = (48271 * state) % 2147483647
        return state

    int .rnd(int bound)
        return .draw() % bound

    int .roll(int count, int sides)
        int total = 0
        for int index < count
            total += 1 + .rnd(sides)
        return total

    int .select(int[] weights)
        int choice = .draw() % math.sum(weights)
        int cumulative = 0
        for int index < int(len(weights))
            cumulative += weights[index]
            if choice < cumulative
                return index
        return int(len(weights)) - 1
