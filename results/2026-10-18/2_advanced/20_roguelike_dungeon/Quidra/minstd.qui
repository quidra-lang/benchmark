class Generator(int state)
    int .draw()
        state = (48271 * state) % 2147483647
        return state

    int .rnd(int bound)
        return .draw() % bound

    int .roll(int count, int sides)
        total := 0
        for: index < count
            total += 1 + .rnd(sides)
        return total

    int .select(int[] weights)
        choice := .draw() % weights.sum()
        cumulative := 0
        for: index < int(weights.len())
            cumulative += weights[index]
            if choice < cumulative
                return index
        return int(weights.len()) - 1
