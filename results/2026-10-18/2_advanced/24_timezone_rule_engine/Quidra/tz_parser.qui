import calendar = "./day_rules.qui"

string line_content(string raw)
    content := raw.split("#")[0]
    end := int(content.len())
    while end > 0 and content[end - 1] == " "
        end -= 1
    return content[0:<end]

bool is_continuation(string content)
    return content.starts_with(" ")

string[] split_fields(string content)
    return [for field := content.split(" ")[] if field != "" then field]

bool is_number(string text, int minimum, int maximum)
    if not (minimum <= int(text.len()) <= maximum)
        return false
    for code := text.codepoints()[]
        if not (48 <= code <= 57)
            return false
    return true

int | none hms_value(string text, maximum_parts := 3)
    parts := text.split(":")
    if int(parts.len()) > maximum_parts or not is_number(parts[0], 1, 2)
        return none
    int result := int(parts[0]) * 3600
    for: 1 <= index < int(parts.len())
        if not is_number(parts[index], 2, 2)
            return none
        amount := int(parts[index])
        if amount > 59
            return none
        result += amount * (if index == 1 then 60 else 1)
    return result

int | error parse_year(string text)
    if not is_number(text, 4, 4)
        return error("bad year")
    value := int(text)
    return if 1800 <= value <= 2099 then value else error("bad year")

int | error parse_to(string text, int from_year)
    if text == "only"
        return from_year
    if text == "max"
        return 2099
    if not is_number(text, 4, 4)
        return error("bad year")
    value := int(text)
    return if from_year <= value <= 2099 then value else error("bad year")

int | error parse_month(string text)
    names := calendar.month_names()
    for: index < 12
        if names[index] == text
            return index + 1
    return error("bad month")

int | error parse_weekday(string text)
    names := calendar.weekday_names()
    for: index < 7
        if names[index] == text
            return index
    return error("bad day spec")

int | error parse_day_of_month(string text, int month)
    if not is_number(text, 1, 2) or text[0] == "0"
        return error("bad day spec")
    value := int(text)
    return if value <= calendar.common_month_days()[month - 1] then value else error("bad day spec")

calendar.DaySpec | error parse_day_spec(string text, int month)
    if text.starts_with("last")
        weekday := try parse_weekday(text[4:<text.len()])
        return calendar.DaySpec("last", weekday, 0)
    for operator := [">=", "<="][]
        if text.contains(operator)
            parts := text.split(operator)
            weekday := try parse_weekday(parts[0])
            day := try parse_day_of_month(parts[1], month)
            if parts.len() != 2
                return error("bad day spec")
            return calendar.DaySpec(if operator == ">=" then "after" else "before", weekday, day)
    day := try parse_day_of_month(text, month)
    return calendar.DaySpec("day", 0, day)

class Time(int value, string kind)

Time | error parse_time(string text)
    if text == ""
        return error("bad time")
    kind := "w"
    numeric_text := text
    last := text[int(text.len()) - 1]
    if "wsu".contains(last)
        kind = last
        numeric_text = text[0:<text.len() - 1]
    match hms_value(numeric_text)
        int value
            return if value <= 86400 then Time(value, kind) else error("bad time")
        none
            return error("bad time")

int | error parse_save(string text)
    match hms_value(text, 2)
        int value
            return if value <= 7200 then value else error("bad save")
        none
            return error("bad save")

string | error parse_letter(string text)
    if text == "-"
        return ""
    if not (1 <= int(text.len()) <= 5)
        return error("bad letter")
    for code := text.codepoints()[]
        if not (65 <= code <= 90)
            return error("bad letter")
    return text

int | error parse_stdoff(string text)
    negative := text.starts_with("-")
    magnitude := if negative then text[1:<text.len()] else text
    match hms_value(magnitude)
        int value
            if value < 57600
                return if negative then -value else value
        none
            return error("bad offset")
    return error("bad offset")

void | error check_format(string text, bool uses_rule_set)
    placeholders := 0
    slashes := 0
    for: index < int(text.len())
        character := text[index]
        int code := text.codepoints()[index]
        if not ((65 <= code <= 90) or (97 <= code <= 122) or (48 <= code <= 57) or "+-/%".contains(character))
            return error("bad format")
        if character == "%"
            if index + 1 >= int(text.len()) or text[index + 1] != "s"
                return error("bad format")
            placeholders += 1
        if character == "/"
            slashes += 1
    if placeholders > 1 or slashes > 1 or (placeholders > 0 and slashes > 0) or (not uses_rule_set and placeholders > 0)
        return error("bad format")
    if slashes == 1 and (text.starts_with("/") or text.ends_with("/"))
        return error("bad format")
    return void

class Until(string year_text, string month_text, string day_text, int clock, string time_type, int value)

Until | error parse_until(string[] fields)
    year := try parse_year(fields[0])
    month_text := if fields.len() > 1 then fields[1] else "Jan"
    month := try parse_month(month_text)
    day_text := if fields.len() > 2 then fields[2] else "1"
    day := try parse_day_spec(day_text, month)
    clock := Time(0, "w")
    if fields.len() > 3
        clock = try parse_time(fields[3])
    return Until(fields[0], month_text, day_text, clock.value, clock.kind, day.value(year, month) * calendar.seconds_per_day + clock.value)
