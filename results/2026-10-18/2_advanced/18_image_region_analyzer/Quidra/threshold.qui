import pgm = "./pgm_reader.qui"

class Histogram(int maxval, int pixels, int[] counts, int[] below_counts, int[] below_sums, int total, int minimum, int maximum, int median, int mode, int levels, int bin_width, int[] bins)
class Candidate(int cutoff, int below, int sum_below, int above, int sum_above)
    int numerator = sum_below * sum_below * above + sum_above * sum_above * below
    int denominator = below * above
class OtsuResult(int cutoff, int upper, Candidate[] candidates)

Histogram histogram(pgm.Image image)
    int[] counts = array(nat(image.maxval + 1), fill = 0)
    for int[] row = image.pixels[]
        for int value = row[]
            counts[value] += 1
    int[] below_counts = []
    int[] below_sums = []
    int total = 0
    int count = 0
    int minimum = image.maxval
    int maximum = 0
    int median = -1
    int mode = 0
    int levels = 0
    int pixels = image.width * image.height
    for int value <= image.maxval
        count += counts[value]
        total += value * counts[value]
        below_counts = below_counts.append(count)
        below_sums = below_sums.append(total)
        if counts[value] > 0
            if value < minimum
                minimum = value
            maximum = value
            levels += 1
        if median < 0 and 2 * count >= pixels
            median = value
        if counts[value] > counts[mode]
            mode = value
    int bin_width = (image.maxval + 8) / 8
    int[] bins = []
    for int start <= image.maxval step bin_width
        int frequency = 0
        for start <= int value < start + bin_width
            if value <= image.maxval
                frequency += counts[value]
        bins = bins.append(frequency)
    return Histogram(image.maxval, pixels, counts, below_counts, below_sums, total, minimum, maximum, median, mode, levels, bin_width, bins)

int compare_scores(Candidate first, Candidate second)
    int first_quotient = first.numerator / first.denominator
    int second_quotient = second.numerator / second.denominator
    if first_quotient != second_quotient
        return if first_quotient > second_quotient then 1 else -1
    int left = (first.numerator % first.denominator) * second.denominator
    int right = (second.numerator % second.denominator) * first.denominator
    return if left > right then 1 elif left < right then -1 else 0

OtsuResult otsu(Histogram data)
    Candidate[] ranked = []
    for int cutoff < data.maxval
        int below = data.below_counts[cutoff]
        int sum_below = data.below_sums[cutoff]
        int above = data.pixels - below
        if data.counts[cutoff] == 0 or above == 0
            continue
        auto candidate = Candidate(cutoff, below, sum_below, above, data.total - sum_below)
        int position = int(len(ranked))
        ranked = ranked.append(candidate)
        while position > 0
            if compare_scores(candidate, ranked[position - 1]) <= 0
                break
            ranked[position] = ranked[position - 1]
            position -= 1
        ranked[position] = candidate
    if len(ranked) == 0
        return OtsuResult(data.minimum, data.minimum, ranked)
    int best = ranked[0].cutoff
    int following = best + 1
    while data.counts[following] == 0
        following += 1
    return OtsuResult(best, following - 1, ranked)

(int, int) isodata(Histogram data)
    int cutoff = data.total / data.pixels
    int iterations = 0
    while true
        int below = data.below_counts[cutoff]
        int above = data.pixels - below
        if below == 0 or above == 0
            break
        int sum_below = data.below_sums[cutoff]
        int sum_above = data.total - sum_below
        int following = (sum_below * above + sum_above * below) / (2 * below * above)
        iterations += 1
        if following == cutoff
            break
        cutoff = following
        if iterations == 100
            break
    return (cutoff, iterations)
