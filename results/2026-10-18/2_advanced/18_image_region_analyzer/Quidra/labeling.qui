import math

class Labeling(int[][] labels, int count, int provisional)

int find_root(int[] &parents, int label)
    int current = label
    while parents[current] != current
        parents[current] = parents[parents[current]]
        current = parents[current]
    return current

void union_roots(int[] &parents, int first, int second)
    int a = find_root(&parents, first)
    int b = find_root(&parents, second)
    if a != b
        parents[math.max(a, b)] = math.min(a, b)

Labeling label_components(bool[][] mask, int connectivity)
    int height = int(len(mask))
    int width = int(len(mask[0]))
    int[][] provisional = array(nat(height), fill = array(nat(width), fill = 0))
    int[] parents = [0]
    int[][] previous = if connectivity == 4 then [[-1, 0], [0, -1]] else [[-1, 0], [-1, -1], [0, -1], [1, -1]]
    for int y < height
        for int x < width
            if not mask[y][x]
                continue
            int[] neighbors = []
            for int[] offset = previous[]
                int nx = x + offset[0]
                int ny = y + offset[1]
                if 0 <= nx < width and 0 <= ny and mask[ny][nx]
                    neighbors = neighbors.append(provisional[ny][nx])
            if len(neighbors) == 0
                provisional[y][x] = int(len(parents))
                parents = parents.append(int(len(parents)))
            else
                provisional[y][x] = neighbors[0]
                for int other = neighbors[]
                    union_roots(&parents, neighbors[0], other)
    int[] numbers = array(len(parents), fill = 0)
    int[][] labels = array(nat(height), fill = array(nat(width), fill = 0))
    int count = 0
    for int y < height
        for int x < width
            if provisional[y][x] == 0
                continue
            int root = find_root(&parents, provisional[y][x])
            if numbers[root] == 0
                count += 1
                numbers[root] = count
            labels[y][x] = numbers[root]
    return Labeling(labels, count, int(len(parents)) - 1)

bool occupied(bool[][] mask, int x, int y)
    return 0 <= y < int(len(mask)) and 0 <= x < int(len(mask[0])) and mask[y][x]

int bit_quad_euler(bool[][] mask, int connectivity)
    int singles = 0
    int triples = 0
    int diagonals = 0
    for -1 <= int y < int(len(mask))
        for -1 <= int x < int(len(mask[0]))
            bool a = occupied(mask, x, y)
            bool b = occupied(mask, x + 1, y)
            bool c = occupied(mask, x, y + 1)
            bool d = occupied(mask, x + 1, y + 1)
            int count = (if a then 1 else 0) + (if b then 1 else 0) + (if c then 1 else 0) + (if d then 1 else 0)
            if count == 1
                singles += 1
            elif count == 3
                triples += 1
            elif count == 2 and ((a and d) or (b and c))
                diagonals += 1
    return (singles - triples + (if connectivity == 8 then -2 else 2) * diagonals) / 4
