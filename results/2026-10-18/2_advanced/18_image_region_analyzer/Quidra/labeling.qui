import math

class Labeling(int[][] labels, int count, int provisional)

int find_root(int[] &parents, int label)
    current := label
    while parents[current] != current
        parents[current] = parents[parents[current]]
        current = parents[current]
    return current

void union_roots(int[] &parents, int first, int second)
    a := find_root(&parents, first)
    b := find_root(&parents, second)
    if a != b
        parents[math.max(a, b)] = math.min(a, b)

Labeling label_components(bool[][] mask, int connectivity)
    height := int(#mask)
    width := int(#mask[0])
    int[][] provisional := array(nat(height), fill = array(nat(width), fill = 0))
    parents := [0]
    int[][] previous := if connectivity == 4 then [[-1, 0], [0, -1]] else [[-1, 0], [-1, -1], [0, -1], [1, -1]]
    for: y < height
        for: x < width
            if not mask[y][x]
                continue
            int[] neighbors := []
            for offset := previous[]
                nx := x + offset[0]
                ny := y + offset[1]
                if 0 <= nx < width and 0 <= ny and mask[ny][nx]
                    neighbors = neighbors.append(provisional[ny][nx])
            if #neighbors == 0
                provisional[y][x] = int(#parents)
                parents = parents.append(int(#parents))
            else
                provisional[y][x] = neighbors[0]
                for other := neighbors[]
                    union_roots(&parents, neighbors[0], other)
    numbers := array(#parents, fill = 0)
    int[][] labels := array(nat(height), fill = array(nat(width), fill = 0))
    count := 0
    for: y < height
        for: x < width
            if provisional[y][x] == 0
                continue
            root := find_root(&parents, provisional[y][x])
            if numbers[root] == 0
                count += 1
                numbers[root] = count
            labels[y][x] = numbers[root]
    return Labeling(labels, count, int(#parents) - 1)

bool occupied(bool[][] mask, int x, int y)
    return 0 <= y < int(#mask) and 0 <= x < int(#mask[0]) and mask[y][x]

int bit_quad_euler(bool[][] mask, int connectivity)
    singles := 0
    triples := 0
    diagonals := 0
    for: -1 <= y < int(#mask)
        for: -1 <= x < int(#mask[0])
            a := occupied(mask, x, y)
            b := occupied(mask, x + 1, y)
            c := occupied(mask, x, y + 1)
            d := occupied(mask, x + 1, y + 1)
            count := (if a then 1 else 0) + (if b then 1 else 0) + (if c then 1 else 0) + (if d then 1 else 0)
            if count == 1
                singles += 1
            elif count == 3
                triples += 1
            elif count == 2 and ((a and d) or (b and c))
                diagonals += 1
    return (singles - triples + (if connectivity == 8 then -2 else 2) * diagonals) / 4
