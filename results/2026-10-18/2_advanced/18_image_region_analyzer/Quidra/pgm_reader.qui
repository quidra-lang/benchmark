class Image(string name, int width, int height, int maxval, int[][] pixels)

Image[] read_images(string path)
    string[] words := []
    text := string.from_utf8(file.read_bin(path))
    for line := text.split(NL)[]
        for word := line.split("#")[0].split(" ")[]
            if word != ""
                words = words.append(word)
    Image[] images := []
    position := 0
    while position < int(words.len())
        name := words[position + 1]
        width := int(words[position + 3])
        height := int(words[position + 4])
        maxval := int(words[position + 5])
        position += 6
        int[][] pixels := array(nat(height), fill = array(nat(width), fill = 0))
        for: y < height
            for: x < width
                pixels[y][x] = int(words[position])
                position += 1
        images = images.append(Image(name, width, height, maxval, pixels))
    return images
