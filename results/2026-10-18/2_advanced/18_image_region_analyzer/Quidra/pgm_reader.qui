class Image(string name, int width, int height, int maxval, int[][] pixels)

Image[] read_images(string path)
    string[] words = []
    for string line = file.read(path).split(NL)[]
        for string word = line.split("#")[0].split(" ")[]
            if word != ""
                words = words.append(word)
    Image[] images = []
    int position = 0
    while position < int(len(words))
        string name = words[position + 1]
        int width = int.parse(words[position + 3])
        int height = int.parse(words[position + 4])
        int maxval = int.parse(words[position + 5])
        position += 6
        int[][] pixels = array(nat(height), fill = array(nat(width), fill = 0))
        for int y < height
            for int x < width
                pixels[y][x] = int.parse(words[position])
                position += 1
        images = images.append(Image(name, width, height, maxval, pixels))
    return images
