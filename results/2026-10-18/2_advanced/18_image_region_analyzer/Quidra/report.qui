import math

string decimal(int numerator, int denominator, int digits)
    int scale = 10 ^ digits
    int scaled = (2 * scale * math.abs(numerator) + denominator) / (2 * denominator)
    string sign = if numerator < 0 and scaled > 0 then "-" else ""
    string fraction = "{scaled % scale}"
    return "{sign}{scaled / scale}." + string.repeat("0", nat(digits - int(len(fraction)))) + fraction

string hull_area_text(int doubled)
    return "{doubled / 2}.{if doubled % 2 == 0 then 0 else 5}"

string integers(int[] values)
    return [for int value = values[] then "{value}"].join(" ")

void write_lines(string name, string[] lines)
    file.write("output/" + name, lines.join(NL) + NL)
