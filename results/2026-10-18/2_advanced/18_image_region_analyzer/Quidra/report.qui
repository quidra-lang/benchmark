import math

string decimal(int numerator, int denominator, int digits)
    scale := 10 ^ digits
    scaled := (2 * scale * math.abs(numerator) + denominator) / (2 * denominator)
    sign := if numerator < 0 and scaled > 0 then "-" else ""
    fraction := "{scaled % scale}"
    return "{sign}{scaled / scale}." + "0" * nat(digits - int(fraction.len())) + fraction

string hull_area_text(int doubled)
    return "{doubled / 2}.{if doubled % 2 == 0 then 0 else 5}"

string integers(int[] values)
    return [for value := values[] then "{value}"].join(" ")

void write_lines(string name, string[] lines)
    writer1 := file.write("output/" + name)
    .writer1(lines.join(NL) + NL)
