class Position(int file_index, int line, int column)
class Token(string kind, string spelling, string value, Position position)

bool has<T>(const T[] items, T sought)
    for T item = items[]
        if item == sought
            return true
    return false

int minimum(int first, int second)
    return if first < second then first else second

int maximum(int first, int second)
    return if first > second then first else second

string repeat(string text, int count)
    string result = ""
    for int iteration < count
        result += text
    return result

int compare_position(const Position first, const Position second)
    if first.file_index != second.file_index
        return if first.file_index < second.file_index then -1 else 1
    if first.line != second.line
        return if first.line < second.line then -1 else 1
    return if first.column < second.column then -1 elif first.column > second.column then 1 else 0

bool letter(string character)
    return (character >= "A" and character <= "Z") or (character >= "a" and character <= "z")

bool digit(string character)
    return character >= "0" and character <= "9"

Token[] lex(string text, int file_index)
    Position[] positions = []
    int row = 1
    int column = 1
    for int position < int(len(text))
        positions = positions.append(Position(file_index, row, column))
        if text[position] == NL
            row += 1
            column = 1
        else
            column += 1
    positions = positions.append(Position(file_index, row, column))
    Token[] tokens = []
    int position = 0
    while position < int(len(text))
        string character = text[position]
        if character == " " or character == NL
            position += 1
            continue
        int start = position
        string kind = ""
        string value = ""
        if text[position:<int(len(text))].starts_with("(*")
            int finish = position + 2
            while finish + 1 < int(len(text)) and text[finish:<finish + 2] != "*)"
                finish += 1
            if finish + 1 < int(len(text))
                position = finish + 2
                continue
            tokens = tokens.append(Token("invalid", text[start:<int(len(text))], "unterminated comment", positions[start]))
            break
        elif digit(character)
            position += 1
            while position < int(len(text)) and digit(text[position])
                position += 1
            int number = int.parse(text[start:<position])
            kind = if number <= 2147483647 then "integer" else "invalid"
            value = if kind == "integer" then number.string() else "integer literal too large"
        elif letter(character) or character == "_"
            position += 1
            while position < int(len(text)) and (letter(text[position]) or digit(text[position]) or text[position] == "_" or text[position] == "'")
                position += 1
            value = text[start:<position]
            kind = if has(["let", "rec", "and", "in", "fun", "if", "then", "else", "match", "with", "true", "false", "mod", "val"], value) then "keyword" else "identifier"
        elif character == "'" and position + 1 < int(len(text)) and text[position + 1] >= "a" and text[position + 1] <= "z"
            position += 2
            while position < int(len(text)) and (letter(text[position]) or digit(text[position]) or text[position] == "_")
                position += 1
            kind = "type_variable"
            value = text[start:<position]
        elif character == DQ
            position += 1
            bool closed = false
            bool valid = true
            string decoded = ""
            while position < int(len(text)) and text[position] != NL
                if text[position] == DQ
                    position += 1
                    closed = true
                    break
                if text[position] == "\" and position + 1 < int(len(text)) and text[position + 1] != NL
                    string escaped = text[position + 1]
                    if escaped == "n"
                        decoded += NL
                    elif escaped == "t"
                        decoded += HT
                    elif escaped == "\" or escaped == DQ
                        decoded += escaped
                    else
                        valid = false
                    position += 2
                elif text[position] == "\"
                    position += 1
                else
                    decoded += text[position]
                    position += 1
            kind = if closed and valid then "string" else "invalid"
            value = if not closed then "unterminated string" elif not valid then "invalid escape sequence" else decoded
        else
            if position + 1 < int(len(text)) and has([";;", "->", "::", "||", "&&", "<=", ">=", "<>"], text[position:<position + 2])
                position += 2
                kind = "symbol"
                value = text[start:<position]
            elif ":;=<>+-*/^()[],|".contains(character)
                position += 1
                kind = "symbol"
                value = character
            else
                position += 1
                kind = "invalid"
                value = "illegal character '{character}'"
        tokens = tokens.append(Token(kind, text[start:<position], value, positions[start]))
    tokens = tokens.append(Token("eof", "", "", positions[int(len(positions)) - 1]))
    return tokens
