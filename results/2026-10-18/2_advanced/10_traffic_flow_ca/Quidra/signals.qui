class Phase(local string text)
    local string[] fields = text.split(":")
    int duration = int.parse(fields[0])
    string token = fields[1]
    set.Set<string> greens
    if token != "-"
        for string segment_id = token.split(",")[]
            .greens.add(segment_id)

class Junction(string node, int offset, local string[] tokens)
    Phase[] phases = []
    int cycle = 0
    for string token = tokens[]
        Phase phase = Phase(token)
        phases = phases.append(phase)
        cycle += phase.duration

    bool green(string segment_id, int time_step)
        if len(phases) == 0
            return true
        int elapsed = (time_step - 1 + offset) % cycle
        for Phase entry = phases[]
            if elapsed < entry.duration
                return entry.greens.has(segment_id)
            elapsed -= entry.duration
        return false

    string[] plan_lines()
        if len(phases) == 0
            return ["JUNCTION {node} unsignalized"]
        string[] result = ["JUNCTION {node} signal cycle {cycle} offset {offset}"]
        int begin = 0
        for nat index < len(phases)
            Phase entry = phases[index]
            result = result.append("  PHASE {index + 1} {begin}-{begin + entry.duration - 1} {entry.token}")
            begin += entry.duration
        return result
