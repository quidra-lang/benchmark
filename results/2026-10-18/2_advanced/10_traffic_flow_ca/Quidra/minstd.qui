class Generator(int state)
    int .draw()
        state = state * 48271 % 2147483647
        return state

int select(int[] weights, int random_value)
    total := 0
    for weight := weights[]
        total += weight
    value := random_value % total
    cumulative := 0
    for: index < len(weights)
        cumulative += weights[index]
        if value < cumulative
            return int(index)
    return int(len(weights)) - 1
