class Generator(int state)
    int .draw()
        state = state * 48271 % 2147483647
        return state

int select(int[] weights, int random_value)
    int total = 0
    for int weight = weights[]
        total += weight
    int value = random_value % total
    int cumulative = 0
    for nat index < len(weights)
        cumulative += weights[index]
        if value < cumulative
            return int(index)
    return int(len(weights)) - 1
