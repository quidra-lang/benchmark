int gcd(int first, int second)
    int left = first
    int right = second
    while right != 0
        int remainder = left % right
        left = right
        right = remainder
    return left

string decimal(int numerator, int denominator, int places)
    if denominator == 0
        return "-"
    int scale = 1
    for int digit < places
        scale *= 10
    int value = (2 * numerator * scale + denominator) / (2 * denominator)
    string tail = (value % scale).string()
    return "{value / scale}." + string.repeat("0", nat(places - int(len(tail)))) + tail

string fraction(int numerator, int denominator)
    if denominator == 0
        return "-"
    int divisor = gcd(numerator, denominator)
    return "{numerator / divisor}/{denominator / divisor}"

int percentile(int[] times, int q)
    return times[(q * int(len(times)) + 99) / 100 - 1]

string[] histogram(int[] times, int width)
    int first = times[0] / width
    int[] counts = array(nat(times[len(times) - 1] / width - first + 1), fill = 0)
    for int value = times[]
        counts[value / width - first] += 1
    int maximum = 0
    for int frequency = counts[]
        if frequency > maximum
            maximum = frequency
    string[] result = []
    for nat index < len(counts)
        int lower = (first + int(index)) * width
        int frequency = counts[index]
        int stars = (80 * frequency + maximum) / (2 * maximum)
        string line = "  {lower}-{lower + width - 1} {frequency}"
        if stars > 0
            line += " " + string.repeat("*", nat(stars))
        result = result.append(line)
    return result
