string[] lines(string path)
    string contents = file.read(path)
    string[] result = contents.split(NL)
    return result[0:<int(len(result)) - 1]

real64 decimal(string value)
    real64 result = real64.parse(value)
    return result

int find_name(string[] names, string name)
    for int index < int(len(names))
        if names[index] == name
            return index
    return -1

class Frame(string[] columns, bool[] categorical, string[][] rows)

Frame read_csv(string path, bool[] known_kinds = [], string[] known_columns = [])
    string[] contents = lines(path)
    string[] columns = contents[0].split(",")
    string[][] rows = []
    for 1 <= int index < int(len(contents))
        rows = rows.append(contents[index].split(","))
    bool[] kinds = []
    for int column < int(len(columns))
        bool categorical = false
        if len(known_kinds) > 0
            categorical = known_kinds[find_name(known_columns, columns[column])]
        else
            for string[] row = rows[]
                if row[column] != "NA" and "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(row[column][0])
                    categorical = true
        kinds = kinds.append(categorical)
    return Frame(columns, kinds, rows)

real64[] read_params()
    real64[] result = []
    for string line = lines("input/params.txt")[]
        string[] fields = line.split(" ")
        for 1 <= int index < int(len(fields))
            result = result.append(decimal(fields[index]))
    return result
