import math

real64 as_real(int value)
    real64 result = real64(value)
    return result

int as_int(real64 value)
    int result = int(value)
    return result

int floor_value(real64 value)
    int result = math.floor(value)
    return result

real64 root(real64 value)
    real64 result = math.sqrt(value)
    return result

real64 logarithm(real64 value)
    real64 result = math.log(value)
    return result

real64 exponential(real64 value)
    real64 result = math.exp(value)
    return result

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

real64 log_gamma(real64 x)
    real64[] coefficients = [76.18009172947146, -86.50532032941677, 24.01409824083091, -1.231739572450155, 0.001208650973866179, -0.000005395239384953]
    real64 t = x + 5.5
    real64 adjustment = t - (x + 0.5) * logarithm(t)
    real64 series = 1.000000000190015
    for int j < 6
        series += coefficients[j] / (x + as_real(j + 1))
    return -adjustment + logarithm(2.5066282746310005 * series / x)

real64 replace_small(real64 value)
    return if absolute(value) < 1.0e-300 then 1.0e-300 else value

real64 beta_fraction(real64 a, real64 b, real64 x)
    real64 c = 1.0
    real64 d = 1.0 / replace_small(1.0 - (a + b) * x / (a + 1.0))
    real64 h = d
    for 1 <= int m <= 1000
        real64 value = as_real(m)
        real64 q = value * (b - value) * x / ((a - 1.0 + 2.0 * value) * (a + 2.0 * value))
        d = 1.0 / replace_small(1.0 + q * d)
        c = replace_small(1.0 + q / c)
        h *= d * c
        q = -(a + value) * (a + b + value) * x / ((a + 2.0 * value) * (a + 1.0 + 2.0 * value))
        d = 1.0 / replace_small(1.0 + q * d)
        c = replace_small(1.0 + q / c)
        real64 delta = d * c
        h *= delta
        if absolute(delta - 1.0) < 1.0e-15
            break
    return h

real64 incomplete_beta(real64 x, real64 a, real64 b)
    if x <= 0.0
        return 0.0
    if x >= 1.0
        return 1.0
    real64 factor = exponential(log_gamma(a + b) - log_gamma(a) - log_gamma(b) + a * logarithm(x) + b * logarithm(1.0 - x))
    if x < (a + 1.0) / (a + b + 2.0)
        return factor * beta_fraction(a, b, x) / a
    return 1.0 - factor * beta_fraction(b, a, 1.0 - x) / b

real64 upper_gamma(real64 a, real64 x)
    if x <= 0.0
        return 1.0
    real64 factor = exponential(-x + a * logarithm(x) - log_gamma(a))
    if x < a + 1.0
        real64 term = 1.0 / a
        real64 e = a
        real64 series = term
        for _ < 1000
            e += 1.0
            term *= x / e
            series += term
            if absolute(term) < absolute(series) * 1.0e-15
                break
        return 1.0 - series * factor
    real64 beta = x + 1.0 - a
    real64 c = 1.0 / 1.0e-300
    real64 d = 1.0 / beta
    real64 h = d
    for 1 <= int i <= 1000
        real64 q = -as_real(i) * (as_real(i) - a)
        beta += 2.0
        d = 1.0 / replace_small(q * d + beta)
        c = replace_small(beta + q / c)
        real64 delta = d * c
        h *= delta
        if absolute(delta - 1.0) < 1.0e-15
            break
    return factor * h

real64 t_pvalue(real64 value, int degrees)
    real64 df = as_real(degrees)
    return incomplete_beta(df / (df + value * value), df / 2.0, 0.5)

real64 f_pvalue(real64 statistic, int numerator_df, int denominator_df)
    real64 first = as_real(numerator_df)
    real64 second = as_real(denominator_df)
    return incomplete_beta(second / (second + first * statistic), second / 2.0, first / 2.0)

real64 chi_pvalue(real64 statistic, int degrees)
    return upper_gamma(as_real(degrees) / 2.0, statistic / 2.0)

real64 t_quantile(real64 confidence, int degrees)
    real64 lo = 0.0
    real64 hi = 1000.0
    for _ < 100
        real64 mid = (lo + hi) / 2.0
        if t_pvalue(mid, degrees) > 1.0 - confidence
            lo = mid
        else
            hi = mid
    return (lo + hi) / 2.0

string significance(real64 value)
    if value < 0.0
        return ""
    if value < 0.001
        return "***"
    if value < 0.01
        return "**"
    if value < 0.05
        return "*"
    if value < 0.1
        return "."
    return ""

string four(real64 value)
    string result = "{value:frac=4}"
    return if result == "-0.0000" then "0.0000" else result

string probability(real64 value)
    if value < 0.0
        return "NA"
    return if value < 0.0001 then "<0.0001" else four(value)
