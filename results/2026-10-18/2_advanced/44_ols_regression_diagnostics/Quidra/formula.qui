public import dataframe = "./dataframe.qui"

bool contains_name(string[] values, string value)
    for string item = values[]
        if item == value
            return true
    return false

bool contains_int(int[] values, int value)
    for int item = values[]
        if item == value
            return true
    return false

int power_two(int exponent)
    int result = 1
    for _ < exponent
        result *= 2
    return result

class Factor(string name, int column, int power, bool categorical)
class Term(Factor[] factors, string name, string[] keys)
class Model(string original, string response, int response_column, string weight, int weight_column, Term[] terms, int[] factor_columns, int[] categorical_columns, int[] variables)
class Component(Factor factor, string name, string level)
class DesignColumn(int term_index, string name, Component[] components)
class Design(Model model, int[] row_numbers, string[][] rows, string[][] levels, DesignColumn[] columns, real64[][] matrix, real64[] response, real64[] weights)

Factor parse_factor(string name, string[] columns)
    bool categorical = len(name) >= 2 and name[0:<2] == "C("
    string column = name
    int power = 1
    if categorical
        column = name[2:<int(len(name)) - 1]
    elif len(name) >= 2 and name[0:<2] == "I("
        string[] parts = name[2:<int(len(name)) - 1].split("^")
        column = parts[0]
        power = if parts[1] == "2" then 2 else 3
    return Factor(name, dataframe.find_name(columns, column), power, categorical)

Term make_term(Factor[] factors)
    string[] names = [for Factor factor = factors[] then factor.name]
    return Term(factors, names.join(":"), names.sorted())

bool same_keys(string[] first, string[] second)
    if len(first) != len(second)
        return false
    for int index < int(len(first))
        if first[index] != second[index]
            return false
    return true

bool contained(Term first, Term second)
    if len(first.factors) >= len(second.factors)
        return false
    for string name = first.keys[]
        if not contains_name(second.keys, name)
            return false
    return true

Model parse(string line, string[] columns)
    string[] parts = line.split(" weights=")
    string original = parts[0]
    string weight = if len(parts) == 2 then parts[1] else ""
    string[] halves = original.split(" ~ ")
    Term[] terms = []
    int[] factor_columns = []
    int[] categorical_columns = []
    int[] variables = []
    for string expression = halves[1].split(" + ")[]
        Factor[][] expanded = []
        if expression.contains("*")
            Factor[] factors = [for string name = expression.split("*")[] then parse_factor(name, columns)]
            for 1 <= int size <= int(len(factors))
                for 1 <= int mask < power_two(int(len(factors)))
                    Factor[] chosen = []
                    for int index < int(len(factors))
                        if (mask / power_two(index)) % 2 == 1
                            chosen = chosen.append(factors[index])
                    if int(len(chosen)) == size
                        expanded = expanded.append(chosen)
        else
            expanded = [[for string name = expression.split(":")[] then parse_factor(name, columns)]]
        for Factor[] factors = expanded[]
            Term item = make_term(factors)
            bool exists = false
            for Term previous = terms[]
                if same_keys(item.keys, previous.keys)
                    exists = true
                    break
            if exists
                continue
            terms = terms.append(item)
            for Factor factor = factors[]
                if not contains_int(factor_columns, factor.column)
                    factor_columns = factor_columns.append(factor.column)
                    variables = variables.append(factor.column)
                if factor.categorical and not contains_int(categorical_columns, factor.column)
                    categorical_columns = categorical_columns.append(factor.column)
    int response_column = dataframe.find_name(columns, halves[0])
    int weight_column = if weight == "" then -1 else dataframe.find_name(columns, weight)
    variables = variables.append(response_column)
    if weight_column >= 0
        variables = variables.append(weight_column)
    return Model(original, halves[0], response_column, weight, weight_column, terms, factor_columns, categorical_columns, variables)

string format_model(Model model, int[] indices)
    string[] names = [for int index = indices[] then model.terms[index].name]
    return model.response + " ~ " + (if len(names) == 0 then "1" else names.join(" + "))

int[] removable(Term[] terms, int[] indices)
    int[] result = []
    for int index = indices[]
        bool allowed = true
        Term current = terms[index]
        for int other = indices[]
            Term candidate = terms[other]
            if contained(current, candidate)
                allowed = false
                break
        if allowed
            result = result.append(index)
    return result

int[] candidates(Term[] terms, int[] indices)
    int[] result = []
    for int index < int(len(terms))
        bool allowed = not contains_int(indices, index)
        Term item = terms[index]
        for int other < int(len(terms))
            Term smaller = terms[other]
            if contained(smaller, item) and not contains_int(indices, other)
                allowed = false
        if allowed
            result = result.append(index)
    return result

bool hierarchical(Term[] terms, int[] indices)
    for int index = indices[]
        Term item = terms[index]
        for int other < int(len(terms))
            Term smaller = terms[other]
            if contained(smaller, item) and not contains_int(indices, other)
                return false
    return true

real64 component_value(Component component, string[] row)
    Factor factor = component.factor
    string value = row[factor.column]
    if factor.categorical
        return if value == component.level then 1.0 else 0.0
    real64 number = dataframe.decimal(value)
    if factor.power == 2
        return number * number
    if factor.power == 3
        return number * number * number
    return number

real64[] design_values(DesignColumn[] columns, string[] row)
    real64[] result = []
    for DesignColumn column = columns[]
        real64 value = 1.0
        for int index < int(len(column.components))
            Component component = column.components[index]
            real64 next_value = component_value(component, row)
            value = if index == 0 then next_value else value * next_value
        result = result.append(value)
    return result

real64[][] subset_matrix(real64[][] matrix, DesignColumn[] columns, int[] indices)
    real64[][] result = []
    for real64[] row = matrix[]
        real64[] selected = []
        for int column < int(len(columns))
            if columns[column].term_index < 0 or contains_int(indices, columns[column].term_index)
                selected = selected.append(row[column])
        result = result.append(selected)
    return result

bool predictable(Model model, string[][] levels, string[] row)
    for int column = model.factor_columns[]
        if row[column] == "NA"
            return false
        if len(levels[column]) > 0 and not contains_name(levels[column], row[column])
            return false
    return true

Design design(Model model, dataframe.Frame data)
    int[] row_numbers = []
    string[][] rows = []
    for int index < int(len(data.rows))
        string[] row = data.rows[index]
        bool complete = true
        for int column = model.variables[]
            if row[column] == "NA"
                complete = false
        if complete
            rows = rows.append(row)
            row_numbers = row_numbers.append(index + 1)
    string[][] levels = []
    for int column < int(len(data.columns))
        string[] items = []
        if contains_int(model.categorical_columns, column)
            for string[] row = rows[]
                if not contains_name(items, row[column])
                    items = items.append(row[column])
            items = items.sorted()
        levels = levels.append(items)
    DesignColumn[] columns = [DesignColumn(-1, "(Intercept)", [])]
    for int term_index < int(len(model.terms))
        Term item = model.terms[term_index]
        Component[][] choices = []
        int total = 1
        for Factor factor = item.factors[]
            Component[] components = []
            if factor.categorical
                for 1 <= int index < int(len(levels[factor.column]))
                    string level = levels[factor.column][index]
                    components = components.append(Component(factor, factor.name + level, level))
            else
                components = [Component(factor, factor.name, "")]
            choices = choices.append(components)
            total *= int(len(components))
        for int code < total
            int remaining = code
            string[] names = []
            Component[] components = []
            for Component[] options = choices[]
                Component component = options[remaining % int(len(options))]
                remaining /= int(len(options))
                names = names.append(component.name)
                components = components.append(component)
            columns = columns.append(DesignColumn(term_index, names.join(":"), components))
    real64[][] matrix = []
    real64[] response = []
    real64[] weights = []
    for string[] row = rows[]
        matrix = matrix.append(design_values(columns, row))
        response = response.append(dataframe.decimal(row[model.response_column]))
        weights = weights.append(if model.weight_column >= 0 then dataframe.decimal(row[model.weight_column]) else 1.0)
    return Design(model, row_numbers, rows, levels, columns, matrix, response, weights)
