public import qr = "./qr_solver.qui"
import inference = "./inference.qui"

class Row(real64 standardized, real64 studentized, real64 cooks, real64 dffits, string flags, real64[] dfbetas)
class Result(Row[] rows, real64 dw, real64[] bp, real64[] jb)

Row[] row_diagnostics(qr.Fit fitted, real64[] params)
    int n = fitted.n
    int rank = fitted.rank
    int degrees = n - rank
    real64 sigma = inference.root(fitted.rss / inference.as_real(degrees))
    real64 leverage_limit = params[3] * inference.as_real(rank) / inference.as_real(n)
    real64 cook_limit = params[5] / inference.as_real(n)
    real64 dffits_limit = params[6] * inference.root(inference.as_real(rank) / inference.as_real(n))
    Row[] rows = []
    for int i < n
        real64 h = fitted.leverage[i]
        real64 residual = fitted.weighted_residual[i]
        real64 z = residual / (sigma * inference.root(1.0 - h))
        real64 studentized = z * inference.root(inference.as_real(degrees - 1) / (inference.as_real(degrees) - z * z))
        real64 cooks = z * z * h / (inference.as_real(rank) * (1.0 - h))
        real64 dffits = studentized * inference.root(h / (1.0 - h))
        string flags = ""
        if h > leverage_limit
            flags += "H"
        if inference.absolute(studentized) > params[4]
            flags += "O"
        if cooks > cook_limit
            flags += "C"
        if inference.absolute(dffits) > dffits_limit
            flags += "F"
        real64 deleted_sigma = sigma * inference.root((inference.as_real(degrees) - z * z) / inference.as_real(degrees - 1))
        real64[] dfbetas = []
        for int k < rank
            dfbetas = dfbetas.append(fitted.g[i][k] * residual / (1.0 - h) / (deleted_sigma * inference.root(fitted.variance[k])))
        rows = rows.append(Row(z, studentized, cooks, dffits, if flags == "" then "-" else flags, dfbetas))
    return rows

real64 durbin_watson(real64[] residuals, real64 rss)
    real64 numerator = 0.0
    for 1 <= int i < int(len(residuals))
        real64 difference = residuals[i] - residuals[i - 1]
        numerator += difference * difference
    return numerator / rss

real64[] breusch_pagan(qr.Fit fitted, real64 tolerance)
    real64[] squared = []
    real64[][] matrix = []
    real64[] ones = []
    real64 sum = 0.0
    for int i < fitted.n
        real64 value = fitted.weighted_residual[i] * fitted.weighted_residual[i]
        squared = squared.append(value)
        sum += value
        ones = ones.append(1.0)
        real64[] row = []
        for int column = fitted.accepted[]
            row = row.append(fitted.matrix[i][column])
        matrix = matrix.append(row)
    qr.Fit auxiliary = qr.fit(matrix, squared, ones, tolerance)
    real64 mean = sum / inference.as_real(fitted.n)
    real64 tss = 0.0
    for real64 value = squared[]
        tss += (value - mean) * (value - mean)
    real64 statistic = inference.as_real(fitted.n) * (1.0 - auxiliary.rss / tss)
    int degrees = auxiliary.rank - 1
    return [statistic, inference.as_real(degrees), inference.chi_pvalue(statistic, degrees)]

real64[] jarque_bera(real64[] residuals)
    int n = int(len(residuals))
    real64 sum = 0.0
    for real64 value = residuals[]
        sum += value
    real64 mean = sum / inference.as_real(n)
    real64 m2 = 0.0
    real64 m3 = 0.0
    real64 m4 = 0.0
    for real64 value = residuals[]
        real64 delta = value - mean
        m2 += delta * delta
        m3 += delta * delta * delta
        m4 += delta * delta * delta * delta
    m2 /= inference.as_real(n)
    m3 /= inference.as_real(n)
    m4 /= inference.as_real(n)
    real64 skewness = m3 / (m2 * inference.root(m2))
    real64 kurtosis = m4 / (m2 * m2)
    real64 statistic = inference.as_real(n) / 6.0 * (skewness * skewness + (kurtosis - 3.0) * (kurtosis - 3.0) / 4.0)
    return [statistic, inference.chi_pvalue(statistic, 2), skewness, kurtosis]

Result calculate(qr.Fit fitted, real64[] params)
    return Result(row_diagnostics(fitted, params), durbin_watson(fitted.weighted_residual, fitted.rss), breusch_pagan(fitted, params[0]), jarque_bera(fitted.weighted_residual))
