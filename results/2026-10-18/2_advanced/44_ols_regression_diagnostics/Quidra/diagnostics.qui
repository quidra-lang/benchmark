public import qr = "./qr_solver.qui"
import inference = "./inference.qui"

class Row(real64 standardized, real64 studentized, real64 cooks, real64 dffits, string flags, real64[] dfbetas)
class Result(Row[] rows, real64 dw, real64[] bp, real64[] jb)

Row[] row_diagnostics(qr.Fit fitted, real64[] params)
    n := fitted.n
    rank := fitted.rank
    degrees := n - rank
    sigma := inference.root(fitted.rss / inference.as_real(degrees))
    leverage_limit := params[3] * inference.as_real(rank) / inference.as_real(n)
    cook_limit := params[5] / inference.as_real(n)
    dffits_limit := params[6] * inference.root(inference.as_real(rank) / inference.as_real(n))
    Row[] rows := []
    for: int i < n
        h := fitted.leverage[i]
        residual := fitted.weighted_residual[i]
        z := residual / (sigma * inference.root(1.0 - h))
        studentized := z * inference.root(inference.as_real(degrees - 1) / (inference.as_real(degrees) - z * z))
        cooks := z * z * h / (inference.as_real(rank) * (1.0 - h))
        dffits := studentized * inference.root(h / (1.0 - h))
        flags := ""
        if h > leverage_limit
            flags += "H"
        if inference.absolute(studentized) > params[4]
            flags += "O"
        if cooks > cook_limit
            flags += "C"
        if inference.absolute(dffits) > dffits_limit
            flags += "F"
        deleted_sigma := sigma * inference.root((inference.as_real(degrees) - z * z) / inference.as_real(degrees - 1))
        real64[] dfbetas := []
        for: int k < rank
            dfbetas = dfbetas.append(fitted.g[i][k] * residual / (1.0 - h) / (deleted_sigma * inference.root(fitted.variance[k])))
        rows = rows.append(Row(z, studentized, cooks, dffits, if flags == "" then "-" else flags, dfbetas))
    return rows

real64 durbin_watson(real64[] residuals, real64 rss)
    real64 numerator := 0.0
    for: 1 <= i < int(#residuals)
        difference := residuals[i] - residuals[i - 1]
        numerator += difference * difference
    return numerator / rss

real64[] breusch_pagan(qr.Fit fitted, real64 tolerance)
    real64[] squared := []
    real64[][] matrix := []
    real64[] ones := []
    real64 sum := 0.0
    for: int i < fitted.n
        value := fitted.weighted_residual[i] * fitted.weighted_residual[i]
        squared = squared.append(value)
        sum += value
        ones = ones.append(1.0)
        real64[] row := []
        for column := fitted.accepted[]
            row = row.append(fitted.matrix[i][column])
        matrix = matrix.append(row)
    auxiliary := qr.fit(matrix, squared, ones, tolerance)
    mean := sum / inference.as_real(fitted.n)
    real64 tss := 0.0
    for value := squared[]
        tss += (value - mean) * (value - mean)
    statistic := inference.as_real(fitted.n) * (1.0 - auxiliary.rss / tss)
    degrees := auxiliary.rank - 1
    return [statistic, inference.as_real(degrees), inference.chi_pvalue(statistic, degrees)]

real64[] jarque_bera(real64[] residuals)
    n := int(#residuals)
    real64 sum := 0.0
    for value := residuals[]
        sum += value
    mean := sum / inference.as_real(n)
    real64 m2 := 0.0
    real64 m3 := 0.0
    real64 m4 := 0.0
    for value := residuals[]
        delta := value - mean
        m2 += delta * delta
        m3 += delta * delta * delta
        m4 += delta * delta * delta * delta
    m2 /= inference.as_real(n)
    m3 /= inference.as_real(n)
    m4 /= inference.as_real(n)
    skewness := m3 / (m2 * inference.root(m2))
    kurtosis := m4 / (m2 * m2)
    statistic := inference.as_real(n) / 6.0 * (skewness * skewness + (kurtosis - 3.0) * (kurtosis - 3.0) / 4.0)
    return [statistic, inference.chi_pvalue(statistic, 2), skewness, kurtosis]

Result calculate(qr.Fit fitted, real64[] params)
    return Result(row_diagnostics(fitted, params), durbin_watson(fitted.weighted_residual, fitted.rss), breusch_pagan(fitted, params[0]), jarque_bera(fitted.weighted_residual))
