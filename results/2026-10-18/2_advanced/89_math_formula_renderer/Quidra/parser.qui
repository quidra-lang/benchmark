import lexer = "./lexer.qui"

class Node(string kind, value := "", column := 0, int[] children := [], atom_kind := "", int | none sub := none, int | none sup := none, left := "", right := "", int[][] rows := [])
class Formula(Node[] nodes, int[] elements, lexer.Token | none tag, lexer.Token | none label)
class Parsing(lexer.Token[] tokens, int end_column, position := 0, Node[] nodes := [], lexer.Token | none tag := none, lexer.Token | none label := none, lexer.Problem | none problem := none)

bool failed(const Parsing context)
    match context.problem
        lexer.Problem found
            return true
        none
            return false

lexer.Token peek(const Parsing context)
    return if context.position < int(#context.tokens) then context.tokens[context.position] else lexer.Token("eof", "", context.end_column)

lexer.Token take(Parsing &context)
    result := peek(context)
    if context.position < int(#context.tokens)
        context.position += 1
    return result

int fail(Parsing &context, int column, string reason)
    if not failed(context)
        context.problem = lexer.Problem(column, reason)
    return -1

int add(Parsing &context, const Node node)
    index := int(#context.nodes)
    context.nodes = context.nodes.append(node)
    return index

int collapse(Parsing &context, const int[] nodes)
    if #nodes == 1
        return nodes[0]
    return add(&context, Node("row", children = nodes))

int unexpected(Parsing &context)
    token := peek(context)
    reason := if token.kind == "right" then "unexpected \right" elif token.kind == "end" then "unexpected \end" elif token.kind == "&" then "misplaced &" elif token.kind == "newline" then "misplaced \\" else "unexpected end of input"
    return fail(&context, token.column, reason)

int[] parse_list(Parsing &context, bool top := false, bool root_index := false);
int nucleus(Parsing &context);

int argument(Parsing &context, string name)
    token := peek(context)
    if lexer.has(["identifier", "number", "symbol", "command", "text", "eqref", "{{", "frac", "binom", "overset", "underset", "sqrt", "accent"], token.kind)
        return nucleus(&context)
    return fail(&context, token.column, "missing argument for {name}")

string delimiter(Parsing &context)
    token := take(&context)
    if (token.kind == "symbol" and lexer.has(["(", ")", "[", "]", "|", "."], token.value)) or (token.kind == "command" and lexer.has(["\{{", "\}}"], token.value))
        return token.value
    ignored := fail(&context, token.column, "invalid delimiter")
    return ""

int element(Parsing &context)
    next := peek(context)
    base := if next.kind == "^" or next.kind == "_" then add(&context, Node("row")) else nucleus(&context)
    if failed(context)
        return -1
    int | none sub := none
    int | none sup := none
    while peek(context).kind == "^" or peek(context).kind == "_"
        token := take(&context)
        duplicate := false
        int | none existing := if token.kind == "^" then sup else sub
        match existing
            int found
                duplicate = true
            none
                duplicate = false
        if duplicate
            return fail(&context, token.column, if token.kind == "^" then "double superscript" else "double subscript")
        value := argument(&context, token.kind)
        if failed(context)
            return -1
        if token.kind == "^"
            sup = value
        else
            sub = value
    scripted := false
    match sub
        int found
            scripted = true
        none
            scripted = false
    match sup
        int found
            scripted = true
        none
            scripted = scripted
    return if scripted then add(&context, Node("script", children = [base], sub = sub, sup = sup)) else base

int[] parse_list(Parsing &context, bool top, bool root_index)
    int[] result := []
    while not failed(context)
        token := peek(context)
        if lexer.has(["}}", "&", "newline", "right", "end", "eof"], token.kind) or (root_index and token.kind == "symbol" and token.value == "]")
            return result
        if token.kind == "tag" or token.kind == "label"
            if not top
                ignored := fail(&context, token.column, "misplaced \{token.kind}")
                return result
            lexer.Token | none previous := if token.kind == "tag" then context.tag else context.label
            match previous
                lexer.Token found
                    ignored := fail(&context, token.column, "duplicate \{token.kind}")
                    return result
                none
                    if token.kind == "tag"
                        context.tag = token
                    else
                        context.label = token
            ignored := take(&context)
            continue
        node := element(&context)
        if not failed(context)
            result = result.append(node)
    return result

int nucleus(Parsing &context)
    token := take(&context)
    if lexer.has(["identifier", "number", "symbol", "command", "text", "eqref"], token.kind)
        return add(&context, Node("atom", token.value, token.column, atom_kind = token.kind))
    if token.kind == "{{"
        nodes := parse_list(&context)
        if failed(context)
            return -1
        if peek(context).kind != "}}"
            return unexpected(&context)
        ignored := take(&context)
        return collapse(&context, nodes)
    if lexer.has(["frac", "binom", "overset", "underset"], token.kind)
        first := argument(&context, "\" + token.kind)
        if failed(context)
            return -1
        second := argument(&context, "\" + token.kind)
        if failed(context)
            return -1
        return add(&context, Node(token.kind, children = [first, second]))
    if token.kind == "sqrt"
        int | none index := none
        next := peek(context)
        if next.kind == "symbol" and next.value == "["
            opening := take(&context)
            nodes := parse_list(&context, false, true)
            if failed(context)
                return -1
            next = peek(context)
            if next.kind != "symbol" or next.value != "]"
                return fail(&context, opening.column, "missing ]")
            ignored := take(&context)
            index = collapse(&context, nodes)
        body := argument(&context, "\sqrt")
        if failed(context)
            return -1
        match index
            int found
                return add(&context, Node("root", children = [found, body]))
            none
                return add(&context, Node("sqrt", children = [body]))
    if token.kind == "accent"
        body := argument(&context, "\" + token.value)
        if failed(context)
            return -1
        return add(&context, Node("accent", token.value, children = [body]))
    if token.kind == "left"
        left := delimiter(&context)
        if failed(context)
            return -1
        nodes := parse_list(&context)
        if failed(context)
            return -1
        if peek(context).kind != "right"
            return fail(&context, token.column, "missing \right")
        closing := take(&context)
        right := delimiter(&context)
        if failed(context)
            return -1
        body := collapse(&context, nodes)
        return add(&context, Node("delim", column = closing.column, children = [body], left = left, right = right))
    if token.kind == "begin"
        int[][] rows := [[]]
        while true
            elements := parse_list(&context)
            if failed(context)
                return -1
            cell := collapse(&context, elements)
            last := int(#rows) - 1
            rows[last] = rows[last].append(cell)
            closing := take(&context)
            if closing.kind == "&"
                continue
            if closing.kind == "newline"
                rows = rows.append([])
                continue
            if closing.kind == "end"
                if closing.value != token.value
                    return fail(&context, closing.column, "mismatched \end")
                break
            return fail(&context, token.column, "missing \end")
        last := int(#rows) - 1
        if last > 0 and #rows[last] == 1
            cell := context.nodes[rows[last][0]]
            if cell.kind == "row" and #cell.children == 0
                rows = rows[0:<last]
        width := 0
        for row := rows[]
            if int(#row) > width
                width = int(#row)
        for: row_index < int(#rows)
            while int(#rows[row_index]) < width
                empty := add(&context, Node("row"))
                rows[row_index] = rows[row_index].append(empty)
        return add(&context, Node("matrix", token.value, rows = rows))
    return fail(&context, token.column, "unexpected end of input")

Formula | lexer.Problem parse(const lexer.Token[] tokens, int end_column)
    int[] braces := []
    for token := tokens[]
        if token.kind == "{{"
            braces = braces.append(token.column)
        elif token.kind == "}}"
            if #braces == 0
                return lexer.Problem(token.column, "unmatched }}")
            braces = braces[0:<int(#braces) - 1]
    if #braces > 0
        return lexer.Problem(braces[-1], "unclosed {{")
    context := Parsing(tokens, end_column)
    elements := parse_list(&context, true)
    if not failed(context) and peek(context).kind != "eof"
        ignored := unexpected(&context)
    match context.problem
        lexer.Problem problem
            return problem
        none
            return Formula(context.nodes, elements, context.tag, context.label)
