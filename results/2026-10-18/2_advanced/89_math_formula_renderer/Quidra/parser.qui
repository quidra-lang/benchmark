import lexer = "./lexer.qui"

class Node(string kind, string value = "", int column = 0, int[] children = [], string atom_kind = "", int | none sub = none, int | none sup = none, string left = "", string right = "", int[][] rows = [])
class Formula(Node[] nodes, int[] elements, lexer.Token | none tag, lexer.Token | none label)
class Parsing(lexer.Token[] tokens, int end_column, int position = 0, Node[] nodes = [], lexer.Token | none tag = none, lexer.Token | none label = none, lexer.Problem | none problem = none)

bool failed(const Parsing context)
    match context.problem
        lexer.Problem found
            return true
        none
            return false

lexer.Token peek(const Parsing context)
    return if context.position < int(len(context.tokens)) then context.tokens[context.position] else lexer.Token("eof", "", context.end_column)

lexer.Token take(Parsing &context)
    lexer.Token result = peek(context)
    if context.position < int(len(context.tokens))
        context.position += 1
    return result

int fail(Parsing &context, int column, string reason)
    if not failed(context)
        context.problem = lexer.Problem(column, reason)
    return -1

int add(Parsing &context, const Node node)
    int index = int(len(context.nodes))
    context.nodes = context.nodes.append(node)
    return index

int collapse(Parsing &context, const int[] nodes)
    if len(nodes) == 1
        return nodes[0]
    return add(&context, Node("row", children = nodes))

int unexpected(Parsing &context)
    lexer.Token token = peek(context)
    string reason = if token.kind == "right" then "unexpected \right" elif token.kind == "end" then "unexpected \end" elif token.kind == "&" then "misplaced &" elif token.kind == "newline" then "misplaced \\" else "unexpected end of input"
    return fail(&context, token.column, reason)

int[] parse_list(Parsing &context, bool top = false, bool root_index = false);
int nucleus(Parsing &context);

int argument(Parsing &context, string name)
    lexer.Token token = peek(context)
    if lexer.has(["identifier", "number", "symbol", "command", "text", "eqref", "{{", "frac", "binom", "overset", "underset", "sqrt", "accent"], token.kind)
        return nucleus(&context)
    return fail(&context, token.column, "missing argument for {name}")

string delimiter(Parsing &context)
    lexer.Token token = take(&context)
    if (token.kind == "symbol" and lexer.has(["(", ")", "[", "]", "|", "."], token.value)) or (token.kind == "command" and lexer.has(["\{{", "\}}"], token.value))
        return token.value
    int ignored = fail(&context, token.column, "invalid delimiter")
    return ""

int element(Parsing &context)
    lexer.Token next = peek(context)
    int base = if next.kind == "^" or next.kind == "_" then add(&context, Node("row")) else nucleus(&context)
    if failed(context)
        return -1
    int | none sub = none
    int | none sup = none
    while peek(context).kind == "^" or peek(context).kind == "_"
        lexer.Token token = take(&context)
        bool duplicate = false
        int | none existing = if token.kind == "^" then sup else sub
        match existing
            int found
                duplicate = true
            none
                duplicate = false
        if duplicate
            return fail(&context, token.column, if token.kind == "^" then "double superscript" else "double subscript")
        int value = argument(&context, token.kind)
        if failed(context)
            return -1
        if token.kind == "^"
            sup = value
        else
            sub = value
    bool scripted = false
    match sub
        int found
            scripted = true
        none
            scripted = false
    match sup
        int found
            scripted = true
        none
            scripted = scripted
    return if scripted then add(&context, Node("script", children = [base], sub = sub, sup = sup)) else base

int[] parse_list(Parsing &context, bool top, bool root_index)
    int[] result = []
    while not failed(context)
        lexer.Token token = peek(context)
        if lexer.has(["}}", "&", "newline", "right", "end", "eof"], token.kind) or (root_index and token.kind == "symbol" and token.value == "]")
            return result
        if token.kind == "tag" or token.kind == "label"
            if not top
                int ignored = fail(&context, token.column, "misplaced \{token.kind}")
                return result
            lexer.Token | none previous = if token.kind == "tag" then context.tag else context.label
            match previous
                lexer.Token found
                    int ignored = fail(&context, token.column, "duplicate \{token.kind}")
                    return result
                none
                    if token.kind == "tag"
                        context.tag = token
                    else
                        context.label = token
            lexer.Token ignored = take(&context)
            continue
        int node = element(&context)
        if not failed(context)
            result = result.append(node)
    return result

int nucleus(Parsing &context)
    lexer.Token token = take(&context)
    if lexer.has(["identifier", "number", "symbol", "command", "text", "eqref"], token.kind)
        return add(&context, Node("atom", token.value, token.column, atom_kind = token.kind))
    if token.kind == "{{"
        int[] nodes = parse_list(&context)
        if failed(context)
            return -1
        if peek(context).kind != "}}"
            return unexpected(&context)
        lexer.Token ignored = take(&context)
        return collapse(&context, nodes)
    if lexer.has(["frac", "binom", "overset", "underset"], token.kind)
        int first = argument(&context, "\" + token.kind)
        if failed(context)
            return -1
        int second = argument(&context, "\" + token.kind)
        if failed(context)
            return -1
        return add(&context, Node(token.kind, children = [first, second]))
    if token.kind == "sqrt"
        int | none index = none
        lexer.Token next = peek(context)
        if next.kind == "symbol" and next.value == "["
            lexer.Token opening = take(&context)
            int[] nodes = parse_list(&context, false, true)
            if failed(context)
                return -1
            next = peek(context)
            if next.kind != "symbol" or next.value != "]"
                return fail(&context, opening.column, "missing ]")
            lexer.Token ignored = take(&context)
            index = collapse(&context, nodes)
        int body = argument(&context, "\sqrt")
        if failed(context)
            return -1
        match index
            int found
                return add(&context, Node("root", children = [found, body]))
            none
                return add(&context, Node("sqrt", children = [body]))
    if token.kind == "accent"
        int body = argument(&context, "\" + token.value)
        if failed(context)
            return -1
        return add(&context, Node("accent", token.value, children = [body]))
    if token.kind == "left"
        string left = delimiter(&context)
        if failed(context)
            return -1
        int[] nodes = parse_list(&context)
        if failed(context)
            return -1
        if peek(context).kind != "right"
            return fail(&context, token.column, "missing \right")
        lexer.Token closing = take(&context)
        string right = delimiter(&context)
        if failed(context)
            return -1
        int body = collapse(&context, nodes)
        return add(&context, Node("delim", column = closing.column, children = [body], left = left, right = right))
    if token.kind == "begin"
        int[][] rows = [[]]
        while true
            int[] elements = parse_list(&context)
            if failed(context)
                return -1
            int cell = collapse(&context, elements)
            int last = int(len(rows)) - 1
            rows[last] = rows[last].append(cell)
            lexer.Token closing = take(&context)
            if closing.kind == "&"
                continue
            if closing.kind == "newline"
                rows = rows.append([])
                continue
            if closing.kind == "end"
                if closing.value != token.value
                    return fail(&context, closing.column, "mismatched \end")
                break
            return fail(&context, token.column, "missing \end")
        int last = int(len(rows)) - 1
        if last > 0 and len(rows[last]) == 1
            Node cell = context.nodes[rows[last][0]]
            if cell.kind == "row" and len(cell.children) == 0
                rows = rows[0:<last]
        int width = 0
        for int[] row = rows[]
            if int(len(row)) > width
                width = int(len(row))
        for int row_index < int(len(rows))
            while int(len(rows[row_index])) < width
                int empty = add(&context, Node("row"))
                rows[row_index] = rows[row_index].append(empty)
        return add(&context, Node("matrix", token.value, rows = rows))
    return fail(&context, token.column, "unexpected end of input")

Formula | lexer.Problem parse(const lexer.Token[] tokens, int end_column)
    int[] braces = []
    for lexer.Token token = tokens[]
        if token.kind == "{{"
            braces = braces.append(token.column)
        elif token.kind == "}}"
            if len(braces) == 0
                return lexer.Problem(token.column, "unmatched }}")
            braces = braces[0:<int(len(braces)) - 1]
    if len(braces) > 0
        return lexer.Problem(braces[int(len(braces)) - 1], "unclosed {{")
    Parsing context = Parsing(tokens, end_column)
    int[] elements = parse_list(&context, true)
    if not failed(context) and peek(context).kind != "eof"
        int ignored = unexpected(&context)
    match context.problem
        lexer.Problem problem
            return problem
        none
            return Formula(context.nodes, elements, context.tag, context.label)
