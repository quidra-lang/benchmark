import lexer = "./lexer.qui"

class Child(string role, int x, int y, int box)
class Ink(int x, int y, string text)
class Box(int width, int height, int baseline, string description, Child[] children = [], Ink[] strings = [])
class Store(Box[] items = [])

int minimum(int first, int second)
    return if first < second then first else second

int maximum(int first, int second)
    return if first > second then first else second

string repeat(string text, int count)
    string result = ""
    for int iteration < count
        result += text
    return result

int add(Store &store, const Box box)
    int index = int(len(store.items))
    store.items = store.items.append(box)
    return index

int text_box(Store &store, string display, string description)
    return add(&store, Box(int(len(display)), 1, 0, description, strings = [Ink(0, 0, display)]))

void child(Box &parent, int box, int x, int y, string role = "")
    parent.children = parent.children.append(Child(role, x, y, box))

void ink(Box &parent, int x, int y, string text)
    parent.strings = parent.strings.append(Ink(x, y, text))

string[] delimiter(string text, int height)
    if text == "."
        return []
    string plain = if text == "\{{" then "{{" elif text == "\}}" then "}}" else text
    string[] result = array(nat(height), fill = plain)
    if height == 1
        return result
    if text == "(" or text == "\{{"
        result = array(nat(height), fill = "|")
        result[0] = "/"
        result[height - 1] = "\"
        if text == "\{{" and height >= 3
            result[(height - 1) / 2] = "<"
    elif text == ")" or text == "\}}"
        result = array(nat(height), fill = "|")
        result[0] = "\"
        result[height - 1] = "/"
        if text == "\}}" and height >= 3
            result[(height - 1) / 2] = ">"
    return result

void draw_delimiter(Box &parent, string text, int x)
    string[] glyph = delimiter(text, parent.height)
    for int y < int(len(glyph))
        ink(&parent, x, y, glyph[y])

string[] large(string name)
    return if name == "sum" then ["\--", " > ", "/--"] elif name == "prod" then ["___", "| |", "| |"] else [" /", " |", "/ "]

int atom_type(string kind, string value)
    if kind == "command"
        match lexer.symbol(value[1:<int(len(value))])
            lexer.Symbol found
                return found.type
            none
                return 0
    if kind != "symbol"
        return 0
    if lexer.has(["+", "-", "*"], value)
        return 2
    if lexer.has(["=", "<", ">", ":"], value)
        return 3
    if lexer.has(["(", "["], value)
        return 4
    if lexer.has([ ")", "]", "!"], value)
        return 5
    if lexer.has([",", ";"], value)
        return 6
    return 0
