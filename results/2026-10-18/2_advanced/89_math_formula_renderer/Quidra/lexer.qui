class Token(string kind, string value, int column)
class Problem(int column, string reason)
class Symbol(string display, int type)

bool has<T>(const T[] items, T sought)
    for T item = items[]
        if item == sought
            return true
    return false

string[] greek()
    return ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu", "nu", "xi", "pi", "rho", "sigma", "tau", "upsilon", "phi", "chi", "psi", "omega", "Gamma", "Delta", "Theta", "Lambda", "Xi", "Pi", "Sigma", "Upsilon", "Phi", "Psi", "Omega"]

Symbol | none symbol(string name)
    if has(greek(), name)
        return Symbol(name, 0)
    string[] names = ["cdot", "times", "pm", "mp", "leq", "geq", "neq", "approx", "to", "infty", "ldots", "cdots", "quad", ",", "{{", "}}"]
    string[] displays = ["*", "x", "+-", "-+", "<=", ">=", "!=", "~=", "->", "oo", "...", "...", "  ", " ", "{{", "}}"]
    int[] types = [2, 2, 2, 2, 3, 3, 3, 3, 3, 0, 0, 0, 0, 0, 4, 5]
    for int position < int(len(names))
        if names[position] == name
            return Symbol(displays[position], types[position])
    if has(["sin", "cos", "tan", "log", "ln", "exp", "det", "lim", "max", "min", "sum", "prod", "int"], name)
        return Symbol(name, 1)
    return none

bool letter(string character)
    return (character >= "a" and character <= "z") or (character >= "A" and character <= "Z")

bool digit(string character)
    return character >= "0" and character <= "9"

bool command_name(string name)
    if name == ""
        return false
    for int position < int(len(name))
        if not letter(name[position])
            return false
    match symbol(name)
        Symbol found
            return true
        none
            return false

Token[] | Problem lex(string text)
    Token[] result = []
    int position = 0
    while position < int(len(text))
        string character = text[position]
        int column = position + 1
        string kind = ""
        string value = ""
        if character == " "
            position += 1
            continue
        if letter(character)
            int start = position
            position += 1
            while position < int(len(text)) and letter(text[position])
                position += 1
            kind = "identifier"
            value = text[start:<position]
        elif digit(character)
            int start = position
            position += 1
            while position < int(len(text)) and digit(text[position])
                position += 1
            if position + 1 < int(len(text)) and text[position] == "." and digit(text[position + 1])
                position += 2
                while position < int(len(text)) and digit(text[position])
                    position += 1
            kind = "number"
            value = text[start:<position]
        elif "+-*/=<>:()[],;.!|'".contains(character)
            kind = "symbol"
            value = character
            position += 1
        elif "{{}}^_&".contains(character)
            kind = character
            value = character
            position += 1
        elif character == "\"
            position += 1
            if position < int(len(text)) and text[position] == "\"
                position += 1
                kind = "newline"
            elif position < int(len(text)) and "{{}},".contains(text[position])
                kind = "command"
                value = "\" + text[position]
                position += 1
            else
                int start = position
                while position < int(len(text)) and letter(text[position])
                    position += 1
                string name = text[start:<position]
                if name == ""
                    return Problem(column, "invalid command")
                if has(["text", "begin", "end", "tag", "label", "eqref"], name)
                    while position < int(len(text)) and text[position] == " "
                        position += 1
                    if position == int(len(text)) or text[position] != "{{"
                        return Problem(position + 1, "expected {{")
                    int finish = position + 1
                    while finish < int(len(text)) and text[finish] != "}}"
                        finish += 1
                    if finish == int(len(text))
                        return Problem(column, "unterminated argument")
                    value = text[position + 1:<finish]
                    position = finish + 1
                    kind = name
                    if has(["begin", "end"], name) and not has(["matrix", "pmatrix", "bmatrix", "vmatrix", "cases"], value)
                        return Problem(column, "unknown environment {DQ}{value}{DQ}")
                elif command_name(name)
                    kind = "command"
                    value = "\" + name
                elif has(["overline", "hat", "vec", "dot", "tilde", "overbrace", "underbrace"], name)
                    kind = "accent"
                    value = name
                elif has(["frac", "binom", "overset", "underset", "sqrt", "left", "right"], name)
                    kind = name
                else
                    return Problem(column, "unknown command \{name}")
        else
            return Problem(column, "invalid character {character}")
        result = result.append(Token(kind, value, column))
    return result
