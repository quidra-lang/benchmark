import boxes = "./boxes.qui"

class Description(string[] lines = [], map.Map<string, int> kinds = map.Map<string, int>(), int depth = 0)

string trim_end(string text)
    int finish = int(len(text))
    while finish > 0 and text[finish - 1] == " "
        finish -= 1
    return text[0:<finish]

void paint(const boxes.Store store, int index, int x, int y, string[][] &grid)
    boxes.Box box = store.items[index]
    for boxes.Ink entry = box.strings[]
        for int position < int(len(entry.text))
            string character = entry.text[position]
            if character != " "
                grid[y + entry.y][x + entry.x + position] = character
    for boxes.Child entry = box.children[]
        paint(store, entry.box, x + entry.x, y + entry.y, &grid)

void visit(const boxes.Store store, int index, int x, int y, int level, string role, Description &result)
    boxes.Box box = store.items[index]
    result.lines = result.lines.append(boxes.repeat(" ", level * 2) + role + "{box.description} x={x} y={y} w={box.width} h={box.height} b={box.baseline}")
    string[] words = box.description.split(" ")
    int previous = 0
    match result.kinds.get(words[0])
        int found
            previous = found
        none
            previous = 0
    .result.kinds.set(words[0], previous + 1)
    result.depth = boxes.maximum(result.depth, level + 1)
    for boxes.Child entry = box.children[]
        visit(store, entry.box, x + entry.x, y + entry.y, level + 1, entry.role, &result)

Description describe(const boxes.Store store, const boxes.Child[] roots)
    Description result = Description()
    for boxes.Child entry = roots[]
        visit(store, entry.box, entry.x, entry.y, 0, "", &result)
    return result

string[] lines(const string[][] grid)
    string[] result = []
    for string[] row = grid[]
        result = result.append(trim_end(row.join("")))
    return result
