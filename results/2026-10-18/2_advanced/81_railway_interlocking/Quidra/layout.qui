class Section(string name, int length, int row, int first, int last)
    bool failed = false
    int[] occupants = []
    int occupied_seconds = 0
    int locked_seconds = 0
    set.Set<int> trains = set.Set<int>()

class Point(string name, string side, int common, int normal, int reverse, int row, int column)
    string position = "N"
    bool moving = false
    bool failed = false
    string target = "N"
    int completion = -1
    int throws = 0
    int locked_seconds = 0
    int moving_seconds = 0

class Signal(string name, int section, string direction, int row, int column)
    string aspect = "RED"
    int[] seconds = [0, 0, 0]
    int passes = 0

class Endpoint(string name, int section, string end, int row = 0, int column = 0)
class Label(int row, int column, string text)
class Connection(string kind, int index)

class Network()
    Section[] sections = []
    Point[] points = []
    Signal[] signals = []
    Endpoint[] buffers = []
    Endpoint[] boundaries = []
    Label[] labels = []
    Connection[][] ends = []
    map.Map<string, int> section_ids = map.Map<string, int>()
    map.Map<string, int> point_ids = map.Map<string, int>()
    map.Map<string, int> signal_ids = map.Map<string, int>()
    map.Map<string, int> buffer_ids = map.Map<string, int>()
    map.Map<string, int> boundary_ids = map.Map<string, int>()

int lookup_index(map.Map<string, int> ids, string name)
    match ids.get(name)
        int index
            return index
        none
            return -1

string[] read_lines(string filename)
    string content = file.read("input/" + filename)
    string[] rows = content.split(NL)
    return rows[0:<int(len(rows)) - 1]

Network read_layout()
    Network result = Network()
    for string row = read_lines("layout.txt")[]
        string[] fields = row.split(" ")
        string kind = fields[0]
        if kind == "SECTION"
            int index = int(len(result.sections))
            .result.section_ids.set(fields[1], index)
            result.sections = result.sections.append(Section(fields[1], int.parse(fields[2]), int.parse(fields[3]), int.parse(fields[4]), int.parse(fields[5])))
            result.ends = result.ends.append([Connection("", -1), Connection("", -1)])
        elif kind == "JOINT"
            int first = lookup_index(result.section_ids, fields[1])
            int second = lookup_index(result.section_ids, fields[2])
            result.ends[first][1] = Connection("section", second)
            result.ends[second][0] = Connection("section", first)
        elif kind == "POINT"
            int index = int(len(result.points))
            .result.point_ids.set(fields[1], index)
            int common = lookup_index(result.section_ids, fields[3])
            int normal = lookup_index(result.section_ids, fields[4])
            int reverse = lookup_index(result.section_ids, fields[5])
            result.points = result.points.append(Point(fields[1], fields[2], common, normal, reverse, int.parse(fields[6]), int.parse(fields[7])))
            int side = if fields[2] == "R" then 1 else 0
            result.ends[common][side] = Connection("point", index)
            result.ends[normal][1 - side] = Connection("point", index)
            result.ends[reverse][1 - side] = Connection("point", index)
        elif kind == "SIGNAL"
            .result.signal_ids.set(fields[1], int(len(result.signals)))
            result.signals = result.signals.append(Signal(fields[1], lookup_index(result.section_ids, fields[2]), fields[3], int.parse(fields[4]), int.parse(fields[5])))
        elif kind == "BUFFER" or kind == "BOUNDARY"
            int section = lookup_index(result.section_ids, fields[2])
            int side = if fields[3] == "R" then 1 else 0
            if kind == "BUFFER"
                int index = int(len(result.buffers))
                .result.buffer_ids.set(fields[1], index)
                result.buffers = result.buffers.append(Endpoint(fields[1], section, fields[3], int.parse(fields[4]), int.parse(fields[5])))
                result.ends[section][side] = Connection("buffer", index)
            else
                int index = int(len(result.boundaries))
                .result.boundary_ids.set(fields[1], index)
                result.boundaries = result.boundaries.append(Endpoint(fields[1], section, fields[3]))
                result.ends[section][side] = Connection("boundary", index)
        else
            result.labels = result.labels.append(Label(int.parse(fields[1]), int.parse(fields[2]), fields[3]))
    return result

Connection beyond_end(Network network, int section, string direction)
    Connection connection = network.ends[section][if direction == "UP" then 1 else 0]
    if connection.kind != "point"
        return connection
    Point point = network.points[connection.index]
    int branch = if point.position == "N" then point.normal else point.reverse
    if point.moving or (section != point.common and section != branch)
        return Connection("impassable", -1)
    return Connection("section", if section == point.common then branch else point.common)

int signal_at(Network network, int section, string direction)
    for int i < int(len(network.signals))
        if network.signals[i].section == section and network.signals[i].direction == direction
            return i
    return -1

bool track_occupied(Network network, int section)
    return network.sections[section].failed or len(network.sections[section].occupants) > 0
