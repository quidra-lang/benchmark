import layout = "./layout.qui"
import interlocking = "./interlocking.qui"

class Stop(string kind, int section, int dwell, int scheduled_arrival, int scheduled_departure)
    int arrival = -1
    int departure = -1

class PathSection(int section, int start)
class BodyPart(int section, int start, int low, int high)
class PlannedRequest(int tick, int train, int route)

class Train(string name, string symbol, int length, int acceleration, int deceleration, int max_speed, int entry, int entry_time, int entry_speed)
    int exit = -1
    int scheduled_exit = 0
    Stop[] stops = []
    int stop_index = 0
    string state = "WAITING"
    string direction = "UP"
    PathSection[] path = []
    int head = 0
    int speed = 0
    bool dwelling = false
    int awaiting_departure = -1
    bool emergency = false
    int boundary = -1
    int boundary_coordinate = -1
    int entered = -1
    int exited = -1
    int distance = 0
    int maximum_speed = 0
    int standing = 0
    int passes = 0

class Plans(Train[] trains, PlannedRequest[] requests)

Plans read_plans(layout.Network network, interlocking.State state)
    Train[] items = []
    PlannedRequest[] requests = []
    map.Map<string, int> ids = map.Map<string, int>()
    string symbols = "abcdefghijklmnopqrstuvwxyz"
    for string row = layout.read_lines("trains.txt")[]
        string[] fields = row.split(" ")
        if fields[0] == "TRAIN"
            int index = int(len(items))
            .ids.set(fields[1], index)
            items = items.append(Train(fields[1], symbols[index], int.parse(fields[2]), int.parse(fields[3]), int.parse(fields[4]), int.parse(fields[5]), layout.lookup_index(network.boundary_ids, fields[6]), int.parse(fields[7]), int.parse(fields[8])))
        else
            int index = layout.lookup_index(ids, fields[1])
            if fields[0] == "REQUEST"
                requests = requests.append(PlannedRequest(int.parse(fields[3]), index, layout.lookup_index(state.route_ids, fields[2])))
            elif fields[0] == "STOP" or fields[0] == "TURN"
                items[index].stops = items[index].stops.append(Stop(fields[0], layout.lookup_index(network.section_ids, fields[2]), int.parse(fields[3]), int.parse(fields[4]), int.parse(fields[5])))
            else
                items[index].exit = layout.lookup_index(network.boundary_ids, fields[2])
                items[index].scheduled_exit = int.parse(fields[3])
    return Plans(items, requests)

int braking_distance(int speed, int deceleration)
    int count = speed / deceleration
    return count * speed - deceleration * count * (count + 1) / 2

int select_speed(Train train, int distance)
    int low = train.speed - train.deceleration
    if low < 0
        low = 0
    if not train.emergency
        int high = train.speed + train.acceleration
        if high > train.max_speed
            high = train.max_speed
        for high >= int speed >= low
            if distance < 0 or speed + braking_distance(speed, train.deceleration) <= distance
                return speed
    return low
