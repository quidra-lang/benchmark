import layout = "./layout.qui"

class Requirement(int point, string position)
class PointLock(int route, string position)
class Route(string name, int start, string finish_name, string finish_kind, int finish_index, Requirement[] requirements, int[] sections, int[] overlap, string[] conflict_names, int approach_time, string direction)
    int[] conflicts = []
    string state = "none"
    int release_time = -1
    set.Set<int> passed = set.Set<int>()
    bool overlap_locked = false
    int overlap_counter = 0
    int requests = 0
    int grants = 0
    int uses = 0
    int cancels = 0
    int wait = 0
    int maxwait = 0
    int locked_seconds = 0

class State(Route[] routes, map.Map<string, int> route_ids, int[] route_locks, int[][] overlap_locks, PointLock[][] point_locks)

string[] name_list(string text)
    return if text == "-" then [] else text.split(",")

Requirement[] parse_requirements(string text, layout.Network network)
    Requirement[] result = []
    for string item = name_list(text)[]
        string[] pieces = item.split(":")
        result = result.append(Requirement(layout.lookup_index(network.point_ids, pieces[0]), pieces[1]))
    return result

State read_routes(layout.Network network)
    Route[] routes = []
    map.Map<string, int> ids = map.Map<string, int>()
    for string row = layout.read_lines("routes.txt")[]
        string[] fields = row.split(" ")
        int start = layout.lookup_index(network.signal_ids, fields[2])
        string finish_kind = "boundary"
        int finish_index = layout.lookup_index(network.boundary_ids, fields[3])
        if network.signal_ids.has(fields[3])
            finish_kind = "signal"
            finish_index = layout.lookup_index(network.signal_ids, fields[3])
        elif network.buffer_ids.has(fields[3])
            finish_kind = "buffer"
            finish_index = layout.lookup_index(network.buffer_ids, fields[3])
        Requirement[] requirements = parse_requirements(fields[4], network).concat(parse_requirements(fields[7], network))
        int[] sections = [for string name = name_list(fields[5])[] then layout.lookup_index(network.section_ids, name)]
        int[] overlap = [for string name = name_list(fields[6])[] then layout.lookup_index(network.section_ids, name)]
        .ids.set(fields[1], int(len(routes)))
        routes = routes.append(Route(fields[1], start, fields[3], finish_kind, finish_index, requirements, sections, overlap, name_list(fields[8]), int.parse(fields[9]), network.signals[start].direction))
    for int i < int(len(routes))
        routes[i].conflicts = [for string name = routes[i].conflict_names[] then layout.lookup_index(ids, name)]
    int[] route_locks = array(len(network.sections), fill = -1)
    int[][] overlap_locks = []
    for int i < int(len(network.sections))
        overlap_locks = overlap_locks.append([])
    PointLock[][] point_locks = []
    for int i < int(len(network.points))
        point_locks = point_locks.append([])
    return State(routes, ids, route_locks, overlap_locks, point_locks)

void lock_route(State &state, int route_index)
    Route &route = &state.routes[route_index]
    route.state = "LOCKED"
    route.release_time = -1
    route.passed = set.Set<int>()
    route.overlap_locked = true
    route.overlap_counter = 0
    for int section = route.sections[]
        state.route_locks[section] = route_index
    for int section = route.overlap[]
        state.overlap_locks[section] = state.overlap_locks[section].append(route_index)
    for Requirement requirement = route.requirements[]
        bool exists = false
        for PointLock held = state.point_locks[requirement.point][]
            if held.route == route_index and held.position == requirement.position
                exists = true
        if not exists
            state.point_locks[requirement.point] = state.point_locks[requirement.point].append(PointLock(route_index, requirement.position))

void unlock_points(State &state, layout.Network network, int route_index, int[] sections, bool all_points = false)
    for int p < int(len(network.points))
        bool selected = all_points
        for int section = sections[]
            if network.points[p].common == section
                selected = true
        if selected
            state.point_locks[p] = [for PointLock held = state.point_locks[p][] if held.route != route_index then held]

void unlock_section(State &state, layout.Network network, int route_index, int section)
    if state.route_locks[section] == route_index
        state.route_locks[section] = -1
    unlock_points(&state, network, route_index, [section])

void unlock_overlap(State &state, layout.Network network, int route_index)
    int[] sections = state.routes[route_index].overlap
    for int section = sections[]
        state.overlap_locks[section] = [for int held = state.overlap_locks[section][] if held != route_index then held]
    unlock_points(&state, network, route_index, sections)
    state.routes[route_index].overlap_locked = false

void release_route(State &state, layout.Network network, int route_index)
    for int section = state.routes[route_index].sections[]
        if state.route_locks[section] == route_index
            state.route_locks[section] = -1
    if state.routes[route_index].overlap_locked
        unlock_overlap(&state, network, route_index)
    unlock_points(&state, network, route_index, [], true)
    state.routes[route_index].state = "none"
    state.routes[route_index].release_time = -1
