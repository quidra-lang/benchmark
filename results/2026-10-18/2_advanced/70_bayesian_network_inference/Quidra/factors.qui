import learning = "./learning.qui"

bool includes(int[] variables, int wanted)
    for int variable = variables[]
        if variable == wanted
            return true
    return false

int entry_count(int[] variables, int[] sizes)
    int result = 1
    for int variable = variables[]
        result *= sizes[variable]
    return result

int[][] assignments(int[] variables, int[] sizes)
    int count = entry_count(variables, sizes)
    int[][] result = []
    for int index < count
        int[] assignment = [for int i < int(len(sizes)) then -1]
        int remaining = index
        int position = int(len(variables)) - 1
        while position >= 0
            int variable = variables[position]
            assignment[variable] = remaining % sizes[variable]
            remaining /= sizes[variable]
            position -= 1
        result = result.append(assignment)
    return result

class Factor(int[] variables, real64[] values, int[] sizes)
    real64 value(int[] assignment)
        int index = 0
        for int variable = variables[]
            index = index * sizes[variable] + assignment[variable]
        return values[index]

    Factor reduced(int[] evidence)
        int[] retained = [for int variable = variables[] if evidence[variable] < 0 then variable]
        real64[] result = []
        for int[] assignment = assignments(retained, sizes)[]
            for int variable < int(len(sizes))
                if evidence[variable] >= 0
                    assignment[variable] = evidence[variable]
            result = result.append(value(assignment))
        return Factor(retained, result, sizes)

    Factor multiplied(Factor other)
        int[] joined = [for int variable < int(len(sizes)) if includes(variables, variable) or includes(other.variables, variable) then variable]
        real64[] result = []
        for int[] assignment = assignments(joined, sizes)[]
            result = result.append(value(assignment) * other.value(assignment))
        return Factor(joined, result, sizes)

    Factor eliminate(int variable, bool maximize)
        int[] retained = [for int item = variables[] if item != variable then item]
        real64[] result = []
        for int[] assignment = assignments(retained, sizes)[]
            real64[] candidates = []
            for int state < sizes[variable]
                assignment[variable] = state
                candidates = candidates.append(value(assignment))
            real64 reduced_value = candidates[0]
            for 1 <= int state < sizes[variable]
                if maximize
                    if candidates[state] > reduced_value
                        reduced_value = candidates[state]
                else
                    reduced_value += candidates[state]
            result = result.append(reduced_value)
        return Factor(retained, result, sizes)

Factor cpt_factor(int variable, int[] parents, real64[][] cpt, int[] sizes)
    int[] variables = parents.append(variable).sorted()
    real64[] values = [for int[] assignment = assignments(variables, sizes)[] then cpt[learning.parent_row(parents, assignment, sizes)][assignment[variable]]]
    return Factor(variables, values, sizes)

Factor multiply(Factor[] values, int[] sizes)
    if len(values) == 0
        return Factor([], [1.0], sizes)
    Factor result = values[0]
    for 1 <= int i < int(len(values))
        result = result.multiplied(values[i])
    return result
