int integer(string text)
    int value = int.parse(text)
    return value

real64 number(string text)
    real64 value = real64.parse(text)
    return value

string[] read_lines(string path)
    string text = file.read(path)
    string[] lines = text.split(NL)
    return lines[0:<int(len(lines)) - 1]

int name_index(string[] names, string wanted)
    for int i < int(len(names))
        if names[i] == wanted
            return i
    return -1

class Network(string[] names, string[][] states, int[][] parents, real64[][][] expert)
class Params(real64 alpha, bool minfill, int[] order, int enumeration_limit, int seed, bool[] learned)
class Input(Network network, int[][] samples, string[] queries, Params params)

Network read_network()
    string[] lines = []
    for string line = read_lines("input/network.txt")[]
        if line != "" and line[0] != "#"
            lines = lines.append(line)
    string[] names = []
    string[][] states = []
    int[][] parents = []
    real64[][][] expert = []
    int position = 0
    while position < int(len(lines))
        string[] fields = lines[position].split(" ")
        position += 1
        if fields[0] == "VARIABLE"
            names = names.append(fields[1])
            states = states.append(fields[2:<int(len(fields))])
            parents = parents.append([])
            expert = expert.append([])
        elif fields[0] == "PARENTS"
            parents[name_index(names, fields[1])] = [for string name = fields[2:<int(len(fields))][] then name_index(names, name)]
        else
            int variable = name_index(names, fields[1])
            int rows = 1
            for int parent = parents[variable][]
                rows *= int(len(states[parent]))
            expert[variable] = [for position <= int i < position + rows then [for string value = lines[i].split(" ")[] then number(value)]]
            position += rows
    return Network(names, states, parents, expert)

Input read_inputs()
    Network network = read_network()
    string[][] settings = [for string line = read_lines("input/params.txt")[] then line.split(" ")]
    Params params = Params(number(settings[0][1]), settings[1][1] == "MINFILL", [for string name = settings[2][1:<int(len(settings[2]))][] then name_index(network.names, name)], integer(settings[3][1]), integer(settings[4][1]), [for int i < int(len(network.names)) then settings[5 + i][2] == "LEARNED"])
    string[] lines = read_lines("input/samples.csv")
    int[] columns = [for string name = lines[0].split(",")[] then name_index(network.names, name)]
    int[][] samples = []
    for string line = lines[1:<int(len(lines))][]
        string[] fields = line.split(",")
        int[] sample = [for int i < int(len(network.names)) then 0]
        for int c < int(len(columns))
            int variable = columns[c]
            sample[variable] = name_index(network.states[variable], fields[c])
        samples = samples.append(sample)
    return Input(network, samples, read_lines("input/queries.txt"), params)
