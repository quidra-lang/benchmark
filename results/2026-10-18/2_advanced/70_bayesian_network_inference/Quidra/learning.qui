import math

real64 ordered_sum(real64[] values)
    if len(values) == 0
        return 0.0
    real64 result = values[0]
    for 1 <= int i < int(len(values))
        result += values[i]
    return result

int parent_row(int[] parents, int[] assignment, int[] sizes)
    int row = 0
    for int parent = parents[]
        row = row * sizes[parent] + assignment[parent]
    return row

int[][] count_samples(int variable, int[] parents, int[][] samples, int[] sizes)
    int rows = 1
    for int parent = parents[]
        rows *= sizes[parent]
    int[][] counts = [for int row < rows then [for int state < sizes[variable] then 0]]
    for int[] sample = samples[]
        counts[parent_row(parents, sample, sizes)][sample[variable]] += 1
    return counts

real64[][] learn(int[][] counts, real64 alpha)
    real64[][] result = []
    for int[] row = counts[]
        real64 denominator = ordered_sum([for int count = row[] then real64(count) + alpha])
        result = result.append([for int count = row[] then (real64(count) + alpha) / denominator])
    return result

real64 log_likelihood(int[][] counts, real64[][] cpt)
    real64[] terms = []
    for int row < int(len(counts))
        for int state < int(len(counts[row]))
            if counts[row][state] != 0
                real64 logarithm = math.log(cpt[row][state])
                terms = terms.append(real64(counts[row][state]) * logarithm)
    return ordered_sum(terms)

int parameter_count(int[][] counts)
    return (int(len(counts[0])) - 1) * int(len(counts))

real64 family_score(int variable, int[] parents, int[][] samples, int[] sizes, real64 alpha)
    int[][] counts = count_samples(variable, parents.sorted(), samples, sizes)
    real64[][] cpt = learn(counts, alpha)
    real64 logarithm = math.log(real64(len(samples)))
    return log_likelihood(counts, cpt) - real64(parameter_count(counts)) * logarithm / 2.0
