int integer(string text)
    int value = int.parse(text)
    return value

real64 number(string text)
    real64 value = real64.parse(text)
    return value

string[] lines(string path)
    string text = file.read(path)
    string[] rows = text.split(NL)
    return rows[0:<int(len(rows)) - 1]

bool leap(int year)
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

int[] month_lengths(int year)
    return [31, if leap(year) then 29 else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

int ordinal(int year, int month, int day)
    int previous = year - 1
    int result = 365 * previous + previous / 4 - previous / 100 + previous / 400 + day - 1
    int[] months = month_lengths(year)
    for int m < month - 1
        result += months[m]
    return result

int absolute_minute(string text)
    int year = integer(text[0:<4])
    int month = integer(text[5:<7])
    int day = integer(text[8:<10])
    int hour = integer(text[11:<13])
    int minute = integer(text[14:<16])
    return ordinal(year, month, day) * 1440 + hour * 60 + minute

string padded(int value, int width)
    string text = value.string()
    return string.repeat("0", nat(width - int(len(text)))) + text

string datetime_at_minute(int epoch, int minute)
    int instant = epoch + minute
    int day = instant / 1440
    int within = instant % 1440
    int year = day / 365 + 1
    while ordinal(year, 1, 1) > day
        year -= 1
    while ordinal(year + 1, 1, 1) <= day
        year += 1
    int remaining = day - ordinal(year, 1, 1)
    int[] months = month_lengths(year)
    int month = 0
    while remaining >= months[month]
        remaining -= months[month]
        month += 1
    return padded(year, 4) + "-" + padded(month + 1, 2) + "-" + padded(remaining + 1, 2) + " " + padded(within / 60, 2) + ":" + padded(within % 60, 2)

string datetime_at_hour(int epoch, int hour)
    return datetime_at_minute(epoch, 60 * hour)

string date_at_minute(int epoch, int minute)
    return datetime_at_minute(epoch, minute)[0:<10]

int millimetres(string text)
    bool negative = text[0] == "-"
    string magnitude = if negative then text[1:<int(len(text))] else text
    string[] parts = magnitude.split(".")
    int result = 1000 * integer(parts[0]) + integer(parts[1])
    return if negative then -result else result

class Observation(int hour, bool numeric, int value)
class Station(string code, string name, Observation[] observations)
class Constituent(string name, real64 speed)
class Params(int epoch, string reference, int flat_run, int spike_window, int spike_minimum, real64 spike_factor, real64 spike_floor, real64 rayleigh, real64 snr_min, int top_residuals, real64 surge_threshold, int surge_hours, int prediction_start, int prediction_hours, int grid_minutes, real64 min_range, int correlation_lag, string plot_code, int plot_hours, int plot_top, int plot_bottom, int plot_step)
class Input(Params params, Station[] stations, Constituent[] constituents)

Input read_inputs()
    string[] rows = lines("input/params.txt")
    int epoch = absolute_minute(rows[0][6:<int(len(rows[0]))])
    Station[] stations = []
    int cursor = 1
    while rows[cursor][0:<8] == "station "
        string[] fields = rows[cursor].split(" ")
        stations = stations.append(Station(fields[1], fields[2:<int(len(fields))].join(" "), []))
        cursor += 1
    string[][] settings = [for string row = rows[cursor:<int(len(rows))][] then row.split(" ")]
    int prediction_start = (absolute_minute(settings[7][1] + " " + settings[7][2]) - epoch) / 60
    Params params = Params(epoch, settings[0][1], integer(settings[1][1]), integer(settings[2][1]), integer(settings[2][2]), number(settings[2][3]), number(settings[2][4]), number(settings[3][1]), number(settings[4][1]), integer(settings[5][1]), number(settings[6][1]), integer(settings[6][2]), prediction_start, integer(settings[7][3]), integer(settings[8][1]), number(settings[9][1]), integer(settings[10][1]), settings[11][1], integer(settings[11][2]), integer(settings[11][3]), integer(settings[11][4]), integer(settings[11][5]))
    Constituent[] constituents = []
    rows = lines("input/constituents.txt")
    for string row = rows[1:<int(len(rows))][]
        string[] fields = row.split(" ")
        constituents = constituents.append(Constituent(fields[0], number(fields[1])))
    rows = lines("input/observations.csv")
    for string row = rows[1:<int(len(rows))][]
        string[] fields = row.split(",")
        int hour = (absolute_minute(fields[1]) - epoch) / 60
        bool numeric = fields[2] != "NA"
        Observation observation = Observation(hour, numeric, if numeric then millimetres(fields[2]) else 0)
        for int i < int(len(stations))
            if stations[i].code == fields[0]
                stations[i].observations = stations[i].observations.append(observation)
                break
    return Input(params, stations, constituents)
