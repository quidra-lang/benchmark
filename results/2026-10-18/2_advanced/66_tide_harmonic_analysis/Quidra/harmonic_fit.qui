import math

const real64 pi = 3.141592653589793

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

real64 arctangent(real64 value)
    bool invert = value > 1.0
    real64 z = if invert then 1.0 / value else value
    bool reduce = z > 0.41421356237309503
    if reduce
        z = (z - 1.0) / (z + 1.0)
    real64 squared = z * z
    real64 power = z
    real64 result = 0.0
    for int j < 40
        result += power / real64(2 * j + 1)
        power *= -squared
    if reduce
        result += pi / 4.0
    return if invert then pi / 2.0 - result else result

real64 phase(real64 a, real64 b)
    real64 radians = 0.0
    if a == 0.0
        radians = if b >= 0.0 then pi / 2.0 else -pi / 2.0
    else
        real64 ratio = b / a
        radians = arctangent(absolute(ratio))
        if ratio < 0.0
            radians = -radians
        if a < 0.0
            radians += if b >= 0.0 then pi else -pi
    real64 degrees = radians * 180.0 / pi
    return if degrees < 0.0 then degrees + 360.0 else degrees

real64 angle(real64 speed, real64 hour)
    real64 degrees = speed * hour
    int turns = math.floor(degrees / 360.0)
    real64 reduced = degrees - 360.0 * real64(turns)
    return reduced * pi / 180.0

real64[] regressors(real64 hour, real64[] speeds)
    real64[] result = [1.0]
    for real64 speed = speeds[]
        real64 theta = angle(speed, hour)
        result = result.concat([math.cos(theta), math.sin(theta)])
    return result

class Model(real64[] coefficients, real64[][] inverse, real64[] amplitudes, real64[] phases)

Model fit(real64[] values, int[] times, real64[] speeds)
    int dimension = 2 * int(len(speeds)) + 1
    real64[][] matrix = [for int i < dimension then [for int j < dimension then 0.0]]
    real64[] right = [for int i < dimension then 0.0]
    for int t = times[]
        real64[] vector = regressors(real64(t), speeds)
        for int i < dimension
            right[i] += vector[i] * values[t]
            for int j < dimension
                matrix[i][j] += vector[i] * vector[j]
    real64[][] augmented = [for int i < dimension then matrix[i].append(right[i]).concat([for int j < dimension then (if i == j then 1.0 else 0.0)])]
    for int column < dimension
        int pivot = column
        for column + 1 <= int i < dimension
            if absolute(augmented[i][column]) > absolute(augmented[pivot][column])
                pivot = i
        if pivot != column
            real64[] previous = augmented[column]
            augmented[column] = augmented[pivot]
            augmented[pivot] = previous
        for column + 1 <= int row < dimension
            real64 factor = augmented[row][column] / augmented[column][column]
            for column <= int c <= 2 * dimension
                augmented[row][c] -= factor * augmented[column][c]
    real64[][] solutions = []
    for dimension <= int column <= 2 * dimension
        real64[] solution = [for int i < dimension then 0.0]
        int row = dimension - 1
        while row >= 0
            real64 current = augmented[row][column]
            for row + 1 <= int j < dimension
                current -= augmented[row][j] * solution[j]
            solution[row] = current / augmented[row][row]
            row -= 1
        solutions = solutions.append(solution)
    real64[] coefficients = solutions[0]
    real64[][] inverse = [for int row < dimension then [for int column < dimension then solutions[column + 1][row]]]
    real64[] amplitudes = []
    real64[] phases = []
    for int k < int(len(speeds))
        real64 a = coefficients[2 * k + 1]
        real64 b = coefficients[2 * k + 2]
        real64 amplitude = math.sqrt(a * a + b * b)
        amplitudes = amplitudes.append(amplitude)
        phases = phases.append(phase(a, b))
    return Model(coefficients, inverse, amplitudes, phases)
