import math

string fmt(real64 value, int places)
    factor := 10 ^ places
    magnitude := if value < 0.0 then -value else value
    rounded := math.floor(magnitude * real64(factor) + 0.5)
    tail := (rounded % factor).string()
    sign := if value < 0.0 and rounded != 0 then "-" else ""
    return sign + (rounded / factor).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

void write(string name, string[] rows)
    writer1 := file.write("output/" + name)
    .writer1(rows.join(NL) + NL)

string[] plot_lines(int top, int step, string[][] cells)
    labels := [for row := (0:<int(len(cells)))[] then fmt(real64(top - row * step) / 100.0, 2)]
    width := 0
    for label := labels[]
        if int(len(label)) > width
            width = int(len(label))
    string[] lines := []
    for: row < int(len(cells))
        lines = lines.append(string.repeat(" ", nat(width - int(len(labels[row])))) + labels[row] + " |" + cells[row].join("") + "|")
    ticks := [for column := (0:<int(len(cells[0])))[] then (if column % 6 == 0 then "+" else "-")].join("")
    return lines.append(string.repeat(" ", nat(width + 1)) + "+" + ticks + "+")
