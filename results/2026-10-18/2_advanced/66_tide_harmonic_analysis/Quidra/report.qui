import math

string fmt(real64 value, int places)
    factor := 10 ^ places
    magnitude := if value < 0.0 then -value else value
    rounded := math.floor(magnitude * real64(factor) + 0.5)
    tail := string(rounded % factor)
    sign := if value < 0.0 and rounded != 0 then "-" else ""
    return sign + string(rounded / factor) + "." + "0" * nat(places - int(tail.len())) + tail

void write(string name, string[] rows)
    writer1 := file.write("output/" + name)
    .writer1(rows.join(NL) + NL)

string[] plot_lines(int top, int step, string[][] cells)
    labels := [for row := (0:<int(cells.len()))[] then fmt(real64(top - row * step) / 100.0, 2)]
    width := 0
    for label := labels[]
        if int(label.len()) > width
            width = int(label.len())
    string[] lines := []
    for: row < int(cells.len())
        lines = lines.append(" " * nat(width - int(labels[row].len())) + labels[row] + " |" + cells[row].join("") + "|")
    ticks := [for column := (0:<int(cells[0].len()))[] then (if column % 6 == 0 then "+" else "-")].join("")
    return lines.append(" " * nat(width + 1) + "+" + ticks + "+")
