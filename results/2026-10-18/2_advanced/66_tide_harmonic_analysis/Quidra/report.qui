import math

string fmt(real64 value, int places)
    int factor = 10 ^ places
    real64 magnitude = if value < 0.0 then -value else value
    int rounded = math.floor(magnitude * real64(factor) + 0.5)
    string tail = (rounded % factor).string()
    string sign = if value < 0.0 and rounded != 0 then "-" else ""
    return sign + (rounded / factor).string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

void write(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)

string[] plot_lines(int top, int step, string[][] cells)
    string[] labels = [for int row < int(len(cells)) then fmt(real64(top - row * step) / 100.0, 2)]
    int width = 0
    for string label = labels[]
        if int(len(label)) > width
            width = int(len(label))
    string[] lines = []
    for int row < int(len(cells))
        lines = lines.append(string.repeat(" ", nat(width - int(len(labels[row])))) + labels[row] + " |" + cells[row].join("") + "|")
    string ticks = [for int column < int(len(cells[0])) then (if column % 6 == 0 then "+" else "-")].join("")
    return lines.append(string.repeat(" ", nat(width + 1)) + "+" + ticks + "+")
