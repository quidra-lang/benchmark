import math
import records = "./records.qui"
import cleaning = "./cleaning.qui"
import harmonic_fit = "./harmonic_fit.qui"
import predict = "./predict.qui"
import report = "./report.qui"

const string[] reason_names = ["usable", "absent", "na", "flat", "spike", "mixed"]
const int[] doodson = [0, 2, 1, 1, 2, 0, 1, 1, 0, 2, 0, 1, 1, 0, 1, 0, 0, 1, 0, 1]
const string[] compared_names = ["M2", "S2", "K1", "O1"]

real64 absolute(real64 value)
    return if value < 0.0 then -value else value

int integer_absolute(int value)
    return if value < 0 then -value else value

real64 total(real64[] values)
    if len(values) == 0
        return 0.0
    real64 result = values[0]
    for 1 <= int i < int(len(values))
        result += values[i]
    return result

real64 mean(real64[] values)
    return total(values) / real64(len(values))

real64 rms(real64[] values)
    real64 result = math.sqrt(total([for real64 value = values[] then value * value]) / real64(len(values)))
    return result

int largest(real64[] values)
    int best = 0
    for int i < int(len(values))
        if values[i] > values[best]
            best = i
    return best

int smallest(real64[] values)
    int best = 0
    for int i < int(len(values))
        if values[i] < values[best]
            best = i
    return best

class Selection(int[] indices, string[] statuses, string[] names, real64[] speeds)

Selection select_constituents(records.Constituent[] constituents, int duration, real64 rayleigh)
    int[] indices = []
    string[] statuses = []
    real64 limit = 360.0 * rayleigh
    for int i < int(len(constituents))
        real64 speed = constituents[i].speed
        string status = "fitted"
        if speed * real64(duration) < limit
            status = "short"
        else
            for int j = indices[]
                if absolute(speed - constituents[j].speed) * real64(duration) < limit
                    status = "conflict:" + constituents[j].name
                    break
        statuses = statuses.append(status)
        if status == "fitted"
            indices = indices.append(i)
    return Selection(indices, statuses, [for int i = indices[] then constituents[i].name], [for int i = indices[] then constituents[i].speed])

int named_index(string[] names, string wanted)
    for int i < int(len(names))
        if names[i] == wanted
            return i
    return -1

class Constant(string name, real64 speed, real64 amplitude, real64 phase, real64 amplitude_error, real64 phase_error, real64 snr)

Constant[] fitted_constants(Selection selection, harmonic_fit.Model model, real64 variance)
    Constant[] constants = []
    for int k < int(len(selection.indices))
        int ia = 2 * k + 1
        int ib = 2 * k + 2
        real64 a = model.coefficients[ia]
        real64 b = model.coefficients[ib]
        real64 amplitude = model.amplitudes[k]
        real64 va = variance * model.inverse[ia][ia]
        real64 vb = variance * model.inverse[ib][ib]
        real64 cab = variance * model.inverse[ia][ib]
        real64 amplitude_root = math.sqrt(a * a * va + b * b * vb + 2.0 * a * b * cab)
        real64 phase_root = math.sqrt(b * b * va + a * a * vb - 2.0 * a * b * cab)
        real64 amplitude_error = amplitude_root / amplitude
        real64 phase_error = phase_root / (amplitude * amplitude) * 180.0 / harmonic_fit.pi
        real64 ratio = amplitude / amplitude_error
        constants = constants.append(Constant(selection.names[k], selection.speeds[k], amplitude, model.phases[k], amplitude_error, phase_error, ratio * ratio))
    return constants

class Extremum(bool high, int minute, real64 level, int day, string label)

Extremum[] prepare_extrema(predict.Extremum[] raw, real64 minimum_range)
    predict.Extremum[] remaining = raw
    while len(remaining) >= 2
        int best = 0
        real64 minimum = absolute(remaining[0].level - remaining[1].level)
        for 1 <= int i < int(len(remaining)) - 1
            real64 difference = absolute(remaining[i].level - remaining[i + 1].level)
            if difference < minimum
                minimum = difference
                best = i
        if minimum >= minimum_range
            break
        remaining = remaining[0:<best].concat(remaining[best + 2:<int(len(remaining))])
    Extremum[] extrema = []
    for predict.Extremum item = remaining[]
        int minute = math.floor(item.minute + 0.5)
        extrema = extrema.append(Extremum(item.high, minute, item.level, minute / 1440, ""))
    int first = 0
    while first < int(len(extrema))
        int last = first + 1
        while last < int(len(extrema)) and extrema[last].day == extrema[first].day
            last += 1
        int high = -1
        int low = -1
        for first <= int i < last
            if extrema[i].high
                if high < 0 or extrema[i].level > extrema[high].level
                    high = i
            else
                if low < 0 or extrema[i].level < extrema[low].level
                    low = i
        for first <= int i < last
            extrema[i].label = if extrema[i].high then (if i == high then "HHW" else "LHW") else (if i == low then "LLW" else "HLW")
        first = last
    return extrema

class Daily(int day, int[] highs, int[] lows, int highest, int lowest)

Daily[] daily_table(Extremum[] extrema, int start, int hours)
    Daily[] days = []
    for int i < hours / 24
        int day = start / 24 + i
        int[] highs = []
        int[] lows = []
        int highest = -1
        int lowest = -1
        for int j < int(len(extrema))
            if extrema[j].day != day
                continue
            if extrema[j].high
                highs = highs.append(j)
                if highest < 0 or extrema[j].level > extrema[highest].level
                    highest = j
            else
                lows = lows.append(j)
                if lowest < 0 or extrema[j].level < extrema[lowest].level
                    lowest = j
        days = days.append(Daily(day, highs, lows, highest, lowest))
    return days

class DailyMean(int day, real64 level, int filled)

DailyMean[] daily_means(int first, int last, real64[] values, real64[] fitted, int[] reasons)
    DailyMean[] days = []
    for first / 24 <= int day <= last / 24
        int noon = day * 24 + 12
        if noon - 19 < first or noon + 19 > last
            continue
        real64[] terms = []
        int filled = 0
        for -19 <= int j <= 19
            int t = noon + j
            real64 level = if reasons[t] == 0 then values[t] else fitted[t]
            terms = terms.append(real64(doodson[integer_absolute(j)]) * level)
            if reasons[t] != 0
                filled += 1
        days = days.append(DailyMean(day, total(terms) / 30.0, filled))
    return days

class Event(int first, int last, int peak, bool positive)

Event[] residual_events(int[] usable, real64[] residuals, real64 threshold, int minimum_duration)
    Event[] events = []
    int cursor = 0
    while cursor < int(len(usable))
        int start = usable[cursor]
        real64 value = residuals[start]
        if absolute(value) <= threshold
            cursor += 1
            continue
        bool positive = value > threshold
        int last = start
        int peak = start
        while cursor + 1 < int(len(usable))
            int next = usable[cursor + 1]
            bool same = if positive then residuals[next] > threshold else residuals[next] < -threshold
            if next != last + 1 or not same
                break
            cursor += 1
            last = next
            if (positive and residuals[last] > residuals[peak]) or (not positive and residuals[last] < residuals[peak])
                peak = last
        if last - start + 1 >= minimum_duration
            events = events.append(Event(start, last, peak, positive))
        cursor += 1
    return events

class Datums(real64 mhhw, real64 mhw, real64 mtl, real64 dtl, real64 mlw, real64 mllw, real64 mn, real64 gt)
class Characteristics(Datums datums, real64 form_number, string tide_type, real64 spring, real64 neap, real64 hat, real64 lat, int[] highs, int[] lows, int highest, int lowest, int widest, int narrowest, real64 above, real64 below, real64 rise_minutes, real64 fall_minutes, real64 m4_ratio, real64 relative_phase, string dominance)

Characteristics tidal_characteristics(Selection selection, harmonic_fit.Model model, Extremum[] extrema, Daily[] days, real64[] hourly)
    int m2 = named_index(selection.names, "M2")
    int s2 = named_index(selection.names, "S2")
    int k1 = named_index(selection.names, "K1")
    int o1 = named_index(selection.names, "O1")
    int m4 = named_index(selection.names, "M4")
    real64[] amplitudes = model.amplitudes
    real64 form_number = (amplitudes[k1] + amplitudes[o1]) / (amplitudes[m2] + amplitudes[s2])
    string tide_type = if form_number < 0.25 then "semidiurnal" elif form_number < 1.5 then "mixed_semidiurnal" elif form_number < 3.0 then "mixed_diurnal" else "diurnal"
    int[] highs = [for int i < int(len(extrema)) if extrema[i].high then i]
    int[] lows = [for int i < int(len(extrema)) if not extrema[i].high then i]
    real64 mhw = mean([for int i = highs[] then extrema[i].level])
    real64 mlw = mean([for int i = lows[] then extrema[i].level])
    real64 mhhw = mean([for Daily day = days[] if day.highest >= 0 then extrema[day.highest].level])
    real64 mllw = mean([for Daily day = days[] if day.lowest >= 0 then extrema[day.lowest].level])
    Datums datums = Datums(mhhw, mhw, (mhw + mlw) / 2.0, (mhhw + mllw) / 2.0, mlw, mllw, mhw - mlw, mhhw - mllw)
    int highest = highs[largest([for int i = highs[] then extrema[i].level])]
    int lowest = lows[smallest([for int i = lows[] then extrema[i].level])]
    int[] complete_days = [for int i < int(len(days)) if days[i].highest >= 0 and days[i].lowest >= 0 then i]
    real64[] ranges = [for int i = complete_days[] then extrema[days[i].highest].level - extrema[days[i].lowest].level]
    int widest = complete_days[largest(ranges)]
    int narrowest = complete_days[smallest(ranges)]
    int above = int(len([for real64 value = hourly[] if value > mhhw then value]))
    int below = int(len([for real64 value = hourly[] if value < mllw then value]))
    real64[] rises = []
    real64[] falls = []
    for 1 <= int i < int(len(extrema))
        if not extrema[i - 1].high and extrema[i].high
            rises = rises.append(real64(extrema[i].minute - extrema[i - 1].minute))
        elif extrema[i - 1].high and not extrema[i].high
            falls = falls.append(real64(extrema[i].minute - extrema[i - 1].minute))
    real64 relative = 2.0 * model.phases[m2] - model.phases[m4]
    while relative < 0.0
        relative += 360.0
    while relative >= 360.0
        relative -= 360.0
    real64 amplitude_sum = total(amplitudes)
    return Characteristics(datums, form_number, tide_type, 2.0 * (amplitudes[m2] + amplitudes[s2]), 2.0 * (amplitudes[m2] - amplitudes[s2]), model.coefficients[0] + amplitude_sum, model.coefficients[0] - amplitude_sum,
        highs, lows, highest, lowest, widest, narrowest, 100.0 * real64(above) / real64(len(hourly)), 100.0 * real64(below) / real64(len(hourly)), mean(rises), mean(falls), amplitudes[m4] / amplitudes[m2], relative, if relative < 180.0 then "flood" else "ebb")

int[] strongest(int[] times, real64[] residuals, int limit)
    int[] order = []
    for int t = times[]
        int position = int(len(order))
        for int i < int(len(order))
            if absolute(residuals[t]) > absolute(residuals[order[i]])
                position = i
                break
        order = order[0:<position].concat([t]).concat(order[position:<int(len(order))])
        if int(len(order)) > limit
            order = order[0:<limit]
    return order

class Station(records.Station source, records.Params params, records.Constituent[] constituents)
    int capacity = source.observations[int(len(source.observations)) - 1].hour + 1
    bool[] present = [for int i < capacity then false]
    bool[] numeric = present
    int[] millimetres = [for int i < capacity then 0]
    real64[] values = [for int i < capacity then 0.0]
    for records.Observation observation = source.observations[]
        present[observation.hour] = true
        numeric[observation.hour] = observation.numeric
        millimetres[observation.hour] = observation.value
        values[observation.hour] = real64(observation.value) / 1000.0
    cleaning.Prepared cleaned = cleaning.prepare_record(present, numeric, millimetres, params.flat_run)
    int first = cleaned.first
    int last = cleaned.last
    int duration = last - first
    Selection selection = select_constituents(constituents, duration, params.rayleigh)
    harmonic_fit.Model preliminary = harmonic_fit.fit(values, cleaned.candidates, selection.speeds)
    real64[] preliminary_residuals = [for int i < capacity then 0.0]
    for int t = cleaned.candidates[]
        preliminary_residuals[t] = values[t] - predict.height(selection.speeds, preliminary.coefficients, real64(t))
    real64 prefit_rms = rms([for int t = cleaned.candidates[] then preliminary_residuals[t]])
    cleaning.Tests spike_tests = cleaning.detect_spikes(cleaned.candidates, preliminary_residuals, params.spike_window, params.spike_minimum, params.spike_factor, params.spike_floor)
    int[] reasons = cleaned.reasons
    for cleaning.Spike spike = spike_tests.spikes[]
        reasons[spike.hour] = 4
    int[] usable = [for int t = cleaned.candidates[] if reasons[t] == 0 then t]
    harmonic_fit.Model model = harmonic_fit.fit(values, usable, selection.speeds)
    real64[] fitted = [for int t < capacity then predict.height(selection.speeds, model.coefficients, real64(t))]
    real64[] residuals = [for int t < capacity then values[t] - fitted[t]]
    int n = int(len(usable))
    int unknowns = int(len(model.coefficients))
    int dof = n - unknowns
    real64 ss = total([for int t = usable[] then residuals[t] * residuals[t]])
    real64 variance = ss / real64(dof)
    real64 residual_rms = rms([for int t = usable[] then residuals[t]])
    real64 max_abs = absolute(residuals[strongest(usable, residuals, 1)[0]])
    real64 observed_mean = mean([for int t = usable[] then values[t]])
    real64 observed_ss = total([for int t = usable[] then (values[t] - observed_mean) * (values[t] - observed_mean)])
    real64 explained = 100.0 * (1.0 - ss / observed_ss)
    int[] lag_times = [for int t = usable[] if t + 1 <= last and reasons[t + 1] == 0 then t]
    real64 lag_numerator = total([for int t = lag_times[] then residuals[t] * residuals[t + 1]])
    real64 lag_denominator = total([for int t = lag_times[] then residuals[t] * residuals[t]])
    real64 lag1 = lag_numerator / lag_denominator
    Constant[] constants = fitted_constants(selection, model, variance)
    int[] top_times = strongest(usable, residuals, params.top_residuals)
    int split = first + duration / 2
    int[] training = [for int t = usable[] if t <= split then t]
    int[] testing = [for int t = usable[] if t > split then t]
    Selection validation_selection = select_constituents(constituents, training[int(len(training)) - 1] - training[0], params.rayleigh)
    harmonic_fit.Model validation_model = harmonic_fit.fit(values, training, validation_selection.speeds)
    real64[] validation_residuals = [for int t = testing[] then values[t] - predict.height(validation_selection.speeds, validation_model.coefficients, real64(t))]
    real64 validation_rms = rms(validation_residuals)
    real64 in_sample_rms = rms([for int t = testing[] then residuals[t]])
    real64 test_mean = mean([for int t = testing[] then values[t]])
    real64 validation_ss = total([for real64 value = validation_residuals[] then value * value])
    real64 test_ss = total([for int t = testing[] then (values[t] - test_mean) * (values[t] - test_mean)])
    real64 skill = 1.0 - validation_ss / test_ss
    Event[] events = residual_events(usable, residuals, params.surge_threshold, params.surge_hours)
    DailyMean[] daily_levels = daily_means(first, last, values, fitted, reasons)
    real64[] mean_values = [for DailyMean day = daily_levels[] then day.level]
    real64 mean_level = mean(mean_values)
    real64[] mean_dates = [for DailyMean day = daily_levels[] then real64(day.day - daily_levels[0].day)]
    real64 mean_date = mean(mean_dates)
    real64 slope_numerator = total([for int i < int(len(daily_levels)) then (mean_dates[i] - mean_date) * (mean_values[i] - mean_level)])
    real64 slope_denominator = total([for real64 value = mean_dates[] then (value - mean_date) * (value - mean_date)])
    real64 slope = 1000.0 * (slope_numerator / slope_denominator)
    int daily_max = largest(mean_values)
    int daily_min = smallest(mean_values)
    real64[] hourly = predict.hours(selection.speeds, model.coefficients, params.prediction_start, params.prediction_hours)
    predict.Extremum[] raw_extrema = predict.grid_extrema(selection.speeds, model.coefficients, params.prediction_start, params.prediction_hours, params.grid_minutes)
    Extremum[] extrema = prepare_extrema(raw_extrema, params.min_range)
    Daily[] days = daily_table(extrema, params.prediction_start, params.prediction_hours)
    Characteristics characteristics = tidal_characteristics(selection, model, extrema, days, hourly)

    string hour_text(int t)
        return records.datetime_at_hour(params.epoch, t)

    string minute_text(int m)
        return records.datetime_at_minute(params.epoch, m)

    string day_text(int d)
        return records.date_at_minute(params.epoch, 1440 * d)

    string[] cleaning_lines()
        int[] counts = [for int reason <= 4 then int(len([for first <= int t <= last if reasons[t] == reason then t]))]
        string[] lines = ["station={source.code} name={source.name}", "span start=" + hour_text(first) + " end=" + hour_text(last) + " hours={duration + 1} record_length={duration}",
            "counts rows={len(source.observations)} numeric={len(cleaned.numeric_times)} na={counts[2]} absent={counts[1]} flat={counts[3]} spikes={counts[4]} usable={n}"]
        for cleaning.Flat flat_run = cleaned.flat_runs[]
            lines = lines.append("flat start=" + hour_text(flat_run.first) + " end=" + hour_text(flat_run.last) + " value=" + report.fmt(real64(flat_run.value) / 1000.0, 3) + " removed={flat_run.last - flat_run.first}")
        lines = lines.append("spike_test window={params.spike_window} candidates={len(cleaned.candidates)} tested={spike_tests.tested} prefit_rms=" + report.fmt(prefit_rms, 4))
        for cleaning.Spike spike = spike_tests.spikes[]
            lines = lines.append("spike time=" + hour_text(spike.hour) + " value=" + report.fmt(values[spike.hour], 3) + " residual=" + report.fmt(spike.residual, 4) + " median=" + report.fmt(spike.center, 4) + " mad=" + report.fmt(spike.mad, 4) + " limit=" + report.fmt(spike.limit, 4))
        for cleaning.Gap gap = cleaning.list_gaps(first, last, reasons)[]
            lines = lines.append("gap start=" + hour_text(gap.first) + " end=" + hour_text(gap.last) + " hours={gap.last - gap.first + 1} cause={reason_names[gap.reason]}")
        return lines

    string[] constituent_lines()
        string[] lines = []
        int k = 0
        for int i < int(len(constituents))
            string prefix = source.code + "," + constituents[i].name + "," + report.fmt(constituents[i].speed, 7) + ","
            if selection.statuses[i] != "fitted"
                lines = lines.append(prefix + selection.statuses[i] + ",,,,,,")
            else
                Constant value = constants[k]
                string significant = if value.snr >= params.snr_min then "yes" else "no"
                lines = lines.append(prefix + "fitted," + report.fmt(value.amplitude, 4) + "," + report.fmt(value.phase, 2) + "," + report.fmt(value.amplitude_error, 4) + "," + report.fmt(value.phase_error, 2) + "," + report.fmt(value.snr, 1) + "," + significant)
                k += 1
        return lines

    string[] extreme_lines()
        string[] lines = ["station={source.code} extremes={len(extrema)} raw={len(raw_extrema)} removed={int(len(raw_extrema)) - int(len(extrema))}"]
        for int i < int(len(extrema))
            Extremum item = extrema[i]
            string change = if i == 0 then "none" else report.fmt(item.level - extrema[i - 1].level, 3)
            lines = lines.append(minute_text(item.minute) + " {item.label} " + report.fmt(item.level, 3) + " change={change}")
        for Daily day = days[]
            string hhw = if day.highest < 0 then "none" else report.fmt(extrema[day.highest].level, 3)
            string llw = if day.lowest < 0 then "none" else report.fmt(extrema[day.lowest].level, 3)
            string range = if day.highest < 0 or day.lowest < 0 then "none" else report.fmt(extrema[day.highest].level - extrema[day.lowest].level, 3)
            lines = lines.append("day date=" + day_text(day.day) + " high_waters={len(day.highs)} low_waters={len(day.lows)} hhw={hhw} llw={llw} range={range}")
        return lines

    string[] spring_neap_lines()
        int m2 = named_index(selection.names, "M2")
        int s2 = named_index(selection.names, "S2")
        real64 dw = selection.speeds[s2] - selection.speeds[m2]
        real64 dg = model.phases[s2] - model.phases[m2]
        real64 start_q = (real64(params.prediction_start) * dw - dg) / 180.0
        real64 end_q = (real64(params.prediction_start + params.prediction_hours) * dw - dg) / 180.0
        real64 lower = if start_q < end_q then start_q else end_q
        real64 upper = if start_q < end_q then end_q else start_q
        int first_q = math.floor(lower)
        int last_q = math.floor(upper) + 1
        string[] lines = []
        for first_q <= int q <= last_q
            real64 hour = (dg + 180.0 * real64(q)) / dw
            if hour >= real64(params.prediction_start) and hour <= real64(params.prediction_start + params.prediction_hours)
                string kind = if q % 2 == 0 then "spring" else "neap"
                int minute = math.floor(hour * 60.0 + 0.5)
                lines = lines.append(kind + " time=" + minute_text(minute))
        return lines

    string[] summary_lines()
        Characteristics c = characteristics
        Datums d = c.datums
        Extremum highest = extrema[c.highest]
        Extremum lowest = extrema[c.lowest]
        Daily widest = days[c.widest]
        Daily narrowest = days[c.narrowest]
        string[] lines = ["[station {source.code}] {source.name}", "record first=" + hour_text(first) + " last=" + hour_text(last) + " length={duration} usable={n}",
            "fit constituents={len(selection.indices)} unknowns={unknowns} dof={dof} mean_level=" + report.fmt(model.coefficients[0], 4),
            "residual rms=" + report.fmt(residual_rms, 4) + " max_abs=" + report.fmt(max_abs, 4) + " explained_percent=" + report.fmt(explained, 4) + " lag1_autocorrelation=" + report.fmt(lag1, 4)]
        for int i < int(len(top_times))
            int t = top_times[i]
            lines = lines.append("top_residual rank={i + 1} time=" + hour_text(t) + " observed=" + report.fmt(values[t], 3) + " fitted=" + report.fmt(fitted[t], 4) + " residual=" + report.fmt(residuals[t], 4))
        lines = lines.concat(["validation split=" + hour_text(split) + " train={len(training)} test={len(testing)} constituents={len(validation_selection.indices)} rms=" + report.fmt(validation_rms, 4) + " in_sample_rms=" + report.fmt(in_sample_rms, 4) + " skill=" + report.fmt(skill, 4),
            "form_number=" + report.fmt(c.form_number, 4) + " type={c.tide_type}",
            "ranges spring=" + report.fmt(c.spring, 3) + " neap=" + report.fmt(c.neap, 3) + " mn=" + report.fmt(d.mn, 3) + " gt=" + report.fmt(d.gt, 3),
            "asymmetry rise_minutes=" + report.fmt(c.rise_minutes, 1) + " fall_minutes=" + report.fmt(c.fall_minutes, 1) + " m4_m2_ratio=" + report.fmt(c.m4_ratio, 4) + " relative_phase=" + report.fmt(c.relative_phase, 2) + " dominance={c.dominance}",
            "datums mhhw=" + report.fmt(d.mhhw, 3) + " mhw=" + report.fmt(d.mhw, 3) + " mtl=" + report.fmt(d.mtl, 3) + " dtl=" + report.fmt(d.dtl, 3) + " mlw=" + report.fmt(d.mlw, 3) + " mllw=" + report.fmt(d.mllw, 3),
            "bounds hat=" + report.fmt(c.hat, 3) + " lat=" + report.fmt(c.lat, 3),
            "window high_waters={len(c.highs)} low_waters={len(c.lows)} highest=" + report.fmt(highest.level, 3) + " highest_time=" + minute_text(highest.minute) + " lowest=" + report.fmt(lowest.level, 3) + " lowest_time=" + minute_text(lowest.minute),
            "daily_range widest=" + report.fmt(extrema[widest.highest].level - extrema[widest.lowest].level, 3) + " widest_date=" + day_text(widest.day) + " narrowest=" + report.fmt(extrema[narrowest.highest].level - extrema[narrowest.lowest].level, 3) + " narrowest_date=" + day_text(narrowest.day),
            "exceedance above_mhhw=" + report.fmt(c.above, 2) + " below_mllw=" + report.fmt(c.below, 2)])
        lines = lines.concat(spring_neap_lines())
        lines = lines.append("surges count={len(events)} threshold=" + report.fmt(params.surge_threshold, 3) + " min_hours={params.surge_hours}")
        for Event event = events[]
            string kind = if event.positive then "positive" else "negative"
            lines = lines.append("surge type={kind} start=" + hour_text(event.first) + " end=" + hour_text(event.last) + " hours={event.last - event.first + 1} peak=" + report.fmt(residuals[event.peak], 4) + " peak_time=" + hour_text(event.peak))
        lines = lines.append("daily_mean days={len(daily_levels)} average=" + report.fmt(mean_level, 4) + " slope_mm_per_day=" + report.fmt(slope, 3) + " max=" + report.fmt(daily_levels[daily_max].level, 4) + " max_date=" + day_text(daily_levels[daily_max].day) + " min=" + report.fmt(daily_levels[daily_min].level, 4) + " min_date=" + day_text(daily_levels[daily_min].day))
        for DailyMean day = daily_levels[]
            lines = lines.append("daily_mean date=" + day_text(day.day) + " level=" + report.fmt(day.level, 4) + " filled={day.filled}")
        return lines

real64 mean_lag(Station station, Station reference, bool high)
    int[] own = if high then station.characteristics.highs else station.characteristics.lows
    int[] other = if high then reference.characteristics.highs else reference.characteristics.lows
    real64[] differences = []
    for int index = own[]
        int minute = station.extrema[index].minute
        int closest = other[0]
        int distance = integer_absolute(minute - reference.extrema[closest].minute)
        for int candidate = other[]
            int separation = integer_absolute(minute - reference.extrema[candidate].minute)
            if separation < distance
                distance = separation
                closest = candidate
        differences = differences.append(real64(minute - reference.extrema[closest].minute))
    return mean(differences)

string[] comparison_lines(Station[] stations, records.Params params)
    int reference_index = 0
    for int i < int(len(stations))
        if stations[i].source.code == params.reference
            reference_index = i
    Station reference = stations[reference_index]
    string[] lines = ["[comparison] reference={params.reference}"]
    for int i < int(len(stations))
        if i == reference_index
            continue
        Station station = stations[i]
        real64 range_ratio = station.characteristics.datums.gt / reference.characteristics.datums.gt
        real64 mtl_difference = station.characteristics.datums.mtl - reference.characteristics.datums.mtl
        lines = lines.append("{station.source.code} tide hw_lag_min=" + report.fmt(mean_lag(station, reference, true), 1) + " lw_lag_min=" + report.fmt(mean_lag(station, reference, false), 1) + " range_ratio=" + report.fmt(range_ratio, 4) + " mtl_diff=" + report.fmt(mtl_difference, 3))
        for string name = compared_names[]
            Constant own = station.constants[named_index(station.selection.names, name)]
            Constant other = reference.constants[named_index(reference.selection.names, name)]
            real64 phase_difference = own.phase - other.phase
            if phase_difference > 180.0
                phase_difference -= 360.0
            if phase_difference <= -180.0
                phase_difference += 360.0
            real64 lag = phase_difference / own.speed * 60.0
            lines = lines.append("{station.source.code} {name} amplitude_ratio=" + report.fmt(own.amplitude / other.amplitude, 4) + " phase_diff=" + report.fmt(phase_difference, 2) + " time_lag_min=" + report.fmt(lag, 1))
    return lines

class Correlation(int lag, int pairs, real64 value)

Correlation correlate(Station first, Station second, int lag)
    real64[] xs = []
    real64[] ys = []
    for int t = first.usable[]
        int u = t + lag
        if u >= 0 and u < second.capacity and second.reasons[u] == 0
            xs = xs.append(first.residuals[t])
            ys = ys.append(second.residuals[u])
    real64 mx = mean(xs)
    real64 my = mean(ys)
    real64 sxy = total([for int i < int(len(xs)) then (xs[i] - mx) * (ys[i] - my)])
    real64 sxx = total([for real64 x = xs[] then (x - mx) * (x - mx)])
    real64 syy = total([for real64 y = ys[] then (y - my) * (y - my)])
    real64 denominator = math.sqrt(sxx * syy)
    return Correlation(lag, int(len(xs)), sxy / denominator)

string[] correlation_lines(Station[] stations, int maximum_lag)
    string[] lines = ["[correlation] max_lag={maximum_lag}"]
    for int a < int(len(stations))
        for a + 1 <= int b < int(len(stations))
            Correlation best = correlate(stations[a], stations[b], -maximum_lag)
            real64 lag0 = 0.0
            for -maximum_lag <= int lag <= maximum_lag
                Correlation current = correlate(stations[a], stations[b], lag)
                if lag == 0
                    lag0 = current.value
                bool preferred = integer_absolute(lag) < integer_absolute(best.lag) or (integer_absolute(lag) == integer_absolute(best.lag) and lag < best.lag)
                if current.value > best.value or (current.value == best.value and preferred)
                    best = current
            lines = lines.append("{stations[a].source.code}-{stations[b].source.code} lag0=" + report.fmt(lag0, 4) + " best_lag={best.lag} best=" + report.fmt(best.value, 4) + " pairs={best.pairs}")
    return lines

string[] plot_lines(Station station, records.Params params)
    int rows = (params.plot_top - params.plot_bottom) / params.plot_step + 1
    string[][] cells = [for int row < rows then [for int column < params.plot_hours then " "]]
    real64 zero_position = (real64(params.plot_top) - 100.0 * station.model.coefficients[0]) / real64(params.plot_step) + 0.5
    int zero_row = math.floor(zero_position)
    if zero_row >= 0 and zero_row < rows
        cells[zero_row] = [for int column < params.plot_hours then "-"]
    string[] marks = [for int column < params.plot_hours then "*"]
    for Extremum item = station.extrema[]
        int column = (item.minute - 60 * params.prediction_start + 30) / 60
        if column >= 0 and column < params.plot_hours
            marks[column] = if item.high then "H" else "L"
    for int column < params.plot_hours
        real64 position = (real64(params.plot_top) - 100.0 * station.hourly[column]) / real64(params.plot_step) + 0.5
        int row = math.floor(position)
        if row < 0
            cells[0][column] = "^"
        elif row >= rows
            cells[rows - 1][column] = "v"
        else
            cells[row][column] = marks[column]
    string[] lines = ["[plot] station={params.plot_code} start=" + records.datetime_at_hour(params.epoch, params.prediction_start) + " hours={params.plot_hours} step_cm={params.plot_step}"]
    return lines.concat(report.plot_lines(params.plot_top, params.plot_step, cells))

void run()
    records.Input input_data = records.read_inputs()
    records.Params params = input_data.params
    Station[] stations = [for records.Station source = input_data.stations[] then Station(source, params, input_data.constituents)]
    string[] cleaning_rows = []
    string[] constituent_rows = ["station,constituent,speed,status,amplitude,phase,amplitude_error,phase_error,snr,significant"]
    string[] extremes_rows = []
    string[] summary_rows = []
    for Station station = stations[]
        cleaning_rows = cleaning_rows.concat(station.cleaning_lines())
        constituent_rows = constituent_rows.concat(station.constituent_lines())
        extremes_rows = extremes_rows.concat(station.extreme_lines())
        summary_rows = summary_rows.concat(station.summary_lines())
    string header = "time" + [for Station station = stations[] then "," + station.source.code].join("")
    string[] predictions = [header]
    for int i <= params.prediction_hours
        string instant = records.datetime_at_hour(params.epoch, params.prediction_start + i)
        predictions = predictions.append(instant + [for Station station = stations[] then "," + report.fmt(station.hourly[i], 3)].join(""))
    summary_rows = summary_rows.concat(comparison_lines(stations, params)).concat(correlation_lines(stations, params.correlation_lag))
    for Station station = stations[]
        if station.source.code == params.plot_code
            summary_rows = summary_rows.concat(plot_lines(station, params))
    report.write("cleaning.txt", cleaning_rows)
    report.write("constituents.csv", constituent_rows)
    report.write("predictions.csv", predictions)
    report.write("extremes.txt", extremes_rows)
    report.write("summary.txt", summary_rows)

run()
