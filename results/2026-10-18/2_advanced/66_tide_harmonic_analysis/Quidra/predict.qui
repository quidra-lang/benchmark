import math
import harmonic_fit = "./harmonic_fit.qui"

real64 height(real64[] speeds, real64[] coefficients, real64 hour)
    real64 result = coefficients[0]
    for int k < int(len(speeds))
        real64 theta = harmonic_fit.angle(speeds[k], hour)
        result += coefficients[2 * k + 1] * math.cos(theta) + coefficients[2 * k + 2] * math.sin(theta)
    return result

real64[] hours(real64[] speeds, real64[] coefficients, int start, int count)
    return [for int i <= count then height(speeds, coefficients, real64(start + i))]

class Extremum(bool high, real64 minute, real64 level)

Extremum[] grid_extrema(real64[] speeds, real64[] coefficients, int start, int duration, int spacing)
    int count = duration * 60 / spacing
    int[] minutes = [for int i <= count then 60 * start + i * spacing]
    real64[] heights = [for int minute = minutes[] then height(speeds, coefficients, real64(minute) / 60.0)]
    Extremum[] extrema = []
    for 1 <= int j < count
        real64 left = heights[j - 1]
        real64 center = heights[j]
        real64 right = heights[j + 1]
        bool high = left < center and center > right
        bool low = left > center and center < right
        if not high and not low
            continue
        real64 delta = (left - right) / (2.0 * (left - 2.0 * center + right))
        real64 minute = real64(minutes[j]) + delta * real64(spacing)
        real64 level = center - (left - right) * delta / 4.0
        extrema = extrema.append(Extremum(high, minute, level))
    return extrema
