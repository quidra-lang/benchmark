int hundredths(string text)
    return int.parse(text.split(".").join(""))

string[] read_lines(string path)
    content := string.from_utf8(file.read_bin(path))
    lines := content.split(NL)
    return lines[0:<int(len(lines)) - 1]

class Point(int position, int value)
class Series(string name)
    Point[] points := []
class Request(string name, int position)

class Settings(local string[][] rows)
    windows := rows[0]
    kernels := rows[1]
    bandwidths := rows[2]
    degrees := rows[3]
    spans := rows[4]
    int robust_iterations := int.parse(rows[5][0])
    lambdas := rows[6]
    int folds := int.parse(rows[7][0])
    isotonic := rows[8]
    int grid_points := int.parse(rows[9][0])
    real64 band_z := real64.parse(rows[10][0])
    band_methods := rows[11]
    real64 threshold := real64.parse(rows[12][0])
    int bootstrap := int.parse(rows[13][0])
    int trim := int.parse(rows[13][1])
    int seed := int.parse(rows[13][2])
    plot_series := rows[14]
    plot_methods := rows[15]
    int width := int.parse(rows[16][0])
    int height := int.parse(rows[16][1])

class Dataset(Series[] series, Request[] requests, Settings settings)

Dataset read()
    Series[] series := []
    lines := read_lines("input/series.csv")
    for line := lines[1:][]
        row := line.split(",")
        int selected := -1
        for int index < int(len(series))
            if series[index].name == row[0]
                selected = index
        if selected < 0
            selected = int(len(series))
            series = series.append(Series(row[0]))
        series[selected].points = series[selected].points.append(Point(hundredths(row[1]), hundredths(row[2])))
    for int index < int(len(series))
        Point[] ordered := []
        for point := series[index].points[]
            position := int(len(ordered))
            ordered = ordered.append(point)
            while position > 0 and point.position < ordered[position - 1].position
                ordered[position] = ordered[position - 1]
                position -= 1
            ordered[position] = point
        series[index].points = ordered
    Request[] requests := []
    lines = read_lines("input/test_points.csv")
    for line := lines[1:][]
        row := line.split(",")
        requests = requests.append(Request(row[0], hundredths(row[1])))
    string[][] rows := []
    for line := read_lines("input/params.txt")[]
        rows = rows.append(line.split(" ")[1:])
    return Dataset(series, requests, Settings(rows))
