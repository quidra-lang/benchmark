import eventlog = "./eventlog.qui"
import dfg = "./dfg.qui"
import alpha_miner = "./alpha_miner.qui"
import heuristic_miner = "./heuristic_miner.qui"
import conformance = "./conformance.qui"
import report = "./report.qui"

int sum_values(int[] values)
    int result = 0
    for int value = values[]
        result += value
    return result

int index_of(string[] values, string wanted)
    for int i < int(len(values))
        if values[i] == wanted
            return i
    return -1

int integer_index(int[] values, int wanted)
    for int i < int(len(values))
        if values[i] == wanted
            return i
    return -1

string[] unique_strings(string[] values)
    string[] result = []
    for string value = values.sorted()[]
        if len(result) == 0 or result[int(len(result)) - 1] != value
            result = result.append(value)
    return result

string integer_key(int[] values)
    return [for int value = values[] then value.string()].join(",")

int lookup_id(map.Map<string, int> values, string key)
    match values.get(key)
        int found
            return found
        none
            return -1

int[] parse_fraction(string value)
    string[] parts = value.split("/")
    return [eventlog.parse_integer(parts[0]), eventlog.parse_integer(parts[1])]

string fraction_value(int numerator, int denominator)
    return report.fraction([numerator, denominator])

string yes_no(bool value)
    return if value then "yes" else "no"

class Params(int filter_min, int sla, int observations, int[] dependency_threshold, int[] relative_best, int[] loop1_threshold, int[] loop2_threshold, int[] and_threshold)

Params extract_parameters()
    string[][] rows = eventlog.read_parameters()
    return Params(eventlog.parse_integer(rows[0][1]), eventlog.parse_integer(rows[1][1]), eventlog.parse_integer(rows[2][1]), parse_fraction(rows[3][1]), parse_fraction(rows[4][1]), parse_fraction(rows[5][1]), parse_fraction(rows[6][1]), parse_fraction(rows[7][1]))

class Validated(eventlog.Event[] events, string[] errors)

Validated validate_rows(string[][] rows)
    eventlog.Event[] events = []
    string[] errors = []
    set.Set<string> adopted = set.Set<string>()
    for int i < int(len(rows))
        string[] row = rows[i]
        int minute = eventlog.timestamp_minutes(row[2])
        if minute < 0
            errors = errors.append("line {i + 2}: bad timestamp {row[2]}")
            continue
        string identity = row[0] + HT + row[1] + HT + row[2]
        if adopted.has(identity)
            errors = errors.append("line {i + 2}: duplicate event {row[0]} {row[1]} {row[2]}")
            continue
        .adopted.add(identity)
        events = events.append(eventlog.Event(i + 2, row[0], row[1], row[2], row[3], minute))
    return Validated(events, errors)

class Case(string identifier, eventlog.Event[] events, int[] trace, int[] resources)
    int duration = events[int(len(events)) - 1].time_value - events[0].time_value
    int variant = 0

class Variant(int[] trace, int[] cases, bool keep)

bool variant_before(Variant first, Variant second)
    return if len(first.cases) != len(second.cases) then len(first.cases) > len(second.cases) else alpha_miner.sequence_before(first.trace, second.trace)

Variant[] make_variants(Case[] cases, int[][] counts, int minimum)
    Variant[] grouped = []
    for int i < int(len(cases))
        int group = -1
        for int j < int(len(grouped))
            if grouped[j].trace == cases[i].trace
                group = j
                break
        if group < 0
            bool keep = true
            int[] trace = cases[i].trace
            for 1 <= int j < int(len(trace))
                if counts[trace[j - 1]][trace[j]] < minimum
                    keep = false
            grouped = grouped.append(Variant(trace, [i], keep))
        else
            grouped[group].cases = grouped[group].cases.append(i)
    Variant[] result = []
    for Variant item = grouped[]
        int position = int(len(result))
        for int i < int(len(result))
            if variant_before(item, result[i])
                position = i
                break
        result = result[0:<position].concat([item]).concat(result[position:<int(len(result))])
    return result

int[] log_activities(int[][] traces, int size)
    bool[] present = [for int i < size then false]
    for int[] trace = traces[]
        for int activity = trace[]
            present[activity] = true
    return [for int i < size if present[i] then i]

string[] footprint_lines(string[] names, int[] activities, string[][] relations)
    string[] selected_names = [for int i = activities[] then names[i]]
    string[][] cells = [for int a = activities[] then [for int b = activities[] then relations[a][b]]]
    return dfg.footprint(selected_names, cells)

class Discovery(conformance.Net net, int candidate_count, int causal_count, int[][] pairs, int[] activities, string[][] relations)

Discovery discover_net(int[][] traces, int[] activities, string[] names, string[][] relations)
    int size = int(len(names))
    int[][] candidates = []
    set.Set<string> seen = set.Set<string>()
    int causal = 0
    for int a = activities[]
        for int b = activities[]
            if relations[a][b] != "->"
                continue
            causal += 1
            if relations[a][a] == "#" and relations[b][b] == "#"
                int[] pair = [2 ^ a, 2 ^ b]
                string key = integer_key(pair)
                if not seen.has(key)
                    .seen.add(key)
                    candidates = candidates.append(pair)
    int cursor = 0
    while cursor < int(len(candidates))
        int[] pair = candidates[cursor]
        cursor += 1
        for int activity = activities[]
            for int side < 2
                if alpha_miner.extend_pair(pair, activity, side, relations, size)
                    int[] grown = pair
                    grown[side] += 2 ^ activity
                    string key = integer_key(grown)
                    if not seen.has(key)
                        .seen.add(key)
                        candidates = candidates.append(grown)
    int[][] maximal = []
    for int[] pair = candidates[]
        bool extendable = false
        for int activity = activities[]
            for int side < 2
                extendable = extendable or alpha_miner.extend_pair(pair, activity, side, relations, size)
        if extendable
            continue
        int position = int(len(maximal))
        for int i < int(len(maximal))
            if alpha_miner.pair_before(pair, maximal[i], size)
                position = i
                break
        maximal = maximal[0:<position].concat([pair]).concat(maximal[position:<int(len(maximal))])
    string[] places = ["start"].concat([for int i < int(len(maximal)) then "p{i + 1}"]).concat(["end"])
    string[] transitions = [for int activity = activities[] then names[activity]]
    int[][] inputs = [for int t < int(len(transitions)) then []]
    int[][] outputs = inputs
    int final = int(len(places)) - 1
    bool[] starts = [for int i < size then false]
    bool[] ends = starts
    for int[] trace = traces[]
        starts[trace[0]] = true
        ends[trace[int(len(trace)) - 1]] = true
    for int t < int(len(activities))
        int activity = activities[t]
        if starts[activity]
            inputs[t] = inputs[t].append(0)
        for int i < int(len(maximal))
            if alpha_miner.contains(maximal[i][1], activity)
                inputs[t] = inputs[t].append(i + 1)
            if alpha_miner.contains(maximal[i][0], activity)
                outputs[t] = outputs[t].append(i + 1)
        if ends[activity]
            outputs[t] = outputs[t].append(final)
    return Discovery(conformance.Net(places, transitions, inputs, outputs, 0, final), int(len(candidates)), causal, maximal, activities, relations)

class PlusResult(Discovery discovery, int[] loop_places, int[][] triangles)

PlusResult discover_plus(int[][] traces, int[] weights, int[] activities, int[] loops, string[] names, int[][] counts)
    int size = int(len(names))
    int[] reduced_activities = [for int activity = activities[] if integer_index(loops, activity) < 0 then activity]
    int[][] reduced = [for int[] trace = traces[] then [for int activity = trace[] if integer_index(loops, activity) < 0 then activity]]
    int[][] reduced_counts = dfg.directly_follows(reduced, weights, size)
    int[][] triangles = alpha_miner.triangle_counts(reduced, weights, size)
    string[][] relations = [for int a < size then [for int b < size then alpha_miner.plus_relation(reduced_counts, triangles, a, b)]]
    Discovery discovered = discover_net(reduced, reduced_activities, names, relations)
    int[][] inputs = [for int activity = activities[] then []]
    int[][] outputs = inputs
    for int i < int(len(reduced_activities))
        int t = integer_index(activities, reduced_activities[i])
        inputs[t] = discovered.net.inputs[i]
        outputs[t] = discovered.net.outputs[i]
    int[] loop_places = [for int i < size then -1]
    for int loop_activity = loops[]
        int predecessors = 0
        int successors = 0
        for int activity = reduced_activities[]
            if counts[activity][loop_activity] > 0
                predecessors += 2 ^ activity
            if counts[loop_activity][activity] > 0
                successors += 2 ^ activity
        for int p < int(len(discovered.pairs))
            if discovered.pairs[p] == [predecessors, successors]
                int t = integer_index(activities, loop_activity)
                loop_places[loop_activity] = p + 1
                inputs[t] = [p + 1]
                outputs[t] = [p + 1]
                break
    string[] transitions = [for int activity = activities[] then names[activity]]
    discovered.net = conformance.Net(discovered.net.places, transitions, inputs, outputs, discovered.net.initial, discovered.net.final)
    return PlusResult(discovered, loop_places, triangles)

class Reachability(int markings, int edges, int unsafe, int deadlocks, int stuck, bool final, int[] dead, bool sound, bool[][] follows)

Reachability explore_net(conformance.Net net)
    int transitions = int(len(net.transitions))
    int[][] markings = [net.initial_marking]
    map.Map<string, int> positions = map.Map<string, int>()
    .positions.set(integer_key(net.initial_marking), 0)
    int[][] edges = []
    int unsafe = 0
    int deadlocks = 0
    bool[] enabled_ever = [for int t < transitions then false]
    bool[][] follows = [for int t < transitions then [for int u < transitions then false]]
    int cursor = 0
    while cursor < int(len(markings))
        int[] marking = markings[cursor]
        int[] enabled = net.enabled_transitions(marking)
        if len(enabled) == 0 and marking != net.final_marking
            deadlocks += 1
        for int t = enabled[]
            enabled_ever[t] = true
            int[] following = net.fire(marking, t)
            bool safe = true
            for int tokens = following[]
                safe = safe and tokens <= 1
            if not safe
                unsafe += 1
                continue
            string key = integer_key(following)
            int target = lookup_id(positions, key)
            if target < 0
                target = int(len(markings))
                .positions.set(key, target)
                markings = markings.append(following)
            edges = edges.append([cursor, target, t])
            for int u = net.enabled_transitions(following)[]
                follows[t][u] = true
        cursor += 1
    int final_index = lookup_id(positions, integer_key(net.final_marking))
    bool[] reaches_final = [for int i < int(len(markings)) then i == final_index]
    bool changed = true
    while changed
        changed = false
        for int[] edge = edges[]
            if reaches_final[edge[1]] and not reaches_final[edge[0]]
                reaches_final[edge[0]] = true
                changed = true
    int stuck = int(len([for bool reaches = reaches_final[] if not reaches then reaches]))
    int[] dead = [for int t < transitions if not enabled_ever[t] then t]
    return Reachability(int(len(markings)), int(len(edges)), unsafe, deadlocks, stuck, final_index >= 0, dead, unsafe == 0 and stuck == 0 and len(dead) == 0, follows)

conformance.Replay replay_case(Case record, conformance.Net net, string[] activity_names)
    int places = int(len(net.places))
    conformance.Replay result = conformance.Replay(places, int(len(net.transitions)))
    int[][] tokens = [for int p < places then []]
    tokens[net.initial] = [record.events[0].time_value]
    result.produced = 1
    for int i < int(len(record.trace))
        int t = index_of(net.transitions, activity_names[record.trace[i]])
        if t < 0
            result.skipped += 1
            continue
        int minute = record.events[i].time_value
        for int p = net.inputs[t][]
            result.consumed += 1
            if len(tokens[p]) == 0
                result.missing += 1
                result.place_missing[p] += 1
            else
                result.waiting[p] = result.waiting[p].append(minute - tokens[p][0])
                tokens[p] = tokens[p][1:<int(len(tokens[p]))]
                result.routes[p][t] += 1
        for int p = net.outputs[t][]
            tokens[p] = tokens[p].append(minute)
            result.produced += 1
    result.consumed += 1
    int final = net.final
    if len(tokens[final]) == 0
        result.missing += 1
        result.place_missing[final] += 1
    else
        tokens[final] = tokens[final][1:<int(len(tokens[final]))]
    for int p < places
        int remaining = int(len(tokens[p]))
        result.place_remaining[p] = remaining
        result.remaining += remaining
        result.deviating[p] = if remaining > 0 or result.place_missing[p] > 0 then 1 else 0
    return result

class Replays(conformance.Replay[] cases, conformance.Replay totals, int fitting)

Replays replay_all(Case[] cases, conformance.Net net, string[] names)
    conformance.Replay totals = conformance.Replay(int(len(net.places)), int(len(net.transitions)))
    conformance.Replay[] records = []
    int fitting = 0
    for Case record = cases[]
        conformance.Replay result = replay_case(record, net, names)
        records = records.append(result)
        if result.missing == 0 and result.remaining == 0
            fitting += 1
        totals.missing += result.missing
        totals.remaining += result.remaining
        totals.consumed += result.consumed
        totals.produced += result.produced
        totals.skipped += result.skipped
        for int p < int(len(net.places))
            totals.place_missing[p] += result.place_missing[p]
            totals.place_remaining[p] += result.place_remaining[p]
            totals.deviating[p] += result.deviating[p]
            totals.waiting[p] = totals.waiting[p].concat(result.waiting[p])
            for int t < int(len(net.transitions))
                totals.routes[p][t] += result.routes[p][t]
    return Replays(records, totals, fitting)

class Prefix(int[] trace, int weight, bool[] followers)

Prefix[] build_prefixes(Case[] cases, int activity_count)
    Prefix[] prefixes = []
    map.Map<string, int> positions = map.Map<string, int>()
    for Case record = cases[]
        for int length <= int(len(record.trace))
            int[] trace = record.trace[0:<length]
            string key = integer_key(trace)
            int index = lookup_id(positions, key)
            if index < 0
                index = int(len(prefixes))
                .positions.set(key, index)
                prefixes = prefixes.append(Prefix(trace, 0, [for int a < activity_count then false]))
            prefixes[index].weight += 1
            if length < int(len(record.trace))
                prefixes[index].followers[record.trace[length]] = true
    return prefixes

class Precision(int prefixes, int allowed, int escaping, int[] escape_weights)

Precision prefix_precision(conformance.Net net, Prefix[] prefixes, string[] activities)
    int fitting = 0
    int allowed = 0
    int escaping = 0
    int[] weights = [for string name = net.transitions[] then 0]
    for Prefix prefix = prefixes[]
        int[] marking = net.initial_marking
        bool fit = true
        for int activity = prefix.trace[]
            int t = index_of(net.transitions, activities[activity])
            if t < 0 or not net.enabled(marking, t)
                fit = false
                break
            marking = net.fire(marking, t)
        if not fit
            continue
        fitting += 1
        for int t = net.enabled_transitions(marking)[]
            allowed += prefix.weight
            int activity = index_of(activities, net.transitions[t])
            if activity < 0 or not prefix.followers[activity]
                escaping += prefix.weight
                weights[t] += prefix.weight
    return Precision(fitting, allowed, escaping, weights)

string[] net_lines(conformance.Net net, int[][] pairs, string[] activities)
    string[] lines = []
    int size = int(len(activities))
    for int p < int(len(net.places))
        string[] before = []
        string[] after = []
        for int t < int(len(net.transitions))
            if integer_index(net.outputs[t], p) >= 0
                before = before.append(net.transitions[t])
            if integer_index(net.inputs[t], p) >= 0
                after = after.append(net.transitions[t])
        if p > 0 and p + 1 < int(len(net.places))
            before = [for int a = alpha_miner.members(pairs[p - 1][0], size)[] then activities[a]]
            after = [for int a = alpha_miner.members(pairs[p - 1][1], size)[] then activities[a]]
        lines = lines.append("PLACE {net.places[p]} " + report.names(before) + " " + report.names(after))
    for int t < int(len(net.transitions))
        string[] inputs = [for int p = net.inputs[t][] then net.places[p]]
        string[] outputs = [for int p = net.outputs[t][] then net.places[p]]
        lines = lines.append("TRANSITION {net.transitions[t]} in " + report.names(inputs) + " out " + report.names(outputs))
    return lines.append("NET places {len(net.places)} transitions {len(net.transitions)} arcs {net.arc_count}")

string[] heuristic_lines(int[][] counts, int[][] triangles, string[] names, Params params)
    int size = int(len(names))
    bool[] loop1 = [for int a < size then false]
    bool[][] loop2 = [for int a < size then [for int b < size then false]]
    bool[][] edges = loop2
    string[] lines = []
    int loops1 = 0
    int loops2 = 0
    for int a < size
        int count = counts[a][a]
        if count == 0
            continue
        int[] measure = heuristic_miner.loop_measure(count)
        bool accepted = count >= params.observations and report.compare(measure, params.loop1_threshold) >= 0
        loop1[a] = accepted
        edges[a][a] = accepted
        if accepted
            loops1 += 1
        lines = lines.append("L1 {names[a]} count {count} measure " + report.fraction(measure) + " " + (if accepted then "ACCEPT" else "REJECT"))
    for int a < size
        for a + 1 <= int b < size
            int count = triangles[a][b] + triangles[b][a]
            if loop1[a] or loop1[b] or count == 0
                continue
            int[] measure = heuristic_miner.loop_measure(count)
            bool accepted = count >= params.observations and report.compare(measure, params.loop2_threshold) >= 0
            loop2[a][b] = accepted
            loop2[b][a] = accepted
            if accepted
                loops2 += 1
            lines = lines.append("L2 {names[a]} {names[b]} count {count} measure " + report.fraction(measure) + " " + (if accepted then "ACCEPT" else "REJECT"))
    int[][] best_out = [for int a < size then [-1, 1]]
    int[][] best_in = best_out
    for int a < size
        for int b < size
            if a == b or counts[a][b] == 0
                continue
            int[] measure = heuristic_miner.dependency(counts, a, b)
            if report.compare(measure, best_out[a]) > 0
                best_out[a] = measure
            if report.compare(measure, best_in[b]) > 0
                best_in[b] = measure
    for int a < size
        for int b < size
            if a == b or counts[a][b] == 0
                continue
            int[] measure = heuristic_miner.dependency(counts, a, b)
            string verdict = "ACCEPT"
            if loop2[a][b]
                verdict = "LOOP2"
            elif counts[a][b] < params.observations
                verdict = "REJECT_COUNT"
            elif report.compare(measure, params.dependency_threshold) < 0
                verdict = "REJECT_MEASURE"
            elif report.compare(report.difference(best_out[a], measure), params.relative_best) > 0 and report.compare(report.difference(best_in[b], measure), params.relative_best) > 0
                verdict = "REJECT_BEST"
            if verdict == "ACCEPT" or verdict == "LOOP2"
                edges[a][b] = true
            lines = lines.append("DEP {names[a]} {names[b]} count {counts[a][b]} reverse {counts[b][a]} measure " + report.fraction(measure) + " {verdict}")
    for int a < size
        string[] inputs = [for int b < size if edges[b][a] then names[b]]
        string[] outputs = [for int b < size if edges[a][b] then names[b]]
        lines = lines.append("NODE {names[a]} in " + report.names(inputs) + " out " + report.names(outputs))
    int edge_count = 0
    for int a < size
        for int b < size
            if edges[a][b]
                edge_count += 1
        for int side < 2
            int[] neighbours = [for int b < size if b != a and (if side == 0 then edges[a][b] else edges[b][a]) then b]
            for int i < int(len(neighbours))
                for i + 1 <= int j < int(len(neighbours))
                    int b = neighbours[i]
                    int c = neighbours[j]
                    int[] measure = if side == 0 then heuristic_miner.split_measure(counts, a, b, c) else heuristic_miner.join_measure(counts, a, b, c)
                    string kind = if side == 0 then "SPLIT" else "JOIN"
                    string verdict = if report.compare(measure, params.and_threshold) >= 0 then "AND" else "XOR"
                    lines = lines.append("{kind} {names[a]} {names[b]} {names[c]} measure " + report.fraction(measure) + " {verdict}")
    return lines.append("GRAPH activities {size} edges {edge_count} loops1 {loops1} loops2 {loops2}")

class Study(string[][] rows, Params params, conformance.Net reference)
    Validated validated = validate_rows(rows)
    eventlog.Event[] events = validated.events
    string[] activities = unique_strings([for eventlog.Event event = events[] then event.activity])
    string[] resources = unique_strings([for eventlog.Event event = events[] then event.resource])
    int activity_count = int(len(activities))
    int resource_count = int(len(resources))
    Case[] cases = [for eventlog.Case record = eventlog.group_cases(events)[] then Case(record.identifier, record.events, [for eventlog.Event event = record.events[] then index_of(activities, event.activity)], [for eventlog.Event event = record.events[] then index_of(resources, event.resource)])]
    int case_count = int(len(cases))
    int[][] traces = [for Case record = cases[] then record.trace]
    int[] weights = [for Case record = cases[] then 1]
    int[][] counts = dfg.directly_follows(traces, weights, activity_count)
    int[][] triangles = alpha_miner.triangle_counts(traces, weights, activity_count)
    Variant[] variants = make_variants(cases, counts, params.filter_min)
    for int i < int(len(variants))
        for int case_index = variants[i].cases[]
            cases[case_index].variant = i + 1
    int[][] filtered = [for Variant variant = variants[] if variant.keep then variant.trace]
    int[] filtered_weights = [for Variant variant = variants[] if variant.keep then int(len(variant.cases))]
    int kept_cases = sum_values(filtered_weights)
    int kept_events = sum_values([for int i < int(len(filtered)) then int(len(filtered[i])) * filtered_weights[i]])
    int[][] filtered_counts = dfg.directly_follows(filtered, filtered_weights, activity_count)
    int[] filtered_activities = log_activities(filtered, activity_count)
    int[] loops = [for int a = filtered_activities[] if filtered_counts[a][a] > 0 then a]
    string[][] full_relations = [for int a < activity_count then [for int b < activity_count then dfg.basic_relation(counts, a, b)]]
    string[][] filtered_relations = [for int a < activity_count then [for int b < activity_count then dfg.basic_relation(filtered_counts, a, b)]]
    Discovery alpha = discover_net(filtered, filtered_activities, activities, filtered_relations)
    PlusResult plus = discover_plus(filtered, filtered_weights, filtered_activities, loops, activities, filtered_counts)
    conformance.Net[] nets = [reference, alpha.net, plus.discovery.net]
    string[] net_names = ["reference", "alpha", "alpha_plus"]
    Reachability[] reachability = [for conformance.Net net = nets[] then explore_net(net)]
    Prefix[] prefixes = build_prefixes(cases, activity_count)
    Precision[] precisions = [for conformance.Net net = nets[] then prefix_precision(net, prefixes, activities)]
    Replays[] replays = [for conformance.Net net = nets[] then replay_all(cases, net, activities)]

    string trace_names(int[] trace)
        return report.names([for int activity = trace[] then activities[activity]])

    string[] log_summary()
        string[] lines = [for string problem = validated.errors[] then "ERROR " + problem]
        int first = 0
        int last = 0
        for int i < int(len(events))
            if events[i].time_value < events[first].time_value
                first = i
            if events[i].time_value > events[last].time_value
                last = i
        lines = lines.append("LOG rows {len(rows)} adopted {len(events)} rejected {len(validated.errors)} cases {case_count} activities {activity_count} resources {resource_count} first {events[first].timestamp} last {events[last].timestamp}")
        int[] event_counts = [for int a < activity_count then 0]
        int[] case_counts = event_counts
        int[] starts = event_counts
        int[] ends = event_counts
        int[] rework = event_counts
        int[][] waiting = [for int a < activity_count then []]
        bool[][] used_resources = [for int a < activity_count then [for int r < resource_count then false]]
        int[] weekday_events = [for int d < 7 then 0]
        int[] weekday_starts = weekday_events
        int[] weekday_ends = weekday_events
        for Case record = cases[]
            int[] occurrences = [for int a < activity_count then 0]
            starts[record.trace[0]] += 1
            ends[record.trace[int(len(record.trace)) - 1]] += 1
            weekday_starts[(record.events[0].time_value / 1440 + 3) % 7] += 1
            weekday_ends[(record.events[int(len(record.events)) - 1].time_value / 1440 + 3) % 7] += 1
            for int i < int(len(record.trace))
                int activity = record.trace[i]
                occurrences[activity] += 1
                event_counts[activity] += 1
                used_resources[activity][record.resources[i]] = true
                weekday_events[(record.events[i].time_value / 1440 + 3) % 7] += 1
                if i > 0
                    waiting[activity] = waiting[activity].append(record.events[i].time_value - record.events[i - 1].time_value)
            for int a < activity_count
                if occurrences[a] > 0
                    case_counts[a] += 1
                if occurrences[a] > 1
                    rework[a] += 1
        for int a < activity_count
            string wait = if len(waiting[a]) == 0 then "-" else fraction_value(sum_values(waiting[a]), int(len(waiting[a])))
            int resource_total = int(len([for bool used = used_resources[a][] if used then used]))
            lines = lines.append("ACTIVITY {activities[a]} events {event_counts[a]} cases {case_counts[a]} start {starts[a]} end {ends[a]} rework {rework[a]} wait {wait} resources {resource_total} model " + yes_no(index_of(reference.transitions, activities[a]) >= 0))
        int[] lengths = [for Case record = cases[] then int(len(record.trace))]
        int[] durations = [for Case record = cases[] then record.duration]
        int[][] lists = [lengths, durations]
        string[] labels = ["LENGTH", "DURATION"]
        for int i < 2
            int[] ordered = lists[i].sorted()
            lines = lines.append("{labels[i]} min {ordered[0]} max {ordered[case_count - 1]} mean " + fraction_value(sum_values(ordered), case_count) + " median " + report.fraction(eventlog.median(ordered)))
        int[] days = [for int duration = durations[] then duration / 1440]
        int max_day = days.sorted()[case_count - 1]
        for int day <= max_day
            int count = int(len([for int value = days[] if value == day then value]))
            lines = lines.append("DAYS {day} cases {count} share " + report.percentage(count, case_count))
        int late = int(len([for int duration = durations[] if duration > params.sla then duration]))
        lines = lines.append("SLA limit {params.sla} late {late} share " + report.percentage(late, case_count))
        string[] weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
        for int day < 7
            lines = lines.append("WEEKDAY {weekdays[day]} events {weekday_events[day]} starts {weekday_starts[day]} ends {weekday_ends[day]}")
        return lines

    string[] variant_lines()
        string[] lines = []
        for int i < int(len(variants))
            Variant variant = variants[i]
            int count = int(len(variant.cases))
            int duration_sum = sum_values([for int index = variant.cases[] then cases[index].duration])
            int late = int(len([for int index = variant.cases[] if cases[index].duration > params.sla then index]))
            conformance.Replay replay = replays[0].cases[variant.cases[0]]
            int[] fitness = conformance.fitness(replay.missing, replay.remaining, replay.consumed, replay.produced)
            string decision = if variant.keep then "KEEP" else "DROP"
            lines = lines.append("VARIANT {i + 1} count {count} share " + report.percentage(count, case_count) + " length {len(variant.trace)} first {cases[variant.cases[0]].identifier} duration " + fraction_value(duration_sum, count) + " late {late} fitness " + report.fraction(fitness) + " {decision} " + trace_names(variant.trace))
        return lines.append("FILTER min_follows {params.filter_min} variants {len(filtered)} of {len(variants)} cases {kept_cases} of {case_count} events {kept_events} of {len(events)}")

    string[] dfg_lines()
        int[] starts = [for int a < activity_count then 0]
        int[][] durations = [for int a < activity_count then []]
        int[][][] waiting = [for int a < activity_count then [for int b < activity_count then []]]
        int[][] case_counts = [for int a < activity_count then [for int b < activity_count then 0]]
        for Case record = cases[]
            starts[record.trace[0]] += 1
            int end = record.trace[int(len(record.trace)) - 1]
            durations[end] = durations[end].append(record.duration)
            bool[][] seen = [for int a < activity_count then [for int b < activity_count then false]]
            for 1 <= int i < int(len(record.trace))
                int a = record.trace[i - 1]
                int b = record.trace[i]
                waiting[a][b] = waiting[a][b].append(record.events[i].time_value - record.events[i - 1].time_value)
                seen[a][b] = true
            for int a < activity_count
                for int b < activity_count
                    if seen[a][b]
                        case_counts[a][b] += 1
        int upper = int(len(events))
        int[] keys = [for int a < activity_count if starts[a] > 0 then (upper - starts[a]) * activity_count + a]
        string[] lines = []
        for int key = keys.sorted()[]
            int a = key % activity_count
            lines = lines.append("START {activities[a]} count {starts[a]}")
        keys = [for int a < activity_count if len(durations[a]) > 0 then (upper - int(len(durations[a]))) * activity_count + a]
        for int key = keys.sorted()[]
            int a = key % activity_count
            lines = lines.append("END {activities[a]} count {len(durations[a])} duration " + fraction_value(sum_values(durations[a]), int(len(durations[a]))))
        int base = activity_count * activity_count
        keys = []
        for int a < activity_count
            for int b < activity_count
                if counts[a][b] > 0
                    keys = keys.append((upper - counts[a][b]) * base + a * activity_count + b)
        for int key = keys.sorted()[]
            int pair = key % base
            int a = pair / activity_count
            int b = pair % activity_count
            int[] ordered = waiting[a][b].sorted()
            lines = lines.append("EDGE {activities[a]} {activities[b]} count {counts[a][b]} cases {case_counts[a][b]} mean " + fraction_value(sum_values(ordered), int(len(ordered))) + " min {ordered[0]} max {ordered[int(len(ordered)) - 1]}")
        return lines.concat(footprint_lines(activities, [for int a < activity_count then a], full_relations))

    string pair_summary(Discovery discovery)
        return "PAIRS causal {discovery.causal_count} candidates {discovery.candidate_count} maximal {len(discovery.pairs)}"

    string[] alpha_lines()
        string[] lines = ["LOG variants {len(filtered)} cases {kept_cases} activities " + trace_names(filtered_activities), "LOOPS " + trace_names(loops), "MINER alpha"]
        lines = lines.concat(footprint_lines(activities, alpha.activities, alpha.relations)).append(pair_summary(alpha)).concat(net_lines(alpha.net, alpha.pairs, activities))
        lines = lines.append("MINER alpha_plus")
        for int a < activity_count
            for int b < activity_count
                if plus.triangles[a][b] > 0
                    lines = lines.append("TRIANGLE {activities[a]} {activities[b]} count {plus.triangles[a][b]}")
        Discovery discovery = plus.discovery
        lines = lines.concat(footprint_lines(activities, discovery.activities, discovery.relations)).append(pair_summary(discovery))
        for int activity = loops[]
            int[] before = [for int other = discovery.activities[] if filtered_counts[other][activity] > 0 then other]
            int[] after = [for int other = discovery.activities[] if filtered_counts[activity][other] > 0 then other]
            int p = plus.loop_places[activity]
            string place = if p < 0 then "-" else discovery.net.places[p]
            lines = lines.append("LOOP {activities[activity]} before " + trace_names(before) + " after " + trace_names(after) + " place {place}")
        return lines.concat(net_lines(discovery.net, discovery.pairs, activities))

    string[] conformance_rows()
        string[] lines = ["case_id,variant,events,skipped,missing,remaining,consumed,produced,fitness"]
        for int i < case_count
            Case record = cases[i]
            conformance.Replay replay = replays[0].cases[i]
            string fitness = report.fraction(conformance.fitness(replay.missing, replay.remaining, replay.consumed, replay.produced))
            lines = lines.append("{record.identifier},{record.variant},{len(record.trace)},{replay.skipped},{replay.missing},{replay.remaining},{replay.consumed},{replay.produced},{fitness}")
        return lines

    string model_relation(int net_index, string first, string second)
        conformance.Net net = nets[net_index]
        int a = index_of(net.transitions, first)
        int b = index_of(net.transitions, second)
        if a < 0 or b < 0
            return "#"
        bool forward = reachability[net_index].follows[a][b]
        bool backward = reachability[net_index].follows[b][a]
        return if forward and not backward then "->" elif backward and not forward then "<-" elif forward then "||" else "#"

    string[] footprint_check_lines(int net_index)
        string[] names = unique_strings(activities.concat(nets[net_index].transitions))
        int size = int(len(names))
        int differing = 0
        string[] differences = []
        for int i < size
            for int j < size
                int a = index_of(activities, names[i])
                int b = index_of(activities, names[j])
                string log_relation = if a < 0 or b < 0 then "#" else full_relations[a][b]
                string net_relation = model_relation(net_index, names[i], names[j])
                if log_relation != net_relation
                    differing += 1
                    if net_index == 0 and i <= j
                        differences = differences.append("DIFF {names[i]} {names[j]} log {log_relation} model {net_relation}")
        string line = "FOOTPRINT {net_names[net_index]} activities {size} cells {size * size} differing {differing} fitness " + fraction_value(size * size - differing, size * size)
        return [line].concat(differences)

    string[] conformance_lines()
        string[] lines = ["MODEL places {len(reference.places)} transitions {len(reference.transitions)} arcs {reference.arc_count}"]
        for int i < 3
            Reachability result = reachability[i]
            string[] dead = [for int t = result.dead[] then nets[i].transitions[t]]
            lines = lines.append("REACHABILITY {net_names[i]} markings {result.markings} edges {result.edges} unsafe {result.unsafe} deadlocks {result.deadlocks} stuck {result.stuck} final " + yes_no(result.final) + " dead " + report.names(dead) + " sound " + yes_no(result.sound))
        for int i < 3
            lines = lines.concat(footprint_check_lines(i))
        for int i < 3
            Precision precision = precisions[i]
            string value = if precision.allowed == 0 then fraction_value(1, 1) else fraction_value(precision.allowed - precision.escaping, precision.allowed)
            lines = lines.append("PRECISION {net_names[i]} prefixes {precision.prefixes} allowed {precision.allowed} escaping {precision.escaping} precision {value}")
            int size = int(len(nets[i].transitions))
            int maximum_weight = 0
            for int weight = precision.escape_weights[]
                if weight > maximum_weight
                    maximum_weight = weight
            int[] keys = [for int t < size if precision.escape_weights[t] > 0 then (maximum_weight - precision.escape_weights[t]) * size + t]
            for int key = keys.sorted()[]
                int t = key % size
                lines = lines.append("ESCAPE {net_names[i]} {nets[i].transitions[t]} weight {precision.escape_weights[t]}")
        for int i < 3
            conformance.Net net = nets[i]
            conformance.Replay totals = replays[i].totals
            string fitness = report.fraction(conformance.fitness(totals.missing, totals.remaining, totals.consumed, totals.produced))
            lines = lines.append("REPLAY {net_names[i]} cases {case_count} fitting {replays[i].fitting} skipped {totals.skipped} missing {totals.missing} remaining {totals.remaining} consumed {totals.consumed} produced {totals.produced} fitness {fitness}")
            for int p < int(len(net.places))
                int[] waiting = totals.waiting[p]
                string average = if len(waiting) == 0 then "-" else fraction_value(sum_values(waiting), int(len(waiting)))
                string maximum_wait = if len(waiting) == 0 then "-" else waiting.sorted()[int(len(waiting)) - 1].string()
                lines = lines.append("PLACE {net_names[i]} {net.places[p]} missing {totals.place_missing[p]} remaining {totals.place_remaining[p]} deviating {totals.deviating[p]} tokens {len(waiting)} mean {average} max {maximum_wait}")
            for int p < int(len(net.places))
                if len(net.routes[p]) < 2
                    continue
                string[] consumptions = [for int t = net.routes[p][] then net.transitions[t] + "={totals.routes[p][t]}"]
                lines = lines.append("ROUTE {net_names[i]} {net.places[p]} " + consumptions.join(","))
        return lines

    string[] resource_lines()
        int[][] work = [for int r < resource_count then [for int a < activity_count then 0]]
        int[] case_counts = [for int r < resource_count then 0]
        int[][] handovers = [for int r < resource_count then [for int s < resource_count then 0]]
        int[][] handover_cases = handovers
        int[][] subcontracts = handovers
        int[][] together = handovers
        for Case record = cases[]
            bool[] present = [for int r < resource_count then false]
            bool[][] seen_handover = [for int r < resource_count then [for int s < resource_count then false]]
            for int i < int(len(record.trace))
                int r = record.resources[i]
                present[r] = true
                work[r][record.trace[i]] += 1
                if i > 0
                    int previous = record.resources[i - 1]
                    handovers[previous][r] += 1
                    seen_handover[previous][r] = true
                if i >= 2 and record.resources[i - 2] == r and record.resources[i - 1] != r
                    subcontracts[r][record.resources[i - 1]] += 1
            for int r < resource_count
                if present[r]
                    case_counts[r] += 1
                for int s < resource_count
                    if seen_handover[r][s]
                        handover_cases[r][s] += 1
                    if r < s and present[r] and present[s]
                        together[r][s] += 1
        string[] lines = []
        for int r < resource_count
            string[] items = [for int a < activity_count if work[r][a] > 0 then activities[a] + "={work[r][a]}"]
            lines = lines.append("RESOURCE {r + 1} {resources[r]} events {sum_values(work[r])} cases {case_counts[r]} work " + items.join(","))
        int base = resource_count * resource_count
        int upper = int(len(events))
        int[] keys = []
        for int r < resource_count
            for int s < resource_count
                if r != s and handovers[r][s] > 0
                    keys = keys.append((upper - handovers[r][s]) * base + r * resource_count + s)
        for int key = keys.sorted()[]
            int pair = key % base
            int r = pair / resource_count
            int s = pair % resource_count
            lines = lines.append("HANDOVER {resources[r]} {resources[s]} count {handovers[r][s]} cases {handover_cases[r][s]}")
        string[][] cells = [for int[] row = handovers[] then [for int value = row[] then value.string()]]
        lines = lines.concat(dfg.table(cells, 5))
        keys = []
        for int r < resource_count
            for int s < resource_count
                if subcontracts[r][s] > 0
                    keys = keys.append((upper - subcontracts[r][s]) * base + r * resource_count + s)
        for int key = keys.sorted()[]
            int pair = key % base
            int r = pair / resource_count
            int s = pair % resource_count
            lines = lines.append("SUBCONTRACT {resources[r]} {resources[s]} count {subcontracts[r][s]}")
        keys = []
        for int r < resource_count
            for r + 1 <= int s < resource_count
                if together[r][s] > 0
                    keys = keys.append((case_count - together[r][s]) * base + r * resource_count + s)
        for int key = keys.sorted()[]
            int pair = key % base
            int r = pair / resource_count
            int s = pair % resource_count
            lines = lines.append("TOGETHER {resources[r]} {resources[s]} cases {together[r][s]}")
        int all_handovers = sum_values([for int[] row = handovers[] then sum_values(row)])
        int self_handovers = sum_values([for int r < resource_count then handovers[r][r]])
        return lines.append("TOTAL handovers {all_handovers} self {self_handovers} other {all_handovers - self_handovers}")

void run_program()
    Study study = Study(eventlog.read_log(), extract_parameters(), conformance.read_model())
    report.write("log_summary.txt", study.log_summary())
    report.write("variants.txt", study.variant_lines())
    report.write("dfg.txt", study.dfg_lines())
    report.write("alpha_net.txt", study.alpha_lines())
    report.write("heuristic_net.txt", heuristic_lines(study.counts, study.triangles, study.activities, study.params))
    report.write("conformance.csv", study.conformance_rows())
    report.write("conformance.txt", study.conformance_lines())
    report.write("resources.txt", study.resource_lines())

run_program()
