int name_index(string[] names, string wanted)
    for int i < int(len(names))
        if names[i] == wanted
            return i
    return -1

class Net(string[] places, string[] transitions, int[][] inputs, int[][] outputs, int initial, int final)
    int[][] routes = [for int p < int(len(places)) then []]
    for int t < int(len(transitions))
        for int p = inputs[t][]
            routes[p] = routes[p].append(t)
    int[] initial_marking = [for int p < int(len(places)) then (if p == initial then 1 else 0)]
    int[] final_marking = [for int p < int(len(places)) then (if p == final then 1 else 0)]
    int arc_count = 0
    for int t < int(len(transitions))
        arc_count += int(len(inputs[t])) + int(len(outputs[t]))

    bool enabled(int[] marking, int transition)
        for int p = inputs[transition][]
            if marking[p] == 0
                return false
        return true

    int[] enabled_transitions(int[] marking)
        return [for int t < int(len(transitions)) if enabled(marking, t) then t]

    int[] fire(int[] marking, int transition)
        int[] result = marking
        for int p = inputs[transition][]
            result[p] -= 1
        for int p = outputs[transition][]
            result[p] += 1
        return result

Net read_model()
    string text = file.read("input/model.txt")
    string[] lines = text.split(NL)
    string[] places = []
    string[] transitions = []
    string[][] arcs = []
    string initial = ""
    string final = ""
    for string line = lines[0:<int(len(lines)) - 1][]
        string[] fields = line.split(" ")
        if fields[0] == "PLACE"
            places = places.append(fields[1])
        elif fields[0] == "TRANSITION"
            transitions = transitions.append(fields[1])
        elif fields[0] == "ARC"
            arcs = arcs.append(fields[1:<3])
        elif fields[0] == "INITIAL"
            initial = fields[1]
        else
            final = fields[1]
    transitions = transitions.sorted()
    int[][] inputs = [for string transition = transitions[] then []]
    int[][] outputs = inputs
    for string[] arc = arcs[]
        int p = name_index(places, arc[0])
        if p >= 0
            int t = name_index(transitions, arc[1])
            inputs[t] = inputs[t].append(p)
        else
            int t = name_index(transitions, arc[0])
            outputs[t] = outputs[t].append(name_index(places, arc[1]))
    return Net(places, transitions, [for int[] values = inputs[] then values.sorted()], [for int[] values = outputs[] then values.sorted()], name_index(places, initial), name_index(places, final))

int[] fitness(int missing, int remaining, int consumed, int produced)
    return [(consumed - missing) * produced + (produced - remaining) * consumed, 2 * consumed * produced]

class Replay(int place_count, int transition_count)
    int missing = 0
    int remaining = 0
    int consumed = 0
    int produced = 0
    int skipped = 0
    int[] place_missing = [for int p < place_count then 0]
    int[] place_remaining = place_missing
    int[] deviating = place_missing
    int[][] waiting = [for int p < place_count then []]
    int[][] routes = [for int p < place_count then [for int t < transition_count then 0]]
