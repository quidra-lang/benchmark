int parse_integer(string text)
    int value = int.parse(text)
    return value

string[] read_lines(string path)
    string text = file.read(path)
    string[] lines = text.split(NL)
    return lines[0:<int(len(lines)) - 1]

string[][] read_log()
    string[] lines = read_lines("input/eventlog.csv")
    return [for string line = lines[1:<int(len(lines))][] then line.split(",")]

string[][] read_parameters()
    return [for string line = read_lines("input/params.txt")[] then line.split(" ")]

int timestamp_minutes(string timestamp)
    int month = parse_integer(timestamp[5:<7])
    int day = parse_integer(timestamp[8:<10])
    int hour = parse_integer(timestamp[11:<13])
    int minute = parse_integer(timestamp[14:<16])
    int[] months = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if month < 1 or month > 12 or day < 1 or day > months[month - 1] or hour > 23 or minute > 59
        return -1
    int days = day - 1
    for int i < month - 1
        days += months[i]
    return (days * 24 + hour) * 60 + minute

class Event(int line, string case_id, string activity, string timestamp, string resource, int time_value)
class Case(string identifier, Event[] events)

Case[] group_cases(Event[] events)
    string[] names = [for Event event = events[] then event.case_id].sorted()
    string[] identifiers = []
    for string name = names[]
        if len(identifiers) == 0 or identifiers[int(len(identifiers)) - 1] != name
            identifiers = identifiers.append(name)
    Case[] cases = []
    for string identifier = identifiers[]
        Event[] ordered = []
        for Event event = events[]
            if event.case_id != identifier
                continue
            int position = int(len(ordered))
            for int i < int(len(ordered))
                if event.time_value < ordered[i].time_value or (event.time_value == ordered[i].time_value and event.line < ordered[i].line)
                    position = i
                    break
            ordered = ordered[0:<position].concat([event]).concat(ordered[position:<int(len(ordered))])
        cases = cases.append(Case(identifier, ordered))
    return cases

int[] median(int[] values)
    int[] ordered = values.sorted()
    int size = int(len(ordered))
    return if size % 2 == 1 then [ordered[size / 2], 1] else [ordered[size / 2 - 1] + ordered[size / 2], 2]
