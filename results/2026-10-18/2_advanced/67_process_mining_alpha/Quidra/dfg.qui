int[][] directly_follows(int[][] traces, int[] weights, int size)
    int[][] counts = [for int a < size then [for int b < size then 0]]
    for int index < int(len(traces))
        int[] trace = traces[index]
        for 1 <= int i < int(len(trace))
            counts[trace[i - 1]][trace[i]] += weights[index]
    return counts

string basic_relation(int[][] counts, int first, int second)
    bool forward = counts[first][second] > 0
    bool backward = counts[second][first] > 0
    return if forward and not backward then "->" elif backward and not forward then "<-" elif forward then "||" else "#"

string align(string value, int width)
    return string.repeat(" ", nat(width - int(len(value)))) + value

string[] table(string[][] rows, int width)
    int size = int(len(rows))
    string header = "    " + [for 1 <= int i <= size then align(i.string(), width)].join("")
    string[] lines = [header]
    for int i < size
        lines = lines.append(align((i + 1).string(), 4) + [for string value = rows[i][] then align(value, width)].join(""))
    return lines

string[] footprint(string[] activities, string[][] relations)
    string[] lines = [for int i < int(len(activities)) then "ACTIVITY {i + 1} {activities[i]}"]
    return lines.concat(table(relations, 4))
