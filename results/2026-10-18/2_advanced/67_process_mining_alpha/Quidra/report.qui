int gcd(int first, int second)
    int a = first
    int b = second
    while b != 0
        int remainder = a % b
        a = b
        b = remainder
    return a

int[] ratio(int numerator, int denominator)
    int magnitude = if numerator < 0 then -numerator else numerator
    int divisor = gcd(magnitude, denominator)
    return [numerator / divisor, denominator / divisor]

int compare(int[] first, int[] second)
    int a = first[0] * second[1]
    int b = second[0] * first[1]
    return if a < b then -1 elif a > b then 1 else 0

int[] difference(int[] first, int[] second)
    return ratio(first[0] * second[1] - second[0] * first[1], first[1] * second[1])

string fraction(int[] value)
    int[] reduced = ratio(value[0], value[1])
    bool negative = reduced[0] < 0
    int magnitude = if negative then -reduced[0] else reduced[0]
    int scaled = 10000 * magnitude / reduced[1]
    string fraction_part = (scaled % 10000).string()
    string decimal_sign = if negative and scaled != 0 then "-" else ""
    return (if negative then "-" else "") + "{magnitude}/{reduced[1]}=" + decimal_sign + (scaled / 10000).string() + "." + string.repeat("0", nat(4 - int(len(fraction_part)))) + fraction_part

string percentage(int numerator, int denominator)
    int scaled = 10000 * numerator / denominator
    string fraction_part = (scaled % 100).string()
    return (scaled / 100).string() + "." + (if len(fraction_part) == 1 then "0" else "") + fraction_part + "%"

string names(string[] values)
    return if len(values) == 0 then "-" else values.join(",")

void write(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + (if len(rows) == 0 then "" else NL))
