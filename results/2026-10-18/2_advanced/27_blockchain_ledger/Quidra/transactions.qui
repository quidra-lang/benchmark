import hashing = "./hashing.qui"
import wallets = "./wallets.qui"

T | error entry<T>(const map.Map<string, T> values, string key)
    match values.get(key)
        T value
            return value
        none
            return error("missing key: " + key)

class Output(string address, int amount)

class Transaction(string text, string[] inputs, Output[] outputs, string[] signatures, int coinbase_height)
    string txid = hashing.digest(text)
    int size = int(len(text))

    bool is_coinbase()
        return coinbase_height >= 0

    string body()
        return text.split(";sig=")[0]

    int output_total()
        int amount = 0
        for Output output = outputs[]
            amount += output.amount
        return amount

class Coin(string address, int amount, int height, bool coinbase)
    bool mature(int next_height, int maturity)
        return not coinbase or height == 0 or next_height >= height + maturity

Output[] parse_outputs(string text)
    Output[] outputs = []
    for string piece = text.split(",")[]
        string[] fields = piece.split(":")
        outputs = outputs.append(Output(fields[0], int.parse(fields[1])))
    return outputs

string outputs_text(Output[] outputs)
    return [for Output output = outputs[] then "{output.address}:{output.amount}"].join(",")

Transaction parse_transaction(string text)
    string[] parts = text.split(";")
    Output[] outputs = parse_outputs(parts[1].split("=")[1])
    if parts[0].starts_with("cb=")
        return Transaction(text, [], outputs, [], int.parse(parts[0][3:]))
    return Transaction(text, parts[0][3:].split(","), outputs, parts[2][4:].split(","), -1)

Transaction create_transaction(string[] inputs, Output[] outputs, string secret)
    string body = "in=" + inputs.join(",") + ";out=" + outputs_text(outputs)
    string[] signatures = [for int index = (0:<int(len(inputs)))[] then wallets.sign(secret, index, body)]
    return Transaction(body + ";sig=" + signatures.join(","), inputs, outputs, signatures, -1)

Transaction create_coinbase(int height, Output[] outputs)
    return Transaction("cb={height};out=" + outputs_text(outputs), [], outputs, [], height)

class Check(string reason, int fee = 0)

Check check_transaction(Transaction transaction, map.Map<string, Coin> utxo, set.Set<string> spent, int height, map.Map<string, wallets.Wallet> owners, int maturity)
    for Output output = transaction.outputs[]
        if not owners.has(output.address) or output.amount == 0
            return Check("bad-output")
    set.Set<string> seen
    int total = 0
    for int index < int(len(transaction.inputs))
        string reference = transaction.inputs[index]
        if spent.has(reference) or seen.has(reference)
            return Check("double-spend")
        if not utxo.has(reference)
            return Check("missing-input")
        Coin coin = entry(utxo, reference)
        if not coin.mature(height, maturity)
            return Check("immature")
        wallets.Wallet owner = entry(owners, coin.address)
        if transaction.signatures[index] != wallets.sign(owner.secret, index, transaction.body())
            return Check("bad-sig")
        .seen.add(reference)
        total += coin.amount
    int amount = transaction.output_total()
    if total < amount
        return Check("overspend")
    return Check("", total - amount)

void apply_transaction(map.Map<string, Coin> &utxo, Transaction transaction, int height)
    for string reference = transaction.inputs[]
        .utxo.remove(reference)
    for int index < int(len(transaction.outputs))
        Output output = transaction.outputs[index]
        .utxo.set("{transaction.txid}:{index}", Coin(output.address, output.amount, height, transaction.is_coinbase()))
