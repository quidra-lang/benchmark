string hex8(int number)
    string digits = "0123456789abcdef"
    string result = ""
    int value = number
    for int _ < 8
        result = digits[value % 16] + result
        value /= 16
    return result

string digest(string text)
    int[] bases = [1000003, 1500007, 2750159, 4194301]
    int[] initials = [11, 23, 37, 53]
    string result = ""
    for int lane < 4
        int value = initials[lane]
        for int code = text.codepoints()[]
            value = (value * bases[lane] + code) % 2147483647
        for int extra = [int(len(text)), 0, 0][]
            value = (value * bases[lane] + extra) % 2147483647
        result += hex8(value)
    return result

string merkle_root(string[] hashes)
    string[] level = hashes
    while len(level) > 1
        if len(level) % 2 == 1
            level = level.append(level[len(level) - 1])
        string[] next_level = []
        for 0 <= int position < int(len(level)) step 2
            next_level = next_level.append(digest(level[position] + level[position + 1]))
        level = next_level
    return level[0]

string short(string value)
    return value[0:<8]
