import math
import hashing = "./hashing.qui"
import wallets = "./wallets.qui"
import transactions = "./transactions.qui"
import blocks = "./blocks.qui"
import chain = "./chain.qui"

string[] read_lines(string path)
    string[] lines = file.read(path).split(NL)
    return lines[0:<len(lines) - 1]

class Params(local string[][] rows)
    int initial_difficulty = int.parse(rows[0][1])
    int retarget_interval = int.parse(rows[1][1])
    int target_spacing = int.parse(rows[1][2])
    int initial_reward = int.parse(rows[2][1])
    int halving_interval = int.parse(rows[2][2])
    int maturity = int.parse(rows[3][1])
    int max_block_size = int.parse(rows[4][1])
    int min_fee_rate = int.parse(rows[5][1])
    int mempool_limit = int.parse(rows[6][1])
    int orphan_limit = int.parse(rows[7][1])
    int drift = int.parse(rows[8][1])
    int expiry = int.parse(rows[9][1])
    int max_reorg = int.parse(rows[10][1])
    int ban_score = int.parse(rows[11][1])
    int block_penalty = int.parse(rows[11][2])
    int tx_penalty = int.parse(rows[11][3])
    string[] genesis = rows[12][1:]

class Peer(string name)
    int accepted_blocks = 0
    int rejected_blocks = 0
    int orphaned_blocks = 0
    int accepted_txs = 0
    int rejected_txs = 0
    int ignored = 0
    int score = 0

class MempoolEntry(transactions.Transaction transaction, int fee, int arrival, bool returned = false)
class Orphan(blocks.Block block, int peer)
class Reorganization(int time, int fork_height, int disconnected, int connected, string old_hash, string new_hash)
class Acceptance(string reason, int fee = 0, string[] conflicts = [])
class Validation(string reason, map.Map<string, transactions.Coin> utxo, int[] fees)

bool priority_before(MempoolEntry first, MempoolEntry second)
    int left = first.fee * second.transaction.size
    int right = second.fee * first.transaction.size
    return left > right or (left == right and first.transaction.txid < second.transaction.txid)

bool reference_before(string first, string second)
    string[] left = first.split(":")
    string[] right = second.split(":")
    return left[0] < right[0] or (left[0] == right[0] and int.parse(left[1]) < int.parse(right[1]))

string signed(int value)
    return if value >= 0 then "+{value}" else "{value}"

class Node(Params params, wallets.Wallet[] managed)
    map.Map<string, wallets.Wallet> owners
    map.Map<string, wallets.Wallet> named
    chain.Record[] records = []
    map.Map<string, int> record_index
    int tip = 0
    int now = 0
    int[] main_chain = []
    map.Map<string, int> confirmed
    MempoolEntry[] mempool = []
    Orphan[] orphans = []
    set.Set<string> rejected
    map.Map<string, string> drop_record
    Peer[] peers = []
    map.Map<string, int> peer_index
    map.Map<string, int> rejections
    Reorganization[] reorganizations = []
    string[] log_lines = []

    for wallets.Wallet wallet = managed[]
        .owners.set(wallet.address, wallet)
        .named.set(wallet.name, wallet)
    local transactions.Output[] initial_outputs = []
    for 0 <= int position < int(len(params.genesis)) step 2
        local wallets.Wallet destination = transactions.entry(named, params.genesis[position])
        initial_outputs = initial_outputs.append(transactions.Output(destination.address, int.parse(params.genesis[position + 1])))
    local transactions.Transaction genesis_tx = transactions.create_coinbase(0, initial_outputs)
    local blocks.Block genesis_block = blocks.Block(0, string.repeat("0", 32), genesis_tx.txid, 0, 0, 0, [genesis_tx])
    local map.Map<string, transactions.Coin> genesis_utxo
    transactions.apply_transaction(&genesis_utxo, genesis_tx, 0)
    records = [chain.Record(genesis_block, -1, genesis_utxo, [], "genesis", 1)]
    .record_index.set(genesis_block.hash, 0)
    .refresh()

    void .refresh()
        main_chain = chain.chain_to(records, tip)
        confirmed = map.Map<string, int>()
        for int index = main_chain[]
            for transactions.Transaction payment = records[index].block.txs[]
                .confirmed.set(payment.txid, records[index].height)

    void .log(string text)
        log_lines = log_lines.append("{now} " + text)

    void .tally(string category, string reason)
        string key = category + " " + reason
        int count = 0
        if rejections.has(key)
            count = transactions.entry(rejections, key)
        .rejections.set(key, count + 1)

    int .peer(string name)
        if not peer_index.has(name)
            .peer_index.set(name, int(len(peers)))
            peers = peers.append(Peer(name))
        return transactions.entry(peer_index, name)

    int next_height()
        return records[tip].height + 1

    int reward(int height)
        return chain.reward(height, params.initial_reward, params.halving_interval)

    int difficulty(int parent)
        return chain.required_difficulty(records, parent, params.initial_difficulty, params.retarget_interval, params.target_spacing)

    bool mature(transactions.Coin coin)
        return coin.mature(next_height(), params.maturity)

    set.Set<string> locked()
        set.Set<string> result
        for MempoolEntry pending = mempool[]
            for string reference = pending.transaction.inputs[]
                .result.add(reference)
        return result

    MempoolEntry[] priority()
        MempoolEntry[] ranked = []
        for MempoolEntry pending = mempool[]
            int position = int(len(ranked))
            ranked = ranked.append(pending)
            while position > 0 and priority_before(pending, ranked[position - 1])
                ranked[position] = ranked[position - 1]
                position -= 1
            ranked[position] = pending
        return ranked

    int find_entry(string txid)
        for int index < int(len(mempool))
            if mempool[index].transaction.txid == txid
                return index
        return -1

    Acceptance acceptance(transactions.Transaction payment)
        if payment.is_coinbase()
            return Acceptance("coinbase")
        if confirmed.has(payment.txid) or find_entry(payment.txid) >= 0
            return Acceptance("duplicate")
        set.Set<string> spent
        transactions.Check result = transactions.check_transaction(payment, records[tip].utxo, spent, next_height(), owners, params.maturity)
        if result.reason != ""
            return Acceptance(result.reason)
        if result.fee * 1000 < params.min_fee_rate * payment.size
            return Acceptance("low-fee")
        string[] conflicts = []
        int total = 0
        bool higher_rate = true
        for MempoolEntry pending = mempool[]
            bool conflict = false
            for string reference = pending.transaction.inputs[]
                for string candidate = payment.inputs[]
                    if reference == candidate
                        conflict = true
            if conflict
                conflicts = conflicts.append(pending.transaction.txid)
                total += pending.fee
                if result.fee * pending.transaction.size <= pending.fee * payment.size
                    higher_rate = false
        if len(conflicts) > 0 and (result.fee <= total or not higher_rate)
            return Acceptance("conflict")
        return Acceptance("", result.fee, conflicts)

    void .record_drop(string txid, string reason)
        .drop_record.set(txid, reason)
        .log("DROP " + hashing.short(txid) + " " + reason)

    void .drop(string txid, string reason)
        mempool = [for MempoolEntry pending = mempool[] if pending.transaction.txid != txid then pending]
        .record_drop(txid, reason)

    void .register(transactions.Transaction payment, Acceptance result, int arrival)
        for string txid = result.conflicts[]
            .drop(txid, "replaced")
        mempool = mempool.append(MempoolEntry(payment, result.fee, arrival))
        if int(len(mempool)) > params.mempool_limit
            MempoolEntry[] ranked = priority()
            .drop(ranked[len(ranked) - 1].transaction.txid, "mempool-full")

    void .rebuild(transactions.Transaction[] returned)
        MempoolEntry[] previous = mempool
        mempool = []
        MempoolEntry[] candidates = [for transactions.Transaction payment = returned[] then MempoolEntry(payment, 0, now, true)].concat(previous)
        for MempoolEntry candidate = candidates[]
            transactions.Transaction payment = candidate.transaction
            if confirmed.has(payment.txid)
                continue
            Acceptance result = acceptance(payment)
            if result.reason != ""
                .record_drop(payment.txid, result.reason)
            else
                if candidate.returned
                    .log("RETURN " + hashing.short(payment.txid))
                .register(payment, result, candidate.arrival)

    void .switch_tip(int target)
        int old_tip = tip
        int fork = chain.fork_point(records, tip, target)
        int disconnected = records[tip].height - records[fork].height
        int connected = records[target].height - records[fork].height
        chain.Record candidate = records[target]
        int fork_height = records[fork].height
        if disconnected > params.max_reorg
            .log("REFUSE {candidate.height} " + hashing.short(candidate.hash) + " work {candidate.cumulative_work} fork {fork_height} depth {disconnected}")
            return
        transactions.Transaction[] returned = []
        for int index = main_chain[fork_height + 1:][]
            returned = returned.concat(records[index].block.txs[1:])
        tip = target
        .refresh()
        if disconnected == 0
            .log("TIP {candidate.height} " + hashing.short(candidate.hash) + " work {candidate.cumulative_work}")
        else
            .log("REORG {candidate.height} " + hashing.short(candidate.hash) + " work {candidate.cumulative_work} fork {fork_height} disconnected {disconnected} connected {connected}")
            reorganizations = reorganizations.append(Reorganization(now, fork_height, disconnected, connected, records[old_tip].hash, candidate.hash))
        .rebuild(returned)

    void .penalize(int peer_number, int points)
        int before = peers[peer_number].score
        peers[peer_number].score += points
        if before < params.ban_score and peers[peer_number].score >= params.ban_score
            .log("BAN {peers[peer_number].name} score {peers[peer_number].score}")

    void .pay(string[] fields)
        wallets.Wallet sender = transactions.entry(named, fields[2])
        int fee = int.parse(fields[3])
        transactions.Output[] outputs = []
        int total = 0
        for 4 <= int position < int(len(fields)) step 2
            wallets.Wallet destination = transactions.entry(named, fields[position])
            int amount = int.parse(fields[position + 1])
            outputs = outputs.append(transactions.Output(destination.address, amount))
            total += amount
        string prefix = "PAY {sender.name} fee {fee} total {total}"
        set.Set<string> held = locked()
        string[] coins = []
        map.Map<string, transactions.Coin> utxo = records[tip].utxo
        for string reference = utxo.keys()[]
            transactions.Coin coin = transactions.entry(utxo, reference)
            if coin.address != sender.address or held.has(reference) or not mature(coin)
                continue
            int position = int(len(coins))
            coins = coins.append(reference)
            while position > 0
                string previous_reference = coins[position - 1]
                transactions.Coin previous_coin = transactions.entry(utxo, previous_reference)
                if coin.amount < previous_coin.amount or (coin.amount == previous_coin.amount and not reference_before(reference, previous_reference))
                    break
                coins[position] = previous_reference
                position -= 1
            coins[position] = reference
        string[] inputs = []
        int gathered = 0
        for string reference = coins[]
            if gathered >= total + fee
                break
            inputs = inputs.append(reference)
            transactions.Coin selected = transactions.entry(utxo, reference)
            gathered += selected.amount
        if gathered < total + fee
            .log(prefix + " rejected insufficient-funds")
            .tally("pay", "insufficient-funds")
            return
        if gathered > total + fee
            outputs = outputs.append(transactions.Output(sender.address, gathered - total - fee))
        transactions.Transaction payment = transactions.create_transaction(inputs, outputs, sender.secret)
        Acceptance result = acceptance(payment)
        prefix += " tx " + hashing.short(payment.txid)
        if result.reason != ""
            .log(prefix + " rejected " + result.reason)
            .tally("pay", result.reason)
            return
        .log(prefix + " accepted inputs {len(inputs)} outputs {len(outputs)} size {payment.size}")
        .register(payment, result, now)

    void .bump(string txid, int fee)
        string prefix = "BUMP " + hashing.short(txid) + " fee {fee}"
        int index = find_entry(txid)
        if index < 0
            .log(prefix + " rejected unknown")
            .tally("bump", "unknown")
            return
        MempoolEntry pending = mempool[index]
        transactions.Transaction original = pending.transaction
        transactions.Output[] outputs = original.outputs
        int last = int(len(outputs)) - 1
        string address = outputs[last].address
        outputs[last].amount -= fee - pending.fee
        bool valid = outputs[last].amount >= 1
        for string reference = original.inputs[]
            transactions.Coin coin = transactions.entry(records[tip].utxo, reference)
            if coin.address != address
                valid = false
        if not valid
            .log(prefix + " rejected no-change")
            .tally("bump", "no-change")
            return
        wallets.Wallet owner = transactions.entry(owners, address)
        transactions.Transaction payment = transactions.create_transaction(original.inputs, outputs, owner.secret)
        Acceptance result = acceptance(payment)
        prefix += " tx " + hashing.short(payment.txid)
        if result.reason != ""
            .log(prefix + " rejected " + result.reason)
            .tally("bump", result.reason)
            return
        .log(prefix + " accepted size {payment.size}")
        .register(payment, result, now)

    void .receive_transaction(int peer_number, transactions.Transaction payment)
        Acceptance result = acceptance(payment)
        string prefix = "TX {peers[peer_number].name} " + hashing.short(payment.txid)
        if result.reason != ""
            peers[peer_number].rejected_txs += 1
            .tally("tx", result.reason)
            .log(prefix + " rejected " + result.reason)
            if result.reason == "coinbase" or result.reason == "bad-output" or result.reason == "bad-sig" or result.reason == "overspend"
                .penalize(peer_number, params.tx_penalty)
        else
            peers[peer_number].accepted_txs += 1
            .log(prefix + " accepted fee {result.fee} size {payment.size}")
            .register(payment, result, now)

    void .mine(wallets.Wallet wallet)
        int height = next_height()
        transactions.Transaction[] payments = []
        int[] fees = []
        int size = 0
        for MempoolEntry pending = priority()[]
            if size + pending.transaction.size <= params.max_block_size
                payments = payments.append(pending.transaction)
                fees = fees.append(pending.fee)
                size += pending.transaction.size
        transactions.Transaction coinbase = transactions.create_coinbase(height, [transactions.Output(wallet.address, reward(height) + math.sum(fees))])
        payments = [coinbase].concat(payments)
        blocks.Block block = blocks.mine_block(height, records[tip].hash, payments, math.max(now, chain.median_time(records, tip) + 1), difficulty(tip))
        map.Map<string, transactions.Coin> utxo = records[tip].utxo
        for transactions.Transaction payment = payments[]
            transactions.apply_transaction(&utxo, payment, height)
        int work = records[tip].cumulative_work + 16 ^ block.difficulty
        records = records.append(chain.Record(block, tip, utxo, fees, "local", work))
        int index = int(len(records)) - 1
        .record_index.set(block.hash, index)
        .log("MINE {wallet.name} {height} " + hashing.short(block.hash) + " bits {block.difficulty} nonce {block.nonce} txs {len(payments)} size {size} fees {math.sum(fees)} work {work}")
        .switch_tip(index)

    void .reject_block(string kind, blocks.Block block, int peer_number, string reason)
        .rejected.add(block.hash)
        peers[peer_number].rejected_blocks += 1
        .tally("block", reason.split(" ")[0])
        .log("{kind} {peers[peer_number].name} {block.height} " + hashing.short(block.hash) + " rejected " + reason)
        if reason != "time-too-new"
            .penalize(peer_number, params.block_penalty)

    Validation validate(blocks.Block block, int parent)
        map.Map<string, transactions.Coin> utxo = records[parent].utxo
        int[] fees = []
        if block.height != records[parent].height + 1
            return Validation("bad-height", utxo, fees)
        if block.difficulty != difficulty(parent)
            return Validation("bad-difficulty", utxo, fees)
        if block.timestamp <= chain.median_time(records, parent)
            return Validation("time-too-old", utxo, fees)
        if block.timestamp > now + params.drift
            return Validation("time-too-new", utxo, fees)
        set.Set<string> spent
        for 1 <= int position < int(len(block.txs))
            transactions.Transaction payment = block.txs[position]
            transactions.Check result = transactions.check_transaction(payment, utxo, spent, block.height, owners, params.maturity)
            if result.reason != ""
                return Validation(result.reason + " tx {position + 1}", utxo, fees)
            for string reference = payment.inputs[]
                .spent.add(reference)
            transactions.apply_transaction(&utxo, payment, block.height)
            fees = fees.append(result.fee)
        transactions.Transaction coinbase = block.txs[0]
        for transactions.Output output = coinbase.outputs[]
            if not owners.has(output.address) or output.amount == 0
                return Validation("bad-output tx 1", utxo, fees)
        if coinbase.output_total() > reward(block.height) + math.sum(fees)
            return Validation("bad-coinbase", utxo, fees)
        transactions.apply_transaction(&utxo, coinbase, block.height)
        return Validation("", utxo, fees)

    void .connect(string kind, blocks.Block block, int peer_number)
        int parent = transactions.entry(record_index, block.previous)
        Validation result = validate(block, parent)
        if result.reason != ""
            .reject_block(kind, block, peer_number, result.reason)
            return
        int work = records[parent].cumulative_work + 16 ^ block.difficulty
        records = records.append(chain.Record(block, parent, result.utxo, result.fees, peers[peer_number].name, work))
        int index = int(len(records)) - 1
        .record_index.set(block.hash, index)
        peers[peer_number].accepted_blocks += 1
        .log("{kind} {peers[peer_number].name} {block.height} " + hashing.short(block.hash) + " accepted work {work}")
        if work > records[tip].cumulative_work
            .switch_tip(index)

    void .resolve(string start)
        string[] queue = [start]
        int head = 0
        while head < int(len(queue))
            string parent_hash = queue[head]
            head += 1
            Orphan[] children = [for Orphan orphan = orphans[] if orphan.block.previous == parent_hash then orphan]
            orphans = [for Orphan orphan = orphans[] if orphan.block.previous != parent_hash then orphan]
            for Orphan orphan = children[]
                if rejected.has(parent_hash)
                    .reject_block("UNORPHAN", orphan.block, orphan.peer, "bad-parent")
                else
                    .connect("UNORPHAN", orphan.block, orphan.peer)
                queue = queue.append(orphan.block.hash)

    void .receive_block(int peer_number, blocks.Block block)
        bool duplicate = record_index.has(block.hash) or rejected.has(block.hash)
        for Orphan orphan = orphans[]
            if orphan.block.hash == block.hash
                duplicate = true
        string prefix = "BLOCK {peers[peer_number].name} {block.height} " + hashing.short(block.hash)
        if duplicate
            .log(prefix + " rejected duplicate")
            peers[peer_number].rejected_blocks += 1
            .tally("block", "duplicate")
            return
        string reason = blocks.context_free_error(block, params.max_block_size)
        if reason == "" and rejected.has(block.previous)
            reason = "bad-parent"
        if reason != ""
            .reject_block("BLOCK", block, peer_number, reason)
            .resolve(block.hash)
            return
        if not record_index.has(block.previous)
            orphans = orphans.append(Orphan(block, peer_number))
            peers[peer_number].orphaned_blocks += 1
            .log(prefix + " orphan parent " + hashing.short(block.previous))
            if int(len(orphans)) > params.orphan_limit
                .log("EVICT " + hashing.short(orphans[0].block.hash) + " orphan-limit")
                orphans = orphans[1:]
            return
        .connect("BLOCK", block, peer_number)
        .resolve(block.hash)

    void .status(string txid)
        string prefix = "STATUS " + hashing.short(txid)
        if confirmed.has(txid)
            int height = transactions.entry(confirmed, txid)
            .log(prefix + " confirmed {height} confirmations {next_height() - height}")
            return
        MempoolEntry[] ranked = priority()
        for int rank < int(len(ranked))
            if ranked[rank].transaction.txid == txid
                .log(prefix + " mempool rank {rank + 1} of {len(ranked)}")
                return
        if drop_record.has(txid)
            string reason = transactions.entry(drop_record, txid)
            .log(prefix + " dropped " + reason)
            return
        for chain.Record record = records[]
            for transactions.Transaction payment = record.block.txs[]
                if payment.txid == txid
                    .log(prefix + " stale")
                    return
        .log(prefix + " unknown")

    int balance(string address)
        int total = 0
        for transactions.Coin coin = records[tip].utxo.values()[]
            if coin.address == address
                total += coin.amount
        return total

    void .print_state()
        MempoolEntry[] ranked = priority()
        int size = 0
        for MempoolEntry pending = ranked[]
            size += pending.transaction.size
        chain.Record head = records[tip]
        .log("PRINT height {head.height} tip " + hashing.short(head.hash) + " work {head.cumulative_work} bits {difficulty(tip)} reward {reward(next_height())} mempool {len(ranked)} size {size} orphans {len(orphans)}")
        for int rank < int(len(ranked))
            MempoolEntry pending = ranked[rank]
            .log("MEMPOOL {rank + 1} " + hashing.short(pending.transaction.txid) + " fee {pending.fee} size {pending.transaction.size}")
        for wallets.Wallet wallet = managed[]
            .log("BALANCE {wallet.name} {balance(wallet.address)}")

    void .process_event(string[] fields, string[] texts)
        now = int.parse(fields[0])
        MempoolEntry[] previous = mempool
        for MempoolEntry pending = previous[]
            if now - pending.arrival >= params.expiry
                .drop(pending.transaction.txid, "expired")
        string kind = fields[1]
        if kind == "PAY"
            .pay(fields)
        elif kind == "BUMP"
            .bump(fields[2], int.parse(fields[3]))
        elif kind == "MINE"
            wallets.Wallet wallet = transactions.entry(named, fields[2])
            .mine(wallet)
        elif kind == "STATUS"
            .status(fields[2])
        elif kind == "PRINT"
            .print_state()
        else
            int peer_number = .peer(fields[2])
            if peers[peer_number].score >= params.ban_score
                peers[peer_number].ignored += 1
                .log("IGNORE {peers[peer_number].name} {kind}")
            elif kind == "TX"
                .receive_transaction(peer_number, transactions.parse_transaction(fields[3]))
            else
                .receive_block(peer_number, blocks.parse_block_event(fields, texts))

    string[] chain_lines()
        chain.Record head = records[tip]
        string[] lines = ["TIP {head.height} {head.hash} work {head.cumulative_work} stored {len(records)} orphans {len(orphans)}"]
        set.Set<string> main_hashes
        int rewards = 0
        int fees = 0
        int minted = 0
        for int index = main_chain[]
            chain.Record record = records[index]
            blocks.Block block = record.block
            .main_hashes.add(record.hash)
            string miner_name = "-"
            if record.height > 0
                wallets.Wallet owner = transactions.entry(owners, block.txs[0].outputs[0].address)
                miner_name = owner.name
                rewards += reward(record.height)
                fees += record.fees
                minted += block.txs[0].output_total()
            lines = lines.append("BLOCK {block.height} {block.hash} prev " + hashing.short(block.previous) + " time {block.timestamp} bits {block.difficulty} nonce {block.nonce} txs {len(block.txs)} size {block.size()} fees {record.fees} miner {miner_name} source {record.source} work {record.cumulative_work}")
            for int position < int(len(block.txs))
                transactions.Transaction payment = block.txs[position]
                if payment.is_coinbase()
                    string category = if block.height == 0 then "genesis" else "coinbase"
                    lines = lines.append("TX {position + 1} {payment.txid} {category} out {len(payment.outputs)} amount {payment.output_total()}")
                else
                    lines = lines.append("TX {position + 1} {payment.txid} payment in {len(payment.inputs)} out {len(payment.outputs)} size {payment.size} fee {record.transaction_fees[position - 1]}")
        int[] stale = []
        for int index < int(len(records))
            if main_hashes.has(records[index].hash)
                continue
            int position = int(len(stale))
            stale = stale.append(index)
            while position > 0
                chain.Record previous = records[stale[position - 1]]
                chain.Record candidate = records[index]
                if candidate.height > previous.height or (candidate.height == previous.height and candidate.hash >= previous.hash)
                    break
                stale[position] = stale[position - 1]
                position -= 1
            stale[position] = index
        for int index = stale[]
            chain.Record record = records[index]
            lines = lines.append("STALE {record.height} {record.hash} prev " + hashing.short(record.block.previous) + " source {record.source} work {record.cumulative_work}")
        for Orphan orphan = orphans[]
            lines = lines.append("ORPHAN {orphan.block.height} {orphan.block.hash} prev " + hashing.short(orphan.block.previous) + " source {peers[orphan.peer].name}")
        for Reorganization change = reorganizations[]
            lines = lines.append("REORG {change.time} fork {change.fork_height} disconnected {change.disconnected} connected {change.connected} old " + hashing.short(change.old_hash) + " new " + hashing.short(change.new_hash))
        for wallets.Wallet wallet = managed[]
            int count = 0
            int coinbase = 0
            int paid = 0
            for int index = main_chain[1:][]
                chain.Record record = records[index]
                if record.block.txs[0].outputs[0].address == wallet.address
                    count += 1
                    coinbase += record.block.txs[0].output_total()
                    paid += record.fees
            if count > 0
                lines = lines.append("MINER {wallet.name} blocks {count} coinbase {coinbase} fees {paid}")
        int first = 1
        while first < int(len(main_chain))
            int last = first
            int bits = records[main_chain[first]].block.difficulty
            while last + 1 < int(len(main_chain)) and records[main_chain[last + 1]].block.difficulty == bits
                last += 1
            lines = lines.append("BITS {bits} heights {first}-{last} blocks {last - first + 1}")
            first = last + 1
        for string name = peer_index.keys().sorted()[]
            int peer_number = transactions.entry(peer_index, name)
            Peer sender = peers[peer_number]
            string state = if sender.score >= params.ban_score then "banned" else "ok"
            lines = lines.append("PEER {name} blocks {sender.accepted_blocks} rejected {sender.rejected_blocks} orphans {sender.orphaned_blocks} txs {sender.accepted_txs} rejected {sender.rejected_txs} ignored {sender.ignored} score {sender.score} {state}")
        MempoolEntry[] ranked = priority()
        for int rank < int(len(ranked))
            MempoolEntry pending = ranked[rank]
            lines = lines.append("MEMPOOL {rank + 1} {pending.transaction.txid} fee {pending.fee} size {pending.transaction.size} time {pending.arrival}")
        for string key = rejections.keys().sorted()[]
            int count = transactions.entry(rejections, key)
            lines = lines.append("REJECT {key} {count}")
        int utxo_total = 0
        for transactions.Coin coin = head.utxo.values()[]
            utxo_total += coin.amount
        lines = lines.append("SUPPLY genesis {records[0].block.txs[0].output_total()} rewards {rewards} fees {fees} burned {rewards + fees - minted} utxo {utxo_total}")
        return lines

    string[] balance_lines()
        string[] lines = ["wallet,address,balance,immature,locked,incoming,utxos"]
        set.Set<string> held = locked()
        map.Map<string, transactions.Coin> utxo = records[tip].utxo
        for wallets.Wallet wallet = managed[]
            int total = 0
            int immature = 0
            int locked_amount = 0
            int count = 0
            int incoming = 0
            for string reference = utxo.keys()[]
                transactions.Coin coin = transactions.entry(utxo, reference)
                if coin.address != wallet.address
                    continue
                total += coin.amount
                count += 1
                if not mature(coin)
                    immature += coin.amount
                if held.has(reference)
                    locked_amount += coin.amount
            for MempoolEntry pending = mempool[]
                for transactions.Output output = pending.transaction.outputs[]
                    if output.address == wallet.address
                        incoming += output.amount
            lines = lines.append("{wallet.name},{wallet.address},{total},{immature},{locked_amount},{incoming},{count}")
        return lines

    string[] utxo_lines()
        string[] lines = []
        string[] hashes = []
        int total = 0
        set.Set<string> held = locked()
        map.Map<string, transactions.Coin> utxo = records[tip].utxo
        string[] references = []
        for string reference = utxo.keys()[]
            int position = int(len(references))
            references = references.append(reference)
            while position > 0 and reference_before(reference, references[position - 1])
                references[position] = references[position - 1]
                position -= 1
            references[position] = reference
        for string reference = references[]
            transactions.Coin coin = transactions.entry(utxo, reference)
            wallets.Wallet owner = transactions.entry(owners, coin.address)
            string category = if coin.height == 0 then "genesis" elif coin.coinbase then "coinbase" else "payment"
            string state = if not mature(coin) then "immature" elif held.has(reference) then "locked" else "free"
            string line = "{reference} {owner.name} {coin.amount} height {coin.height} {category} {state}"
            lines = lines.append(line)
            hashes = hashes.append(hashing.digest(line))
            total += coin.amount
        return lines.concat(["TOTAL {utxo.size()} {total}", "ROOT " + hashing.merkle_root(hashes)])

    string[] history_lines()
        map.Map<string, transactions.Transaction> payments
        for int index = main_chain[]
            for transactions.Transaction payment = records[index].block.txs[]
                .payments.set(payment.txid, payment)
        string[] lines = []
        for wallets.Wallet wallet = managed[]
            lines = lines.append("WALLET {wallet.name} {wallet.address}")
            int count = 0
            int spent_total = 0
            int received_total = 0
            int running_balance = 0
            for int index = main_chain[]
                chain.Record record = records[index]
                for transactions.Transaction payment = record.block.txs[]
                    int spent = 0
                    int received = 0
                    bool involved = false
                    for string reference = payment.inputs[]
                        string[] parts = reference.split(":")
                        transactions.Transaction earlier = transactions.entry(payments, parts[0])
                        transactions.Output output = earlier.outputs[int.parse(parts[1])]
                        if output.address == wallet.address
                            spent += output.amount
                            involved = true
                    for transactions.Output output = payment.outputs[]
                        if output.address == wallet.address
                            received += output.amount
                            involved = true
                    if not involved
                        continue
                    count += 1
                    spent_total += spent
                    received_total += received
                    running_balance += received - spent
                    string category = if not payment.is_coinbase() then "payment" elif record.height == 0 then "genesis" else "coinbase"
                    lines = lines.append("{record.height} " + hashing.short(payment.txid) + " {category} spent {spent} received {received} net " + signed(received - spent) + " balance {running_balance}")
            int pending_count = 0
            for MempoolEntry pending = priority()[]
                int spent = 0
                int received = 0
                for string reference = pending.transaction.inputs[]
                    transactions.Coin coin = transactions.entry(records[tip].utxo, reference)
                    if coin.address == wallet.address
                        spent += coin.amount
                for transactions.Output output = pending.transaction.outputs[]
                    if output.address == wallet.address
                        received += output.amount
                if spent != 0 or received != 0
                    pending_count += 1
                    lines = lines.append("pending " + hashing.short(pending.transaction.txid) + " spent {spent} received {received} net " + signed(received - spent))
            lines = lines.append("END {wallet.name} txs {count} spent {spent_total} received {received_total} balance {running_balance} pending {pending_count}")
        return lines

void write_lines(string name, string[] lines)
    file.write("output/" + name, if len(lines) == 0 then "" else lines.join(NL) + NL)

Params settings = Params([for string line = read_lines("input/params.txt")[] then line.split(" ")])
Node node = Node(settings, wallets.read_wallets("input/wallets.txt"))
string[] events = read_lines("input/events.txt")
int position = 0
while position < int(len(events))
    string[] fields = events[position].split(" ")
    int count = if fields[1] == "BLOCK" then int.parse(fields[9]) else 0
    .node.process_event(fields, events[position + 1:<position + 1 + count])
    position += count + 1
if not file.is_directory("output")
    file.mkdir("output")
write_lines("log.txt", node.log_lines)
write_lines("chain.txt", node.chain_lines())
write_lines("balances.csv", node.balance_lines())
write_lines("utxo.txt", node.utxo_lines())
write_lines("history.txt", node.history_lines())
