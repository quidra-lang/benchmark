import hashing = "./hashing.qui"
import transactions = "./transactions.qui"

string header_text(int height, string previous, string merkle, int timestamp, int difficulty, int nonce)
    return "{height}|{previous}|{merkle}|{timestamp}|{difficulty}|{nonce}"

class Block(int height, string previous, string merkle, int timestamp, int difficulty, int nonce, transactions.Transaction[] txs)
    string hash = hashing.digest(header_text(height, previous, merkle, timestamp, difficulty, nonce))

    int size()
        int amount = 0
        for int index = (1:<int(len(txs)))[]
            amount += txs[index].size
        return amount

    string[] txids()
        return [for auto transaction = txs[] then transaction.txid]

bool meets_difficulty(string hash, int difficulty)
    return hash.starts_with(string.repeat("0", nat(difficulty)))

Block parse_block_event(string[] fields, string[] texts)
    return Block(int.parse(fields[3]), fields[4], fields[5], int.parse(fields[6]), int.parse(fields[7]), int.parse(fields[8]), [for string text = texts[] then transactions.parse_transaction(text)])

Block mine_block(int height, string previous, transactions.Transaction[] payments, int timestamp, int difficulty)
    string merkle = hashing.merkle_root([for auto transaction = payments[] then transaction.txid])
    int nonce = 0
    while not meets_difficulty(hashing.digest(header_text(height, previous, merkle, timestamp, difficulty, nonce)), difficulty)
        nonce += 1
    return Block(height, previous, merkle, timestamp, difficulty, nonce, payments)

string context_free_error(Block block, int maximum)
    if not meets_difficulty(block.hash, block.difficulty)
        return "bad-pow"
    if hashing.merkle_root(block.txids()) != block.merkle
        return "bad-merkle"
    transactions.Transaction first = block.txs[0]
    if not first.is_coinbase() or first.coinbase_height != block.height
        return "bad-structure"
    for int index = (1:<int(len(block.txs)))[]
        if block.txs[index].is_coinbase()
            return "bad-structure"
    return if block.size() > maximum then "too-large" else ""
