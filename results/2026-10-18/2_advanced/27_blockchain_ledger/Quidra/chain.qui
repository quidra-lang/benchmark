import math
import blocks = "./blocks.qui"
import transactions = "./transactions.qui"

class Record(blocks.Block block, int parent, map.Map<string, transactions.Coin> utxo, int[] transaction_fees, string source, int cumulative_work)
    int fees = math.sum(transaction_fees)
    int height = block.height
    string hash = block.hash

int reward(int height, int initial, int interval)
    int amount = initial
    for int _ < height / interval
        amount /= 2
    return amount

int ancestor(Record[] records, int start, int height)
    int cursor = start
    while records[cursor].height > height
        cursor = records[cursor].parent
    return cursor

int[] chain_to(Record[] records, int start)
    int[] reverse = []
    int cursor = start
    while cursor >= 0
        reverse = reverse.append(cursor)
        cursor = records[cursor].parent
    return reverse[::-1]

int fork_point(Record[] records, int first, int second)
    int height = math.min(records[first].height, records[second].height)
    int left = ancestor(records, first, height)
    int right = ancestor(records, second, height)
    while left != right
        left = records[left].parent
        right = records[right].parent
    return left

int median_time(Record[] records, int start)
    int[] times = []
    int cursor = start
    while cursor >= 0 and len(times) < 3
        times = times.append(records[cursor].block.timestamp)
        cursor = records[cursor].parent
    return times.sorted()[(len(times) - 1) / 2]

int required_difficulty(Record[] records, int parent, int initial, int interval, int target)
    int height = records[parent].height + 1
    int difficulty = records[parent].block.difficulty
    if height == 1
        return initial
    if height % interval != 0
        return difficulty
    int first = ancestor(records, parent, height - interval)
    int span = records[parent].block.timestamp - records[first].block.timestamp
    int expected = target * (interval - 1)
    if 2 * span < expected
        return math.min(difficulty + 1, 2)
    return if span > 2 * expected then math.max(difficulty - 1, 0) else difficulty
