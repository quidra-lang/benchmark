import syntax = "./grammar_parser.qui"

class Result(string[] order, string[][][] rules, string[] log)

string fresh(string[] order, string name)
    while true
        name = name[0:<int(len(name)) - 1] + "'>"
        if syntax.index_of(order, name) < 0
            return name

bool leading_reachable(string[] order, string[][][] rules, string start, string target)
    int initial = syntax.index_of(order, start)
    int[] queue = [initial]
    bool[] visited = [for int i < int(len(order)) then i == initial]
    int cursor = 0
    while cursor < int(len(queue))
        int lhs = queue[cursor]
        cursor += 1
        for string[] rhs = rules[lhs][]
            if len(rhs) == 0
                continue
            string symbol = rhs[0]
            if symbol == target
                return true
            int next = syntax.index_of(order, symbol)
            if next >= 0 and not visited[next]
                visited[next] = true
                queue = queue.append(next)
    return false

string[][] unique(string[][] values)
    string[][] result = []
    for string[] rhs = values[]
        if syntax.index_of(result, rhs) < 0
            result = result.append(rhs)
    return result

Result eliminate(string[] source_order, string[][][] source_rules)
    string[] order = source_order
    string[][][] rules = source_rules
    string[] log = []
    for int original < int(len(source_order))
        string lhs_name = source_order[original]
        for int earlier < original
            int lhs = syntax.index_of(order, lhs_name)
            string other = source_order[earlier]
            bool starts = false
            for string[] rhs = rules[lhs][]
                if len(rhs) > 0 and rhs[0] == other
                    starts = true
                    break
            if starts and leading_reachable(order, rules, other, lhs_name)
                string[][] replaced = []
                int other_index = syntax.index_of(order, other)
                for string[] rhs = rules[lhs][]
                    if len(rhs) > 0 and rhs[0] == other
                        for string[] alternative = rules[other_index][]
                            replaced = replaced.append(alternative.concat(rhs[1:<int(len(rhs))]))
                    else
                        replaced = replaced.append(rhs)
                rules[lhs] = unique(replaced)
                log = log.append("substitute {other} into {lhs_name}")
        int lhs = syntax.index_of(order, lhs_name)
        string[][] retained = []
        string[][] recursive = []
        string[][] ordinary = []
        for string[] rhs = rules[lhs][]
            if len(rhs) == 1 and rhs[0] == lhs_name
                log = log.append("remove cycle {lhs_name} -> {lhs_name}")
            else
                retained = retained.append(rhs)
                if len(rhs) > 0 and rhs[0] == lhs_name
                    recursive = recursive.append(rhs[1:<int(len(rhs))])
                else
                    ordinary = ordinary.append(rhs)
        if len(recursive) > 0
            string name = fresh(order, lhs_name)
            rules[lhs] = [for string[] rhs = ordinary[] then rhs.append(name)]
            string[][] tails = [for string[] rhs = recursive[] then rhs.append(name)]
            tails = tails.append([])
            order = order[0:<lhs + 1].append(name).concat(order[lhs + 1:<int(len(order))])
            rules = rules[0:<lhs + 1].append(tails).concat(rules[lhs + 1:<int(len(rules))])
            log = log.append("eliminate left recursion in {lhs_name} with {name}")
        else
            rules[lhs] = retained
    return Result(order, rules, log)

Result factor(string[] source_order, string[][][] source_rules)
    string[] order = source_order
    string[][][] rules = source_rules
    string[] log = []
    int cursor = 0
    while cursor < int(len(order))
        string lhs_name = order[cursor]
        string[][] alternatives = []
        string[] seen = []
        string[] created = []
        string[][][] created_rules = []
        for string[] rhs = rules[cursor][]
            if len(rhs) == 0
                alternatives = alternatives.append(rhs)
                continue
            string first = rhs[0]
            if syntax.index_of(seen, first) >= 0
                continue
            seen = seen.append(first)
            string[][] group = [for string[] member = rules[cursor][] if len(member) > 0 and member[0] == first then member]
            if len(group) == 1
                alternatives = alternatives.append(rhs)
                continue
            int length = int(len(rhs))
            for string[] member = group[]
                if int(len(member)) < length
                    length = int(len(member))
                int matching = 0
                while matching < length and rhs[matching] == member[matching]
                    matching += 1
                length = matching
            string name = fresh(order.concat(created), lhs_name)
            string[] prefix = rhs[0:<length]
            alternatives = alternatives.append(prefix.append(name))
            created = created.append(name)
            created_rules = created_rules.append([for string[] member = group[] then member[length:<int(len(member))]])
            log = log.append("left factor {lhs_name} on {syntax.alternative(prefix)} with {name}")
        rules[cursor] = alternatives
        order = order[0:<cursor + 1].concat(created).concat(order[cursor + 1:<int(len(order))])
        rules = rules[0:<cursor + 1].concat(created_rules).concat(rules[cursor + 1:<int(len(rules))])
        cursor += 1
    return Result(order, rules, log)
