import syntax = "./grammar_parser.qui"
import analysis = "./first_follow.qui"

class Production(int number, int lhs, string[] rhs, string notation)
class Conflict(int lhs, int token, int[] numbers, string kind, int chosen)
class Table(Production[] productions, string[][] predict, string[][] reasons, int[][][] cells, int[][] choices, Conflict[] conflicts)

Production[] number_productions(string[] order, string[][][] rules)
    Production[] result = []
    for int lhs < int(len(order))
        for string[] rhs = rules[lhs][]
            result = result.append(Production(int(len(result)) + 1, lhs, rhs, syntax.production(order[lhs], rhs)))
    return result

Table build(string[] order, string[][][] rules, bool[] nullable, string[][] first, string[][] follow, string[] terminals)
    Production[] productions = number_productions(order, rules)
    string[] columns = terminals.append("$")
    string[][] predict = []
    string[][] reasons = []
    int[][][] cells = [for int i < int(len(order)) then [for int j < int(len(columns)) then []]]
    int[][] choices = [for int i < int(len(order)) then [for int j < int(len(columns)) then 0]]
    for Production production = productions[]
        analysis.Sequence values = analysis.sequence(production.rhs, order, nullable, first)
        string[] tokens = values.first
        if values.nullable
            analysis.merge(&tokens, follow[production.lhs])
        tokens = analysis.terminal_order(tokens)
        string[] token_reasons = []
        for string token = tokens[]
            token_reasons = token_reasons.append(if syntax.index_of(values.first, token) >= 0 then "FIRST" else "FOLLOW")
            int column = syntax.index_of(columns, token)
            cells[production.lhs][column] = cells[production.lhs][column].append(production.number)
        predict = predict.append(tokens)
        reasons = reasons.append(token_reasons)
    Conflict[] conflicts = []
    for int lhs < int(len(order))
        for int column < int(len(columns))
            int[] numbers = cells[lhs][column]
            if len(numbers) == 0
                continue
            int chosen = numbers[0]
            bool has_first = false
            bool has_follow = false
            for int number = numbers[]
                int index = syntax.index_of(predict[number - 1], columns[column])
                if reasons[number - 1][index] == "FIRST"
                    if not has_first
                        chosen = number
                    has_first = true
                else
                    has_follow = true
            choices[lhs][column] = chosen
            if len(numbers) > 1
                string kind = if has_first then (if has_follow then "FIRST/FOLLOW" else "FIRST/FIRST") else "FOLLOW/FOLLOW"
                conflicts = conflicts.append(Conflict(lhs, column, numbers, kind, chosen))
    return Table(productions, predict, reasons, cells, choices, conflicts)
