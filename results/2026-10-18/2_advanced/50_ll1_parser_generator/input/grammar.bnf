# Draft grammar of a small imperative language.
# Terminals are bare words or quoted symbols; %empty is the empty string.
%start <program>
%token id num str true false
%token if then else while do for to downto in return import exit
%tokens or and not

<program> ::= <stmt_list>    # a program is a list of statements
<stmt_list> ::= <stmt> <stmt_list> | %empty

<stmt> ::= id "=" <condition> ";"
         | id "[" <sum> "]" "=" <condition> ";"
         | id "(" <args> ")" ";"
         | <if_stmt> | <while_stmt> | <for_stmt> | <repeat_stmt>
         | <return_stmt> | <import_stmt> | <block> | <ref> ";"
         | <switch_stmt> | <loop_stmt>

<block> ::= "{" <stmt_list> "}"
<block> ::= begin <stmt_list> end |
<if_stmt> ::= if <condition> then <stmt>
            | if <condition> then <stmt> else <stmt>
<while_stmt> ::= while <condition> do <stmt>
<repeat_stmt> := repeat <stmt_list> until <condition> ";"
               | repeat <stmt> until <condition> ";"
<for_stmt> ::= for id "=" <sum> to <sum> do <stmt>
             | for id "=" <sum> downto <sum> do <stmt>
             | for id in <ref> do <stmt>
<return_stmt> ::= return ";" | return <condition> ";"
<loop_stmt> ::= loop <loop_body>
<loop_body> ::= <stmt> <loop_body> | exit <loop_body>

<qualified> ::= <path> "." id | id
<import_stmt> ::= import <path> ";"
<path> ::= <qualified> | <path> "::" id

<condition> ::= <disjunction>
<disjunction> ::= <condition> or <conjunction> | <conjunction>
<conjunction> ::= <conjunction> and <negation> | <negation>
<negation> ::= not <negation> | <comparison>
<comparison> ::= <sum> | <sum> <relop> <sum> | <negation> | not <negation>
<relop> ::= "<" | "<=" | ">" | ">=" | "==" | "!=" | "<"
<sum> ::= <sum> "+" <product> | <sum> "-" <product> | <product>
<product> ::= <product> "*" <unary> | <product> "/" <unary>
            | <product> "%" <unary> | <unary>
<unary> ::= "-" <unary> | <primary>
<unary> ::= "+" <unary
<primary> ::= num | str | <ref> | "(" <condition> ")"
<primary> ::= "num" | "(" <condition> ")"
<primary> ::= true | "false
<ref> ::= id | id "::" id | <ref> "[" <sum> "]" | <ref> "." id | <ref> "(" <args> ")"
<args> ::= <condition> <more_args> | %empty
<more_args> ::= "," <condition> <more_args> | %empty

%start <stmt>
<declaration> ::= var id ":" <type_name> ";"
<type_name> ::= int | bool | <type_name> "[" "]"
