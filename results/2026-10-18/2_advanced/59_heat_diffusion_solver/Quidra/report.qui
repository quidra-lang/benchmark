import math

string padded(int value, int width)
    string text = value.string()
    return string.repeat("0", nat(width - int(len(text)))) + text

string real_text(real64 value, int places)
    int factor = 10 ^ places
    real64 magnitude = if value < 0.0 then -value else value
    int rounded = math.floor(magnitude * real64(factor) + 0.5)
    string sign = if value < 0.0 and rounded != 0 then "-" else ""
    return sign + (rounded / factor).string() + "." + padded(rounded % factor, places)

string time_text(int milliseconds)
    return (milliseconds / 1000).string() + "." + padded(milliseconds % 1000, 3)

string[] temperatures(int width, int height, real64[] field)
    string[] result = []
    for int row < height
        result = result.append([for int column < width then real_text(field[row * width + column], 2)].join(" "))
    return result

class Map(int[] counts, string[] rows)

Map isotherms(int width, int height, real64[] field, real64[] bands)
    int hottest = 0
    for int p < int(len(field))
        if field[p] > field[hottest]
            hottest = p
    int[] counts = [for int i <= int(len(bands)) then 0]
    string[] characters = []
    for int p < int(len(field))
        int digit = 0
        for real64 band = bands[]
            if field[p] >= band
                digit += 1
        counts[digit] += 1
        characters = characters.append(if p == hottest then "*" else digit.string())
    string[] rows = [for int row < height then characters[row * width:<(row + 1) * width].join("")]
    return Map(counts, rows)

void write(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)
