int integer(string text)
    int result = int.parse(text)
    return result

real64 number(string text)
    real64 result = real64.parse(text)
    return result

string[] lines(string path)
    string content = file.read(path)
    string[] rows = content.split(NL)
    return rows[0:<int(len(rows)) - 1]

class Mesh(int width, int height, real64 dx, real64 thickness, string[] codes)
    int count = width * height
    int[][] neighbors = []
    for int row < height
        for int column < width
            local int p = row * width + column
            neighbors = neighbors.append([(if column > 0 then p - 1 else -1), (if column + 1 < width then p + 1 else -1), (if row > 0 then p - width else -1), (if row + 1 < height then p + width else -1)])

int cell(int width, int row, int column)
    return row * width + column

int[] coordinates(int width, int point)
    return [point / width, point % width]

Mesh read_plate()
    string[] rows = lines("input/plate.txt")
    string[] header = rows[0].split(" ")
    string[] codes = []
    for string row = rows[1:<int(len(rows))][]
        for int i < int(len(row))
            codes = codes.append(row[i])
    return Mesh(integer(header[0]), integer(header[1]), number(header[2]), number(header[3]), codes)

int[][] segment_faces(int width, int height, string edge, int first, int last)
    int[][] result = []
    for first <= int coordinate <= last
        if edge == "top"
            result = result.append([cell(width, 0, coordinate), 2])
        elif edge == "bottom"
            result = result.append([cell(width, height - 1, coordinate), 3])
        elif edge == "left"
            result = result.append([cell(width, coordinate, 0), 0])
        else
            result = result.append([cell(width, coordinate, width - 1), 1])
    return result

int[] source_cells(int width, int first_row, int first_column, int last_row, int last_column)
    int[] result = []
    for first_row <= int row <= last_row
        for first_column <= int column <= last_column
            result = result.append(cell(width, row, column))
    return result
