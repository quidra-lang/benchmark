real64 number(string text)
    real64 result = real64.parse(text)
    return result

class Material(string code, string name, real64 k, real64 rho, real64 cp)

Material[] read_materials()
    string content = file.read("input/materials.txt")
    string[] rows = content.split(NL)
    Material[] result = []
    for string row = rows[0:<int(len(rows)) - 1][]
        string[] fields = row.split(" ")
        result = result.append(Material(fields[0], fields[1], number(fields[2]), number(fields[3]), number(fields[4])))
    return result

real64 capacity(Material material, real64 dx, real64 thickness)
    return material.rho * material.cp * dx * dx * thickness

real64 interior(real64 first, real64 second, real64 thickness)
    return 2.0 * first * second / (first + second) * thickness

real64 fixed(real64 k, real64 thickness)
    return 2.0 * k * thickness

real64 convective(real64 k, real64 h, real64 dx, real64 thickness)
    return 1.0 / (1.0 / (h * dx * thickness) + 1.0 / (2.0 * k * thickness))
