import lexer = "./lexer.qui"

class Position(string display_name, int line)
    string text()
        return "{display_name}:{line}"

class Diagnostic(Position position, string kind, string message)
class Problem(string reason)
class Macro(string name, bool function_like, string[] parameters, bool variadic, lexer.Token[] replacement, Position position, bool main_file, int expanded = 0, int tested = 0)
    string signature()
        if not function_like
            return name
        string[] names = parameters
        if variadic
            names[int(len(names)) - 1] = "..."
        return "{name}({names.join(", ")})"

    string definition()
        return "#define " + signature() + (if len(replacement) == 0 then "" else " " + lexer.render(replacement))

bool builtin(string name)
    return lexer.has(["__LINE__", "__FILE__", "__COUNTER__"], name)

string | Problem macro_name(const lexer.Token[] tokens, string directive)
    if len(tokens) == 0
        return Problem("no macro name given in #{directive} directive")
    lexer.Token token = tokens[0]
    if token.kind != "identifier"
        return Problem("macro names must be identifiers")
    if token.text == "defined"
        return Problem("{DQ}defined{DQ} cannot be used as a macro name")
    if builtin(token.text)
        string verb = if directive == "define" then "redefine" else "undefine"
        return Problem("cannot {verb} builtin macro {DQ}{token.text}{DQ}")
    return token.text

bool identical(const Macro first, const Macro second)
    if first.function_like != second.function_like or first.parameters != second.parameters or first.variadic != second.variadic or len(first.replacement) != len(second.replacement)
        return false
    for int position < int(len(first.replacement))
        if first.replacement[position].text != second.replacement[position].text or first.replacement[position].space != second.replacement[position].space
            return false
    return true

Macro | Problem parse(const lexer.Token[] tokens, const Position position, bool main_file)
    string name = ""
    match macro_name(tokens, "define")
        string found
            name = found
        Problem problem
            return problem
    string va_error = "{DQ}__VA_ARGS__{DQ} can only appear in the expansion of a variadic macro"
    if name == "__VA_ARGS__"
        return Problem(va_error)
    int cursor = 1
    string[] parameters = []
    bool function_like = false
    bool variadic = false
    if len(tokens) > 1 and tokens[1].text == "(" and not tokens[1].space
        function_like = true
        cursor = 2
        if cursor < int(len(tokens)) and tokens[cursor].text == ")"
            cursor += 1
        else
            while true
                if cursor == int(len(tokens))
                    return Problem("missing ')' in macro parameter list")
                lexer.Token token = tokens[cursor]
                if token.text == "..."
                    variadic = true
                    parameters = parameters.append("__VA_ARGS__")
                elif token.kind == "identifier"
                    if token.text == "__VA_ARGS__"
                        return Problem(va_error)
                    if lexer.has(parameters, token.text)
                        return Problem("duplicate macro parameter {DQ}{token.text}{DQ}")
                    parameters = parameters.append(token.text)
                else
                    return Problem("expected parameter name, found {DQ}{token.text}{DQ}")
                cursor += 1
                if cursor == int(len(tokens))
                    return Problem("missing ')' in macro parameter list")
                if tokens[cursor].text == ")"
                    cursor += 1
                    break
                if variadic
                    return Problem("expected ')' after {DQ}...{DQ}, found {DQ}{tokens[cursor].text}{DQ}")
                if tokens[cursor].text != ","
                    return Problem("expected ',' or ')', found {DQ}{tokens[cursor].text}{DQ}")
                cursor += 1
    lexer.Token[] replacement = tokens[cursor:<int(len(tokens))]
    if len(replacement) > 0
        replacement[0].space = false
        if replacement[0].text == "##" or replacement[int(len(replacement)) - 1].text == "##"
            return Problem("'##' cannot appear at either end of a macro expansion")
    for int index < int(len(replacement))
        lexer.Token token = replacement[index]
        if token.kind == "identifier" and token.text == "__VA_ARGS__" and not variadic
            return Problem(va_error)
        if token.text == "#" and function_like and (index + 1 == int(len(replacement)) or replacement[index + 1].kind != "identifier" or not lexer.has(parameters, replacement[index + 1].text))
            return Problem("'#' is not followed by a macro parameter")
    return Macro(name, function_like, parameters, variadic, replacement, position, main_file)
