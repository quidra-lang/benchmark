import lexer = "./lexer.qui"

class SourceFile(string path, lexer.LogicalLine[] lines, int physical_lines, string | none guard, int entered = 0, int skipped = 0, int output_lines = 0, int skipped_lines = 0, bool once = false)
class Manager(SourceFile[] files = [], map.Map<string, int> lookup = map.Map<string, int>(), string[] order = [])

string | none search(string name, bool quoted)
    if quoted
        bool exists = file.exists("input/{name}")
        if exists
            return name
    string path = "include/{name}"
    bool exists = file.exists("input/{path}")
    if exists
        return path
    return none

string | none guard_name(const lexer.LogicalLine[] original)
    lexer.LogicalLine[] lines = []
    for lexer.LogicalLine line = original[]
        if len(line.tokens) > 0
            lines = lines.append(line)
    if len(lines) == 0
        return none
    lexer.Token[] first = lines[0].tokens
    lexer.Token[] last = lines[int(len(lines)) - 1].tokens
    if len(first) != 3 or first[0].text != "#" or first[1].text != "ifndef" or first[2].kind != "identifier" or len(last) != 2 or last[0].text != "#" or last[1].text != "endif"
        return none
    int depth = 0
    for int position < int(len(lines))
        lexer.Token[] tokens = lines[position].tokens
        string directive = if len(tokens) >= 2 and tokens[0].text == "#" and tokens[1].kind == "identifier" then tokens[1].text else ""
        if depth == 1 and lexer.has(["elif", "elifdef", "elifndef", "else"], directive)
            return none
        if lexer.has(["if", "ifdef", "ifndef"], directive)
            depth += 1
        elif directive == "endif"
            depth -= 1
        if depth == 0 and position + 1 != int(len(lines))
            return none
    if depth == 0
        return first[2].text
    return none

int enter(Manager &manager, string path)
    int index = -1
    match manager.lookup.get(path)
        int found
            index = found
        none
            string text = file.read("input/{path}")
            lexer.LogicalLine[] lines = lexer.lex(text)
            int physical_lines = 0
            for int position < int(len(text))
                if text[position] == NL
                    physical_lines += 1
            index = int(len(manager.files))
            manager.files = manager.files.append(SourceFile(path, lines, physical_lines, guard_name(lines)))
            manager.order = manager.order.append(path)
            .manager.lookup.set(path, index)
    manager.files[index].entered += 1
    return index
