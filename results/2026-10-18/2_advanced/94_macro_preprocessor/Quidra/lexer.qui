class Token(string kind, string text, int line, bool space, string[] hide = [])
class LogicalLine(Token[] tokens, int start, int end)
class ReadToken(string kind, int length)

bool has<T>(const T[] items, T sought)
    for T item = items[]
        if item == sought
            return true
    return false

string[] unique(const string[] items)
    string[] result = []
    for string item = items[]
        if not has(result, item)
            result = result.append(item)
    return result

string[] intersection(const string[] first, const string[] second)
    string[] result = []
    for string item = first[]
        if has(second, item)
            result = result.append(item)
    return result

string repeat(string text, int count)
    string result = ""
    for int iteration < count
        result += text
    return result

bool letter(string character)
    return (character >= "A" and character <= "Z") or (character >= "a" and character <= "z")

bool digit(string character)
    return character >= "0" and character <= "9"

ReadToken one(string text, int start = 0, bool header = false)
    if start == int(len(text))
        return ReadToken("other", 0)
    string character = text[start]
    if header and character == "<"
        int finish = start + 1
        while finish < int(len(text)) and text[finish] != NL and text[finish] != ">"
            finish += 1
        if finish < int(len(text)) and text[finish] == ">"
            return ReadToken("header", finish - start + 1)
    if letter(character) or character == "_"
        int finish = start + 1
        while finish < int(len(text)) and (letter(text[finish]) or digit(text[finish]) or text[finish] == "_")
            finish += 1
        return ReadToken("identifier", finish - start)
    if digit(character) or (character == "." and start + 1 < int(len(text)) and digit(text[start + 1]))
        int finish = start + 1
        while finish < int(len(text))
            if "eEpP".contains(text[finish]) and finish + 1 < int(len(text)) and "+-".contains(text[finish + 1])
                finish += 2
            elif letter(text[finish]) or digit(text[finish]) or "_.".contains(text[finish])
                finish += 1
            else
                break
        return ReadToken("number", finish - start)
    if character == "'" or character == DQ
        int finish = start + 1
        while finish < int(len(text)) and text[finish] != NL
            if text[finish] == character
                return ReadToken(if character == "'" then "character" else "string", finish - start + 1)
            if text[finish] == "\" and finish + 1 < int(len(text)) and text[finish + 1] != NL
                finish += 2
            else
                finish += 1
    string[] punctuators = ["...", "<<=", ">>=", "->", "++", "--", "<<", ">>", "<=", ">=", "==", "!=", "&&", "||", "*=", "/=", "%=", "+=", "-=", "&=", "^=", "|=", "##"]
    string remaining = text[start:<int(len(text))]
    for string punctuator = punctuators[]
        if remaining.starts_with(punctuator)
            return ReadToken("punctuator", int(len(punctuator)))
    return ReadToken(if "[](){{}}.&*+-~!/%<>^|?:;=,#".contains(character) then "punctuator" else "other", 1)

string | none single(string text)
    if text == "" or text.starts_with("//") or text.starts_with("/*")
        return none
    ReadToken token = one(text)
    if token.length == int(len(text))
        return token.kind
    return none

bool separator(string left, string right)
    return (left == "/" and (right.starts_with("/") or right.starts_with("*"))) or one(left + right).length != int(len(left))

string render(const Token[] tokens, bool output = false)
    string result = ""
    for int position < int(len(tokens))
        Token token = tokens[position]
        if position > 0 and (token.space or (output and separator(tokens[position - 1].text, token.text)))
            result += " "
        result += token.text
    return result

LogicalLine[] lex(string source)
    string spliced = ""
    int[] physical = []
    int position = 0
    int line_number = 1
    while position < int(len(source))
        if source[position] == "\" and position + 1 < int(len(source)) and source[position + 1] == NL
            position += 2
            line_number += 1
            continue
        spliced += source[position]
        physical = physical.append(line_number)
        if source[position] == NL
            line_number += 1
        position += 1
    LogicalLine[] result = []
    Token[] tokens = []
    int start = 1
    bool space = true
    position = 0
    while position < int(len(spliced))
        if spliced[position] == " "
            position += 1
            space = true
            continue
        if spliced[position] == NL
            int finish = physical[position]
            result = result.append(LogicalLine(tokens, start, finish))
            tokens = []
            start = finish + 1
            position += 1
            space = true
            continue
        string remaining = spliced[position:<int(len(spliced))]
        if remaining.starts_with("//")
            while position < int(len(spliced)) and spliced[position] != NL
                position += 1
            space = true
            continue
        if remaining.starts_with("/*")
            position += 2
            while spliced[position:<position + 2] != "*/"
                position += 1
            position += 2
            space = true
            continue
        bool header = len(tokens) == 2 and tokens[0].text == "#" and tokens[1].text == "include"
        ReadToken token = one(spliced, position, header)
        tokens = tokens.append(Token(token.kind, spliced[position:<position + token.length], physical[position], space))
        position += token.length
        space = false
    if len(tokens) > 0
        result = result.append(LogicalLine(tokens, start, line_number))
    return result
