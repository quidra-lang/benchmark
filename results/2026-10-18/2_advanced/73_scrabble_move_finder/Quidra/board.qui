const string letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const string lowercase_letters = "abcdefghijklmnopqrstuvwxyz"
const string columns = "ABCDEFGHIJKLMNO"

int character_index(string alphabet, string character)
    for int i < int(len(alphabet))
        if alphabet[i] == character
            return i
    return -1

string uppercase(string text)
    string result = ""
    for int i < int(len(text))
        int at = character_index(lowercase_letters, text[i])
        result += if at >= 0 then letters[at] else text[i]
    return result

string lower_letter(string character)
    return lowercase_letters[character_index(letters, character)]

bool inside(int row, int column)
    return 0 <= row and row < 15 and 0 <= column and column < 15

class Move(int row, int column, int direction, string word)
class Tile(int row, int column, string letter)

string square_name(int row, int column)
    return columns[column] + (row + 1).string()

string position(Move move)
    return if move.direction == 0 then (move.row + 1).string() + columns[move.column] else square_name(move.row, move.column)

int[] parse_position(string text)
    for int row < 15
        for int column < 15
            for int direction < 2
                if position(Move(row, column, direction, "")) == text
                    return [row, column, direction]
    return []

string[][] premiums()
    string[] rows = ["#..+...#...+..#", ".*...^...^...*.", "..*...+.+...*..", "+..*...+...*..+", "....*.....*....", ".^...^...^...^.", "..+...+.+...+..", "#..+...*...+..#", "..+...+.+...+..", ".^...^...^...^.", "....*.....*....", "+..*...+...*..+", "..*...+.+...*..", ".*...^...^...*.", "#..+...#...+..#"]
    return [for string row = rows[] then [for int c < 15 then row[c]]]

string[][] empty_board()
    return [for int row < 15 then [for int column < 15 then "."]]

string[][] transpose(string[][] grid)
    return [for int row < 15 then [for int column < 15 then grid[column][row]]]

Tile[] transpose_tiles(Tile[] placed)
    return [for Tile tile = placed[] then Tile(tile.column, tile.row, tile.letter)]

Tile[] tiles(string[][] grid)
    return [for int row < 15 for int column < 15 if grid[row][column] != "." then Tile(row, column, grid[row][column])]

int[][] neighbours(int row, int column)
    int[][] candidates = [[row - 1, column], [row + 1, column], [row, column - 1], [row, column + 1]]
    return [for int[] point = candidates[] if inside(point[0], point[1]) then point]

Move run_at(string[][] grid, int row, int column, int direction)
    int dr = direction
    int dc = 1 - direction
    while inside(row - dr, column - dc) and grid[row - dr][column - dc] != "."
        row -= dr
        column -= dc
    int first_row = row
    int first_column = column
    string word = ""
    while inside(row, column) and grid[row][column] != "."
        word += grid[row][column]
        row += dr
        column += dc
    return Move(first_row, first_column, direction, word)

Move[] words(string[][] grid)
    Move[] result = []
    for int direction < 2
        for int line < 15
            int offset = 0
            while offset < 15
                int row = if direction == 0 then line else offset
                int column = if direction == 0 then offset else line
                if grid[row][column] == "."
                    offset += 1
                    continue
                Move word = run_at(grid, row, column, direction)
                if len(word.word) >= 2
                    result = result.append(word)
                offset += int(len(word.word))
    return result

bool connected(string[][] grid)
    Tile[] occupied = tiles(grid)
    if len(occupied) == 0
        return true
    bool[][] visited = [for int row < 15 then [for int column < 15 then false]]
    int[][] queue = [[occupied[0].row, occupied[0].column]]
    visited[occupied[0].row][occupied[0].column] = true
    int cursor = 0
    while cursor < int(len(queue))
        int[] point = queue[cursor]
        cursor += 1
        for int[] next = neighbours(point[0], point[1])[]
            if grid[next[0]][next[1]] != "." and not visited[next[0]][next[1]]
                visited[next[0]][next[1]] = true
                queue = queue.append(next)
    return len(queue) == len(occupied)

string[] display(string[][] grid)
    string[][] layout = premiums()
    string[] lines = ["   " + [for int i < 15 then columns[i]].join(" ")]
    for int row < 15
        string padding = if row < 9 then " " else ""
        lines = lines.append(padding + (row + 1).string() + " " + [for int column < 15 then (if grid[row][column] == "." then layout[row][column] else grid[row][column])].join(" "))
    return lines
