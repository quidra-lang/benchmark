import board = "./board.qui"

const int rack_size = 7
const int bingo_bonus = 50

board.Tile[] squares(board.Move move)
    return [for int i < int(len(move.word)) then board.Tile(move.row + move.direction * i, move.column + (1 - move.direction) * i, move.word[i])]

board.Tile[] placement(string[][] grid, board.Move move)
    return [for board.Tile tile = squares(move)[] if grid[tile.row][tile.column] == "." then tile]

string[][] apply(string[][] grid, board.Tile[] placed)
    string[][] result = grid
    for board.Tile tile = placed[]
        result[tile.row][tile.column] = tile.letter
    return result

board.Move[] cross_words(string[][] grid, board.Move move)
    board.Tile[] placed = placement(grid, move)
    string[][] after = apply(grid, placed)
    board.Move[] result = []
    for board.Tile tile = placed[]
        board.Move word = board.run_at(after, tile.row, tile.column, 1 - move.direction)
        if len(word.word) >= 2
            result = result.append(word)
    return result

int word_score(string[][] grid, board.Move word, int[] values)
    int score = 0
    int multiplier = 1
    string[][] layout = board.premiums()
    for board.Tile tile = squares(word)[]
        int letter = board.character_index(board.letters, tile.letter)
        int value = if letter < 0 then 0 else values[letter]
        if grid[tile.row][tile.column] == "."
            string premium = layout[tile.row][tile.column]
            value *= if premium == "+" then 2 else (if premium == "^" then 3 else 1)
            multiplier *= if premium == "*" then 2 else (if premium == "#" then 3 else 1)
        score += value
    return score * multiplier

class Scored(int score, board.Tile[] placed, board.Move[] words, int[] word_scores)

Scored score_move(string[][] grid, board.Move move, int[] values)
    board.Move[] words = [move].concat(cross_words(grid, move))
    int[] word_scores = [for board.Move word = words[] then word_score(grid, word, values)]
    int score = 0
    for int value = word_scores[]
        score += value
    board.Tile[] placed = placement(grid, move)
    if len(placed) == rack_size
        score += bingo_bonus
    return Scored(score, placed, words, word_scores)
