import board = "./board.qui"

const string tile_order = "ABCDEFGHIJKLMNOPQRSTUVWXYZ?"

int tile_index(string tile)
    return if tile == "?" then 26 else board.character_index(board.letters, tile)

int points(string collection, int[] values)
    int result = 0
    for int i < int(len(collection))
        result += values[tile_index(collection[i])]
    return result

class Bag(int state, int[] counts)
    string[] tiles = []
    for int i < 27
        for int j < counts[i]
            tiles = tiles.append(tile_order[i])

    int .next_random()
        state = (48271 * state) % 2147483647
        return state

    void .shuffle()
        int i = int(len(tiles)) - 1
        while i >= 1
            int j = .next_random() % (i + 1)
            string temporary = tiles[i]
            tiles[i] = tiles[j]
            tiles[j] = temporary
            i -= 1

    string .draw(int amount)
        string drawn = ""
        for int i < amount
            if len(tiles) == 0
                break
            int last = int(len(tiles)) - 1
            drawn += tiles[last]
            tiles = tiles[0:<last]
        return drawn

    string .exchange(string returned)
        string drawn = .draw(int(len(returned)))
        string[] sorted = [for int i < int(len(returned)) then returned[i]].sorted()
        tiles = tiles.concat(sorted)
        .shuffle()
        return drawn
