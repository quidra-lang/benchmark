import board = "./board.qui"
import dictionary_trie = "./dictionary_trie.qui"
import scoring = "./scoring.qui"

bool[][] anchors(string[][] grid)
    bool[][] result = [for int row < 15 then [for int column < 15 then false]]
    if len(board.tiles(grid)) == 0
        result[7][7] = true
        return result
    for int row < 15
        for int column < 15
            if grid[row][column] == "."
                for int[] point = board.neighbours(row, column)[]
                    if grid[point[0]][point[1]] != "."
                        result[row][column] = true
    return result

class Checks(bool[][] needed, bool[][][] allowed)

Checks cross_checks(string[][] grid, dictionary_trie.Trie trie)
    bool[][] needed = [for int row < 15 then [for int column < 15 then false]]
    bool[][][] allowed = [for int row < 15 then [for int column < 15 then [for int letter < 26 then true]]]
    for int row < 15
        for int column < 15
            if grid[row][column] != "."
                continue
            int first = row
            int last = row
            while first > 0 and grid[first - 1][column] != "."
                first -= 1
            while last + 1 < 15 and grid[last + 1][column] != "."
                last += 1
            if first == last
                continue
            needed[row][column] = true
            string prefix = [for first <= int r < row then grid[r][column]].join("")
            string suffix = [for row + 1 <= int r <= last then grid[r][column]].join("")
            for int letter < 26
                allowed[row][column][letter] = trie.has(board.uppercase(prefix) + board.letters[letter] + board.uppercase(suffix))
    return Checks(needed, allowed)

class Search(string[][] grid, string rack, dictionary_trie.Trie trie, bool[][] anchor_squares, Checks checks)
    int[] counts = [for int i < 27 then 0]
    for int i < int(len(rack))
        int tile = if rack[i] == "?" then 26 else board.character_index(board.letters, rack[i])
        counts[tile] += 1
    board.Move[] result = []

    void .extend_right(int row, int anchor, int node, int column, string word, int start, int[] remaining)
        bool empty = column == 15 or grid[row][column] == "."
        if empty and column > anchor and trie.terminal[node]
            result = result.append(board.Move(row, start, 0, word))
        if column == 15
            return
        if not empty
            string character = grid[row][column]
            int letter = board.character_index(board.letters, board.uppercase(character))
            int child = trie.children[node][letter]
            if child >= 0
                .extend_right(row, anchor, child, column + 1, word + character, start, remaining)
            return
        for int letter < 26
            int child = trie.children[node][letter]
            if child < 0 or not checks.allowed[row][column][letter]
                continue
            for int alternative < 2
                int tile = if alternative == 0 then letter else 26
                if remaining[tile] > 0
                    int[] next = remaining
                    next[tile] -= 1
                    string character = if alternative == 0 then board.letters[letter] else board.lowercase_letters[letter]
                    .extend_right(row, anchor, child, column + 1, word + character, start, next)

    void .left_part(int row, int anchor, int node, string prefix, int limit, int[] remaining)
        .extend_right(row, anchor, node, anchor, prefix, anchor - int(len(prefix)), remaining)
        if limit == 0
            return
        for int letter < 26
            int child = trie.children[node][letter]
            if child < 0
                continue
            for int alternative < 2
                int tile = if alternative == 0 then letter else 26
                if remaining[tile] > 0
                    int[] next = remaining
                    next[tile] -= 1
                    string character = if alternative == 0 then board.letters[letter] else board.lowercase_letters[letter]
                    .left_part(row, anchor, child, prefix + character, limit - 1, next)

    void .across_moves()
        for int row < 15
            for int anchor < 15
                if not anchor_squares[row][anchor]
                    continue
                if anchor > 0 and grid[row][anchor - 1] != "."
                    int first = anchor - 1
                    while first > 0 and grid[row][first - 1] != "."
                        first -= 1
                    string prefix = grid[row][first:<anchor].join("")
                    int node = trie.prefix(board.uppercase(prefix))
                    if node >= 0
                        .extend_right(row, anchor, node, anchor, prefix, first, counts)
                else
                    int first = anchor - 1
                    while first >= 0 and grid[row][first] == "." and not anchor_squares[row][first]
                        first -= 1
                    .left_part(row, anchor, 0, "", anchor - first - 1, counts)

board.Move[] generate(string[][] grid, string rack, dictionary_trie.Trie trie)
    bool[][] anchor_squares = anchors(grid)
    Search across = Search(grid, rack, trie, anchor_squares, cross_checks(grid, trie))
    .across.across_moves()
    string[][] transposed = board.transpose(grid)
    bool[][] swapped = [for int row < 15 then [for int column < 15 then anchor_squares[column][row]]]
    Search down = Search(transposed, rack, trie, swapped, cross_checks(transposed, trie))
    .down.across_moves()
    board.Move[] result = across.result
    for board.Move candidate = down.result[]
        board.Move move = board.Move(candidate.column, candidate.row, 1, candidate.word)
        board.Tile[] placed = scoring.placement(grid, move)
        if len(placed) == 1
            string[][] after = scoring.apply(grid, placed)
            if len(board.run_at(after, placed[0].row, placed[0].column, 0).word) >= 2
                continue
        result = result.append(move)
    return result
