import board = "./board.qui"

class Trie()
    int[][] children = [[for int i < 26 then -1]]
    bool[] terminal = [false]
    int word_count = 0

    bool .add(string word)
        int node = 0
        for int i < int(len(word))
            int letter = board.character_index(board.letters, word[i])
            if children[node][letter] < 0
                int created = int(len(children))
                children[node][letter] = created
                children = children.append([for int j < 26 then -1])
                terminal = terminal.append(false)
            node = children[node][letter]
        if terminal[node]
            return false
        terminal[node] = true
        word_count += 1
        return true

    int prefix(string word)
        int node = 0
        for int i < int(len(word))
            int letter = board.character_index(board.letters, word[i])
            if letter < 0 or children[node][letter] < 0
                return -1
            node = children[node][letter]
        return node

    bool has(string word)
        int node = prefix(word)
        return node >= 0 and terminal[node]

    string[] anagram_visit(int node, string word, int[] counts)
        string[] result = if terminal[node] then [word] else []
        for int letter < 26
            int child = children[node][letter]
            if child < 0
                continue
            int tile = if counts[letter] > 0 then letter else 26
            if counts[tile] > 0
                int[] remaining = counts
                remaining[tile] -= 1
                result = result.concat(anagram_visit(child, word + board.letters[letter], remaining))
        return result

    string[] anagrams(string rack)
        int[] counts = [for int i < 27 then 0]
        for int i < int(len(rack))
            int tile = if rack[i] == "?" then 26 else board.character_index(board.letters, rack[i])
            counts[tile] += 1
        return anagram_visit(0, "", counts)
