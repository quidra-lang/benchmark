import board = "./board.qui"
import dictionary_trie = "./dictionary_trie.qui"
import move_generator = "./move_generator.qui"
import scoring = "./scoring.qui"
import game = "./game.qui"

int integer(string text)
    int result = int.parse(text)
    return result

bool valid_name(string text)
    if len(text) < 1 or len(text) > 20
        return false
    for int i < int(len(text))
        if board.character_index("abcdefghijklmnopqrstuvwxyz0123456789_", text[i]) < 0
            return false
    return true

bool valid_number(string text, int minimum, int maximum)
    if len(text) == 0 or (len(text) > 1 and text[0] == "0")
        return false
    for int i < int(len(text))
        if board.character_index("0123456789", text[i]) < 0
            return false
    int value = integer(text)
    return minimum <= value and value <= maximum

bool valid_rack(string rack)
    if len(rack) < 1 or len(rack) > 7
        return false
    for int i < int(len(rack))
        if board.character_index(game.tile_order, rack[i]) < 0
            return false
    return true

bool valid_strategy(string strategy)
    return strategy == "score" or strategy == "tiles" or strategy == "equity"

bool valid_word(string word, bool uppercase_only)
    if len(word) < 2 or len(word) > 15
        return false
    string alphabet = if uppercase_only then board.letters else board.letters + board.lowercase_letters
    for int i < int(len(word))
        if board.character_index(alphabet, word[i]) < 0
            return false
    return true

bool lex_less(string first, string second)
    return first != second and [first, second].sorted()[0] == first

string sorted_tiles(string text)
    return [for int i < int(len(text)) then text[i]].sorted().join("")

string collection(string text)
    return if len(text) == 0 then "-" else sorted_tiles(text)

int[] tile_counts(string text)
    int[] result = [for int i < 27 then 0]
    for int i < int(len(text))
        result[game.tile_index(text[i])] += 1
    return result

string kind_of(string character)
    return if board.character_index(board.letters, character) >= 0 then character else "?"

string remove_tiles(string rack, string removed)
    int[] counts = tile_counts(rack)
    for int i < int(len(removed))
        counts[game.tile_index(removed[i])] -= 1
    string result = ""
    for int i < 27
        result += string.repeat(game.tile_order[i], nat(counts[i]))
    return sorted_tiles(result)

int string_index(string[] values, string wanted)
    for int i < int(len(values))
        if values[i] == wanted
            return i
    return -1

string placement_key(board.Tile[] placed)
    string result = ""
    for int row < 15
        for int column < 15
            for board.Tile tile = placed[]
                if tile.row == row and tile.column == column
                    result += "{row},{column}:" + tile.letter + ";"
    return result

class Evaluated(board.Move move, int score, board.Tile[] placed, string words, string leave, int value)

string notation(Evaluated evaluated)
    return board.position(evaluated.move) + " " + evaluated.move.word

bool before(Evaluated first, Evaluated second, string strategy)
    int primary_first = if strategy == "tiles" then int(len(first.placed)) else (if strategy == "equity" then first.score + first.value else 0)
    int primary_second = if strategy == "tiles" then int(len(second.placed)) else (if strategy == "equity" then second.score + second.value else 0)
    if primary_first != primary_second
        return primary_first > primary_second
    if first.score != second.score
        return first.score > second.score
    if first.move.row != second.move.row
        return first.move.row < second.move.row
    if first.move.column != second.move.column
        return first.move.column < second.move.column
    if first.move.direction != second.move.direction
        return first.move.direction < second.move.direction
    return lex_less(first.move.word, second.move.word)

Evaluated[] sorted_moves(Evaluated[] moves, string strategy)
    if len(moves) < 2
        return moves
    int middle = int(len(moves)) / 2
    Evaluated[] left = sorted_moves(moves[0:<middle], strategy)
    Evaluated[] right = sorted_moves(moves[middle:<int(len(moves))], strategy)
    Evaluated[] result = []
    int a = 0
    int b = 0
    while a < int(len(left)) and b < int(len(right))
        if before(right[b], left[a], strategy)
            result = result.append(right[b])
            b += 1
        else
            result = result.append(left[a])
            a += 1
    return result.concat(left[a:<int(len(left))]).concat(right[b:<int(len(right))])

int strategy_choice(Evaluated[] moves, string strategy)
    int result = 0
    for 1 <= int i < int(len(moves))
        if before(moves[i], moves[result], strategy)
            result = i
    return result

class Inputs()
    int[] values = []
    int[] counts = []
    int[] weights = []
    for string line = file.read("input/tiles.txt").split(NL)[]
        if line == "" or line[0] == "#"
            continue
        string[] fields = line.split(" ")
        values = values.append(integer(fields[1]))
        counts = counts.append(integer(fields[2]))
        weights = weights.append(integer(fields[3]))
    dictionary_trie.Trie trie = dictionary_trie.Trie()
    int candidate_lines = 0
    int skipped = 0
    int duplicates = 0
    int[] lengths = [for int i < 16 then 0]
    for string line = file.read("input/dictionary.txt").split(NL)[]
        if line == "" or line[0] == "#"
            continue
        candidate_lines += 1
        if not valid_word(line, true)
            skipped += 1
        else
            bool added = .trie.add(line)
            if added
                lengths[int(len(line))] += 1
            else
                duplicates += 1
    string[][] jobs = []
    string[] current = []
    for string line = file.read("input/jobs.txt").split(NL)[]
        if len(current) == 0
            if line != "" and line[0] != "#"
                current = [line]
        elif line == "END"
            jobs = jobs.append(current)
            current = []
        else
            current = current.append(line)
    string[] length_parts = [for 2 <= int k <= 15 if lengths[k] > 0 then "{k}={lengths[k]}"]
    string[] dictionary_lines = ["DICTIONARY lines={candidate_lines} words={trie.word_count} skipped={skipped} duplicates={duplicates} nodes={len(trie.children)}", "lengths " + length_parts.join(" ")]

class Checked(string reason, board.Move move, bool placing)

class Scrabble(Inputs input_data)
    int[] values = input_data.values
    int[] counts = input_data.counts
    int[] weights = input_data.weights
    dictionary_trie.Trie trie = input_data.trie
    int[] top_totals = [0, 0, 0, 0]
    int[] validation_totals = [0, 0, 0, 0, 0, 0]
    int[] game_totals = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    string[][] move_blocks = [input_data.dictionary_lines]
    string[][] validation_blocks = []
    string[][] game_blocks = []

    int[] used_tiles(string[][] grid, string rack)
        int[] used = tile_counts(rack)
        for board.Tile tile = board.tiles(grid)[]
            used[game.tile_index(kind_of(tile.letter))] += 1
        return used

    string tile_error(string[][] grid, string rack)
        int[] used = used_tiles(grid, rack)
        for int i < 27
            if used[i] > counts[i]
                return "too many " + game.tile_order[i]
        return ""

    string unseen(string[][] grid, string rack)
        int[] used = used_tiles(grid, rack)
        return [for int i < 27 then string.repeat(game.tile_order[i], nat(counts[i] - used[i]))].join("")

    string[][] grid_from(string[] rows)
        return [for string row = rows[] then [for int c < int(len(row)) then row[c]]]

    string board_error(string[] rows, string rack)
        if len(rows) != 15
            return "board rows {len(rows)}"
        for int i < 15
            if len(rows[i]) != 15
                return "bad board row {i + 1}"
            for int j < 15
                if board.character_index("." + board.letters + board.lowercase_letters, rows[i][j]) < 0
                    return "bad board row {i + 1}"
        string[][] grid = grid_from(rows)
        string reason = tile_error(grid, rack)
        if reason != ""
            return reason
        if len(board.tiles(grid)) != 0 and grid[7][7] == "."
            return "center empty"
        if not board.connected(grid)
            return "disconnected"
        for board.Move word = board.words(grid)[]
            if not trie.has(board.uppercase(word.word))
                return "unknown word " + word.word + " at " + board.position(word)
        return ""

    string job_error(string[] job, string[] seen)
        string[] fields = job[0].split(" ")
        string kind = fields[0]
        string name = fields[1]
        if not valid_name(name)
            return "bad name"
        if string_index(seen, name) >= 0
            return "duplicate name"
        if kind == "TOPN"
            if not valid_number(fields[2], 1, 99)
                return "bad count"
            if not valid_strategy(fields[3])
                return "bad order"
            string rack = job[1].split(" ")[1]
            if not valid_rack(rack)
                return "bad rack"
            return board_error(job[3:<int(len(job))], rack)
        if kind == "VALIDATE"
            string[] rows = []
            for string line = job[2:<int(len(job))][]
                if line.starts_with("MOVE")
                    break
                rows = rows.append(line)
            return board_error(rows, "")
        if not valid_number(fields[2], 1, 2147483646)
            return "bad seed"
        int player_count = int(len(job)) - 1
        if player_count < 2 or player_count > 4
            return "bad player count {player_count}"
        string[] names = []
        for 1 <= int i < int(len(job))
            string[] player = job[i].split(" ")
            if not valid_name(player[1]) or not valid_strategy(player[2])
                return "bad player {i}"
            if kind == "GAME" and not valid_number(player[3], 0, 99)
                return "bad player {i}"
            if string_index(names, player[1]) >= 0
                return "duplicate player {i}"
            names = names.append(player[1])
        return ""

    int leave_value(string rack)
        int[] quantities = tile_counts(rack)
        int duplicates = 0
        int vowels = 0
        int consonants = 0
        int result = 0
        for int i < 27
            result += quantities[i] * weights[i]
            if i < 26
                if quantities[i] > 1
                    duplicates += quantities[i] - 1
                if board.character_index("AEIOU", game.tile_order[i]) >= 0
                    vowels += quantities[i]
                else
                    consonants += quantities[i]
        int imbalance = vowels - consonants
        if imbalance < 0
            imbalance = -imbalance
        int penalty = if imbalance > 1 then imbalance - 1 else 0
        return result - 4 * duplicates - 3 * penalty

    string best_leave(string rack)
        string best = ""
        int best_value = 0
        set.Set<string> seen = set.Set<string>()
        for int mask < 2 ^ int(len(rack))
            string candidate = ""
            for int i < int(len(rack))
                if (mask / (2 ^ i)) % 2 == 1
                    candidate += rack[i]
            if len(candidate) == len(rack)
                continue
            candidate = sorted_tiles(candidate)
            if seen.has(candidate)
                continue
            .seen.add(candidate)
            int value = leave_value(candidate)
            if value > best_value or (value == best_value and (len(candidate) > len(best) or (len(candidate) == len(best) and lex_less(candidate, best))))
                best = candidate
                best_value = value
        return best

    Evaluated evaluate(string[][] grid, string rack, board.Move move)
        scoring.Scored scored = scoring.score_move(grid, move, values)
        string removed = [for board.Tile tile = scored.placed[] then kind_of(tile.letter)].join("")
        string leave = remove_tiles(rack, removed)
        string words = [for int i < int(len(scored.words)) then scored.words[i].word + ":" + scored.word_scores[i].string()].join(",")
        return Evaluated(move, scored.score, scored.placed, words, leave, leave_value(leave))

    Evaluated[] legal_moves(string[][] grid, string rack)
        Evaluated[] result = [for board.Move move = move_generator.generate(grid, rack, trie)[] then evaluate(grid, rack, move)]
        return sorted_moves(result, "score")

    string position_summary(string[][] grid)
        board.Move[] words = board.words(grid)
        board.Tile[] occupied = board.tiles(grid)
        string longest = "-"
        int longest_length = 0
        for board.Move word = words[]
            if int(len(word.word)) > longest_length
                longest_length = int(len(word.word))
                longest = word.word
        int blanks = 0
        int[] premium_counts = [0, 0, 0, 0]
        string symbols = "#*^+"
        string[][] layout = board.premiums()
        for board.Tile tile = occupied[]
            if kind_of(tile.letter) == "?"
                blanks += 1
            int at = board.character_index(symbols, layout[tile.row][tile.column])
            if at >= 0
                premium_counts[at] += 1
        return "position tiles={len(occupied)} words={len(words)} longest={longest} blanks={blanks} premiums=TW:{premium_counts[0]},DW:{premium_counts[1]},TL:{premium_counts[2]},DL:{premium_counts[3]}"

    string check_statistics(move_generator.Checks checks)
        int squares = 0
        int dead = 0
        int letters = 0
        for int row < 15
            for int column < 15
                if checks.needed[row][column]
                    squares += 1
                    int count = int(len([for bool allowed = checks.allowed[row][column][] if allowed then allowed]))
                    letters += count
                    if count == 0
                        dead += 1
        return "{squares},{dead},{letters}"

    string[] ordered_anagrams(string rack)
        string[] found = trie.anagrams(rack).sorted()
        string[] result = []
        int length = 15
        while length >= 2
            for string word = found[]
                if int(len(word)) == length
                    result = result.append(word)
            length -= 1
        return result

    string[] .topn(string[] job)
        string[] fields = job[0].split(" ")
        string name = fields[1]
        int requested = integer(fields[2])
        string strategy = fields[3]
        string rack = job[1].split(" ")[1]
        string[][] grid = grid_from(job[3:<int(len(job))])
        Evaluated[] moves = legal_moves(grid, rack)
        Evaluated[] ordered = sorted_moves(moves, strategy)
        int shown_count = if requested < int(len(ordered)) then requested else int(len(ordered))
        Evaluated[] shown = ordered[0:<shown_count]
        string remaining = unseen(grid, rack)
        bool[][] anchor_squares = move_generator.anchors(grid)
        int anchor_count = 0
        for bool[] row = anchor_squares[]
            anchor_count += int(len([for bool item = row[] if item then item]))
        int vowels = 0
        int consonants = 0
        int blanks = 0
        for int i < int(len(rack))
            if rack[i] == "?"
                blanks += 1
            elif board.character_index("AEIOU", rack[i]) >= 0
                vowels += 1
            else
                consonants += 1
        int across = int(len([for Evaluated move = moves[] if move.move.direction == 0 then move]))
        int bingos = int(len([for Evaluated move = moves[] if len(move.placed) == 7 then move]))
        int blank_moves = 0
        for Evaluated move = moves[]
            if len([for board.Tile tile = move.placed[] if kind_of(tile.letter) == "?" then tile]) != 0
                blank_moves += 1
        string[] lines = ["TOPN {name} n={requested} order={strategy} rack=" + collection(rack), "board tiles={len(board.tiles(grid))} anchors={anchor_count}", "unseen count={len(remaining)} tiles=" + collection(remaining), "rack vowels={vowels} consonants={consonants} blanks={blanks} value={game.points(rack, values)}", "checks across=" + check_statistics(move_generator.cross_checks(grid, trie)) + " down=" + check_statistics(move_generator.cross_checks(board.transpose(grid), trie)), "moves total={len(moves)} across={across} down={int(len(moves)) - across} bingos={bingos} blanks={blank_moves}"]
        string best_by_tiles = "best_by_tiles"
        for 1 <= int count <= 7
            int best = -1
            for Evaluated move = moves[]
                if int(len(move.placed)) == count and move.score > best
                    best = move.score
            best_by_tiles += " {count}=" + (if best < 0 then "-" else best.string())
        lines = lines.append(best_by_tiles)
        string keep = best_leave(rack)
        lines = lines.append("exchange keep=" + collection(keep) + " value={leave_value(keep)}")
        string[] anagrams = ordered_anagrams(rack)
        int anagram_count = if len(anagrams) < 10 then int(len(anagrams)) else 10
        lines = lines.append("anagrams total={len(anagrams)} top=" + (if anagram_count == 0 then "-" else anagrams[0:<anagram_count].join(",")))
        for board.Move word = board.words(grid)[]
            if len(word.word) < 3
                continue
            string front = ""
            string back = ""
            for int i < 26
                string letter = board.letters[i]
                if trie.has(letter + board.uppercase(word.word))
                    front += letter
                if trie.has(board.uppercase(word.word) + letter)
                    back += letter
            if front != "" or back != ""
                lines = lines.append("hook " + board.position(word) + " " + word.word + " front=" + (if front == "" then "-" else front) + " back=" + (if back == "" then "-" else back))
        bool endgame = 1 <= len(remaining) and len(remaining) <= 7 and shown_count > 0
        int[] nets = []
        if endgame
            for Evaluated move = shown[]
                Evaluated[] replies = legal_moves(scoring.apply(grid, move.placed), remaining)
                nets = nets.append(move.score - (if len(replies) == 0 then 0 else replies[0].score))
            int best = 0
            for 1 <= int i < shown_count
                if nets[i] > nets[best]
                    best = i
            lines = lines.append("endgame opponent=" + collection(remaining) + " best={best + 1} net={nets[best]}")
        for int i < shown_count
            Evaluated move = shown[i]
            string net = if endgame then " net={nets[i]}" else ""
            lines = lines.append("{i + 1} " + notation(move) + " score={move.score} tiles={len(move.placed)} leave=" + collection(move.leave) + " value={move.value}" + net + " words={move.words}")
        top_totals[2] += int(len(moves))
        top_totals[3] += bingos
        return lines

    Checked record_error(string[][] grid, string player, string rack, string[] action)
        board.Move absent = board.Move(0, 0, 0, "")
        if not valid_name(player)
            return Checked("bad player", absent, false)
        if not valid_rack(rack)
            return Checked("bad rack", absent, false)
        string reason = tile_error(grid, rack)
        if reason != ""
            return Checked(reason, absent, false)
        if len(action) == 1 and action[0] == "PASS"
            return Checked("", absent, false)
        if action[0] == "EXCHANGE"
            if not valid_rack(action[1])
                return Checked("bad exchange", absent, false)
            int[] available = tile_counts(rack)
            int[] requested = tile_counts(action[1])
            for int i < int(len(action[1]))
                int tile = game.tile_index(action[1][i])
                if requested[tile] > available[tile]
                    return Checked("rack lacks " + action[1][i], absent, false)
            return Checked("", absent, false)
        int[] parsed = board.parse_position(action[0])
        if len(parsed) == 0
            return Checked("bad position", absent, false)
        if not valid_word(action[1], false)
            return Checked("bad word", absent, false)
        board.Move move = board.Move(parsed[0], parsed[1], parsed[2], action[1])
        board.Tile[] cells = scoring.squares(move)
        for board.Tile tile = cells[]
            if not board.inside(tile.row, tile.column)
                return Checked("off board", absent, false)
        for board.Tile tile = cells[]
            if grid[tile.row][tile.column] != "." and grid[tile.row][tile.column] != tile.letter
                return Checked("mismatch at " + board.square_name(tile.row, tile.column), absent, false)
        int dr = move.direction
        int dc = 1 - move.direction
        int[][] ends = [[move.row - dr, move.column - dc], [move.row + dr * int(len(move.word)), move.column + dc * int(len(move.word))]]
        for int[] point = ends[]
            if board.inside(point[0], point[1]) and grid[point[0]][point[1]] != "."
                return Checked("not whole word", absent, false)
        board.Tile[] placed = scoring.placement(grid, move)
        if len(placed) == 0
            return Checked("no new tiles", absent, false)
        int[] available = tile_counts(rack)
        for board.Tile tile = placed[]
            string kind = kind_of(tile.letter)
            int index = game.tile_index(kind)
            if available[index] == 0
                return Checked("rack lacks " + kind, absent, false)
            available[index] -= 1
        if len(board.tiles(grid)) == 0
            if len([for board.Tile tile = placed[] if tile.row == 7 and tile.column == 7 then tile]) == 0
                return Checked("center not covered", absent, false)
        else
            bool connected = false
            for board.Tile tile = placed[]
                for int[] point = board.neighbours(tile.row, tile.column)[]
                    connected = connected or grid[point[0]][point[1]] != "."
            if not connected
                return Checked("not connected", absent, false)
        for board.Move word = [move].concat(scoring.cross_words(grid, move))[]
            if not trie.has(board.uppercase(word.word))
                return Checked("unknown word " + word.word + " at " + board.position(word), absent, false)
        return Checked("", move, true)

    string[] .validate(string[] job)
        string name = job[0].split(" ")[1]
        string[][] grid = grid_from(job[2:<17])
        string[] records = job[17:<int(len(job))]
        string[] lines = ["VALIDATE {name}"]
        string[] players = []
        int[][] statistics = []
        int[] totals = [0, 0, 0, 0, 0]
        for int i < int(len(records))
            string[] fields = records[i].split(" ")
            string player = fields[1]
            string rack = fields[2]
            string[] action = fields[3:<int(len(fields))]
            string prefix = "move {i + 1} {player} " + action.join(" ")
            Checked checked = record_error(grid, player, rack, action)
            int p = string_index(players, player)
            if checked.reason != "bad player"
                if p < 0
                    p = int(len(players))
                    players = players.append(player)
                    statistics = statistics.append([0, 0, 0, 0])
                statistics[p][0] += 1
            if checked.reason != ""
                lines = lines.append(prefix + " invalid " + checked.reason)
                totals[1] += 1
                continue
            Evaluated[] legal = legal_moves(grid, rack)
            int best = if len(legal) == 0 then 0 else legal[0].score
            int score = 0
            Evaluated evaluated = Evaluated(board.Move(0, 0, 0, ""), 0, [], "", "", 0)
            int rank = 0
            if checked.placing
                evaluated = evaluate(grid, rack, checked.move)
                score = evaluated.score
                string key = placement_key(evaluated.placed)
                for int j < int(len(legal))
                    if placement_key(legal[j].placed) == key
                        rank = j + 1
                        break
            statistics[p][1] += 1
            statistics[p][2] += score
            statistics[p][3] += best - score
            totals[0] += 1
            totals[2] += score
            totals[3] += best
            totals[4] += best - score
            if checked.placing
                lines = lines.append(prefix + " score={score} total={statistics[p][2]} tiles={len(evaluated.placed)} rank={rank}/{len(legal)} best={best} words={evaluated.words}")
                grid = scoring.apply(grid, evaluated.placed)
            else
                lines = lines.append(prefix + " score=0 total={statistics[p][2]} moves={len(legal)} best={best}")
        for int p < int(len(players))
            int[] stats = statistics[p]
            lines = lines.append("player {players[p]} moves={stats[0]} valid={stats[1]} score={stats[2]} loss={stats[3]}")
        lines = lines.append("total valid={totals[0]} invalid={totals[1]} score={totals[2]} best={totals[3]} loss={totals[4]}")
        validation_totals[2] += int(len(records))
        validation_totals[3] += totals[0]
        validation_totals[4] += totals[1]
        validation_totals[5] += totals[4]
        return lines.append(position_summary(grid)).concat(board.display(grid))

    string[] .ordinary_game(string[] job)
        string[] header = job[0].split(" ")
        string name = header[1]
        int seed = integer(header[2])
        game.Bag bag = game.Bag(seed, counts)
        .bag.shuffle()
        string[][] grid = board.empty_board()
        int player_count = int(len(job)) - 1
        string[] names = []
        string[] strategies = []
        int[] thresholds = []
        string[] racks = []
        int[] scores = [for int p < player_count then 0]
        int[][] statistics = [for int p < player_count then [0, 0, 0, 0, 0, 0]]
        string[] lines = ["GAME {name} seed={seed} players={player_count}"]
        for 1 <= int i < int(len(job))
            string[] fields = job[i].split(" ")
            names = names.append(fields[1])
            strategies = strategies.append(fields[2])
            thresholds = thresholds.append(integer(fields[3]))
            string drawn = .bag.draw(7)
            racks = racks.append(drawn)
            lines = lines.append("player {i} {fields[1]} strategy={fields[2]} threshold={integer(fields[3])}")
        int turn = 0
        int consecutive = 0
        int outgoing = -1
        int highlight_score = -1
        string highlight = ""
        while true
            int p = turn % player_count
            turn += 1
            string rack = racks[p]
            Evaluated[] legal = legal_moves(grid, rack)
            int chosen = if len(legal) == 0 then -1 else strategy_choice(legal, strategies[p])
            string prefix = "turn {turn} {names[p]} rack=" + collection(rack) + " moves={len(legal)}"
            if chosen >= 0 and not (legal[chosen].score < thresholds[p] and len(bag.tiles) >= 7)
                Evaluated candidate = legal[chosen]
                int best = legal[0].score
                grid = scoring.apply(grid, candidate.placed)
                scores[p] += candidate.score
                string drawn = .bag.draw(7 - int(len(candidate.leave)))
                racks[p] = candidate.leave + drawn
                statistics[p][0] += 1
                if len(candidate.placed) == 7
                    statistics[p][1] += 1
                if candidate.score > statistics[p][4]
                    statistics[p][4] = candidate.score
                statistics[p][5] += best - candidate.score
                consecutive = 0
                if candidate.score > highlight_score
                    highlight_score = candidate.score
                    highlight = "highlight turn={turn} player={names[p]} play " + notation(candidate) + " score={candidate.score}"
                lines = lines.append(prefix + " best={best} play " + notation(candidate) + " score={candidate.score} total={scores[p]} draw=" + collection(drawn) + " bag={len(bag.tiles)}")
                if racks[p] == "" and len(bag.tiles) == 0
                    outgoing = p
                    break
            elif len(bag.tiles) >= 7
                string keep = best_leave(rack)
                string returned = remove_tiles(rack, keep)
                string drawn = .bag.exchange(returned)
                racks[p] = keep + drawn
                statistics[p][2] += 1
                consecutive += 1
                lines = lines.append(prefix + " exchange keep=" + collection(keep) + " draw=" + collection(drawn) + " bag={len(bag.tiles)}")
            else
                statistics[p][3] += 1
                consecutive += 1
                lines = lines.append(prefix + " pass bag={len(bag.tiles)}")
            if consecutive == 6
                break
        if outgoing < 0
            lines = lines.append("end reason=scoreless turns={turn}")
        else
            lines = lines.append("end reason=out player={names[outgoing]} turns={turn}")
        int[] adjustments = [for string rack = racks[] then -game.points(rack, values)]
        if outgoing >= 0
            int adjustment = 0
            for int p < player_count
                if p != outgoing
                    adjustment += game.points(racks[p], values)
            adjustments[outgoing] = adjustment
        int[] final_scores = [for int p < player_count then scores[p] + adjustments[p]]
        for int p < player_count
            string adjustment = (if adjustments[p] > 0 then "+" else "") + adjustments[p].string()
            lines = lines.append("final {names[p]} score={scores[p]} rack=" + collection(racks[p]) + " adjust={adjustment} total={final_scores[p]}")
        int[] standings = []
        for 1 <= int rank <= player_count
            int chosen = -1
            for int p < player_count
                bool used = false
                for int earlier = standings[]
                    used = used or earlier == p
                if not used and (chosen < 0 or final_scores[p] > final_scores[chosen])
                    chosen = p
            standings = standings.append(chosen)
            int[] stats = statistics[chosen]
            lines = lines.append("standing {rank} {names[chosen]} total={final_scores[chosen]} plays={stats[0]} bingos={stats[1]} exchanges={stats[2]} passes={stats[3]} top={stats[4]} loss={stats[5]}")
        string[] winners = [for int p < player_count if final_scores[p] == final_scores[standings[0]] then names[p]]
        lines = lines.append("winner " + winners.join(","))
        if highlight != ""
            lines = lines.append(highlight)
        game_totals[3] += turn
        for int[] stats = statistics[]
            game_totals[5] += stats[0]
            game_totals[6] += stats[2]
            game_totals[7] += stats[3]
            game_totals[8] += stats[1]
        return lines.append(position_summary(grid)).concat(board.display(grid))

    string[] .duplicate_game(string[] job)
        string[] header = job[0].split(" ")
        string name = header[1]
        int seed = integer(header[2])
        int player_count = int(len(job)) - 1
        game.Bag bag = game.Bag(seed, counts)
        .bag.shuffle()
        string[][] grid = board.empty_board()
        string rack = .bag.draw(7)
        string[] names = []
        string[] strategies = []
        int[] totals = [for int p < player_count then 0]
        string[] lines = ["DUPLICATE {name} seed={seed} players={player_count}"]
        for 1 <= int i < int(len(job))
            string[] fields = job[i].split(" ")
            names = names.append(fields[1])
            strategies = strategies.append(fields[2])
            lines = lines.append("player {i} {fields[1]} strategy={fields[2]}")
        int round_number = 0
        int master_total = 0
        string reason = "stuck"
        while true
            Evaluated[] legal = legal_moves(grid, rack)
            if len(legal) == 0
                break
            round_number += 1
            Evaluated master = legal[0]
            int[] picks = []
            for int p < player_count
                int score = legal[strategy_choice(legal, strategies[p])].score
                totals[p] += score
                picks = picks.append(score)
            master_total += master.score
            lines = lines.append("round {round_number} rack=" + collection(rack) + " moves={len(legal)} master " + notation(master) + " score={master.score} picks=" + [for int score = picks[] then score.string()].join(","))
            grid = scoring.apply(grid, master.placed)
            string drawn = .bag.draw(7 - int(len(master.leave)))
            rack = master.leave + drawn
            if rack == ""
                reason = "out"
                break
        string suffix = if reason == "stuck" then " rack=" + collection(rack) else ""
        lines = lines.concat(["end reason={reason} rounds={round_number}" + suffix, "master total={master_total}"])
        int maximum = totals[0]
        for int p < player_count
            if totals[p] > maximum
                maximum = totals[p]
            int percent = if master_total >= 1 then 100 * totals[p] / master_total else 0
            lines = lines.append("final {names[p]} total={totals[p]} percent={percent}")
        string[] winners = [for int p < player_count if totals[p] == maximum then names[p]]
        lines = lines.append("winner " + winners.join(","))
        game_totals[4] += round_number
        return lines.append(position_summary(grid)).concat(board.display(grid))

    void .process()
        string[] seen = []
        for string[] job = input_data.jobs[]
            string[] header = job[0].split(" ")
            string kind = header[0]
            string name = header[1]
            if kind == "TOPN"
                top_totals[0] += 1
            elif kind == "VALIDATE"
                validation_totals[0] += 1
            elif kind == "GAME"
                game_totals[0] += 1
            else
                game_totals[1] += 1
            string reason = job_error(job, seen)
            seen = seen.append(name)
            string[] paragraph = []
            if reason != ""
                paragraph = [kind + " " + name, "error " + reason]
                if kind == "TOPN"
                    top_totals[1] += 1
                elif kind == "VALIDATE"
                    validation_totals[1] += 1
                else
                    game_totals[2] += 1
            elif kind == "TOPN"
                paragraph = .topn(job)
            elif kind == "VALIDATE"
                paragraph = .validate(job)
            elif kind == "GAME"
                paragraph = .ordinary_game(job)
            else
                paragraph = .duplicate_game(job)
            if kind == "TOPN"
                move_blocks = move_blocks.append(paragraph)
            elif kind == "VALIDATE"
                validation_blocks = validation_blocks.append(paragraph)
            else
                game_blocks = game_blocks.append(paragraph)
        move_blocks = move_blocks.append(["SUMMARY jobs={top_totals[0]} errors={top_totals[1]} moves={top_totals[2]} bingos={top_totals[3]}"])
        validation_blocks = validation_blocks.append(["SUMMARY jobs={validation_totals[0]} errors={validation_totals[1]} moves={validation_totals[2]} valid={validation_totals[3]} invalid={validation_totals[4]} loss={validation_totals[5]}"])
        game_blocks = game_blocks.append(["SUMMARY games={game_totals[0]} duplicates={game_totals[1]} errors={game_totals[2]} turns={game_totals[3]} rounds={game_totals[4]} plays={game_totals[5]} exchanges={game_totals[6]} passes={game_totals[7]} bingos={game_totals[8]}"])

void write_blocks(string name, string[][] blocks)
    file.write("output/" + name, [for string[] block = blocks[] then block.join(NL)].join(NL + NL) + NL)

void run_program()
    Scrabble program = Scrabble(Inputs())
    .program.process()
    write_blocks("moves.txt", program.move_blocks)
    write_blocks("validation.txt", program.validation_blocks)
    write_blocks("game.txt", program.game_blocks)

run_program()
