int integer(string text)
    int value = int.parse(text)
    return value

string[] lines(string path)
    string text = file.read(path)
    string[] rows = text.split(NL)
    return rows[0:<int(len(rows)) - 1]

class Image(int width, int height, int[] pixels)
class Params(int dmin, int dmax, int[][] windows, int texture_window, int texture_threshold, int uniqueness, int lr_diff, string wta_kind, string sgm_kind, int sgm_window, int paths, int p1, int p2, int gamma, int speckle_size, int speckle_range, int fusion_votes, int object_range, int object_min, int focal, int baseline, int[][] samples)

Image read_image(string path)
    string[] rows = lines(path)
    string[] dimensions = rows[1].split(" ")
    int[] pixels = []
    for string row = rows[3:<int(len(rows))][]
        pixels = pixels.concat([for string value = row.split(" ")[] then integer(value)])
    return Image(integer(dimensions[0]), integer(dimensions[1]), pixels)

Params read_params()
    string[][] rows = [for string row = lines("input/params.txt")[] then row.split(" ")]
    int[][] windows = [for 2 <= int i <= 4 then [for string value = rows[i][1:<int(len(rows[i]))][] then integer(value)]]
    int[][] samples = [for string[] row = rows[24:<int(len(rows))][] then [integer(row[1]), integer(row[2])]]
    return Params(integer(rows[0][1]), integer(rows[1][1]), windows,
        integer(rows[5][1]), integer(rows[6][1]), integer(rows[7][1]), integer(rows[8][1]), rows[9][1], rows[10][1],
        integer(rows[11][1]), integer(rows[12][1]), integer(rows[13][1]), integer(rows[14][1]), integer(rows[15][1]),
        integer(rows[16][1]), integer(rows[17][1]), integer(rows[18][1]), integer(rows[19][1]), integer(rows[20][1]), integer(rows[21][1]), integer(rows[22][1]), samples)

void write_lines(string name, string[] rows)
    file.write("output/" + name, rows.join(NL) + NL)

void write_image(string name, int width, int height, int[] pixels)
    string[] rows = ["P2", "{width} {height}", "255"]
    for int y < height
        rows = rows.append([for int x < width then pixels[y * width + x].string()].join(" "))
    write_lines(name, rows)
