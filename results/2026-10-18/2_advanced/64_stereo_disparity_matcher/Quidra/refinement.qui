string hundredths(int value)
    string tail = (value % 100).string()
    return (value / 100).string() + "." + (if len(tail) == 1 then "0" else "") + tail

string two_decimals(int numerator, int denominator = 1)
    return hundredths((200 * numerator + denominator) / (2 * denominator))

int depth_hundredths(int disparity, int focal, int baseline)
    return (200 * focal * baseline + disparity) / (2 * disparity)

string[] subpixel(int disparity, int[] values, int dmin, int dmax, int focal, int baseline)
    int index = disparity - dmin
    int a = 0
    int b = 1
    if dmin < disparity and disparity < dmax and values[index - 1] > values[index] and values[index + 1] >= values[index]
        a = values[index - 1] - values[index + 1]
        b = 2 * (values[index - 1] - 2 * values[index] + values[index + 1])
    int rounded = (200 * (disparity * b + a) + b) / (2 * b)
    return [hundredths(rounded), two_decimals(100 * focal * baseline, rounded)]
