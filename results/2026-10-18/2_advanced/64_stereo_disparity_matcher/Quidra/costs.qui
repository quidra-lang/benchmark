int absolute(int value)
    return if value < 0 then -value else value

int clamped(int[] image, int width, int height, int x, int y)
    int column = if x < 0 then 0 elif x >= width then width - 1 else x
    int row = if y < 0 then 0 elif y >= height then height - 1 else y
    return image[row * width + column]

int[] box_sum(int[] image, int width, int height, int window)
    int radius = window / 2
    int padded_width = width + 2 * radius
    int padded_height = height + 2 * radius
    int[][] integral = [for int y <= padded_height then [for int x <= padded_width then 0]]
    for int y < padded_height
        int row_sum = 0
        for int x < padded_width
            row_sum += clamped(image, width, height, x - radius, y - radius)
            integral[y + 1][x + 1] = integral[y][x + 1] + row_sum
    int[] result = []
    for int y < height
        for int x < width
            result = result.append(integral[y + window][x + window] - integral[y][x + window] - integral[y + window][x] + integral[y][x])
    return result

int[] census(int[] image, int width, int height)
    int[] result = []
    for int y < height
        for int x < width
            int code = 0
            int center = image[y * width + x]
            for -2 <= int dy <= 2
                for -2 <= int dx <= 2
                    if dx != 0 or dy != 0
                        code = 2 * code + (if clamped(image, width, height, x + dx, y + dy) < center then 1 else 0)
            result = result.append(code)
    return result

int[] texture(int[] image, int width, int height, int window)
    int[] gradient = []
    for int y < height
        for int x < width
            gradient = gradient.append(absolute(clamped(image, width, height, x + 1, y) - clamped(image, width, height, x - 1, y)))
    return box_sum(gradient, width, height, window)

int hamming(int first, int second)
    int a = first
    int b = second
    int count = 0
    while a != 0 or b != 0
        if a % 2 != b % 2
            count += 1
        a /= 2
        b /= 2
    return count

int[][] volume(int[] left, int[] right, int[] census_left, int[] census_right, int width, int height, string kind, int window, int dmin, int dmax)
    int[][] result = [for int p < width * height then []]
    for dmin <= int disparity <= dmax
        int[] pixels = []
        for int y < height
            for int x < width
                int p = y * width + x
                int q = y * width + (if x < disparity then 0 else x - disparity)
                int difference = left[p] - right[q]
                int value = if kind == "census" then hamming(census_left[p], census_right[q]) elif kind == "sad" then absolute(difference) else difference * difference
                pixels = pixels.append(value)
        int[] sums = box_sum(pixels, width, height, window)
        for int p < width * height
            result[p] = result[p].append(sums[p])
    return result
