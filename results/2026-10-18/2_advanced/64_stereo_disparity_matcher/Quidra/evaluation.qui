import refinement = "./refinement.qui"

int absolute(int value)
    return if value < 0 then -value else value

int count(bool[] values)
    int result = 0
    for bool value = values[]
        if value
            result += 1
    return result

class Regions(bool[] nonocc, bool[] known, bool[] occluded, bool[] disc)

Regions regions(int[] truth, int width, int height)
    bool[] known = [for int value = truth[] then value != 0]
    bool[] occluded = [for int p < width * height then false]
    for int y < height
        for int x < width
            int p = y * width + x
            int g = truth[p]
            if g == 0
                continue
            bool hidden = x - g < 0
            for int x2 < width
                if truth[y * width + x2] > g and x2 - truth[y * width + x2] == x - g
                    hidden = true
            occluded[p] = hidden
    bool[] nonocc = [for int p < width * height then known[p] and not occluded[p]]
    bool[] disc = [for int p < width * height then false]
    for int y < height
        for int x < width
            int p = y * width + x
            if not nonocc[p]
                continue
            for -1 <= int dy <= 1
                for -1 <= int dx <= 1
                    int nx = x + dx
                    int ny = y + dy
                    if (dx != 0 or dy != 0) and nx >= 0 and nx < width and ny >= 0 and ny < height
                        int q = ny * width + nx
                        if known[q] and absolute(truth[q] - truth[p]) >= 2
                            disc[p] = true
    return Regions(nonocc, known, occluded, disc)

class Metrics(int pixels, int valid, int bad1, int bad2, int error_sum, int exact)

Metrics evaluate(int[] image, int[] truth, bool[] region)
    int pixels = 0
    int valid = 0
    int bad1 = 0
    int bad2 = 0
    int error_sum = 0
    int exact = 0
    for int p < int(len(image))
        if not region[p]
            continue
        pixels += 1
        if image[p] < 0
            bad1 += 1
            bad2 += 1
        else
            valid += 1
            int difference = absolute(image[p] - truth[p])
            error_sum += difference
            if difference > 1
                bad1 += 1
            if difference > 2
                bad2 += 1
            if difference == 0
                exact += 1
    return Metrics(pixels, valid, bad1, bad2, error_sum, exact)

int gcd(int first, int second)
    int a = first
    int b = second
    while b != 0
        int remainder = a % b
        a = b
        b = remainder
    return a

string ratio(int numerator, int denominator)
    if denominator == 0
        return "0/1 0.00"
    int divisor = gcd(numerator, denominator)
    return "{numerator / divisor}/{denominator / divisor} " + refinement.two_decimals(100 * numerator, denominator)
