import refinement = "./refinement.qui"

int absolute(int value)
    return if value < 0 then -value else value

int count(bool[] values)
    result := 0
    for value := values[]
        if value
            result += 1
    return result

class Regions(bool[] nonocc, bool[] known, bool[] occluded, bool[] disc)

Regions regions(int[] truth, int width, int height)
    known := [for value := truth[] then value != 0]
    occluded := [for p := (0:<int(width * height))[] then false]
    for: y < height
        for: x < width
            p := y * width + x
            g := truth[p]
            if g == 0
                continue
            hidden := x - g < 0
            for: x2 < width
                if truth[y * width + x2] > g and x2 - truth[y * width + x2] == x - g
                    hidden = true
            occluded[p] = hidden
    nonocc := [for p := (0:<int(width * height))[] then known[p] and not occluded[p]]
    disc := [for p := (0:<int(width * height))[] then false]
    for: y < height
        for: x < width
            p := y * width + x
            if not nonocc[p]
                continue
            for: -1 <= dy <= 1
                for: -1 <= dx <= 1
                    nx := x + dx
                    ny := y + dy
                    if (dx != 0 or dy != 0) and nx >= 0 and nx < width and ny >= 0 and ny < height
                        q := ny * width + nx
                        if known[q] and absolute(truth[q] - truth[p]) >= 2
                            disc[p] = true
    return Regions(nonocc, known, occluded, disc)

class Metrics(int pixels, int valid, int bad1, int bad2, int error_sum, int exact)

Metrics evaluate(int[] image, int[] truth, bool[] region)
    pixels := 0
    valid := 0
    bad1 := 0
    bad2 := 0
    error_sum := 0
    exact := 0
    for: p < int(len(image))
        if not region[p]
            continue
        pixels += 1
        if image[p] < 0
            bad1 += 1
            bad2 += 1
        else
            valid += 1
            difference := absolute(image[p] - truth[p])
            error_sum += difference
            if difference > 1
                bad1 += 1
            if difference > 2
                bad2 += 1
            if difference == 0
                exact += 1
    return Metrics(pixels, valid, bad1, bad2, error_sum, exact)

int gcd(int first, int second)
    a := first
    b := second
    while b
        a, b = b, a % b
    return a

string ratio(int numerator, int denominator)
    if denominator == 0
        return "0/1 0.00"
    divisor := gcd(numerator, denominator)
    return "{numerator / divisor}/{denominator / divisor} " + refinement.two_decimals(100 * numerator, denominator)
