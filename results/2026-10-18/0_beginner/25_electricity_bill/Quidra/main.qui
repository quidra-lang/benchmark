string[] names := ["Sato", "Suzuki", "Takahashi", "Tanaka", "Ito", "Watanabe"]
int[] usages := [85, 120, 254, 300, 438, 176]
int total := 0
for string name := names[], int usage := usages[]
    int bill := 900
    if usage <= 120
        bill += usage * 30
    elif usage <= 300
        bill += 120 * 30 + (usage - 120) * 36
    else
        bill += 120 * 30 + 180 * 36 + (usage - 300) * 40
    total += bill
    print.line("{name}: {usage} kWh, {bill} yen")
print.line("total: {total} yen")
