import collections
import text

string passage = "The cat sat on the mat. The dog sat on the rug, and the cat watched the dog. A bird sang on the fence, and the Dog barked at the bird. The cat slept in the sun, the bird flew away, and the dog sat by the door."
string[] tokens = text.ascii_words(passage, ignore_case = true)
map<string, nat> counts = collections.frequencies(tokens)
for (string word, nat amount) = collections.entries(counts).sorted(by = (counts.values(), counts.keys()), descending = (true, false))[:<5][]
    print.line("{word}: {amount}")
print.line("distinct words: {counts.size()}")
