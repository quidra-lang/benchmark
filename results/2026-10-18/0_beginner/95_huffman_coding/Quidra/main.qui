import c = collections
import math
import text

class Candidate(c.NodeId id, nat weight, nat minimum)

(nat, nat) priority(Candidate candidate)
    return (candidate.weight, candidate.minimum)

void assign_codes(c.NodeId | none id, string prefix, c.BinaryNodes<nat> nodes, string[] &codes)
    auto node = nodes.get(id)
    if not nodes.present(node.left)
        codes[node.value] = prefix
        return
    assign_codes(node.left, prefix + "0", nodes, &codes)
    assign_codes(node.right, prefix + "1", nodes, &codes)

string source = "she sells sea shells by the sea shore"
auto frequencies = c.frequencies(source.characters())
auto leaves = c.sorted_entries(frequencies)
c.BinaryNodes<nat> nodes()
Candidate[] active = []
for (_, nat weight) = leaves[nat i]
    auto id = .nodes.add(i)
    .active.push(Candidate(id, weight, i))
while len(active) > 1
    active = active.sorted_by_pair(priority)
    Candidate left = active[0]
    Candidate right = active[1]
    nat minimum = math.min(left.minimum, right.minimum)
    auto id = .nodes.add(0, left = left.id, right = right.id)
    active = active[2:].append(Candidate(id, left.weight + right.weight, minimum))
string[] codes = array(len(leaves), fill = "")
assign_codes(active[0].id, "", nodes, &codes)
nat bits = 0
for (string symbol, nat weight) = leaves[nat i]
    bits += weight * len(codes[i])
    print.line("'{symbol}' freq={weight} code={codes[i]}")
print.line("encoded bits: {bits}{NL}fixed 8-bit: {len(source) * 8}")
