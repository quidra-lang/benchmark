int smallest(int[] active, int[] weights, int[] minima)
    int best = 0
    for 1 <= int i < int(len(active))
        int a = active[i]
        int b = active[best]
        if weights[a] < weights[b] or (weights[a] == weights[b] and minima[a] < minima[b])
            best = i
    return best

void assign_codes(int node, string prefix, int[] left, int[] right, int[] symbols, string[] &codes)
    if symbols[node] >= 0
        codes[symbols[node]] = prefix
        return
    assign_codes(left[node], prefix + "0", left, right, symbols, &codes)
    assign_codes(right[node], prefix + "1", left, right, symbols, &codes)

string text = "she sells sea shells by the sea shore"
string alphabet = " abcdefghijklmnopqrstuvwxyz"
int[] frequencies = array(27, fill = 0)
for nat i < len(text)
    match alphabet.find(text[i])
        nat symbol
            frequencies[symbol] += 1
        none
            continue
int[] weights = []
int[] minima = []
int[] left = []
int[] right = []
int[] symbols = []
int[] active = []
for 0 <= int i < 27
    if frequencies[i] > 0
        active = active.append(int(len(weights)))
        weights = weights.append(frequencies[i])
        minima = minima.append(i)
        left = left.append(-1)
        right = right.append(-1)
        symbols = symbols.append(i)
while len(active) > 1
    int[] children = []
    for 0 <= int take < 2
        int index = smallest(active, weights, minima)
        children = children.append(active[index])
        int[] remaining = []
        for 0 <= int i < int(len(active))
            if i != index
                remaining = remaining.append(active[i])
        active = remaining
    int first = children[0]
    int second = children[1]
    int node = int(len(weights))
    weights = weights.append(weights[first] + weights[second])
    minima = minima.append(if minima[first] < minima[second] then minima[first] else minima[second])
    left = left.append(first)
    right = right.append(second)
    symbols = symbols.append(-1)
    active = active.append(node)
string[] codes = array(27, fill = "")
assign_codes(active[0], "", left, right, symbols, &codes)
int bits = 0
for 0 <= int i < 27
    if frequencies[i] > 0
        bits += frequencies[i] * int(len(codes[i]))
        print("'{alphabet[i]}' freq={frequencies[i]} code={codes[i]}{NL}")
int fixed_bits = int(len(text)) * 8
print("encoded bits: {bits}{NL}fixed 8-bit: {fixed_bits}{NL}")
