import collections
import math
import text

class Node(nat weight, nat minimum, int left = -1, int right = -1)

void assign_codes(int index, string prefix, Node[] nodes, string[] &codes)
    Node node = nodes[index]
    if node.left == -1
        codes[index] = prefix
        return
    assign_codes(node.left, prefix + "0", nodes, &codes)
    assign_codes(node.right, prefix + "1", nodes, &codes)

string source = "she sells sea shells by the sea shore"
auto frequencies = collections.frequencies(source.characters())
auto leaves = collections.entries(frequencies).sorted(by = frequencies.keys())
Node[] nodes = []
for (string symbol, nat weight) = leaves[]
    .nodes.push(Node(weight, len(nodes)))
int[] active = int(nodes.indices())
while len(active) > 1
    auto weights = [for int index = active[] then nodes[index].weight]
    auto minima = [for int index = active[] then nodes[index].minimum]
    active = active.sorted(by = (weights, minima))
    int left = active[0]
    int right = active[1]
    Node first = nodes[left]
    Node second = nodes[right]
    nat minimum = math.min(first.minimum, second.minimum)
    active = active[2:].append(int(len(nodes)))
    .nodes.push(Node(first.weight + second.weight, minimum, left, right))
string[] codes = array(len(leaves), fill = "")
assign_codes(active[0], "", nodes, &codes)
nat bits = 0
for nat i < len(leaves)
    (string symbol, nat weight) = leaves[i]
    bits += weight * len(codes[i])
    print.line("'{symbol}' freq={weight} code={codes[i]}")
print.line("encoded bits: {bits}{NL}fixed 8-bit: {len(source) * 8}")
