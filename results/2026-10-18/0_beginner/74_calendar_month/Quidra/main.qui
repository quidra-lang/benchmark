string[] names = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
int[] lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
int[][] months = [[2024, 2], [2026, 8], [2026, 11]]
for 0 <= int index < 3
    int year = months[index][0]
    int month = months[index][1]
    int y = year
    int m = month
    if m < 3
        m += 12
        y -= 1
    int century = y / 100
    int within = y % 100
    int h = (1 + 13 * (m + 1) / 5 + within + within / 4 + century / 4 + 5 * century) % 7
    int weekday = (h + 6) % 7
    int days = lengths[month - 1]
    if month == 2 and (year % 400 == 0 or (year % 4 == 0 and year % 100 != 0))
        days = 29
    if index > 0
        print(NL)
    print("{names[month - 1]} {year}{NL}Su Mo Tu We Th Fr Sa{NL}")
    string line = string.repeat(" ", nat(weekday * 3))
    int column = weekday
    for 1 <= int day <= days
        if day > 1 and column > 0
            line += " "
        line += "{day:int=2}"
        column += 1
        if column == 7 or day == days
            print(line + NL)
            line = ""
            column = 0
