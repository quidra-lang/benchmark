import collections

string[] names = [
    "January", "February", "March", "April", "May", "June", "July", "August", "September",
    "October", "November", "December",
]
int[] lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
(int, int)[] months = [(2024, 2), (2026, 8), (2026, 11)]
for (int year, int month) = months[nat index]
    int y = if month < 3 then year - 1 else year
    int m = if month < 3 then month + 12 else month
    int century = y / 100
    int within = y % 100
    int h = (1 + 13 * (m + 1) / 5 + within + within / 4 + century / 4 + 5 * century) % 7
    int weekday = (h + 6) % 7
    int days = lengths[month - 1]
    if month == 2 and (year % 400 == 0 or (year % 4 == 0 and year % 100 != 0))
        days = 29
    if index > 0
        print.line()
    print.line("{names[month - 1]} {year}{NL}Su Mo Tu We Th Fr Sa")
    string[] fields = array(nat(weekday), fill = "  ")
    fields = fields.concat([for int day = (1:days)[] then "{day:int=2}"])
    auto weeks = fields.chunks(7)
    for string[] week = weeks[]
        print.line(week.join(" "))
