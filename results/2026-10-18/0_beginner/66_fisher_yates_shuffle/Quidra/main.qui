import collections

ranks := "A23456789TJQK"
suits := "SHDC"
string[] deck := [for i := (0:<52)[] then ranks[i % 13] + suits[i / 13]]
int state := 2026
for 51 >= int i >= 1
    state = state * 48271 % 2147483647
    j := state % (i + 1)
    (deck[i], deck[j]) = (deck[j], deck[i])
rows := deck.chunks(13)
for cards := rows[]
    print.line(cards.join(" "))
