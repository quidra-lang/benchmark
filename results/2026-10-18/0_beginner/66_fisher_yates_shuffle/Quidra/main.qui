string ranks = "A23456789TJQK"
string suits = "SHDC"
string[] deck = []
for nat suit < len(suits)
    for nat rank < len(ranks)
        deck = deck.append(ranks[rank] + suits[suit])
int state = 2026
for 51 >= int i >= 1
    state = state * 48271 % 2147483647
    int j = state % (i + 1)
    (deck[i], deck[j]) = (deck[j], deck[i])
for 0 <= int row < 4
    string[] cards = deck[(row * 13):<(row * 13 + 13)]
    print(cards.join(" ") + NL)
