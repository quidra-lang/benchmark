import text

string[] phrases := [
    "Never odd or even",
    "Race a car",
    "Was it a car or a cat I saw?",
    "Hello, World!",
    "Step on no pets.",
    "No lemon, no melon",
]
for string phrase := phrases[]
    string cleaned := text.ascii_words(phrase, ignore_case = true).join("")
    string result := if cleaned == cleaned[::-1] then "yes" else "no"
    print.line("{phrase} -> {result}")
