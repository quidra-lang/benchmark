string letters(string text)
    string alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string result = ""
    for nat i < len(text)
        match alphabet.find(text[i])
            nat position
                result += alphabet[position % 26]
            none
                continue
    return result

string[] phrases = [
    "Never odd or even", "Race a car", "Was it a car or a cat I saw?", "Hello, World!",
    "Step on no pets.", "No lemon, no melon",
]
for string phrase = phrases[]
    string cleaned = letters(phrase)
    string result = if cleaned == cleaned[::-1] then "yes" else "no"
    print("{phrase} -> {result}{NL}")
