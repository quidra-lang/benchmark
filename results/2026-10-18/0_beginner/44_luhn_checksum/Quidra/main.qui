numbers := [
    "688126340316",
    "0128469655154",
    "92181914514156",
    "177332430060552",
    "7982377590420309",
    "9884593615513906",
]
for number := numbers[]
    total := 0
    for: i < number.len()
        digit := int(number[i])
        if (number.len() - i) % 2 == 0
            digit *= 2
            if digit > 9
                digit -= 9
        total += digit
    if total % 10 == 0
        println("{number}: valid")
    else
        last := int(number[number.len() - 1])
        expected := (10 - (total - last) % 10) % 10
        println("{number}: invalid (expected check digit {expected})")
