(string, int, int)[] people = [
    ("Aiko", 158, 45),
    ("Kenji", 172, 68),
    ("Mika", 165, 70),
    ("Ryo", 180, 101),
    ("Yuki", 150, 52),
]
for (string name, int height, int weight) = people[]
    int numerator = weight * 10000
    int denominator = height * height
    real bmi = real(numerator) / real(denominator)
    string category = (
        if bmi < 18.5 then "underweight"
        elif bmi < 25.0 then "normal"
        elif bmi < 30.0 then "overweight"
        else "obese"
    )
    print.line("{name}: BMI {bmi:frac=1} ({category})")
