import math

string fixed(real64 value, int places)
    int scale = 10 ^ places
    int rounded = math.round(value * real64(scale))
    string sign = ""
    if rounded < 0
        sign = "-"
        rounded = -rounded
    int whole = rounded / scale
    int fraction = rounded % scale
    string tail = fraction.string()
    return sign + whole.string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string[] names = ["Aiko", "Kenji", "Mika", "Ryo", "Yuki"]
int[] heights = [158, 172, 165, 180, 150]
int[] weights = [45, 68, 70, 101, 52]
for 0 <= int index < 5
    int numerator = weights[index] * 10000
    int denominator = heights[index] * heights[index]
    real64 bmi = real64(numerator) / real64(denominator)
    string category = if bmi < 18.5 then "underweight" elif bmi < 25.0 then "normal" elif bmi < 30.0 then "overweight" else "obese"
    print("{names[index]}: BMI {fixed(bmi, 1)} ({category}){NL}")
