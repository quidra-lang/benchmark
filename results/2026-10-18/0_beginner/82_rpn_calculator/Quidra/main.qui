import collections

expressions := [
    "3 4 + 2 *",
    "-17 5 / 4 -3 * -",
    "1 2 + * 3",
    "15 7 1 1 + - / 3 * 2 1 1 + + -",
    "4 2 5 * + 1 3 2 * - 5 + /",
    "2 3 4 + 5",
    "46341 46339 * -2 /",
]
for expression := expressions[]
    int[] stack := []
    failure := ""
    tokens := expression.split(" ")
    for token := tokens[]
        if len(token) == 1 and "+-*/".contains(token)
            if len(stack) < 2
                failure = "stack underflow"
                break
            b := .stack.take()
            a := .stack.take()
            int value := 0
            if token == "+"
                value = a + b
            elif token == "-"
                value = a - b
            elif token == "*"
                value = a * b
            elif b == 0
                failure = "division by zero"
                break
            else
                value = a / b
            .stack.push(value)
        else
            value := int.parse(token)
            .stack.push(value)
    if failure == "" and len(stack) != 1
        failure = "leftover operands"
    if failure != ""
        println("{expression} => error: {failure}")
    else
        println("{expression} => {stack[0]}")
