int paths(bool obstacles)
    grid := [".......", "..#....", "....#..", ".#.....", "...#.#.", "......."]
    int[] dp := array(7, fill = 0)
    dp[0] = 1
    for row := grid[]
        for int c < 7
            if obstacles and row[c] == "#"
                dp[c] = 0
            elif c > 0
                dp[c] += dp[c - 1]
    return dp[6]

print.line("without obstacles: {paths(false)}{NL}with obstacles: {paths(true)}")
