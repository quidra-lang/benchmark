string date_text(int year, int month, int day)
    return "{year:int=4,zero}-{month:int=2,zero}-{day:int=2,zero}"

int[][] cases = [[1999, 12, 25, 10], [2000, 2, 27, 3], [2021, 2, 20, 14], [2023, 11, 15, 120], [2026, 10, 17, 1500]]
int[] common_months = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
for int[] row = cases[]
    int year = row[0]
    int month = row[1]
    int day = row[2]
    int days = row[3]
    string original = date_text(year, month, day)
    for 0 <= int added < days
        bool leap = year % 400 == 0 or (year % 4 == 0 and year % 100 != 0)
        int month_length = common_months[month - 1]
        if month == 2 and leap
            month_length = 29
        day += 1
        if day > month_length
            day = 1
            month += 1
            if month > 12
                month = 1
                year += 1
    print("{original} + {days} days = {date_text(year, month, day)}{NL}")
