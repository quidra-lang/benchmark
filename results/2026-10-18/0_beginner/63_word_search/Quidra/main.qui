string search(string word, string[] board)
    int[] dr = [0, 1, 1, 1, 0, -1, -1, -1]
    int[] dc = [1, 1, 0, -1, -1, -1, 0, 1]
    string[] directions = ["E", "SE", "S", "SW", "W", "NW", "N", "NE"]
    for 0 <= int r < 10
        for 0 <= int c < 10
            for 0 <= int direction < 8
                bool matched = true
                for 0 <= int k < int(len(word))
                    int row = r + k * dr[direction]
                    int column = c + k * dc[direction]
                    if row < 0 or row >= 10 or column < 0 or column >= 10 or board[row][column] != word[k]
                        matched = false
                        break
                if matched
                    return "({r}, {c}) {directions[direction]}"
    return "not found"

string[] board = ["MMONKENBIR", "PMTIGERJPL", "TGREJEDUZI", "SPYUTEJDEC", "WKAPSIDLBN", "KUVNGSBPRO", "RIBSDACBAM", "YWVAUAPKAH", "KYCGTHHESR", "OCCALAOKKR"]
string[] words = ["TIGER", "ZEBRA", "MONKEY", "PANDA", "KOALA", "RABBIT"]
for string word = words[]
    print("{word}: {search(word, board)}{NL}")
