import math

int[] temperatures = [-40, -15, -3, 0, 22, 37, 100]
for int celsius = temperatures[]
    real64 fahrenheit = ((real64(celsius) * 9.0) / 5.0) + 32.0
    int scaled = math.round(fahrenheit * 10.0)
    string sign = ""
    if scaled < 0
        sign = "-"
        scaled = -scaled
    int whole = scaled / 10
    int fraction = scaled % 10
    print("{celsius} C = {sign}{whole}.{fraction} F{NL}")
