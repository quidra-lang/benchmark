string letters(string text)
    string alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    string result = ""
    for nat i < len(text)
        match alphabet.find(text[i])
            nat position
                result += alphabet[position % 26]
            none
                continue
    return result

string normalized = letters("Peter Piper picked a peck of pickled peppers!")
string alphabet = "abcdefghijklmnopqrstuvwxyz"
int[] counts = array(26, fill = 0)
for nat i < len(normalized)
    match alphabet.find(normalized[i])
        nat position
            counts[position] += 1
        none
            continue
for 0 <= int i < 26
    if counts[i] > 0
        print("{alphabet[i]}: {counts[i]}{NL}")
