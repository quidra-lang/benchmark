string sentence = "Peter Piper picked a peck of pickled peppers!"
string alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
int[] counts = array(26, fill = 0)
for nat i < len(sentence)
    match alphabet.find(sentence[i])
        nat position
            counts[position % 26] += 1
        none
            continue
for 0 <= int i < 26
    if counts[i] > 0
        print("{alphabet[i]}: {counts[i]}{NL}")
