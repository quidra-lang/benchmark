import collections
import math

commands := [
    "undo", "type hello world", "delete 5", "type there", "undo", "undo", "redo", "type friend",
    "redo", "delete 20", "undo", "redo", "redo", "type see you",
]
buffer := ""
string[] undo := []
string[] redo := []
for command := commands[]
    result := ""
    if command == "undo"
        match .undo.pop()
            string previous
                .redo.push(buffer)
                buffer = previous
            none
                result = "nothing to undo"
    elif command == "redo"
        match .redo.pop()
            string previous
                .undo.push(buffer)
                buffer = previous
            none
                result = "nothing to redo"
    else
        .undo.push(buffer)
        redo = []
        if command.starts_with("type ")
            buffer += command[5:]
        else
            int count := int.parse(command[7:])
            keep := math.max(0, int(len(buffer)) - count)
            buffer = buffer[:<keep]
    if result == ""
        result = DQ + buffer + DQ
    print.line("{command} => {result}")
