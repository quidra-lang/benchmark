string[] commands = ["undo", "type hello world", "delete 5", "type there", "undo", "undo", "redo", "type friend", "redo", "delete 20", "undo", "redo", "redo", "type see you"]
string buffer = ""
string[] undo = []
string[] redo = []
for string command = commands[]
    string result = ""
    if command == "undo"
        if len(undo) == 0
            result = "nothing to undo"
        else
            redo = redo.append(buffer)
            buffer = undo[len(undo) - 1]
            undo = undo[:<len(undo) - 1]
    elif command == "redo"
        if len(redo) == 0
            result = "nothing to redo"
        else
            undo = undo.append(buffer)
            buffer = redo[len(redo) - 1]
            redo = redo[:<len(redo) - 1]
    else
        undo = undo.append(buffer)
        redo = []
        if command.starts_with("type ")
            buffer += command[5:]
        else
            int count = int.parse(command[7:])
            int keep = int(len(buffer)) - count
            if keep < 0
                keep = 0
            buffer = buffer[:<keep]
    if result == ""
        result = DQ + buffer + DQ
    print("{command} => {result}{NL}")
