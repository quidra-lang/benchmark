import math
import text

int[][] a := [[3, -2, 5, 1], [-4, 7, 0, 6], [2, 9, -8, -3]]
int[][] b := [[1, 4], [-5, 2], [6, -1], [0, 7]]
for int i < 3
    for int j < 2
        column := [for row := b[] then row[j]]
        field := text.pad_start(a[i].dot(column).string(), 5)
        print(field)
    print.line()
