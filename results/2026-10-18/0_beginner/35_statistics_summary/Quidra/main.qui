import math

int64[] values = [72, 85, 64, 90, 85, 58, 77, 85, 69, 93, 71]
real64 mean = real64(values.sum()) / real64(len(values))
int64[] ordered = values.sorted()
int64 median = ordered[5]
int64 mode = ordered[0]
int best = 0
for int64 candidate = ordered[]
    int count = 0
    for int64 value = values[]
        if value == candidate
            count += 1
    if count > best
        best = count
        mode = candidate
int64 spread = ordered[10] - ordered[0]
real64 squares = 0.0
for int64 value = values[]
    real64 difference = real64(value) - mean
    squares += difference * difference
real64 deviation = math.sqrt(squares / real64(len(values)))
print("mean: {mean:frac=3}{NL}median: {median}{NL}mode: {mode}{NL}range: {spread}{NL}stdev: {deviation:frac=3}{NL}")
