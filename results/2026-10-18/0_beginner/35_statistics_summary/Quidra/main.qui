import collections
import math

int64[] values := [72, 85, 64, 90, 85, 58, 77, 85, 69, 93, 71]
count := real64(len(values))
mean := real64(values.sum()) / count
ordered := values.sorted()
median := ordered[5]
counts := values.frequencies()
(mode, _) := collections.ranked_entries(counts)[0]
spread := ordered[10] - ordered[0]
real64 squares := 0.0
for value := values[]
    difference := real64(value) - mean
    squares += difference * difference
deviation := math.sqrt(squares / count)
print.line("mean: {mean:frac=3}{NL}median: {median}{NL}mode: {mode}{NL}range: {spread}{NL}stdev: {deviation:frac=3}")
