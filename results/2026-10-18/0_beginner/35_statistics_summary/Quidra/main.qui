import math

string fixed(real64 value, int places)
    int scale = 10 ^ places
    int rounded = math.round(value * real64(scale))
    string sign = ""
    if rounded < 0
        sign = "-"
        rounded = -rounded
    int whole = rounded / scale
    int fraction = rounded % scale
    string tail = fraction.string()
    return sign + whole.string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

int64[] values = [72, 85, 64, 90, 85, 58, 77, 85, 69, 93, 71]
int64 total = 0
for int64 value = values[]
    total += value
real64 mean = real64(total) / real64(len(values))
int64[] ordered = values.sorted()
int64 median = ordered[5]
int64 mode = ordered[0]
int best = 0
for int64 candidate = ordered[]
    int count = 0
    for int64 value = values[]
        if value == candidate
            count += 1
    if count > best
        best = count
        mode = candidate
int64 spread = ordered[10] - ordered[0]
real64 squares = 0.0
for int64 value = values[]
    real64 difference = real64(value) - mean
    squares += difference * difference
real64 deviation = math.sqrt(squares / real64(len(values)))
print("mean: {fixed(mean, 3)}{NL}median: {median}{NL}mode: {mode}{NL}range: {spread}{NL}stdev: {fixed(deviation, 3)}{NL}")
