import collections
import math

int64[] values = [72, 85, 64, 90, 85, 58, 77, 85, 69, 93, 71]
real64 count = real64(len(values))
real64 mean = real64(values.sum()) / count
int64[] ordered = values.sorted()
int64 median = ordered[5]
auto counts = collections.frequencies(values)
(int64 mode, _) = collections.ranked_entries(counts)[0]
int64 spread = ordered[10] - ordered[0]
real64 squares = 0.0
for int64 value = values[]
    real64 difference = real64(value) - mean
    squares += difference * difference
real64 deviation = math.sqrt(squares / count)
print.line("mean: {mean:frac=3}{NL}median: {median}{NL}mode: {mode}{NL}range: {spread}{NL}stdev: {deviation:frac=3}")
