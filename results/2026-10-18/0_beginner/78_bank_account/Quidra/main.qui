import collections

string[] names = ["Nina", "Leo", "Emma"]
int[] balances = [12000, 3500, 800]
string[] commands = [
    "deposit Emma 1200",
    "withdraw Leo 4000",
    "transfer Nina Leo 5000",
    "withdraw Leo 4000",
    "transfer Emma Nina 2500",
    "transfer Emma Nina 2000",
    "withdraw Emma 300",
    "deposit Nina 750",
    "transfer Leo Emma 3200",
    "withdraw Nina 9800",
]
for string command = commands[nat i]
    string[] fields = command.split(" ")
    nat source = collections.index(names, fields[1])
    int amount = int.parse(fields[len(fields) - 1])
    bool success = true
    if fields[0] == "deposit"
        balances[source] += amount
    elif amount > balances[source]
        success = false
    else
        balances[source] -= amount
        if fields[0] == "transfer"
            nat target = collections.index(names, fields[2])
            balances[target] += amount
    string status = if success then "ok" else "failed (insufficient funds)"
    nat number = i + 1
    print.line("op {number}: {command} {status}")
nat[] order = names.indices().sorted(by = names)
for nat index = order[]
    print.line("{names[index]}: {balances[index]}")
