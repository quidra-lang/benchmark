import text

identifiers := [
    "user_name", "maxRetryCount", "ShoppingCartItem", "background-color", "get_last_login_time",
    "isEmailAddressValid",
]
for identifier := identifiers[]
    snake := text.identifier.snake(identifier)
    camel := text.identifier.camel(identifier)
    pascal := text.identifier.pascal(identifier)
    kebab := text.identifier.kebab(identifier)
    println("{identifier}: snake={snake}, camel={camel}, pascal={pascal}, kebab={kebab}")
