string capitalized(string word)
    string lower = "abcdefghijklmnopqrstuvwxyz"
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    match lower.find(word[0])
        nat index
            return upper[index] + word[1:]
        none
            return word

string[] identifiers = ["user_name", "maxRetryCount", "ShoppingCartItem", "background-color", "get_last_login_time", "isEmailAddressValid"]
string lower = "abcdefghijklmnopqrstuvwxyz"
string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
for string identifier = identifiers[]
    string[] words = []
    string current = ""
    for nat i < len(identifier)
        string character = identifier[i]
        if character == "_" or character == "-"
            if current != ""
                words = words.append(current)
                current = ""
        else
            match upper.find(character)
                nat index
                    if current != ""
                        words = words.append(current)
                    current = lower[index]
                none
                    current += character
    if current != ""
        words = words.append(current)
    string snake = words.join("_")
    string kebab = words.join("-")
    string camel = words[0]
    string pascal = ""
    for nat i < len(words)
        string word = capitalized(words[i])
        pascal += word
        if i > 0
            camel += word
    print("{identifier}: snake={snake}, camel={camel}, pascal={pascal}, kebab={kebab}{NL}")
