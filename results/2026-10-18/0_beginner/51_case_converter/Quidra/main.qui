import text

string[] identifiers := [
    "user_name", "maxRetryCount", "ShoppingCartItem", "background-color", "get_last_login_time",
    "isEmailAddressValid",
]
for string identifier := identifiers[]
    string snake := text.identifier.snake(identifier)
    string camel := text.identifier.camel(identifier)
    string pascal := text.identifier.pascal(identifier)
    string kebab := text.identifier.kebab(identifier)
    print.line("{identifier}: snake={snake}, camel={camel}, pascal={pascal}, kebab={kebab}")
