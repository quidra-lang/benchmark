words := "we planted beans and carrots in the garden behind our old house".split(" ")
longest := words[0]
shortest := words[0]
nat total := 0
for word := words[]
    total += word.len()
    if word.len() > longest.len()
        longest = word
    if word.len() < shortest.len()
        shortest = word
average := real(total) / real(words.len())
println("words: {words.len()}{NL}longest: {longest}{NL}shortest: {shortest}{NL}average length: {average:.2}")
