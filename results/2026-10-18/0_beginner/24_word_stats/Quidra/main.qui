string[] words = "we planted beans and carrots in the garden behind our old house".split(" ")
string longest = words[0]
string shortest = words[0]
int total = 0
for string word = words[]
    total += int(len(word))
    if len(word) > len(longest)
        longest = word
    if len(word) < len(shortest)
        shortest = word
real average = real(total) / real(len(words))
print("words: {len(words)}{NL}longest: {longest}{NL}shortest: {shortest}{NL}average length: {average:frac=2}{NL}")
