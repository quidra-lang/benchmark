import math

string fixed(real64 value, int places)
    int scale = 10 ^ places
    int rounded = math.round(value * real64(scale))
    string sign = ""
    if rounded < 0
        sign = "-"
        rounded = -rounded
    int whole = rounded / scale
    int fraction = rounded % scale
    string tail = fraction.string()
    return sign + whole.string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string[] words = "we planted beans and carrots in the garden behind our old house".split(" ")
string longest = words[0]
string shortest = words[0]
int total = 0
for string word = words[]
    total += int(len(word))
    if len(word) > len(longest)
        longest = word
    if len(word) < len(shortest)
        shortest = word
real64 average = real64(total) / real64(len(words))
print("words: {len(words)}{NL}longest: {longest}{NL}shortest: {shortest}{NL}average length: {fixed(average, 2)}{NL}")
