words := "we planted beans and carrots in the garden behind our old house".split(" ")
longest := words[0]
shortest := words[0]
nat total := 0
for word := words[]
    total += len(word)
    if len(word) > len(longest)
        longest = word
    if len(word) < len(shortest)
        shortest = word
average := real(total) / real(len(words))
println("words: {len(words)}{NL}longest: {longest}{NL}shortest: {shortest}{NL}average length: {average:.2}")
