import math

int[] targets = [8, 11, 15, 22, 33, 40]
int[] coins = [1, 5, 6, 9]
int maximum = targets.max_all()
int[] minimum = array(nat(maximum + 1), fill = maximum + 1)
minimum[0] = 0
for 1 <= int amount <= maximum
    minimum[amount] = [for int coin = coins[] if coin <= amount then minimum[amount - coin] + 1].min_all()
int[] ways = array(nat(maximum + 1), fill = 0)
ways[0] = 1
for int coin = coins[]
    for coin <= int amount <= maximum
        ways[amount] += ways[amount - coin]
for int target = targets[]
    int remaining = target
    int greedy = 0
    for int coin = coins[::-1][]
        greedy += remaining / coin
        remaining %= coin
    print.line("{target}: min={minimum[target]} greedy={greedy} ways={ways[target]}")
