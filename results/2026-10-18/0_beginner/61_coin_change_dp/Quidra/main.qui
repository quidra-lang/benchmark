import math

targets := [8, 11, 15, 22, 33, 40]
coins := [1, 5, 6, 9]
maximum := targets.max_all()
minimum := array(nat(maximum + 1), fill = maximum + 1)
minimum[0] = 0
for 1 <= int amount <= maximum
    minimum[amount] = [for coin := coins[] if coin <= amount then minimum[amount - coin] + 1].min_all()
ways := array(nat(maximum + 1), fill = 0)
ways[0] = 1
for coin := coins[]
    for coin <= int amount <= maximum
        ways[amount] += ways[amount - coin]
for target := targets[]
    remaining := target
    greedy := 0
    for coin := coins[::-1][]
        greedy += remaining / coin
        remaining %= coin
    println("{target}: min={minimum[target]} greedy={greedy} ways={ways[target]}")
