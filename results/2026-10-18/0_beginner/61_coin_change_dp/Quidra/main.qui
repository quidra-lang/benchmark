int[] targets = [8, 11, 15, 22, 33, 40]
int[] coins = [1, 5, 6, 9]
for int target = targets[]
    int[] minimum = array(nat(target + 1), fill = target + 1)
    minimum[0] = 0
    for 1 <= int amount <= target
        for int coin = coins[]
            if coin <= amount and minimum[amount - coin] + 1 < minimum[amount]
                minimum[amount] = minimum[amount - coin] + 1
    int[] ways = array(nat(target + 1), fill = 0)
    ways[0] = 1
    for int coin = coins[]
        for coin <= int amount <= target
            ways[amount] += ways[amount - coin]
    int remaining = target
    int greedy = 0
    for 3 >= int i >= 0
        greedy += remaining / coins[i]
        remaining %= coins[i]
    print("{target}: min={minimum[target]} greedy={greedy} ways={ways[target]}{NL}")
