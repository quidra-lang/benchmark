string encode(string text)
    string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    int[] bytes = text.codepoints()
    string result = ""
    for 0 <= int i < int(len(bytes)) step 3
        int remaining = int(len(bytes)) - i
        int second = if remaining >= 2 then bytes[i + 1] else 0
        int third = if remaining >= 3 then bytes[i + 2] else 0
        int value = bytes[i] * 65536 + second * 256 + third
        result += alphabet[value / 262144]
        result += alphabet[value / 4096 % 64]
        result += if remaining >= 2 then alphabet[value / 64 % 64] else "="
        result += if remaining >= 3 then alphabet[value % 64] else "="
    return result

string[] inputs = ["Man", "Hello, World!", "", "<b>bold</b>", "a+b=c?"]
for string text = inputs[]
    print("{DQ}{text}{DQ} -> {DQ}{encode(text)}{DQ}{NL}")
