string encode(string text)
    alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    bytes := text.codepoints()
    result := ""
    for: i < bytes.len() step 3
        remaining := bytes.len() - i
        second := if remaining >= 2 then bytes[i + 1] else 0
        third := if remaining >= 3 then bytes[i + 2] else 0
        value := bytes[i] * 65536 + second * 256 + third
        divisors := [262144, 4096, 64, 1]
        for: divisor := divisors[digit]
            result += if digit <= remaining then alphabet[value / divisor % 64] else "="
    return result

inputs := ["Man", "Hello, World!", "", "<b>bold</b>", "a+b=c?"]
for text := inputs[]
    println("{DQ}{text}{DQ} -> {DQ}{encode(text)}{DQ}")
