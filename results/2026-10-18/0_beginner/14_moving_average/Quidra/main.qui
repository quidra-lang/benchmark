import math

string fixed(real64 value, int places)
    int scale = 10 ^ places
    int rounded = math.round(value * real64(scale))
    string sign = ""
    if rounded < 0
        sign = "-"
        rounded = -rounded
    int whole = rounded / scale
    int fraction = rounded % scale
    string tail = fraction.string()
    return sign + whole.string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

int[] sales = [120, 135, 98, 143, 160, 152, 171, 149, 188, 176]
for 2 <= int index < int(len(sales))
    int total = sales[index - 2] + sales[index - 1] + sales[index]
    real64 average = real64(total) / 3.0
    int day = index + 1
    print("day {day}: {fixed(average, 2)}{NL}")
