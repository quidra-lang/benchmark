int permutations(string prefix, bool[] used, int count)
    if len(prefix) == 4
        count += 1
        print("{count}: {prefix}{NL}")
        return count
    string alphabet = "ABCD"
    for 0 <= int i < 4
        if not used[i]
            used[i] = true
            count = permutations(prefix + alphabet[i], used, count)
            used[i] = false
    return count

bool[] used = array(4, fill = false)
int count = permutations("", used, 0)
