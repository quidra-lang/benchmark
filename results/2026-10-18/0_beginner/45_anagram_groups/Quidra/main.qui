string signature(string word)
    string[] characters = []
    for nat i < len(word)
        characters = characters.append(word[i])
    return characters.sorted().join("")

string[] words = "listen stone night silent notes apple thing enlist earth onset heart tones".split(" ")
string[] signatures = [for string word = words[] then signature(word)]
bool[] used = array(len(words), fill = false)
for nat i < len(words)
    if used[i]
        continue
    string[] group = []
    for nat j < len(words)
        if not used[j] and signatures[j] == signatures[i]
            group = group.append(words[j])
            used[j] = true
    print(group.join(" ") + NL)
