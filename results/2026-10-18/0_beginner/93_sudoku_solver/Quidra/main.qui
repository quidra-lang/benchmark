import collections
import text

bool solve(int[] &board, int &placements)
    nat position
    match board.find_index(0)
        nat index
            position = index
        none
            return true
    row := position / 9
    column := position % 9
    for 1 <= int digit <= 9
        valid := true
        for nat i < 9
            if board[row * 9 + i] == digit or board[i * 9 + column] == digit
                valid = false
        block_row := row / 3 * 3
        block_column := column / 3 * 3
        for nat dr < 3
            for nat dc < 3
                if board[(block_row + dr) * 9 + block_column + dc] == digit
                    valid = false
        if valid
            board[position] = digit
            placements += 1
            if solve(&board, &placements)
                return true
            board[position] = 0
    return false

rows := [
    "800025000",
    "070080005",
    "260400070",
    "000001900",
    "010000040",
    "600200000",
    "900010000",
    "700000004",
    "020000036",
]
puzzle := rows.join("")
board := [for int code := puzzle.codepoints()[] then code - 48]
int placements := 0
solved := solve(&board, &placements)
solved_rows := board.chunks(9)
for int[] row := solved_rows[]
    print.line(text.join(row, " "))
print.line("placements: {placements}")
