bool solve(int[] &board, int &placements)
    int position = -1
    for 0 <= int i < 81
        if board[i] == 0
            position = i
            break
    if position == -1
        return true
    int row = position / 9
    int column = position % 9
    for 1 <= int digit <= 9
        bool valid = true
        for 0 <= int i < 9
            if board[row * 9 + i] == digit or board[i * 9 + column] == digit
                valid = false
        int block_row = row / 3 * 3
        int block_column = column / 3 * 3
        for 0 <= int dr < 3
            for 0 <= int dc < 3
                if board[(block_row + dr) * 9 + block_column + dc] == digit
                    valid = false
        if valid
            board[position] = digit
            placements += 1
            if solve(&board, &placements)
                return true
            board[position] = 0
    return false

string[] rows = ["800025000", "070080005", "260400070", "000001900", "010000040", "600200000", "900010000", "700000004", "020000036"]
string puzzle = rows.join("")
int[] board = [for nat i < len(puzzle) then int.parse(puzzle[i])]
int placements = 0
bool solved = solve(&board, &placements)
for 0 <= int r < 9
    string[] fields = [for int digit = board[(r * 9):<(r * 9 + 9)][] then digit.string()]
    print(fields.join(" ") + NL)
print("placements: {placements}{NL}")
