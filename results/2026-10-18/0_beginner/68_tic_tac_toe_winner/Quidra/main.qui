string[][] boards = [["XXX", "OO.", "O.X"], ["X.O", ".X.", "O.."], ["XO.", ".OX", "XO."], ["XOX", "XOO", "OXX"], ["X.O", "XO.", "O.X"], ["XOX", "OXO", "OXX"]]
int[][] lines = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]]
for 0 <= int i < 6
    string flat = boards[i].join("")
    string result = if flat.contains(".") then "in progress" else "draw"
    for int[] line = lines[]
        string mark = flat[line[0]]
        if mark != "." and mark == flat[line[1]] and mark == flat[line[2]]
            result = mark + " wins"
            break
    int number = i + 1
    print("board {number}: {result}{NL}")
