import collections
import text

accesses := "BACBDABEADDCAEB"
string[] cache := []
int hits := 0
int misses := 0
for key := accesses.characters()[]
    status := "hit"
    if .cache.remove(key)
        hits += 1
    else
        misses += 1
        status = "miss"
        if len(cache) == 3
            status += ", evict {.cache.take()}"
    .cache.insert(0, key)
    print.line("{key}: {status} [{cache.join(" ")}]")
print.line("hits: {hits} misses: {misses}")
