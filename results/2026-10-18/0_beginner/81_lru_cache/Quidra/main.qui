string accesses = "BACBDABEADDCAEB"
string[] cache = []
int hits = 0
int misses = 0
for nat i < len(accesses)
    string key = accesses[i]
    bool hit = false
    for string item = cache[]
        if item == key
            hit = true
    string status = "hit"
    if hit
        hits += 1
    else
        misses += 1
        status = "miss"
        if len(cache) == 3
            status += ", evict " + cache[2]
            cache = cache[:<2]
    string[] next = [key]
    for string item = cache[]
        if item != key
            next = next.append(item)
    cache = next
    print("{key}: {status} [{cache.join(" ")}]{NL}")
print("hits: {hits} misses: {misses}{NL}")
