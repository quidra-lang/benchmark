string accesses = "BACBDABEADDCAEB"
string[] cache = []
int hits = 0
int misses = 0
for nat i < len(accesses)
    string key = accesses[i]
    string[] remaining = [for string item = cache[] if item != key then item]
    bool hit = len(remaining) < len(cache)
    string status = "hit"
    if hit
        hits += 1
    else
        misses += 1
        status = "miss"
        if len(cache) == 3
            status += ", evict " + cache[2]
            remaining = remaining[:<2]
    cache = [key].concat(remaining)
    print("{key}: {status} [{cache.join(" ")}]{NL}")
print("hits: {hits} misses: {misses}{NL}")
