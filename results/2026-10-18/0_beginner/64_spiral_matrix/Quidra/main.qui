int[] zero_row = array(6, fill = 0)
int[][] matrix = array(5, fill = zero_row)
int[] dr = [0, 1, 0, -1]
int[] dc = [1, 0, -1, 0]
int row = 0
int column = 0
int direction = 0
for 1 <= int value <= 30
    matrix[row][column] = value
    if value == 30
        break
    int next_row = row + dr[direction]
    int next_column = column + dc[direction]
    if next_row < 0 or next_row >= 5 or next_column < 0 or next_column >= 6 or matrix[next_row][next_column] != 0
        direction = (direction + 1) % 4
        next_row = row + dr[direction]
        next_column = column + dc[direction]
    row = next_row
    column = next_column
for int[] values = matrix[]
    for int value = values[]
        print("{value:int=3}")
    print(NL)
