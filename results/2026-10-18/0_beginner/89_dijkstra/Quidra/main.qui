import collections

string names = "ABCDEFG"
int[][] edges = [
    [0, 1, 7], [0, 2, 3], [0, 3, 9], [1, 2, 2], [2, 4, 6], [1, 3, 3], [3, 4, 4], [3, 5, 5],
    [4, 5, 3], [4, 6, 8], [5, 6, 4],
]
int[][] weights = array(7, fill = array(7, fill = 0))
for int[] edge = edges[]
    weights[edge[0]][edge[1]] = edge[2]
    weights[edge[1]][edge[0]] = edge[2]
int[] distance = array(7, fill = -1)
int[] predecessor = array(7, fill = -1)
bool[] ready = array(7, fill = false)
nat start = 0
distance[start] = 0
ready[start] = true
while true
    auto next = collections.argmin(distance, where = ready)
    match next
        none
            break
        nat selected
            ready[selected] = false
            for int weight = weights[selected][nat vertex]
                int candidate = distance[selected] + weight
                if weight > 0 and (distance[vertex] == -1 or candidate < distance[vertex])
                    distance[vertex] = candidate
                    predecessor[vertex] = int(selected)
                    ready[vertex] = true
for int vertex < 7
    string[] path = []
    int current = vertex
    while current != -1
        .path.push(names[current])
        current = predecessor[current]
    print.line("{names[vertex]}: distance={distance[vertex]} path={path[::-1].join("-")}")
