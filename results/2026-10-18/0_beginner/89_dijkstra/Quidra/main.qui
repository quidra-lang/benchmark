string names = "ABCDEFG"
int[][] edges = [[0, 1, 7], [0, 2, 3], [0, 3, 9], [1, 2, 2], [2, 4, 6], [1, 3, 3], [3, 4, 4], [3, 5, 5], [4, 5, 3], [4, 6, 8], [5, 6, 4]]
int[] zeros = array(7, fill = 0)
int[][] weights = array(7, fill = zeros)
for int[] edge = edges[]
    weights[edge[0]][edge[1]] = edge[2]
    weights[edge[1]][edge[0]] = edge[2]
int[] distance = array(7, fill = -1)
int[] predecessor = array(7, fill = -1)
bool[] done = array(7, fill = false)
distance[0] = 0
for 0 <= int step < 7
    int selected = -1
    for 0 <= int vertex < 7
        if not done[vertex] and distance[vertex] >= 0
            if selected == -1 or distance[vertex] < distance[selected]
                selected = vertex
    done[selected] = true
    for 0 <= int vertex < 7
        if weights[selected][vertex] > 0
            int candidate = distance[selected] + weights[selected][vertex]
            if distance[vertex] == -1 or candidate < distance[vertex]
                distance[vertex] = candidate
                predecessor[vertex] = selected
for 0 <= int vertex < 7
    string[] path = []
    int current = vertex
    while current != -1
        path = path.append(names[current])
        current = predecessor[current]
    string[] ordered = path[::-1]
    print("{names[vertex]}: distance={distance[vertex]} path={ordered.join("-")}{NL}")
