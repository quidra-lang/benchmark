string[] board = [".#......", "..#.....", "###.....", "........", "........", "........", ".....###", "........"]
for 0 <= int generation <= 4
    print("generation {generation}{NL}")
    for string row = board[]
        print(row + NL)
    if generation == 4
        break
    string[] next = []
    for 0 <= int r < 8
        string row = ""
        for 0 <= int c < 8
            int neighbors = 0
            for -1 <= int dr <= 1
                for -1 <= int dc <= 1
                    int nr = r + dr
                    int nc = c + dc
                    if (dr != 0 or dc != 0) and 0 <= nr < 8 and 0 <= nc < 8
                        if board[nr][nc] == "#"
                            neighbors += 1
            bool live = neighbors == 3 or (board[r][c] == "#" and neighbors == 2)
            row += if live then "#" else "."
        next = next.append(row)
    board = next
int alive = 0
for string row = board[]
    for nat c < len(row)
        if row[c] == "#"
            alive += 1
print("alive: {alive}{NL}")
