board := [".#......", "..#.....", "###.....", "........", "........", "........", ".....###", "........"]
for: generation <= 4
    println("generation {generation}")
    for row := board[]
        println(row)
    if generation == 4
        break
    string[] next := []
    for: r < 8
        row := ""
        for: c < 8
            neighbors := 0
            for: -1 <= dr <= 1
                for: -1 <= dc <= 1
                    nr := r + dr
                    nc := c + dc
                    if (dr != 0 or dc != 0) and 0 <= nr < 8 and 0 <= nc < 8
                        if board[nr][nc] == "#"
                            neighbors += 1
            live := neighbors == 3 or (board[r][c] == "#" and neighbors == 2)
            row += if live then "#" else "."
        next = next.append(row)
    board = next
alive := 0
for row := board[]
    for: c < row.len()
        if row[c] == "#"
            alive += 1
println("alive: {alive}")
