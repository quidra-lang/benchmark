int[] values = [52, 17, 38, 9, 61, 38, 24, 45]
int total = 0
for 1 <= int i <= 7
    int value = values[i]
    int j = i - 1
    int shifts = 0
    while j >= 0 and values[j] > value
        values[j + 1] = values[j]
        j -= 1
        shifts += 1
    values[j + 1] = value
    total += shifts
    string[] fields = [for int item = values[] then item.string()]
    print("i={i} shifts={shifts}: {fields.join(" ")}{NL}")
print("total shifts: {total}{NL}")
