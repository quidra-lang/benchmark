int queens(int n, int row, int[] positions, int[] &first)
    if row == n
        if n == 8 and len(first) == 0
            first = positions
        return 1
    int count = 0
    for 0 <= int column < n
        bool valid = true
        for 0 <= int previous < row
            int difference = positions[previous] - column
            if difference == 0 or difference == row - previous or -difference == row - previous
                valid = false
                break
        if valid
            positions[row] = column
            count += queens(n, row + 1, positions, &first)
    return count

int[] first = []
for 4 <= int n <= 8
    int[] positions = array(nat(n), fill = -1)
    int count = queens(n, 0, positions, &first)
    print("N={n}: {count} solutions{NL}")
for int column = first[]
    print(string.repeat(".", nat(column)) + "Q" + string.repeat(".", nat(7 - column)) + NL)
