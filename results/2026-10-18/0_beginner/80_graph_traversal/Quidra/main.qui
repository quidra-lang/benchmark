import collections
import text

void dfs(int vertex, int[][] adjacency, bool[] &visited, int[] &order)
    visited[vertex] = true
    .order.push(vertex)
    for int neighbor = adjacency[vertex][]
        if not visited[neighbor]
            dfs(neighbor, adjacency, &visited, &order)

void show(string label, int[] values)
    print.line("{label}: {text.join(values, " ")}")

(int, int)[] edges = [(5, 0), (3, 8), (7, 2), (1, 6), (0, 2), (5, 3), (7, 5), (6, 4), (8, 7)]
auto adjacency = collections.adjacency_lists(9, edges, undirected = true)
bool[] visited = array(9, fill = false)
int[] order = []
dfs(0, adjacency, &visited, &order)
show("DFS", order)
visited = array(9, fill = false)
visited[0] = true
collections.Queue<int> queue([0])
order = []
while not queue.empty()
    int vertex = .queue.take()
    .order.push(vertex)
    for int neighbor = adjacency[vertex][]
        if not visited[neighbor]
            visited[neighbor] = true
            .queue.push(neighbor)
show("BFS", order)
visited = array(9, fill = false)
int[][] components = []
for int vertex < 9
    if not visited[vertex]
        int[] traversal = []
        dfs(vertex, adjacency, &visited, &traversal)
        .components.push(traversal.sorted())
print.line("components: {len(components)}")
for int[] component = components[nat i]
    show("component {i + 1}", component)
