import collections

string[] operations = [
    "add email 3", "add backup 5", "add deploy 1", "run", "add report 3", "add test 2",
    "add lint 3", "run", "run", "add cleanup 5", "add review 2", "run", "add build 1", "add docs 4",
    "run", "run",
]
collections.PriorityQueue<string, int> queue()
for string operation = operations[]
    string[] fields = operation.split(" ")
    if fields[0] == "add"
        .queue.push(fields[1], int.parse(fields[2]))
    else
        (string name, int priority) = .queue.take()
        print.line("run: {name} (priority {priority})")
string[] remaining = []
while not queue.empty()
    (string name, int priority) = .queue.take()
    .remaining.push(name)
print.line("remaining: {remaining.join(" ")}")
