bool before(int a, int b, int[] priorities)
    return priorities[a] < priorities[b] or (priorities[a] == priorities[b] and a < b)

void push(int value, int[] &heap, int[] priorities)
    heap = heap.append(value)
    int index = int(len(heap)) - 1
    while index > 0
        int parent = (index - 1) / 2
        if not before(heap[index], heap[parent], priorities)
            break
        (heap[index], heap[parent]) = (heap[parent], heap[index])
        index = parent

int pop(int[] &heap, int[] priorities)
    int result = heap[0]
    int last = heap[len(heap) - 1]
    heap = heap[:<len(heap) - 1]
    if len(heap) == 0
        return result
    heap[0] = last
    int index = 0
    while 2 * index + 1 < int(len(heap))
        int child = 2 * index + 1
        if child + 1 < int(len(heap)) and before(heap[child + 1], heap[child], priorities)
            child += 1
        if not before(heap[child], heap[index], priorities)
            break
        (heap[index], heap[child]) = (heap[child], heap[index])
        index = child
    return result

string[] operations = [
    "add email 3", "add backup 5", "add deploy 1", "run", "add report 3", "add test 2",
    "add lint 3", "run", "run", "add cleanup 5", "add review 2", "run", "add build 1", "add docs 4",
    "run", "run",
]
string[] names = []
int[] priorities = []
int[] heap = []
for string operation = operations[]
    string[] fields = operation.split(" ")
    if fields[0] == "add"
        int id = int(len(names))
        names = names.append(fields[1])
        int priority = int.parse(fields[2])
        priorities = priorities.append(priority)
        push(id, &heap, priorities)
    else
        int id = pop(&heap, priorities)
        print("run: {names[id]} (priority {priorities[id]}){NL}")
string[] remaining = []
while len(heap) > 0
    int id = pop(&heap, priorities)
    remaining = remaining.append(names[id])
print("remaining: {remaining.join(" ")}{NL}")
