import collections
import text

prime := array(201, fill = true)
prime[0] = false
prime[1] = false
for: 2 <= p <= 200
    if prime[p]
        for: 2 * p <= multiple <= 200 step p
            prime[multiple] = false
int[] primes := []
for: 2 <= n <= 200
    if prime[n]
        .primes.push(n)
println("count: {primes.len()}")
groups := primes.chunks(10)
for group := groups[]
    println(text.join<int>(group, " "))
