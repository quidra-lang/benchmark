bool[] prime = array(201, fill = true)
prime[0] = false
prime[1] = false
for 2 <= int p <= 200
    if prime[p]
        for 2 * p <= int multiple <= 200 step p
            prime[multiple] = false
int[] primes = []
for 2 <= int n <= 200
    if prime[n]
        primes = primes.append(n)
print("count: {len(primes)}{NL}")
for nat i < len(primes)
    if i % 10 != 0
        print(" ")
    print(primes[i])
    if i % 10 == 9 or i + 1 == len(primes)
        print(NL)
