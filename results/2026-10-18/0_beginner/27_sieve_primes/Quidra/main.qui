import collections
import text

bool[] prime = array(201, fill = true)
prime[0] = false
prime[1] = false
for 2 <= int p <= 200
    if prime[p]
        for 2 * p <= int multiple <= 200 step p
            prime[multiple] = false
int[] primes = []
for 2 <= int n <= 200
    if prime[n]
        primes = primes.append(n)
print.line("count: {len(primes)}")
int[][] groups = primes.chunks(10)
for int[] group = groups[]
    print.line(text.join(group, " "))
