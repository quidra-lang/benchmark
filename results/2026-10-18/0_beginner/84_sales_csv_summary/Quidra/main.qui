import collections

string[] csv = [
    "date,region,product,quantity,unit_price",
    "2026-04-01,north,notebook,10,200",
    "2026-04-01,east,marker,6,150",
    "2026-04-01,south,eraser,25,80",
    "2026-04-02,west,stapler,4,600",
    "2026-04-02,north,marker,8,150",
    "2026-04-02,east,notebook,9,200",
    "2026-04-03,south,stapler,3,600",
    "2026-04-03,west,eraser,15,80",
    "2026-04-03,north,eraser,20,80",
    "2026-04-04,east,stapler,5,600",
    "2026-04-04,south,notebook,6,200",
    "2026-04-04,west,marker,8,150",
]
map<string, int> regional
map<string, int> product_quantities
map<string, int> daily
int total = 0
for string row = csv[1:][]
    string[] fields = row.split(",")
    int quantity = int.parse(fields[3])
    int price = int.parse(fields[4])
    int amount = quantity * price
    total += amount
    .regional.increment(fields[1], by = amount)
    .product_quantities.increment(fields[2], by = quantity)
    .daily.increment(fields[0], by = amount)
print.line("total: {total}")
auto regions = collections.entries(regional).sorted(by = (regional.values(), regional.keys()), descending = (true, false))
for (string region, int revenue) = regions[]
    print.line("{region}: {revenue}")
auto products = collections.entries(product_quantities).sorted(by = product_quantities.keys())
for (string product, int quantity) = products[]
    print.line("{product}: {quantity}")
auto days = collections.entries(daily).sorted(by = (daily.values(), daily.keys()), descending = (true, false))
(string day, int best) = days[0]
print.line("best day: {day} ({best})")
