string paragraph = "Good software is written for people first and for machines second. A clear program explains its purpose through careful names, small functions and honest tests. When a team agrees on shared rules for internationalization, documentation and code review, every newcomer can read the code quickly, change it safely and ship new improvements with confidence instead of fear, week after week."
string[] words = paragraph.split(" ")
string[][] lines = []
string[] current = []
int length = 0
for string word = words[]
    int candidate = length + int(len(word)) + (if len(current) > 0 then 1 else 0)
    if candidate > 30
        lines = lines.append(current)
        current = []
        length = 0
    if len(current) > 0
        length += 1
    current = current.append(word)
    length += int(len(word))
if len(current) > 0
    lines = lines.append(current)
for nat index < len(lines)
    string[] line = lines[index]
    string result = ""
    if index + 1 == len(lines) or len(line) == 1
        result = line.join(" ")
        result += string.repeat(" ", nat(30 - int(len(result))))
    else
        int letters = 0
        for string word = line[]
            letters += int(len(word))
        int gaps = int(len(line)) - 1
        int spaces = 30 - letters
        int base = spaces / gaps
        int extra = spaces % gaps
        for 0 <= int i < int(len(line))
            if i > 0
                int count = base + (if i <= extra then 1 else 0)
                result += string.repeat(" ", nat(count))
            result += line[i]
    print("|{result}|{NL}")
