import math

(string, string)[] pairs := [
    ("kitten", "sitting"),
    ("flaw", "lawn"),
    ("listen", "silent"),
    ("intention", "execution"),
    ("algorithm", "altruistic"),
]
for (a, b) := pairs[]
    rows := int(len(a))
    columns := int(len(b))
    dp := [for i := (0:rows)[] then [i].concat(array(nat(columns), fill = 0))]
    dp[0] = (0:columns)
    for: 1 <= i <= rows
        for: 1 <= j <= columns
            cost := if a[i - 1] == b[j - 1] then 0 else 1
            dp[i][j] = [dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost].min_all()
    println("{a} -> {b}: {dp[rows][columns]}")
