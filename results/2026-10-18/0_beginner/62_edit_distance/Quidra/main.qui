string[][] pairs = [["kitten", "sitting"], ["flaw", "lawn"], ["listen", "silent"], ["intention", "execution"], ["algorithm", "altruistic"]]
for string[] pair = pairs[]
    string a = pair[0]
    string b = pair[1]
    int rows = int(len(a))
    int columns = int(len(b))
    int[] zero_row = array(nat(columns + 1), fill = 0)
    int[][] dp = array(nat(rows + 1), fill = zero_row)
    for 0 <= int i <= rows
        dp[i][0] = i
    for 0 <= int j <= columns
        dp[0][j] = j
    for 1 <= int i <= rows
        for 1 <= int j <= columns
            int cost = if a[i - 1] == b[j - 1] then 0 else 1
            int best = dp[i - 1][j] + 1
            if dp[i][j - 1] + 1 < best
                best = dp[i][j - 1] + 1
            if dp[i - 1][j - 1] + cost < best
                best = dp[i - 1][j - 1] + cost
            dp[i][j] = best
    print("{a} -> {b}: {dp[rows][columns]}{NL}")
