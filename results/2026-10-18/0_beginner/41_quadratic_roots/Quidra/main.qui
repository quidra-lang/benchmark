import math

(int, int, int)[] coefficients := [(1, -3, -10), (-2, 5, 4), (3, 1, -2), (4, -12, 9), (1, 2, 5), (-2, 3, -4)]
for (a, b, c) := coefficients[]
    d := b * b - 4 * a * c
    denominator := real64(2 * a)
    numerator := real64(-b)
    print("{a} {b} {c}: ")
    if d > 0
        root := math.sqrt(real64(d))
        first := (numerator + root) / denominator
        second := (numerator - root) / denominator
        if first < second
            (first, second) = (second, first)
        println("x1 = {first:frac=4}, x2 = {second:frac=4}")
    elif d == 0
        root := numerator / denominator
        println("x = {root:frac=4}")
    else
        real_text := "{numerator / denominator:frac=4}"
        imaginary_root := math.sqrt(real64(-d))
        imaginary_text := "{imaginary_root / math.abs(denominator):frac=4}"
        println("x = {real_text} + {imaginary_text}i, {real_text} - {imaginary_text}i")
