import math

string fixed(real64 value, int places)
    int scale = 10 ^ places
    int rounded = math.round(value * real64(scale))
    string sign = ""
    if rounded < 0
        sign = "-"
        rounded = -rounded
    int whole = rounded / scale
    int fraction = rounded % scale
    string tail = fraction.string()
    return sign + whole.string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

int[][] coefficients = [[1, -3, -10], [-2, 5, 4], [3, 1, -2], [4, -12, 9], [1, 2, 5], [-2, 3, -4]]
for int[] row = coefficients[]
    int a = row[0]
    int b = row[1]
    int c = row[2]
    int d = b * b - 4 * a * c
    real64 denominator = real64(2 * a)
    print("{a} {b} {c}: ")
    if d > 0
        real64 root = math.sqrt(real64(d))
        real64 first = (real64(-b) + root) / denominator
        real64 second = (real64(-b) - root) / denominator
        if first < second
            (first, second) = (second, first)
        print("x1 = {fixed(first, 4)}, x2 = {fixed(second, 4)}{NL}")
    elif d == 0
        real64 root = real64(-b) / denominator
        print("x = {fixed(root, 4)}{NL}")
    else
        int magnitude = if a < 0 then -a else a
        real64 p = real64(-b) / denominator
        real64 imaginary = math.sqrt(real64(-d)) / real64(2 * magnitude)
        string real_text = fixed(p, 4)
        string imaginary_text = fixed(imaginary, 4)
        print("x = {real_text} + {imaginary_text}i, {real_text} - {imaginary_text}i{NL}")
