import math

(int, int, int)[] coefficients := [(1, -3, -10), (-2, 5, 4), (3, 1, -2), (4, -12, 9), (1, 2, 5), (-2, 3, -4)]
for (int a, int b, int c) := coefficients[]
    int d := b * b - 4 * a * c
    real64 denominator := real64(2 * a)
    real64 numerator := real64(-b)
    print("{a} {b} {c}: ")
    if d > 0
        real64 root := math.sqrt(real64(d))
        real64 first := (numerator + root) / denominator
        real64 second := (numerator - root) / denominator
        if first < second
            (first, second) = (second, first)
        print.line("x1 = {first:frac=4}, x2 = {second:frac=4}")
    elif d == 0
        real64 root := numerator / denominator
        print.line("x = {root:frac=4}")
    else
        string real_text := "{numerator / denominator:frac=4}"
        real64 imaginary_root := math.sqrt(real64(-d))
        string imaginary_text := "{imaginary_root / math.abs(denominator):frac=4}"
        print.line("x = {real_text} + {imaginary_text}i, {real_text} - {imaginary_text}i")
