int[] values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
string[] symbols = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
string alphabet = "IVXLCDM"
int[] single_values = [1, 5, 10, 50, 100, 500, 1000]
int[] numbers = [9, 14, 49, 94, 444, 1994, 2768, 3999]
for int number = numbers[]
    int remaining = number
    string roman = ""
    for 0 <= int i < 13
        while remaining >= values[i]
            roman += symbols[i]
            remaining -= values[i]
    int decoded = 0
    for nat i < len(roman)
        int current = 0
        int next = 0
        match alphabet.find(roman[i])
            nat position
                current = single_values[position]
            none
                continue
        if i + 1 < len(roman)
            match alphabet.find(roman[i + 1])
                nat position
                    next = single_values[position]
                none
                    continue
        decoded += if current < next then -current else current
    print("{number} -> {roman} -> {decoded}{NL}")
