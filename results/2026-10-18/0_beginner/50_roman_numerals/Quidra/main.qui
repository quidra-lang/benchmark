import collections

int[] values := [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
symbols := ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
letters := "IVXLCDM".codepoints()
int[] single_values := [1, 5, 10, 50, 100, 500, 1000]
int[] numbers := [9, 14, 49, 94, 444, 1994, 2768, 3999]
for number := numbers[]
    remaining := number
    roman := ""
    for int i < 13
        while remaining >= values[i]
            roman += symbols[i]
            remaining -= values[i]
    int decoded := 0
    int next := 0
    for len(roman) >= nat i > 0
        position := letters.index(roman[i - 1].codepoints()[0])
        current := single_values[position]
        decoded += if current < next then -current else current
        next = current
    println("{number} -> {roman} -> {decoded}")
