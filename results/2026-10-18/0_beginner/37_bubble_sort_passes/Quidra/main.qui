import text

int[] values := [27, 64, 13, 88, 41, 5, 72, 36]
int swaps := 0
for 1 <= int pass <= 7
    bool changed := false
    for int j <= 7 - pass
        if values[j] > values[j + 1]
            (values[j], values[j + 1]) = (values[j + 1], values[j])
            swaps += 1
            changed = true
    print.line("pass {pass}: {text.join(values, " ")}")
    if not changed
        break
print.line("swaps: {swaps}")
