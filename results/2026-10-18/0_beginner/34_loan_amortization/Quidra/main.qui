int balance = 1000000
int month = 0
int total_interest = 0
int total_paid = 0
while balance > 0
    month += 1
    int interest = balance / 100
    int payment = if balance + interest < 50000 then balance + interest else 50000
    int principal = payment - interest
    balance -= principal
    total_interest += interest
    total_paid += payment
    print("month {month}: interest={interest} principal={principal} balance={balance}{NL}")
print("total interest: {total_interest}{NL}total paid: {total_paid}{NL}")
