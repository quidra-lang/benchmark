import math

int balance := 1000000
int month := 0
int total_interest := 0
int total_paid := 0
while balance > 0
    month += 1
    interest := balance / 100
    payment := math.min(balance + interest, 50000)
    principal := payment - interest
    balance -= principal
    total_interest += interest
    total_paid += payment
    print.line("month {month}: interest={interest} principal={principal} balance={balance}")
print.line("total interest: {total_interest}{NL}total paid: {total_paid}")
