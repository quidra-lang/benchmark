int[][] polygon = [[1, 1], [11, 2], [13, 9], [9, 7], [7, 12], [5, 6], [2, 10], [3, 5]]
int[][] points = [[4, 8], [6, 4], [10, 8], [7, 11], [14, 3], [12, 8]]
for int[] point = points[]
    int px = point[0]
    int py = point[1]
    int crossings = 0
    for 0 <= int i < 8
        int j = (i + 1) % 8
        int x1 = polygon[i][0]
        int y1 = polygon[i][1]
        int x2 = polygon[j][0]
        int y2 = polygon[j][1]
        if (y1 > py) != (y2 > py)
            real64 intersection = real64(x1) + real64(x2 - x1) * real64(py - y1) / real64(y2 - y1)
            if intersection > real64(px)
                crossings += 1
    string result = if crossings % 2 == 1 then "inside" else "outside"
    print("({px}, {py}): {result}{NL}")
