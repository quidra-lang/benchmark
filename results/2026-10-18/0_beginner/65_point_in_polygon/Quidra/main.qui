(int, int)[] polygon := [(1, 1), (11, 2), (13, 9), (9, 7), (7, 12), (5, 6), (2, 10), (3, 5)]
(int, int)[] points := [(4, 8), (6, 4), (10, 8), (7, 11), (14, 3), (12, 8)]
for (px, py) := points[]
    point_x := real64(px)
    int crossings := 0
    for (x1, y1) := polygon[nat i]
        (int x2, int y2) := polygon[(i + 1) % len(polygon)]
        if (y1 > py) != (y2 > py)
            intersection := real64(x2 - x1)
            intersection *= real64(py - y1)
            intersection /= real64(y2 - y1)
            intersection += real64(x1)
            if intersection > point_x
                crossings += 1
    result := if crossings % 2 == 1 then "inside" else "outside"
    print.line("({px}, {py}): {result}")
