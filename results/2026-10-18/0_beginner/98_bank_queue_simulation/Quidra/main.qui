import math

state := 42
arrival := 0
free := [0, 0]
total_wait := 0
maximum_wait := 0
for: 1 <= customer <= 20
    state = state * 48271 % 2147483647
    arrival += state % 5 + 1
    state = state * 48271 % 2147483647
    service := state % 7 + 2
    int teller := if free[0] <= free[1] then 0 else 1
    start := math.max(arrival, free[teller])
    end := start + service
    wait := start - arrival
    free[teller] = end
    total_wait += wait
    maximum_wait = math.max(maximum_wait, wait)
    number := teller + 1
    println("customer {customer}: arrive={arrival} start={start} end={end} teller={number} wait={wait}")
average := real(total_wait) / 20.0
departure := math.max(free[0], free[1])
println("average wait: {average:frac=2}{NL}max wait: {maximum_wait}{NL}last departure: {departure}")
