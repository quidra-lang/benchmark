int state = 42
int arrival = 0
int[] free = [0, 0]
int total_wait = 0
int maximum_wait = 0
for 1 <= int customer <= 20
    state = state * 48271 % 2147483647
    arrival += state % 5 + 1
    state = state * 48271 % 2147483647
    int service = state % 7 + 2
    int teller = if free[0] <= free[1] then 0 else 1
    int start = if arrival > free[teller] then arrival else free[teller]
    int end = start + service
    int wait = start - arrival
    free[teller] = end
    total_wait += wait
    if wait > maximum_wait
        maximum_wait = wait
    int number = teller + 1
    print("customer {customer}: arrive={arrival} start={start} end={end} teller={number} wait={wait}{NL}")
real average = real(total_wait) / 20.0
int departure = if free[0] > free[1] then free[0] else free[1]
print("average wait: {average:frac=2}{NL}max wait: {maximum_wait}{NL}last departure: {departure}{NL}")
