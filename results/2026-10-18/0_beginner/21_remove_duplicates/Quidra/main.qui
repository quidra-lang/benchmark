int[] values = [12, 5, 12, 8, 3, 5, 20, 8, 8, 15, 3, 7, 20, 12, 9]
set.Set<int> seen = set.Set<int>()
for int value = values[]
    .seen.add(value)
int[] unique = seen.values()
string[] fields = [for int value = unique[] then value.string()]
int removed = int(len(values)) - int(len(unique))
print("{fields.join(" ")}{NL}removed: {removed}{NL}")
