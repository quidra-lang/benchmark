int index_of(string name, string[] names)
    for 0 <= int i < int(len(names))
        if names[i] == name
            return i
    return -1

void topology(string[] names, string[][] edges, bool show_cycle)
    string[] ordered = names.sorted()
    int n = int(len(ordered))
    int[] indegree = array(nat(n), fill = 0)
    for string[] edge = edges[]
        indegree[index_of(edge[1], ordered)] += 1
    bool[] taken = array(nat(n), fill = false)
    string[] result = []
    while true
        int selected = -1
        for 0 <= int i < n
            if not taken[i] and indegree[i] == 0
                selected = i
                break
        if selected == -1
            break
        taken[selected] = true
        result = result.append(ordered[selected])
        for string[] edge = edges[]
            if edge[0] == ordered[selected]
                indegree[index_of(edge[1], ordered)] -= 1
    print("order: {result.join(" -> ")}{NL}")
    if show_cycle
        string[] remaining = []
        for 0 <= int i < n
            if not taken[i]
                remaining = remaining.append(ordered[i])
        print("cycle: {remaining.join(" ")}{NL}")

string[] first = ["physics", "algebra", "graphics", "programming", "statistics", "calculus", "databases", "algorithms"]
string[][] first_edges = [["calculus", "physics"], ["algebra", "calculus"], ["programming", "algorithms"], ["algebra", "statistics"], ["algorithms", "databases"], ["statistics", "databases"], ["calculus", "graphics"], ["algorithms", "graphics"], ["physics", "graphics"]]
topology(first, first_edges, false)
string[] second = ["music", "ecology", "art", "geology", "biology", "chemistry"]
string[][] second_edges = [["music", "art"], ["art", "ecology"], ["biology", "chemistry"], ["chemistry", "ecology"], ["ecology", "geology"], ["geology", "chemistry"]]
topology(second, second_edges, true)
