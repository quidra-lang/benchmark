import collections

void topology(string[] names, string[][] edges, bool show_cycle)
    string[] ordered = names.sorted()
    nat n = len(ordered)
    int[] indegree = array(n, fill = 0)
    for string[] edge = edges[]
        nat target = ordered.index(edge[1])
        indegree[target] += 1
    bool[] taken = array(n, fill = false)
    string[] result = []
    while true
        nat selected = n
        for nat i < n
            if not taken[i] and indegree[i] == 0
                selected = i
                break
        if selected == n
            break
        taken[selected] = true
        .result.push(ordered[selected])
        for string[] edge = edges[]
            if edge[0] == ordered[selected]
                nat target = ordered.index(edge[1])
                indegree[target] -= 1
    print.line("order: {result.join(" -> ")}")
    if show_cycle
        string[] remaining = [for nat i = ordered.indices()[] if not taken[i] then ordered[i]]
        print.line("cycle: {remaining.join(" ")}")

string[] first = ["physics", "algebra", "graphics", "programming", "statistics", "calculus", "databases", "algorithms"]
string[][] first_edges = [
    ["calculus", "physics"], ["algebra", "calculus"], ["programming", "algorithms"],
    ["algebra", "statistics"], ["algorithms", "databases"], ["statistics", "databases"],
    ["calculus", "graphics"], ["algorithms", "graphics"], ["physics", "graphics"],
]
topology(first, first_edges, false)
string[] second = ["music", "ecology", "art", "geology", "biology", "chemistry"]
string[][] second_edges = [
    ["music", "art"], ["art", "ecology"], ["biology", "chemistry"], ["chemistry", "ecology"],
    ["ecology", "geology"], ["geology", "chemistry"],
]
topology(second, second_edges, true)
