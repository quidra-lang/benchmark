int gcd(int a, int b)
    while b != 0
        int remainder = a % b
        a = b
        b = remainder
    return a

int[][] pairs = [[48, 180], [1071, 462], [7, 91], [13, 97], [36288, 98280]]
for int[] pair = pairs[]
    int a = pair[0]
    int b = pair[1]
    int divisor = gcd(a, b)
    int multiple = (a / divisor) * b
    print("gcd({a}, {b}) = {divisor}, lcm({a}, {b}) = {multiple}{NL}")
