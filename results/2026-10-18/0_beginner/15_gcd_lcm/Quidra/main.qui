int gcd(int a, int b)
    while b != 0
        (a, b) = (b, a % b)
    return a

(int, int)[] pairs := [(48, 180), (1071, 462), (7, 91), (13, 97), (36288, 98280)]
for (int a, int b) := pairs[]
    int divisor := gcd(a, b)
    int multiple := (a / divisor) * b
    print.line("gcd({a}, {b}) = {divisor}, lcm({a}, {b}) = {multiple}")
