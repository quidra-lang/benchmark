string[] inputs = [
    "(a + b) * [c - d]", "{{x = [1, 2, (3 + 4)]}}", "f(a[i] + g(b)}}", "(1 + 2)) * 3",
    "if (a < b) {{ c = d[0]; }}", "((a + b] * c", "[{{(x * y) - z}}",
]
string openings = "([{{"
string closings = ")]}}"
for string text = inputs[]
    string stack = ""
    int failure = -1
    for nat i < len(text)
        string character = text[i]
        if openings.contains(character)
            stack += character
        else
            match closings.find(character)
                nat position
                    if len(stack) == 0 or stack[len(stack) - 1] != openings[position]
                        failure = int(i)
                        break
                    stack = stack[:<len(stack) - 1]
                none
                    continue
    if failure == -1 and len(stack) > 0
        failure = int(len(text))
    if failure == -1
        print("{text} -> balanced{NL}")
    else
        print("{text} -> error at index {failure}{NL}")
