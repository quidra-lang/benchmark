import math

names := ["Tanaka", "Suzuki", "Yamada", "Ito", "Kato", "Mori"]
int[][] scores := [[78, 85, 94], [88, 74, 82], [65, 90, 71], [80, 79, 85], [92, 88, 95], [70, 62, 78]]
totals := [for row := scores[] then row.sum()]
order := names.indices().sorted(by = (totals, names), descending = (true, false))
int previous := -1
nat rank := 0
for best := order[nat position]
    if totals[best] != previous
        rank = position + 1
    previous = totals[best]
    average := real(totals[best]) / 3.0
    println("{rank}. {names[best]} total={totals[best]} average={average:frac=2}")
