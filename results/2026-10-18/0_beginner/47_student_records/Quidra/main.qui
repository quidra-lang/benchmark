import math

string fixed(real64 value, int places)
    int scale = 10 ^ places
    int rounded = math.round(value * real64(scale))
    string sign = ""
    if rounded < 0
        sign = "-"
        rounded = -rounded
    int whole = rounded / scale
    int fraction = rounded % scale
    string tail = fraction.string()
    return sign + whole.string() + "." + string.repeat("0", nat(places - int(len(tail)))) + tail

string[] names = ["Tanaka", "Suzuki", "Yamada", "Ito", "Kato", "Mori"]
int[][] scores = [[78, 85, 94], [88, 74, 82], [65, 90, 71], [80, 79, 85], [92, 88, 95], [70, 62, 78]]
int[] totals = array(6, fill = 0)
for 0 <= int i < 6
    for int score = scores[i][]
        totals[i] += score
string[] alphabetic = names.sorted()
bool[] used = array(6, fill = false)
int previous = -1
int rank = 0
for 0 <= int position < 6
    int best = -1
    for string name = alphabetic[]
        for 0 <= int i < 6
            if names[i] == name and not used[i]
                if best == -1 or totals[i] > totals[best]
                    best = i
    used[best] = true
    if totals[best] != previous
        rank = position + 1
    previous = totals[best]
    real64 average = real64(totals[best]) / 3.0
    print("{rank}. {names[best]} total={totals[best]} average={fixed(average, 2)}{NL}")
