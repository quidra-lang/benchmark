import math

string[] names = ["Tanaka", "Suzuki", "Yamada", "Ito", "Kato", "Mori"]
int[][] scores = [[78, 85, 94], [88, 74, 82], [65, 90, 71], [80, 79, 85], [92, 88, 95], [70, 62, 78]]
int[] totals = [for int[] row = scores[] then row.sum()]
string[] alphabetic = names.sorted()
bool[] used = array(6, fill = false)
int previous = -1
int rank = 0
for 0 <= int position < 6
    int best = -1
    for string name = alphabetic[]
        for 0 <= int i < 6
            if names[i] == name and not used[i]
                if best == -1 or totals[i] > totals[best]
                    best = i
    used[best] = true
    if totals[best] != previous
        rank = position + 1
    previous = totals[best]
    real average = real(totals[best]) / 3.0
    print("{rank}. {names[best]} total={totals[best]} average={average:frac=2}{NL}")
