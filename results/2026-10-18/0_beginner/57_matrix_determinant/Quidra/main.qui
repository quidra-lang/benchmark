int determinant(int[][] matrix)
    int n = int(len(matrix))
    if n == 1
        return matrix[0][0]
    int total = 0
    for 0 <= int j < n
        int[][] minor = []
        for 1 <= int r < n
            int[] row = []
            for 0 <= int c < n
                if c != j
                    row = row.append(matrix[r][c])
            minor = minor.append(row)
        int term = matrix[0][j] * determinant(minor)
        total += if j % 2 == 0 then term else -term
    return total

int[][][] matrices = [[[2, -3, 1], [5, 4, -2], [-1, 6, 3]], [[3, 0, -2, 5], [1, 4, 7, -3], [-6, 2, 1, 8], [9, -5, 3, 2]], [[4, -1, 7, 0, -3], [2, 8, -5, 6, 1], [-9, 3, 2, -4, 5], [6, 0, -7, 3, -2], [1, -6, 4, 9, 8]]]
for int[][] matrix = matrices[]
    nat n = len(matrix)
    print("det({n}x{n}) = {determinant(matrix)}{NL}")
