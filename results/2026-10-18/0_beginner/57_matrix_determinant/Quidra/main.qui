int determinant(int[][] matrix)
    n := len(matrix)
    if n == 1
        return matrix[0][0]
    total := 0
    for: nat j < n
        minor := [for row := matrix[1:][] then [for c := row.indices()[] if c != j then row[c]]]
        term := matrix[0][j] * determinant(minor)
        total += if j % 2 == 0 then term else -term
    return total

int[][][] matrices := [
    [[2, -3, 1], [5, 4, -2], [-1, 6, 3]],
    [[3, 0, -2, 5], [1, 4, 7, -3], [-6, 2, 1, 8], [9, -5, 3, 2]],
    [[4, -1, 7, 0, -3], [2, 8, -5, 6, 1], [-9, 3, 2, -4, 5], [6, 0, -7, 3, -2], [1, -6, 4, 9, 8]],
]
for matrix := matrices[]
    n := len(matrix)
    println("det({n}x{n}) = {determinant(matrix)}")
