int hex_digit(string character)
    string alphabet = "0123456789abcdefABCDEF"
    match alphabet.find(character)
        nat position
            return if position < 16 then int(position) else int(position) - 6
        none
            return 0

string decode(string text)
    string result = ""
    int i = 0
    while i < int(len(text))
        if text[i] == "+"
            result += " "
            i += 1
        elif text[i] == "%"
            int value = hex_digit(text[i + 1]) * 16 + hex_digit(text[i + 2])
            nat8[] byte = [nat8(value)]
            string character = string.from_utf8(bin(byte))
            result += character
            i += 3
        else
            result += text[i]
            i += 1
    return result

string[] queries = ["name=Alice+Smith&age=30&city=New%20York", "q=c%2B%2B+tutorial&page=2&sort=desc&page=3", "msg=50%25+off%21&debug&lang=en&ref=&lang=ja", "redirect=https%3a%2f%2fexample.com%2Fhome&token=abc==&item10=pen&item2=fish%26chips"]
for 0 <= int index < 4
    string[] keys = []
    string[] values = []
    set.Set<string> distinct = set.Set<string>()
    string[] items = queries[index].split("&")
    for string item = items[]
        string key = item
        string value = ""
        match item.find("=")
            nat separator
                key = item[:<separator]
                value = item[(separator + 1):]
            none
                value = ""
        key = decode(key)
        value = decode(value)
        keys = keys.append(key)
        values = values.append(value)
        .distinct.add(key)
    int number = index + 1
    print("query {number}:{NL}")
    string[] ordered = distinct.values().sorted()
    for string key = ordered[]
        string[] quoted = []
        for nat i < len(keys)
            if keys[i] == key
                quoted = quoted.append(DQ + values[i] + DQ)
        print("  {key}: {quoted.join(", ")}{NL}")
