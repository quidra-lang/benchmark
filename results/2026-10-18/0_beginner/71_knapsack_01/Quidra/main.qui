import math

string[] names = ["tent", "stove", "lantern", "rope", "camera", "blanket", "water"]
int[] weights = [10, 3, 2, 3, 5, 5, 6]
int[] values = [120, 65, 45, 20, 90, 85, 100]
int[][] dp = array(8, fill = array(21, fill = 0))
for 1 <= int i <= 7
    for 0 <= int capacity <= 20
        dp[i][capacity] = dp[i - 1][capacity]
        if weights[i - 1] <= capacity
            int candidate = dp[i - 1][capacity - weights[i - 1]] + values[i - 1]
            if candidate > dp[i][capacity]
                dp[i][capacity] = candidate
bool[] chosen = array(7, fill = false)
int capacity = 20
for 7 >= int i >= 1
    if dp[i][capacity] != dp[i - 1][capacity]
        chosen[i - 1] = true
        capacity -= weights[i - 1]
int total_weight = weights[chosen].sum()
string[] items = names[chosen]
print("max value: {dp[7][20]}{NL}total weight: {total_weight}{NL}items: {items.join(" ")}{NL}")
