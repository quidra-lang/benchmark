int index_of(string name, string[] names)
    for 0 <= int i < int(len(names))
        if names[i] == name
            return i
    return -1

bool better(int a, int b, int[] points, int[] goals_for, int[] goals_against)
    if points[a] != points[b]
        return points[a] > points[b]
    int first = goals_for[a] - goals_against[a]
    int second = goals_for[b] - goals_against[b]
    if first != second
        return first > second
    return goals_for[a] > goals_for[b]

string[] names = ["Lions", "Tigers", "Eagles", "Sharks", "Wolves", "Bears"]
names = names.sorted()
string[] matches = [
    "Lions 0-3 Bears", "Tigers 2-2 Wolves", "Eagles 4-0 Sharks", "Bears 0-1 Sharks",
    "Wolves 2-1 Eagles", "Lions 0-1 Tigers", "Tigers 3-3 Bears", "Eagles 2-2 Lions",
    "Sharks 2-2 Wolves", "Bears 3-1 Wolves", "Lions 2-0 Sharks", "Tigers 2-1 Eagles",
    "Eagles 1-0 Bears", "Sharks 2-0 Tigers", "Wolves 2-1 Lions",
]
int[] played = array(6, fill = 0)
int[] wins = array(6, fill = 0)
int[] draws = array(6, fill = 0)
int[] losses = array(6, fill = 0)
int[] goals_for = array(6, fill = 0)
int[] goals_against = array(6, fill = 0)
int[] points = array(6, fill = 0)
for string match_text = matches[]
    string[] fields = match_text.split(" ")
    int home = index_of(fields[0], names)
    int away = index_of(fields[2], names)
    string[] score = fields[1].split("-")
    int first = int.parse(score[0])
    int second = int.parse(score[1])
    played[home] += 1
    played[away] += 1
    goals_for[home] += first
    goals_against[home] += second
    goals_for[away] += second
    goals_against[away] += first
    if first == second
        draws[home] += 1
        draws[away] += 1
        points[home] += 1
        points[away] += 1
    elif first > second
        wins[home] += 1
        losses[away] += 1
        points[home] += 3
    else
        wins[away] += 1
        losses[home] += 1
        points[away] += 3
bool[] used = array(6, fill = false)
for 1 <= int position <= 6
    int best = -1
    for 0 <= int i < 6
        if not used[i]
            if best == -1 or better(i, best, points, goals_for, goals_against)
                best = i
    used[best] = true
    int difference = goals_for[best] - goals_against[best]
    string gd = if difference > 0 then "+" + difference.string() else difference.string()
    print("{position}. {names[best]} P={played[best]} W={wins[best]} D={draws[best]} L={losses[best]} GF={goals_for[best]} GA={goals_against[best]} GD={gd} Pts={points[best]}{NL}")
