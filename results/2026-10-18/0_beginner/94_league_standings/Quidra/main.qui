import collections

class Team(string name)
    int wins := 0
    int draws := 0
    int losses := 0
    int scored := 0
    int conceded := 0

    int points()
        return 3 * wins + draws

    int difference()
        return scored - conceded

    void .record(int goals, int against)
        scored += goals
        conceded += against
        if goals == against
            draws += 1
        elif goals > against
            wins += 1
        else
            losses += 1

string[] names := ["Lions", "Tigers", "Eagles", "Sharks", "Wolves", "Bears"]
string[] matches := [
    "Lions 0-3 Bears",
    "Tigers 2-2 Wolves",
    "Eagles 4-0 Sharks",
    "Bears 0-1 Sharks",
    "Wolves 2-1 Eagles",
    "Lions 0-1 Tigers",
    "Tigers 3-3 Bears",
    "Eagles 2-2 Lions",
    "Sharks 2-2 Wolves",
    "Bears 3-1 Wolves",
    "Lions 2-0 Sharks",
    "Tigers 2-1 Eagles",
    "Eagles 1-0 Bears",
    "Sharks 2-0 Tigers",
    "Wolves 2-1 Lions",
]
Team[] teams := [for string name := names[] then Team(name)]
for string match_text := matches[]
    string[] fields := match_text.split(" ")
    nat home := names.index(fields[0])
    nat away := names.index(fields[2])
    string[] score := fields[1].split("-")
    int first := int.parse(score[0])
    int second := int.parse(score[1])
    .teams[home].record(first, second)
    .teams[away].record(second, first)
points := [for Team team := teams[] then team.points()]
differences := [for Team team := teams[] then team.difference()]
goals := [for Team team := teams[] then team.scored]
teams = teams.sorted(by = (points, differences, goals, names), descending = (true, true, true, false))
for Team team := teams[nat position]
    int played := team.wins + team.draws + team.losses
    int difference := team.difference()
    string gd := if difference > 0 then "+{difference}" else difference.string()
    print.line("{position + 1}. {team.name} P={played} W={team.wins} D={team.draws} L={team.losses} GF={team.scored} GA={team.conceded} GD={gd} Pts={team.points()}")
