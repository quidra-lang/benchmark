string encode(string text)
    string result = ""
    int i = 0
    while i < int(len(text))
        int end = i + 1
        while end < int(len(text)) and text[end] == text[i]
            end += 1
        int count = end - i
        result += count.string() + text[i]
        i = end
    return result

string decode(string encoded)
    string result = ""
    int i = 0
    while i < int(len(encoded))
        int count = 0
        while i < int(len(encoded)) and "0123456789".contains(encoded[i])
            int digit = int.parse(encoded[i])
            count = count * 10 + digit
            i += 1
        result += string.repeat(encoded[i], nat(count))
        i += 1
    return result

string[] values = ["AAABBBCCCD", "WWWWWWWWWWWWBWWWWWWWWWWWWBBB", "ALGORITHM", "MISSISSIPPI", "XXXXXXXXXXYYYYYYYYYYYYYYYYYYYYYZ"]
for string value = values[]
    string encoded = encode(value)
    print("{value} -> {encoded} -> {decode(encoded)}{NL}")
