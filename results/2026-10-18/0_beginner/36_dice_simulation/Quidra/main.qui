int state = 12345
int[] counts = array(13, fill = 0)
for 0 <= int trial < 1000
    state = state * 48271 % 2147483647
    int first = state % 6 + 1
    state = state * 48271 % 2147483647
    int second = state % 6 + 1
    counts[first + second] += 1
int most = 2
for 2 <= int sum <= 12
    print("{sum}: {counts[sum]}{NL}")
    if counts[sum] > counts[most]
        most = sum
print("most frequent: {most}{NL}")
