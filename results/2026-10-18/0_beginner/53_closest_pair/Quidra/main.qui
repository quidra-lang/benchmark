import math

int[][] points = [[12, -7], [-33, 25], [41, 18], [-8, -44], [27, 39], [-46, -12], [5, 14], [36, -29], [-19, 47], [-2, 3]]
int minimum = -1
int maximum = -1
int near_i = 0
int near_j = 1
int far_i = 0
int far_j = 1
for 0 <= int i < 10
    for i + 1 <= int j < 10
        int dx = points[i][0] - points[j][0]
        int dy = points[i][1] - points[j][1]
        int squared = dx * dx + dy * dy
        if minimum == -1 or squared < minimum
            minimum = squared
            near_i = i
            near_j = j
        if squared > maximum
            maximum = squared
            far_i = i
            far_j = j
real64 near_distance = math.sqrt(real64(minimum))
real64 far_distance = math.sqrt(real64(maximum))
print("closest: P{near_i} P{near_j} {near_distance:frac=4}{NL}farthest: P{far_i} P{far_j} {far_distance:frac=4}{NL}")
