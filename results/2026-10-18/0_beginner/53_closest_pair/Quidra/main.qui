import math

int[][] points := [
    [12, -7], [-33, 25], [41, 18], [-8, -44], [27, 39], [-46, -12], [5, 14], [36, -29], [-19, 47],
    [-2, 3],
]
minimum := -1
maximum := -1
near_i := 0
near_j := 1
far_i := 0
far_j := 1
for int i < 10
    for i + 1 <= int j < 10
        dx := points[i][0] - points[j][0]
        dy := points[i][1] - points[j][1]
        squared := dx * dx + dy * dy
        if minimum == -1 or squared < minimum
            minimum = squared
            near_i = i
            near_j = j
        if squared > maximum
            maximum = squared
            far_i = i
            far_j = j
near_distance := math.sqrt(real64(minimum))
far_distance := math.sqrt(real64(maximum))
println("closest: P{near_i} P{near_j} {near_distance:frac=4}{NL}farthest: P{far_i} P{far_j} {far_distance:frac=4}")
