string base_text(int value, int base)
    if value == 0
        return "0"
    string alphabet = "0123456789ABCDEF"
    string result = ""
    while value > 0
        result = alphabet[value % base] + result
        value /= base
    return result

int[] values = [0, 10, 255, 1000, 43981, 65535]
for int value = values[]
    print("{value}: bin={base_text(value, 2)} oct={base_text(value, 8)} hex={base_text(value, 16)}{NL}")
