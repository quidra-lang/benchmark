import text

int | error expression(const string[] tokens, nat &position, const map<string, int> variables);

int | error unary(const string[] tokens, nat &position, const map<string, int> variables)
    string token := tokens[position]
    position += 1
    if token == "-"
        int value := -(try unary(tokens, &position, variables))
        return value
    if token == "("
        int value := try expression(tokens, &position, variables)
        position += 1
        return value
    if "0123456789".contains(token[0])
        return int.parse(token)
    map<string, int> lookup := variables
    match lookup.get(token)
        int value
            return value
        none
            return error("undefined variable " + token)

int | error product(const string[] tokens, nat &position, const map<string, int> variables)
    int value := try unary(tokens, &position, variables)
    while position < len(tokens)
        string operation := tokens[position]
        if operation != "*" and operation != "/"
            break
        position += 1
        int right := try unary(tokens, &position, variables)
        if operation == "*"
            value *= right
        else
            if right == 0
                return error("division by zero")
            value /= right
    return value

int | error expression(const string[] tokens, nat &position, const map<string, int> variables)
    int value := try product(tokens, &position, variables)
    while position < len(tokens)
        string operation := tokens[position]
        if operation != "+" and operation != "-"
            break
        position += 1
        int right := try product(tokens, &position, variables)
        value = if operation == "+" then value + right else value - right
    return value

string[] lines := [
    "width = 12", "height = width - 5", "area = width * height", "(area + 6) / 4",
    "shift = -area / 8 + 3", "height = 100 / (height - 7) + bonus", "volume = area * depth",
    "width = (width+3)*-(2-4)", "width * shift - height",
]
map<string, int> variables
for string line := lines[]
    string[] tokens := text.lex.tokenize(line)
    nat position := 0
    string name := ""
    if len(tokens) >= 2 and tokens[1] == "="
        name = tokens[0]
        position = 2
    match expression(tokens, &position, variables)
        error problem
            print.line("error: {problem.message}")
        int value
            if name != ""
                .variables.set(name, value)
                print.line("{name} = {value}")
            else
                print.line(value)
