int expression(const string[] tokens, int &position, const map.Map<string, int> variables, string &failure);

int unary(const string[] tokens, int &position, const map.Map<string, int> variables, string &failure)
    string token = tokens[position]
    position += 1
    if token == "-"
        return -unary(tokens, &position, variables, &failure)
    if token == "("
        int value = expression(tokens, &position, variables, &failure)
        if failure != ""
            return 0
        position += 1
        return value
    if "0123456789".contains(token[0])
        return int.parse(token)
    match variables.get(token)
        int value
            return value
        none
            failure = "undefined variable " + token
            return 0

int product(const string[] tokens, int &position, const map.Map<string, int> variables, string &failure)
    int value = unary(tokens, &position, variables, &failure)
    while failure == "" and position < int(len(tokens))
        string operation = tokens[position]
        if operation != "*" and operation != "/"
            break
        position += 1
        int right = unary(tokens, &position, variables, &failure)
        if failure != ""
            return 0
        if operation == "*"
            value *= right
        else
            if right == 0
                failure = "division by zero"
                return 0
            value /= right
    return value

int expression(const string[] tokens, int &position, const map.Map<string, int> variables, string &failure)
    int value = product(tokens, &position, variables, &failure)
    while failure == "" and position < int(len(tokens))
        string operation = tokens[position]
        if operation != "+" and operation != "-"
            break
        position += 1
        int right = product(tokens, &position, variables, &failure)
        if failure != ""
            return 0
        value = if operation == "+" then value + right else value - right
    return value

string[] tokenize(string text)
    string[] tokens = []
    int i = 0
    while i < int(len(text))
        string character = text[i]
        if character == " "
            i += 1
            continue
        int start = i
        if "0123456789".contains(character)
            while i < int(len(text)) and "0123456789".contains(text[i])
                i += 1
        elif "abcdefghijklmnopqrstuvwxyz".contains(character)
            while i < int(len(text)) and "abcdefghijklmnopqrstuvwxyz".contains(text[i])
                i += 1
        else
            i += 1
        tokens = tokens.append(text[start:<i])
    return tokens

string[] lines = ["width = 12", "height = width - 5", "area = width * height", "(area + 6) / 4", "shift = -area / 8 + 3", "height = 100 / (height - 7) + bonus", "volume = area * depth", "width = (width+3)*-(2-4)", "width * shift - height"]
map.Map<string, int> variables = map.Map<string, int>()
for string line = lines[]
    string[] tokens = tokenize(line)
    int position = 0
    string name = ""
    if len(tokens) >= 2 and tokens[1] == "="
        name = tokens[0]
        position = 2
    string failure = ""
    int value = expression(tokens, &position, variables, &failure)
    if failure != ""
        print("error: {failure}{NL}")
    else
        if name != ""
            .variables.set(name, value)
            print("{name} = {value}{NL}")
        else
            print("{value}{NL}")
