import math

int[][][] systems := [
    [[2, -1, 3, 7], [4, 1, -2, 3], [-3, 5, 1, -4]],
    [[1, 3, -2, 4, 6], [5, -2, 1, 3, -7], [-2, 4, 6, -1, 9], [3, 1, -4, 2, 5]],
]
for system := systems[nat index]
    real64[][] a := real64(system)
    n := int(len(a))
    for int k < n
        pivot := k
        for k + 1 <= int i < n
            if math.abs(a[i][k]) > math.abs(a[pivot][k])
                pivot = i
        if pivot != k
            (a[k], a[pivot]) = (a[pivot], a[k])
        for k + 1 <= int i < n
            factor := a[i][k] / a[k][k]
            for k <= int j <= n
                a[i][j] -= factor * a[k][j]
    real64[] solution := array(nat(n), fill = 0.0)
    for n > int i >= 0
        sum := a[i][n]
        for i + 1 <= int j < n
            sum -= a[i][j] * solution[j]
        solution[i] = sum / a[i][i]
    print.line("system {index + 1}:")
    for value := solution[nat i]
        variable := i + 1
        print.line("x{variable} = {value:frac=4}")
