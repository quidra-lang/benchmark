string[] names = ["milk", "notebook", "bread", "apple", "detergent", "eggs"]
int[] prices = [198, 165, 248, 128, 437, 268]
int[] quantities = [2, 3, 1, 4, 1, 1]
bool[] food = [true, false, true, true, false, true]
int food_total = 0
int general_total = 0
for 0 <= int i < 6
    int subtotal = prices[i] * quantities[i]
    if food[i]
        food_total += subtotal
    else
        general_total += subtotal
    print("{names[i]} {prices[i]} x {quantities[i]} = {subtotal}{NL}")
int food_tax = food_total * 8 / 100
int general_tax = general_total * 10 / 100
int total = food_total + general_total + food_tax + general_tax
print("food: {food_total} yen, tax {food_tax} yen{NL}general: {general_total} yen, tax {general_tax} yen{NL}total: {total} yen{NL}")
