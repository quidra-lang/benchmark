scores := [78, 90, 100, 59, 80, 85, 89, 70, 45, 93]
grades := ["A", "B", "C", "D", "F"]
counts := [0, 0, 0, 0, 0]
for score := scores[]
    int index := if score >= 90 then 0 elif score >= 80 then 1 elif score >= 70 then 2 elif score >= 60 then 3 else 4
    counts[index] += 1
    println("{score}: {grades[index]}")
for: index < 5
    println("{grades[index]}: {counts[index]}")
