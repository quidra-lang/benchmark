int[] scores = [78, 90, 100, 59, 80, 85, 89, 70, 45, 93]
string[] grades = ["A", "B", "C", "D", "F"]
int[] counts = [0, 0, 0, 0, 0]
for int score = scores[]
    int index = if score >= 90 then 0 elif score >= 80 then 1 elif score >= 70 then 2 elif score >= 60 then 3 else 4
    counts[index] += 1
    print("{score}: {grades[index]}{NL}")
for 0 <= int index < 5
    print("{grades[index]}: {counts[index]}{NL}")
