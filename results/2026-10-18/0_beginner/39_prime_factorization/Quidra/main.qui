import collections

int[] values := [84, 9973, 15625, 1001, 123456, 48000, 999958, 999999]
for original := values[]
    remaining := original
    int divisor := 2
    string[] factors := []
    while divisor * divisor <= remaining
        int exponent := 0
        while remaining % divisor == 0
            remaining /= divisor
            exponent += 1
        if exponent > 0
            .factors.push(if exponent >= 2 then "{divisor}^{exponent}" else divisor.string())
        divisor += 1
    if remaining > 1
        .factors.push(remaining.string())
    print.line("{original} = {factors.join(" * ")}")
