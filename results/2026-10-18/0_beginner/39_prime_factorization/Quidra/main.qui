int[] values = [84, 9973, 15625, 1001, 123456, 48000, 999958, 999999]
for int original = values[]
    int remaining = original
    int divisor = 2
    string[] factors = []
    while divisor * divisor <= remaining
        int exponent = 0
        while remaining % divisor == 0
            remaining /= divisor
            exponent += 1
        if exponent > 0
            string factor = divisor.string()
            if exponent >= 2
                factor += "^{exponent}"
            factors = factors.append(factor)
        divisor += 1
    if remaining > 1
        factors = factors.append(remaining.string())
    print("{original} = {factors.join(" * ")}{NL}")
