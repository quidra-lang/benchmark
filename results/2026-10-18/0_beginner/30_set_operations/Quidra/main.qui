import collections
import text

void show(string label, int64[] values)
    print.line("{label}: {text.join(values, " ")}")

int64[] a = [12, 5, 8, 21, 5, 17, 3, 12, 9]
int64[] b = [8, 14, 21, 6, 14, 3, 25, 6]
auto left = a.to_distinct()
auto right = b.to_distinct()
show("union", left.union(right).values().sorted())
show("intersection", left.intersection(right).values().sorted())
show("difference", left.difference(right).values().sorted())
show("symmetric difference", left.symmetric_difference(right).values().sorted())
