void show(string label, int64[] values)
    string[] fields = [for int64 value = values[] then value.string()]
    print("{label}: {fields.join(" ")}{NL}")

int64[] a = [12, 5, 8, 21, 5, 17, 3, 12, 9]
int64[] b = [8, 14, 21, 6, 14, 3, 25, 6]
set.Set<int64> left = set.Set<int64>()
set.Set<int64> right = set.Set<int64>()
set.Set<int64> united = set.Set<int64>()
for int64 value = a[]
    .left.add(value)
    .united.add(value)
for int64 value = b[]
    .right.add(value)
    .united.add(value)
int64[] ordered = united.values().sorted()
int64[] intersection = [for int64 value = ordered[] if left.has(value) and right.has(value) then value]
int64[] difference = [for int64 value = ordered[] if left.has(value) and not right.has(value) then value]
int64[] symmetric = [for int64 value = ordered[] if left.has(value) != right.has(value) then value]
show("union", ordered)
show("intersection", intersection)
show("difference", difference)
show("symmetric difference", symmetric)
