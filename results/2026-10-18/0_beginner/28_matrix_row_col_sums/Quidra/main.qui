import math

int[][] matrix := [[125, 340, 78, 912, 456], [603, 27, 819, 150, 384], [0, 765, 231, 498, 62], [947, 113, 586, 39, 720]]
columns := array(5, fill = 0)
for row := matrix[]
    columns = columns + row
    for value := row[]
        print("{value:int=6}")
    println("{row.sum():int=6}")
for column_sum := columns[]
    print("{column_sum:int=6}")
println("{columns.sum():int=6}")
