int[][] matrix = [[125, 340, 78, 912, 456], [603, 27, 819, 150, 384], [0, 765, 231, 498, 62], [947, 113, 586, 39, 720]]
int[] columns = array(5, fill = 0)
int total = 0
for int[] row = matrix[]
    int row_sum = 0
    for 0 <= int j < 5
        print("{row[j]:int=6}")
        row_sum += row[j]
        columns[j] += row[j]
    total += row_sum
    print("{row_sum:int=6}{NL}")
for int column_sum = columns[]
    print("{column_sum:int=6}")
print("{total:int=6}{NL}")
