int[] values = [17, -8, 42, 5, -23, 36, 5, 0, -11, 29]
int total = 0
int largest = values[0]
int smallest = values[0]
for int value = values[]
    total += value
    if value > largest
        largest = value
    if value < smallest
        smallest = value
print("sum: {total}{NL}max: {largest}{NL}min: {smallest}{NL}")
