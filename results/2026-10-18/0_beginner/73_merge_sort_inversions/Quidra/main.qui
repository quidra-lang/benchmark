void merge_sort(int[] &values, int left, int right, int &inversions)
    if left >= right
        return
    int middle = (left + right) / 2
    merge_sort(&values, left, middle, &inversions)
    merge_sort(&values, middle + 1, right, &inversions)
    int[] first = values[left:middle]
    int[] second = values[(middle + 1):right]
    int i = 0
    int j = 0
    int[] merged = []
    while i < int(len(first)) and j < int(len(second))
        if first[i] <= second[j]
            merged = merged.append(first[i])
            i += 1
        else
            merged = merged.append(second[j])
            j += 1
            inversions += int(len(first)) - i
    merged = merged.concat(first[i:]).concat(second[j:])
    for nat k < len(merged)
        values[left + int(k)] = merged[k]
    string[] fields = [for int value = merged[] then value.string()]
    print("merge [{left}..{right}]: {fields.join(" ")}{NL}")

int[] values = [47, 12, 85, 33, 6, 71, 29, 58, 90, 14]
int inversions = 0
merge_sort(&values, 0, 9, &inversions)
string[] fields = [for int value = values[] then value.string()]
print("sorted: {fields.join(" ")}{NL}inversions: {inversions}{NL}")
