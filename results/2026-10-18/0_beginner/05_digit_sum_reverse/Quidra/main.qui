import math

int[] values = [7, 98000, 4096, 50301, 2718281, 123456789]
for int original = values[]
    string text = original.string()
    int[] digits = [for nat i < len(text) then int.parse(text[i])]
    int reversed = int.parse(text[::-1])
    print("{original}: digits={len(text)} sum={digits.sum()} reversed={reversed}{NL}")
