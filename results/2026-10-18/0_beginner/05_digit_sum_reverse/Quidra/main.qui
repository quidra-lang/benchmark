int[] values = [7, 98000, 4096, 50301, 2718281, 123456789]
for int original = values[]
    int remaining = original
    int digits = 0
    int total = 0
    int reversed = 0
    while remaining > 0
        int digit = remaining % 10
        digits += 1
        total += digit
        reversed = reversed * 10 + digit
        remaining /= 10
    print("{original}: digits={digits} sum={total} reversed={reversed}{NL}")
