import math

int[] values := [7, 98000, 4096, 50301, 2718281, 123456789]
for original := values[]
    text := original.string()
    digits := [for int digit := text.codepoints()[] then digit - 48]
    reversed := int.parse(text[::-1])
    print.line("{original}: digits={len(text)} sum={digits.sum()} reversed={reversed}")
