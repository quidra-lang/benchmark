void visit(int node, int mode, int[] keys, int[] left, int[] right, int[] &order)
    if node == -1
        return
    if mode == 1
        order = order.append(keys[node])
    visit(left[node], mode, keys, left, right, &order)
    if mode == 0
        order = order.append(keys[node])
    visit(right[node], mode, keys, left, right, &order)
    if mode == 2
        order = order.append(keys[node])

int height(int node, int[] left, int[] right)
    if node == -1
        return 0
    int first = height(left[node], left, right)
    int second = height(right[node], left, right)
    return 1 + (if first > second then first else second)

int erase(int node, int key, int[] &keys, int[] &left, int[] &right)
    if node == -1
        return -1
    if key < keys[node]
        left[node] = erase(left[node], key, &keys, &left, &right)
    elif key > keys[node]
        right[node] = erase(right[node], key, &keys, &left, &right)
    else
        if left[node] == -1
            return right[node]
        if right[node] == -1
            return left[node]
        int successor = right[node]
        while left[successor] != -1
            successor = left[successor]
        keys[node] = keys[successor]
        right[node] = erase(right[node], keys[successor], &keys, &left, &right)
    return node

void show(string label, int[] order)
    string[] fields = [for int key = order[] then key.string()]
    print("{label}: {fields.join(" ")}{NL}")

int[] keys = [50, 27, 74, 13, 39, 62, 88, 6, 31, 45, 70, 34]
int[] left = array(12, fill = -1)
int[] right = array(12, fill = -1)
int root = 0
for 1 <= int i < 12
    int node = root
    while true
        if keys[i] < keys[node]
            if left[node] == -1
                left[node] = i
                break
            node = left[node]
        else
            if right[node] == -1
                right[node] = i
                break
            node = right[node]
string[] labels = ["inorder", "preorder", "postorder"]
for 0 <= int mode < 3
    int[] order = []
    visit(root, mode, keys, left, right, &order)
    show(labels[mode], order)
int[] queue = [root]
int[] level = []
int head = 0
while head < int(len(queue))
    int node = queue[head]
    head += 1
    level = level.append(keys[node])
    if left[node] != -1
        queue = queue.append(left[node])
    if right[node] != -1
        queue = queue.append(right[node])
show("levelorder", level)
print("height: {height(root, left, right)}{NL}")
root = erase(root, 6, &keys, &left, &right)
root = erase(root, 27, &keys, &left, &right)
int[] after = []
visit(root, 1, keys, left, right, &after)
show("preorder after deletions", after)
print("height after deletions: {height(root, left, right)}{NL}")
