string under_thousand(int number)
    string[] small = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    string[] tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    string[] parts = []
    if number >= 100
        parts = parts.append(small[number / 100] + " hundred")
    int remainder = number % 100
    if remainder >= 20
        string part = tens[remainder / 10]
        if remainder % 10 != 0
            part += "-" + small[remainder % 10]
        parts = parts.append(part)
    elif remainder > 0
        parts = parts.append(small[remainder])
    return parts.join(" ")

int[] numbers = [0, 13, 40, 100, 568, 71000, 300019, 999999]
for int number = numbers[]
    string[] parts = []
    if number == 0
        parts = parts.append("zero")
    if number >= 1000
        parts = parts.append(under_thousand(number / 1000) + " thousand")
    if number % 1000 > 0
        parts = parts.append(under_thousand(number % 1000))
    print("{number}: {parts.join(" ")}{NL}")
