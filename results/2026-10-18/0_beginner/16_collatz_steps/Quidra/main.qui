int[] starts = [1, 6, 27, 97, 871]
for int start = starts[]
    int n = start
    int steps = 0
    int largest = n
    while n != 1
        n = if n % 2 == 0 then n / 2 else 3 * n + 1
        steps += 1
        if n > largest
            largest = n
    print("{start}: steps={steps} max={largest}{NL}")
