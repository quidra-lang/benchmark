bool[] white_row = array(11, fill = false)
bool[][] black = array(11, fill = white_row)
int row = 5
int column = 5
int direction = 0
int[] dr = [-1, 0, 1, 0]
int[] dc = [0, 1, 0, -1]
for 0 <= int step < 300
    direction = if black[row][column] then (direction + 3) % 4 else (direction + 1) % 4
    black[row][column] = not black[row][column]
    row = (row + dr[direction] + 11) % 11
    column = (column + dc[direction] + 11) % 11
int count = 0
for 0 <= int r < 11
    string line = ""
    for 0 <= int c < 11
        if black[r][c]
            count += 1
        line += if r == row and c == column then "A" elif black[r][c] then "#" else "."
    print(line + NL)
print("black: {count}{NL}")
