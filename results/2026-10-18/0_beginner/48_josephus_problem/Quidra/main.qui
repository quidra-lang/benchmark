import collections

(int, int)[] cases = [(7, 3), (10, 2), (41, 3)]
for (int n, int k) = cases[]
    int[] people = 1:n
    int index = 0
    int survivor = 0
    print("n={n} k={k}:")
    while len(people) > 0
        index = (index + k - 1) % int(len(people))
        survivor = people[index]
        print(" {survivor}")
        .people.remove(survivor)
    print.line("{NL}survivor: {survivor}")
