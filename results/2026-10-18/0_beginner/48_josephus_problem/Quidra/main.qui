import collections

(int, nat)[] cases := [(7, 3), (10, 2), (41, 3)]
for (n, k) := cases[]
    people := 1:n
    nat index := 0
    survivor := 0
    print("n={n} k={k}:")
    while #people != 0
        index = (index + k - 1) % #people
        survivor = .people.remove_at(index)
        print(" {survivor}")
    println("{NL}survivor: {survivor}")
