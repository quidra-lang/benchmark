import collections

(int, nat)[] cases := [(7, 3), (10, 2), (41, 3)]
for (n, k) := cases[]
    people := 1:n
    nat index := 0
    int survivor := 0
    print("n={n} k={k}:")
    while len(people) > 0
        index = (index + k - 1) % len(people)
        survivor = .people.remove_at(index)
        print(" {survivor}")
    print.line("{NL}survivor: {survivor}")
