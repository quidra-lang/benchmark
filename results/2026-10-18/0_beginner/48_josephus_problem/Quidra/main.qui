int[][] cases = [[7, 3], [10, 2], [41, 3]]
for int[] pair = cases[]
    int n = pair[0]
    int k = pair[1]
    int[] people = 1:n
    int index = 0
    int survivor = 0
    print("n={n} k={k}:")
    while len(people) > 0
        index = (index + k - 1) % int(len(people))
        survivor = people[index]
        print(" {survivor}")
        int[] remaining = []
        for 0 <= int i < int(len(people))
            if i != index
                remaining = remaining.append(people[i])
        people = remaining
    print("{NL}survivor: {survivor}{NL}")
