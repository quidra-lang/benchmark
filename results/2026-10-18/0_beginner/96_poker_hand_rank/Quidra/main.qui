int[] score(string hand)
    string ranks = "23456789TJQKA"
    string[] cards = hand.split(" ")
    int[] counts = array(15, fill = 0)
    bool is_flush = true
    for string card = cards[]
        match ranks.find(card[0])
            nat position
                counts[int(position) + 2] += 1
            none
                continue
        if card[1] != cards[0][1]
            is_flush = false
    int distinct = 0
    int low = 15
    int high = 0
    int pairs = 0
    int largest = 0
    for 2 <= int rank <= 14
        if counts[rank] > 0
            distinct += 1
            if rank < low
                low = rank
            high = rank
        if counts[rank] == 2
            pairs += 1
        if counts[rank] > largest
            largest = counts[rank]
    bool wheel = counts[14] == 1 and counts[2] == 1 and counts[3] == 1 and counts[4] == 1 and counts[5] == 1
    bool straight = distinct == 5 and (high - low == 4 or wheel)
    int category = 0
    if straight and is_flush
        category = 8
    elif largest == 4
        category = 7
    elif largest == 3 and pairs == 1
        category = 6
    elif is_flush
        category = 5
    elif straight
        category = 4
    elif largest == 3
        category = 3
    elif pairs == 2
        category = 2
    elif pairs == 1
        category = 1
    int[] key = [category]
    if straight and wheel
        key = key.concat([5, 4, 3, 2, 1])
    else
        for 4 >= int count >= 1
            for 14 >= int rank >= 2
                if counts[rank] == count
                    key = key.append(rank)
    return key

bool stronger(int[] first, int[] second)
    nat count = if len(first) < len(second) then len(first) else len(second)
    for nat i < count
        if first[i] != second[i]
            return first[i] > second[i]
    return len(first) > len(second)

string[] hands = [
    "9C 9D 5H QH 2C", "4D AH 3C 5S 2H", "KS 8S 2S JS 6S", "7H 7D KC 7S KD",
    "3H 6C 4S 2D 5C", "JD TC 4H 8C AS", "QC 6D QS 3S 6H", "9H KH 9S 8H 3D",
]
string[] categories = [
    "high card", "one pair", "two pair", "three of a kind", "straight", "flush", "full house",
    "four of a kind", "straight flush",
]
int[][] keys = [for string hand = hands[] then score(hand)]
bool[] used = array(8, fill = false)
for 1 <= int position <= 8
    int best = -1
    for 0 <= int i < 8
        if not used[i]
            if best == -1 or stronger(keys[i], keys[best])
                best = i
    used[best] = true
    print("{position}. {hands[best]}: {categories[keys[best][0]]}{NL}")
