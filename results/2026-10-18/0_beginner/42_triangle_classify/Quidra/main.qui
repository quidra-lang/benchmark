int64[][] triples = [[3, 8, 5], [6, 6, 6], [5, 8, 5], [13, 5, 12], [2, 9, 4], [7, 4, 7], [8, 6, 7], [4, 9, 6]]
for int64[] original = triples[]
    int64[] ordered = original.sorted()
    int64 a = ordered[0]
    int64 b = ordered[1]
    int64 c = ordered[2]
    print("{original[0]} {original[1]} {original[2]}: ")
    if a + b <= c
        print("not a triangle{NL}")
    else
        string side = if a == c then "equilateral" elif a == b or b == c then "isosceles" else "scalene"
        int64 sum_squares = a * a + b * b
        int64 largest_square = c * c
        string angle = if largest_square < sum_squares then "acute" elif largest_square == sum_squares then "right" else "obtuse"
        print("{side} {angle}{NL}")
