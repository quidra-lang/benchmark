int64[][] triples := [[3, 8, 5], [6, 6, 6], [5, 8, 5], [13, 5, 12], [2, 9, 4], [7, 4, 7], [8, 6, 7], [4, 9, 6]]
for original := triples[]
    ordered := original.sorted()
    a := ordered[0]
    b := ordered[1]
    c := ordered[2]
    print("{original[0]} {original[1]} {original[2]}: ")
    if a + b <= c
        print.line("not a triangle")
    else
        side := if a == c then "equilateral" elif a == b or b == c then "isosceles" else "scalene"
        sum_squares := a * a + b * b
        largest_square := c * c
        angle := (
            if largest_square < sum_squares then "acute"
            elif largest_square == sum_squares then "right"
            else "obtuse"
        )
        print.line("{side} {angle}")
