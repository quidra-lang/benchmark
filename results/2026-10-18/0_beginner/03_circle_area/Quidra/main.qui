import math

string fixed3(real64 value)
    int scaled = math.round(value * 1000.0)
    int whole = scaled / 1000
    int fraction = scaled % 1000
    return "{whole}.{fraction:int=3,zero}"

real64 pi = 3.141592653589793
int[] radii = [3, 7, 12, 25, 41]
for int radius = radii[]
    real64 r = real64(radius)
    real64 area = (pi * r) * r
    real64 circumference = (2.0 * pi) * r
    print("r={radius} area={fixed3(area)} circumference={fixed3(circumference)}{NL}")
