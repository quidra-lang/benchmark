import collections
import math

int root(int vertex, int[] parent)
    while parent[vertex] != vertex
        vertex = parent[vertex]
    return vertex

string names = "ABCDEFGH"
(int, int, int)[] edges = [
    (0, 1, 7),
    (2, 0, 4),
    (1, 2, 9),
    (1, 3, 14),
    (3, 2, 6),
    (2, 4, 3),
    (4, 3, 5),
    (5, 3, 11),
    (4, 6, 16),
    (6, 5, 8),
    (7, 5, 12),
    (6, 7, 2),
    (7, 4, 10),
]
int[] weights = []
for (_, _, int weight) = edges[]
    .weights.push(weight)
edges = edges.sorted(by = weights)
int[] parent = 0:7
int accepted = 0
int skipped = 0
int total = 0
for (int a, int b, int weight) = edges[]
    int first = root(a, parent)
    int second = root(b, parent)
    if first == second
        skipped += 1
        continue
    parent[second] = first
    print.line("{names[math.min(a, b)]}-{names[math.max(a, b)]} {weight}")
    total += weight
    accepted += 1
    if accepted == 7
        break
print.line("total weight: {total}{NL}skipped: {skipped}")
