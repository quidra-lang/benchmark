int root(int vertex, int[] parent)
    while parent[vertex] != vertex
        vertex = parent[vertex]
    return vertex

string names = "ABCDEFGH"
int[][] edges = [[0, 1, 7], [2, 0, 4], [1, 2, 9], [1, 3, 14], [3, 2, 6], [2, 4, 3], [4, 3, 5], [5, 3, 11], [4, 6, 16], [6, 5, 8], [7, 5, 12], [6, 7, 2], [7, 4, 10]]
for 1 <= int i < int(len(edges))
    int[] edge = edges[i]
    int j = i - 1
    while j >= 0 and edges[j][2] > edge[2]
        edges[j + 1] = edges[j]
        j -= 1
    edges[j + 1] = edge
int[] parent = 0:7
int accepted = 0
int skipped = 0
int total = 0
for int[] edge = edges[]
    int first = root(edge[0], parent)
    int second = root(edge[1], parent)
    if first == second
        skipped += 1
        continue
    parent[second] = first
    int a = if edge[0] < edge[1] then edge[0] else edge[1]
    int b = if edge[0] > edge[1] then edge[0] else edge[1]
    print("{names[a]}-{names[b]} {edge[2]}{NL}")
    total += edge[2]
    accepted += 1
    if accepted == 7
        break
print("total weight: {total}{NL}skipped: {skipped}{NL}")
