int value_of(string token, int[] registers)
    string names = "ABCD"
    match names.find(token)
        nat index
            return registers[index]
        none
            return int.parse(token)

string[] program = ["SET A 1", "SET B 1", "SET D 8", "MUL A B", "PRINT A", "ADD B 1", "SUB D 1", "JNZ D -4", "SET A 1071", "SET B 462", "SET C A", "MOD C B", "SET A B", "SET B C", "JNZ B -4", "PRINT A", "HALT"]
string names = "ABCD"
int[] registers = array(4, fill = 0)
int pc = 0
int executed = 0
while 0 <= pc < int(len(program))
    string[] fields = program[pc].split(" ")
    string operation = fields[0]
    executed += 1
    if operation == "HALT"
        break
    if operation == "PRINT"
        print("{value_of(fields[1], registers)}{NL}")
    elif operation == "JNZ"
        int offset = int.parse(fields[2])
        pc += if value_of(fields[1], registers) != 0 then offset else 1
        continue
    else
        match names.find(fields[1])
            nat index
                int value = value_of(fields[2], registers)
                if operation == "SET"
                    registers[index] = value
                elif operation == "ADD"
                    registers[index] += value
                elif operation == "SUB"
                    registers[index] -= value
                elif operation == "MUL"
                    registers[index] *= value
                else
                    registers[index] %= value
            none
                break
    pc += 1
print("executed: {executed}{NL}")
