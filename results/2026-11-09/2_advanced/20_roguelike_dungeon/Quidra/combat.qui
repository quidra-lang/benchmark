import math
import minstd = "./minstd.qui"

class Dice(int count, int sides)
    int roll(minstd.Generator &generator)
        return .generator.roll(count, sides)

Dice parse_dice(string token)
    parts := token.split("d")
    return Dice(int(parts[0]), int(parts[1]))

class Attack(string outcome, int damage)

Attack resolve_attack(minstd.Generator &generator, int to_hit, int defense, Dice dice, int bonus)
    rolled := 1 + .generator.rnd(20)
    if rolled == 1
        return Attack("miss", 0)
    damage := 0
    outcome := "hit"
    if rolled == 20
        outcome = "critical"
        damage = dice.roll(&generator) + dice.roll(&generator) + bonus
    elif rolled + to_hit >= defense
        damage = dice.roll(&generator) + bonus
    else
        return Attack("miss", 0)
    return Attack(outcome, math.max(damage, 1))
