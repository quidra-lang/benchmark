class Generator(int state)
    int .draw()
        state = 48271 * state % 2147483647
        return state

    int .below(int limit)
        return .draw() % limit

    void .shuffle(int[] &items)
        for: int(#items) - 1 >= i >= 1
            j := .draw() % (i + 1)
            saved := items[i]
            items[i] = items[j]
            items[j] = saved
