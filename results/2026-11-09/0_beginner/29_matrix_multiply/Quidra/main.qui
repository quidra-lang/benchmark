import math

int[][] a := [[3, -2, 5, 1], [-4, 7, 0, 6], [2, 9, -8, -3]]
int[][] b := [[1, 4], [-5, 2], [6, -1], [0, 7]]
for: i < 3
    int[] products := []
    for: j < 2
        column := [for row := b[] then row[j]]
        .products.push(a[i].dot(column))
    for product := products[]
        print("{product:5.}")
    println()
