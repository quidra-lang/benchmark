import collections
import text

limit := 200
prime := array(limit + 1, fill = true)
prime[0] = false
prime[1] = false
for: 2 <= p <= limit
    if prime[p]
        for: 2 * p <= multiple <= limit step p
            prime[multiple] = false
int[] primes := []
for: 2 <= n <= limit
    if prime[n]
        .primes.push(n)
println("count: {#primes}")
groups := primes.chunks(10)
for group := groups[]
    println(text.join<int>(group, " "))
